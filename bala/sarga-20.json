[{"id":"VRCE-1-20-1","kanda":1,"kandaId":"bala","sarga":20,"verse":1,"english":"Hearing those words of Dasaratha's composed of letters faltering with affection, Kusika's son, stirred up with anger, answered the monarch, saying,","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-21-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1020001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8a2c6a74ae673b82f626d748c291a1be05eea7b6fd2d8c62a8e349e490f48ee4","compact":"d4ec755914b1fd3369767912ce5d5d59cf08f4813f9e977c9f2ff080385c3c94","nasal":"d4ec755914b1fd3369767912ce5d5d59cf08f4813f9e977c9f2ff080385c3c94"}},{"id":"VRCE-1-20-2","kanda":1,"kandaId":"bala","sarga":20,"verse":2,"english":"Having promised me first, you endeavour to renounce that proinise of yours. This surely is unworthy of a descendant of Raghu, and this can bring destruction upon the dynasty.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-21-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1020002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a7f6253f34f184804eb8dd735c99a32e880edea90cc6f8806ea9f2f6bc3cd983","compact":"4779a06e6f7375b8a45bdde08bcf8b13aec4cc78e68fb35ab4cd33588980a46f","nasal":"4779a06e6f7375b8a45bdde08bcf8b13aec4cc78e68fb35ab4cd33588980a46f"}},{"id":"VRCE-1-20-3","kanda":1,"kandaId":"bala","sarga":20,"verse":3,"english":"If, O king, in acting thus, you have acted properly, I will then repair to the place whence I had come. O Kākutstha's descendant false in promise, do you attain happiness, being surrounded by your friends.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-21-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1020003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"