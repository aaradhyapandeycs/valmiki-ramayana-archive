[{"id":"VRCE-1-68-1","kanda":1,"kandaId":"bala","sarga":68,"verse":1,"english":"Then when the night had been spent, king Dasaratha accompanied with his priests and adherents, well pleased spoke to Sumantra, saying,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-69-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1068001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2e31aed98bcb4d3fc8199094d39c6ce3912bdf3ff41507340f98f96abab7a32b","compact":"797770a16e8cb9702e6b00959f211908087275a5f0912d9f9cbf1033dafa2220","nasal":"88e86211056fb2d3877171270d96a01f2874755858595aa9bc47afd417a15b69"}},{"id":"VRCE-1-68-2","kanda":1,"kandaId":"bala","sarga":68,"verse":2,"english":"To-day let the officers in charge of the treasury, taking plenty of excellent wealth, and furnished with various gems, go in advance under proper escort.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-69-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1068002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aad47b9ed49b80fc3b20acc5d74b1c57af9d2c4f0c0d4bc5d94484c6640bf70d","compact":"7974c44281e304eda2da623ce9ebc96f4b0864b0b0ce95b3c10a988434defe0e","nasal":"69a79d304d631d8224cf446527fa7687760536d64b8c970ba21983afcec8adfd"}},{"id":"VRCE-1-68-3","kanda":1,"kandaId":"bala","sarga":68,"verse":3,"english":"And let the fore-fold forces sally out with speed. And at my command let horses and conveyances and elegant vehicles march out","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-69-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1068003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e81bc1ceed523d4e46d3e43c3af3a95345df28b734b841f0bdcc3807bc904a56","compact":"b40b51be44870f781ec711487d51d564