red-sanskrit-ngram","duttRefs":["DUTT-1-69-5"],"status":"unreviewed"},"source":{"sanskritLocator":"1068006","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"233b86fa3e5c4ac182414d3badff4d544c5d228821096775d6251037d34347a3","compact":"f88c12c7e83c965c59e94b39e6046167519232548f7e63edaa2572444f3c22a1","nasal":"9c8859ce44dab24ae7e0d29559aaf5c45b9d754805d97e4aea3859e95666a858"}},{"id":"VRCE-1-68-7","kanda":1,"kandaId":"bala","sarga":68,"verse":7,"english":"After having passed four days on the way, they arrived at Videha. And bearing of Dasaratha's arrival, the auspicious king Janaka experienced great delight, and having obtained the aged king Dasaratha, he honoured him duly.","alignment":{"type":"grouped","confidence":0.612,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-69-6"],"status":"unreviewed"},"source":{"sanskritLocator":"1068007","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f35136054de4281c94c300b8bb5ddb96e13cb0928eb77abd173f10ac34b1fe95","compact":"c215f87110604517cfe6b4deacca3633bd71323740f57b51620066c2f0605366","nasal":"c215f87110604517cfe6b4deacca3633bd71323740f57b51620066c2f0605366"}},{"id":"VRCE-1-68-8","kanda":1,"kandaId":"bala","sarga":68,"verse":8,"english":"After having passed four days on the way, they arrived at Videha. And bearing of Dasaratha's arrival, the auspicious king Janaka experienced great delight, and having obtained the aged king Dasaratha, he honoured him duly. That chief of men well pleased, spoke these words, Have your journey been a pleasant one, O best of men? By luck have I obtained you, O descendant of Raghu.","alignment":{"type":"split","confidence":0.276,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-69-6","DUTT-1-69-7"],"status":"unreviewed"},"source":{"sanskritLocator":"1068008","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f1bcb74299d78dea71ba09c1aeb0d9c445ea0