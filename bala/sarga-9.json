[{"id":"VRCE-1-9-1","kanda":1,"kandaId":"bala","sarga":9,"verse":1,"english":"Thus asked by the king, Sumantra said these words-I will relate to you how the counsellors brought Rşyaśộnga. Do you listen with your counsellors!","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-10-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1009001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d80f3b24e60023131807246ceda8a78d37a1ae70b859ec1320b5e4b32f401962","compact":"45e5df2439ac342efb4371ec3ee8b0bdf4787693a9137f8674eb9ad9fdc91523","nasal":"23cad724a82cc54ea922e6949c1819a6d921da81f7391a4584c498d466c63570"}},{"id":"VRCE-1-9-2","kanda":1,"kandaId":"bala","sarga":9,"verse":2,"english":"The priest together with the counsellors spoke to Romapada, saying, 'The means that we have hit upon can never fail of effect.'","alignment":{"type":"1:1","confidence":0.982,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-10-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1009002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"95ce8bb59a8cb5dead447ecae9d2f7543bff29d33b7cabe6e67767f04b08c563","compact":"613f9d89bb402de410cd08fdc804f52ef038e74e66f47ca98c82f789ff015e1f","nasal":"92d2e992b28096938812e1c5801e28ae37517fbddc97084206d82f542484d036"}},{"id":"VRCE-1-9-3","kanda":1,"kandaId":"bala","sarga":9,"verse":3,"english":"Rşyaśộnga has been brought up in woods; and is engaged in austerities and the study of the Vedas. He is ignorant of the pleasure that ensues from contact with women,","alignment":{"type":"1:1","confidence":0.632,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-10-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1009003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a71525c77e1bd1f8bd24ad562fb224ca1e82c1fb73b7cdf2ea7ebe8fb9eee51","compact":"c9e6ab807c22d9fbecbd30026b016ead9213f85e8e7cb8901c8b0f87b04d2967","nasal":"98809c6ec3fa4055cc19af0755dc1e1e7daf41fdb464deeae6eef2187a0bf2d2"}},{"id":"VRCE-1-9-4","kanda":1,"kandaId":"bala","sarga":9,"verse":4,"english":"By help of things agreeably ministering to the sense, and ravishing the soul, we shall bring him to the city. Do you, therefore, arrange for them!","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-10-4"],"status":"unreviewed"},"source":{"sanskritLocator":"1009004","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fa7ffaff91abbbac5cea201c8cc3990218816b59ff372f8b4033f699b5432972","compact":"d29b9cd81d79bc441221e444f6f00fcb409efd916f82a4ffce3ea38cc978ab34","nasal":"2be4118dc3ba4c00da7b5531afc6e5ec18576956aa0cf23a84933828af088e98"}},{"id":"VRCE-1-9-5","kanda":1,"kandaId":"bala","sarga":9,"verse":5,"english":"Let courtezans of comely presence, clad in ornaments, repair thither. And if well treated, they will by various means bring him here.'","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-10-5"],"status":"unreviewed"},"source":{"sanskritLocator":"1009005","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"16d4b160de18b01056fd7079a41e39ccdd998fc344f834266e0a3b91aae96532","compact":"6a508f69771041c3bf197381d5bbf0410dbb640dcc020cefe378daa33ba6d100","nasal":"f73fbd9bbe16fa52c5a304e7b60811ea007e93149e6b1016443a71db640681e3"}},{"id":"VRCE-1-9-6","kanda":1,"kandaId":"bala","sarga":9,"verse":6,"english":"Hearing this, the king said to the priest, 'So be it!' Then the priest and courtiers acted accordingly.","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-10-6"],"status":"unreviewed"},"source":{"sanskritLocator":"1009006","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8cfb84b9