[{"id":"VRCE-1-74-1","kanda":1,"kandaId":"bala","sarga":74,"verse":1,"english":"Rama, son of Dasaratha, I have, O hero, heard of your wonderful prowess; and I have also heard all about your breaking of the bow.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-75-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1074001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b9628c89ec7095771b52b96c93643cc9ae9a2527f9c86565baa4e62fb10302e3","compact":"cb8d46cb3b1cd4a1fdc963b75b4be6d3a8dbc0bc18dc25ef26c333383758cbd5","nasal":"cb8d46cb3b1cd4a1fdc963b75b4be6d3a8dbc0bc18dc25ef26c333383758cbd5"}},{"id":"VRCE-1-74-2","kanda":1,"kandaId":"bala","sarga":74,"verse":2,"english":"Having heard of that wonderful and inconceivable breaking of the bow, I have bent my steps hither. Do you take another auspicious bow,. Do you stretch it, fix the arrow upon this mighty and dreadful bow, belonging to Jamadagni; and thus display your prowess.","alignment":{"type":"grouped","confidence":0.853,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-75-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1074002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"07e98a409630a0b3b03829eff5a841ecf605eaf9c64209a0031cdfead06ef4c7","compact":"3fba8934f4306182f0a401e731653a9548fa98451237f7b512b71cd9915e0971","nasal":"b087e0301fcabf4620f795074614f3a961bde980fffa34a6d68204f6ed5a6706"}},{"id":"VRCE-1-74-3","kanda":1,"kandaId":"bala","sarga":74,"verse":3,"english":"Having heard of that wonderful and inconceivable breaking of the bow, I have bent my steps hither. Do you take another auspicious bow,. Do you stretch it, fix the arrow upon this mighty and dreadful bow, belonging to Jamadagni; and thus display your prowess.","alignment":{"type":"grouped","confidence":0.83,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-75-2"],"status":"unreviewed"},"so