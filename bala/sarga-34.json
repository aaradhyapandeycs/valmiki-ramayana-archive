[{"id":"VRCE-1-34-1","kanda":1,"kandaId":"bala","sarga":34,"verse":1,"english":"HAVING in company with the ascetics passed the remainder of the night on the banks of the Sona, Visvāmitra, when the day broke, spoke,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-35-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1034001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d46eadbcb596d6c4b298dfa8300ad44a173b8899d7c7cde5eecbf749e663fbd0","compact":"0a6288397b98b3b89db4237e8c92a5f86331d02c31edcef406ddce77cfe3c8ec","nasal":"0a6288397b98b3b89db4237e8c92a5f86331d02c31edcef406ddce77cfe3c8ec"}},{"id":"VRCE-1-34-2","kanda":1,"kandaId":"bala","sarga":34,"verse":2,"english":"O Rāma, the night has passed away, and the morn has come. The hour for performing the prior devotions has arrived. Arise! arise! good betide you! Do you prepare for going.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-35-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1034002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e077f8224a42200dc49c41539eb7a96b93ca6f7fb9bed32b2436755ff0f026d0","compact":"6f6c65c52739366913de7a1b5a268e5fbc07911394f51021e89e340af78ca15c","nasal":"6f6c65c52739366913de7a1b5a268e5fbc07911394f51021e89e340af78ca15c"}},{"id":"VRCE-1-34-3","kanda":1,"kandaId":"bala","sarga":34,"verse":3,"english":"Hearing these words of his, Rāma, having finished his morning devotions and rites, and ready for departure, said,","alignment":{"type":"1:1","confidence":0.53,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-35-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1034003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"490123e0f65d008307e5e63953b0752ce3260a0f3ae677f11c8571e3e23b03fb","compact":"f66d577e7dd108dfcd025c0d0f8d