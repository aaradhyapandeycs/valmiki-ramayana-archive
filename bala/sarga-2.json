[{"id":"VRCE-1-2-1","kanda":1,"kandaId":"bala","sarga":2,"verse":1,"english":"Hearing those words of Nārada, that one of virtuous soul, skilled in speech, together with his disciples, worshipped that great sage.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-2-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1002001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cee774f242f4a86a0c847f80857d140165863287ca7cb0b982c84243057cfcd3","compact":"e8f44afbb32f6fda22887ecb766b2ef25028f3b38ace487539681276d5377154","nasal":"e8f44afbb32f6fda22887ecb766b2ef25028f3b38ace487539681276d5377154"}},{"id":"VRCE-1-2-2","kanda":1,"kandaId":"bala","sarga":2,"verse":2,"english":"Having received due honours, that Devarși Nārada taking leave of him went to his ethereal regions.","alignment":{"type":"1:1","confidence":0.597,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-2-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1002002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7b01f98bb5358933d10bbea6ce730bc560121ce3bb72c3528dea0fe888dc268f","compact":"2c8ea66c07756a0ab8a68c5fc2b27571fb8f65cc3e7ee9427ce3dcd84cc86947","nasal":"2c8ea66c07756a0ab8a68c5fc2b27571fb8f65cc3e7ee9427ce3dcd84cc86947"}},{"id":"VRCE-1-2-3","kanda":1,"kandaId":"bala","sarga":2,"verse":3,"english":"And when Nārada had left for the celestial regions, that holy person went to the banks of the Tamasā not very far from Jāhnavī.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-2-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1002003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"487b2b70733c693740967cd28b3817f0f5df359f4cfc12545d81182b07cb2a6d","compact":"07351afea6394d7d931d1537086101a791bbc83bcd75fe7e889feb1a8746e215","nasal":"f06ae651661f0184caf