gram","duttRefs":["DUTT-1-61-9"],"status":"unreviewed"},"source":{"sanskritLocator":"1060009","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a07413b75e0065e57159a9cfd4481c3212a814ae111d329c3ae73e254d78fc6e","compact":"6241447c4fa7a40f58f9d5888afe6c23406c3917935e8431afbdf0432923efcc","nasal":"6241447c4fa7a40f58f9d5888afe6c23406c3917935e8431afbdf0432923efcc"}},{"id":"VRCE-1-60-10","kanda":1,"kandaId":"bala","sarga":60,"verse":10,"english":"And, O child, it came to pass that arriving at Bhrgutunga, (A mountain peak) he beheld Řcīka seated there in company with his wife and sons.","alignment":{"type":"grouped","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-10"],"status":"unreviewed"},"source":{"sanskritLocator":"1060010","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2833acc01cb58ae337bd5fe2d84737b285787e7de6aa2ca76bef3174340143f5","compact":"635584dbcd44263b83d3116fcaa961ebc42640a36c6ec4d27017eab8d288f058","nasal":"e3c12684a46fb792965c4e64ba89a1dd6e20ec984ace2d858b975224f507bb27"}},{"id":"VRCE-1-60-11","kanda":1,"kandaId":"bala","sarga":60,"verse":11,"english":"And, O child, it came to pass that arriving at Bhrgutunga, (A mountain peak) he beheld Řcīka seated there in company with his wife and sons.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-10"],"status":"unreviewed"},"source":{"sanskritLocator":"1060011","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b9cf1fa9fc4c24a462f8180894087f305692fe7066111196b2804ed91f63894e","compact":"8c21fac356a9ade0714b1bb4c963fec78aad9d27e49af95b9e26247f82053e16","nasal":"21ebcda4254ab0ae25d034f723fe7828dcbfd455584b865ae0c93f45b6e3e114"}},{"id":"VRCE-1-60-12","kanda":1,"kandaId":"bala","sarga":60,"verse":12,"english":"O descendant of Raghu. And bowing to that Brahmarşi flaming in asceticism, and propitiating him, the exceedingly energetic royal saint of unparalleled effulgence having enquired as to his complete welfare, addressed Rcika, saying, 'O highly pious one, O Bhrgu's son, if in order that I may have a substitute for my sacrificial beast, you sell your son, my desire I shall atain.'","alignment":{"type":"grouped","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-11"],"status":"unreviewed"},"source":{"sanskritLocator":"1060012","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55f77be4687d3b04b7ff8a12a7c8b9cca2173b04f17a126191e5a155e392ab82","compact":"5c5cfab4fb5b7206ce702ca84b5f8050cc3d31fdd3fd4ebb1be3ae2753a3b2c5","nasal":"5c5cfab4fb5b7206ce702ca84b5f8050cc3d31fdd3fd4ebb1be3ae2753a3b2c5"}},{"id":"VRCE-1-60-13","kanda":1,"kandaId":"bala","sarga":60,"verse":13,"english":"O descendant of Raghu. And bowing to that Brahmarşi flaming in asceticism, and propitiating him, the exceedingly energetic royal saint of unparalleled effulgence having enquired as to his complete welfare, addressed Rcika, saying, 'O highly pious one, O Bhrgu's son, if in order that I may have a substitute for my sacrificial beast, you sell your son, my desire I shall atain.'","alignment":{"type":"grouped","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-11"],"status":"unreviewed"},"source":{"sanskritLocator":"1060013","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f84e13cbe24fe1475a7ffe92591b466c8d399994db0825b425e9ed32b9f8a05","compact":"009f9dc53040a5cd202bbd8735ee75da74e807464eca6f8a2a0636ff66b56708","nasal":"009f9dc53040a5cd202bbd8735ee75da74e807464eca6f8a2a0636ff66b56708"}},{"id":"VRCE-1-60-14","kanda":1,"kandaId":"bala","sarga":60,"verse":14,"english":"I have ranged every country; but the beast I do not find. Therefore, it behove you to part with one of your sons for price.'","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-12"],"status":"unreviewed"},"source":{"sanskritLocator":"1060014","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"870a6879894a5f6836873f2aa689610348f779b82863c0fc288cd5987be571bb","compact":"6d9649a8bf82d88192797f04d6a20a84d8808039a7399b57f911f74486feda97","nasal":"6d9649a8bf82d88192797f04d6a20a84d8808039a7399b57f911f74486feda97"}},{"id":"VRCE-1-60-15","kanda":1,"kandaId":"bala","sarga":60,"verse":15,"english":"Thus addressed the exceedingly energetic Rcīka replied, “O best of men, my first-born I will in no wise dispose of.'","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-13"],"status":"unreviewed"},"source":{"sanskritLocator":"1060015","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7db98b6bd9d305e76762e429e0f4f148710ec24dd629c2cfce920c14bfe646aa","compact":"72f38edeebf6a0fd141b51d680ec32f5c251a2423ef51cacb8de899120778c44","nasal":"72f38edeebf6a0fd141b51d680ec32f5c251a2423ef51cacb8de899120778c44"}},{"id":"VRCE-1-60-16","kanda":1,"kandaId":"bala","sarga":60,"verse":16,"english":"Hearing the words of the high-souled Rcīka, their mother spoke to that foremost of men, Amvarisha, saying,","alignment":{"type":"1:1","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-14"],"status":"unreviewed"},"source":{"sanskritLocator":"1060016","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4ab8878f36c5ff7051c8a8c6340fd3f0b9ce8c502b23f938b7a7c42cfb85aad","compact":"d79a0e81886526893496ee87c253e4ccf5e67ab603ae9b2ddf5f5c83f9fbc665","nasal":"2705ae363d0db2f56f872a69d82c8f492dfca7e7d1f1fd5966c2b4442dadf6a0"}},{"id":"VRCE-1-60-17","kanda":1,"kandaId":"bala","sarga":60,"verse":17,"english":"The worshipful son of Bhțgu has said that his first-born cannot be disposed of-do you, O lord, also know that the youngest, Sunaka, is my favourite. Therefore my youngest son will I not give to you.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-15"],"status":"unreviewed"},"source":{"sanskritLocator":"1060017","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d048bc5be987a7e16db956ea9c467fbb58a4b1640426e3ccfa293b26c912bf2b","compact":"52640f22b6ab82674a39adc65bd97363ff674f76d91bf17750e605caee34565a","nasal":"52640f22b6ab82674a39adc65bd97363ff674f76d91bf17750e605caee34565a"}},{"id":"VRCE-1-60-18","kanda":1,"kandaId":"bala","sarga":60,"verse":18,"english":"O foremost of men, the eldest sons are generally the best beloved of their fathers; and the youngest, of their mother, therefore the youngest I would retain.","alignment":{"type":"1:1","confidence":0.783,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-16"],"status":"unreviewed"},"source":{"sanskritLocator":"1060018","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"637f5e1823260972bee7c163b4b939011c8289d30c3e0f3f8d31b75de298c8db","compact":"e59ccb04ef3cde075b13e5d84b6d7efdd8f69070aeb4aeba8eba4ba1d088f05f","nasal":"e59ccb04ef3cde075b13e5d84b6d7efdd8f69070aeb4aeba8eba4ba1d088f05f"}},{"id":"VRCE-1-60-19","kanda":1,"kandaId":"bala","sarga":60,"verse":19,"english":"And when the ascetic as well as his wife had spoken thus, the second son, Sunahsepa, O Rāma, himself said.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-17"],"status":"unreviewed"},"source":{"sanskritLocator":"1060019","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cf36bb47c9f8f2e22f8e40547cafab6489f2a3208334d18aefbcbc8ea202f491","compact":"0bd2b660fd05cc4aa6fa3cdf4d60ae0189bab5f0273611a0300274eaa34007b4","nasal":"0bd2b660fd05cc4aa6fa3cdf4d60ae0189bab5f0273611a0300274eaa34007b4"}},{"id":"VRCE-1-60-20","kanda":1,"kandaId":"bala","sarga":60,"verse":20,"english":"My father would not sell the eldest; nor my mother the youngest,—therefore, I consider even the second as disposable. Do you then, O prince, take me.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-18"],"status":"unreviewed"},"source":{"sanskritLocator":"1060020","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b323675d86701267b533c0bb89bf04937f81c05ab207bee9320423a35810f77","compact":"46cc3dac5a7d47c748a9f28648d1c20b4d69914d526e14577d05c33797204ecb","nasal":"46cc3dac5a7d47c748a9f28648d1c20b4d69914d526e14577d05c33797204ecb"}},{"id":"VRCE-1-60-21","kanda":1,"kandaId":"bala","sarga":60,"verse":21,"english":"When that one versed in the Veda had ended, that lord of men, O mighty-armed descendant of Raghu, taking possession of Sunaḥsepa, by paying koțis of kine, and heaps of jewels, and gold and silver by hundreds and thousands, went away exceedingly delighted.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-19"],"status":"unreviewed"},"source":{"sanskritLocator":"1060021","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8e588a563c4362a248c17eae0f5d3eeafc0560e6564fae9eb67b2e6e5ef0965e","compact":"a16831ba6b248b9eaca6728741739cfbf958a2705db18a9ff6b495c7b3c8ccd0","nasal":"ce101633ebea49740c711b053a520e6fb330113197e608de12ecad17440c3587"}},{"id":"VRCE-1-60-22","kanda":1,"kandaId":"bala","sarga":60,"verse":22,"english":"That royal saint, the exceedingly energetic and highly famous Ambarīşa, placing Sunaḥsepa on his car, speedily set out.","alignment":{"type":"1:1","confidence":0.927,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-20"],"status":"unreviewed"},"source":{"sanskritLocator":"1060022","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fdc1c37b3355e8cf40