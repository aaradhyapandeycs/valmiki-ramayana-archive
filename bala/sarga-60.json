[{"id":"VRCE-1-60-1","kanda":1,"kandaId":"bala","sarga":60,"verse":1,"english":"And, O puissant one, seeing those saints gone, the highly energetic Viśvāmitra addressed those inhabitants of the forest.","alignment":{"type":"1:1","confidence":0.59,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1060001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b87f2a0f1de2166c0293a3015d42a5ac52d2e0665bc0e63d9c2fe892b8087ca0","compact":"f9aaeaca6ccf5b70c55bc50db5ece8a8a66faeccb6d9ec424fbee185cd02bf84","nasal":"541174158f7f857c67cf650dc32114d3a04f26d0fbf0e1a7b87c33f25275020d"}},{"id":"VRCE-1-60-2","kanda":1,"kandaId":"bala","sarga":60,"verse":2,"english":"A mighty disturbance has happened in regard to the southern quarter: let us therefore repairing to another region, carry on austerities.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1060002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d401bff721be62443a8c28db48801d0d2a2901295bb8e6e0a86b175f6a1d6094","compact":"b02d7aeb662166ac6406bb7d6b9831cc9da3bbe087a7b31383a7b9488af4d931","nasal":"b02d7aeb662166ac6406bb7d6b9831cc9da3bbe087a7b31383a7b9488af4d931"}},{"id":"VRCE-1-60-3","kanda":1,"kandaId":"bala","sarga":60,"verse":3,"english":"You high-souled ones, in the west there are extensive tracts; and there in Puşkara will we peaceably carry on our austerities. That asylum is really pleasant.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1060003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ecfb6e2b18b8da3e70c8e78036eeb9af6909ae1336dd73e2d0693e1de75f4e0","compact":"b3d0943ecc9670af47b3465021ecafb681460a88366c532d15601e34f69e3301","nasal":"b3d0943ecc9670af47b3465021ecafb681460a88366c532d15601e34f69e3301"}},{"id":"VRCE-1-60-4","kanda":1,"kandaId":"bala","sarga":60,"verse":4,"english":"Having said this, that exceedingly energetic and mighty Muni (Ascetic) began to perform terrible austerities, subsisting on fruits and roots.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-4"],"status":"unreviewed"},"source":{"sanskritLocator":"1060004","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f6dddc5ed8f272561085d2f11d426d96f1e9c53fdfbbb5cb5754bb45a6599ae1","compact":"e85806c631b295e125c756f9b16f08524fc5cb128d6e4f0c9b22e0f43f01add1","nasal":"e85806c631b295e125c756f9b16f08524fc5cb128d6e4f0c9b22e0f43f01add1"}},{"id":"VRCE-1-60-5","kanda":1,"kandaId":"bala","sarga":60,"verse":5,"english":"And it came to pass that at this time that mighty lord of Ayodhyā, Ambarışa, prepared for celebrating a sacrifice.","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-5"],"status":"unreviewed"},"source":{"sanskritLocator":"1060005","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3d98c05416b7854561ec8d3f8bae38a3c3212554240de7084004c0d3b39a61e","compact":"52a7f0b2cc28c668531b6136ae2087d859d820e7d2e8c2f80872d2be31e677e6","nasal":"fb909e7c57bb0375f0172b1b0df23587d8e9869251508b1368bcaab98bd3468f"}},{"id":"VRCE-1-60-6","kanda":1,"kandaId":"bala","sarga":60,"verse":6,"english":"And as he was sacrificing, Indra stole away his sacrificial beast. And on the beast being stolen, the priest said unto the king.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-61-6"],"status":"unreviewed"},"source":{"sanskritLocator":"1060006","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c81ed61754d6c4b4002275942e