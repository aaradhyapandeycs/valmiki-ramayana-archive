[{"id":"VRCE-1-46-1","kanda":1,"kandaId":"bala","sarga":46,"verse":1,"english":"When the embryo had been sundered is seven, Díti exceedingly aggrieved humbly spoke to the irrepressible thousand-eyed deity, saying, as","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-47-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1046001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9f0b6021054ad7eac5556bfba8fa484ebb3903cdf932a9495d96c51f5b96d376","compact":"5f9d020d50ff01bfca91b2759e09a16e904cff44064584a862a27c66060c7d3a","nasal":"5f9d020d50ff01bfca91b2759e09a16e904cff44064584a862a27c66060c7d3a"}},{"id":"VRCE-1-46-2","kanda":1,"kandaId":"bala","sarga":46,"verse":2,"english":"By my fault it is that the embryo has been sundered in seven. O chief of the celestials, herein you are guilty of no transgression, o destroyer of Bala.","alignment":{"type":"1:1","confidence":0.623,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-47-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1046002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"25f31b9679a894072c1d6c51e4b75c4383eaa5fd15376edc210e69dec55a5755","compact":"daa62c940c40a291af9b40bf7dba5418d26fc1a7e6ff9428c290614394cc235f","nasal":"daa62c940c40a291af9b40bf7dba5418d26fc1a7e6ff9428c290614394cc235f"}},{"id":"VRCE-1-46-3","kanda":1,"kandaId":"bala","sarga":46,"verse":3,"english":"And since calamity has befallen the embryo, I wish to do you a good turn. Let the seven parts become the guardians of the seven Maruts.","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-47-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1046003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5851545d04daa42836cfae80a26b845fc4b69f2a9e4cc1b9a80e285e2b94e984","compact":"0f1a39bcf6ea67e1ca39