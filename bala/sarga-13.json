[{"id":"VRCE-1-13-1","kanda":1,"kandaId":"bala","sarga":13,"verse":1,"english":"After the expiry of full one year, when the sacrificial horse had returned, the sacrifice, of the king commenced on the north bank of the Sarayu.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-14-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1013001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e570c01fce539d01cf2d4be90549d09ce598ac0e27ddbe260c8a71fd3c926bb","compact":"83aa49893e3326ce1ea1ea99c714ca83ca2efa4528727fb3bed0147e71d405fd","nasal":"5cb311771b2e31e961dae9aed080b5647113ac81f24a02478cadde1ca30b71a9"}},{"id":"VRCE-1-13-2","kanda":1,"kandaId":"bala","sarga":13,"verse":2,"english":"And with Rşyasſága at their head, the principal twice-born ones began the proceedings in that mighty horse-sacrifice of that high-souled monarch.","alignment":{"type":"1:1","confidence":0.843,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-14-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1013002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f519ee4dd36be2dda7508b8dee5fc50026ff81cb398d283b34725d8af1e2cd8a","compact":"eb765bc52ad830617f7f9ac4837e178a45f0c79a7c31a6356ca4354e516fe974","nasal":"bd3b12ae6d6a287647cff9b1104a159446479daa1a4fe8ffb1734a9e355a8ba7"}},{"id":"VRCE-1-13-3","kanda":1,"kandaId":"bala","sarga":13,"verse":3,"english":"And the priests, each duly and according to the ordinance performing his proper part, engaged in the ceremony in consonance with the scriptures.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-14-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1013003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05bc1321cbb97441f3d5931328962aed91cd1fa64c03e8307c40826eeb1be1c2","compact":"03d000656a1