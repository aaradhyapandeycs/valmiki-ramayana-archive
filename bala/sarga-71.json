[{"id":"VRCE-1-71-1","kanda":1,"kandaId":"bala","sarga":71,"verse":1,"english":"When Vaideha had spoken thus, the mighty ascetic Viśvāmitra is company with Vasiștha addressed that heroic king, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-72-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1071001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bc8dc8b291599a7e6cf2bb6704655c4aaa901fef502bc08f63876e13c17a6f31","compact":"0295498c80c1a75e9b40dc8b1217e6010db72140330e45b90d2c05868f131a5a","nasal":"b00d67c4147de6fe2c3ac112bb9c87d40dbcc85c8df874cfd673a512c0ad711b"}},{"id":"VRCE-1-71-2","kanda":1,"kandaId":"bala","sarga":71,"verse":2,"english":"O puissant one, the lines of the Ikşvākus and the Vaidehas are exceedingly noble and incomparable. No other race can by any means compare with them.","alignment":{"type":"1:1","confidence":0.765,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-72-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1071002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cdc4cddb1165bf90552b34fc09f4a7a67f936f86f1330a597e9ec4bf0b9729d3","compact":"6391d76ed40e051d01bd58c05f39f8ec2fff0d58e31b7a76ccd1ecf2826562c5","nasal":"7b3b781ba53d8dc266414d6d50ca633159abdd94369effd41daa0bf52840807d"}},{"id":"VRCE-1-71-3","kanda":1,"kandaId":"bala","sarga":71,"verse":3,"english":"O monarch, this youthful union of Rāma and Lakşmaņa with Sītā and Urmilā is fit by all means; and it is worthy of their wealth of grace.","alignment":{"type":"1:1","confidence":0.704,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-72-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1071003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9c1e2a222068ab4559ac988da0acf2a2ab67a072d71639e5f9f8df72ebedc08c","compact":"7070f516acb3c35bd02f146f0838920e365df94