[{"id":"VRCE-1-44-1","kanda":1,"kandaId":"bala","sarga":44,"verse":1,"english":"Hearing the words of Viśvāmitra, Rāghava, together with Laksmana, was struck with amazement, and spoke to Viśvāmitra, saying,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-45-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1044001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"651043877cf2089d73c2298aad33764e3b72830cf64b4eea0166cd26fe6e0cec","compact":"b0d13dcb911d107f84f7c36cb4e43a6ccacc5830cd2c2b941ca9187dae1ca4c3","nasal":"b0d13dcb911d107f84f7c36cb4e43a6ccacc5830cd2c2b941ca9187dae1ca4c3"}},{"id":"VRCE-1-44-2","kanda":1,"kandaId":"bala","sarga":44,"verse":2,"english":"O Brāhmaṇa, wonderful is the story that you have recited to us, viz; that of Ganga's sacred dissension and the replenishing of the Ocean.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-45-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1044002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"61211ad7bd6b48dd75f36703b51a556d4963435a320caf914a7a1727207956d3","compact":"315f381d9871ce8bcbf04f5e9f88e7439341e5130b2821bcc95cab094da49101","nasal":"ccb91711e78ec405fa3b3dbbf86f5588f44a3459ba0a21ed1d7e74b275ce2d89"}},{"id":"VRCE-1-44-3","kanda":1,"kandaId":"bala","sarga":44,"verse":3,"english":"And the live-long night has passed away as I in company with Sumitrā's son, was pondering over Viśvāmitra's auspicious speech.'","alignment":{"type":"1:1","confidence":0.689,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-45-4"],"status":"unreviewed"},"source":{"sanskritLocator":"1044003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8933299463fb531234b28e6fda1afe7d5f2dd965d31eb8a62403efc3cb8c718","compact":"52d165494b9d0f5e3563e7ae6c45807f78d34ba9f0d6933f148194