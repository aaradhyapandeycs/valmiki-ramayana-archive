[{"id":"VRCE-1-42-1","kanda":1,"kandaId":"bala","sarga":42,"verse":1,"english":"When that god of gods had gone away, Bhagiratha, O Rāma, pressing the earth with his thumb, spent a year in adoring Siva.","alignment":{"type":"1:1","confidence":0.597,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-43-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1042001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b585e43ffc0200b1761892aca82d75364d5e926b98f948dab9390276f656bb0","compact":"7dc96f3390ad85d921f4fe0069aa36d2ba80c4229e6f230d90e08badca786c63","nasal":"9836453120cda56d71016ffaa0a6d00f0f8558bc4587b4414adc0b1a928253e4"}},{"id":"VRCE-1-42-2","kanda":1,"kandaId":"bala","sarga":42,"verse":2,"english":"And when the yea was complete, Uma's lord, Pasupati, worshipped of all the worlds, spoke to the king, saying,","alignment":{"type":"1:1","confidence":0.849,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-43-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1042002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0952a338fdb7c942729ca2759cfd460b3e5fdaca9971d64b68fc1fb8e18cac17","compact":"abf9bd0e4f3d7ba8fac15fa3da934281b6cfc793ce084f4be4f814a797b47d88","nasal":"abf9bd0e4f3d7ba8fac15fa3da934281b6cfc793ce084f4be4f814a797b47d88"}},{"id":"VRCE-1-42-3","kanda":1,"kandaId":"bala","sarga":42,"verse":3,"english":"O foremost of men, I am well pleased with you: I will do what will before your welfare. I will hold the Mountain's daughter on my head.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-43-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1042003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87f25daddd9db5afaea254fd4b3ab3cce8d52141c299c85b8eecd029990c880c","compact":"053566720837f4e705164052c6af77028f4e118bb9b0a6356b3551c35f5d8bd7","nasal":"053