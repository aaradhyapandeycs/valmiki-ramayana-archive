ment":{"type":"1:1","confidence":0.654,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-42-15"],"status":"unreviewed"},"source":{"sanskritLocator":"1041016","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f0d848d78288f0431551622dcdf669d8fa8187055da0c29295969a251ad954c","compact":"e58c4ad20f6562cab01b26c6ad91e22656c190908ccadc912a06c217462590ca","nasal":"b4e66407d4fc526336bc2a338f875f1310b81093e5194d68bf55de6579407bb5"}},{"id":"VRCE-1-41-17","kanda":1,"kandaId":"bala","sarga":41,"verse":17,"english":"If, adorable one, you are pleased with me, if you would grant me the fruit of my asceticism, may Sagara's sons receive water at my hands; and on the ashes of those high-souled ones being laved by the waters of Gangā, may my greatgrand-father without fail repair to heaven!","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-42-16"],"status":"unreviewed"},"source":{"sanskritLocator":"1041017","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"990d0704e7750f5b75657c5a17772d579e7eaedfcc95dbdeb97a587a5a9654db","compact":"9606b88206f20c02748ce2ff1549d44c2a1789dae11a06223fd60cdff90bb5c4","nasal":"9606b88206f20c02748ce2ff1549d44c2a1789dae11a06223fd60cdff90bb5c4"}},{"id":"VRCE-1-41-18","kanda":1,"kandaId":"bala","sarga":41,"verse":18,"english":"If, adorable one, you are pleased with me, if you would grant me the fruit of my asceticism, may Sagara's sons receive water at my hands; and on the ashes of those high-souled ones being laved by the waters of Gangā, may my greatgrand-father without fail repair to heaven!","alignment":{"type":"grouped","confidence":0.878,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-42-16"],"status":"unreviewed"},"source":{"sanskritLocator":"1041018","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2592e05f589d10db178b1053076d99f67cb2a710a54ebd070