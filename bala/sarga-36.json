grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-19"],"status":"unreviewed"},"source":{"sanskritLocator":"1036020","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b12ebe391d9a26c0eef0265e1905a8dfec8ece2a6763a338f88b0ea4ef9cb848","compact":"a32679f32774f05a4f60af8aee50eecd6c84e9ef620b3dd0bc02bc7f2ccbe2b0","nasal":"a32679f32774f05a4f60af8aee50eecd6c84e9ef620b3dd0bc02bc7f2ccbe2b0"}},{"id":"VRCE-1-36-21","kanda":1,"kandaId":"bala","sarga":36,"verse":21,"english":"As soon as the embryo was brought forth, the woods adjoining the mountain, being overspread with that energy, were turned into gold.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-20"],"status":"unreviewed"},"source":{"sanskritLocator":"1036021","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4b71146d26b787be2be4de12318c1abd2e18b1de88ef7e9d46dabe102dcd1bcd","compact":"6b535b4f90f09cc31d6ad59f2b14d8d36a33add7c6dbcdc6af531bc42e803525","nasal":"4fb56a03238a6d708fe9f745960682aa81d74f561db08beb9a56aefb7818edad"}},{"id":"VRCE-1-36-22","kanda":1,"kandaId":"bala","sarga":36,"verse":22,"english":"And from that day, O descendant of Raghu, gold of effulgence like to that of fire, became known as Jātarūpa, O foremost of men!","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-21"],"status":"unreviewed"},"source":{"sanskritLocator":"1036022","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aef4f390664e8d34e6c075c50d2bd37f389006b7516d0305ba3dcc0640988261","compact":"fdcf95e660a8e58d13f550ed662f5524f5896eb7c9f16b85783d7d785a9a81e1","nasal":"fdcf95e660a8e58d13f550ed662f5524f5896eb7c9f16b85783d7d785a9a81e1"}},{"id":"VRCE-1-36-23","kanda":1,"kandaId":"bala","sarga":36,"verse":23,"english":"And when the son was born, the deities with Indra and the Maruts enjoined upon the Křttikā stars to suckle him.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-22"],"status":"unreviewed"},"source":{"sanskritLocator":"1036023","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"57b2fed68a09e0f8d2a8b9e6fa60d8445805262ddbf50eab6055329a10371a15","compact":"af1a19fbb9944065ef2a125b96b164d10d2875171e3eb8acc86ec8bc64d09605","nasal":"458e24645ae4293225362c3321663886c35026be15b37278afe4a9fd081823f8"}},{"id":"VRCE-1-36-24","kanda":1,"kandaId":"bala","sarga":36,"verse":24,"english":"'Surely he shall be son to us all’-concluding thus, they as soon as he was born, by turns began to dispense milk to him.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-23"],"status":"unreviewed"},"source":{"sanskritLocator":"1036024","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4afd0437ba99e89280f2a9519b32cbec93712b2a2a6b5fb38afe52352aa00134","compact":"f11acc4229d936d85ff2f831bf646012b8567c3833093019b9f926a20aadea23","nasal":"f11acc4229d936d85ff2f831bf646012b8567c3833093019b9f926a20aadea23"}},{"id":"VRCE-1-36-25","kanda":1,"kandaId":"bala","sarga":36,"verse":25,"english":"Then the celestials called him Kārtikeya, saying, “Without doubt, this son shall become famed over the three worlds.'","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-24"],"status":"unreviewed"},"source":{"sanskritLocator":"1036025","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27b2f85a6fda7b7a9154bc19b80f3aa7d071739d915731dc53fb6378222edf95","compact":"849d06109941d3e85d2995c15ee9c8666095840fbcf49393322957a5ac88107f","nasal":"849d06109941d3e85d2995c15ee9c8666095840fbcf49393322957a5ac88107f"}},{"id":"VRCE-1-36-26","kanda":1,"kandaId":"bala","sarga":36,"verse":26,"english":"An