[{"id":"VRCE-1-36-1","kanda":1,"kandaId":"bala","sarga":36,"verse":1,"english":"On that celestial being engaged in austerities, the deities with Indra and Agni at their head, desirous of gaining over the generalissimo, Appeared before the Grand-sire.","alignment":{"type":"1:1","confidence":0.421,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1036001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"404417356ffb5360047da6607390b8f9eb46bd34e31212fc83a93703b18e2d5c","compact":"3195238f3eb4180565f36c2d5483cb191de14ad744830370f31f40bfcbdd8707","nasal":"4e8951839bf92bf48c23afe45a706ce4f353591ab7f8646a76c92e6776bb05df"}},{"id":"VRCE-1-36-2","kanda":1,"kandaId":"bala","sarga":36,"verse":2,"english":"And, O Rāma, the gods with Agni at their head, bowing to him, addressed that possessor of the six attributes, the Grand-sir, saying,","alignment":{"type":"1:1","confidence":0.757,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1036002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eec22f15b430503b1dd411e8d43d0c268eabe09606c8fd32516999504c941c00","compact":"e011a06edcec5bca32b6c9ae53909c06fa8cfd7ede2aae0ff899c251f5b0080b","nasal":"54211c4387528efbdfb9fe918cc3b62e323188d7af1a3a34393ccc010a2d8088"}},{"id":"VRCE-1-36-3","kanda":1,"kandaId":"bala","sarga":36,"verse":3,"english":"'O God, that adorable one who had formerly consigned to us the generalissimo, resorting to high asceticism, is practising austerities with Uma.","alignment":{"type":"1:1","confidence":0.922,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-37-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1036003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5fee4e5fead9f41b07faa0e82b53e98b9359d594cd24ae4117249b3016547a59","compac