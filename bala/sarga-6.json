[{"id":"VRCE-1-6-1","kanda":1,"kandaId":"bala","sarga":6,"verse":1,"english":"In that city of Ayodhyā resided king Dasaratha, versed in the Vedas, commanding all resources, far-sighted, of mighty prowess, dear to the inhabitants both rural and urban.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-6-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1006001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a1cf238e6bf554e324548dcc25ae93680797f05e124647455118725a84fcdbb","compact":"e1b65d89f5177ccb74be304bd413f41c69a02aa213a7936dbed89665530539dd","nasal":"e1b65d89f5177ccb74be304bd413f41c69a02aa213a7936dbed89665530539dd"}},{"id":"VRCE-1-6-2","kanda":1,"kandaId":"bala","sarga":6,"verse":2,"english":"He was an Athiratha in the Ikşvāku line, performing sacrifices, engaged in the performance of duties, self-controlled like a Maharși, a royal saint famed in the three worlds.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-6-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1006002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62a61fd554fe5c82c26b01fdb997a36b84c6f81662d908b17cf7a7bd3075bf17","compact":"0b890c76a25caf8fe00e1ab1acd90896dfc87e2f7fd907e1b935cf7b0b656e26","nasal":"0b890c76a25caf8fe00e1ab1acd90896dfc87e2f7fd907e1b935cf7b0b656e26"}},{"id":"VRCE-1-6-3","kanda":1,"kandaId":"bala","sarga":6,"verse":3,"english":"He possessed of strength, the destroyer of foes, having friends, of subdued senses, comparable to ſakra and Vaiśravaņa by virtue of accumulated riches and other possessions.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-6-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1006003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6070fc8fe8