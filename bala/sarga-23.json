fidence":0.78,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-22"],"status":"unreviewed"},"source":{"sanskritLocator":"1023024","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3633dc0e488cce09146bbd047af4f8cdca36e3d1ab66d6b7caf283a552f2a82a","compact":"74c306b88ac8e4c6ed88b8404d654d0757cef3bbe3f27255e032e1cc7444bf4a","nasal":"647560d9c985ca4cbedf868e9b11ceb0a3b9c0fe72bca5ba4136bb970d1f02f1"}},{"id":"VRCE-1-23-25","kanda":1,"kandaId":"bala","sarga":23,"verse":25,"english":"Her name, good betide you! was Tātakā, and she was the spouse of the intelligent Sundashe whose son is the Rākşasa, Mārīca, possessed of the prowess of Sacra; having round arms, with a huge head, a capacious mouth and a cyclopean body.","alignment":{"type":"1:1","confidence":0.891,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-23"],"status":"unreviewed"},"source":{"sanskritLocator":"1023025","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f4f3ebeca1012b1edffae3bab978dcdd1dde9639a577dc22d9eb681901ed5eb","compact":"5a452499ccbb52687e42a5f1549789a6ac51d34d635e8e10cf159eab7598b828","nasal":"13d1359f9ddfc9f0343d7cf983b22dcbe500a7cce54773eb12bed46607fe08d9"}},{"id":"VRCE-1-23-26","kanda":1,"kandaId":"bala","sarga":23,"verse":26,"english":"And that Rākṣasa of dreadful form daily frightens people. And, O descendant of Raghu, Tātakā of wicked deeds, daily commits havoc upon these countries, Maladã and Karuşă.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-24"],"status":"unreviewed"},"source":{"sanskritLocator":"1023026","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb8582df6fc0ca8c51bb23681a971e20c06a6342db8805b7ba7b5ea83f7f0e9b","compact":"bdc1ad6a6512f3bd1dd1ab1a3cc478fce484a49e7ebbd2125bdb610a2e91d029","nasal":"bdc1ad6a6512f3bd1dd1ab1a3cc478fce484a49e7ebbd2125bdb610a2e91d029"}},{