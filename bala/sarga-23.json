sanskrit-ngram","duttRefs":["DUTT-1-24-10"],"status":"unreviewed"},"source":{"sanskritLocator":"1023009","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af3c5741ceee31b91c5f412277932aaeb9bfa496627fac7a9ba333f9b1278f28","compact":"3cd4ec176adfb28d3a6814720ad59735532d1a7e8cee2e829b0d5d60880cabbe","nasal":"3cd4ec176adfb28d3a6814720ad59735532d1a7e8cee2e829b0d5d60880cabbe"}},{"id":"VRCE-1-23-10","kanda":1,"kandaId":"bala","sarga":23,"verse":10,"english":"Thereupon, both of those exceedingly righteous ones, bowed down to those streams; and betaking themselves to the right bank, began to proceed with fleet vigour.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-11"],"status":"unreviewed"},"source":{"sanskritLocator":"1023010","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"199fdeb505a7d24b5c5745499b62864e587c169e3a20e7d8e8602d66ba357e53","compact":"f893fa5ec43f93ca095b8ef438e1727fd850c4fa0b04859d2d1d9c8ebfd80972","nasal":"f893fa5ec43f93ca095b8ef438e1727fd850c4fa0b04859d2d1d9c8ebfd80972"}},{"id":"VRCE-1-23-11","kanda":1,"kandaId":"bala","sarga":23,"verse":11,"english":"And beholding a dreadful and trackless. forest, that son of the foremost of men, Ikşvāku's descendant, asked that best of ascetics.","alignment":{"type":"1:1","confidence":0.77,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-12"],"status":"unreviewed"},"source":{"sanskritLocator":"1023011","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ad5f4096d45fb38a67ed5f1bc9073d7f2ce6716fa6b5144d6893d4ce84ca6bb","compact":"677c39abf97c1c95fc310b86b5a861e5a9fe2f65200625d7429df03710ea9d33","nasal":"677c39abf97c1c95fc310b86b5a861e5a9fe2f65200625d7429df03710ea9d33"}},{"id":"VRCE-1-23-12","kanda":1,"kandaId":"bala","sarga":23,"verse":12,"english":"Ah! deep is this forest abounding in crickets; and filled with terrible ferocious beasts, and various birds possessed of shocking voices and creaming frightfully; and graced by lion, and tigers, and boars, and elephants; and crowded with Dhavas* (Grislea Tomentosa). and Asvas and Karnas (Cassia fistula) and Kakubhas and Vilvas (Aegle marmalos) and Tindukas; (Diospyros glutinosa) and Patalas (Bignonia suave-olens) and Badaris (Fujube). Whence is this dreadful forest?","alignment":{"type":"grouped","confidence":0.646,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-13"],"status":"unreviewed"},"source":{"sanskritLocator":"1023012","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"610e691945f2a2cb648ff1da5242fca61f27a202ac39a3aea07c96cc4794ae26","compact":"8764023176a83970543908cd52b41e1086b8da2a92a937437b839c57ea3cc62a","nasal":"0f05e2b84dadcca19bb82248a38801d3d378ca3f844876dc3e8c57a80ab48d14"}},{"id":"VRCE-1-23-13","kanda":1,"kandaId":"bala","sarga":23,"verse":13,"english":"Ah! deep is this forest abounding in crickets; and filled with terrible ferocious beasts, and various birds possessed of shocking voices and creaming frightfully; and graced by lion, and tigers, and boars, and elephants; and crowded with Dhavas* (Grislea Tomentosa). and Asvas and Karnas (Cassia fistula) and Kakubhas and Vilvas (Aegle marmalos) and Tindukas; (Diospyros glutinosa) and Patalas (Bignonia suave-olens) and Badaris (Fujube). Whence is this dreadful forest?","alignment":{"type":"grouped","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-24-13"],"status":"unreviewed"},"source":{"sanskritLocator":"1023013","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7bd4ec2c652196cba3aad78f051368eb083440aa4653adefa2550adea78476e7","compact":"314e0d3b4bd9b2a7b75f29360bf2dc25b2159f55bdf532476db3035cf8eb8778","nasal":"314e0d3b4bd9b2a7b75f29360bf2dc25b2159f55bdf532476db3035cf8eb8778"}},{"id":"VRCE-1-23-14","kanda":1,"kandaId":"bala","sarga":23,