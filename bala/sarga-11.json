[{"id":"VRCE-1-11-1","kanda":1,"kandaId":"bala","sarga":11,"verse":1,"english":"Then after a long while, when the charming spring had appeared on the earth, the king conceived the desire of celebrating the sacrifice.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1011001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9a0d15f68b56370e10ee6b1d25f191a7e4c784bdf58d5d36d25485b7d5e8da6c","compact":"62483942fe7ae6d59c28edcf038f71143669883988b1575c679c575025f7a94d","nasal":"8a7449045583805dd7df92b7c3e30d4759b8f6a7e254c7361b2de0dcbec1444d"}},{"id":"VRCE-1-11-2","kanda":1,"kandaId":"bala","sarga":11,"verse":2,"english":"Then bowing down the head before the Vipra effulgent like a celestial, he appointed him to undertake the ceremony, for the purpose of obtaining offspring to perpetuate his line.","alignment":{"type":"1:1","confidence":0.814,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1011002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b0fa156ed57ae4ff84d5014b41d6de62a0b519075b31daf29f8150e708fd3fa","compact":"85367fcf55c34fb247a40c1c9b697d0d519660fbc1a326582fa3e7f580c5be06","nasal":"85367fcf55c34fb247a40c1c9b697d0d519660fbc1a326582fa3e7f580c5be06"}},{"id":"VRCE-1-11-3","kanda":1,"kandaId":"bala","sarga":11,"verse":3,"english":"Then that Brāhmana said to the lord of the earth, the king, So be it! Get order the necessary provisions procured, free the horse set, and prepare a sacrificial ground on the north bank of the Sarayd.","alignment":{"type":"1:1","confidence":0.559,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1011003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bf8e722