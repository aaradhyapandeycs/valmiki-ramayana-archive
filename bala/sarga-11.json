1–94"},"sanskrit_fingerprints":{"exact":"5c2038aca932ab66d3a40c31f500104f980fa6f6fd34ac9bf874272fa1fb1247","compact":"2e7919abead773412cb15eb8540d8c21892e6b0dc7fb0487831d595a34bf3f15","nasal":"203fa7a883eb6bfb50a06935f0761a15a5fddfbfddf59c6a5b12ea0edc4ea47b"}},{"id":"VRCE-1-11-15","kanda":1,"kandaId":"bala","sarga":11,"verse":15,"english":"And prepare the sacrificial ground on the north bank of the Sarayu. And perform the ceremonies capable of securing the rites from disturbance.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-14"],"status":"unreviewed"},"source":{"sanskritLocator":"1011015","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ce086be800e848b7c351fed5ae15dbfa27e055f7a07525db6945bb8a32634b1","compact":"534bb772fac4e91f5931b02fa2a2f84e7e76bc156a243744d666180f06fe05f8","nasal":"9c4814566702ff9fd46db3766b80637f274ed14199d090c2fb8120b91bd03909"}},{"id":"VRCE-1-11-16","kanda":1,"kandaId":"bala","sarga":11,"verse":16,"english":"Surely every king is competent to perform this sacrifice yet care must be taken that no default occurs in it.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-15"],"status":"unreviewed"},"source":{"sanskritLocator":"1011016","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29e2edfd8c0ca337d5d1aa4b0aeba072f66e106b5920a9c71b5fa2a3b1d2a49f","compact":"c28ed75a0cd71f2509572a2771a79f2f6bee0ba217d32dca1caf6738e6986abe","nasal":"c28ed75a0cd71f2509572a2771a79f2f6bee0ba217d32dca1caf6738e6986abe"}},{"id":"VRCE-1-11-17","kanda":1,"kandaId":"bala","sarga":11,"verse":17,"english":"For flaws in this foremost of sacrifices are watched by learned Brahma-Rākşasas. And should it come to be celebrated in violation of the ordinance, ihe performer thereof shall meet with instant destruction.","alignment":{"type":"1:1","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-16"],"status":"unreviewed"},"source":{"sanskritLocator":"1011017","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"751ce5bbacf186bc71a839be6489428753afd84f8c76e4d42c64def35751251a","compact":"0f1496d139c247ba6aeaf2c0de3c320ea3ff415b34f0e2c99e8e7b6512cd4efb","nasal":"ab997efcceb3ca479659c1f082e55c8ba1130e3101e1cb1a66da46347cb953c6"}},{"id":"VRCE-1-11-18","kanda":1,"kandaId":"bala","sarga":11,"verse":18,"english":"And do you so order that this sacrifice of mine may be completed according to the prescribed ritual.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-17"],"status":"unreviewed"},"source":{"sanskritLocator":"1011018","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4605d5743c2ae03ef0801e26bd1e0611c4df5406f394baf6def588f5cc8185a9","compact":"345fb574313ea6d0455f3b5b468e9efb820d90a1646069f4e3bf577daef69b5e","nasal":"345fb574313ea6d0455f3b5b468e9efb820d90a1646069f4e3bf577daef69b5e"}},{"id":"VRCE-1-11-19","kanda":1,"kandaId":"bala","sarga":11,"verse":19,"english":"Thereupon honouring those words of the king, the ministers did as ordered.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-12-18"],"status":"unreviewed"},"source":{"sanskritLocator":"1011019","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9e3a77372a02f7665a079fcda69ac7d0cb345b1b802969dc1602ba1c8ae7b6a1","compact":"7d34edfccda5bd86109af3971a1580b9db0819719f5df329ce3fb62ca9ba1da2","nasal":"bea3c81e007e79c402b610c9ba64971d12e1391c25bd56531bbe76d696681422"}},{"id":"VRCE-1-11-20","kanda":1,"kandaId":"bala","sarga":11,"verse":20,"english":"And having eulogised the king knowing duty, the twice-born ones, with the Monarch's leave, departed for their respective quarters.","alignment":{"type":"1:1","confidence":1.0,"method":"sh