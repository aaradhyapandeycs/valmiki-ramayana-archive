[{"id":"VRCE-1-40-1","kanda":1,"kandaId":"bala","sarga":40,"verse":1,"english":"Being the delay on the part of his sons, King Sagara, O son of Raghu, addressed his grandson, flaming in his native energy, saying,","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-41-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1040001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"befc33cc92eee7244a18fc08f57346ed9f7775dcf5e317b5fa0044220604b5b5","compact":"5bfaa1ab5015a71e2d2f6100c27d5c45a868ccf0781d923d69c042987723d395","nasal":"feb90fb384fc3d96bc2f5be7dca66a46cac47e30b8429eb0a4a22c1d5c5cfd5d"}},{"id":"VRCE-1-40-2","kanda":1,"kandaId":"bala","sarga":40,"verse":2,"english":"You are heroic and accomplished and like to your uncles. Do you enquire into the circumstances that have befallen your uncles, as also about the way by which the horse has escaped.","alignment":{"type":"1:1","confidence":0.785,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-41-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1040002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c6856f9d41ab5ecef450d8af50b510812f61743cd31fccd8049a4a0c0572de8","compact":"186a847bf80d5c8b40242e0f4438084935a05a3b00c3b67cc9b42a28aa40556a","nasal":"186a847bf80d5c8b40242e0f4438084935a05a3b00c3b67cc9b42a28aa40556a"}},{"id":"VRCE-1-40-3","kanda":1,"kandaId":"bala","sarga":40,"verse":3,"english":"And as there are strong and mighty creatures inhabiting the Earth's interior, with the view of resisting them, do you take your how along with your scimitar.","alignment":{"type":"1:1","confidence":0.792,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-41-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1040003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ae58257808f81779c9f23c7c8fa33be0f054ac49d4bd17445