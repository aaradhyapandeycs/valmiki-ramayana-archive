[{"id":"VRCE-1-5-1","kanda":1,"kandaId":"bala","sarga":5,"verse":1,"english":"This great story of Rämāyana treats of those victorious kings commencing with Prajāpati, and having Ikşvāku for their founder, who ruled the entire earth as no other kings had done so before them, and in whose line Sagara was born Sagara who dug the ocean, and whom, while out in progress, his sixty-thousand sons followed.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1005001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e937ea644c372f6c30c8b464a121e0dfe393461a0764b21f54c814f930d3e821","compact":"5ad71e271dd68a65af49dc9acfe36d1bd8eb2fcee90690a5322d1e6bcb3a6ef7","nasal":"5ad71e271dd68a65af49dc9acfe36d1bd8eb2fcee90690a5322d1e6bcb3a6ef7"}},{"id":"VRCE-1-5-2","kanda":1,"kandaId":"bala","sarga":5,"verse":2,"english":"This great story of Rämāyana treats of those victorious kings commencing with Prajāpati, and having Ikşvāku for their founder, who ruled the entire earth as no other kings had done so before them, and in whose line Sagara was born Sagara who dug the ocean, and whom, while out in progress, his sixty-thousand sons followed.","alignment":{"type":"grouped","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1005002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83b4bed5f9884164a41301cfa3a7d4e407dd6ec0e6619d8faa1e7d739a45721d","compact":"581a7b70b8e532a628c4e9630aa1141e856c3246197f5407533a9b0d7ee1e846","nasal":"a82fa2844f6a1372a1aebe45fe6fcd52052c3591e10f8f32827b0066af56fd3d"}},{"id":"VRCE-1-5-3","kanda":1,"kandaId":"bala","sarga":5,"verse":3,"english":"This great story of Rämāyana treats of those victorious kings commencing with Prajāpati, and having Ikşvāku for their founder, who ruled the entire earth as no other kings had done so before them, and in whose line Sagara was born Sagara who dug the ocean, and whom, while out in progress, his sixty-thousand sons followed.","alignment":{"type":"grouped","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1005003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"89f1b0f6904e455b1977c5c9146d073144082e5901ab9a7692fe73623eae46e2","compact":"1301c9428de3092abfff920e36f9ceb5f0907c80b55ecb31f7cd727b1550c52e","nasal":"930e72df50beaac4c67433d5bfcb3c055d40763795fad385bf1a4a8c18f5aa45"}},{"id":"VRCE-1-5-4","kanda":1,"kandaId":"bala","sarga":5,"verse":4,"english":"We shall now chant the entire history of that dynasty from the beginning. Do you, with minds free from ill will, listen to that story conferring merit, profit and pleasure.","alignment":{"type":"1:1","confidence":0.807,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-5-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1005004","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ee753520ca1facadfc944ed92884a91cc4c2176c60922424573d4e6c3b8da0c","compact":"f14f948f74c6a7b9a9565a6c0cb9aaf0a00ab0bb0e3f941ecc24b68ca177a237","nasal":"f14f948f74c6a7b9a9565a6c0cb9aaf0a00ab0bb0e3f941ecc24b68ca177a237"}},{"id":"VRCE-1-5-5","kanda":1,"kandaId":"bala","sarga":5,"verse":5,"english":"There is on the banks of the Sarayū a great and flourishing country called Kośala abounding in corn and wealth, in which the inhabitants passed their days pleasantly.","alignment":{"type":"1:1","confidence":0.946,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-5-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1005005","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b564a864cb484365dfb4ac3127a70b6015b9755a44443df9e09b2b88a79276f0","compact":"efdb0e