171381b03a2f2411d43db94b095db62"}},{"id":"VRCE-1-37-15","kanda":1,"kandaId":"bala","sarga":37,"verse":15,"english":"Then, O son of Raghu, having gone round the saint and bowed down the head, the king went to his own capital, accompanied by his consorts.","alignment":{"type":"1:1","confidence":0.586,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-14"],"status":"unreviewed"},"source":{"sanskritLocator":"1037015","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"40d3f0f43ce15fe7ef3c2d5aba8e7d1276d651a0186ab5332064b7a5c87c1fd7","compact":"a061dc5209f63682d20047d8a77e0e48cdbff210ee81effb5da6d99b05a00f2b","nasal":"9054d594fe1d1651e2a419853e8b2d42b78c36a9f3547a5d488d1393b2bbac0e"}},{"id":"VRCE-1-37-16","kanda":1,"kandaId":"bala","sarga":37,"verse":16,"english":"And after a length of time, the elder, Kesini, bore a son to Sagara, known by the name of Asamanja.","alignment":{"type":"1:1","confidence":0.82,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-15"],"status":"unreviewed"},"source":{"sanskritLocator":"1037016","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"613fe29abc01df61735b9fd1502ba93d7e770394e65b20efec90b67939b1de1c","compact":"9a5170e5f4a9139213f236e3b2821cdb1177a826c12022748cfce6620f6ac585","nasal":"8d7159df83adc3e096208bd3719f435d5a8b8ad3a6b284912b039320b3309286"}},{"id":"VRCE-1-37-17","kanda":1,"kandaId":"bala","sarga":37,"verse":17,"english":"And Sumati, O foremost of men, brought forth a gourd. And when it burst open, out came from it sixty thousand sons.","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-16"],"status":"unreviewed"},"source":{"sanskritLocator":"1037017","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"972b68b3e02e2f39a9f76fb82661a53cf3cc0e7a5a081426419611f4f1c50f06","compact":"b6635fee0920970bf4dd8cba42f6da9f8d1faef5a5f6e3d6