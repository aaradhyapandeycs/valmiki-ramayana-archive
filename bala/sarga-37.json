[{"id":"VRCE-1-37-1","kanda":1,"kandaId":"bala","sarga":37,"verse":1,"english":"Having said those words to Rāma, composed of melodious letters, Kausika again spoke to Kākutstha, saying,","alignment":{"type":"1:1","confidence":0.891,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-1"],"status":"unreviewed"},"source":{"sanskritLocator":"1037001","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"938120ae07e9018a7733bd31a88a72ac8c0a62b7b5c3c79330f14e51840295b7","compact":"93a9cfb7f004d0626b962cfb524aafb64b19b97816993ad86aae66d55c0ee3cf","nasal":"0fe4d45ecdf19846fa7b43d49c6a6954564453888fc18094f1eeee70c1e8513c"}},{"id":"VRCE-1-37-2","kanda":1,"kandaId":"bala","sarga":37,"verse":2,"english":"Formerly there was a king-lord of Ayodhyā-named Sagara. And it came to pass that righteous one, though eagerly wishing for children was without issue.","alignment":{"type":"1:1","confidence":0.721,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-2"],"status":"unreviewed"},"source":{"sanskritLocator":"1037002","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7caa3b4ec250fc92e8a8d0d843cb1e56f6c4ae55b368d50239f0881de96ba65c","compact":"8d70aba0214701db735e5383ac544fb1c65c6a77841ef0f221c6bb86f8c2c3d9","nasal":"c2e79b4ad114ef326c7936e9c487b7956cdb17448fc40516ecc892de99a1b756"}},{"id":"VRCE-1-37-3","kanda":1,"kandaId":"bala","sarga":37,"verse":3,"english":"O Räma, Vidarbha's daughter, named Kesinī, was the elder wife of Sagara. And she was virtuous and truthful.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-3"],"status":"unreviewed"},"source":{"sanskritLocator":"1037003","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"872f1fc26c624f0230e8ec08b79c96eefa6f7dc31ed1e7a81311537fdeb0bcc4","compact":"faf978ff60f823487c6ccb60b2a980f207510c6c73807783607123bbfeb547b1","nasal":"faf978