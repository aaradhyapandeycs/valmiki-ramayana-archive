-ngram","duttRefs":["DUTT-1-38-22"],"status":"unreviewed"},"source":{"sanskritLocator":"1037023","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c83183a293bdb99abd6dec00a062758c47a51c5e9fbd1dff6e15b931bdf298d5","compact":"64eae353444fc00a471525dee823108d3b50cb63f3b007d85f3a945fc173db26","nasal":"64eae353444fc00a471525dee823108d3b50cb63f3b007d85f3a945fc173db26"}},{"id":"VRCE-1-37-24","kanda":1,"kandaId":"bala","sarga":37,"verse":24,"english":"Having determined upon it, that one versed in the Vedas set about it, in company with his priests.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-38-23"],"status":"unreviewed"},"source":{"sanskritLocator":"1037024","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"210d9fd0baa8675e0f5481f5136adb2e983d2a2be0044c0255acbdc530b4720b","compact":"f49189a6dcb75ade376434967ebf8ee016f859fc6c637a1a1dc59ca64e862f13","nasal":"f49189a6dcb75ade376434967ebf8ee016f859fc6c637a1a1dc59ca64e862f13"}}]
