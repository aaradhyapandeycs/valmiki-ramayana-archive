4175170511ef082579f4a","compact":"a23e1429a816e1fcd19dbfc85fae240c629be7df371f79849d17d8d5552d1480","nasal":"a23e1429a816e1fcd19dbfc85fae240c629be7df371f79849d17d8d5552d1480"}},{"id":"VRCE-1-32-26","kanda":1,"kandaId":"bala","sarga":32,"verse":26,"english":"And the Gandharvī Somadā rejoiced exceedingly at the completion of the nuptials of her son; and embracing her daughters-in-law again and again, and extolling her son, she expressed the fullness of her joy. And he dismissed that lord of earth, king Brahmadatta, in company with his consorts and the priests. And the Gandharvī Somadā rejoiced exceedingly at the completion of the nuptials of her son; and embracing her daughters-in-law again and again, and extolling her son, she expressed the fullness of her joy.","alignment":{"type":"split","confidence":0.653,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-1-33-25","DUTT-1-33-26"],"status":"unreviewed"},"source":{"sanskritLocator":"1032026","sanskritFile":"Ram01.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"928b91624f5804566b504b4c54d180629ac846530c6b47f613551cb45f816a8e","compact":"3d47fa6d195de54fa0dbfb0c7f75eb2e15e5988bd0f8a3945f536b82a9cf9dad","nasal":"b9db52bcfd7bf9eb1f13e528f18aaf0426d4544a996daae76b51f8c55d87d37b"}}]
