[{"id":"VRCE-3-39-1","kanda":3,"kandaId":"aranya","sarga":39,"verse":1,"english":"Being thus commended by Rāvana like a king to act against his will Mārica fearlessly addressed the lord of the Rākṣasas with the following bold words.","alignment":{"type":"1:1","confidence":0.364,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3039001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"21793dc1d8ff462e9803728adcf6b0b1352829af105eb7e2d71a05618b75783f","compact":"8ed2ca5b1ec60f6961d17b24341ed547d1205ae74c5e935a3ecf242a5f1b05c3","nasal":"8ed2ca5b1ec60f6961d17b24341ed547d1205ae74c5e935a3ecf242a5f1b05c3"}},{"id":"VRCE-3-39-2","kanda":3,"kandaId":"aranya","sarga":39,"verse":2,"english":"What person of impious deeds has advised you ( ranger of the night thus in order to exterminate you with your kingdom, counsellors and children?","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3039002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c2f36679cba78e2776c810f9d574ab922e501b739fa64b22e2e9ceda72bd07a0","compact":"92690724e6804629fe3d28520ca2ac1bc857ddcb892fb2b11b7012aaafb8a31e","nasal":"92690724e6804629fe3d28520ca2ac1bc857ddcb892fb2b11b7012aaafb8a31e"}},{"id":"VRCE-3-39-3","kanda":3,"kandaId":"aranya","sarga":39,"verse":3,"english":"Who of a vicious heart, O King, dose not feel himself happy at your welfare? Who has pointed out to you the way of your death under the cover of your means?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3039003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"68547f016c178b1f3a1c7b2bbca201592df50ad8130c92b35389a280df5e0ac6","compact":"756e9c95590ecb294940a67c4f8b22854e095111b23cf07f5a41f5338511a7ed","nasal":"aa8d0937cb8ee79440765667a1e53bf404516f7df9a0ec22bdcc78ac23f9caf1"}},{"id":"VRCE-3-39-4","kanda":3,"kandaId":"aranya","sarga":39,"verse":4,"english":"O Ranger of night surely do your weak enemies wish to bring about your destruction by making you enter into a conflict with a powerful man.","alignment":{"type":"1:1","confidence":0.794,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-4"],"status":"unreviewed"},"source":{"sanskritLocator":"3039004","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1e64468923822fba49098ecf21e538b797686369975002a2069674606827364","compact":"3aea45db2b378980291e673989e57f6b5334746bcc86807cb0930c2840d48890","nasal":"48e153412c2019745606a05f1c4fbaaa5c3aa2e0525cfa774c475bfc594dfd59"}},{"id":"VRCE-3-39-5","kanda":3,"kandaId":"aranya","sarga":39,"verse":5,"english":"What little-minded man of evil intent has counselled you thus? O Ranger of night, really do they desire that you do bring destruction upon yourself by your own actions.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3039005","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"355a3412e256598481a3c345c66d841d6cd9e472a98d9ecfd8bd1d22cf449499","compact":"16bc5ddd426f3a10b56eca6d4b1884d6136ae99b2f9994c847fa23c2641306f9","nasal":"868788d423d89b390ce4ef3f7069d26846d15236129243b53864cfad97bcdac4"}},{"id":"VRCE-3-39-6","kanda":3,"kandaId":"aranya","sarga":39,"verse":6,"english":"You do not exterminate your counsellors O Rāvana, albeit they are worthy of being destroyed. For they do not prevent these entirely from your evil course.","alignment":{"type":"1:1","confidence":0.85,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3039006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"822bed3d7ac79142e2f0ee26fb01685eaf1d75e2391558ce3e150a0f095609a1","compact":"deda270865f2aaabea1fe9c396341191873b53c1bb71918759bc7884354749a9","nasal":"fe430e5a790a80dc3a1220046801713d22c622cbe568098db12c0e703de54bde"}},{"id":"VRCE-3-39-7","kanda":3,"kandaId":"aranya","sarga":39,"verse":7,"english":"Wise counsellors do always restrain a king who wends a vicious track being guided by his impulses and passions; but about you they are quite unmindful, though you should by every means be brought under restraint.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3039007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a0ecc08db3540b644a26e0a980ad6595e02c6de1d40f9cca73725d15611de33","compact":"61e7c30704b6a42c08c770c7e53ab7512dc243972edc1f9e74e63c14fe54e6a1","nasal":"61e7c30704b6a42c08c770c7e53ab7512dc243972edc1f9e74e63c14fe54e6a1"}},{"id":"VRCE-3-39-8","kanda":3,"kandaId":"aranya","sarga":39,"verse":8,"english":"O you the best of conquerors, O you the ranger of high, ministers by the grace of their sovereign attain virtue, wealth, desires and fame.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3039008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3a61962e87703ceca1a9b78bb9e21123e7b75f16f62f2ea03dfcddd3077fc772","compact":"bfb28379938f06f0cb0cfe55c11dad74097273da1f0084660d1c059b9349654c","nasal":"af208b71dd0c105c427bb25ff535e0455fe1a750b9d8a29370c485e787600626"}},{"id":"VRCE-3-39-9","kanda":3,"kandaId":"aranya","sarga":39,"verse":9,"english":"But those objects are never attained O Rāvana when they are not in good odour with their sovereign; moreover the subjects meet with dangers when he is devoid of all qualities.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3039009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"707ad9d8200ed00c14c7e17dabac93ba10d526112680fb459697a19c30a7922e","compact":"33c025605a325c2a7c4ce59a4ba8c07e81f7971164456c3d914e50b43aa09afa","nasal":"4a14a6d899b3993d87c01925c53ce4ed7fc6a666cccc21c0df4173677dad408a"}},{"id":"VRCE-3-39-10","kanda":3,"kandaId":"aranya","sarga":39,"verse":10,"english":"O you the best of conquerors, the king is the root of virtue and fame to the subjects; he should therefore be always protected by them.","alignment":{"type":"1:1","confidence":0.717,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3039010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2f94f263e2a0373e54a529242da1aa7506473ac8e418bd0b6b35dbdf7d308c0f","compact":"11d07a36f587c1168346c4b91cb63a85e88e2e3093af778e5f2d4c8c70d755ac","nasal":"11d07a36f587c1168346c4b91cb63a85e88e2e3093af778e5f2d4c8c70d755ac"}},{"id":"VRCE-3-39-11","kanda":3,"kandaId":"aranya","sarga":39,"verse":11,"english":"O ranger of night, proud kings of cruel temperament, acting against the subjects can never administer their kingdoms.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3039011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"75431a659bb3b47374e1cff92ad90723c907e43c25a9c71bb8c7fc61f1844001","compact":"46c4bf952159c8d8fd79724db7d80069277654e3ac4e8e4708cff1b57a8698a0","nasal":"46c4bf952159c8d8fd79724db7d80069277654e3ac4e8e4708cff1b57a8698a0"}},{"id":"VRCE-3-39-12","kanda":3,"kandaId":"aranya","sarga":39,"verse":12,"english":"So do the ministers of cruel counsel meet with their end like to a chariot driven into a wild track by an unskilled charioteer.","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3039012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"feb0840dc35f527fc0695146d1d5d546c26f0117c9b1a3d847973f1955871789","compact":"c3ab162f3fea10cbd903407a859b4c3250fffa7cdf5dfc0c5f761747c1326f54","nasal":"85762f0e73a85301ef67485f8adfd9538656fcac5a1bd5ad8246985620c8f3cb"}},{"id":"VRCE-3-39-13","kanda":3,"kandaId":"aranya","sarga":39,"verse":13,"english":"Many a pious person, on this earth, ever engaged in the performance of religious services, have, for the folly of other persons, met with destruction along with their relatives.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3039013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9eafbc81ca23c529a685d075f88ccc87c79c730053a0a870ed1211ea4a00b7ce","compact":"30aeee8e84cad83e1674ed6b0d5b2ad688118119cf82ec706801f01e946dc623","nasal":"30aeee8e84cad83e1674ed6b0d5b2ad688118119cf82ec706801f01e946dc623"}},{"id":"VRCE-3-39-14","kanda":3,"kandaId":"aranya","sarga":39,"verse":14,"english":"Verily the subjects, O Ravana, can never expect to prosper under the regime of hotnatured sovereigns acting against their subjects like to deer under the protection of a jackal.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3039014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f595b8bd18f231515517d02a858d04c59139346c1400cda825f147918bbf706","compact":"39fd8b515ed752809d0855414c9fe26cc8a1f7919729b2177c2f156a944851bf","nasal":"30c640ef7c7c1422f73dbbf9325f04a758b91280d99a6e8a56edf46e676d778f"}},{"id":"VRCE-3-39-15","kanda":3,"kandaId":"aranya","sarga":39,"verse":15,"english":"O Rāvana, surely shall all the Räkşasas meet with death, who have such a stupid, harsh and lustful person like you for their king.","alignment":{"type":"grouped","confidence":0.886,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3039015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6be924c11f592d4a893706ddc90531bb8079a127e0182cd168fab223ae70bd7a","compact":"d4d1769f548176629cb84b0ef74f62b5010fc195dccb84c98989fef372b3ff21","nasal":"d084b77a5d2016ec110a7b0ec6385ceafb3a4a5031889b1b2911969de3e18e0e"}},{"id":"VRCE-3-39-16","kanda":3,"kandaId":"aranya","sarga":39,"verse":16,"english":"I shall not be the least sorry if I do meet with a sudden accident—what I do deplore most is that you shall meet in no time with destruction along with your soldiery.","alignment":{"type":"1:1","confidence":0.475,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3039016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fe6781c6a014d21b986f527560b5f491bacc3eca21e6d87aab6631b5683eeb1c","compact":"f008b20310dfb6681b396aca2e9a81a176219d71ce40bc2c7d957767578db61b","nasal":"f008b20310dfb6681b396aca2e9a81a176219d71ce40bc2c7d957767578db61b"}},{"id":"VRCE-3-39-17","kanda":3,"kandaId":"aranya","sarga":39,"verse":17,"english":"Compassing my end Rāma shall exterminate you in no time and blessed I shall be being killed by an enemy in the conflict.","alignment":{"type":"1:1","confidence":0.71,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3039017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"44f5771421d322c76ab6eb300d8f10028c62b4c56eeb263f104a42ffb02129c1","compact":"77bac08e49bcf5cccfbc9ea3c93c87481b3b2f3ce39772b7d0ff45b6a4c2046a","nasal":"77bac08e49bcf5cccfbc9ea3c93c87481b3b2f3ce39772b7d0ff45b6a4c2046a"}},{"id":"VRCE-3-39-18","kanda":3,"kandaId":"aranya","sarga":39,"verse":18,"english":"Surely do you know that no sooner shall I see Rāma I shall be done away with; you shall carrying away Sītā meet with your end along with your kinsmen.","alignment":{"type":"1:1","confidence":0.842,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3039018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e209e8802bf4d3d768f0c7695d46f332e3dff86b3f1b37b588399c68617b0487","compact":"32f46fed8290a39a9b5c93695cebcdd6b6a66ad14dc177442ae7ba276d476b9e","nasal":"793981eb895ea10953ebcf7b6d2109112c43d18ffa79854f109022789058445b"}},{"id":"VRCE-3-39-19","kanda":3,"kandaId":"aranya","sarga":39,"verse":19,"english":"And if do you bring Şītā with me from the asylum, none shall be saved, me, yourself, the city of Lankā and the Rākşasas.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3039019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04163fa3eb4c40a300e8f413f72622373eb109ff5d1ae8dcbc82e824ae70afd2","compact":"e2169017fd378ee92ccb4a6ad0cf91b982235de6ef1167ae35243dfe3fc5a4a4","nasal":"9e50388577f7d432bb366369350acf8706b96ff2b1e75dc9637d970bb9bffd90"}},{"id":"VRCE-3-39-20","kanda":3,"kandaId":"aranya","sarga":39,"verse":20,"english":"You do not relish my words O ranger of the night though prevented by me, who wishes you welfare; those men who range on the verge of death, well-nigh finishing the term of their existence do not receive with good grace the counsels of friends.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-41-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3039020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"774ef63a4dc611f75445d8682eb5e6d8860a0a434d100566a9403ccb08902f51","compact":"71075e0bf9b17fc245c69bca8b41891e316140640c57f0d4b27ca362f219ab5d","nasal":"49c18ead1ed019641dc711bdc815201c2400679bf1b43d44efe294f92b6ffa39"}}]
