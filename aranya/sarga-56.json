[{"id":"VRCE-3-56-1","kanda":3,"kandaId":"aranya","sarga":56,"verse":1,"english":"Seeing Lakşmana cast down, cheerless, and come without Vaidehī, the righteous son of Dasaratha, asked him.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3056001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"808f567c45f20a8d42322ca0a2729fae3180683147edf12d593df99a955799e8","compact":"6d3063c52ad78a8025455389f266f3bde5437a8d980528fbef77c7201feb8629","nasal":"6d3063c52ad78a8025455389f266f3bde5437a8d980528fbef77c7201feb8629"}},{"id":"VRCE-3-56-2","kanda":3,"kandaId":"aranya","sarga":56,"verse":2,"english":"Where, O Laksmana is that Vaidehi, who has followed me to the Dandaka forest, and leaving whom you have come hither?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3056002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"521d1cd3217d3247f6e4474a6859e6b888a810d59d99b024dc345865780632db","compact":"8de00fd7a4ffa3827f5094c9b06f538caf39acabe333435bcb9f401f75d49776","nasal":"839aff8a49163ffa539c284725be023e86669b3206d4c1221e0a5e7852230b33"}},{"id":"VRCE-3-56-3","kanda":3,"kandaId":"aranya","sarga":56,"verse":3,"english":"Where is that one of a slender waist, who is the help in trouble of me, deprived of my kingdom, dispirited, and running about the Dandakas?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3056003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"725ab1a8b7239d0f11aee19a6d955e7ee1b895fbaa0047aa554590269ddc273a","compact":"5f8cbe31ea393245424c51377a0f5d99eef560887b74188d966019b8c0de2c81","nasal":"b52a14d114a03c5118609c832357a1b53d19506a3d2e3b6573eac752097a9446"}},{"id":"VRCE-3-56-4","kanda":3,"kandaId":"aranya","sarga":56,"verse":4,"english":"Without whom, O hero, I cannot live for a moment-where is that life's help of me Sītā resembling the daughter of a celestial?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3056004","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"37fe6a24c700ac09867c646f8a3ea4d1fb9ccacd7e0a22b2a787a13df2020c20","compact":"d565a79e5f368cd7fdf9f68295ad7083c97619734a9ecafef0eaa137081da49f","nasal":"d565a79e5f368cd7fdf9f68295ad7083c97619734a9ecafef0eaa137081da49f"}},{"id":"VRCE-3-56-5","kanda":3,"kandaId":"aranya","sarga":56,"verse":5,"english":"O Laksmana, without Janaka's daughter (hued) like burning gold, I covet not the sovereignty of the celestials or the earth.","alignment":{"type":"1:1","confidence":0.734,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3056005","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"56b76ab2b7f4d305664e791b62c9b17be7fa87e763748bc28fc15cfd81385c3b","compact":"551421cfb9238764184606465f85d838fad5a468ae49982608daf0ae82245e27","nasal":"551421cfb9238764184606465f85d838fad5a468ae49982608daf0ae82245e27"}},{"id":"VRCE-3-56-6","kanda":3,"kandaId":"aranya","sarga":56,"verse":6,"english":"Is Vaidehī, dearer to me than my life still living? Shall this exile of mine be of no avail?","alignment":{"type":"1:1","confidence":0.821,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-25"],"status":"unreviewed"},"source":{"sanskritLocator":"3056006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04d1ac1e0236a3dcc184804e67159eec1a83b1030ac473b9e2c644081482523a","compact":"c8efe769c456d43099c648e96d6bdcc6b30ea14698dbd2d5e291014703fcbbc0","nasal":"c8efe769c456d43099c648e96d6bdcc6b30ea14698dbd2d5e291014703fcbbc0"}},{"id":"VRCE-3-56-7","kanda":3,"kandaId":"aranya","sarga":56,"verse":7,"english":"O Sumitrā's son, on my dying for Sītā and your returning (to the city). shall Kaikeyi have her desire, and attain felicity; and shall Kausalyā, her son dead, and herself wearing the guise of a female mendicant, humbly wait upon Kaikeyi when she shall have succeeded in obtaining the kingdom for her son?","alignment":{"type":"grouped","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-26"],"status":"unreviewed"},"source":{"sanskritLocator":"3056007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"042fabb2a2eae533a0c2444b774a573ac5f1a285aef8cdc30df1451176314394","compact":"a9511268fb0d19f600f6cee7e9826688c9fdf726f1928be5ec9b0ce9d7ff3c5c","nasal":"a9511268fb0d19f600f6cee7e9826688c9fdf726f1928be5ec9b0ce9d7ff3c5c"}},{"id":"VRCE-3-56-8","kanda":3,"kandaId":"aranya","sarga":56,"verse":8,"english":"O Sumitrā's son, on my dying for Sītā and your returning (to the city). shall Kaikeyi have her desire, and attain felicity; and shall Kausalyā, her son dead, and herself wearing the guise of a female mendicant, humbly wait upon Kaikeyi when she shall have succeeded in obtaining the kingdom for her son?","alignment":{"type":"grouped","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-26"],"status":"unreviewed"},"source":{"sanskritLocator":"3056008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"adb15f7e1ee2497f11dd7eab132522982da4a3fb01dc4d876b590900b09c5361","compact":"c3e96e3efa76b1e90f1f15294eb72e88230ffd17e337b2f72c62d8b632a2d064","nasal":"c3e96e3efa76b1e90f1f15294eb72e88230ffd17e337b2f72c62d8b632a2d064"}},{"id":"VRCE-3-56-9","kanda":3,"kandaId":"aranya","sarga":56,"verse":9,"english":"If Vaidehī live, I will then return to the asylum; but O Lakşmaņa, if that one of excellent character should happen to be dead, I will also renounce my life.","alignment":{"type":"1:1","confidence":0.89,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-27"],"status":"unreviewed"},"source":{"sanskritLocator":"3056009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0cac31af13886d8382b35b7b9194e5f92d79d09608faef5cfb0062ee07c9fd6e","compact":"f41a1b5be0864fa9370e2ebab978972936540a47f933682f58673f821ffe2ce0","nasal":"f41a1b5be0864fa9370e2ebab978972936540a47f933682f58673f821ffe2ce0"}},{"id":"VRCE-3-56-10","kanda":3,"kandaId":"aranya","sarga":56,"verse":10,"english":"If, O Laksmana, Vaidehi ever precluding her speech with a smile should not speak to me when I arrive at the asylum, I shall give up my life.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-28"],"status":"unreviewed"},"source":{"sanskritLocator":"3056010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a8a75967b61af0aa6445765aba76e60ba8c3c40ce0224a5d2d856f97c51d4cca","compact":"1aef5ba52bf57e0a6a18abdfd2fc15866447bdecd77aab6d4ef6010d0ccf4e71","nasal":"1aef5ba52bf57e0a6a18abdfd2fc15866447bdecd77aab6d4ef6010d0ccf4e71"}},{"id":"VRCE-3-56-11","kanda":3,"kandaId":"aranya","sarga":56,"verse":11,"english":"tell me, O Laksmana, whether Do you Videha's daughter live or not; or whether, in consequence of your acting heedlessly, that forlorn wench has been devoured by Raksasas.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-29"],"status":"unreviewed"},"source":{"sanskritLocator":"3056011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dfdb13934c9ab98f4411bfaf7c99e249366ade1d1b12080304691919ee237764","compact":"83697df395fde667ed6848d7e051ba1d8bce0500a017cf396aab20acf852890b","nasal":"83697df395fde667ed6848d7e051ba1d8bce0500a017cf396aab20acf852890b"}},{"id":"VRCE-3-56-12","kanda":3,"kandaId":"aranya","sarga":56,"verse":12,"english":"Of a tender frame, and a mere girl, Vaidehi, never having experienced unhappiness being cast down, surely weep for my separation.","alignment":{"type":"1:1","confidence":0.823,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-30"],"status":"unreviewed"},"source":{"sanskritLocator":"3056012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5d90bcf3c848c7818f7b337633ebf5473d2014615edd6d09e1623779449627bb","compact":"2525f2863cd792ece54d4ddd0e7dfe38a7803d524635954c489ab9004afb574c","nasal":"2525f2863cd792ece54d4ddd0e7dfe38a7803d524635954c489ab9004afb574c"}},{"id":"VRCE-3-56-13","kanda":3,"kandaId":"aranya","sarga":56,"verse":13,"english":"When that exceedingly wicked Rākşasa cried, Lakşmaņa at the top of his voice, was you also seized with fear?","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-31"],"status":"unreviewed"},"source":{"sanskritLocator":"3056013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55e28aae5e36d2f5cf6d04d6ea4e8659364cf9e37004c2f616dc274f819a6467","compact":"9c96fcc3a7178155ddd35f9bb442dc4b0c3b7c271d8632092f92485722c160f1","nasal":"9c96fcc3a7178155ddd35f9bb442dc4b0c3b7c271d8632092f92485722c160f1"}},{"id":"VRCE-3-56-14","kanda":3,"kandaId":"aranya","sarga":56,"verse":14,"english":"And I apprehend that voice resembling mine was heard by Vaidehī; and, despatched by her from fear, you may have come hither swiftly to see* me. Some texts-to rescue me.","alignment":{"type":"1:1","confidence":0.843,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-32"],"status":"unreviewed"},"source":{"sanskritLocator":"3056014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"696f35c9cbdc7f5da15858a685116c4215f8e2a811a855503d871ca92aaadabc","compact":"b33f0493d89771b2d7d922d4431f7c310b243792e508ebd837fb029a7fb997b8","nasal":"e9c387b69f822bff76fc93ec3c7f96ea9d0109e62d097961c9b5c61638752017"}},{"id":"VRCE-3-56-15","kanda":3,"kandaId":"aranya","sarga":56,"verse":15,"english":"You have every way acted unwisely in having left Şītā alone in the wood. By this you have afforded opportunity to the cruel Rākşasas to repair the mischief (I have done them).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-33"],"status":"unreviewed"},"source":{"sanskritLocator":"3056015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f7e3a98697e737bb52286a2ea64b3a6d87627829cf698bf011e9df339d09fd7","compact":"f817e4d6984a8bd8cad35a5b2ad5361d60858e6dcc98d32c2a295e26201400df","nasal":"4ad81294df7eb53abd5d1d361e3b9d4395520c0faf08e4a9469e3f96bd68f1ce"}},{"id":"VRCE-3-56-16","kanda":3,"kandaId":"aranya","sarga":56,"verse":16,"english":"The Rākşasas subsisting flesh are aggrieved because of Khara having been slain; and now, without doubt, those terrible ones have slain Sita.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-34"],"status":"unreviewed"},"source":{"sanskritLocator":"3056016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"74fae31c67d7d9b8720366eacfbd87a092e20097cde43b831591893e2f4ea2d9","compact":"1d15a952bea2f80a08a0ec9f701f6453e8b03b47fda37206364d34686caa30d2","nasal":"1d15a952bea2f80a08a0ec9f701f6453e8b03b47fda37206364d34686caa30d2"}},{"id":"VRCE-3-56-17","kanda":3,"kandaId":"aranya","sarga":56,"verse":17,"english":"Alas! absolutely sunk am I in peril, O destroyer of foes. What shall I do now? I fear such an event was appointed for me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-35"],"status":"unreviewed"},"source":{"sanskritLocator":"3056017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc533ebe28e4421529ac296a67e7d6cc54a2db71e9456726c0390a9ee3361b18","compact":"b70d62a5dd5ee763e131252e2e6ef0950b9b1c4a128b53a0e37c3f2cf4e8e1ac","nasal":"b420fd725bf904b7f0bc67a080979c6d34469c47fa00b81b842643ca37e368c4"}},{"id":"VRCE-3-56-18","kanda":3,"kandaId":"aranya","sarga":56,"verse":18,"english":"Thus thinking of Sītā, paragon among women, Rāghava hastily went to Janasthāna in company with Laksmana. on","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-36"],"status":"unreviewed"},"source":{"sanskritLocator":"3056018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bbe871abe0bdc9d75aa38f2823d25f850cebaf030cb04cc2af0d27702d711730","compact":"4ee47c0b5e71ec861428dfa0b214e0d6b87e26502e4b23b2e58d3aa998acc124","nasal":"164774c83ee5376171b2a5c8b79169e2043017d78779ffbb87b5412757750aa0"}},{"id":"VRCE-3-56-19","kanda":3,"kandaId":"aranya","sarga":56,"verse":19,"english":"Taking to task his younger brother of distressed visage, Rāma, afflicted with hunger and thirst, and dejected in spirits, sighing heavily with a countenance turned pale, entered the asylum and found it vacant.","alignment":{"type":"1:1","confidence":0.796,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-37"],"status":"unreviewed"},"source":{"sanskritLocator":"3056019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c7762a45f8b482483aedc85266dab2109b9072b9e116bf02edbdfb93e18ec4a","compact":"f181096f4651db3062f6a384bbc9170a7f33115423cebe905c6d6dd4a547b77c","nasal":"3af7bf946d4893dd13f9769b5427ce0be4205f778a4b91cf6e62619fdcd0b0f2"}},{"id":"VRCE-3-56-20","kanda":3,"kandaId":"aranya","sarga":56,"verse":20,"english":"And entering his own asylum that hero went to the play-grounds (of Sītā) and remembering the sporting ground (of Sītā) in that abode, he was filled with grief and his down stood on end.","alignment":{"type":"1:1","confidence":0.91,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-38"],"status":"unreviewed"},"source":{"sanskritLocator":"3056020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"457b0305b0f6216b633b67447491b6b952c0cd425c031f3f1c021c91a741bc77","compact":"5521643fb437a37a03487c6fdaa32b2d3e68a5521b25535caa8a3a183f7e9a89","nasal":"5521643fb437a37a03487c6fdaa32b2d3e68a5521b25535caa8a3a183f7e9a89"}}]
