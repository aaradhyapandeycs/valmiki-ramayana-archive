[{"id":"VRCE-3-38-1","kanda":3,"kandaId":"aranya","sarga":38,"verse":1,"english":"As a person desirous of meeting with his end dose not take medicine, Ravana, the king of night-rangers paid no heed to the appropriate and sound words of Márica skilled in speech, foreboding good to him.","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3038001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"24063ec658f80071b140e49d424099e33fe9cb62973aab61c93ede84214222e1","compact":"55fb0258d984ceadad420e843147dce28834eb411f570db6b8b12e2c8ced3f63","nasal":"55fb0258d984ceadad420e843147dce28834eb411f570db6b8b12e2c8ced3f63"}},{"id":"VRCE-3-38-2","kanda":3,"kandaId":"aranya","sarga":38,"verse":2,"english":"Moreover he addressed him with the following harsh words.","alignment":{"type":"1:1","confidence":0.85,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3038002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1718db562bf01a731771a07d1a70f3b7dfe5560ae4ab1c37482d4c5ab94c13a2","compact":"87379b5d259f310ed9550fe0ed31fad3d1d5753240884d87d574cc9a88999e54","nasal":"87379b5d259f310ed9550fe0ed31fad3d1d5753240884d87d574cc9a88999e54"}},{"id":"VRCE-3-38-3","kanda":3,"kandaId":"aranya","sarga":38,"verse":3,"english":"O, Marica, what you have spoken to me, shall bear no fruit like to seeds sown into a desertland.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3038003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"256a2f368c4e28847d14da94c3197cbe9c131184e38bb7610825e9493035a0fc","compact":"b521ec453ae9d96c352a908819b7751ebf787bce5ffc717de232508ec3496552","nasal":"b521ec453ae9d96c352a908819b7751ebf787bce5ffc717de232508ec3496552"}},{"id":"VRCE-3-38-4","kanda":3,"kandaId":"aranya","sarga":38,"verse":4,"english":"I shall not be frightened thereby to fight with that foolish Rāma—a human being of vicious deeds.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-4"],"status":"unreviewed"},"source":{"sanskritLocator":"3038004","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"94e6f0c4d7258436a6975998a686b5c1268d0e96f09401332f34813618b91899","compact":"ad3c740e216135224cdb92e56fad7760396d8bf829432e3c98d1b727fe9678fc","nasal":"ad3c740e216135224cdb92e56fad7760396d8bf829432e3c98d1b727fe9678fc"}},{"id":"VRCE-3-38-5","kanda":3,"kandaId":"aranya","sarga":38,"verse":5,"english":"Surely shall I before you take away from that Rāma the destroyer of Khara his favourite wife, at whose words he has sojourned into woods renouncing his father mother, kingdom and friends.","alignment":{"type":"grouped","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3038005","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78662b43a5af96ba9708d9801388f668d3ce34e97ea6d4bbd8880142295f4e87","compact":"ac8122b9212d038782a67d0933f40ba52d42210979cc6533b153e10edce898ce","nasal":"ac8122b9212d038782a67d0933f40ba52d42210979cc6533b153e10edce898ce"}},{"id":"VRCE-3-38-6","kanda":3,"kandaId":"aranya","sarga":38,"verse":6,"english":"Surely shall I before you take away from that Rāma the destroyer of Khara his favourite wife, at whose words he has sojourned into woods renouncing his father mother, kingdom and friends.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3038006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"08f33a993b8236867cf14e79d0bd7ed3db66c18c6dbd534247bfbb9d5e85db52","compact":"fd68961beb58dd101c041d99c167aa845db4046cd997db298b92d02293a8d7f5","nasal":"fd68961beb58dd101c041d99c167aa845db4046cd997db298b92d02293a8d7f5"}},{"id":"VRCE-3-38-7","kanda":3,"kandaId":"aranya","sarga":38,"verse":7,"english":"I have made this firm resolution in my mind O, Marica; even Indra, with the celestials and Asuras shall not be able to shake it.","alignment":{"type":"1:1","confidence":0.618,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3038007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d2c620cb6033ca30062466b17ebfa4f04489390b1f54ba098489580d265f6254","compact":"f4451b75077529b2431de22db529e5bab2149a4e72bd3072f5d3fea996f89d01","nasal":"733a5a9233ba9b7cc39491cb6e662373838be7f7c13a5fbbbe69c84e6dd38409"}},{"id":"VRCE-3-38-8","kanda":3,"kandaId":"aranya","sarga":38,"verse":8,"english":"It would have been proper for you to give vent to these expressions had I but asked you for advice to ascertain my duty, the propriety or impropriety of my action its way or losses,","alignment":{"type":"1:1","confidence":0.691,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3038008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05554ea531701fdd7c6ee7c0dc9c73dd82aac0f4e2f6ad8c85629cd25e153634","compact":"5eda9b77984e76261d156450627cc0e4b9255c5df4a188ea913e851d2d0faf81","nasal":"5eda9b77984e76261d156450627cc0e4b9255c5df4a188ea913e851d2d0faf81"}},{"id":"VRCE-3-38-9","kanda":3,"kandaId":"aranya","sarga":38,"verse":9,"english":"A wise counsellor who wishes prosperity to himself should always communicate to his master his desire with joined hands whenever asked to do so.","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3038009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"61f956b3893496b0690d4a49979f4d0652db7442166c4ecd3f43538a50e23e97","compact":"6b7579f974198c05a454fe82da5d4a9c64ece6b96cebb27c4cb78d3dcdb589d2","nasal":"e81ebf5099b5bcf39cd8ded9dc0955b976d3af7a41d1fe541e645b860cce8fdd"}},{"id":"VRCE-3-38-10","kanda":3,"kandaId":"aranya","sarga":38,"verse":10,"english":"It is always proper to speak before monarchs such pleasant and favourable words as are intended for the welfare of the master and are sanctioned by the royal etiquette.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3038010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a17d0e249ffa98ccdade11c9a1c9b01e7356ea466750b78481ea13a4294a6027","compact":"24cd58bb1f75ce585ee84aee38f1d9a7d7bae695e7c12cea811fef8f3f1cfc7b","nasal":"24cd58bb1f75ce585ee84aee38f1d9a7d7bae695e7c12cea811fef8f3f1cfc7b"}},{"id":"VRCE-3-38-11","kanda":3,"kandaId":"aranya","sarga":38,"verse":11,"english":"A respectable king dose not receive with good grace friendly words even when they are expressed disre .pectfully.","alignment":{"type":"1:1","confidence":0.413,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3038011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cb8afe10f166b7ea836dfc83f9a8ae468564e5acde49c1d65d71b00b77a75cc9","compact":"af89aeff19239a1d171102769876515d3c7421eeab94bf1bc7e8e746ff8a9460","nasal":"a1cbf28937d97adac3873406b68c828aadb145de861251ce0b23ef71f1134ab1"}},{"id":"VRCE-3-38-12","kanda":3,"kandaId":"aranya","sarga":38,"verse":12,"english":"Sovereigns of superb prowess assume the semblance of five deities–Agni, Indra, Moon, Yama, and Varuna. Powerful kings, O Ranger of the night, assume haughtiness, power, a placid look and contentment and administer punishment to the wicked.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3038012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1a728600cddff0dc9021d81c23f3241491cb76b74cbe1f5bb90db302e12c7a3","compact":"4f0b8a3fc721a821db044ee76105ca2a028d2655e0423fd149a443c779e123a9","nasal":"7573b7b5b97896d8032dd375b6d7d3712fecc959aae0c8a274257f562fae95e7"}},{"id":"VRCE-3-38-13","kanda":3,"kandaId":"aranya","sarga":38,"verse":13,"english":"They are to be adored and honoured therefore on all occasions. You are ignorant of kingly morality and fully absorbed in illusion. It is for this that you do out of your wickedness of heart address me your guest with these harsh words. I do not ask you, O, Raksasa about the propriety (of my conduct) or about my welfare.","alignment":{"type":"grouped","confidence":0.703,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3038013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c0b678ccca78cb206fc45d8347ceabb56e887d98fb31ff108f78484a4c929b87","compact":"c47e9b0572ca8ae4c4f0d4840f808220cfbd6730572e7579b2bb33c86ac21ecb","nasal":"c47e9b0572ca8ae4c4f0d4840f808220cfbd6730572e7579b2bb33c86ac21ecb"}},{"id":"VRCE-3-38-14","kanda":3,"kandaId":"aranya","sarga":38,"verse":14,"english":"They are to be adored and honoured therefore on all occasions. You are ignorant of kingly morality and fully absorbed in illusion. It is for this that you do out of your wickedness of heart address me your guest with these harsh words. I do not ask you, O, Raksasa about the propriety (of my conduct) or about my welfare. I did only ask you for your help.","alignment":{"type":"split","confidence":0.448,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-12","DUTT-3-40-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3038014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b21f47b43238437a14e1acb3be96c7b42d14bb458297598180de10c75f3d6cd1","compact":"116abe8efc989543394a69ff3e6ad16169aa5ac1a40f9e23f2f09475d7ee2e14","nasal":"116abe8efc989543394a69ff3e6ad16169aa5ac1a40f9e23f2f09475d7ee2e14"}},{"id":"VRCE-3-38-15","kanda":3,"kandaId":"aranya","sarga":38,"verse":15,"english":"Listen what you shall have to do at my request in my aid; assuming the shape of a deer having golden skin painted with silvery drops do you proceed to the asylum of Rāma, and ranging at large before Vaidehī do you after captivating her take your wished-for way.","alignment":{"type":"1:1","confidence":0.786,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3038015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ffce97426ae0710c524e785318f57a285828fd44ac9dc65032328c78267512e7","compact":"8fd3b0ee68f9832a6124ec717f05ad4d50d9d041a8a6f9b6f8d8fcf194c997d4","nasal":"d1289a2a49b746a06521c426aad18f01cc3f151193810f060a4beedbf702939c"}},{"id":"VRCE-3-38-16","kanda":3,"kandaId":"aranya","sarga":38,"verse":16,"english":"Vaidehi, being struck with wonder seeing you a golden deer capable of illusions, shall request Rāma to get you soon for her.","alignment":{"type":"1:1","confidence":0.794,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3038016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"75de86184fc0d56ab383ee3c6317f975a2d94f20c94902f8e002cab9835fb24b","compact":"a124da3d60231d6869872e92b823c8c107e57243f63617f6b5163a506c185a48","nasal":"4c53798730175806039143169b5d50318a7489046c8465f2af86518eed8d82b4"}},{"id":"VRCE-3-38-17","kanda":3,"kandaId":"aranya","sarga":38,"verse":17,"english":"Kākutstha issuing out of the asylum, you shall, at a great distance utter such cries as O Sītā, O Lakşmaņa imitating his (Rāma's) voice. When both Rāma and Laksmana shall go elsewhere in this way, I shall to my felicity carry away Vaidehī like to the thousand-eyed deity carrying away Sací.","alignment":{"type":"split","confidence":0.734,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-16","DUTT-3-40-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3038017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5eadb105e3fcf53170c9d3e770d1f2fa1f669678ba4024911ceea9afbef018b2","compact":"91584acef9fafd99893fb2cbbbe27631538c88f0c89680b8c83300eb744f3110","nasal":"c21b5e3194ea82c0d05bf88af3775a8ecfa08eddff404b8f3a071c58d7a2ca08"}},{"id":"VRCE-3-38-18","kanda":3,"kandaId":"aranya","sarga":38,"verse":18,"english":"O Rākşasa, do you go wherever you like after doing this. I shall confer on you, O Mārīca, half of my kingdom.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3038018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3f37d76953af4ebf7f768d2d252702c66ec8b3d42cfe4e9f6c10ca8d855ed96","compact":"513f73f9eeaf894bd65f055a0d92e0c2d8d5c71bf1ec7de06b351a1add53f55b","nasal":"513f73f9eeaf894bd65f055a0d92e0c2d8d5c71bf1ec7de06b351a1add53f55b"}},{"id":"VRCE-3-38-19","kanda":3,"kandaId":"aranya","sarga":38,"verse":19,"english":"O you of auspicious look, do you proceed towards the forest of Dandaka to compass this end of mine; I shall follow you in my chariot, Acquiring Sītā without any conflict, after imposing upon Rāma I shall return to Lankā successful along with you.","alignment":{"type":"split","confidence":0.623,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-20","DUTT-3-40-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3038019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2ff75af297bfd7531e67658a58a787ab4975871619166985610d93a1bffbd24d","compact":"206c5d2ae953d472b5986e49f6e0dcc971470ab2ba2ce698b823fd8ec4bd3e1a","nasal":"0941dc3a15ead40bb9a5513f6133a762fc1ec8422b048b0d8dfe783b893a949d"}},{"id":"VRCE-3-38-20","kanda":3,"kandaId":"aranya","sarga":38,"verse":20,"english":"I shall kill you, O Mārīca, if do you not obey my behest. I shall compel you to do this. No body can attain to prosperity and happiness, acting against his sovereign's will.","alignment":{"type":"1:1","confidence":0.807,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3038020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cbfede08b22612437b4585bcf22c17adf5dd1d3c3b6382f3d72b82769a8e5c6a","compact":"aefa420a3699548ae4a7f752670bbed72129bbf2968ec85e5e7fa88fa05bd56f","nasal":"aefa420a3699548ae4a7f752670bbed72129bbf2968ec85e5e7fa88fa05bd56f"}},{"id":"VRCE-3-38-21","kanda":3,"kandaId":"aranya","sarga":38,"verse":21,"english":"Truly shall you risk your life if you approaches Rāma, but you shall meet with sure destruction if do you act against my will. Consider about it, and do what you think proper.","alignment":{"type":"1:1","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-40-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3038021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f1913eb60dcc252bd6b02d0b688fdd95388191e152d4d0fff4c9c12e63b438de","compact":"856f311f7c5994d1c75a911908fd1d07a957501602b963079c9dac5750ccc28d","nasal":"856f311f7c5994d1c75a911908fd1d07a957501602b963079c9dac5750ccc28d"}}]
