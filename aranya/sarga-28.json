[{"id":"VRCE-3-28-1","kanda":3,"kandaId":"aranya","sarga":28,"verse":1,"english":"And to Khara deprived of his car standing with a mace in his hand, that exceedingly energetic one, Rāma, precluding his speech with mildness, spoke.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3028001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e63f24789874d1153b7f98268d5bb5cdbb8aab48eae3728cdeb895ac1b6c2756","compact":"323fa9f2d6cd946836ac03555f9585099e0783dc965dd84d76dc7acd8ac7e0a9","nasal":"6827470d76f0d770296f8c1060b2ec31201e99f6a3b92ee035e6c4528cce4c7f"}},{"id":"VRCE-3-28-2","kanda":3,"kandaId":"aranya","sarga":28,"verse":2,"english":"Backed by this mighty host abounding in elephants and horses and cars, you have done an exceedingly wicked deed, execrated by all the worlds. Even if one happen to be the lord of the three worlds, one given to troubling creatures, and who is cruel and engaged in wicked acts, can not exist. All persons destroy, like a snake that has intruded itself, him that dose cruel deeds, hostile to the interests of every one.","alignment":{"type":"grouped","confidence":0.691,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3028002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eedd031220d865c974fc9b7fa20b9ebb68a5edb31c72ade9c0052b1b7a3d0a96","compact":"c1652804a20f32b243465a73f1dbaa309ff20b606652a92718fa255c94abd0ac","nasal":"c1652804a20f32b243465a73f1dbaa309ff20b606652a92718fa255c94abd0ac"}},{"id":"VRCE-3-28-3","kanda":3,"kandaId":"aranya","sarga":28,"verse":3,"english":"Backed by this mighty host abounding in elephants and horses and cars, you have done an exceedingly wicked deed, execrated by all the worlds. Even if one happen to be the lord of the three worlds, one given to troubling creatures, and who is cruel and engaged in wicked acts, can not exist. All persons destroy, like a snake that has intruded itself, him that dose cruel deeds, hostile to the interests of every one.","alignment":{"type":"grouped","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3028003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55e9c71da7f1195098b486b83e3184280e9dbedf76040a5c73812cc2e1ceb023","compact":"6616d13d4a353461a1f99f61172b876e47ef4b401692f290f6dc7b2305e202aa","nasal":"6616d13d4a353461a1f99f61172b876e47ef4b401692f290f6dc7b2305e202aa"}},{"id":"VRCE-3-28-4","kanda":3,"kandaId":"aranya","sarga":28,"verse":4,"english":"Backed by this mighty host abounding in elephants and horses and cars, you have done an exceedingly wicked deed, execrated by all the worlds. Even if one happen to be the lord of the three worlds, one given to troubling creatures, and who is cruel and engaged in wicked acts, can not exist. All persons destroy, like a snake that has intruded itself, him that dose cruel deeds, hostile to the interests of every one.","alignment":{"type":"grouped","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3028004","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4592f3f2ce283efc9458778b9efd38705c814ae445a128021e050bd123223744","compact":"b62c05868d21949d18f26d61170f3d99975edfd5f76a335574b4bbea5b437ff0","nasal":"c17fab78213134dcf5a708b62bbeac461d5ae7fd7e3a05a38d4adcd3ec8f28c0"}},{"id":"VRCE-3-28-5","kanda":3,"kandaId":"aranya","sarga":28,"verse":5,"english":"People delightedly behold the end of him that doing an action either from covetousness or desire, dose not like a Brāhmaṇi swallowing a Karakā, see the consequence thereof.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3028005","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c6c0e0c3eeadf1af3442f41fe86a239fc602424aa713af21e740c6e5adc2142","compact":"fe0f0bbcf5b027bc8ac5d254605d98dd79fda3339ec8a71e7706f34efd8dae9c","nasal":"fdfb83ab31b21282509d3c7e5b45eba528a8f935d6dd7550d8934503a7fa4393"}},{"id":"VRCE-3-28-6","kanda":3,"kandaId":"aranya","sarga":28,"verse":6,"english":"What, O Rākṣasa, do you gain by slaughtering exceedingly pious ascetics engaged in righteous acts, living in the forest of Dandaka?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-4"],"status":"unreviewed"},"source":{"sanskritLocator":"3028006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d242c88cd4f6a37c3ca797dd2a15580d85ad995092e1adbc303d1bd3c38820d8","compact":"b4b8bec9f7135af86074cb5b315591cc58b900df27b9bdf8a050268634e8898c","nasal":"a044f3c1e7025efa80a8a6a5a1a1018fcb0a9024a903881d766770ae317a4c2b"}},{"id":"VRCE-3-28-7","kanda":3,"kandaId":"aranya","sarga":28,"verse":7,"english":"Like to trees whose roots have been reduced, cruel persons, execrated of men, who perpetrate iniquitous acts, do not exist long.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3028007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5440c7d17e081fabd2860ca90d4afba5cd6059c535ce2bf271be692a4396fa76","compact":"a06e62888126d3a5f576d8a879b89bf6dfe4164ff8b554c82c76b2c4e1fe45fe","nasal":"521d6c5714ce8066ba54345f3db632b1f7c5988ca00a8ec317847e71e0acdf41"}},{"id":"VRCE-3-28-8","kanda":3,"kandaId":"aranya","sarga":28,"verse":8,"english":"As a tree puts forth blossoms in season, the doer of sinful deeds, at the hour (of repentance) inevitably reaps their fruit in the shape of dreadful anguish (of the spirit).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3028008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fbeb7f6d46327693e969b6812fe31c80393464be853145c1f7d857b49bd38992","compact":"7ccacf36c10abfa83fe3551505d1af378683f227487a817d6bf7560b448ea038","nasal":"7ccacf36c10abfa83fe3551505d1af378683f227487a817d6bf7560b448ea038"}},{"id":"VRCE-3-28-9","kanda":3,"kandaId":"aranya","sarga":28,"verse":9,"english":"O ranger of night, as the effect of having taken rice mixed with poison, appears without delay, even so also people readily reap the fruit of their own acts.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3028009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"60c5aa368cedcacfc36d69b7f70c02ea5a4c54d4e06364b69e4c1f7fedd6f2c0","compact":"45b0881f20b01e7beb34bb49723493658bba467fec804d2bf3da737bf8f396a4","nasal":"68a813182b76b12224768ac11d28d82627b5e407ee05d53c0975c8328b6d3464"}},{"id":"VRCE-3-28-10","kanda":3,"kandaId":"aranya","sarga":28,"verse":10,"english":"O ranger of the night, it is to take the lives of the perpetrators of dreadful sins, who wish ill to men, that I the king have come.","alignment":{"type":"1:1","confidence":0.781,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3028010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0f1da923d02af5cf68bb031df82c7db51d3add64030f26b7c519d9a897b6691c","compact":"7b98075034d52b3fddb8b79051e34d687c0e655b92d44ebc47598294d3e04879","nasal":"d6174a019e91cc9ddb68bc1b2c8ec3048241198f827348eedc7e4946236a062a"}},{"id":"VRCE-3-28-11","kanda":3,"kandaId":"aranya","sarga":28,"verse":11,"english":"Today the gold-decked arrows discharged by ine, piercing (your body), shall enter into the carth, cleaving it, like serpents falling into an ant-hill.","alignment":{"type":"1:1","confidence":0.708,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3028011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04e101110ee1de555521cf16da50e3f6f48090244c1060212ab6e6aa715bd5a1","compact":"827d02db6956ec73a276e99426eef30de143ae683cf27656f5632f30d4770f0e","nasal":"bc7fea31e826c8cdc87dceb1ea38d5e3d9be4f3eb5f8a5a0f65e21db55aa5e85"}},{"id":"VRCE-3-28-12","kanda":3,"kandaId":"aranya","sarga":28,"verse":12,"english":"Slain in battle, you shall in company with your army, follow those people practising piety, whom you have devoured in the Dandaka forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3028012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"69524817ea61be8ee1780c3246a5ddc8b4132e55b81e4850f2ec688d5b7657a8","compact":"4485c8e0b971047796140854db5087010320c5ca0f75a431102e324e38ee0f55","nasal":"32e1f7627c65040a792484dbfa2a53e50972a07e96df81eb4e1f4da27871963f"}},{"id":"VRCE-3-28-13","kanda":3,"kandaId":"aranya","sarga":28,"verse":13,"english":"Today let those great saints, who had formerly been slain by you, stationed in the sky, behold you slain (in turn) with my arrows, and inhabiting hell.","alignment":{"type":"1:1","confidence":0.812,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3028013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ef77494c00767ac190504766cd4d22eddc27a6c7a06c5649dca43250a6e77a3","compact":"a6e31d531e783a24e40768a10b25fde0aeab41affda51bc9c96fc81e9d8ba734","nasal":"c13e3f250ad456c511ac000a124024917f59dbe9aa8d132e9a36f00688ae3ba8"}},{"id":"VRCE-3-28-14","kanda":3,"kandaId":"aranya","sarga":28,"verse":14,"english":"Do you strike as you like. And youl that are of an odious race, do you put forth your energy. Today I will bring down your head, even as a palm falls to the ground.","alignment":{"type":"1:1","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3028014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5702a38ca8242f3eab5674c642e1b961a8328781cfd408c961b2b03300a5bc78","compact":"89d08f6b872e0776ca669ff4dc0c785de767a05e2319a10925d4abc6e3301aab","nasal":"89d08f6b872e0776ca669ff4dc0c785de767a05e2319a10925d4abc6e3301aab"}},{"id":"VRCE-3-28-15","kanda":3,"kandaId":"aranya","sarga":28,"verse":15,"english":"Thus addressed by Rāma, Khara enraged and beyond himself with passion, with eyes reddened, replied.","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3028015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"171035db02b44d34b2b2023a2b9f9d269d3f6efafecf04d3538b8be6f6e1e698","compact":"b4113addff1964336ac33b25140e71b1765f0aa743ac96b4233b386ee3bfe99b","nasal":"b4113addff1964336ac33b25140e71b1765f0aa743ac96b4233b386ee3bfe99b"}},{"id":"VRCE-3-28-16","kanda":3,"kandaId":"aranya","sarga":28,"verse":16,"english":"O son of Dasaratha, why having slain inferior Rākṣasas in battle, do you praise yourself without reason?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3028016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"684a29720dc7f5eaeef66a920bd30b271cef08e7ad2e93006ed2e87202c2e43e","compact":"4cb13544ee926178c9b542a53e853d73ed7a8988e3081c687e9fd256bb22b608","nasal":"4cb13544ee926178c9b542a53e853d73ed7a8988e3081c687e9fd256bb22b608"}},{"id":"VRCE-3-28-17","kanda":3,"kandaId":"aranya","sarga":28,"verse":17,"english":"Those foremost of men that are puissant and powerful, do not, inflated with their energy, mouth (their own consequence).","alignment":{"type":"1:1","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3028017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3ff583f58562895f9c2c7ddd764c3ce084d26138a2be5af8c34b4c2304b8a62","compact":"cf5d56a11c2d51e6ed9c58fb92e352de52a8189f007afaa58b8d76b4cdee9dfe","nasal":"c3e35271eed49d315880babf96a2af3120ba8b03bea9b79ed31ee8baa1efaa6a"}},{"id":"VRCE-3-28-18","kanda":3,"kandaId":"aranya","sarga":28,"verse":18,"english":"It is the mean-minded Kșatriyas of impure hearts that magnify themselves among men, even as you, O Rama,do.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3028018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c2921f43c58282d396ceaec42884f2c42ecf2f4a70ba2055416520d98d89d759","compact":"ca75cdb287b893cf2be2cb984d041a4047a5e13612ea54672671e6fec4b99a92","nasal":"1db1cf7bfa029046a1204c84fe1df374816cfbf8886ad989c872fd20f9a0d438"}},{"id":"VRCE-3-28-19","kanda":3,"kandaId":"aranya","sarga":28,"verse":19,"english":"What hero, when the hour of his death has approached, publishes in the field his own lofty lineage and sings his own hymn.","alignment":{"type":"1:1","confidence":0.727,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3028019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c16540a6657595cb3241597fccaeb7c334ba701307afc19249f7e3dda325112e","compact":"9ec1c2b0999106b83b25cd9dba628a593b0759237ecaf28a4decc0a78d8d6389","nasal":"9ec1c2b0999106b83b25cd9dba628a593b0759237ecaf28a4decc0a78d8d6389"}},{"id":"VRCE-3-28-20","kanda":3,"kandaId":"aranya","sarga":28,"verse":20,"english":"As brass wearing the semblance of gold, displays its own defect on being heated*, with a fire lit with Kusa, so you have betrayed your own lightness by this speech of yours. i.c. becomes dusky, (Ramanuja).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3028020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"98828b85b9b51e2f6561cbeaebf5be344e6eeb6a14bdd43033dc2228e438cd51","compact":"5d089a548374995536104d778a9ee3d5bf4ac2dcc9c3ab39efa2cc37ac02111e","nasal":"5d089a548374995536104d778a9ee3d5bf4ac2dcc9c3ab39efa2cc37ac02111e"}},{"id":"VRCE-3-28-21","kanda":3,"kandaId":"aranya","sarga":28,"verse":21,"english":"You do not see me staying here mace in hand, like a moveless mountain dyed in metals, bearing mobile and immobile things.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3028021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f51310ed2a14cb326ab5a98b8feb691e4f877f6f1c5bf2a4c6976466f1f34e1c","compact":"ece32522325f2b83e793265e01edb584b9544d45a5cfa10fd1e61c395be9b05f","nasal":"846d8615fe4220203784fcea569068aa4951a5a02d28a44c4f136fd045ec30b8"}},{"id":"VRCE-3-28-22","kanda":3,"kandaId":"aranya","sarga":28,"verse":22,"english":"I can, mace in hand, deprive you and the three worlds to boot clean of your lives, like the very Destroyer with the noose in his hand.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3028022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"86d02e68da32716a9d228411d53c8d62b7986ffa64615a41e5f6e13582741d24","compact":"454e22ceb2a1f28ab21cf3d3dde629a873e2ae78b15dac32486ca4fd0cb24f97","nasal":"4d5bcbe299bb83e9a04d0eb8e549f2f178a1f31016b6d28b2b34386e51d2acc9"}},{"id":"VRCE-3-28-23","kanda":3,"kandaId":"aranya","sarga":28,"verse":23,"english":"But I will not parley much with you as much as I could wish: the sun is going to set, and our fight shall be interrupted.","alignment":{"type":"1:1","confidence":0.676,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3028023","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c1f080c4f23d4c8110f71eb198ea937c2abb165437266f9823443871ad21dfc","compact":"cfcfc241e07904dbe936bab7a5a697d2fc69aea10fd3d2f401f6322e288488f4","nasal":"cfcfc241e07904dbe936bab7a5a697d2fc69aea10fd3d2f401f6322e288488f4"}},{"id":"VRCE-3-28-24","kanda":3,"kandaId":"aranya","sarga":28,"verse":24,"english":"Fourteen thousand Räksasas have been slaughtered by you. I will for their deaths wipe their tears to-day.","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3028024","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b884fc2eb8161a399c9984fbddc067ad15c18db332dea4309b5fb6a25c002e5","compact":"0ee53ad57c7458b43741d40b14c238f897bdb4be78126ff6c4d11fc788d5cfec","nasal":"0ee53ad57c7458b43741d40b14c238f897bdb4be78126ff6c4d11fc788d5cfec"}},{"id":"VRCE-3-28-25","kanda":3,"kandaId":"aranya","sarga":28,"verse":25,"english":"Saying this Khara, highly enraged, hurled his mace+ provided with golden rings at Rāma, like to the blazing thunderbolt. Another reading is, plaited with gold.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3028025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04d8c7be716d224ad6f9eb2ea89481e44839fb28d5ca9fac35b4e55fef3ce2bc","compact":"514aa85e32d679f4beefd2f10aa12a92bb8e78bdad846c9698147e4075ee29e7","nasal":"0376b6da850fb58a84c01b52cbb886fb86169931c8b599c4b0fd4b9517729e31"}},{"id":"VRCE-3-28-26","kanda":3,"kandaId":"aranya","sarga":28,"verse":26,"english":"Thereat, reducing to ashes trees and shrubs, that mighty flaming mace, discharged by Khara's arm, fell before Rama.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3028026","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b68a440bfd18afa61891edb3dae17003552d10e697adf10e23a2be0ed279e67c","compact":"c8cb708b783e9519d100161ac251afa7562c4b95303256381295f5ff28f83f05","nasal":"c8cb708b783e9519d100161ac251afa7562c4b95303256381295f5ff28f83f05"}},{"id":"VRCE-3-28-27","kanda":3,"kandaId":"aranya","sarga":28,"verse":27,"english":"And Rāma severed in many fragments that mighty mace, resembling the noose of Death, as ascending the welkin, it was coming down.","alignment":{"type":"1:1","confidence":0.492,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-25"],"status":"unreviewed"},"source":{"sanskritLocator":"3028027","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"33f735944b7685c85c2870f8ef45a83e209a5d966cd8bd25f7e8af71fdfe8c40","compact":"7bd814f6b21f4cedf6fcf6b36bd39e215a5bf22aef0dde8ff353a5d6423ab3eb","nasal":"5734523d658a1005552267f0cf60b52aac672ba9fcff12bff188b6441889224a"}},{"id":"VRCE-3-28-28","kanda":3,"kandaId":"aranya","sarga":28,"verse":28,"english":"Thereupon, like a she-serpent brought down by force of incantations, the mace fell to the earth shattered and riven.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-29-26"],"status":"unreviewed"},"source":{"sanskritLocator":"3028028","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a40ddf550f9a2504ae549222a733c33d22b41996f0e69565b5201905fe7d608","compact":"71a83a1d76b2914e8381fcc2e165a5208ac0110be1bb9120c4da81fe4a90bf57","nasal":"58ab651e9ea79055708f206c2a73f4d9e3c94e27235579b270ce5bb279575cd2"}}]
