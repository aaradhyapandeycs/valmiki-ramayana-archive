[{"id":"VRCE-3-64-1","kanda":3,"kandaId":"aranya","sarga":64,"verse":1,"english":"Beholding Jațāyu fallen on the ground by the terrible Raksasa, Rāma spoke to Laksmana, having compassion for all, saying Verily for my service this bird has breathed its last, being killed by the Raksasa.O Laksmana, its voice has been enfeebled, its vision weakened and its life, greatly exhausted, Leith in a  very little proportion in its body.","alignment":{"type":"grouped","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3064001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a827479560a04dfa41ee756028777903297630a849308f42f49497bd5b0df64","compact":"7e5af65b6a1daebeca957758244e8e699d5ef3b431923be69988340aed11a6e2","nasal":"7e9c0dd9c3de16f6345587e56d6328de23c71664428e1859456f41b83ede1635"}},{"id":"VRCE-3-64-2","kanda":3,"kandaId":"aranya","sarga":64,"verse":2,"english":"Beholding Jațāyu fallen on the ground by the terrible Raksasa, Rāma spoke to Laksmana, having compassion for all, saying Verily for my service this bird has breathed its last, being killed by the Raksasa.O Laksmana, its voice has been enfeebled, its vision weakened and its life, greatly exhausted, Leith in a  very little proportion in its body.","alignment":{"type":"grouped","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3064002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b99a903f2cd76e57413ac1f6acaa011a8bd51ea07f8a1a2940b304d59cc8eb0","compact":"9febb14fc6fb0c4e3f098b765997f276cf27cc2c38defe942abbd361cff43cfe","nasal":"9febb14fc6fb0c4e3f098b765997f276cf27cc2c38defe942abbd361cff43cfe"}},{"id":"VRCE-3-64-3","kanda":3,"kandaId":"aranya","sarga":64,"verse":3,"english":"Beholding Jațāyu fallen on the ground by the terrible Raksasa, Rāma spoke to Laksmana, having compassion for all, saying Verily for my service this bird has breathed its last, being killed by the Raksasa.O Laksmana, its voice has been enfeebled, its vision weakened and its life, greatly exhausted, Leith in a  very little proportion in its body.","alignment":{"type":"grouped","confidence":0.903,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3064003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7906707e9dd1e55a63be8ed7d3b72d6943ca76deb286082091d617f957618c6d","compact":"1f95f8dd6ab1cd3fc90c260c04e4f07207a8c24eb69ccb2585b13b658041602b","nasal":"1f95f8dd6ab1cd3fc90c260c04e4f07207a8c24eb69ccb2585b13b658041602b"}},{"id":"VRCE-3-64-4","kanda":3,"kandaId":"aranya","sarga":64,"verse":4,"english":"May good betide you, O Jatayu; if you are capable of speaking again, do you relate how Sītā has been carried away and you have been killed.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3064004","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f952dc387e3456a15dde2c09bc83066c902907901bce4912c78b4a4ee6661c9e","compact":"c19e2cb457c52720c53f6e7d35e0b13ba139f440b4d4582e0b56aa1a174a456c","nasal":"c19e2cb457c52720c53f6e7d35e0b13ba139f440b4d4582e0b56aa1a174a456c"}},{"id":"VRCE-3-64-5","kanda":3,"kandaId":"aranya","sarga":64,"verse":5,"english":"Why has Rāvaņa taken away by stealth the worshipful Jānki? What offence did I commit by him that he has carried away my dear one?","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3064005","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d8a06f7323c8bb7a41947408dc820e0df8521fbe64ff0bcb906e6b529d09fa57","compact":"024028dd734a25ebc95be6674f76f55b9e05f7e1641be5c42677ed281c8f4d5f","nasal":"024028dd734a25ebc95be6674f76f55b9e05f7e1641be5c42677ed281c8f4d5f"}},{"id":"VRCE-3-64-6","kanda":3,"kandaId":"aranya","sarga":64,"verse":6,"english":"O you best of birds, how looked the moonlike, pleasant countenance of Sītā at the time of her being carried away? What did she speak then?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-4"],"status":"unreviewed"},"source":{"sanskritLocator":"3064006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e08acd8767fb7f51df3a6f1b39bf72f616ff6eae9aefaf2424ca46d7dc9a79f","compact":"a20536fc1ddfec4341f9cd3e952c9c39bec19f107be5dfcf6294c86efeb4f3ae","nasal":"323d227b42525d6070aa15e621fe1eceb55a774a256015c107fc0978ebebc0bc"}},{"id":"VRCE-3-64-7","kanda":3,"kandaId":"aranya","sarga":64,"verse":7,"english":"What is the prowess, appearance and action of that Raksasa? Where dose he live, O reverend Sir? Pray tell me, I do ask you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3064007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1ef87e21760ae86d5ebe71459f93b9bcce4847422312cc442cdcbd4d2bc94797","compact":"5e4d727422447d558c1957f712fd2dbb41f491575c069902c773cecf3a927ae7","nasal":"5e4d727422447d558c1957f712fd2dbb41f491575c069902c773cecf3a927ae7"}},{"id":"VRCE-3-64-8","kanda":3,"kandaId":"aranya","sarga":64,"verse":8,"english":"Beholding Rāma, lament like one helpless, the virtuous-souled Jațăyu spoke in faltering accents.","alignment":{"type":"approximate","confidence":0.129,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3064008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4262feab24a7cf494cb4b8b99a5976681b2f4c468917f4aa2d588bb054968aae","compact":"5216978451e343230029798fb0602fc3a32abf485485dbe8894381836dc8555a","nasal":"5c8989a9818ee53570700ac426703a0d5e3b3d7b390d09e95d29a7f1d3495af3"}},{"id":"VRCE-3-64-9","kanda":3,"kandaId":"aranya","sarga":64,"verse":9,"english":"Sītā has been carried away by Rāvana, the lord of Rākşasas, creating a mighty illusion producing wind and showers.","alignment":{"type":"1:1","confidence":0.79,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3064009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"64d44e5f5696458692e96bb0fc9a62094ccb137f4d8acdc72973752a40464e7c","compact":"cb8d51c8487f171c7c74f838c9128b3c2afc8e93a6e49eba0aae7edc772183d6","nasal":"4ff7e276eb62d9f3c64a240878675030cc4bed58d3c7b87d01c3fcc7b01231f5"}},{"id":"VRCE-3-64-10","kanda":3,"kandaId":"aranya","sarga":64,"verse":10,"english":"O darling, myself being worn out that nightranger, having sundered my wings, fled away with Sītā to the southerly direction.","alignment":{"type":"1:1","confidence":0.677,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3064010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77403263712dbbc4a17e2d6c3235cfb38af4a47007dcb45640c345e501c4d42f","compact":"bb831392334bccf1d3199bc271e0c5e5f25aa9e2aabf8fa624802b574c4dafe3","nasal":"23f52d3c9b1975a866ce729636f4bcaac18e2d52cdd5beaed4a4545dbdf722aa"}},{"id":"VRCE-3-64-11","kanda":3,"kandaId":"aranya","sarga":64,"verse":11,"english":"O Rāghava, my life is about to expire, my eye-sight has grown of mistaken perception, I see trees before me made of gold having hair resembling Usira.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3064011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d53bc2a2cebb5b09610230d1e30dcefa79ffb1aaac5e6b288ecf6b8815b8ff4e","compact":"e364202eafe6e527703f545963a3463c6b39eb6ee5c4e0c99e0b16343f2bfc57","nasal":"790dc9fee893190e91b9ba5e7ef329e91a5cc4b87de2489e0697fb5bf7c5100e"}},{"id":"VRCE-3-64-12","kanda":3,"kandaId":"aranya","sarga":64,"verse":12,"english":"Rāvana has taken away Sītā at a moment when a person regains soon his lost property. O Kākutstha, this moment is called Vindya, which Rāvana has not been able to perceive. (At this moment) the person who takes away (a thing) is soon destroyed like to a fish devouring a hook. This refers to Jatāyu's astrological knowledge. Vindya is derived from the root Vid-to gain. Thus this moment is favourable to the laser and unfavourable to the taker. Hence Rāvana carrying away Sītā at this moment shall meet with destruction.","alignment":{"type":"grouped","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3064012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0bdb57a3b194ac183a3ab38c5b16442f4659c986a5c7deb541e6b99edf189d9","compact":"a361c72a4f865cb9128f7cc7b69dc392b14376b51595b4abb492d5e3e1a49c2e","nasal":"a361c72a4f865cb9128f7cc7b69dc392b14376b51595b4abb492d5e3e1a49c2e"}},{"id":"VRCE-3-64-13","kanda":3,"kandaId":"aranya","sarga":64,"verse":13,"english":"Rāvana has taken away Sītā at a moment when a person regains soon his lost property. O Kākutstha, this moment is called Vindya, which Rāvana has not been able to perceive. (At this moment) the person who takes away (a thing) is soon destroyed like to a fish devouring a hook. This refers to Jatāyu's astrological knowledge. Vindya is derived from the root Vid-to gain. Thus this moment is favourable to the laser and unfavourable to the taker. Hence Rāvana carrying away Sītā at this moment shall meet with destruction.","alignment":{"type":"grouped","confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3064013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"13b4b537f8635466c60fa17bdb266bc72a6847de5946392264d92e47a912ba44","compact":"bbe81275295938d5fe7819524a3f343b17ea75b3426cfb1ea89a87bd0c454d49","nasal":"bc4dd2e8fb402fb1d06c9e3a19a4cc82deec53b7318b550ba69a8f34e33bdd9b"}},{"id":"VRCE-3-64-14","kanda":3,"kandaId":"aranya","sarga":64,"verse":14,"english":"Do not therefore entertain the least doubt about your coming by Janakī. Destroying him at the head of the battle you shall soon sport with Vaidehi.","alignment":{"type":"1:1","confidence":0.866,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3064014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b348d49c4a8ad35177d1c9cd67bbd1598f214209de9eefd81c08a8019c4a8c9","compact":"21bec5216092dbfb01f573ec98b03b3a4f0cc3038d62b9eb26e329e5c38decef","nasal":"21bec5216092dbfb01f573ec98b03b3a4f0cc3038d62b9eb26e329e5c38decef"}},{"id":"VRCE-3-64-15","kanda":3,"kandaId":"aranya","sarga":64,"verse":15,"english":"Thereupon flesh and gore began to come out of the mouth of Jatayu, the king of vultures, not loosing his sense even while treading the verge of death.","alignment":{"type":"1:1","confidence":0.954,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3064015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9bcc5972b7059eef8605625260c74a7cc0f511176c5861b91a36814defe1a5b6","compact":"9f567290059598947237c369e9108f8c7300de683ae5aca3586720a91c0a64fa","nasal":"9f567290059598947237c369e9108f8c7300de683ae5aca3586720a91c0a64fa"}},{"id":"VRCE-3-64-16","kanda":3,"kandaId":"aranya","sarga":64,"verse":16,"english":"Thereupon the king of birds gave up his dear life uttering only-Rāvana is the son of Visravā and brother to Vaisravana (the lord of wealth).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3064016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bc7edb11383b3c4713ad08860b6585778a11e736550cfed68af3e27a46cf1965","compact":"308fdad7aad34f6ea8253e7def347b46f9499659e54d48baa2d8c858cb61cc49","nasal":"308fdad7aad34f6ea8253e7def347b46f9499659e54d48baa2d8c858cb61cc49"}},{"id":"VRCE-3-64-17","kanda":3,"kandaId":"aranya","sarga":64,"verse":17,"english":"Rāma again and again addressed him with joined palms saying, Do you speak! Do you speak. And instantly Jatayu's vital spark rose up in the sky, leaving his bodily frame.","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3064017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e90b80f564f36212ba8e9d1735c83e6944778607a11f4cc39c836c8872ef3ec2","compact":"cb7804c3f77f7a40b3b42c46116dd92c6e25cee33b6b2fac6cd767460dc63b2e","nasal":"5df503acb3179eb346044d43676295153da7c2d77a3623345e1c48a9c2c77d98"}},{"id":"VRCE-3-64-18","kanda":3,"kandaId":"aranya","sarga":64,"verse":18,"english":"Thereupon the king of vultures fell down on the earth by stretching forth his legs, body and head on the ground.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3064018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"47147519181326a72af14e5d7ecfc241896cc0c610b6d2e9aa8f2af0a49b9cb9","compact":"611329ae7f2d23cd105b9906175896e5650f2515aa03ecf0480420