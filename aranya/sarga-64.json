t_fingerprints":{"exact":"3b60d215a29b6397c6dcfe31bf465cad2c3c32a3b9b61775b97a3c648f62b5b1","compact":"34407af8bfeeff5f5005cda73b99a146ea9c22f5c5b565f1645ee0b9ee61e58e","nasal":"cc30aa14d879fbc1490505d49529e0910e0fb7d5ffdb18af18d67264dde2a1bc"}},{"id":"VRCE-3-64-25","kanda":3,"kandaId":"aranya","sarga":64,"verse":25,"english":"I do not feel so much affliction, O hero, for Sītā's ravishment as I do for this vulture, who has been killed for me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3064025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1ccf19810cbed31f85d0ce189d1b0653be1554dd790419f098bd785d381b8d5","compact":"f2b95dc5ed6bec7456f0eccff96302f957b055f0fc76a6b6bcdded179a882b14","nasal":"f2b95dc5ed6bec7456f0eccff96302f957b055f0fc76a6b6bcdded179a882b14"}},{"id":"VRCE-3-64-26","kanda":3,"kandaId":"aranya","sarga":64,"verse":26,"english":"Like to the highly famous, effulgent king Dasaratha, this King of birds is worthy of being adored and worshipped by me.","alignment":{"type":"1:1","confidence":0.849,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3064026","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c2d1366c41a73f6876f66abcaa8442055aa9539ac79abdd897620466ac7da90b","compact":"cd888c8e8b58d36152a5932531181f71ff37c566041fefdd3a7e6a27ba8e13df","nasal":"cd888c8e8b58d36152a5932531181f71ff37c566041fefdd3a7e6a27ba8e13df"}},{"id":"VRCE-3-64-27","kanda":3,"kandaId":"aranya","sarga":64,"verse":27,"english":"O Saumitri, do you bring fuels; I shall produce fire there-with and burn the dead body of this king of birds who has been killed on my account.","alignment":{"type":"1:1","confidence":0.891,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3064027","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a1d16dd43f3c86ea6015b4187d37a0bd310dfc3744c2be25c53d4ea4acaf191","compact":"55ce61b222a049be08205d696617fbb308e6573d664e8ddb09fc0023ddce3665","nasal":"55ce61b222a049be08205d696617fbb308e6573d664e8ddb09fc0023ddce3665"}},{"id":"VRCE-3-64-28","kanda":3,"kandaId":"aranya","sarga":64,"verse":28,"english":"Placing on a funeral pile, I shall cremate, O Saumitrī, the dead body of this king of birds who has been destroyed by the grim-visaged Raksasas.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-25"],"status":"unreviewed"},"source":{"sanskritLocator":"3064028","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f2042436ac3688a852d10f17de3f9cc1767a60ad829649e595838d60d5d7c667","compact":"3a9ce550e4d4cdc4cb6251cd350e4d405273faf2f923da9b041bd72623f2d6f2","nasal":"3a9ce550e4d4cdc4cb6251cd350e4d405273faf2f923da9b041bd72623f2d6f2"}},{"id":"VRCE-3-64-29","kanda":3,"kandaId":"aranya","sarga":64,"verse":29,"english":"Being consecrated and commanded by me, do you, O highly powerful king of birds, attain to that excellent state of existence, which is reached by persons ever performing pious observance, by Āhilāgnis by heroes who are not afraid of entering a battle-field and by persons who confer grants of land.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-68-26"],"status":"unreviewed"},"source":{"sanskritLocator":"3064029","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a00627f43a151ae096014e290f216816f8c9622d4bd264d5b019588375b3b711","compact":"15f4b6aade5fd6a14df3dc2ee4aaa156b550510e3fa4a699642aaacecead7d6b","nasal":"15f4b6aade5fd6a14df3dc2ee4aaa156b550510e3fa4a699642aaacecead7d6b"}},{"id":"VRCE-3-64-30","kanda":3,"kandaId":"aranya","sarga":64,"verse":30,"e