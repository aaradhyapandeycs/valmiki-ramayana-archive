[{"id":"VRCE-3-49-1","kanda":3,"kandaId":"aranya","sarga":49,"verse":1,"english":"When he had spoken thus, his yellow eyes became blood-red with rage and assumed the, semblance of flaming fire.","alignment":{"type":"approximate","confidence":0.5,"method":"fuzzy-nearby-witness","duttRefs":["DUTT-3-49-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3049001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"69dc5a0d5b6e23a4645acf907839f281520616ccc03c72a14313e566b6459feb","compact":"fb2344979e4c6e4cd205920816ce4fd6916ae00a96d7c803ec28dbf51b8c8a6b","nasal":"fb2344979e4c6e4cd205920816ce4fd6916ae00a96d7c803ec28dbf51b8c8a6b"}},{"id":"VRCE-3-49-2","kanda":3,"kandaId":"aranya","sarga":49,"verse":2,"english":"While Jatayu, the king of birds, spake this, Rāvana, the lord of Rākşasas, wearing pendants made of pure gold, having his eyes reddened with ire, darted towards him.","alignment":{"type":"1:1","confidence":0.766,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-51-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3049002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d2355ad17e9252f1a63b6e1f68ce2d7c6b5e350d0b5e84a6d8b8a924e8c348c4","compact":"f89d796c2ec9ed37c3c8cd09aa24e9cb0ee250ab3d1e36d8f441c212546f9064","nasal":"7692fdba60617278deb45db8076f910a70c562b18ecb2cdf4b61571c2b027805"}},{"id":"VRCE-3-49-3","kanda":3,"kandaId":"aranya","sarga":49,"verse":3,"english":"Thereupon they began a terrible conflict in the welkin, like to clouds driven by wind.","alignment":{"type":"1:1","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-51-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3049003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc41a639c61f15775d4e1ad2152b4ae86c29bdd49977f96c7bbb9589a2368096","compact":"47bb7a4e652b97b2a80f2a6b793ffdf5e73f207c1f4025a9e3b27c68aaad937e","n