-23-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3022006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7fd56c2286d9dbb262e5bd4275b10477b5d6e85f18a7ae07f85f7ba910d5f11b","compact":"7bf4b5b51ca3d36572e4a10aa8f4f8a332e5f491857afdfbd4489ae474a40942","nasal":"7bf4b5b51ca3d36572e4a10aa8f4f8a332e5f491857afdfbd4489ae474a40942"}},{"id":"VRCE-3-22-7","kanda":3,"kandaId":"aranya","sarga":22,"verse":7,"english":"And terrific clouds surcharged with water and blood, and resembling elephants with rent temples, enveloped the sky.","alignment":{"type":"1:1","confidence":0.466,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3022007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4bab3245de87386760ed9c29abb38adcb969f66dad750e98d693798f5aec8948","compact":"b18f912fdf3c75dfb2e9ea70c1a756236d1f46eb05b94a0227459ddd0fa6f598","nasal":"b562b1e85e5c2436cd17dac96cc8071344894bccd6d8739d956e37e1e2db0b1e"}},{"id":"VRCE-3-22-8","kanda":3,"kandaId":"aranya","sarga":22,"verse":8,"english":"And a dense darkness appeared, capable of making one's hair stand on end, and no quarter was distinctly visible.","alignment":{"type":"1:1","confidence":0.839,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3022008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ae9863d9c645270ceb65d893db7389ddc490b44c02b6b05913afaedac0f5cc77","compact":"9436dcc86c80f0aef62c85d979cbd8721f04cacf63da10a19ade935533e106cc","nasal":"9436dcc86c80f0aef62c85d979cbd8721f04cacf63da10a19ade935533e106cc"}},{"id":"VRCE-3-22-9","kanda":3,"kandaId":"aranya","sarga":22,"verse":9,"english":"And out of season, there appeared evening hued like a cloth soaked in blood. And facing Khara, terrible beasts and birds set up cries.","alignment":{"type":"1:1","confidence":0.54,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3022009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"763f62396733dc38dc6e3a047386741bec644ca08d692bf2383700338464e25c","compact":"6d1933f309a8c80f0f2e1b4f24fa85a00ae6a2d8b5d8b572a7780122b103866b","nasal":"6d1933f309a8c80f0f2e1b4f24fa85a00ae6a2d8b5d8b572a7780122b103866b"}},{"id":"VRCE-3-22-10","kanda":3,"kandaId":"aranya","sarga":22,"verse":10,"english":"Kankas, Gomayas and vultures, portending fear, began to cry. Ever inauspicious in war, jackals presaging evil, with their mouths belching forth flame, howled in the face of the forces.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3022010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a335ef049432973ca886841b109f3b1402ec8001eaef0ae6102808300e722944","compact":"05eefa8543a342203218f8d998e48f84674b93cff717ae5891317b28580a76b6","nasal":"05eefa8543a342203218f8d998e48f84674b93cff717ae5891317b28580a76b6"}},{"id":"VRCE-3-22-11","kanda":3,"kandaId":"aranya","sarga":22,"verse":11,"english":"And comets, resembling parighas appeared beside the sun. That mighty planet Svarbhānu seized the sun when there was no parva. And the winds blew violently; and the sun was without lustre.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3022011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"00333a341aee0e230a785a96d57b1c15dbc96cd9cbcc69624844c5bd4094f3e6","compact":"8b625eb5e0319c2063ce69f06d5276124c0f4f67b4f1c96cd942cbc2cb83aa44","nasal":"a1fab1198a6ca2bb81011f0e689cae530778e9db40ed0f92301592ba02d5c3cd"}},{"id":"VRCE-3-22-12","kanda":3,"kandaId":"aranya","sarga":22,"verse":12,"english":"And comets, resembling parighas appeared beside the sun. That mighty planet Svarbhānu seized the sun when there was no parva. And the winds blew violently; and the sun was without lustre. And when there was no night, stars wearing the sheen of fireflies, began to fall. And in the tanks fishes and fowls were inert, and the lotuses were withered.","alignment":{"type":"split","confidence":0.408,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-10","DUTT-3-23-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3022012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"75ee1183663e4ea12bd24434019c8783f591bcbf9c2d02bfee47d425dc23772d","compact":"36b8009de11ff62381339f0e70bb8ab702619d3e29fdf4b3d2d8455194abb7ce","nasal":"36b8009de11ff62381339f0e70bb8ab702619d3e29fdf4b3d2d8455194abb7ce"}},{"id":"VRCE-3-22-13","kanda":3,"kandaId":"aranya","sarga":22,"verse":13,"english":"And at that hour the trees were shorn of fruits and flowers; and without wind there arose dust dusky like clouds.","alignment":{"type":"grouped","confidence":0.424,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3022013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"67f8d29ca9ec8c8653fcbe6c82411442c2e499dd92ba3bea498d96f102c49e70","compact":"59339e9db7b847c7d759c3dc26fad58b03ace8bb52041e8be1ca26f733bec49e","nasal":"fa0965caac87e94e03b141ef18d2a275df89f1f7c0ec9fc1df02ad90bc678915"}},{"id":"VRCE-3-22-14","kanda":3,"kandaId":"aranya","sarga":22,"verse":14,"english":"And at that hour the trees were shorn of fruits and flowers; and without wind there arose dust dusky like clouds. And the parrots uttered wild notes-cīcīkūci. And meteors of terrific aspects fell with loud noises.","alignment":{"type":"split","confidence":0.323,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-12","DUTT-3-23-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3022014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"786b7afc77fc1b390eaca0e0f396dfb102aa0610d7119cd3636db3b0250e3603","compact":"7bcbd4fadf82ec7c42fbd3cfac0460bd0e2f51995a36e15cb6e2d78c6c1184a5","nasal":"e61dcfe48b4ea205ef9fa0e9f5aff185a0021ef95bc24833aa7cd6b0c5ea3e93"}},{"id":"VRCE-3-22-15","kanda":3,"kandaId":"aranya","sarga":22,"verse":15,"english":"And the parrots uttered wild notes-cīcīkūci. And meteors of terrific aspects fell with loud noises. And the earth with her mountains, woods, and forests, shook. And as the intelligent Khara was roaring from his car, his left arm shook, and his voice fell, and as he surveyed around, his eyes moistened, and his head ached; yet through ignorance, he did not desist.","alignment":{"type":"split","confidence":0.411,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-13","DUTT-3-23-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3022015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f5909e26ced34a105a92a55fe0f2df7e5b1d4d8884e47107f913b197b5b32c24","compact":"32b3e44ff6d1ff053c27c7367880b12d5a3bfdafb7a6476e39c314cc155c743f","nasal":"32b3e44ff6d1ff053c27c7367880b12d5a3bfdafb7a6476e39c314cc155c743f"}},{"id":"VRCE-3-22-16","kanda":3,"kandaId":"aranya","sarga":22,"verse":16,"english":"And the earth with her mountains, woods, and forests, shook. And as the intelligent Khara was roaring from his car, his left arm shook, and his voice fell, and as he surveyed around, his eyes moistened, and his head ached; yet through ignorance, he did not desist. Witnessing these mighty portents capable of making one's hair stand on end, Khara with a laugh, addressed the whole body of Rākşasas.","alignment":{"type":"split","confidence":0.393,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-14","DUTT-3-23-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3022016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"045d6a47aaba051304e4eefb7083ef145f8492ae4236828f9d5caaace11db868","compact":"bb7a36ae33ae5908cc806f977ff819e5495c8e1f915c003bab6f6c2255cc5453","nasal":"72802b53af8c662b76aa4dc88b278fcd4cd005938708e2cc6878444955ab7ea2"}},{"id":"VRCE-3-22-17","kanda":3,"kandaId":"aranya","sarga":22,"verse":17,"english":"Witnessing these mighty portents capable of making one's hair stand on end, Khara with a laugh, addressed the whole body of Rākşasas.","alignment":{"type":"grouped","confidence":0.733,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3022017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"450a3685919d2a2da8f3da2f7767e550dc620d99867c0f3d6f16c2d13fe96ae9","compact":"591bb881ac32a3feaf612a2f528f33b456e4865be913949c0f964b454c58e266","nasal":"2f965f3366388090f7d5353f5ac82aece69955dfe8ec0b0f198e0040fe7ea177"}},{"id":"VRCE-3-22-18","kanda":3,"kandaId":"aranya","sarga":22,"verse":18,"english":"Witnessing these mighty portents capable of making one's hair stand on end, Khara with a laugh, addressed the whole body of Rākşasas.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3022018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a808fa849bb2ed3c5ac3e703fb0dd96b5e1ae464dd76657f8ed9d930f6fc5df","compact":"3a2c1fe9280400c44d8f3cc682c3285b3f669528f35174c453a0c159daced1ca","nasal":"3a2c1fe9280400c44d8f3cc682c3285b3f669528f35174c453a0c159daced1ca"}},{"id":"VRCE-3-22-19","kanda":3,"kandaId":"aranya","sarga":22,"verse":19,"english":"Even as a strong person from prowess counts not a weak one, I do not dwell upon all these mighty portents, dreadful to behold, that have appeared. Even the stars will I bring down from heaven with my sharp shafts; and even Death will I engaged, bring to mortality. Without slaying Rāghava puffed up with pride as well as Laksmana, by means of sharp weapons, I return not (from the conflict).","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3022019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb0754afea2b7cf89aa137d51e6d3de3ab900426087d0a51e28daa04bd971fac","compact":"f0e8654dac46c9b1198ffc5b56c5b5ac29d8005645b62bc5ec28de8bff23711f","nasal":"bdcd259d330052d80c90cd66fd01b5d0f331791b92944ca5b48d0936d616f24a"}},{"id":"VRCE-3-22-20","kanda":3,"kandaId":"aranya","sarga":22,"verse":20,"english":"Even as a strong person from prowess counts not a weak one, I do not dwell upon all these mighty portents, dreadful to behold, that have appeared. Even the stars will I bring down from heaven with my sharp shafts; and even Death will I engaged, bring to mortality. Without slaying Rāghava puffed up with pride as well as Laksmana, by means of sharp weapons, I return not (from the conflict).","alignment":{"type":"grouped","confidence":0.94,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3022020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1da9f999b7d71ed45259f4aa89839f3a51f882e0a46e280e1ae2a5c2abb32165","compact":"420758787ee7223991f3179444e611b39e4b6742c008eda500c10543234571e9","nasal":"420758787ee7223991f3179444e611b39e4b6742c008eda500c10543234571e9"}},{"id":"VRCE-3-22-21","kanda":3,"kandaId":"aranya","sarga":22,"verse":21,"english":"Even as a strong person from prowess counts not a weak one, I do not dwell upon all these mighty portents, dreadful to behold, that have appeared. Even the stars will I bring down from heaven with my sharp shafts; and even Death will I engaged, bring to mortality. Without slaying Rāghava puffed up with pride as well as Laksmana, by means of sharp weapons, I return not (from the conflict).","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3022021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0dac916eef6efcbe2e4f8d0ea1e55a1abac8f74b00cb0da3380ddccf2684efef","compact":"e85b181715b2cb5e8a0d44a336cf33540a983958b68a06dd32b52bd00d9dfffd","nasal":"e85b181715b2cb5e8a0d44a336cf33540a983958b68a06dd32b52bd00d9dfffd"}},{"id":"VRCE-3-22-22","kanda":3,"kandaId":"aranya","sarga":22,"verse":22,"english":"Let that sister of mine, for whom Rāma and Lakṣmaṇa have had sense perverted, attain her desire, by drinking their blood..","alignment":{"type":"1:1","confidence":0.891,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3022022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5b505bf3782e936a6da150c4849e2cb85c46147da467c2d601649e6a53b94c92","compact":"e09cd8af3cdd109796b61880e8f7bd14070959dacf847e171b7c2ff40cadc95b","nasal":"b85a177f2531ffb06fd2cc463edd772745078492b39d5699ea9508d4dcaf8be9"}},{"id":"VRCE-3-22-23","kanda":3,"kandaId":"aranya","sarga":22,"verse":23,"english":"I had never before met with defeat in conflict. You have witnessed it. I do not speak a falsehood.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3022023","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a556c01402d079c0bdac93e6e82a1894f0e90291aeafdd1688d6f97032b0b34d","compact":"8f69751a38444b979790036d2d0f49b65b8e52405f38ffbbc67f89eada4d54ed","nasal":"8f69751a38444b979790036d2d0f49b65b8e52405f38ffbbc67f89eada4d54ed"}},{"id":"VRCE-3-22-24","kanda":3,"kandaId":"aranya","sarga":22,"verse":24,"english":"Wrought up with rage, I shall slay in fight the sovereign of the celestials himself, going on his mad Airāvata, with the thunderbolt in his hand, what shall I say of those two, who are human beings?","alignment":{"type":"1:1","confidence":0.787,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3022024","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"925b66ba3ed6a9f9685f3b72e2990d099c2bc430062f318d269548d2a3aa5ae2","compact":"42941588725137e6b039a960e49fa82fd6fafcbe7a89c80a2a8abdea0afa128a","nasal":"42941588725137e6b039a960e49fa82fd6fafcbe7a89c80a2a8abdea0afa128a"}},{"id":"VRCE-3-22-25","kanda":3,"kandaId":"aranya","sarga":22,"verse":25,"english":"Entangled in the noose of death, that mighty army of the Rākşasas hearing his challenge, experienced boundless enthusiasm.","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3022025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79abe00863636df54a11de51ee7851828640905acc1e7645f68b4dd0a07235ad","compact":"6fa39d8372060d48677220e3f7cf5a56857fe04e1d6d4e2eed29808907b7255a","nasal":"6fa39d8372060d48677220e3f7cf5a56857fe04e1d6d4e2eed29808907b7255a"}},{"id":"VRCE-3-22-26","kanda":3,"kandaId":"aranya","sarga":22,"verse":26,"english":"And anxious to see the encounter, there came high-souled saints, and celestials, and Gandharvas, and Siddhas, with the Cāranas. And these pious ones assembled, spoke to one another.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3022026","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0caf0cc52c6d44bfedd2689617a3e8babe48de574d3b1c32dafb6158a567967f","compact":"ff886fed04dfe35a0c289cd59f37786d8b6aaac2c975937a6c5daa83694978f0","nasal":"9148b6267a78745a9ada8b9f033e68a2c121330e6ecf297a531b5e796696b75a"}},{"id":"VRCE-3-22-27","kanda":3,"kandaId":"aranya","sarga":22,"verse":27,"english":"And high-souled saints of the world, and the foremost Brahmarșis of pious acts, coming together, spoke to one another, saying, Hail to cows and Brāhmaṇas, and all those in whom are established the worlds! may Rāghava vanquish in fight those rangers of the night, the progeny of Pulastya, even as the discus-handed Vişņu routed in battle the foremost Asuras!","alignment":{"type":"grouped","confidence":0.431,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-24-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3022027","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"58f1b3a745be67bde11f3b5f36128a2bcc8e9bf38d8bd36d22a38e2c88e684ae","compact":"714ff578402367f0b7e23a501e5a37a5ca483241f945483568b653a4fe9cf2c3","nasal":"714ff578402367f0b7e23a501e5a37a5ca483241f945483568b653a4fe9cf2c3"}},{"id":"VRCE-3-22-28","kanda":3,"kandaId":"aranya","sarga":22,"verse":28,"english":"And high-souled saints of the world, and the foremost Brahmarșis of pious acts, coming together, spoke to one another, saying, Hail to cows and Brāhmaṇas, and all those in whom are established the worlds! may Rāghava vanquish in fight those rangers of the night, the progeny of Pulastya, even as the discus-handed Vişņu routed in battle the foremost Asuras!","alignment":{"type":"grouped","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-24-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3022028","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f627348ed92441144ba24ef35295dde21ee3db61d5d768c807ea9a14075f58e1","compact":"4f2afde2eaab06b506c52e97d87c576f8cd647afe195ddb26d