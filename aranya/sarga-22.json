[{"id":"VRCE-3-22-1","kanda":3,"kandaId":"aranya","sarga":22,"verse":1,"english":"As those terrible and inauspicious forces were marching on, a mighty sable cloud with dreadful sounds began to shower down blood.","alignment":{"type":"1:1","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3022001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e5127bb56f8e2d31ba7183cf449da71ca06c1db2f3354753a5c59462fbafc39d","compact":"2222b983c4a3ff67ce667674043c7447d4bbe050f5911d7662a1dd1750567229","nasal":"2222b983c4a3ff67ce667674043c7447d4bbe050f5911d7662a1dd1750567229"}},{"id":"VRCE-3-22-2","kanda":3,"kandaId":"aranya","sarga":22,"verse":2,"english":"The steeds yoked to his (Khara's) car, gifted with great celerity, dropped down all of a sudden on the level high ways strewn with blossoms.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3022002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"248017e26fa22f4903ec5c43ef7c837ba88d2f3aa07a4330be59fba91d4a6615","compact":"83670975055d3a99ed4ffd39a44c43afe1dbc6492c8ec84188cb97f8fdcf2a46","nasal":"83670975055d3a99ed4ffd39a44c43afe1dbc6492c8ec84188cb97f8fdcf2a46"}},{"id":"VRCE-3-22-3","kanda":3,"kandaId":"aranya","sarga":22,"verse":3,"english":"A dark circle bordered with red, resembling that of charcoal, appeared in the vicinity of the sun.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-23-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3022003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2c1aeb995cc7d0b9b8ccfb6e78614e932138d8418811f9c1048cc5deb321ee52","compact":"f7b068ec9b3450a1762d7aeec814e101fe8d788aea3358d088ab6f307677f2df","nas