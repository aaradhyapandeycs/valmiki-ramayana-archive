1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-47-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3045024","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c70abeaa9668d3db1f200a33c02fc9ac9ba146409742020d5e8757115e212bd4","compact":"4ad2f4e73d7a1678e7298527b87e12b21f0ef53821386eb71ef80c9b0d8099f0","nasal":"4ad2f4e73d7a1678e7298527b87e12b21f0ef53821386eb71ef80c9b0d8099f0"}},{"id":"VRCE-3-45-25","kanda":3,"kandaId":"aranya","sarga":45,"verse":25,"english":"That great city in the midst of the ocean, Larkā, encircled on all sides by the sea and situated on the summit of a hill, is my capital.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-47-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3045025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d29af11ee59c57f38d410f68ea626c5a7eddef260d51cd0f316bc13de84e4f0b","compact":"1c5a116dabf4b6780c0ddbfce2c68409f50ddd780a87254928c46f7a3e57d4d3","nasal":"72e5fc5b5ce291de0630e0f8ae99ee6f09143294daacfb6e558dad6defe8199c"}},{"id":"VRCE-3-45-26","kanda":3,"kandaId":"aranya","sarga":45,"verse":26,"english":"There shall you with me, O Sītā, walk in gardens, and thus you shall no more long for living in the forest.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-47-25"],"status":"unreviewed"},"source":{"sanskritLocator":"3045026","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b7f08f01d535a7d6486f9c0e9ddacb65305ced40fd88b8f30fa8a01bbe38804a","compact":"ebc1125d8ce72cfa3c69ed54cc6a5ba8abd7dce6878e83a33355daa689870344","nasal":"ebc1125d8ce72cfa3c69ed54cc6a5ba8abd7dce6878e83a33355daa689870344"}},{"id":"VRCE-3-45-27","kanda":3,"kandaId":"aranya","sarga":45,"verse":27,"english":"If you did become my wife, O Sītā, five thousand maid-servants decorated