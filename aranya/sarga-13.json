s.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-14-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3013024","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"266fda89c44da57e37ca2247b4b0ff25bd18000893e3eff342c579200f5cb281","compact":"e0fc5537b832a3788afd4d92828456d151d27832a1c78cd02cb46702aef590e6","nasal":"e0fc5537b832a3788afd4d92828456d151d27832a1c78cd02cb46702aef590e6"}},{"id":"VRCE-3-13-25","kanda":3,"kandaId":"aranya","sarga":13,"verse":25,"english":"And Hari's sons are lions and the nimble monkeys. And Śārdúlí brought forth as her sons, Golāngūlas, and tigers; and the offspring of Matangi were mad elephants, O best of men. And Śvetā, O Kākutstha, gave birth to the elephants of the cardinal points.","alignment":{"type":"grouped","confidence":0.861,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-14-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3013025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8fa5a634f3dfccd87b10329e298f8b66930a7da5ac278c72c93643291bc55ee2","compact":"b92bfd5da4ea09b6e23d293e79fe64de388c327fef8a153224963a63f2a92a08","nasal":"d12397cf5dbf643d03559b8935d420933be3c4239794ddbe01b222e4932e8b6e"}},{"id":"VRCE-3-13-26","kanda":3,"kandaId":"aranya","sarga":13,"verse":26,"english":"And Hari's sons are lions and the nimble monkeys. And Śārdúlí brought forth as her sons, Golāngūlas, and tigers; and the offspring of Matangi were mad elephants, O best of men. And Śvetā, O Kākutstha, gave birth to the elephants of the cardinal points.","alignment":{"type":"grouped","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-14-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3013026","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62fbd4a2f6b78f6a3b3e6cb952bc93670e210e9045b8decc0eca353f20b2e818","compact"