[{"id":"VRCE-3-24-1","kanda":3,"kandaId":"aranya","sarga":24,"verse":1,"english":"Coming to the asylum, Khara in company with those that went before him, saw that slayer of foes, the enraged Rāma, holding his bow. And seeing him, Khara possessing a shrill voice, raising his bow, commanded to the charioteer to drive towards Rāma, Drive on!","alignment":{"type":"grouped","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3024001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04e85e7297d649a70a54244aa5300778b32ac8b881102d6ebf0c4b805791539a","compact":"5fbd84a55608a31ab14091592ff58064e3c5a39b62e86403c3f72ac075494a3f","nasal":"5fbd84a55608a31ab14091592ff58064e3c5a39b62e86403c3f72ac075494a3f"}},{"id":"VRCE-3-24-2","kanda":3,"kandaId":"aranya","sarga":24,"verse":2,"english":"Coming to the asylum, Khara in company with those that went before him, saw that slayer of foes, the enraged Rāma, holding his bow. And seeing him, Khara possessing a shrill voice, raising his bow, commanded to the charioteer to drive towards Rāma, Drive on!","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3024002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cca7cc2865c2f685e9883fb8eae95c65534d3c1f8bec97aeb7561f4b695dfb7f","compact":"88409d310e02124f106ab22250edd327d085b69b4d256f595aa4d1958f66ab08","nasal":"88409d310e02124f106ab22250edd327d085b69b4d256f595aa4d1958f66ab08"}},{"id":"VRCE-3-24-3","kanda":3,"kandaId":"aranya","sarga":24,"verse":3,"english":"At Khara's command, the charioteer drove the steeds to where the mighty—arined Rāma stood alone, holding his bow.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-2"],"status":"unreviewed"},"source":{"sanskr