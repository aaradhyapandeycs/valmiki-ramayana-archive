nskrit-ngram","duttRefs":["DUTT-3-25-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3024006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"074eeeeafa24525949f8c74fbbdaf0b031da64a481a788d9f3e2a80dbc165fc4","compact":"549b6bddf0c63620239740a41fe813f779eee539971b3498d040603a74fb1834","nasal":"a4caa7cdc0cba999525bd8bae7635615fcdc5139d546932499e94d9f7a2a27c6"}},{"id":"VRCE-3-24-7","kanda":3,"kandaId":"aranya","sarga":24,"verse":7,"english":"And wrought up with rage, the Rākṣasas in battle assailed him with iron clubs, and darts, and prāsas, and swords, and axes.","alignment":{"type":"1:1","confidence":0.723,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3024007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d876fc7bdfa64b40b4d659b5c6ea424d556cd3e0c130cf5bfe7ea663c0d2249a","compact":"d072d79407f6751dd08cf584f2baa7f0d0e646ca5c1b83059c2ec7d34f369f0b","nasal":"d072d79407f6751dd08cf584f2baa7f0d0e646ca5c1b83059c2ec7d34f369f0b"}},{"id":"VRCE-3-24-8","kanda":3,"kandaId":"aranya","sarga":24,"verse":8,"english":"And resembling clouds (in hue), the exceedingly strong Rākṣasas, having huge bodies, darted towards Kākutstha by means of steeds and cars.","alignment":{"type":"1:1","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3024008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"66f6d912e43e62430dbf6241233a3cf0994fcfc4fc1dc10f682dca76ed7beb2a","compact":"938ad5ddb95b0521a3ed52d6f55d5bfa937558e81a10bff5e4458eb271aee903","nasal":"decce56a1f7557109d1a96be17f75ff2c4f088276cfc91b6ad763318c7e579b8"}},{"id":"VRCE-3-24-9","kanda":3,"kandaId":"aranya","sarga":24,"verse":9,"english":"And mounted on elephants resembling mountain-peaks, numbers of Rākṣasas, intent upon staying Rāma in battle, showered arrows on him, as mighty clouds pour down showers on the monarch of mountains.","alignment":{"type":"1:1","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3024009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"300177133cec308bb3e19529100e66f397bb21611934ba5d55a9821a29a9a099","compact":"08c3768f6e1e623a811cde029bb857977399efe80855e17a2f9454a718e1251c","nasal":"65f9977ec7f70101724b4732e1e044919ae65ff8380c196ff2df8bbe8d37fb4b"}},{"id":"VRCE-3-24-10","kanda":3,"kandaId":"aranya","sarga":24,"verse":10,"english":"Rāma was hemmed in by all those fiercelooking Raksasas, even as in the evening Mahādeva is surrounded by his courtiers.","alignment":{"type":"1:1","confidence":0.518,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3024010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2cdc9737c8ed6c9eaedea8c143d4bf3e8e23aba1b2a2710a38f7a13690d9ed32","compact":"0f41badb6e60675c3805412e800fbfff120b41a9a34047d4cc98526fb11745ef","nasal":"0f41badb6e60675c3805412e800fbfff120b41a9a34047d4cc98526fb11745ef"}},{"id":"VRCE-3-24-11","kanda":3,"kandaId":"aranya","sarga":24,"verse":11,"english":"And as the ocean resisted the tide of a river, Rāghava by means of arrow resist the weapons discharged by the Yātudhānas.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3024011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c2c4363657c991677e76103612387dc85b6d5779a5c56d9e8e46d694224a4b3d","compact":"9d83482ac75f722a2dce99d9e3dd54e2e587d6116b9fdcbbef650b340abdcd91","nasal":"9d83482ac75f722a2dce99d9e3dd54e2e587d6116b9fdcbbef650b340abdcd91"}},{"id":"VRCE-3-24-12","kanda":3,"kandaId":"aranya","sarga":24,"verse":12,"english":"As a mighty mountain, assailed by the thunderbolt, dose not feel pain, Rāma, having his person pierced by terrible flaming weapons, did not feel pain.","alignment":{"type":"1:1","confidence":0.687,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3024012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"84f86fdad724b135a371025320a896468f75c1670201d54785943f842083fd6f","compact":"459cf6372d08cfea6442209b27f77b22a49e408e63efe4f8ab06de14cb77c8d7","nasal":"13cd737a46cf30570f8f4303d951eca9fb9827cddf3b47a72315200642a1ab0c"}},{"id":"VRCE-3-24-13","kanda":3,"kandaId":"aranya","sarga":24,"verse":13,"english":"And pierced, and with his person covered with blood, Rāma, the descendant of Raghu, resembled the sun enveloped in evening clouds.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3024013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bf84fbcfcd56cae5379fed9f07aa65bcce58d42445cec43d8c8bfd7bed31fd61","compact":"4a0f73169198d1088ecdfd099629cdeab35c482915da3b633bd10255518d7ab2","nasal":"4a0f73169198d1088ecdfd099629cdeab35c482915da3b633bd10255518d7ab2"}},{"id":"VRCE-3-24-14","kanda":3,"kandaId":"aranya","sarga":24,"verse":14,"english":"And seeing him single, surrounded by many thousand, the Gods, Gandharvas, Siddhas, and supreme saints became sorrowful.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3024014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"810706a52727ed6630644d55b0ff3e900508cc166e5cb5ef11a3f875cbf0171f","compact":"f61251ac01facae81ec92466d8730db7758293240ffe6cda55899a449cc77775","nasal":"e729d5b648aa81e6f1a4ee5438fce311b1061c61a12215757d0192e97e6f67a0"}},{"id":"VRCE-3-24-15","kanda":3,"kandaId":"aranya","sarga":24,"verse":15,"english":"Then Rama getting enraged, bringing his bow to a circle, discharged sharpened shafts by hundreds and by thousands. And as if in sport, Rāma in the conflict shot irresistible (shafts) furnished with Kanka feathers, and decked with gold, irresistible, capable of inflicting extreme pain, and resembling the noose of Death.","alignment":{"type":"grouped","confidence":0.733,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3024015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee2d5ec96a54b39db50de8717cab7d6c8e5c83a11fc4d5931bf16a000e61d97d","compact":"e462506523b2ca52fcd5c9ee959b566cd7b7778413cec2eecc1bda9faf1fcd6f","nasal":"ba7c5095f5fd1810c3d0efdd8bc0fb7db60b8958f4ef8fc57b22ad817dc8aaf6"}},{"id":"VRCE-3-24-16","kanda":3,"kandaId":"aranya","sarga":24,"verse":16,"english":"Then Rama getting enraged, bringing his bow to a circle, discharged sharpened shafts by hundreds and by thousands. And as if in sport, Rāma in the conflict shot irresistible (shafts) furnished with Kanka feathers, and decked with gold, irresistible, capable of inflicting extreme pain, and resembling the noose of Death.","alignment":{"type":"grouped","confidence":0.468,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3024016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7112b193298a1cceaa5688dafc90d61f6f0d1932b7fd802e8cb422c62269a99d","compact":"f080eedc2f93bf5f8e8ba729990ede0684535468b91ba1390da522f2f36d2f84","nasal":"506296ffdd5c758a913a7ec329863f6f40a6b23982d5d37a9ef403e394e99398"}},{"id":"VRCE-3-24-17","kanda":3,"kandaId":"aranya","sarga":24,"verse":17,"english":"And sportively discharged by Rāma, those arrows deprived the Rākṣasas of their lives, like the noose forged by death.","alignment":{"type":"1:1","confidence":0.885,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3024017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dd3058eab2071048fa7f0c9a304f4e1dfa8277fae797effe50be750f703b3386","compact":"5d1e002a28480bbcadef4b14534d7a0dafb5c025b5fa5563c7d67632fcd35192","nasal":"5d1e002a28480bbcadef4b14534d7a0dafb5c025b5fa5563c7d67632fcd35192"}},{"id":"VRCE-3-24-18","kanda":3,"kandaId":"aranya","sarga":24,"verse":18,"english":"And piercing the persons of the Rākşasas, those arrows, soaked in blood, going up to the sky, appeared with the splendour of flaming fire.","alignment":{"type":"1:1","confidence":0.944,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3024018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a2f142bb2bf188beb90c8923ddd32edc918a32820f82e789f3dfd02545337c6","compact":"a660296d7834eb403243c8278f89ba3501a88b9d9966132feb687aca0457671d","nasal":"2288cac3296ad87df722067658f986940e3ee219721b58b9b5de345ed984c61b"}},{"id":"VRCE-3-24-19","kanda":3,"kandaId":"aranya","sarga":24,"verse":19,"english":"And innumerable shafts, exceedingly fierce, capable of depriving the Rāksasas of their lives, were let go from the circle of his bow.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3024019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"50bbbf79b4dea14a2ea0ebc7fd72661cb20904ce833222ef0176403bc82653f7","compact":"b1bd26ad444ccf30ffa8d900f9363f9c823352db01bfbf88a07e1e52e46547c2","nasal":"37fc6ad21db364d98c640f02181e13a92d29dde8822d55e58315160eaf556669"}},{"id":"VRCE-3-24-20","kanda":3,"kandaId":"aranya","sarga":24,"verse":20,"english":"And with those Rāma severed bows, in baitle by hundreds and by thousands and flag ends, and shields, and mail, and many arms with embellished hands, resembling the trunks of elephants.","alignment":{"type":"1:1","confidence":0.613,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3024020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1d0ec174a2bf380942b29972210d64a94868d716cc5d6e82d22559774c6971ad","compact":"1b561a804176e4cfa5a3cbb7e087ce8da6a3f7da2c58265f3f4b0daf8605d296","nasal":"1b561a804176e4cfa5a3cbb7e087ce8da6a3f7da2c58265f3f4b0daf8605d296"}},{"id":"VRCE-3-24-21","kanda":3,"kandaId":"aranya","sarga":24,"verse":21,"english":"And cut off with nālīkas (steel-pointed arrows) and, nārācas (arrows wholly made of steel), and sharp-pointed vikarnas (barbed arrows), the rangers of the night uttered dreadful howls of distress.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3024021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e5ca478078ac94a1c9686b7429907c45fb6b7637119c14d02ed7dad09acfa6f","compact":"ece412b0b4b0f91f5871bf55228bf4c52b9f4855cf59c5a2c4cdf2fd0c4a2d91","nasal":"ece412b0b4b0f91f5871bf55228bf4c52b9f4855cf59c5a2c4cdf2fd0c4a2d91"}},{"id":"VRCE-3-24-22","kanda":3,"kandaId":"aranya","sarga":24,"verse":22,"english":"And like a withered wood afflicted by fire, that host harassed by the various marrowpiercing* shafts shot by Rāma, did not attain ease. Another reading is, sharpened.","alignment":{"type":"1:1","confidence":0.609,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3024022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"243d3192dccaaf2214cea4ee32371aaeeaaa26e0f8d6936f53077ba4e05992ab","compact":"f7c209bd355d744162d2f3fca62bbc0c2159edd9dd9aaac7b2ed9d15e0351390","nasal":"f7c209bd355d744162d2f3fca62bbc0c2159edd9dd9aaac7b2ed9d15e0351390"}},{"id":"VRCE-3-24-23","kanda":3,"kandaId":"aranya","sarga":24,"verse":23,"english":"And some heroic rangers of the night possessed of great strength, waxing furious, threw at Rāma rrāsas, and darts and axes. Another reading: remaining before Rāma, threw powerful weapons.","alignment":{"type":"1:1","confidence":0.47,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3024023","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"89d845a059b2a8accd0ff74812682753a82628460b7dc9cb51fffa4a7a466f30","compact":"248b78fdc56727a8fdbfd281e2ee391379ecb2c130bd26d4ff7c2ae58a9bca78","nasal":"248b78fdc56727a8fdbfd281e2ee391379ecb2c130bd26d4ff7c2ae58a9bca78"}},{"id":"VRCE-3-24-24","kanda":3,"kandaId":"aranya","sarga":24,"verse":24,"english":"Thereupon resisting by means of shafts those weapons of theirs, the mighty-armed Rāma endued with prowess, took their lives in the conflict, and cut off the heads (of warriors).","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3024024","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1858635489bec0c50006df04693685ad04178f20e160ea3080da29744c5e383d","compact":"f56293834815ad1cf41c5f1f89443bbfbfb4ba8d121e78684af2aede1204b80a","nasal":"f56293834815ad1cf41c5f1f89443bbfbfb4ba8d121e78684af2aede1204b80a"}},{"id":"VRCE-3-24-25","kanda":3,"kandaId":"aranya","sarga":24,"verse":25,"english":"And having their heads, and shields and bowstrings, severed, they fell as fall on the earth trees thrown down by blasts froin the wings of Suparņa*. Those rangers of the night that remained there, wounded by arrows, and losing heart, fled with speed to Khara, to seek his protection. *Lit.-Of fair feather. A name of Garuda.","alignment":{"type":"1:1","confidence":0.721,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-25"],"status":"unreviewed"},"source":{"sanskritLocator":"3024025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"51f4cf487c4a3ccab26d79fc4bb374554cb522e06a817c4e339a0d51b6767f5e","compact":"7862920f192433fd37f3a7d93bb008982983e5c7441d03151a1faa76086fd8fa","nasal":"bb6e06b9edcf578995a55f7af0c2c02c2da08ad22cd1977dcf661a4b858699d1"}},{"id":"VRCE-3-24-26","kanda":3,"kandaId":"aranya","sarga":24,"verse":26,"english":"Thereat, encouraging them, Dāsana, taking his bow, ran furiously in high rage against Răma, like the enraged Destroyer himself,","alignment":{"type":"1:1","confidence":0.412,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-26"],"status":"unreviewed"},"source":{"sanskritLocator":"3024026","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77a12060e2a0ffe3956bf476d0cdb8de9b1134b5a7a554042db7aee8886ec19f","compact":"5a56b3b8ae74e6200a8e9bc08869abf4f3f41f93280dc0bfd8288e5f588d784e","nasal":"3d052ca3c30671ee2abf170a412f8dfafe89a67f731329461fff8b2272ce35df"}},{"id":"VRCE-3-24-27","kanda":3,"kandaId":"aranya","sarga":24,"verse":27,"english":"And rallied again (by Dāsana) and, their fear dispelled through their having founded refuge with him, they armed with sālas, tālas, and crags, darted against Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-25-27"],"status":"unreviewed"},"source":{"sanskritLocator":"3024027","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d23e3551143ee1408b265587caad14f088a534276fc35bf0cfe6b7643ea695db","compact":"02eda67cbac2e68ba4528239d06cd05671af29d95f380caf878f4e25c506b97f"