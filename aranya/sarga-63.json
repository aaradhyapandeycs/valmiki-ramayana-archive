[{"id":"VRCE-3-63-1","kanda":3,"kandaId":"aranya","sarga":63,"verse":1,"english":"After Laksmana had spoken these highly sound and pleasant words, Rāma, ever taking to what is sound, accepted them.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-67-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3063001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f83090e93bfbfe97385518d3f5ba3924c0db2d3ffcd191d4230750aa50cc2a7","compact":"2495a7ddb948905fd17950843af3e70122446bb4035cc6a1dec54f7cffb8a535","nasal":"2495a7ddb948905fd17950843af3e70122446bb4035cc6a1dec54f7cffb8a535"}},{"id":"VRCE-3-63-2","kanda":3,"kandaId":"aranya","sarga":63,"verse":2,"english":"Thereupon that one, of mighty arms, slaking his flaming ire and reclining himself upon his beautiful bow, addressed Laksmana.","alignment":{"type":"1:1","confidence":0.821,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-67-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3063002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"982e9b1ed90d14b0a17c881c643a698fcc00eff3f329607afb5fd8c3eb379224","compact":"6e443e26402400ef344323b68b737a504fba61b1cfe453816ec249557bbb2045","nasal":"6e443e26402400ef344323b68b737a504fba61b1cfe453816ec249557bbb2045"}},{"id":"VRCE-3-63-3","kanda":3,"kandaId":"aranya","sarga":63,"verse":3,"english":"Do you ponder over, O brother, where shall we repair, what shall we do and by what means shall we come by Sītā?","alignment":{"type":"1:1","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-67-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3063003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a11641219d637d2e153df531338572b1fb21acf48315181c8e42a4a789a38b37","compact":"9a39efb911a8acf6d6a97c2731b460716fe5d6f1d6b49b6f3025c0a90b22b93a","nasal":"caf412644a060