[{"id":"VRCE-3-48-1","kanda":3,"kandaId":"aranya","sarga":48,"verse":1,"english":"Hearing these words Jațāyu, who lay buried in a deep slumber, awoke and beheld both Rāvana and Janaki.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-50-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3048001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4871404cfff04203968b3ec95d73187a7776c9349600410920a91770e20fa05b","compact":"63f312ed76093ccaa0dd206b328126e31adda0e6b3d91c24aed375a869f1f8b7","nasal":"63f312ed76093ccaa0dd206b328126e31adda0e6b3d91c24aed375a869f1f8b7"}},{"id":"VRCE-3-48-2","kanda":3,"kandaId":"aranya","sarga":48,"verse":2,"english":"There-at the lord of birds resting on the tree, having a big sharp beak like to the summit of a hill, addressed these soft words to Rāvana,","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-50-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3048002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c58282d4a9ad5979ac3778aeeb3b50a397660926b5bcecb1f3600339d9b1162","compact":"c0d9a497cce8e875661caefd51adc288082d954c96825fd71329b6c319816274","nasal":"37b110781271821ca39ae91aec65b17cf64a09b2d6465296497e74065b6ec7b0"}},{"id":"VRCE-3-48-3","kanda":3,"kandaId":"aranya","sarga":48,"verse":3,"english":"O brother Ten-necked one, I am conversant with Purāņas, of truthful vows and abide by religion. It does not behove you to perpetrate such an iniquitous deed before me. I am Jātayu, the mighty lord of vultures.","alignment":{"type":"1:1","confidence":0.885,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-50-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3048003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"977d5b5cbd7e047017bcdfb112dc2a5ad0db38a9e79978052f17aac72b8301