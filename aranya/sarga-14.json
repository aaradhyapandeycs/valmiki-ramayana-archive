[{"id":"VRCE-3-14-1","kanda":3,"kandaId":"aranya","sarga":14,"verse":1,"english":"Then repairing to Pañcavațī filled with various animals and beasts of prey, Rāma remarked to his brother Laksmana of flaming energy,","alignment":{"type":"1:1","confidence":0.59,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-15-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3014001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a175c9991eb1c0dc68e1f7c98492d6efc5c09ce92ca6cc1e33a33f1331cc31f3","compact":"525f2625fe007f2e7ab3176940e44b3adbfb196c398b3b71ef02c00afd1788b1","nasal":"e6e565bd2771281bc6ea9a28e3f6a5f51c0d6f352b644ade3e4dabe31361ab3c"}},{"id":"VRCE-3-14-2","kanda":3,"kandaId":"aranya","sarga":14,"verse":2,"english":"(Now) we have come to the place to which we had been directed by the ascetic This, O amiable one, is Pañcavați furnished with blossoming woods.","alignment":{"type":"1:1","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-15-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3014002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6020901449d34af30d16f490b86c79566493f66fadb8dbf70b8c67b382c3124a","compact":"0ede034058c7075cba4d4c87ee142961f6b40252567105897c500e88d8cfd282","nasal":"1550c1bfc5f7727fbf9010627b668808c9dbaecf55f8a654bd699621c30810c7"}},{"id":"VRCE-3-14-3","kanda":3,"kandaId":"aranya","sarga":14,"verse":3,"english":"Do you cast your eyes around this forest, and (ascertain) what spot shall suit our asylum.","alignment":{"type":"1:1","confidence":0.934,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-15-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3014003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6db8abdc6a2cc21b1e5ce92a7ee9145518e45758732fa8aaedbd14727a561c43","compact":"7d353d0696ae50c3e41f2075adbd0b580e50939691860f9503e3750f3103a445","nasa