[{"id":"VRCE-3-35-1","kanda":3,"kandaId":"aranya","sarga":35,"verse":1,"english":"Hearing the words of that sovereign of the Rākşasas, the highly energetic Mārica, skilled in speech, answered the Raksasa chief.","alignment":{"type":"1:1","confidence":0.805,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3035001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c1c4d07a27b5137df452429f77f0d98cb532c09573b924ae4dea544513275310","compact":"16f88947a0c7495c0941fe3c1471c4f66ae6446b372ee6409fcb8ba0d67a7bd1","nasal":"eef6ce4d24ee3c121cdf5f15e59ac3d168f7af6b87432149cc73559cbd40d3c8"}},{"id":"VRCE-3-35-2","kanda":3,"kandaId":"aranya","sarga":35,"verse":2,"english":"O king, the speaker of soft words is common, but the speaker and the listener of unwelcome though beneficial words are rarities.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3035002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"45d66dc6a138dae286f74c8e5fd87bbae718edf19455384bec2224422313b2b4","compact":"e600d6f7fe2e32e56e58941b8e4d84285843aade6143c3cc93d5d9ee3cc49822","nasal":"e600d6f7fe2e32e56e58941b8e4d84285843aade6143c3cc93d5d9ee3cc49822"}},{"id":"VRCE-3-35-3","kanda":3,"kandaId":"aranya","sarga":35,"verse":3,"english":"Volatile, and employing no spies, you surely do not understand the exceedingly powerful Rāma towering high in virtues, and resembling the illustrious Indra or Varuņa himself.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3035003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"779c9cb1afa038eb2e5735f52028131fa96e748b020ded0705c29e911608d00b","compact":"9d7185b