529633880b1b4cc26d2f9d22653423d8d3799ca883a07c391ea5f174e","compact":"d3706ff0a23f51798231be59251a7674f636f961ae2f9563ea3aba744e913d67","nasal":"77b95b3d9d5edac24a16e554f11f660c5205251ab627c6c541e58929da205b7f"}},{"id":"VRCE-3-35-7","kanda":3,"kandaId":"aranya","sarga":35,"verse":7,"english":"The sovereign who is wicked, whimsical and of evil intent like you, bring about his own destruction as well as that of his kingdom and relatives.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3035007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b3872e6b2aac3780ad1c3a0a384f5fa66ac8507d40fb5ac67f6c374d52010f2","compact":"48caa444aeab7e85a1e163ff48a12ccfeae882aa4faea8e4bd19cdc7fde1c0ad","nasal":"ffc9819b7a8e0a1eb70b24ee9767521f48f0ceb299a7fa6d17b71dd79645377a"}},{"id":"VRCE-3-35-8","kanda":3,"kandaId":"aranya","sarga":35,"verse":8,"english":"Rāma, the enhancer of Kausalyā's delight had not been abandoned by his father, nor is he devoid of propriety of conduct; he is not avaricious, wicked nor the destroyer of Kaşatriya race.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3035008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80d39cf3a0f64fc6654c0411addd2e6e28865fc32b4e1d8cfb9e1da55c568f7c","compact":"34dda35e550e51ea16dd4c0a2b47027dd2ba296170f2748f20cb224f52d592bc","nasal":"34dda35e550e51ea16dd4c0a2b47027dd2ba296170f2748f20cb224f52d592bc"}},{"id":"VRCE-3-35-9","kanda":3,"kandaId":"aranya","sarga":35,"verse":9,"english":"He does not lack religious merits or accomplishments, nor is he of a harsh temperament and intent on causing misery to creatures.","alignment":{"type":"1:1","confidence":0.548,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3035009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5162170b97404501505bd5f5a65246a12b63d8add4628442e4a6f1966b2912ab","compact":"737a8499e1daee3d49abac547e39c46becb78e0c1c86043d6655785e7cf11bcc","nasal":"a6ca70f673f02d20dbf0b9dd0c6acc0b4ec04a8220a76f1d82caf24dab8ef089"}},{"id":"VRCE-3-35-10","kanda":3,"kandaId":"aranya","sarga":35,"verse":10,"english":"Finding his truthful sire imposed on by Kaikeyi he has sojourned to woods. For compassing the welfare of his father Dasaratha and Kaikeyi he has entered the forest of Dandaka.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3035010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"381cd5f03f879a5cb351d16d856dbab249bbfdb759575dedb2e5a4c671799f18","compact":"b6d50a564c0c17e92fba7ac61e0a30efa0c247c3218f507052fa2d2217d82cb2","nasal":"3798628fd64a351103ffc6e3a6ae5d2931e6abdca30b20739d1fc4ffa5701548"}},{"id":"VRCE-3-35-11","kanda":3,"kandaId":"aranya","sarga":35,"verse":11,"english":"Finding his truthful sire imposed on by Kaikeyi he has sojourned to woods. For compassing the welfare of his father Dasaratha and Kaikeyi he has entered the forest of Dandaka.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3035011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c97d257d13feb0979a63db012528512d103f30ea0b98abae115b97f26098793d","compact":"ed2dc084b8fc85584d730e6f1a02f406f4adfc8c1dc8b13d39ef620eefcff725","nasal":"36dcb3adcbf75f7480e426b0e3fd9ede3e243392962d6ffa37159d08f6ac0eba"}},{"id":"VRCE-3-35-12","kanda":3,"kandaId":"aranya","sarga":35,"verse":12,"english":"Rāma, O my child is not harsh or foolish; nor has he not control over his senses. Far from speaking untruth he does not know false stories even.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3035012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f10c723d31187d54e71e588ec437fe41980e236dba30365bfa9cef1a5b1804dc","compact":"70d23a6352fc4c7d0839dd2e7465b26761bdeef9be8572277fe0c7a19bd7e038","nasal":"a4d50e1e135e169041863e45f3debe135af8e785cf4c345323aa5898ade88483"}},{"id":"VRCE-3-35-13","kanda":3,"kandaId":"aranya","sarga":35,"verse":13,"english":"It did not behove you therefore to use such improper language towards him. he is an incarnation of virtue, pious and truthful, and lord of all men as Vāsava of all celestials.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3035013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"45a6a9a08a62582eca6c9359ca9ddadac71e15f3d29b902ee7559cb16215ef50","compact":"ab4844e4b40ad3d42f3341ea3036f2b9809fe1a761606088d85b2f041f89dc25","nasal":"5fcd99bcffb511b1b0dfd7561f34d2d4ff5aa3f2a091e2067a5500ed4764919d"}},{"id":"VRCE-3-35-14","kanda":3,"kandaId":"aranya","sarga":35,"verse":14,"english":"How does you then wish to carry away by force his Vaidehī, protected by virtue of her own chastity, like to the rays of Sun?","alignment":{"type":"1:1","confidence":0.762,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3035014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1de4374d0c18131b3308188280939a74388609f0cf11bade9e462a20dad2e6f","compact":"2ccb07367f8374ef244d833d30ce880f9ac3285b427e4f924daedba2f4983570","nasal":"2ccb07367f8374ef244d833d30ce880f9ac3285b427e4f924daedba2f4983570"}},{"id":"VRCE-3-35-15","kanda":3,"kandaId":"aranya","sarga":35,"verse":15,"english":"It did not behove you to enter that fire of Rāma who has arrows for rays and bow and scimitar for fuel. It did not behove you,","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3035015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f51bac1206d9094218213e37ec4ad5915b217857dd43437f82d4dd1370a9a485","compact":"6b6267ed7772152bcaceac35c11eb6fc3a9b686ea8c3f642a4a569cc225eac85","nasal":"8365bd9f05a51def763d2e7cace1bc5c90ecd80093987c67203dfc88b95d1d4f"}},{"id":"VRCE-3-35-16","kanda":3,"kandaId":"aranya","sarga":35,"verse":16,"english":"O Rāvana, to approach Räma renouncing your kingdom, happiness and love of life, who is like to death itself and has bow for his widened and flaming mouth, and arrows for his rays and who is irrepressible, of mighty prowess, holding bows and arrows and repulsing the forces of the enemy.","alignment":{"type":"grouped","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3035016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b88b407e04290c09a019104541492e8a49789669f7ebbb6da3678cc630215ba","compact":"91c32de2ba04b5f6950209470bb7fd13a136e643bdd3744aea7f5db2ca1dc017","nasal":"91c32de2ba04b5f6950209470bb7fd13a136e643bdd3744aea7f5db2ca1dc017"}},{"id":"VRCE-3-35-17","kanda":3,"kandaId":"aranya","sarga":35,"verse":17,"english":"O Rāvana, to approach Räma renouncing your kingdom, happiness and love of life, who is like to death itself and has bow for his widened and flaming mouth, and arrows for his rays and who is irrepressible, of mighty prowess, holding bows and arrows and repulsing the forces of the enemy.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3035017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"18e99cada9135ceab69b5d96c4a213636dc44fd8c7b5408065551d0ee319fb45","compact":"df2a79ed5a77ea00bb59906ce27c3fee3faee57cd1aa2a81acf10c04385bbf51","nasal":"c0b21119f67ceadfe0d8537141c13489cfafdf763b431053496d2ec79e4053f6"}},{"id":"VRCE-3-35-18","kanda":3,"kandaId":"aranya","sarga":35,"verse":18,"english":"Incomparable is his power; daughter of Janaka is his wife and lives in the forest confiding in the mighty strength of his bow; you shall not be able to carry her away.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3035018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0795f464fe83f43000c51b060cae7f53ce06a2e7a3ab6dc5c079511c820f2882","compact":"6546b8293c59a2aa9baccdb9d20d99ab932f371a626af2b7759b4565902b5690","nasal":"6546b8293c59a2aa9baccdb9d20d99ab932f371a626af2b7759b4565902b5690"}},{"id":"VRCE-3-35-19","kanda":3,"kandaId":"aranya","sarga":35,"verse":19,"english":"She is the beloved wife of that best of men having a leonine chest—and he holds his wife dearer than his life and is ever attached to her. And young Sītā beloved of the mighty Rāma, and like to the rays of flaming fire is ever incapable of being carried away by you.","alignment":{"type":"split","confidence":0.485,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-17","DUTT-3-37-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3035019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1032a9d841c697cc1a8e6373b03a9d26ebd4c33ddf1eec2bdbe8727ddcf1b088","compact":"5216601429a8b129fb57f58b5c0c62e4b557b11bec97a5175dde23c7e65aa47e","nasal":"5216601429a8b129fb57f58b5c0c62e4b557b11bec97a5175dde23c7e65aa47e"}},{"id":"VRCE-3-35-20","kanda":3,"kandaId":"aranya","sarga":35,"verse":20,"english":"Of what avail is this vain attempt O Rākşasa chief? No sooner Rāma shall see you in the battle you shall meet with your end. Hard it is to attain life, happiness and kingdom, so it behoved you to act properly, after consulting with your ministers headed by Vibhīşaņa, judging Rāma's merits and demerits and ascertaining his and your own strength and as well as your welfare.","alignment":{"type":"split","confidence":0.566,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-19","DUTT-3-37-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3035020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a051cb17af463033018dbcf47f392756b84a1d28ee549ddec9d5d868abd9a893","compact":"1a4869be49498c1978a92ec3c3a73a2cb07dbe47861e29b701401170384017c4","nasal":"38c3c5483adbfc4468f01454e6bce2a2617c5bf0105fc9a53a85307130e7eabf"}},{"id":"VRCE-3-35-21","kanda":3,"kandaId":"aranya","sarga":35,"verse":21,"english":"Hard it is to attain life, happiness and kingdom, so it behoved you to act properly, after consulting with your ministers headed by Vibhīşaņa, judging Rāma's merits and demerits and ascertaining his and your own strength and as well as your welfare.","alignment":{"type":"grouped","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3035021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"16724ff569682fa4f3667c753def7943aac3932d66d8f05a9180c87c7dfcab82","compact":"72255299c103e8592dae046b12233573cd573194999a7d3ee9b6ceaffd9c7af9","nasal":"75aae11d67aa5492ea4dfba650aee0e1990fb3b8262ecce222a95f53f7c44fa1"}},{"id":"VRCE-3-35-22","kanda":3,"kandaId":"aranya","sarga":35,"verse":22,"english":"Hard it is to attain life, happiness and kingdom, so it behoved you to act properly, after consulting with your ministers headed by Vibhīşaņa, judging Rāma's merits and demerits and ascertaining his and your own strength and as well as your welfare.","alignment":{"type":"grouped","confidence":0.918,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3035022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ccdf11efe1c95252a73a25f9ccd4e7fecc13da13b6441493daba1a67688c7bb","compact":"4261904ca5a0c57a0a3d06d3795cff46ccfbc0e196ae45ca00623166693f88d2","nasal":"4261904ca5a0c57a0a3d06d3795cff46ccfbc0e196ae45ca00623166693f88d2"}},{"id":"VRCE-3-35-23","kanda":3,"kandaId":"aranya","sarga":35,"verse":23,"english":"Methinks your approaching conflict with the son of the Kosala chief forebodes no good to you; hear again therefore O prince of the night rangers, words sensible and lending to your welfare.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-37-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3035023","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ef294b7f41759e3ac1d8c170f662f8d93c702707f8d1ca0a3e7f21182caa42db","compact":"a896b1af2702cbd88a8a39f61639da5bf3bfb91d827566fdcee3c815f1a27614","nasal":"a896b1af2702cbd88a8a39f61639da5bf3bfb91d827566fdcee3c815f1a27614"}}]
