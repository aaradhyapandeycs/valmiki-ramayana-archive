"],"status":"unreviewed"},"source":{"sanskritLocator":"3008027","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3554c5b32efbe5a6c04d6b6f4d7a9cc183d86a0160a4ed2ff9be15f88ae01ba9","compact":"f3bc9d031617ce1b39abff3e68c985382c3da02ad234bdb8bedeb4b907e8c0cd","nasal":"f3bc9d031617ce1b39abff3e68c985382c3da02ad234bdb8bedeb4b907e8c0cd"}},{"id":"VRCE-3-8-28","kanda":3,"kandaId":"aranya","sarga":8,"verse":28,"english":"O mild one! ever cherishing your heart in purity, do you practise piety in the wood of asceticism Everything the three worlds are truly known to you.","alignment":{"type":"1:1","confidence":0.859,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-9-27"],"status":"unreviewed"},"source":{"sanskritLocator":"3008028","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c074ffe82bbede679768b02b58e6940b1ce6cc5a8944d0b2805f7742364060c4","compact":"4d69ef6dd814a37ea87264efc15aa16adfe272ca49c0888113eaf49d818cc887","nasal":"4d69ef6dd814a37ea87264efc15aa16adfe272ca49c0888113eaf49d818cc887"}},{"id":"VRCE-3-8-29","kanda":3,"kandaId":"aranya","sarga":8,"verse":29,"english":"I have spoken this through feminine fickleness. Who can speak of righteousness to you? Reflecting on and understanding things, do you along with your younger brother speedily do what you like.","alignment":{"type":"1:1","confidence":0.907,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-9-28"],"status":"unreviewed"},"source":{"sanskritLocator":"3008029","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bf29d11eaf64d88874f74de461550b408ac1088b42c81694724e78edd1e88098","compact":"be6f6a5e1dc64b6bcab6e447bacda04689164ba7e6787214cc7e9884b3e108df","nasal":"be6f6a5e1dc64b6bcab6e447bacda04689164ba7e6787214cc7e9884b3e108df"}}]
