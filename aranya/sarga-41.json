row.","alignment":{"type":"grouped","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-43-41"],"status":"unreviewed"},"source":{"sanskritLocator":"3041048","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b41bc20967f4363c0b0dc646ebcbf7d6cec2662c5e3b001d5f5e8409de3823f0","compact":"662d59dabe8e2dfca549fe9f4a9b9217c98135aaaae82d4dbbc0b568854713b4","nasal":"662d59dabe8e2dfca549fe9f4a9b9217c98135aaaae82d4dbbc0b568854713b4"}},{"id":"VRCE-3-41-49","kanda":3,"kandaId":"aranya","sarga":41,"verse":49,"english":"Do you stay here, O Lakşmaņa, with Jānakī in constant fear and vigilance, along with the mighty Jațāyu, intelligent and ever engaged in pious offices.","alignment":{"type":"1:1","confidence":0.915,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-43-42"],"status":"unreviewed"},"source":{"sanskritLocator":"3041049","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cda92cf4c99bea669a5515eefdabbafad7c87f759db7a472efa17b9375afdf08","compact":"00d3cbca763881fdb41dbe0dd969e5480e47c335bfcdd5b449767fde4a888952","nasal":"ffff3b4f7833d8f95d24fba02b30ce76af82f48da23455c4a7dd40065373e745"}}]
