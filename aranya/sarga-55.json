":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3055016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c1c3c4459a7b1ac8b156941e37f8bced5f43358c8f9863aeabdb238f02cff93","compact":"dee015d7b6dc32f970007f65d94c37b084afff924c558df57830a530a99f8dc6","nasal":"dee015d7b6dc32f970007f65d94c37b084afff924c558df57830a530a99f8dc6"}},{"id":"VRCE-3-55-17","kanda":3,"kandaId":"aranya","sarga":55,"verse":17,"english":"I make no doubt, O hero, but that Janaka's daughter has either been slain or devoured by Rākṣasas ranging the forest.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3055017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62ef094994535e3bd3e96e476bdd21a1b0fa42d1f1deed5127d137ee0aaaab18","compact":"edea94f7de2b25ec68515ad98a3b6c816b63710b160b68b3b43d14dc4d6963fe","nasal":"edea94f7de2b25ec68515ad98a3b6c816b63710b160b68b3b43d14dc4d6963fe"}},{"id":"VRCE-3-55-18","kanda":3,"kandaId":"aranya","sarga":55,"verse":18,"english":"And, considering the many omens that take place before me, O Laksmana, I do not know whether we shall light upon welfare of Janaka's daughter Sita being alive, O best of men.","alignment":{"type":"1:1","confidence":0.957,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3055018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b9cdc466e560a1577e88ae48b40da0bf478e78f1fef8a11c615017ee50c4aa1","compact":"49b76e32f09817d8fbde156a09760d2f7459cd1d19f24b7fbb534bb49f40f60a","nasal":"07c7838e3219cc0b06e8dcee3e67e8c88ccad351f5e2d79153bfa58ad00373d7"}},{"id":"VRCE-3-55-19","kanda":3,"kandaId":"aranya","sarga":55,"verse":19,"english":"This Rākşasa, who, wearing the shape of a deer, and, alluring me, had drawn me far, has in some sort been slain by me wiih much ado; and he became a Rāksasa at the time of his death.","alignment":{"type":"1:1","confidence":0.901,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3055019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d57a5316daa046a77cf7fbb0b33a6d7419d0d24f311fc6e265faffc0f60ded80","compact":"2d8dae8caeed1f9754f2fa0ed7aad49c11490f1794e4395750c7a2b8290d56c7","nasal":"2d8dae8caeed1f9754f2fa0ed7aad49c11490f1794e4395750c7a2b8290d56c7"}},{"id":"VRCE-3-55-20","kanda":3,"kandaId":"aranya","sarga":55,"verse":20,"english":"Yet my mind is poor and cheerless; and my left eye throbs. Doubtless, O Laksmana, Sita is not, she is either carried away, or dead, or is wandering on the way. SECITION 58","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-57-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3055020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5638030e4e74420b93a2572686fcf6d18d681cf3961b246da55d38656be3fd55","compact":"420d20b2a65c65cb537e2ce5e9e12c60e5c2fc73aea6441c0535fe61fb7eb729","nasal":"420d20b2a65c65cb537e2ce5e9e12c60e5c2fc73aea6441c0535fe61fb7eb729"}}]
