91–94"},"sanskrit_fingerprints":{"exact":"171609c4eca61c19ebc8af008d63cd25b939d65f6f125b9a2a1a913c28aba4a0","compact":"94311b404a5fee05f2c2b4b5a5181dd3ce52915b7c81d7d14e7860f5c011e27e","nasal":"7ccf2204a8089a4c5ac7f99a55c644e087634c4c368165efe5abd0af400dbc16"}},{"id":"VRCE-3-12-18","kanda":3,"kandaId":"aranya","sarga":12,"verse":18,"english":"And that tract is worthy of all praise, and, O Rāghava, it is not distant from here. It is in the vicinity of the Godāvarī. Mithilā's daughter shall live there agreeably.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-42"],"status":"unreviewed"},"source":{"sanskritLocator":"3012018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"efe96f4ae4044e8b9b2688fe698db073c4205d7787af02b32365d91d67bad453","compact":"60409d7278b4b2218031b3d6d64aeaa48dc883aa48056d9150525ae6f37bf2ac","nasal":"60409d7278b4b2218031b3d6d64aeaa48dc883aa48056d9150525ae6f37bf2ac"}},{"id":"VRCE-3-12-19","kanda":3,"kandaId":"aranya","sarga":12,"verse":19,"english":"And that spot abounds in fruits and roots, is frequented by various fowls, is retired, O mighty-armed one, and is sacred and beautiful.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-43"],"status":"unreviewed"},"source":{"sanskritLocator":"3012019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ec639f007f16818026fa734403e289fdf3ed491cde052e3f95c72d50c609506","compact":"2775fb145200892549ea19ca8e759c44c0e99469247894a698bd104120bf4fc5","nasal":"2775fb145200892549ea19ca8e759c44c0e99469247894a698bd104120bf4fc5"}},{"id":"VRCE-3-12-20","kanda":3,"kandaId":"aranya","sarga":12,"verse":20,"english":"And you of pure ways, and competent to protect the ascetics, shall, O Rāma protect them.","alignment":{"type":"1:1","confidence":0.643,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-44"],"status":"unreviewed"},"source":{"sanskritLocator":"3012020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fac75acd7228c8449a87ed6b414c0dc17602ec3e2b951d7e9fb5946146196301","compact":"3073ae306fdf64e02c126620c2aafd0e48720dbc95570ce11529a437de5a1efa","nasal":"3073ae306fdf64e02c126620c2aafd0e48720dbc95570ce11529a437de5a1efa"}},{"id":"VRCE-3-12-21","kanda":3,"kandaId":"aranya","sarga":12,"verse":21,"english":"O hero, yonder is the mighty wood of Madhūkas. Directing your course to the asylum of Nyagrodha trees, go by the north of this Madhūka wood. Then arriving at a spot hard by a hill, (you will) come upon the celebrated Pañcavați, crowned with blossoming woods.","alignment":{"type":"grouped","confidence":0.583,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-45"],"status":"unreviewed"},"source":{"sanskritLocator":"3012021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"caac0f8afbd9c8634807a899a61a6d657a404cd3bef97c363f0e65cdd5708da9","compact":"ea0542f2254927e7785a45821f43e9cbbac323b5cfd91f49fa85a73eee305307","nasal":"a0082044d4841dcbc3a8c0f808722fa0b9a123c569ce0f8eed9baf262f26f216"}},{"id":"VRCE-3-12-22","kanda":3,"kandaId":"aranya","sarga":12,"verse":22,"english":"O hero, yonder is the mighty wood of Madhūkas. Directing your course to the asylum of Nyagrodha trees, go by the north of this Madhūka wood. Then arriving at a spot hard by a hill, (you will) come upon the celebrated Pañcavați, crowned with blossoming woods.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-45"],"status":"unreviewed"},"source":{"sanskritLocator":"3012022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ba547412752f4ece51dcab26b62a472ecf4c72316820af9bfd694cc761b44fc","compact":"d4260104ecd907b8baa50188fdb8f5c481f3156be7b67a57ef974fc1b8639621","nasal":"31304f63c28fac45acb3b985d8c9df4bff4