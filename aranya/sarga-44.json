3.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"930b30fbdac1cc26e7f742ccda266f0b0b15226b718f237ec086e6d5f7560f0e","compact":"9a91db536443f36a91d9d032d09add01355d6f3da6ac6da81ab54abded6d00cc","nasal":"9a91db536443f36a91d9d032d09add01355d6f3da6ac6da81ab54abded6d00cc"}},{"id":"VRCE-3-44-17","kanda":3,"kandaId":"aranya","sarga":44,"verse":17,"english":"All your teeth are equal having their tops like to the buds of Kunda flower, beautiful and yellow. Your eyes are expansive, clear, of bloody hue, and having black pupils. Your hip is fleshy and spacious. Your thighs are like those of elephants, round, fleshy and perfectly strong.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-46-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3044017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"44f55dc5456d3a6cae6648ee3bc2f19181eee28d21eed8cb5e0c0254598f1139","compact":"d5a74961e3949e3a2f98b5e4b4e917e47d834611a8996aa5b06074df01d5517b","nasal":"b1833fcb21722a495c92b657d87c48e8eec6c034ba6ce31ff219e34e03c0638a"}},{"id":"VRCE-3-44-18","kanda":3,"kandaId":"aranya","sarga":44,"verse":18,"english":"All your teeth are equal having their tops like to the buds of Kunda flower, beautiful and yellow. Your eyes are expansive, clear, of bloody hue, and having black pupils. Your hip is fleshy and spacious. Your thighs are like those of elephants, round, fleshy and perfectly strong. Your nipples are bulky, pointed, highly captivating like cold palm fruits, beautiful and ornamented with diverse jewels.","alignment":{"type":"split","confidence":0.365,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-46-14","DUTT-3-46-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3044018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ca4689e736f48050c20761895dd3dcf086123128ebf962a7b0d50ee4dbeed21","compact":