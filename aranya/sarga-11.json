nt.","alignment":{"type":"1:1","confidence":0.774,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3011006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3d5477566a40469c066fb36be05d5d9a4152c173450151e5f343393cb9bd1258","compact":"8af66161e7beccf6d2ad9d487f3102578e8eb4a3b320edfd2c527dff457af9fe","nasal":"3949d9f77be6325543f856532601dfbc918b6748e32aba955261a3a1eb895f36"}},{"id":"VRCE-3-11-7","kanda":3,"kandaId":"aranya","sarga":11,"verse":7,"english":"For seeing the reverend one, and serving him as well, those subduers of their foes, Dasaratha's sons, Rama and Laksmana, accompanied by Sītā, have entered this asylum. It now behoves you to command what is to be done next.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3011007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"48d44abe614ff0a3f2ae614e23aca7d917709fc0a12c64408184245e1a8e2ea7","compact":"1db3d4c89003da4da2e40c5e6a21601963d71c4002ac6ee90425b612666ef251","nasal":"1db3d4c89003da4da2e40c5e6a21601963d71c4002ac6ee90425b612666ef251"}},{"id":"VRCE-3-11-8","kanda":3,"kandaId":"aranya","sarga":11,"verse":8,"english":"For seeing the reverend one, and serving him as well, those subduers of their foes, Dasaratha's sons, Rama and Laksmana, accompanied by Sītā, have entered this asylum. It now behoves you to command what is to be done next.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-12-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3011008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"128ae21432b87aede03d1129e342fbec2fb7d4544a59552e503babe6bfa87f4b","compact":"4fb9093744bbc3810336a006b91a638efe3e3478a5cb3cd8f3938e9d84cf2b74",