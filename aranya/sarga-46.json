[{"id":"VRCE-3-46-1","kanda":3,"kandaId":"aranya","sarga":46,"verse":1,"english":"After Sītā had spoken these harsh words, Rāvana, enraged, with a frown, replied.","alignment":{"type":"1:1","confidence":0.597,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3046001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f65a315d5ef3345d5c8e6158485ac22240dada1515276886ee0f0098e760741c","compact":"dcf6ec14c020a010d33a9fb0e70c1dbcb730b3d8fd7a4117e272076d426db0e7","nasal":"dcf6ec14c020a010d33a9fb0e70c1dbcb730b3d8fd7a4117e272076d426db0e7"}},{"id":"VRCE-3-46-2","kanda":3,"kandaId":"aranya","sarga":46,"verse":2,"english":"O you of a beatiful countenance, I am the step-brother of the Lord of wealth and my name is the mighty Ten-necked Rāvana May good betide you!","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3046002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7941ce655c937c2de0f389fa5eb5b983e0985c10ca7467399a248b1b25642aad","compact":"cfe36c62b6405a3449b6a578d623a22f11f920f19cde1432a2c677784493ec08","nasal":"cfe36c62b6405a3449b6a578d623a22f11f920f19cde1432a2c677784493ec08"}},{"id":"VRCE-3-46-3","kanda":3,"kandaId":"aranya","sarga":46,"verse":3,"english":"Like to people fearing Death, the celestials, Gandharvas, Piśāchas, Pannagas and Serpents fly in diverse directions being frightened by me. I have subdued by my prowess, my step-brother, the Lord of wealth in a conflict, quarrelling with him for some reason.","alignment":{"type":"grouped","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3046003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f39cfa7c94dacd6a17f62bcf88f45