pe":"1:1","confidence":0.983,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3046006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"44f0870a54cd953eea177356ea81e2879d4315e9bf0bed97cecc5055508dfdb7","compact":"f7eb69c662ae666b0204b08972ed640e4510bdcf55342e49e0e40f92557aa32a","nasal":"f7eb69c662ae666b0204b08972ed640e4510bdcf55342e49e0e40f92557aa32a"}},{"id":"VRCE-3-46-7","kanda":3,"kandaId":"aranya","sarga":46,"verse":7,"english":"O Maithilee, when I am excited with ire, Indra and other celestials at the mere sight of my countenance fly away in divers directions out of fear.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3046007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8fb0871c4189dc2e41137ed62371bb6d6bd74401e564f4ae6b352ea2f3b5d406","compact":"c6adc067422f5e685e6ddcb26c61fc34182072b652ac1155957164451c2754c5","nasal":"0bb98f48efeb7edd87ecad8d0725d82615668c90e7a2b105369b0a2013f7425c"}},{"id":"VRCE-3-46-8","kanda":3,"kandaId":"aranya","sarga":46,"verse":8,"english":"Wherever I live, the Wind bloweth cautiously and the Sun (of piercing rays) out of fear for me appeareth in the welkin like the Moon.","alignment":{"type":"1:1","confidence":0.838,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3046008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"54b947132c92bed223813c327c4bd2dc731ebe107a631d54569eb3d62f1e7deb","compact":"c00577d5ad39f8cd72d2b48a82c3a6a6126456736e534d40cad7eb450b076f4b","nasal":"3a9f09ec79787ee596fe6365621676cf53a36bb5264bc2003d8949ecbfb2e017"}},{"id":"VRCE-3-46-9","kanda":3,"kandaId":"aranya","sarga":46,"verse":9,"english":"What shall I say more? Wherever I live, even the leaves of the trees do not flutter and the currents of the rivers are stopped.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3046009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a31c2d575d14ea544d359aaba19e5fbffae0958dfb128671387fd0bd92c517a","compact":"f0451733cf5a09fd90e666505a680b4607f278a8c6e5737377c8b0b5fa08f580","nasal":"098a45eb5788a15455415851485d2e51ad334ff0fd4f6206af01b9a5e1ff7825"}},{"id":"VRCE-3-46-10","kanda":3,"kandaId":"aranya","sarga":46,"verse":10,"english":"Beyond the ocean stands my beautiful capital Larikā like to Indra's Amaravati, (the capital of the Lord of celestials), guarded on all sides by the terrible night-rangers and encircled by yellow walls.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3046010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e25f8e2782df8e9392cb9034b4e42e8d0e93a881189936bb2c4a707fcdf5e0e","compact":"2eccf0f01493e41a7ed070def1ea60c2a51692b794ab41fc1153bc20ed7958f7","nasal":"f8a7b5e3ad1a818d6a9c4004526abf347a61001b3b37301f3d375ee644d6591b"}},{"id":"VRCE-3-46-11","kanda":3,"kandaId":"aranya","sarga":46,"verse":11,"english":"That beautiful city has gate-ways of ornamented and jewelled arches and golden apartinents.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3046011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e22c7fbb925e8e7bfe487f6ad0ab2e12d86aa585c8b2014168ef7d53a652bcef","compact":"b4e471670a77717ad7d0517cf34d6fa9e1697f9fff734e4274db26be8fe87769","nasal":"518fc312beeb078994a28934426099ad5d1eeaf13a758c3b436efcc537565fbf"}},{"id":"VRCE-3-46-12","kanda":3,"kandaId":"aranya","sarga":46,"verse":12,"english":"It is filled with clephants, horses and chariots, always resounds with the sounds of bugles, and is beautified with gardens having divers trees of wished-for fruits.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3046012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0bfa9d51a992eb49008b4b338b2c083b33c315638ac36a1cb8a324364bc69aec","compact":"8808c8c182a4465b4d075d0b99c943e097be12ac385f9888c5f61e59942ff5bf","nasal":"8808c8c182a4465b4d075d0b99c943e097be12ac385f9888c5f61e59942ff5bf"}},{"id":"VRCE-3-46-13","kanda":3,"kandaId":"aranya","sarga":46,"verse":13,"english":"O Sītā, O you the daughter of a king, in this city shall you dwell with me. O large-minded damsel, you shall never think of earthly women.","alignment":{"type":"1:1","confidence":0.69,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3046013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2a197dc3b3c584901fdd3c1f18972c8b43f3e467de1d98ff816ffa7e4d9559a1","compact":"d6a66027c0f69a91ea10ba262d7af0ac19af14e1875c36075b3cb0ba1159e2e6","nasal":"d6a66027c0f69a91ea10ba262d7af0ac19af14e1875c36075b3cb0ba1159e2e6"}},{"id":"VRCE-3-46-14","kanda":3,"kandaId":"aranya","sarga":46,"verse":14,"english":"O you of an exquisite countenance, enjoying these many things passing human, you shall not any more think of Rāma a human being of brief existence.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-48-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3046014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2fdd4ac6580b9cd765478d5f6695ae3f15f0794d4ce