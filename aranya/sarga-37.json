[{"id":"VRCE-3-37-1","kanda":3,"kandaId":"aranya","sarga":37,"verse":1,"english":"I Was however somehow saved by Rāma in that conflict. Listen what happened afterwards.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-39-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3037001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2f792fc9c9368dce26900f491826712e56195da3defc5853b31d70bdd8a9a698","compact":"111535c365aeaa181269a71e868a891b44fb914b0355a817e7a0d4749d3d331b","nasal":"111535c365aeaa181269a71e868a891b44fb914b0355a817e7a0d4749d3d331b"}},{"id":"VRCE-3-37-2","kanda":3,"kandaId":"aranya","sarga":37,"verse":2,"english":"I was not humbled even by the danger of my life. Once again I entered the forest of Dandaka accompanied by two Rākşasas assuming the shape of deer.","alignment":{"type":"1:1","confidence":0.971,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-39-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3037002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e837dc421a33b83ebc7f138a76a20fa8a18cedef20aa43358ed27f58e2523ac0","compact":"f977f5eba6ded62fd603e46cd1b2eb048f5fafce7e55ce340ea200b3c0f4c1df","nasal":"d94c8431ca5917fbae860781a0bc4d5d0fab7a77d1e1a135fb9431652e942bdc"}},{"id":"VRCE-3-37-3","kanda":3,"kandaId":"aranya","sarga":37,"verse":3,"english":"I had a flaming tongue, huge teeth, sharpened horns and lived on the flesh of ascetics. Assuming such a terrible appearance I began to traverse with great vehemence the Tīrtha, Agnihotri and the place of worship; eating the flesh and drinking the blood of the ascetics after killing them I began to hinder all religious services.","alignment":{"type":"grouped","confidence":0.769,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-39-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3037003","sanskritFile":"Ram03.txt","englishEdition":"M. 