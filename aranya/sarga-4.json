[{"id":"VRCE-3-4-1","kanda":3,"kandaId":"aranya","sarga":4,"verse":1,"english":"Having in the forest slain the Rākṣasa Virādha possessed of tremendous strength, Rāma endued with prowess, embracing and cheering Sītā, spoke to his brother Lakşınaņa of flaming energy, saying, This dense forest is hard to live in; nor are reacquainted with the was of the wood. Therefore will we speedily repair to the ascetic Sarabhanga. Thereupon Rāghava set out for the hermitage of Sarabhanga.","alignment":{"type":"grouped","confidence":0.707,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3004001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f39ae2f5f66e0aa2f443cdb41a6a4119f97b2fe0e31dd41071e067a934ddd89a","compact":"77df0b4882eb2a28e2b9408eda55963aa0e0382c8474972e0504a7bf86602a3f","nasal":"77df0b4882eb2a28e2b9408eda55963aa0e0382c8474972e0504a7bf86602a3f"}},{"id":"VRCE-3-4-2","kanda":3,"kandaId":"aranya","sarga":4,"verse":2,"english":"Having in the forest slain the Rākṣasa Virādha possessed of tremendous strength, Rāma endued with prowess, embracing and cheering Sītā, spoke to his brother Lakşınaņa of flaming energy, saying, This dense forest is hard to live in; nor are reacquainted with the was of the wood. Therefore will we speedily repair to the ascetic Sarabhanga. Thereupon Rāghava set out for the hermitage of Sarabhanga.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3004002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1ffe5e607255d74f5d2ab97ebe127c66f8ebbefc16781e1a064638202bda0887","compact":"b326e46ce8931051cca4f56862933a080bde85460c600051f4bad502d7f4f141","nasal":"7405972dea68606268d7ea5116276a537fb57d98f65fe18a31e5b17e9e5c5288"}},{"id":"VRCE-3-4-3","kanda":3,"kandaId":"aranya","sarga":4,"verse"