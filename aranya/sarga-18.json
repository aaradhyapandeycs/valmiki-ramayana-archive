[{"id":"VRCE-3-18-1","kanda":3,"kandaId":"aranya","sarga":18,"verse":1,"english":"Seeing his sister deformed, and covered with blood, fallen on the ground, the Raksasa, Khara, fired with wrath asked her.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-19-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3018001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"386bc987a8dea13d6ea41d32d2ff9c17ff81851f85922a12903ba973a274c70a","compact":"a18d7e9c970ab07dfb92e517ee17630fb52ffaaf2868bf0a7474408e4f8051c3","nasal":"0881ef5c9965276022701df84e37785ff53f2b88fbd3cf4dcd417a30c2e078ae"}},{"id":"VRCE-3-18-2","kanda":3,"kandaId":"aranya","sarga":18,"verse":2,"english":"Endowed with strength and prowess, ranging about at will, wearing shapes at pleasure, and resembling the destroyer himself, going to whom hast you come by this condition?","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-19-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3018002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f5422f04f04781f5f65ffb6bb142b40c9487d12eca71b857f043b4609f17a70e","compact":"202fd66cd5e5ade6139b67b6c1d925c7acda73dd4028189e0d7f1ea64df7209a","nasal":"06c7501bcf76c0d8bd36e09d1c4a3fdb8dc3efed24dff4cbb7f765b6529822c9"}},{"id":"VRCE-3-18-3","kanda":3,"kandaId":"aranya","sarga":18,"verse":3,"english":"Who among the gods, Gandharvas or creatures or the light souled saints is of such mighty energy as to have deformed you?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-19-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3018003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d6097239ae56037b5234133759e4036a799441f5d0d49b25b3d86f24f8e06f2","compact":"08058178e458fb15a97f27781f