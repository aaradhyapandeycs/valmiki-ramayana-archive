65006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"136052b7f86c696457fba4aaca0443459fda9865a630020fe4a9f0e3815d3cdd","compact":"634433c798d1c40b29c47f16d5e91089e74b5f838140cb89ed5ab825e3392817","nasal":"634433c798d1c40b29c47f16d5e91089e74b5f838140cb89ed5ab825e3392817"}},{"id":"VRCE-3-65-7","kanda":3,"kandaId":"aranya","sarga":65,"verse":7,"english":"Waiting for sometime here and there they, exercised with Sītā's ravishment, explored the entire forest in quest of Vaidehi.","alignment":{"type":"1:1","confidence":0.597,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-69-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3065007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"adcf85f696dbe0f109656304c72412d61afca1c4e73ee9650c8998d6402d4fb1","compact":"ff106aca9666933ba585a7fb648e5170d1bf7dc6d5cc092dd650fb895578399e","nasal":"f392642427d2d8c689adabf583786446131204ed51462adc319b495c5531a518"}},{"id":"VRCE-3-65-8","kanda":3,"kandaId":"aranya","sarga":65,"verse":8,"english":"There upon the highly effulgent and truthful Laksmana, possessing a pure character, spoke, with folded hands, to his brother of flaming energy.","alignment":{"type":"1:1","confidence":0.737,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-69-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3065008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"741303832f8e96fc9ef419f825bb564fc4a48aca130aae43641bed78ce19b43b","compact":"ff53f87a15c361fa79752d330e66339aa43380004bf8ffea5f79576ac1c35686","nasal":"19826d59b015abcd0dc52098ea9df50ab033aeb93cc45f3f35fede31e46eb57e"}},{"id":"VRCE-3-65-9","kanda":3,"kandaId":"aranya","sarga":65,"verse":9,"english":"My left arm is throbbing, my mind is filled with anxiety and I perceive before me many a bad omen. Do you put on your habiliments, O worshipful one, and act by what I say for your well-being. Methinks from these bad omens some calamity shall soon befall us.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-69-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3065009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e7acdf64ecbf06f1ad5ffc141fb1dc9bb7fde9dbdcdcb2c8fbf1211776d2e4a","compact":"20cea3b82d7886a6f755309f5ffc4ac8c005ef5c107834f61d0790341ec42158","nasal":"193f8afd92b91e0435263544505be75fa11135b8b20ca4c326c913471677b316"}},{"id":"VRCE-3-65-10","kanda":3,"kandaId":"aranya","sarga":65,"verse":10,"english":"My left arm is throbbing, my mind is filled with anxiety and I perceive before me many a bad omen. Do you put on your habiliments, O worshipful one, and act by what I say for your well-being. Methinks from these bad omens some calamity shall soon befall us.","alignment":{"type":"grouped","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-69-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3065010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8dc46147355d81984bfb7f620bf5b4a750051295fe3b1535f0440dca719b56a6","compact":"7d77f9cc8f42cc8411dce7d1a07188a1479777b13b8d49fc12dc47570f43f93d","nasal":"a28eb525f43a1f7bdd328676b6f32d33d400e7d2db116ab9f59e4dd278484f72"}},{"id":"VRCE-3-65-11","kanda":3,"kandaId":"aranya","sarga":65,"verse":11,"english":"O Rāma, this terrible bird Vanjulaka is emitting fearful cries as if announcing our victory in the conflict.","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-69-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3065011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d8368819dcbb59e89de018e9ec3dd7fc6bd7db7ddec5e02cd306908414f8cbec","compact":"c18a797ee114c317ab5dfaca553b136cf98fea143143b48074eb8fc6f2aff5c4","na