krit-ngram","duttRefs":["DUTT-3-71-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3067015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"11fa4fe21f917b8d0dfe7f6da083c1e137edd2caba6b947fd5aba1b3e4d1ba2a","compact":"6ea9aee6bf71ff53b866e612c44aef35cccd9f9c2f984fae5efb617e28271d76","nasal":"a6823f125af5c6f9b23bcd78de45d147f1ebb96506ce4ec093dd27105ae79b8c"}},{"id":"VRCE-3-67-16","kanda":3,"kandaId":"aranya","sarga":67,"verse":16,"english":"Acting under the conviction that Rāma, resolved to destroy my person, shall surely come within the compass of my arms, I do always assail with relish, O worshipful one, O you best of kings, every animal I meet with in this forest. You are that Rāma. My good betide you, O Rāghva. Verily did the great ascetic speak to me that none should be able to assail me but Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-71-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3067016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1622bf363925269a773b6397ee2bd59820e436581000d14a4879bb1a16f5399d","compact":"5911b6826cd2067015e4a76d89e06f4455c92d833ac130a230793b540cea3277","nasal":"b80bde9c7001eab990c9351cdbf8da371e24ea40b053e507b1709bd6c9224b05"}},{"id":"VRCE-3-67-17","kanda":3,"kandaId":"aranya","sarga":67,"verse":17,"english":"Being cremated by you, I shall counsel you best and tell you with whom you should contract friendship.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-71-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3067017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"597bccbe24c5c00c909ec79c2d7c332cee36b14534758527a9af59d1d16dd15c","compact":"8bf8882feef6a9564cfbd4fc2796a797d3fadc05280990a2105b1d42ed27f8c6","nasal":"8bf8882feef6a9564cfbd4fc2796a797d3fadc05280990a2105b1d42ed27f8c6"}},{"id":"VRCE-3-67-18","kanda":3,"kandaId":"aranya","sarga":67,"verse":18,"english":"Being thus addressed by Danu, the virtuoussouled Rāghva spoke before listening Lakşmaņa.","alignment":{"type":"1:1","confidence":0.839,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-71-13"],"status":"unreviewed"},"source":{"sanskritLocator":"3067018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"516101dd96de53a83ba2f4927073f5c4670ea4f55613e4c52b9d2ab1db213c7f","compact":"e55aa18f76adf932aef9e215eedf1aaf6452ec71c294d4f6b82ed272800114eb","nasal":"e55aa18f76adf932aef9e215eedf1aaf6452ec71c294d4f6b82ed272800114eb"}},{"id":"VRCE-3-67-19","kanda":3,"kandaId":"aranya","sarga":67,"verse":19,"english":"My renowned spouse Sītā was easily ravished by Rāvaņa after I had gone out of Janasthana along with my brother. I know that Raksasa's name only—but do not know his whereabouts, his figure and his prowess.","alignment":{"type":"grouped","confidence":0.708,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-71-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3067019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"49eee45d6f023e3f1473b19bad14931c58645b98f1ffa1c91ed201f2b9d43550","compact":"b84a2b13f0dbd9b6c4ea004778c6b13e0733a2f83ff5155f583cd9765c02f341","nasal":"b853ca73034252b614588047363c98b93f9ec00a03b24e4556aabeba8ab43c0d"}},{"id":"VRCE-3-67-20","kanda":3,"kandaId":"aranya","sarga":67,"verse":20,"english":"My renowned spouse Sītā was easily ravished by Rāvaņa after I had gone out of Janasthana along with my brother. I know that Raksasa's name only—but do not know his whereabouts, his figure and his prowess. It behove you to show proper compassion for us, who have been stricken with grief, who are helpless, have been ranging this forest in this way and are, ever engaged in the well-being of others*. This sloka may be rendered in another way:Do you continue benefiting us by showing proper compassion for us, who are stricken with grief helpless and ranging the forest in this way. We have however adopted here the commentator Rāmāņaya's explanation.","alignment":{"type":"split","confidence":0.439,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-71-14","DUTT-3-71-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3067020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0617a4524f87ad34ca36bf50f659d172919a9d2520f0c53a345785eb8561e2d8","compact":"9676b0c9888a8aaaf1e8b248f24c0dbb60b3363d992eeea33ea6940515b326eb","nasal":"9676b0c9888a8aaaf1e8b248f24c0dbb60b3363d992eeea33ea6940515b326eb"}},{"id":"VRCE-3-67-21","kanda":3,"kandaId":"aranya","sarga":67,"verse":21,"english":"It behove you to show proper compassion for us, who have been stricken with grief, who are helpless, have been ranging this forest in this way and are, ever engaged in the well-being of others*. This sloka may be rendered in another way:Do you continue benefiting us by showing proper compassion for us, who are stricken with grief helpless and ranging the forest in this way. We have however adopted here the commentator Rāmāņaya's explanation.","alignment":{"type":"grouped","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-71-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3067021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"135e7137f203f039f25367c7e5d44c33f6aad1be89aa8869ddd8b0b25b4c8442","compact":"abd501241fcf018ff37c2caeb64fbf8ad4c8fdd8d5f5408e0943f0af41e77e74","nasal":"abd501241fcf018ff37c2caeb64fbf8ad4c8fdd8d5f5408e0943f0af41e77e74"}},{"id":"VRCE-3-67-22","kanda":3,"kandaId":"aranya","sarga":67,"verse":22,"english":"O, hero, we shall burn you after collecting all the branches that have been broken down by the elephants and dried up in time, and digging a big trench.","alignment":{"type":"1:1","confi