[{"id":"VRCE-3-15-1","kanda":3,"kandaId":"aranya","sarga":15,"verse":1,"english":"As the high-souled Rāghava was dwelling there peacefully, after autumn had departed, the welcome winter commenced.","alignment":{"type":"1:1","confidence":0.983,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-16-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3015001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cfcdf0bf2cb8792f7400b7a1359b04edcd30888cd7c1e3cfbae7c7e52d897c1c","compact":"cffc7759e4794b909e8c2ac4a410911e394edb33fa1d9e3eb7ac82c478aef9a6","nasal":"f511662fff1a248bba3b3c19096d32860ad4a525748602b9937dec8d2f97ac1d"}},{"id":"VRCE-3-15-2","kanda":3,"kandaId":"aranya","sarga":15,"verse":2,"english":"And it came to pass that once on a time, when the night had passed away and day broke, that son of Raghu went to the romantic river Godāvarī for performing his bath.","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-16-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3015002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"826910d664edf0daf1539a7d131a3265286c0eb074366bf07c8767bdcce4455a","compact":"ff2b25d47038303734ebd73042912d87fe4a4299afa07e2d83941348a1c925ef","nasal":"22aa644d4e8d45206b888b19ce2d16cca783ac06e351f8e076ee114c2cb4dc9d"}},{"id":"VRCE-3-15-3","kanda":3,"kandaId":"aranya","sarga":15,"verse":3,"english":"And as the humble son of Sumitrā Rāma's puissant brother bearing a water pitcher in his hand was following Rāma along with Sītā at his back, the former said to Rāma,","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-16-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3015003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3a1e052e56e25902967778936559b8dc9c9d7e46514da4f5eba6680b7b71c604","c