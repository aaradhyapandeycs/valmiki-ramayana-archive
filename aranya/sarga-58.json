d4b0bae51103e62f689013c3aaeaf"}},{"id":"VRCE-3-58-14","kanda":3,"kandaId":"aranya","sarga":58,"verse":14,"english":"Or, O Aryunā, she was very fond of you, tell me if live that daughter of Janaka of slender frame.","alignment":{"type":"1:1","confidence":0.787,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-60-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3058014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4bfa4f32bba0804ac60eaf1a7b2c3fb879d247489309c57eafbcafd8d81107f8","compact":"c46c34c59c4b24478487d44a000e517a17c4c6e32cd0829f90b60eace7e662ad","nasal":"c46c34c59c4b24478487d44a000e517a17c4c6e32cd0829f90b60eace7e662ad"}},{"id":"VRCE-3-58-15","kanda":3,"kandaId":"aranya","sarga":58,"verse":15,"english":"This Kakubha know for certain about Maithilī having thighs like to Kakubha. You stands beautifully that Vanaspati being enveloped with creepers flowers and leaves and filled with the hum of Bhramaras. Surely dose this Tilaka know about her who was fond of her.","alignment":{"type":"grouped","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-60-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3058015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"572a9276d7f76128a00114aca4987d4ee792effa29db2713482dde6f80b9e8f5","compact":"d28b1c01930cb84996d2ac9c5908271db613c1918d85692a9479d020eaa8fb1c","nasal":"d28b1c01930cb84996d2ac9c5908271db613c1918d85692a9479d020eaa8fb1c"}},{"id":"VRCE-3-58-16","kanda":3,"kandaId":"aranya","sarga":58,"verse":16,"english":"This Kakubha know for certain about Maithilī having thighs like to Kakubha. You stands beautifully that Vanaspati being enveloped with creepers flowers and leaves and filled with the hum of Bhramaras. Surely dose this Tilaka know about her who was fond of her.","alignment":{"type":"grouped","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-60-11"],"status":