[{"id":"VRCE-3-9-1","kanda":3,"kandaId":"aranya","sarga":9,"verse":1,"english":"Hearing Vaidehi's words spoken through high regard (for her husband), Rāma with his energy enhanced, answered Janaka's daughter.","alignment":{"type":"1:1","confidence":0.893,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-10-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3009001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d58d677377d688c17701e5ef3da383ec48860529f9fb67dffe197168f67bb145","compact":"a90d9fae89fe9f85e7fecb7ec38dc8483e91dd3b2d07e8e8fdcbce0733153aaf","nasal":"a90d9fae89fe9f85e7fecb7ec38dc8483e91dd3b2d07e8e8fdcbce0733153aaf"}},{"id":"VRCE-3-9-2","kanda":3,"kandaId":"aranya","sarga":9,"verse":2,"english":"O noble lady, you have spoken wild words fraught with worth and profit; and, O Janaka's daughter versed in virtue, you have expounded the duties of Kșatriyas.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-10-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3009002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9eca86bb28c1da1d1a64b781b2b8fdd32a9927c1ec332748d479ae22b098463","compact":"fcad1069eaaa97dd9c71e81b67d910fe303d922bda90967771af918544355cf1","nasal":"d0ef6ea3bd6438c66e236f1af6e930b0542e62c070e6c49269bbed35473aa510"}},{"id":"VRCE-3-9-3","kanda":3,"kandaId":"aranya","sarga":9,"verse":3,"english":"What, O exalted one, shall I say? You have yourself by your words (furnished an answer to what you had said). Kşatriyas wear bows in order that the word 'distressed' may not exist (on earth).","alignment":{"type":"1:1","confidence":0.943,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-10-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3009003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"64a261cf44508aceade7a9ae63554cc5b657e136f05