[{"id":"VRCE-3-57-1","kanda":3,"kandaId":"aranya","sarga":57,"verse":1,"english":"Then coming out of the hermitage, Raghu's descendant, Rāma, after a while, from grief, spoke these words to the son of Sumitrā,","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3057001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ecd3c61ac3e0e96f6ae80e6635704d2861c0d58c39d44e02b6dfb4dbee035c27","compact":"e040c2001cdf453a4a5e41437385ad3bb578444230c14c7f056ca708d99bfcee","nasal":"ad37f755e06f9bb1db28fd717341e31eedc615cc6a0861cdf773eb18e4367293"}},{"id":"VRCE-3-57-2","kanda":3,"kandaId":"aranya","sarga":57,"verse":2,"english":"When confiding myself in you, I had left Maithilī with you in the wood, why then did you go out, leaving her behind?","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3057002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c72cf479eb8f61fc58f22ce1a2d8add66ba10e5e87e3018a94c1234c2b431c24","compact":"a64598c5a58a95b734bbe38b2479668781275f86881f8f90fca443dd8e3b9657","nasal":"a64598c5a58a95b734bbe38b2479668781275f86881f8f90fca443dd8e3b9657"}},{"id":"VRCE-3-57-3","kanda":3,"kandaId":"aranya","sarga":57,"verse":3,"english":"O Laksmana, directly I saw you approach, renouncing Maithilī, my mind, apprehending great wrong, became really aggrieved.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3057003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8468ea5249070dcfb1f1c69104ab8fbb0de7420b74150c2132fd102b0d8ca30","compact":"716d4b80b5afda8f6dd228ffc2c938b21ef1103d32426a0ccc67c5042f946f23","nasal":"ea7b92acbb26f63ebc0db81f1aa907b30eec4e992fe1d87e0933f5a76fb43001"}},{"id":"VRCE-3-57-4","kanda":3,"kandaId":"aranya","sarga":57,"verse":4,"english":"O Lakşmaņa, seeing you coming at a distance, renouncing her, my left eye and arm as well as my heart keep throbbing.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-4"],"status":"unreviewed"},"source":{"sanskritLocator":"3057004","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cc1d08276ca1c5e311bcc290c2609f6eb55d538a16982b9b0dbe084dd7d1ad3a","compact":"d27edb485d5dd88cc35a93331fd5d15449a3fdc4c930bc3b96312d7d8fa606e2","nasal":"d27edb485d5dd88cc35a93331fd5d15449a3fdc4c930bc3b96312d7d8fa606e2"}},{"id":"VRCE-3-57-5","kanda":3,"kandaId":"aranya","sarga":57,"verse":5,"english":"Thus accosted, Laksmana having auspicious signs, afflicted with great grief, said to the aggrieved Rāma,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-5"],"status":"unreviewed"},"source":{"sanskritLocator":"3057005","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"723cc828ddba08422e3e136c1d38212d85da223ce401e9d7078f21198ecf6f15","compact":"193b8af675721883ebe774e8539ddc4b9156035c4e1c5d3663c9ba190d51ad30","nasal":"193b8af675721883ebe774e8539ddc4b9156035c4e1c5d3663c9ba190d51ad30"}},{"id":"VRCE-3-57-6","kanda":3,"kandaId":"aranya","sarga":57,"verse":6,"english":"I have not come hither, of my own accord, renouncing Sītā; but I have come to you, having been urged thereto by herself with rudeness.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-6"],"status":"unreviewed"},"source":{"sanskritLocator":"3057006","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ae29bb4d8a6bd25a7652fff1d3a24a9120ca296e1d77d9fed5d37d8d89d03c7e","compact":"d11fd2998baa0204321381575548daf6a3c8506ac51f8e1ce43fc85448d58013","nasal":"d11fd2998baa0204321381575548daf6a3c8506ac51f8e1ce43fc85448d58013"}},{"id":"VRCE-3-57-7","kanda":3,"kandaId":"aranya","sarga":57,"verse":7,"english":"The cries of O Laksimana, save me, as if uttered by the master, came to the ears of Maithili.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-7"],"status":"unreviewed"},"source":{"sanskritLocator":"3057007","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83f33ce09fc909204a78675a959570d4dbaa7f3c307d68bb9b78f0c5573e0bed","compact":"d460fd83ff8f46258257a8bb63eca56503c648c92d72e46892accbbc8e195c88","nasal":"d460fd83ff8f46258257a8bb63eca56503c648c92d72e46892accbbc8e195c88"}},{"id":"VRCE-3-57-8","kanda":3,"kandaId":"aranya","sarga":57,"verse":8,"english":"Hearing those distressful accents, Maithili from affection [for you], breaking out into lamentations, and overwhelmed with fear, spoke to me, Off, off.","alignment":{"type":"1:1","confidence":0.721,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-8"],"status":"unreviewed"},"source":{"sanskritLocator":"3057008","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80fef57da8c3275713f242cae71897ab82f420a9d1242a831c1b5c0c1e141ba8","compact":"5c75d67d230be1a114db143a03922dbd092fffbf5ef58521516aacfa46fa8cd8","nasal":"3e7a7552e3f27f74cbf12f1362cdae4ce3a907849e32856139bbfd8a743c42c6"}},{"id":"VRCE-3-57-9","kanda":3,"kandaId":"aranya","sarga":57,"verse":9,"english":"On being repeatedly urged, with Go, answered Maithili in these words, tending to inspire her confidence.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-9"],"status":"unreviewed"},"source":{"sanskritLocator":"3057009","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d7ac476be1c6d5dad966d2aa8dffed256c7f03625c79f53a7ed15d7bd638825","compact":"8113e6cef44741461896a799356ec4285ba07a0c001195ad5138558b5299f637","nasal":"8113e6cef44741461896a799356ec4285ba07a0c001195ad5138558b5299f637"}},{"id":"VRCE-3-57-10","kanda":3,"kandaId":"aranya","sarga":57,"verse":10,"english":"I do not see such a Rākṣasa, as can excite his fear. Do you desist. These cries do not come from him; but must have been uttered by someone else.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-10"],"status":"unreviewed"},"source":{"sanskritLocator":"3057010","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83e06afb64f9861c9f9bd2167d998552de6e04ab937c7ac303272316bd4f7315","compact":"fab257b7b20f4114d6a292951a74a9502da6e8f7533de043dfe57ea37909f28e","nasal":"fab257b7b20f4114d6a292951a74a9502da6e8f7533de043dfe57ea37909f28e"}},{"id":"VRCE-3-57-11","kanda":3,"kandaId":"aranya","sarga":57,"verse":11,"english":"How can he that can rescue the celestials themselves, utter, O Sītā, such a blame-worthy and base word as-save me?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-11"],"status":"unreviewed"},"source":{"sanskritLocator":"3057011","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"99db703ece6ce561767e3d39fa9c491362e3fb30f44fb5e0140ae74a2296937c","compact":"aed5efdfb9e22c74d48935823712931bdd4a069b88801121bbc34edd6adcdee8","nasal":"aed5efdfb9e22c74d48935823712931bdd4a069b88801121bbc34edd6adcdee8"}},{"id":"VRCE-3-57-12","kanda":3,"kandaId":"aranya","sarga":57,"verse":12,"english":"Some one for some purpose, assuming my brother's voice, is crying-O Laksmana, save me.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-12"],"status":"unreviewed"},"source":{"sanskritLocator":"3057012","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ddaae8fc9fd1f71b986d22601943ccfe954725ff4279e6c144b02d47634c9bc8","compact":"5461be6e1f2b9ed69689579280e4e02c9b7279e403f1471e381ea8490be52402","nasal":"6870a0d40675cf16060a6079157488c2a28cd93a84b40b06fba025f291978ec9"}},{"id":"VRCE-3-57-13","kanda":3,"kandaId":"aranya","sarga":57,"verse":13,"english":"Do not be over-whelmed; and banish your anxiety. There breathes no person, nor yet shall there be born any one in these three worlds who in the field shall vanquish Rāghava in fight. Rāghava is incapable of being beaten in battle by the very gods headed by Indra.'","alignment":{"type":"1:1","confidence":0.804,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3057013","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d267b17e1dc09f803c5854aebaefce2ecc3d1d1e9fa589a4c9d41894e5bdfa9","compact":"81f583968182f295f9dec80212f96dac4bde50cdcc7c22eefa9ecf15489803a0","nasal":"6aeae7f4b51977aa0d7a7dc95b12b3a2d2c25be35e36332b78b7d24f89f62c95"}},{"id":"VRCE-3-57-14","kanda":3,"kandaId":"aranya","sarga":57,"verse":14,"english":"Thus addressed (by me) Vaidehi, deprived of her sense, shedding tears, spoke to me these cruel words,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3057014","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"465fcbc2decc41b71c370f6edbc8e902536de26137b5e4aea9396c9a88f6420a","compact":"4f6f50bf058838ab854c0406285564c6a9eb79e5b1675edf6bb2ee7f54df6d04","nasal":"1130811ebb12f8203665cd6cb5e6d951f4cdaf57f191b0008d262657702a8adf"}},{"id":"VRCE-3-57-15","kanda":3,"kandaId":"aranya","sarga":57,"verse":15,"english":"You cherish the vile idea that on your brother perishing, you shall come by me; but me you shall never have.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3057015","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a076043aeac8088719370e30a3207acb007d4218c61ef70a43b9bca7bbe56ab9","compact":"800fbfd55ec82603e591319077bec4a14a16df07635cccd4f5fc13f4d603ec95","nasal":"800fbfd55ec82603e591319077bec4a14a16df07635cccd4f5fc13f4d603ec95"}},{"id":"VRCE-3-57-16","kanda":3,"kandaId":"aranya","sarga":57,"verse":16,"english":"As you do not go to him albeit he is crying loudly (for help), you follow Rāma in consonance with a hint from Bharata.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3057016","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0a1d6f7e388ff33fdf502de3699989f27525c01a67bd213219d8fc5a55372950","compact":"b35106f44efa645274db9417349331f4a2aa2c8145733a96332f960d3e561981","nasal":"51d0f15cf806757383ca9b75d4f142398d3414c3ff43b9207dc59afa6651ef99"}},{"id":"VRCE-3-57-17","kanda":3,"kandaId":"aranya","sarga":57,"verse":17,"english":"A foe going about in disguise, you follow Rāma for my sake, prying into Rāghava's draw backs; and it is for this that you do not go (to him)?","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3057017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c532bdde81a0e4f6c31b89ad3c86c209fd4d25752955b76034139b275f2d24fb","compact":"b6ce22dce550715f92907be38b62b854f073a4241670c7704c2df974d91e6e0a","nasal":"36c073fcbcd3078dc1262f63d9328ca6a49c0dc0a03a7602d98b902c3b2d6594"}},{"id":"VRCE-3-57-18","kanda":3,"kandaId":"aranya","sarga":57,"verse":18,"english":"Thus accosted by Vaidehi, I, with eyes reddened in wrath, and my nether lip swollen in ire, rushed out of the asylum.","alignment":{"type":"1:1","confidence":0.727,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3057018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"96dce205eb864ad10ffc256aef567acbb537977693fa8a03bc02ea063c803e95","compact":"b8ec6a82d0421e6630c608fe0238ec91090588aaa2412026a6cb3064d8fccc41","nasal":"b8ec6a82d0421e6630c608fe0238ec91090588aaa2412026a6cb3064d8fccc41"}},{"id":"VRCE-3-57-19","kanda":3,"kandaId":"aranya","sarga":57,"verse":19,"english":"When Saumitri had spoken thus, Rāma transported by grief; said to Laksmana, O gentle one, you have done wrong in having come out hither without her.","alignment":{"type":"1:1","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-20"],"status":"unreviewed"},"source":{"sanskritLocator":"3057019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6fb4128afd568bee9dc71723ff80fc5291b564fd89e43da7efa3a413184c5e31","compact":"f5581637383b88fb12d670cd1e34b4cb5e82e0e58631d92059b6eeb1d1c0975b","nasal":"f5581637383b88fb12d670cd1e34b4cb5e82e0e58631d92059b6eeb1d1c0975b"}},{"id":"VRCE-3-57-20","kanda":3,"kandaId":"aranya","sarga":57,"verse":20,"english":"Although you knew (full well) that I was able to withstand the Rākşasas, yet did you sally out at the angry words of Mithila's daughter.","alignment":{"type":"1:1","confidence":0.645,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3057020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2f69a2f93b866d373fd2622b03a3709b3bf0b72f5a15da85010f479655767dbd","compact":"8777a59603d52af688aae5802be1d44947e98fd00ba8769da11c128236b25162","nasal":"2bdd983d0df12a155eaaeb79f9307678791ae8a56eb74a2519ef30618ce11e5f"}},{"id":"VRCE-3-57-21","kanda":3,"kandaId":"aranya","sarga":57,"verse":21,"english":"I am not pleased with you that hearing her harsh speech spoken in wrath, you have come hither, leaving Vaidehi behind.","alignment":{"type":"1:1","confidence":0.872,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3057021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d4495624860abc01fa461c14e288d53d29f22a8d3a2613b20455b9f0b3a10d72","compact":"f8dec58250cee8a3fd038f330b3a43b82ef1592ee20da5a5a9bcd48ef79ef804","nasal":"f8dec58250cee8a3fd038f330b3a43b82ef1592ee20da5a5a9bcd48ef79ef804"}},{"id":"VRCE-3-57-22","kanda":3,"kandaId":"aranya","sarga":57,"verse":22,"english":"You have every way done wrong in not acting out my mandate in consequence of being urged by Sītā, and under the influence of indignation.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3057022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2c850722c983d77dbc6ce90772883b5e34ed02684ec98322d9a53fab67ae5c3a","compact":"033edc02dfe0c574dbb3769b2a1e6a8eefa8be4e7630f030e17ae27798bfa224","nasal":"033edc02dfe0c574dbb3769b2a1e6a8eefa8be4e7630f030e17ae27798bfa224"}},{"id":"VRCE-3-57-23","kanda":3,"kandaId":"aranya","sarga":57,"verse":23,"english":"That Rākṣasa lie low, being wounded by my shafts—that had drawn me away from the asylum wearing the form of a deer.","alignment":{"type":"1:1","confidence":0.92,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3057023","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72772582122d0b25e3ffc8953a17c355ed5c28486cc78a504192ce471a05a1f2","compact":"4db7fdec591cab292bb47365106df600790a2efc3d1604ce8f11bd5bb19054f3","nasal":"4db7fdec591cab292bb47365106df600790a2efc3d1604ce8f11bd5bb19054f3"}},{"id":"VRCE-3-57-24","kanda":3,"kandaId":"aranya","sarga":57,"verse":24,"english":"I hit him stretching my brow slightly and fixing the shaft on it; when, renouncing his deerform he became a Rākṣasa wearing a bracelet and began to emit distressful shrieks.","alignment":{"type":"1:1","confidence":0.904,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-25"],"status":"unreviewed"},"source":{"sanskritLocator":"3057024","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c0c42c0aa66433e7e5d20da89864a71c3c41fac82061a260f3e6dde8bcc33aa6","compact":"a1413d176954a07aa109f00fa2510897879bdc2ac377301fc54bc47753407515","nasal":"a1413d176954a07aa109f00fa2510897879bdc2ac377301fc54bc47753407515"}},{"id":"VRCE-3-57-25","kanda":3,"kandaId":"aranya","sarga":57,"verse":25,"english":"Wounded by my shaft, he, assuming my voice, and in accents capable of being heard from far, uttered those dreadful words fraught with dole, hearing which, you have come hither, renouncing Mithilā's daughter.","alignment":{"type":"1:1","confidence":0.713,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-59-26"],"status":"unreviewed"},"source":{"sanskritLocator":"3057025","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"037af8a29c3a1878b01638973d7acbc07d4357fdd7327150a26dc00fbe449d75","compact":"b4a0d15cbb1d3b5303b299afbf5c667fc760c318bbc0a70b52754f63447bff59","nasal":"ac7b27ac8804a42775e97268c6315a72129d864275fed582fed8b9be5c6e8b73"}}]
