2afd9a4eb5a0d9840ec982256f8","compact":"3ef162ba451f080f71e45e9ed85dcecaced01b57251beafd6b9c6e45d8445354","nasal":"1ec91c6a03ce55f380c38f866074714463c59908eed068ea9d7fe44d8999b97f"}},{"id":"VRCE-3-53-27","kanda":3,"kandaId":"aranya","sarga":53,"verse":27,"english":"Laving your limbs with water, do you gratify me. The evil that you had done, has been expiated by your life in the forest: now do you reap the fruit of your good deeds.","alignment":{"type":"1:1","confidence":0.633,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-21"],"status":"unreviewed"},"source":{"sanskritLocator":"3053027","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"826bd868d1adfcbc6ae853c3298bbe4126c25c344c3dc312cc755c0642d3cad9","compact":"9cc7a9c4fa467a1e8a3177539f05ad20aa7b49ed37598b458980a481146a8ce6","nasal":"9cc7a9c4fa467a1e8a3177539f05ad20aa7b49ed37598b458980a481146a8ce6"}},{"id":"VRCE-3-53-28","kanda":3,"kandaId":"aranya","sarga":53,"verse":28,"english":"Here are garlands furnished with divine fragrance, and, O Maithili, superb ornaments. Enjoy you all those along with me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-22"],"status":"unreviewed"},"source":{"sanskritLocator":"3053028","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5b3dc2e9bc26aa8f1ec26463ae6f1fd8f876b6b86111ede4442c766bc3a9e94e","compact":"0d85ab781fde2b7f5f172cfe87e327ebfb60395b121bc2dfada822df90eff518","nasal":"3909a0bfb9f035f836c5b17632c33fa525aa99f3a55aebcc8c1d6dea6b771b17"}},{"id":"VRCE-3-53-29","kanda":3,"kandaId":"aranya","sarga":53,"verse":29,"english":"O you of shapely hips, the car called Pușpaka, resembling the sun, which (formerly) belonged to my brother Vaiśravaņa, was through my prowess won by me in fight. And vast and beautiful is that car furnished with the speed of the mind. Do you, O Sītā, at your pleasure sport on it along with me.","alignment":{"type":"grouped","confidence":0.9,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-23"],"status":"unreviewed"},"source":{"sanskritLocator":"3053029","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f77f86febedc2ebff5ccf904c1e3a7ecbd598736d726cc46efba34d1bff5c03d","compact":"f08ecd8413fd61c22b4542f146245c0384f227e7d46ade6e0d9167c820a8f0db","nasal":"f08ecd8413fd61c22b4542f146245c0384f227e7d46ade6e0d9167c820a8f0db"}},{"id":"VRCE-3-53-30","kanda":3,"kandaId":"aranya","sarga":53,"verse":30,"english":"O you of shapely hips, the car called Pușpaka, resembling the sun, which (formerly) belonged to my brother Vaiśravaņa, was through my prowess won by me in fight. And vast and beautiful is that car furnished with the speed of the mind. Do you, O Sītā, at your pleasure sport on it along with me. Your face stainless and lovely to look at, resembling the lotus, dose not, O you of a comely countenance, O magnificent damsel, appear beautiful in consequence of your being exercised with grief.","alignment":{"type":"split","confidence":0.455,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-23","DUTT-3-55-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3053030","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"13e2e47d6a5b326dad8d0aef16469704cdd672607cf1ae4dc892c396afd56f84","compact":"e89df59120808b10771775a26b0315bfcc6c570bf3f4525585b5edfada29a689","nasal":"e89df59120808b10771775a26b0315bfcc6c570bf3f4525585b5edfada29a689"}},{"id":"VRCE-3-53-31","kanda":3,"kandaId":"aranya","sarga":53,"verse":31,"english":"Your face stainless and lovely to look at, resembling the lotus, dose not, O you of a comely countenance, O magnificent damsel, appear beautiful in consequence of your being exercised with grief.","alignment":{"type":"grouped","confidence":0.444,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-24"],"status":"unreviewed"},"source":{"sanskritLocator":"3053031","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ded6e04ebb33ce59ccbbbab2ae79f97272c62cb9d441a254e9bc793116e8c15e","compact":"3de56628d2a01c865e5fd05e02681b307cfeda0bf6f70d5784cdce570aa260f2","nasal":"3de56628d2a01c865e5fd05e02681b307cfeda0bf6f70d5784cdce570aa260f2"}},{"id":"VRCE-3-53-32","kanda":3,"kandaId":"aranya","sarga":53,"verse":32,"english":"These tender feet of yours I press upon my heads. Do you speedily show your favour to me. I am your slave (ever) obedient to you.","alignment":{"type":"grouped","confidence":0.422,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-28"],"status":"unreviewed"},"source":{"sanskritLocator":"3053032","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"515d0b4b41d1df8cde5627056db3506df16d44ed3788067caa0f868e3881d8d7","compact":"ced8778dbf367ae44a1d6479b14e1ba45ead7ca1df3fba14cd75045a4643dfd9","nasal":"a401d18d61a26c95c49bc13ee6be17fc04eca6ab85744f7dfa825d9faba0c25b"}},{"id":"VRCE-3-53-33","kanda":3,"kandaId":"aranya","sarga":53,"verse":33,"english":"These tender feet of yours I press upon my heads. Do you speedily show your favour to me. I am your slave (ever) obedient to you. Let not these words of mine spoken by me under the withering influence of love prove fruitless. Rāvana has never bowed his head to any female. Having said this, the Ten-headed one, come under the subjection of the Destroyer, looked upon Maithili, Janaka's daughter (as his own) saying, She is mine.","alignment":{"type":"split","confidence":0.47,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-55-28","DUTT-3-55-29"],"status":"unreviewed"},"source":{"sanskritLocator":"3053033","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"401fc3da6db25dff3d579cb0842432a4e37fddaa94b5de3d2270ed929c37c2ca","compact":"a52e48c967603d3387f044f6c28084d07fc1202895c9f2d989ee23397b0e46e9","nasal":"a52e48c967603d33