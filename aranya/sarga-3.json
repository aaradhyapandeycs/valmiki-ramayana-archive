sanskrit_fingerprints":{"exact":"84ac3f97fb714df2b35f32dea101f60a4de049441dbb8aacaa010c17471b01bc","compact":"048ae012b11ced1c08675e29eb11a063be215a87fd0f64eb9f935ff8915b34d5","nasal":"5fc3fc407db9c3a6c9b211f65d73ea5b842c15979bcad59b7871aff9d188c5ab"}},{"id":"VRCE-3-3-17","kanda":3,"kandaId":"aranya","sarga":3,"verse":17,"english":"Now I know you that are Rāma, the worthy Son of Kausalyā, my child; as well as the highly virtuous Vaidehi and the renowned Lakşmaņa.","alignment":{"type":"1:1","confidence":0.951,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-14"],"status":"unreviewed"},"source":{"sanskritLocator":"3003017","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e376a17cde1156b49e8d03c8a774289089baf181bad054da2992bd40825ae1c8","compact":"3a2f586a751d094e3faf1ec690449c579244b963c866ec36b54de5c7bd87db3d","nasal":"3a2f586a751d094e3faf1ec690449c579244b963c866ec36b54de5c7bd87db3d"}},{"id":"VRCE-3-3-18","kanda":3,"kandaId":"aranya","sarga":3,"verse":18,"english":"By virtue of a curse, I entered this dreadful Räkşasi form, I a Gandharva, having been cursed by Vaisravaņa.","alignment":{"type":"1:1","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-15"],"status":"unreviewed"},"source":{"sanskritLocator":"3003018","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ec1d84faf4c6c8980755e522d40fb276b1ee76e69545fa41637123fe5770b991","compact":"deffb5c0a52fe3acfb98cbe0acbe6f41ef3565b2127d6e6c4cd15a4e3459b6aa","nasal":"adc426f092c79a19c591e8eb1bee9764d207fc3dde095cae21cd32fb2d49410a"}},{"id":"VRCE-3-3-19","kanda":3,"kandaId":"aranya","sarga":3,"verse":19,"english":"Being propitiated by me, that greatly famous one said, 'When Rāma the son of Dasaratha, shall slay you in encounter, you, attaining your natural condition, shall repair to the celestial regions.'","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-16"],"status":"unreviewed"},"source":{"sanskritLocator":"3003019","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7c2db647adc638dbd95dc934beb4cc843e4170b7ed08f55222e507e651d66864","compact":"1b84881a7e2686742e663264641e6e094ddd38c2b8811f81bb7ee9a487ed7c65","nasal":"1b84881a7e2686742e663264641e6e094ddd38c2b8811f81bb7ee9a487ed7c65"}},{"id":"VRCE-3-3-20","kanda":3,"kandaId":"aranya","sarga":3,"verse":20,"english":"Being propitiated by me, that greatly famous one said, 'When Rāma the son of Dasaratha, shall slay you in encounter, you, attaining your natural condition, shall repair to the celestial regions.' Getting wroth, he cursed me, who had been absent; and thus did king Vaiśravaņa address me, who had conceived love for Rambhā.","alignment":{"type":"split","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-16","DUTT-3-4-17"],"status":"unreviewed"},"source":{"sanskritLocator":"3003020","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8ce0041ddc20353fb687c3fb69b3c842afcc4031624a682cebff03c1163767a5","compact":"9ed69c44ac52db0421ba7a51a20435e93cc7c7524fab417d8ef4ec38a9004143","nasal":"dfedd22747613d61d161a48cbe3f329f1beda23090fa6278a638d37a6fbac361"}},{"id":"VRCE-3-3-21","kanda":3,"kandaId":"aranya","sarga":3,"verse":21,"english":"Through your grace have I been freed from this fearful curse, I shall (now) repair to heaven. Hail, O repressor of foes!","alignment":{"type":"1:1","confidence":0.586,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-18"],"status":"unreviewed"},"source":{"sanskritLocator":"3003021","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3749abfcfd347f773638236374f253fde5654055eaa5bfd1f3c60adbb5516766","compact":"194a986b4f4c3aba71ccd9c7e503d56d7d6f3e26727dbb1c7a35652f6e0c46a3","nasal":"194a986b4f4c3aba71ccd9c7e503d56d7d6f3e26727dbb1c7a35652f6e0c46a3"}},{"id":"VRCE-3-3-22","kanda":3,"kandaId":"aranya","sarga":3,"verse":22,"english":"Half a Yojana hence, my child, dwells the righteous and potent Maharși, Śarabharga, resembling the Sun. Seek him speedily: he will bring about your good. Casting me (into this pit) in the wood, do you, O Rama, peacefully go your way. Even this is the eternal usage of the Raksasas.","alignment":{"type":"grouped","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3003022","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2cd2957696403cf93d93f773cec8831c99ee6379db0b7b3d5e36eba71d192c20","compact":"166725c041e66080694f2b929d43f6b35f17d2de48e8d1bab77e32af6e7bfd4c","nasal":"2ef79b16ab0bba9e5c37704feb6596e424ddd132aaae28a3605d276ba3ce6cc3"}},{"id":"VRCE-3-3-23","kanda":3,"kandaId":"aranya","sarga":3,"verse":23,"english":"Half a Yojana hence, my child, dwells the righteous and potent Maharși, Śarabharga, resembling the Sun. Seek him speedily: he will bring about your good. Casting me (into this pit) in the wood, do you, O Rama, peacefully go your way. Even this is the eternal usage of the Raksasas.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-4-19"],"status":"unreviewed"},"source":{"sanskritLocator":"3003023","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ff0b77ad55b31e23c9de2181552ed8401f1dfb5f53d44f56194a23b56fffce8f","compact":"13ec7a32772342b7295a002d081c7319fdccb12819adf253c864ada4aa445f7c","nasal":"13ec7a32772342b7295a002d081c7319fdccb12819adf253c864ada4aa445f7c"}},{"id":"VRCE-3-3-24","kanda":3,"kandaId":"aranya","sarga":3,"verse":24,"english":"Half a Yojana hence, my child, dwells the righteous and potent Maharși, Śarabharga, resembling the Sun. Seek him speedily: he will bring about your good. Casting me (into this pit) in the wood, do you, O Rama, peacefully