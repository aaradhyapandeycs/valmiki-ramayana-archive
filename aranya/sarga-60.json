[{"id":"VRCE-3-60-1","kanda":3,"kandaId":"aranya","sarga":60,"verse":1,"english":"Rāma stricken with grief spoke to Lakşmaņa the following piteous words saying, O Laks mana, do you speedily repair to the river Godaverſ and learn if Sītā has gone there to fetch lotuses.","alignment":{"type":"1:1","confidence":0.837,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-1"],"status":"unreviewed"},"source":{"sanskritLocator":"3060001","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d016edd198804651dfda0abe554393d12f705b109ba504d3838cf24ebca97a1","compact":"61d7e6834a44ea7212fb53c40ff975b7f8a90e918db269e73aa85351c44920a8","nasal":"61d7e6834a44ea7212fb53c40ff975b7f8a90e918db269e73aa85351c44920a8"}},{"id":"VRCE-3-60-2","kanda":3,"kandaId":"aranya","sarga":60,"verse":2,"english":"Being thus addressed by Rāma, the quickpaced Lakşmaņa went to the pleasant stream Godaveri.","alignment":{"type":"1:1","confidence":0.719,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-2"],"status":"unreviewed"},"source":{"sanskritLocator":"3060002","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b784cdf997b974716021f3429194f3033f70072963c5fe9443f27a11eec54e39","compact":"2856e1c32f1a6fa3972eb954aa5d8964a925e2848a531373dd920069373b1c7c","nasal":"2856e1c32f1a6fa3972eb954aa5d8964a925e2848a531373dd920069373b1c7c"}},{"id":"VRCE-3-60-3","kanda":3,"kandaId":"aranya","sarga":60,"verse":3,"english":"Reconnoitring full well the river containing many a watering-place Lakşmaņa spoke to Rāma saying, Searched have I all the watering-places but have found her nowhere-anon I cried aloud but she did not hear.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-3"],"status":"unreviewed"},"source":{"sanskritLocator":"3060003","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b6e564ed9bade3466265bc1ecbb3e