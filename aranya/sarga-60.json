"3060035","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bab7f28606297bfbacadf13f0e28dfda7e9fab859476edc91899f626a539c937","compact":"38430bed18dc5650fff8808be0df750560914419952331735fb93c8449b8c5df","nasal":"38430bed18dc5650fff8808be0df750560914419952331735fb93c8449b8c5df"}},{"id":"VRCE-3-60-36","kanda":3,"kandaId":"aranya","sarga":60,"verse":36,"english":"O Lakşmaņa, while virtue did not protect Janakī being devoured or taken away by stealth, what person else gifted with heavenly power, on this earth shall bring about my well-being?","alignment":{"type":"1:1","confidence":0.886,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-38"],"status":"unreviewed"},"source":{"sanskritLocator":"3060036","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a2e2275313d5582dbb24ae8a6ee73facfaf8fb88f65a845878b4b26f93e3bb72","compact":"387f11dd719837cf10316cf066dcb10d562d09e7719f7179b4dc25d4b95c74fd","nasal":"387f11dd719837cf10316cf066dcb10d562d09e7719f7179b4dc25d4b95c74fd"}},{"id":"VRCE-3-60-37","kanda":3,"kandaId":"aranya","sarga":60,"verse":37,"english":"For this it is that people through ignorance disregard the ever kind Almighty-the lord of creatures and the best of the celestials.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-39"],"status":"unreviewed"},"source":{"sanskritLocator":"3060037","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"18121b02fdc179e1daf295037b708574bce4fc77546dcd8d61f9eccbc7c91972","compact":"f84f54a0903a2271eba06e3bced8e11839ceb22718878564d9d139de05008246","nasal":"f84f54a0903a2271eba06e3bced8e11839ceb22718878564d9d139de05008246"}},{"id":"VRCE-3-60-38","kanda":3,"kandaId":"aranya","sarga":60,"verse":38,"english":"Truly shall the celestials regard me as one devoid of prowess, who am mild-tempered, kind, ever engaged in the welfare of the humanity, and have controlled all my senses.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-40"],"status":"unreviewed"},"source":{"sanskritLocator":"3060038","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6bd790f29adfda6b901555fd2b70392ddbc0a5aaec635e5dd701157c7f329194","compact":"9c67c7a406afda202d7f0e41cb022c1370bfb971a244cf8039bd6f824e8f977a","nasal":"c00d520e4f4116d468a168297c0ec8a228542bd0b61ff75ad2e3d134464a386c"}},{"id":"VRCE-3-60-39","kanda":3,"kandaId":"aranya","sarga":60,"verse":39,"english":"Observe, O Laksmana, obtaining me as the stay these accomplishments have been turned into so many blemishes. Truly shall my prowess manifest itself to-day overshadowing all my other accomplishments for the destruction of the Rākşasas and all created beings like to the rising of the Sun casting the Moon into shade on the day of dissolution.","alignment":{"type":"1:1","confidence":0.921,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-41"],"status":"unreviewed"},"source":{"sanskritLocator":"3060039","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"175ea4ad81d5de43d6267ecc0a3307c5f28c6320de9265aed5c9ac482842f935","compact":"6fd01628a3b52fb4594b0d913c01bd0c441f5da16a0868122f4c526981b23354","nasal":"6fd01628a3b52fb4594b0d913c01bd0c441f5da16a0868122f4c526981b23354"}},{"id":"VRCE-3-60-40","kanda":3,"kandaId":"aranya","sarga":60,"verse":40,"english":"None shall enjoy felicity, O Lakşmaņa,-Yaksas, Gandharvas, Pisacas, Raksasas, Kinnaras, or human beings.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-3-64-42"],"status":"unreviewed"},"source":{"sanskritLocator":"3060040","sanskritFile":"Ram03.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4782e0d554fa983b0460cf65544eacba7b32d1050dd1c843e2e8f5d0e5eade30","compact":"e42b6bcef587be3d50a6b17ab7f753d7f