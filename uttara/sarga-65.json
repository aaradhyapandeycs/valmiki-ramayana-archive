c326","compact":"5de2098118d8a04991e7173b16730d04d0819a1382fcbe00c9b6d21510afbe89","nasal":"5de2098118d8a04991e7173b16730d04d0819a1382fcbe00c9b6d21510afbe89"}},{"id":"VRCE-7-65-4","kanda":7,"kandaId":"uttara","sarga":65,"verse":4,"english":"Markandeya, Maudgalya, Vamadeva, Kashyapa, Katyayana, Javali, Gautama, and Nārada, these eight leading Brāhmaṇas having takes their seats, Rāma with folded hands, saluted them. And he showed due civilities towards his minister, citizens, Rșis and all others. There upon all the highly effulgent Rșis being accommodated with seats Råma narrated duly before them the account of the Brāhmaṇa and said. This Brāhmaṇa is waiting at the Palace-gate.","alignment":{"type":"grouped","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-74-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7065004","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5acca242c6b649054f19dc24afc312efa183fd0c17249368d1e6bd6252247f03","compact":"82a721d7aeb8ac022e3339cdf893c74c519011ee2e488466001a0fbd22a21127","nasal":"6d4741e21cc89393f8890c1b6c97377c29f8d928de2634a054855599d1cf25f7"}},{"id":"VRCE-7-65-5","kanda":7,"kandaId":"uttara","sarga":65,"verse":5,"english":"Markandeya, Maudgalya, Vamadeva, Kashyapa, Katyayana, Javali, Gautama, and Nārada, these eight leading Brāhmaṇas having takes their seats, Rāma with folded hands, saluted them. And he showed due civilities towards his minister, citizens, Rșis and all others. There upon all the highly effulgent Rșis being accommodated with seats Råma narrated duly before them the account of the Brāhmaṇa and said. This Brāhmaṇa is waiting at the Palace-gate.","alignment":{"type":"grouped","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-74-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7065005","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3dade246d001e5eb3addda4ad7f0