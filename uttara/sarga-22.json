[{"id":"VRCE-7-22-1","kanda":7,"kandaId":"uttara","sarga":22,"verse":1,"english":"Hearing his mighty-shouts, that lord Vaivasvata knew that his adversary had gained the day and that his own host had been destroyed.","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7022001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"041088c62b343e6d6f0fa41f322ffe4c7fad916cf84fd994462fbf0a1c71c560","compact":"0e6ebdeb04bfe6271e7e093c201ee42040e8f89cffe294da3960359e801557d7","nasal":"0e6ebdeb04bfe6271e7e093c201ee42040e8f89cffe294da3960359e801557d7"}},{"id":"VRCE-7-22-2","kanda":7,"kandaId":"uttara","sarga":22,"verse":2,"english":"Knowing that his forces had been slain, he, with his eyes crimsoned with passion hastily spoke to his charioteer, ‘Bring you my car.'","alignment":{"type":"1:1","confidence":0.359,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7022002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"caf221fe45bf0c7fa137621eda77ea75d56a19cf21185b660ac4764a0864538c","compact":"68704e2e292d4e6473d1b259d25d2e5a540066cea30a3bb23c4af767215a6766","nasal":"68704e2e292d4e6473d1b259d25d2e5a540066cea30a3bb23c4af767215a6766"}},{"id":"VRCE-7-22-3","kanda":7,"kandaId":"uttara","sarga":22,"verse":3,"english":"Thereat the charioteer brought the noble and mighty car and stood (there) and then that exceeding energetic one mounted the car.","alignment":{"type":"1:1","confidence":0.375,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7022003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c4c0ad91b392208d62eefc5ab15206191ca7a574e56b1c3bc2e1968f83caa933","compact":"4082e55dc79bc5400113c8b6b452b8488dd54ef868af