t_fingerprints":{"exact":"bf987cf890f52c3279ca84099209da2de4a1c954b2230c7e401f1c3e183e1e76","compact":"510e5519f36d5d85c60b2b556fc7f7cbe04b6719a287c67552b46fc33c39050a","nasal":"d83320a3fd7ef1f13f629bf34184ed4a79b6308d9f5426dc79df203f3fd12bc8"}},{"id":"VRCE-7-22-7","kanda":7,"kandaId":"uttara","sarga":22,"verse":7,"english":"In a moment those horses like to thought (in celerity,) and resembling the steeds themselves of Hari, took Yama where the warfare had already begun. Seeing the frightful car in that aspect with Death present in it, the ministers of the Rākşasa monarch at once took to their heels.","alignment":{"type":"1:1","confidence":0.615,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-7"],"status":"unreviewed"},"source":{"sanskritLocator":"7022007","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"35d66c0c288eb0fe9b8b62762630e4947d083dcfa52afb5d76a951af11331fe4","compact":"22525725705f7fe13e78400bded22d306c7e71acc1fcfdd93606fb7261fdba45","nasal":"96cef0ebbe9244eed9151c6b46a6187ae8af0d95401d92efb65ae12800b51e82"}},{"id":"VRCE-7-22-8","kanda":7,"kandaId":"uttara","sarga":22,"verse":8,"english":"In vonsequence of their being comparatively inferior in point of strength they were deprived of their senses, and afficted with fear; and saying, 'Here we are not equal to fighting' they went their way.","alignment":{"type":"1:1","confidence":0.442,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-8"],"status":"unreviewed"},"source":{"sanskritLocator":"7022008","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"630e8a5647b8f531d68bc841f710dfb0340b1c7f8734b7076c6654bf649c6286","compact":"46c2f6e4485e7ccdcec6b035cd220b7b59dc8beaf2ff3723979788eee675f459","nasal":"46c2f6e4485e7ccdcec6b035cd220b7b59dc8beaf2ff3723979788eee675f459"}},{"id":"VRCE-7-22-9","kanda":7,"kandaId":"uttara","sarga":22,"verse":9,"english":"But seeing that car capable of striking terror into folks, the Ten-necked did not experience any agitation, nor did fear enter his heart. And approaching Ravana, Yama, enraged, discharged spears and tomaras, and began to pierce Rāvana's marrow.","alignment":{"type":"grouped","confidence":0.574,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-9"],"status":"unreviewed"},"source":{"sanskritLocator":"7022009","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b12734645eb169997aacee660e382771800c189eb486efcdb14660de92c59859","compact":"390564a05c850d1069090d4d27ed5ed6f8201b00c97b865d59871f237fab40c4","nasal":"390564a05c850d1069090d4d27ed5ed6f8201b00c97b865d59871f237fab40c4"}},{"id":"VRCE-7-22-10","kanda":7,"kandaId":"uttara","sarga":22,"verse":10,"english":"But seeing that car capable of striking terror into folks, the Ten-necked did not experience any agitation, nor did fear enter his heart. And approaching Ravana, Yama, enraged, discharged spears and tomaras, and began to pierce Rāvana's marrow.","alignment":{"type":"grouped","confidence":0.609,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-9"],"status":"unreviewed"},"source":{"sanskritLocator":"7022010","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"474ac523556bce26e02ea6a4f0f7949a49d3a647aed5810cefcc583e1100b77a","compact":"58642eb13a95b78c37a314b1443418ec594ff5f17bd6d9d57d746a5ff1cb871e","nasal":"e9f835c6ef3dcdfe42762f05bcf7fab9c7f8dd96abc603c68936225e13aec015"}},{"id":"VRCE-7-22-11","kanda":7,"kandaId":"uttara","sarga":22,"verse":11,"english":"But Rāvana, without at all feeling any smart, began to shower arrows on Vaivasvata's vehicle, resembling a downpour caused by clouds.","alignment":{"type":"1:1","confidence":0.82,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-22-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7022011","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2aee2f64805fd6