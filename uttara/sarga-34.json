 Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9659783088882300bfcb4b6816ed45365f831556c676214a4a8fb4538fc37f12","compact":"7857b9cb669723b74187e5d3fc19b0baf51c628c1635fd92880a0898c2f21cd0","nasal":"21fac4f0df085e4630a868cf47f39427b4a79692ef61e03766b462993adf33b8"}},{"id":"VRCE-7-34-35","kanda":7,"kandaId":"uttara","sarga":34,"verse":35,"english":"What strength is your! what prowess! What gravity! Holding me like a beast you have journeyed over the four oceans.","alignment":{"type":"1:1","confidence":0.552,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-34-34"],"status":"unreviewed"},"source":{"sanskritLocator":"7034035","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c80630df01b3bef7fcee6d9d2b4c2369ca91954b2ae34b5176d55de050495df0","compact":"0d7902e31fdcceceed75ced65a4f7619fa080ad017142fbb98f822f1f074c89e","nasal":"4524cfabcb62528a1ac920e4776869aa1ee212c6bd2f87558cbfb0a6836afc70"}},{"id":"VRCE-7-34-36","kanda":7,"kandaId":"uttara","sarga":34,"verse":36,"english":"O hero! What heroic wight is there who is not exhausted by carrying me so vehemently?","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-34-35"],"status":"unreviewed"},"source":{"sanskritLocator":"7034036","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04d2e708a7623b938bef5d013501bb8a56458cd69a6398510f3be2f6ae660b9a","compact":"b42f2c2bedd24e8168ae2b5d00abaac402615099319f122e1998b65082b2fe78","nasal":"b8bc21139a9beb2f73a7d1dd1866f9f7b6abd284f0dc64754f45c6681fbf75e7"}},{"id":"VRCE-7-34-37","kanda":7,"kandaId":"uttara","sarga":34,"verse":37,"english":"O monkey, mind, wind and Garuda-these three are gifted with the velocity. Undoubtedly you have got the same velocity.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-34-36"],"status":"unreviewed"},"source":{"sanskritLocator":"7034037","sanskritFile":"R