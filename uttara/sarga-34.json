[{"id":"VRCE-7-34-1","kanda":7,"kandaId":"uttara","sarga":34,"verse":1,"english":"Released by Arjuna, and yet not conceiving any shame, Rāvana, the king of Räkşasas again began to transverse the earth.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-34-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7034001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55651eb3b400cc82d56f4a409ddc28271ed2bd9153fa5d45590a630acd831098","compact":"4c07a222faadb16778ff77e7d799f1342fe120a1125d2a6f79afaa69d3f13336","nasal":"af4943c11a3b32ca099bc4c87135f17c3f997a3a0c2b3a3d9887077bd1054089"}},{"id":"VRCE-7-34-2","kanda":7,"kandaId":"uttara","sarga":34,"verse":2,"english":"Rākşasas or men, of whom the proud Rävaņa heard to be powerful he used to approach and summon them for fight.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-34-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7034002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fac418e132558cba485178e5c0c27e1dc282d32d4c716c04cbda86ac42619d30","compact":"442db16da07f168e52409b223d0cea01b3641578795f9d633cb665f925e6434a","nasal":"442db16da07f168e52409b223d0cea01b3641578795f9d633cb665f925e6434a"}},{"id":"VRCE-7-34-3","kanda":7,"kandaId":"uttara","sarga":34,"verse":3,"english":"After some time he arrived at the city of Kişkindhā reared by Vāli and invited him, wearing golden garland, to fight.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-34-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7034003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b7f2cd1a9f80ca5aa95a6468df5b9bdb3866ad422246334396cb7bca003de9c9","compact":"7f1bdce728141b448cb53fd1778dbe09277f5de7d499aaea074825f0b1e84fc5","nasal":"eda675c34c320