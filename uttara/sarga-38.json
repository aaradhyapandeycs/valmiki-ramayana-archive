39-5"],"status":"unreviewed"},"source":{"sanskritLocator":"7038006","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c515bd9f906a947af6c313748dda8caf9b0d9973a967a4118b34f545102147fc","compact":"f485c1fde8659e15439fbcd5e847f1eebdd68f3abe82fe1c6366afbe9dde5fda","nasal":"0023bde52492fadb2108337ddb90fd4e55e5833d7f5aaf350e34a637f04d4865"}},{"id":"VRCE-7-38-7","kanda":7,"kandaId":"uttara","sarga":38,"verse":7,"english":"And having arrived at their celebrated cities, unscathed, abounding in delighted people, wealth, crops and jewels they sent various presents of gems to Rāma for his satisfaction. Besides this they made over to him innumerable horses, conveyances infuriated elephants, sandal, excellent ornaments, jewels, pearls, corals, beautiful female servants and various cars.","alignment":{"type":"grouped","confidence":0.61,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-39-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7038007","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"86b0a7d69c5932967d60fdc4162d210b0cecd44356b0882e0c9d311bbb9cd2c8","compact":"1ca246dff32297ffde46cd97c7bed5ec27be632756b2a4510fcbc57b09ee9cb7","nasal":"b9ebd5723dc6c4dd3de2915a188a5283d44c0702b6ecc19aabcce14298b735da"}},{"id":"VRCE-7-38-8","kanda":7,"kandaId":"uttara","sarga":38,"verse":8,"english":"And having arrived at their celebrated cities, unscathed, abounding in delighted people, wealth, crops and jewels they sent various presents of gems to Rāma for his satisfaction. Besides this they made over to him innumerable horses, conveyances infuriated elephants, sandal, excellent ornaments, jewels, pearls, corals, beautiful female servants and various cars.","alignment":{"type":"grouped","confidence":0.551,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-39-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7038008","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 189