":"unreviewed"},"source":{"sanskritLocator":"7070009","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"71b78534f72f0a0840799e24e804df44bf95d474146fca3693340945ab21c8ba","compact":"2ae49d2b5e2c23db4cbcb9368d2f44d67bce929587f556facdb970048d06c4f5","nasal":"d5ce4742385db4335be156d2712b03f66a2ddfd59bc42d3b90a1c58baf1b587b"}},{"id":"VRCE-7-70-10","kanda":7,"kandaId":"uttara","sarga":70,"verse":10,"english":"Therefore, O my son having large arms, be particularly studious as regards punishment for thereby you shall acquire great piety.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-79-9"],"status":"unreviewed"},"source":{"sanskritLocator":"7070010","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8e6f99b87da6eaf4df88a6ef83421d5f1895d6d7b4a97d509f4017fc286d9caa","compact":"6ac09fdc818a46a9eb214dbb4571cd4c2c99cb2b9eb11b82523fc5479eb84178","nasal":"bff0f090338a4e1cb7e9c746fc79439dc62a2a7c17f8ec3390e8929036107bba"}},{"id":"VRCE-7-70-11","kanda":7,"kandaId":"uttara","sarga":70,"verse":11,"english":"Having in this wise advised Ikşvāku Manu delightedly repaired to the region Brahmā.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-79-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7070011","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c19b1c2fc52e579b82b990aeccbefebeaf6e07c6c69947bcab003e3c95314cf","compact":"b955de466501bb332faa0a815304fbca0856969c7c64cce5a5afa437697dbc06","nasal":"b955de466501bb332faa0a815304fbca0856969c7c64cce5a5afa437697dbc06"}},{"id":"VRCE-7-70-12","kanda":7,"kandaId":"uttara","sarga":70,"verse":12,"english":"After Manu's departure towards the heaven, the effulgent Ikşavku thought of the means for creating progeny.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttR