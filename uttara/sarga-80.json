ded king Ila, stricken with distress in consequence of the destruction of his servants, poorly replied.","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-89-14"],"status":"unreviewed"},"source":{"sanskritLocator":"7080015","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d0f40cce97410fb884dc38ba94d19827d801d5c9802a0c71bc6918f07700a96a","compact":"0d9251060fa1d7d4a0e07b2752eb265670fe5d6acb491367af2b92ff0869a24f","nasal":"0d9251060fa1d7d4a0e07b2752eb265670fe5d6acb491367af2b92ff0869a24f"}},{"id":"VRCE-7-80-16","kanda":7,"kandaId":"uttara","sarga":80,"verse":16,"english":"O Brāhmaṇa, I shall renounce my own kingdom. Separated from my servants, I shall not be able to live even for a moment. Do you give me permission in this.","alignment":{"type":"1:1","confidence":0.88,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-89-15"],"status":"unreviewed"},"source":{"sanskritLocator":"7080016","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b3c6788318ea4922946f22545e0e0627d39810218a372fb8a340fbc86ad345d8","compact":"bbdc55a41a1b80b4ef537d094ec6fc305014cc32826e19b11c3ea347449d4092","nasal":"bbdc55a41a1b80b4ef537d094ec6fc305014cc32826e19b11c3ea347449d4092"}},{"id":"VRCE-7-80-17","kanda":7,"kandaId":"uttara","sarga":80,"verse":17,"english":"O Brāhmaṇa, my eldest son, the highly illustrious Sasabindu, the foremost of the pious, shall be the owner of my kingdom.","alignment":{"type":"1:1","confidence":0.866,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-89-16"],"status":"unreviewed"},"source":{"sanskritLocator":"7080017","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c7265ba018917bde0faf29990867c0e8b56eea901879d7df510975c8e3bbb2f","compact":"aa5d6cbc99679dfbaa6cbfe901b24b504fa5e6a41284c47623af7cc4d8eb4124","nasal":"359b5dfd98e79f570b144e2ecd04ea54d8cdbb2a0cfe08f733e555076f