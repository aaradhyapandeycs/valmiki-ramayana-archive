[{"id":"VRCE-7-80-1","kanda":7,"kandaId":"uttara","sarga":80,"verse":1,"english":"Having heard of the origin of Kimpuruṣas, both Bharata and Lakşmaņa said to Råma: This is a wonderful story.","alignment":{"type":"1:1","confidence":0.771,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-89-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7080001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b221bc4b2dce58bedf2961a7b60cb9a9566cc194edbd23396a171401a13625a2","compact":"6cf72d2914dbabb1179b44fd17cbbe5f8d3baa4e1ac552771af798795cb5016f","nasal":"6cf72d2914dbabb1179b44fd17cbbe5f8d3baa4e1ac552771af798795cb5016f"}},{"id":"VRCE-7-80-2","kanda":7,"kandaId":"uttara","sarga":80,"verse":2,"english":"Thereupon the highly illustrious Råma, the foremost of the pious, again began with the story of Ila, the son of the patriarch.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-89-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7080002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"90c4fc73f554b8b019529ed319e87374cb6eab3c7d9cd0eb63ec260a93ec0895","compact":"23685dd31c8e1670117578dc15dafd26b8b68cda912c6a556823c77f0b1372ef","nasal":"23685dd31c8e1670117578dc15dafd26b8b68cda912c6a556823c77f0b1372ef"}},{"id":"VRCE-7-80-3","kanda":7,"kandaId":"uttara","sarga":80,"verse":3,"english":"Beholding the Kinnarīs repairing to a distance, Buddha the foremost of ascetics, smiling said, to the beautiful Ila:","alignment":{"type":"1:1","confidence":0.586,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-89-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7080003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c53160cbbab726fba89454f8a77356cf02b0f29e438ff6e1a227927c7616d7d","compact":"4e1768cb797bf4b82fbc91f05e1b3f751e6169ae8bcf8f10df1d5e93abad5a6f","nasal":"c2208e1ba5df