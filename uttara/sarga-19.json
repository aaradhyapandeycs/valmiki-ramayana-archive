[{"id":"VRCE-7-19-1","kanda":7,"kandaId":"uttara","sarga":19,"verse":1,"english":"Having vanquished Marutta, that lord of Rākşasas the Ten-faced Răvaņa, eager for encounter, began to range the capitals of the foremost monarchs (of the earth).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-19-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7019001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"92edd3dded9c6a7a30d66819abb475bcb60ea8353d0a67a842e17c8352a21f00","compact":"0b24b7d26f374764d3ca791d3f35b25399ce0491100c6a0b28a0979d215722b7","nasal":"8182682776f4787c57f526ba20b5088c3f2246f8e890ee9987cc844a83ebee1a"}},{"id":"VRCE-7-19-2","kanda":7,"kandaId":"uttara","sarga":19,"verse":2,"english":"And coming to the most powerful crowned heads (in the world) resembling Mahendra and Varuna, the Raksasa king said: 'Give me battle; or declare we have been defeated. This I am resolved upon. Otherwise there is no escape for you?'","alignment":{"type":"grouped","confidence":0.781,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-19-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7019002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4f883838df15d4748f850b04dd57ca6ad7be91f1e222d21b00ab84cf408c6cc6","compact":"5bb6c8f705e9f49d142215dcd7d82e7c2e012fdc01d047590acc4d5f07cdfc58","nasal":"a46a0e9df3a34d9bca065f2aec043824a30b88dd9d22b7e31c16c5c9274368fa"}},{"id":"VRCE-7-19-3","kanda":7,"kandaId":"uttara","sarga":19,"verse":3,"english":"And coming to the most powerful crowned heads (in the world) resembling Mahendra and Varuna, the Raksasa king said: 'Give me battle; or declare we have been defeated. This I am resolved upon. Otherwise there is no escape for you?'","alignment":{"type":"grouped","confidence":0.651,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-19-2"],"status":"unreviewed"},"source":{"sanskritLocat