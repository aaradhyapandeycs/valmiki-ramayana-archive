[{"id":"VRCE-7-17-1","kanda":7,"kandaId":"uttara","sarga":17,"verse":1,"english":"Then, O King, the mighty-armed Ravana ranging the earth, came to Himavān and began to go round it.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7017001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c1834b1bd83e5768255efc070c6b673364792b37c75cb9db220a17988da770ef","compact":"47293bd40f4bae2821fa0afec7c18ea13bde202fa824c47fffcf212d4e7ae9eb","nasal":"47293bd40f4bae2821fa0afec7c18ea13bde202fa824c47fffcf212d4e7ae9eb"}},{"id":"VRCE-7-17-2","kanda":7,"kandaId":"uttara","sarga":17,"verse":2,"english":"It came to pass that there he saw a damsel wearing a dark deer-skin and matted locks, leading the life of a saint, and flaming like a celestial.","alignment":{"type":"1:1","confidence":0.532,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7017002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"33633747153d8a23bb2380204f94e7cf8327f4795392a287830ac998dbf83605","compact":"7f336e9d574267f6a7cf8a14ee6b9d23c8e5f7e4ca05d8a2a9c970cd6809bd39","nasal":"29d9ae235484dc244505a3c50041b4b0ee8bb88b9f0e1d7055263d3e6c28cdee"}},{"id":"VRCE-7-17-3","kanda":7,"kandaId":"uttara","sarga":17,"verse":3,"english":"Seeing the girl observing high vows, endowed with beauty, he, with his soul overwhelmed with lust asked her, laughing.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7017003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"86ddb8fb6d4d9a8f1c48c025e9207f42762bc58e743d40552b4097b1392c382f","compact":"7e8cfae0a2d1d60208334624f6670fe1d1132ddc10ae4bd7a37b9733dfb2f2a2","nasal":"dc