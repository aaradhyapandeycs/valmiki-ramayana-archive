.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7017019","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87f7244da6e86be1ac7d9f945fb2203151c7c028f4526283bc6d01c85b5df1e1","compact":"d6e9ba86aab24edc4ead088f8e300d623d1c50ab6c35d4f1a918f9d869c30ec5","nasal":"d6e9ba86aab24edc4ead088f8e300d623d1c50ab6c35d4f1a918f9d869c30ec5"}},{"id":"VRCE-7-17-20","kanda":7,"kandaId":"uttara","sarga":17,"verse":20,"english":"You, furnished with every perfection, should not talk thus. You are the paragon in these three worlds,. Your youth wax away.","alignment":{"type":"1:1","confidence":0.662,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-18"],"status":"unreviewed"},"source":{"sanskritLocator":"7017020","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"67c514370e71d95c518c6a6a8f2ed0bbd7fd14f3c5788548791acf688f94233b","compact":"42ebbb74bcb6fd39613e3f315d5df091d66fcd775fb9e89502e1e81e9fe65811","nasal":"48d4747638a2b8e0d42ab43e2d312f5fe7c23758033ca85c06f856e93814a4eb"}},{"id":"VRCE-7-17-21","kanda":7,"kandaId":"uttara","sarga":17,"verse":21,"english":"Who is he whom you call Vişņu O mild one, neither in prowess, nor in asceticism, nor in enjoyment, nor in strength, is he my equal, whom, O damsel, you seek.","alignment":{"type":"1:1","confidence":0.819,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-20"],"status":"unreviewed"},"source":{"sanskritLocator":"7017021","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d6545a934ab219c8f9b99f484e2cf18d6f99c3c2801c09c6b4d5112a73b735c","compact":"15659246c818393d19172a3c3218f884dcff93264efa09759af12ce91ab42fd6","nasal":"87eea77dca5cb3220ad6e9ccc7baff6c6cbbf2b95152004f198b193131ad1628"}},{"id":"VRCE-7-17-22","kanda":7,"kandaId":"uttara","sarga":17,"verse":22,"english":"Thus accosted, Vedavati said to the nightranger 'Do not say so' in respect of Visnu, lord of this triune sphere, bowed down to by all creatures. Save and except you alone, O King of Raksasa, who, that is intelligent, cried down (Narayana).","alignment":{"type":"1:1","confidence":0.404,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-21"],"status":"unreviewed"},"source":{"sanskritLocator":"7017022","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a40a9e9e9aa889cad2173325fc3b025446dc66c026df19ec41ac1654494585a","compact":"4877da3f34ce97c05419d53a2bee93b386581a64861e81b3deec4115999ee341","nasal":"fb1a30609ece847f94f1d3a5e3e10e1d227c771ad1408752c67a9364b032b3d0"}},{"id":"VRCE-7-17-23","kanda":7,"kandaId":"uttara","sarga":17,"verse":23,"english":"Thereat Vedavati, wroth, cut off her hair with her hand transformed into a sword. Then, flaming up in ire and as if consuming the night-ranger, she, preparing a funeral pyre, hastened to make away with herself.","alignment":{"type":"split","confidence":0.517,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-23","DUTT-7-17-24"],"status":"unreviewed"},"source":{"sanskritLocator":"7017023","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb8aae5394317e2d3665849ce5921b10e85997f7ae9451de8e64eb70651d59c4","compact":"b4604d2cf6a40d77464604d9c31eeb0a066376d7ae3610e1c0ed430e1ca52d3c","nasal":"b4604d2cf6a40d77464604d9c31eeb0a066376d7ae3610e1c0ed430e1ca52d3c"}},{"id":"VRCE-7-17-24","kanda":7,"kandaId":"uttara","sarga":17,"verse":24,"english":"You object, having been outraged by you I wish not to live. Therefore, O Raksasa, I will enter into fire in your very presence.","alignment":{"type":"1:1","confidence":0.699,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-17-25"],"status":"unreviewed"},"source":{"sanskritLocator":"7017024","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6a71ded5ba96f98910c8e516ea3454b7e918192