[{"id":"VRCE-7-61-1","kanda":7,"kandaId":"uttara","sarga":61,"verse":1,"english":"Hearing the words of the high-souled Śatrughna Lavaņa was greatly enraged and again and again asked him to wait.","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-69-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7061001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"15e23021ab34bf7816266cad525a9a09ea5c4eea33dd5f02b102849bd2c12f3e","compact":"b278eb474b924c5ea3b15a0709f171ae1b3e833f1af92cc71321de80e6b7819d","nasal":"b278eb474b924c5ea3b15a0709f171ae1b3e833f1af92cc71321de80e6b7819d"}},{"id":"VRCE-7-61-2","kanda":7,"kandaId":"uttara","sarga":61,"verse":2,"english":"Clashing his hands and grinding his teeth he invited that foremost of Raghus to fight.","alignment":{"type":"1:1","confidence":0.85,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-69-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7061002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd6c04be944bcf07592a2b38f1a0ebb4e52203a2d80c22a2b65f8101d5049bb5","compact":"1d9494db6ceca545bf0ec8271635f263e6f00ddde4291ea5b31c6693d129d841","nasal":"41a081e3e06f16b19041ab332538b746d90069d7963e1d696c93d86b271f648c"}},{"id":"VRCE-7-61-3","kanda":7,"kandaId":"uttara","sarga":61,"verse":3,"english":"And Satrughna, the slayer of celestial's enemies, said to the dreadful Lavaņa, giving vent to those words.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-69-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7061003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f807cf9dc74fc1c7ed2663204b8144cb0f9f4363ceaa0b8b0baddac3488a0f0","compact":"760c86a753213a661053b27e82623d0052b526a70f4035f309b86c75f80e587c","nasal":"760c86a753213a661053b27e82623d0052b526a70f4035f309b86c75f