Edition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"92858774c9a07ed1994c60118c2c4558436fc87b5f5c16dafc98c40eae9c4f85","compact":"eac36d29d4f81ce87de5d6be6ebdf5afd84f7c1e08e2144631ba21b09c3d29b7","nasal":"eac36d29d4f81ce87de5d6be6ebdf5afd84f7c1e08e2144631ba21b09c3d29b7"}},{"id":"VRCE-7-25-7","kanda":7,"kandaId":"uttara","sarga":25,"verse":7,"english":"Hear, I shall relate to you everything, O king; your son has met with the fruits of many a sacrifice, Agnistoma, Asvamedha, Bahusuvarņaka, Rājsūya, Gomedha and Vaisnava. And being engaged in this Maheśvara sacrifice, which is incapable of being celebrated by men, your son has obtained boon from Pasupati’ himself.","alignment":{"type":"grouped","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-7"],"status":"unreviewed"},"source":{"sanskritLocator":"7025007","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8aa9a4716cb7b3ab04a2ed67b0bf3a52e8caf78ba8b33950370fd76792bf0866","compact":"e6796ced7ef96183980f2a1af5d15faaf0ed49fa970440657666a2f3699096f4","nasal":"e6796ced7ef96183980f2a1af5d15faaf0ed49fa970440657666a2f3699096f4"}},{"id":"VRCE-7-25-8","kanda":7,"kandaId":"uttara","sarga":25,"verse":8,"english":"Hear, I shall relate to you everything, O king; your son has met with the fruits of many a sacrifice, Agnistoma, Asvamedha, Bahusuvarņaka, Rājsūya, Gomedha and Vaisnava. And being engaged in this Maheśvara sacrifice, which is incapable of being celebrated by men, your son has obtained boon from Pasupati’ himself.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-7"],"status":"unreviewed"},"source":{"sanskritLocator":"7025008","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c32cf20dd52be74c0f637b6fb50bf654778351189e65d47e9f5544cefcc7d43a","compact":"fdb20bbbeb906b39202d58bd6f9416201869fadfce71942621c4ef0be66fe1c2","nasal":"fdb20bbbeb9