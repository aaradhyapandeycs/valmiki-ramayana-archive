anskrit-ngram","duttRefs":["DUTT-7-25-9"],"status":"unreviewed"},"source":{"sanskritLocator":"7025011","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db6f3f9c36cc3a7b612ea1b309230fde4664d48f7d1678ac346d10b791c68890","compact":"ca28ee02a13d0edd205c546ac1f1bcf0fdbf96e685dd759de5b82075ebbf4f45","nasal":"ca28ee02a13d0edd205c546ac1f1bcf0fdbf96e685dd759de5b82075ebbf4f45"}},{"id":"VRCE-7-25-12","kanda":7,"kandaId":"uttara","sarga":25,"verse":12,"english":"Besides he has obtained a quiver, the arrows whereof shall never be exhausted, a bow, which is hard of being got by and a dreadful weapon which destroys enemies in a conflict.","alignment":{"type":"1:1","confidence":0.766,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7025012","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3125ca2bcd3e908e1f2ceabf5a027bbea6214a10ba620a017d0862318f1aac77","compact":"c2c9d1c223e886ec8a7608983e0f7bd910cc516a62b65fb8d34f24c0069e112f","nasal":"c2c9d1c223e886ec8a7608983e0f7bd910cc516a62b65fb8d34f24c0069e112f"}},{"id":"VRCE-7-25-13","kanda":7,"kandaId":"uttara","sarga":25,"verse":13,"english":"Having obtained these boons your son, O you having ten faces, and myself, the sacrifice being finished, have been waiting to behold you.","alignment":{"type":"1:1","confidence":0.608,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-11"],"status":"unreviewed"},"source":{"sanskritLocator":"7025013","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"24dd8775040e7fea0f853acd1eb6fffc57cd998f4195ed9e157062753ddcd647","compact":"9133184c858e552bdee99224c378f7551b2d989f6e3651e96bfb5406a6ea3e69","nasal":"9133184c858e552bdee99224c378f7551b2d989f6e3651e96bfb5406a6ea3e69"}},{"id":"VRCE-7-25-14","kanda":7,"kandaId":"uttara","sarga":25,"verse":14,"english":"Whereto the Ten-necked demon replied, Y