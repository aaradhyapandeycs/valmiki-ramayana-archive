[{"id":"VRCE-7-25-1","kanda":7,"kandaId":"uttara","sarga":25,"verse":1,"english":"Having thus given the command of a huge and dreadful army to Khara and consoled his sister the Ten-necked demon was satisfied and freed from anxiety.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7025001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"da8b1282a55a6c0fb2bd1f077a8b9f4c36fed57a4ab1ea3bfdf68a688a67627b","compact":"651f47894019436520b93c5c7cb24e794fdb11f3341c4747ac45f2c542a170e0","nasal":"651f47894019436520b93c5c7cb24e794fdb11f3341c4747ac45f2c542a170e0"}},{"id":"VRCE-7-25-2","kanda":7,"kandaId":"uttara","sarga":25,"verse":2,"english":"Thereupon that highly powerful lord of Rāksasas with his followers entered an excellent garden in Larkā named Nikumbhilā.","alignment":{"type":"1:1","confidence":0.415,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7025002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e48f55ccabec3095af0a5b8395fbc60601e4bef00d9544974ca7e8fca214911b","compact":"bd7ade7ec2aab2d915f5bdbbdb532fc01c3809a9c44de7807ae511b73720d977","nasal":"15aed52af45bbadf30a6292e9e2e2373b9f0c6d19a70062e37ce5a9bd72557c1"}},{"id":"VRCE-7-25-3","kanda":7,"kandaId":"uttara","sarga":25,"verse":3,"english":"There, he saw, filled with hundreds of sacrificial posts and altars, a sacrifice being celebrated, as if burning in its lustre.","alignment":{"type":"1:1","confidence":0.646,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-25-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7025003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"efc03967f6b6448ebb7154017357fa527d924ec5e4a3d4ee1e577584a050c141","compact":"eb72f71d0efffbf5d0e659f3c7cd778a054ae7