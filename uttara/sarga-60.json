0.781,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-68-12"],"status":"unreviewed"},"source":{"sanskritLocator":"7060014","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b19c8c9c632bb0751bbfcd0b605ffec3da92775b33f3fb0f0e2816df4b77515","compact":"6276759fb337c6180ee2ebbf9d6cb6859ed3cdeb30e20933cf6a96e16fc32328","nasal":"6276759fb337c6180ee2ebbf9d6cb6859ed3cdeb30e20933cf6a96e16fc32328"}},{"id":"VRCE-7-60-15","kanda":7,"kandaId":"uttara","sarga":60,"verse":15,"english":"It is out of hatred that I have tolerated the destruction of Rāvana's family and have pardoned you all.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-68-13"],"status":"unreviewed"},"source":{"sanskritLocator":"7060015","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ce9f2265e5c50daa41dab13891f5622711ebfe0d03a8522702891ab277045ac0","compact":"e59c217baf2a930f233aab7c17ec16b3eaf396fc06f7f21e8003354ff36e039c","nasal":"d753b4b2d80a7f61f25ef2fb8cd3ed9305789d30fe6e52f78fac0365593f257c"}},{"id":"VRCE-7-60-16","kanda":7,"kandaId":"uttara","sarga":60,"verse":16,"english":"You are all vile men; I have slain and defeated all of your family that have passed away and shall destroy all that are living and shall come into existence.","alignment":{"type":"1:1","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-68-14"],"status":"unreviewed"},"source":{"sanskritLocator":"7060016","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c30189f27474cf8c18a62a13fa2203e50b24f6c3842b07605b3d76ee16bd05b4","compact":"d671ca1d7907e5b117298b8d5f035dd786536a5c3ad95b31b5e3c62038da0a12","nasal":"d671ca1d7907e5b117298b8d5f035dd786536a5c3ad95b31b5e3c62038da0a12"}},{"id":"VRCE-7-60-17","kanda":7,"kandaId":"uttara","sarga":60,"verse":17,"english":"O you of vicious intellect, if you wish I shall fight with you. D