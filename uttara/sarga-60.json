[{"id":"VRCE-7-60-1","kanda":7,"kandaId":"uttara","sarga":60,"verse":1,"english":"They being thus engaged in conversation regarding his achieving victory without any danger Satrughna in no time passed the night.","alignment":{"type":"1:1","confidence":0.859,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-68-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7060001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ea681fc1174c51466dc1530a828f0e17ecf161e36f11eac8026b4068d66dcce8","compact":"c2ecf57d1fb5b0a6e0de02d14e001479e3c1655c0eee3fa9eae129a26b1dc373","nasal":"18561fd7c023cfb823fc513f280543a67fc8082f1809202dc3b9adeed026ed03"}},{"id":"VRCE-7-60-2","kanda":7,"kandaId":"uttara","sarga":60,"verse":2,"english":"The clear morning having arrived, that time the heroic Lavana issued out of his city to collect food.","alignment":{"type":"1:1","confidence":0.891,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-68-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7060002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"20771c8e36254e8926adaa5c7d7fff9c4931d53c2a7a84fd71833db2c3e3f72f","compact":"38dcf0e4a859c26f4bc60dc5f63a58f9897b43aca4181585280548646359b705","nasal":"38dcf0e4a859c26f4bc60dc5f63a58f9897b43aca4181585280548646359b705"}},{"id":"VRCE-7-60-3","kanda":7,"kandaId":"uttara","sarga":60,"verse":3,"english":"In the meantime having crossed the river Yamunā, the heroic Satrughna, with bow in his hands, stood at the gate of Madhu's city.","alignment":{"type":"1:1","confidence":0.418,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-68-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7060003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"22064bf9c8b48c7fa281ca6fa11b550ee0fb38758939c451eed3fe99264cccb4","compact":"ef848d8c5fbd6b79dbde1107da3f087a71ed0abc6d98c9a2b10921d051a4905c","nasal":"92