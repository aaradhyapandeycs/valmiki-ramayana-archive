kritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c08cca09e9bb4e630a297b3460fd6c7b89e2126892ee0fb178075404ff928644","compact":"c2379c7f0086e38062999ab7991fce9e11cc08a3e2ae017f1b70756ba666703f","nasal":"18485958fbcc6e0127539b09d5226128edd3fe5b1fa299d493203c940635f38b"}},{"id":"VRCE-7-4-13","kanda":7,"kandaId":"uttara","sarga":4,"verse":13,"english":"Those among you who have said 'Raksama,' shall be Raksasas; and those among you, who have said 'Yaksama' shall be Yaksas.","alignment":{"type":"1:1","confidence":0.635,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-4-13"],"status":"unreviewed"},"source":{"sanskritLocator":"7004013","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"952187225cb25f67ae8e365845e8729179bdadf59a28e1066aa221960851c4c7","compact":"253e33558c1e6b290e2ef6553f143da0d78fb3de08d444017e287319d5c408ae","nasal":"5a1c220175fdfb0c6acaccfde75cd3141b050d2d878144cb65d671ee7f5ddb31"}},{"id":"VRCE-7-4-14","kanda":7,"kandaId":"uttara","sarga":4,"verse":14,"english":"And there sprang the brothers-repressors of foes-Heti and Praheti lords of Raksasas, resembling Madhu Kaitabha himself.","alignment":{"type":"1:1","confidence":0.804,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-4-14"],"status":"unreviewed"},"source":{"sanskritLocator":"7004014","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"df3ef5634162624820f3a48bc1a16d06bde768ec5190b613bb2b265e91441392","compact":"01f6f775b516e7c1365d91a514134d0675a93381980a32799dd827799fba8a29","nasal":"01f6f775b516e7c1365d91a514134d0675a93381980a32799dd827799fba8a29"}},{"id":"VRCE-7-4-15","kanda":7,"kandaId":"uttara","sarga":4,"verse":15,"english":"Praheti, who was righteous, went to the wood of asceticism. And Heti exerted himself to the utmost to get himself wived.","alignment":{"type":"approximate","confidence":0.183,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-