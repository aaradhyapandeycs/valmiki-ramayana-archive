[{"id":"VRCE-7-4-1","kanda":7,"kandaId":"uttara","sarga":4,"verse":1,"english":"Hearing the words uttered by Agastya, Răma wondered as to how formerly Rākşasas were generated in Lanka.","alignment":{"type":"1:1","confidence":0.609,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-4-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7004001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f21ec7b211ea750dbac1ea92cdbcf4959e6c593e0df4c4228c82a6a9c6bef0b3","compact":"52e0ae93304246613a2198697e0cb2e9165c7d4907ba0521bc263ba12b51231a","nasal":"39914b92fedb0d8b3053b0074a06a42ee7955606dc8ce79360b1be4d3fa15e2d"}},{"id":"VRCE-7-4-2","kanda":7,"kandaId":"uttara","sarga":4,"verse":2,"english":"Then shaking his head, he, struck with wonder, momentarily eyeing Agastya, addressed Agastya resembling fire, saying.","alignment":{"type":"1:1","confidence":0.768,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-4-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7004002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"deea7e1754dfcbf95009ab1b41d67a20f89827fd22140a06ac23b2310e7c63bc","compact":"b70bf62b688f661128395f041858290245ab06763539e5927d79a94645b23750","nasal":"475d4b76b83559301bafb3a0c75b69866a27a18fab8740c0f1805c236061abb9"}},{"id":"VRCE-7-4-3","kanda":7,"kandaId":"uttara","sarga":4,"verse":3,"english":"O worshipful one, hearing your words that formerly Lankā had been in the possession of the flesh-eaters, I have been seized with great amazement.","alignment":{"type":"1:1","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-4-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7004003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4705f13b92c0f72c8c250c8d0a04f531607e362075c2c09d50802c1b993a2a8c","compact":"15ec6b53b61022a58c30a21042250f25c123b62628cba4f4333cdc85bc591384","nasal":"1773a