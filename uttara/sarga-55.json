[{"id":"VRCE-7-55-1","kanda":7,"kandaId":"uttara","sarga":55,"verse":1,"english":"Thus accosted by Rāma, the exceedingly energetic Satrughna was powerfully wrought up with bashfulness, and replied slowly.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-63-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7055001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"92a4ae0fdd783478e3b9b600d7cd79c7012339de048d39179e4e478bc2d89e6d","compact":"320fa32b1a9eb8700baa8b03d69c56f3294299914ec04745b48129d2376831ed","nasal":"f27cb6e857d810db33f7df80420fd8c43637269e58c3f0ec2766401a28fdf7f6"}},{"id":"VRCE-7-55-2","kanda":7,"kandaId":"uttara","sarga":55,"verse":2,"english":"I must, O best of men, do your behest: for, O exalted one, your mandate can never be passed by me.","alignment":{"type":"1:1","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-63-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7055002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72542b703473309167026c532bd9e10769bde4da3c515005e8a7f4e2d974e21a","compact":"cf51773e9baaebbe0f61f06e237e8ac1074284b898ebea3152f7f4f328884991","nasal":"cf51773e9baaebbe0f61f06e237e8ac1074284b898ebea3152f7f4f328884991"}},{"id":"VRCE-7-55-3","kanda":7,"kandaId":"uttara","sarga":55,"verse":3,"english":"Thus addressed by the heroic and high-souled Śatrughna, Rāma, delighted, spoke to Bharata and Laksmana.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-63-8"],"status":"unreviewed"},"source":{"sanskritLocator":"7055003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5990d308cb193e3097680b5c71c650b6a9387fea36e8381f2946897124a929d7","compact":"41e93b5cc77a99d379e69e494f74697b4083c22c44f5ebeae0045aa278e4ec7f","nasal":"41e93b5cc77a99d379e69e494f74697b4083c