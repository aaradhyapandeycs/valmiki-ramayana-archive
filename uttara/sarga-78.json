grouped","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-87-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7078023","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d2e225c4b419f689148b3a32dc0117c7102cd74f9e31ce061f105c5f80fb430","compact":"3eeb6fc8537b2808554838c8a32a3bca626cf7a61f42d977e8438e25c72ad133","nasal":"3eeb6fc8537b2808554838c8a32a3bca626cf7a61f42d977e8438e25c72ad133"}},{"id":"VRCE-7-78-24","kanda":7,"kandaId":"uttara","sarga":78,"verse":24,"english":"There upon, cognisant of that king's intention, the goddess, with Hara's consent, said. Half of the boon, that you shall beg of us both, shall be granted by Mahādeva, and the other half shall be granted by me. Do you therefore beg of me the half.","alignment":{"type":"grouped","confidence":0.735,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-87-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7078024","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"525a15c784d56826e93e17ccac80f2b04fce38e9a30bff2c360165eb27901a06","compact":"371857f088f416ed1d5ca1d937b8f286bbb590e1d00a9db37ebc60bf22578f49","nasal":"371857f088f416ed1d5ca1d937b8f286bbb590e1d00a9db37ebc60bf22578f49"}},{"id":"VRCE-7-78-25","kanda":7,"kandaId":"uttara","sarga":78,"verse":25,"english":"Hearing of that excellent and wondrous boon the king became greatly delighted and said:-If you are pleased with me, O goddess, do you confer upon me this boon, that I may be for one month, a female gifted with wonderful beauty in the three worlds and for another month I may be a male.","alignment":{"type":"grouped","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-87-18"],"status":"unreviewed"},"source":{"sanskritLocator":"7078025","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ef3855933171c86a3e189f09fbd8dce0111a782e7611a627d5fb7bff59d1dac2","