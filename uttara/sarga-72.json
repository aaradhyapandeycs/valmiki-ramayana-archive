erprints":{"exact":"8ea97f9bef00be0c812f835155661f3fefb4cbc3e1772c5fd866a22780868d39","compact":"c457f109ef0c44b24af12d1086adbf924fdaedc8d3c00a6f0aef2cef89895ecd","nasal":"7964b115b2ece341f765de7f4b461cb786cca47326ae10e3036ef59510bbb55d"}},{"id":"VRCE-7-72-18","kanda":7,"kandaId":"uttara","sarga":72,"verse":18,"english":"O Rāma, in the golden age, the province between the mountains Vindhya and Saivala comprising Danda's territories, imprecated by the Brāhmaṇa saint, in consequence of the iniquity of the vicious souled, was reduced into a desert. From that time it passes by the name of Dandaka forest.","alignment":{"type":"grouped","confidence":0.475,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7072018","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b00a9d7327b1bd8f791b25e6f4619cbc2b591db979700e6d7e916eff14989831","compact":"bb0264053d394a3ff601e08ee4df10cd09f994194fb43e0f799ce2074cef2594","nasal":"fae8fd2e0aa6331d2365c7d350792c4ede6f1b3c09a95280ddd0653435c2df7e"}},{"id":"VRCE-7-72-19","kanda":7,"kandaId":"uttara","sarga":72,"verse":19,"english":"And it is otherwise called Janasthāna because the ascetics used to perform austerities there. O Rāghava, I have thus related to you, all you did ask of me. O hero, the time for performing evening rites has come. Behold O foremost of men, having performed ablution, the great saints, on all sides, with jars full of water, are worshipping the sun.","alignment":{"type":"split","confidence":0.459,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-18","DUTT-7-81-19"],"status":"unreviewed"},"source":{"sanskritLocator":"7072019","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0072604d63af27fe19e1a141e2f60da248080e4b40020939db05cc18aa943a17","compact":"d8f1e536f2f4a803cf3c18d9958973abfe689e2280184a571c2804d5e1e79dd2","nasal":"d8f1e536f2f4a803cf3c18d9958973abfe689e2280184a571c2804d5e1e79dd2"}},{"id":"VRCE-7-72-20","kanda":7,"kandaId":"uttara","sarga":72,"verse":20,"english":"O hero, the time for performing evening rites has come. Behold O foremost of men, having performed ablution, the great saints, on all sides, with jars full of water, are worshipping the sun. Having accepted adoration in the shape of Vedic hymns chanted by Brāhmaṇas, wellversed in Vedas, the illustrious Aditya is about to be set. Therefore, O Rāma, do you perform the ceremony.","alignment":{"type":"split","confidence":0.45,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-19","DUTT-7-81-20"],"status":"unreviewed"},"source":{"sanskritLocator":"7072020","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e9281fa3e69a75c8776833cb03e128822d30881c64fb2b758630c44bb2208e62","compact":"82da39135e0a284918c8bc205b7b3d108bde956acd9f6203f842c88f1ee7f995","nasal":"25ce5fc5386ff13df0571abe7709c16946b068111e1c37767bcd891019771d7f"}},{"id":"VRCE-7-72-21","kanda":7,"kandaId":"uttara","sarga":72,"verse":21,"english":"Having accepted adoration in the shape of Vedic hymns chanted by Brāhmaṇas, wellversed in Vedas, the illustrious Aditya is about to be set. Therefore, O Rāma, do you perform the ceremony.","alignment":{"type":"grouped","confidence":0.576,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-20"],"status":"unreviewed"},"source":{"sanskritLocator":"7072021","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2853ea73b167191e2d9bad48dfc5f42a311840c8ad5ca17078bc6a252f5147e2","compact":"300953be26cf4c4248ab2525738f8419b1a6d43e557ce17f5acaeae99f40564e","nasal":"300953be26cf4c4248ab2525738f8419b1a6d43e557ce17f5acaeae99f40564e"}}]
