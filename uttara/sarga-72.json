t-ngram","duttRefs":["DUTT-7-81-5"],"status":"unreviewed"},"source":{"sanskritLocator":"7072006","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c5678e311c71f202da772cabf8e6ac075221e2a2b19081aaad48d5c418347dce","compact":"d0e23fc69cd8ae72055e6f3e5c17490c46e27c1620fba42494d425a2baca5f17","nasal":"d0e23fc69cd8ae72055e6f3e5c17490c46e27c1620fba42494d425a2baca5f17"}},{"id":"VRCE-7-72-7","kanda":7,"kandaId":"uttara","sarga":72,"verse":7,"english":"Within seven nights, the wicked and vicious Daņda, with his son, soldiers and retinue, shall meet with death.","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7072007","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b7ab0d2c55b8567efc7e6cab82d69cd0ba15d4de98b80f341258aed6765cd5c9","compact":"c8df316d95479db299e18300a6e48bb83853b98e3b25c095053c327332413c67","nasal":"c8df316d95479db299e18300a6e48bb83853b98e3b25c095053c327332413c67"}},{"id":"VRCE-7-72-8","kanda":7,"kandaId":"uttara","sarga":72,"verse":8,"english":"Showering dust Indra shall destroy, to the extent of a hundred Yojana, the territory of this vicious king.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-7"],"status":"unreviewed"},"source":{"sanskritLocator":"7072008","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"99fa960d7fdc6681c221a89d3b6fdbe4e36c3ad901e7290ce40efa7bda72f42d","compact":"a8bcaf67f52157b44fb89a973c29133e9f171f08b98543e062d44a9fd47febf0","nasal":"2d2852b231cc44f49d68624bb883b45ec6137c167d57022699ea436c0c1a24a8"}},{"id":"VRCE-7-72-9","kanda":7,"kandaId":"uttara","sarga":72,"verse":9,"english":"And all creatures mobile and immobile, wherever they might be, shall be destroyed with this downpour of dust.","alignment":{"type":"1:1","confidence":0.567,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-8"],"status":"unreviewed"},"source":{"sanskritLocator":"7072009","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"caa7e89a887b0fdab2f321503de3782c7bf329f46ec00515053c59f0880b0c7c","compact":"43dd3ff28d02ec448e49291118e657c32a0fe62797c3c35fc4219a9b0af9af30","nasal":"cdc2ff4885806bcd83698125229fabde73f5e436f1104393eeb2d7702d2fa77c"}},{"id":"VRCE-7-72-10","kanda":7,"kandaId":"uttara","sarga":72,"verse":10,"english":"All animals as far as this Daņdas' territory extends, shall be destroyed within seven nights.","alignment":{"type":"1:1","confidence":0.328,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-9"],"status":"unreviewed"},"source":{"sanskritLocator":"7072010","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85bf9054bf8e2530053b81ccc014f389dbb2eadda707729c32111dad41bad003","compact":"6473343921895c1b80ed480ad2ae898f6b6bec7aa3af7da8aa8cdfcbe95c0e63","nasal":"04da5529309695f5d00c81396db4e66dc4b716c5f3af7e63b1f7c04558a4749c"}},{"id":"VRCE-7-72-11","kanda":7,"kandaId":"uttara","sarga":72,"verse":11,"english":"Having said this, with eyes reddened with ire, USanas, Bhrgu's son, said to the inmates of his hermitage: Do you all go and wait outside this kingdom.","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-81-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7072011","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a6b1c68e373889e28035b9be52344d0cce673664e85ec741e61c748efbb042f4","compact":"e623909b0a74ceeee6765d2a951116b0e20b712ee8b1af431be5c6e1bb999576","nasal":"51c56a93d8c969a71e4b906b7bc29c899a0aaf3ed8fe1c52464ba8e60c8dfe6b"}},{"id":"VRCE-7-72-12","kanda":7,"kandaId":"uttara","sarga":72,"verse":12,"english":"Hearing the words of the preceptor Sukra, the inmates left the hermitage and lived at