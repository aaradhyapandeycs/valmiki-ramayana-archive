[{"id":"VRCE-7-21-1","kanda":7,"kandaId":"uttara","sarga":21,"verse":1,"english":"Having reflected thus, that foremost of Vipras endowed with fleet vigour, bent his steps towards the abode of Yama, for the purpose of relating to him all that had taken place.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-21-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7021001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d366b5d3800e62feb19f6a4a3cdae1bb2ce9b935c372963304f759f10f549692","compact":"e316e477937b726e7b7bd60c27685e9c3d1fc93200d6378fe34e93d59d1e5ca9","nasal":"22e8e964d5d3966538d2510e78675aafd6fee3bfcf2fd458742b6caa6058232f"}},{"id":"VRCE-7-21-2","kanda":7,"kandaId":"uttara","sarga":21,"verse":2,"english":"There he saw that god Yama sitting in front of fire and offering into it the good and evil fruits of their actions. * *Ordaining happiness and misery to the lives of people according to their acts.'","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-21-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7021002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2008c0f2d2431d42ce9e48fae10cfef2a064fa9c80b7663277dae074bb76198a","compact":"9767efd826bdfcb199d8fef5578ff2ee6e903040330373bf7467f0f46dd5e22b","nasal":"d7fa8aa99d88ff4183c2e67ebfb9777b585b9ae3560339dd6b17c4ece6624053"}},{"id":"VRCE-7-21-3","kanda":7,"kandaId":"uttara","sarga":21,"verse":3,"english":"Seeing the Maharși Nārada arrive there, Yama offering him arghya according to the ordinance, addressed him saying, when he was seated at his case:","alignment":{"type":"1:1","confidence":0.701,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-21-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7021003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"ex