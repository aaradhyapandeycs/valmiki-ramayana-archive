[{"id":"VRCE-7-67-1","kanda":7,"kandaId":"uttara","sarga":67,"verse":1,"english":"Hearing the words of Räma of unwearied actions, the ascetic, with his face downwards, said.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-76-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7067001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a37762e7e9041116603968ff30c33160c540ee016be068bed75353515f065ae2","compact":"d1a510eb811abbefabcdb6b00cb7934d2bdb733411373cef23b6e5ea928219bf","nasal":"d1a510eb811abbefabcdb6b00cb7934d2bdb733411373cef23b6e5ea928219bf"}},{"id":"VRCE-7-67-2","kanda":7,"kandaId":"uttara","sarga":67,"verse":2,"english":"O highly illustrious Rāma, I am born in the race of sūdras; and with a view to reach the region of the celestials with my body I am going through these austere penances.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-76-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7067002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e3ff02a8b111fb988ea6768f95543edb52eeefc10010f7c6bc3d184636e33a8","compact":"d4468add0794fff9c4e45f8f9619e2254b5d7ee046b5644a5332e6c387778c3d","nasal":"d4468add0794fff9c4e45f8f9619e2254b5d7ee046b5644a5332e6c387778c3d"}},{"id":"VRCE-7-67-3","kanda":7,"kandaId":"uttara","sarga":67,"verse":3,"english":"O Kākutstha, I shall never utter a falsehood since I am willing to conquer the region of gods. I am a Sūdra and my name is Sambūka.","alignment":{"type":"1:1","confidence":0.71,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-76-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7067003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5fb81e57536388a136dc796f76415982464381e645ce6c5bc530dff274ef98cd","compact":"0c6eff9cdb130a7d6f1ad2dbd50b9c58cdf5076a7e9caf3