method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-23-24"],"status":"unreviewed"},"source":{"sanskritLocator":"7023027","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5184dfad94b46e3c3ead6741a926624adb38d8d5a662e6d15092aca48bf26c8f","compact":"605652375c355553660d2fbf9acc265121fd33d957f273667efc08944cb3d4c9","nasal":"605652375c355553660d2fbf9acc265121fd33d957f273667efc08944cb3d4c9"}},{"id":"VRCE-7-23-28","kanda":7,"kandaId":"uttara","sarga":23,"verse":28,"english":"Seeing their own forces brought to straits in the conflict and driven back in the fight with networks of shafts, and down on the ground and seeing Rävaņa in Puspaka, Varuņa's sons swiftly shot into the welkin with their fleet-footing cars.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-23-24"],"status":"unreviewed"},"source":{"sanskritLocator":"7023028","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"63a1170bd1cd685a80ece335cf55479612807a95cf9dca0f7dae2a3e88f16c88","compact":"417f38e4dd7d31313f80744704387f5c100e53b3278791d9f4441db0ac49d5ef","nasal":"8ba7acfff1d0359e19cec3a43401a4478a5b096cb69bcc70e0c1fab38267a606"}},{"id":"VRCE-7-23-29","kanda":7,"kandaId":"uttara","sarga":23,"verse":29,"english":"After they had attained a station of equal vantage (with Ravana) in the sky,* great was the encounter that then took place in the sky, resembling the encounter of the deities and the Dānavas. *Ere the Rāvana was fighting on Puspaka, while Varuna's sons fought on the earth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-23-25"],"status":"unreviewed"},"source":{"sanskritLocator":"7023029","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d6329bae151d11ee50c9d751dcf96f2d572ca6546453ee100bc27b43173965c","compact":"059141275b5b32850dd1f1d1a8f14bf607cc57de3089d6