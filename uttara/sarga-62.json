shEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"94194dfd9f86664c1724c8a88517ca43b01cd60d38cb639a9a104e2b41a5f2cd","compact":"c7c223363c7db41e9076bc9dfa3dd387af0553d02d5f8f51480d2b3c6be961f5","nasal":"d0a09762626fe5fb437eee497a0f2357ce923d86f30659ff87303cecda5f2dc7"}},{"id":"VRCE-7-62-7","kanda":7,"kandaId":"uttara","sarga":62,"verse":7,"english":"The high-souled celestials having ascended the welkin saying this, the highly effulgent Śatrughna brought the soldiers there, that were encamped on the banks of the Gangā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-70-7"],"status":"unreviewed"},"source":{"sanskritLocator":"7062007","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e7dfa876af07bc1cd861411dfa7ecbb7d00a928feb8fe5dd4a13ef2e45bf5b9","compact":"778e09caf3eda27b5a9f16f5eaca4122f6bc9af975ace9f8cfa0dd3fa0df4866","nasal":"778e09caf3eda27b5a9f16f5eaca4122f6bc9af975ace9f8cfa0dd3fa0df4866"}},{"id":"VRCE-7-62-8","kanda":7,"kandaId":"uttara","sarga":62,"verse":8,"english":"When the soldiers arrived there on hearing the commands of Satrughna he engaged in making encampments in the month of Śrāvan.","alignment":{"type":"1:1","confidence":0.703,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-70-8"],"status":"unreviewed"},"source":{"sanskritLocator":"7062008","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a18cd424cb0f2ace3d5bd16fbd6a5b34cde4f02884489b400a113916c983458","compact":"7005d2409d5bba10e1f6be5292a6e604b386a7d3de082e4d71e80319f6ac7889","nasal":"7005d2409d5bba10e1f6be5292a6e604b386a7d3de082e4d71e80319f6ac7889"}},{"id":"VRCE-7-62-9","kanda":7,"kandaId":"uttara","sarga":62,"verse":9,"english":"In this wise the fearlessness of the celestial host, taking the shape of a country, that beautiful and picturesque city was reared in the course of twelve years. All the fields there were filled with 