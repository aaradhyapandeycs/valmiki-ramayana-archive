[{"id":"VRCE-7-62-1","kanda":7,"kandaId":"uttara","sarga":62,"verse":1,"english":"Lavana being slain the celestials headed by Agni and Indra said in sweet accents to Śatrughna the represser of enemies.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-70-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7062001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e2c83838794a861e0357a7629d7fcabc436d7ca36386272bb6e06c328c84b49","compact":"91178726e3356ae0de6624427a7af8aa274a18c4893b8aad17a72284b5fbf000","nasal":"653a838db91d7d4d4d9ee75869a9a295dac184a95d571327ad6dba82c6d1c741"}},{"id":"VRCE-7-62-2","kanda":7,"kandaId":"uttara","sarga":62,"verse":2,"english":"O child, fortunate it is that you have been crowned with success after slaying the Rākṣasa Lavaņa. Do you, therefore, O foremost of men, O you of firm vows, accept boons.","alignment":{"type":"1:1","confidence":0.927,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-70-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7062002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ba674781865a57ee29dfa3ef7a21284200fdad3ffe58356af7524e49179fbdae","compact":"0fead4929dfa1045fc33f470a29e5c2320603ab675802536e046dd448ff413c2","nasal":"0fead4929dfa1045fc33f470a29e5c2320603ab675802536e046dd448ff413c2"}},{"id":"VRCE-7-62-3","kanda":7,"kandaId":"uttara","sarga":62,"verse":3,"english":"O you having long arms, all those who can confer boons have arrived here; they all wish for your victory; seeing us does not go without fruits.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-70-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7062003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"823e970092760eb43b0ea271c04eb543bb7a37535d5e7aba6359743dc7bacf3c","compact":"14d034