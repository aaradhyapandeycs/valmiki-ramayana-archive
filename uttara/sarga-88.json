tt 1891–94"},"sanskrit_fingerprints":{"exact":"84db4fb33754c86bc3e7fe84bdce5f45fff1a8089949f22ebba2280761f96646","compact":"3d3366fcd08e4eda0e37de79e9cc1367cb9668158ed5cb494e298cc253ae6818","nasal":"e19badcf3bde6484707581f1963e600e9c5c40550b560bd33423582e36629821"}},{"id":"VRCE-7-88-14","kanda":7,"kandaId":"uttara","sarga":88,"verse":14,"english":"And while seated on the throne she was entering the earth, she was covered with the continued showers of celestial flowers.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-97-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7088014","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"789a202c537eabe97a1eac46138b7e93be67dfafb302497c7eaef18bea76f2ac","compact":"8d161b935bfbad8efa4ca59b1defb536d93c6d50f5b506b0ccb03d7fc696cd6a","nasal":"e1531bd9a098a28fc5c847aa961b961bdfd7c63206d41bf9416d844c6bd1fcea"}},{"id":"VRCE-7-88-15","kanda":7,"kandaId":"uttara","sarga":88,"verse":15,"english":"Eulogising her at that time, the celestials said: Oh! highly praiseworthy is your conduct, O Sītā. Being present in the welkin and beholding Sītā enter into the Earth, the celestials again and again eulogised her in various words.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-97-18"],"status":"unreviewed"},"source":{"sanskritLocator":"7088015","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d501da3e48334a9325727f794b505bef89adedb0f0bd90b3b0af0ef9df4dd6c","compact":"d858569a0e98e96f7bdd803c39820b34e9d904a556024d782495df5858f71c58","nasal":"35fa699d0dc2e3d1d6cb79dc8a277b40d8de87594f46a003302ac9e509831ac5"}},{"id":"VRCE-7-88-16","kanda":7,"kandaId":"uttara","sarga":88,"verse":16,"english":"Eulogising her at that time, the celestials said: Oh! highly praiseworthy is your conduct, O Sītā. Being present in the welkin and beholding Sītā enter