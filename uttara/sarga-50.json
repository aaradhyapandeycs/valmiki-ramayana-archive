[{"id":"VRCE-7-50-1","kanda":7,"kandaId":"uttara","sarga":50,"verse":1,"english":"Being thus requested by the high-souled Laks maņa, Sumantra began to reveal the mystery of Durbasa's account.","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7050001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02f3e3dd5e9df7b8fce8ff8e1c579a204d0f0d65b0c4b5c0be6533273ebbcd4a","compact":"041193e3f08d5ea69171043d031eaab28f813a806fcf1139d222033d8ff5110f","nasal":"041193e3f08d5ea69171043d031eaab28f813a806fcf1139d222033d8ff5110f"}},{"id":"VRCE-7-50-2","kanda":7,"kandaId":"uttara","sarga":50,"verse":2,"english":"In the days of yore the great ascetic Durbāsā, the son of Atri, resided for a year in the holy hermitage of Vasiştha.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7050002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d37db8f8f35af73973d9156f44e126e2711eae296fcfba6bb12967ad7769ee56","compact":"d72f7a8c4c73df563e8dc92fd67dab4eb35754a5aa767353f3340c0e109cc746","nasal":"d72f7a8c4c73df563e8dc92fd67dab4eb35754a5aa767353f3340c0e109cc746"}},{"id":"VRCE-7-50-3","kanda":7,"kandaId":"uttara","sarga":50,"verse":3,"english":"At that time your sire, the highly effulgent and illustrious Dasaratha, with a view to see his high-souled priest Vasistha, repaired there.","alignment":{"type":"1:1","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7050003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ddeefb43fde3cae30f497e3194e2e9d96ee29d7be6c9d8887c8ef4ab89da7d0f","compact":"744ff8d35dd580a0c656f0981db1d0c5cb94a45de1c7639d516d85ba8233ba37","nasal":"744ff8d35dd580a0c656f0981db1d0c5cb94a45de1c7639d516d85ba8233ba37"}},{"id":"VRCE-7-50-4","kanda":7,"kandaId":"uttara","sarga":50,"verse":4,"english":"He saw the great ascetic Durbásā, burning like the sun in his effulgence, seated on the right hand side of Vasiștha. Thereupon he humbly saluted those two leading ascetics.","alignment":{"type":"1:1","confidence":0.567,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-4"],"status":"unreviewed"},"source":{"sanskritLocator":"7050004","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"560d0c00fa71b734a3e6cd98a65baeadedc57b7664ad742f5046ad16f5ecad75","compact":"6d9a1a1aa5e676311faed76424107be41633a1f77c37e5a84a573a1553e7783a","nasal":"c50f0809f01bc0b38c9d25b9536b2e83ad86262272b44248b11bdb1058e29c6a"}},{"id":"VRCE-7-50-5","kanda":7,"kandaId":"uttara","sarga":50,"verse":5,"english":"And they too, welcoming him, received him duly with seat, water to wash feet, Arghya, fruits and roots, Then he lived there in the company of the ascetics.","alignment":{"type":"1:1","confidence":0.717,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-5"],"status":"unreviewed"},"source":{"sanskritLocator":"7050005","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"11a7b9d5d8465bf6dc1e59b732c1c5b4c6dca69796de24709d5a06e0ad1b5beb","compact":"18e34d1d4bec3339a551090de925ea3099d71b50c8f635f2b7de9227e34e433f","nasal":"18e34d1d4bec3339a551090de925ea3099d71b50c8f635f2b7de9227e34e433f"}},{"id":"VRCE-7-50-6","kanda":7,"kandaId":"uttara","sarga":50,"verse":6,"english":"Thereupon during the noon, all those ascetics, seated there, began to dwell upon various pleasant topics.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7050006","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ae9bda7384f