":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"855666b5351a53a178eee8d5afecd4eb32e8fe18173b2dbc598f0252b9ce2e49","compact":"e2539692b51fccd4c9f509ca1fdceb1f7c58c3f45dd5c5608d804ebc726ccb8a","nasal":"e2539692b51fccd4c9f509ca1fdceb1f7c58c3f45dd5c5608d804ebc726ccb8a"}},{"id":"VRCE-7-50-10","kanda":7,"kandaId":"uttara","sarga":50,"verse":10,"english":"Hearing the words of the king Dasaratha the highly effulgent Durbāsā replied.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7050010","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6d34d5ed659a28df9ce6d79850e0d12ee8ec1a8cb728d794bc94bf3356f4559f","compact":"2b06395876152ab2531fd330231311db4039b964d12e8a3c55757b969e89d60b","nasal":"2b06395876152ab2531fd330231311db4039b964d12e8a3c55757b969e89d60b"}},{"id":"VRCE-7-50-11","kanda":7,"kandaId":"uttara","sarga":50,"verse":11,"english":"O conferer of honours, for sooth shall Rāma partake of the fruits of Bhrgu's curse. He shall reign in Ayodhyā for a long time. All his followers shall be happy and prosperous. Having reigned for eleven thousand years Rāma shall repair to the region of Brahmă.","alignment":{"type":"split","confidence":0.409,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-17","DUTT-7-51-18"],"status":"unreviewed"},"source":{"sanskritLocator":"7050011","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"daee1ad9213b8790e525e4cb971eb0eaf141820aeb73340b7ea537cb22a6b586","compact":"6b9a962efa1cc830616d18673a79252fea66e961b79d52314ff8577210dced91","nasal":"a6285781b7262516271fec0d71b72e0a08ce5850a7ba461ffe30bd5407ead659"}},{"id":"VRCE-7-50-12","kanda":7,"kandaId":"uttara","sarga":50,"verse":12,"english":"Rāma shall be deprived of all happiness and be separated from his dear wife; what more, the virtuous-souled Rāma, having long arms, shall, under the influence of time, renounce you, Sītā, Śatrughna and Bharata.","alignment":{"type":"grouped","confidence":0.318,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-50-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7050012","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"291a894a6f0db5bdcb481c64a5b5ecf5b2ad516daae9cf5ef0f6d8e9afd99fc4","compact":"c52be092ba44fb8a8e1fd179dfe5775d70a072aa35c246c0cbda6b5840864e69","nasal":"c52be092ba44fb8a8e1fd179dfe5775d70a072aa35c246c0cbda6b5840864e69"}},{"id":"VRCE-7-50-13","kanda":7,"kandaId":"uttara","sarga":50,"verse":13,"english":"All his followers shall be happy and prosperous. Having reigned for eleven thousand years Rāma shall repair to the region of Brahmă.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-18"],"status":"unreviewed"},"source":{"sanskritLocator":"7050013","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7238f0deee5f488211eb89c874bb134fb6e2c316f88df342f84d5a518d52b0c6","compact":"4258ccdbd7729cc51bddf72b0142d36d612b6e6060ee2d546b6d824584048867","nasal":"4258ccdbd7729cc51bddf72b0142d36d612b6e6060ee2d546b6d824584048867"}},{"id":"VRCE-7-50-14","kanda":7,"kandaId":"uttara","sarga":50,"verse":14,"english":"None shall be able to vanquish him. He shall celebrate many a horse-sacrifice with profuse gifts and shall establish many royal families.","alignment":{"type":"1:1","confidence":0.433,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-19"],"status":"unreviewed"},"source":{"sanskritLocator":"7050014","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"40295072fdc66a61d1fc5473ad0117779761b4742dd192cd57c18ff07905062b","compact":"96bc6253b74b9973e16c4f71b897d29ab7a652314cfa6968119e7ae74f54196a","nasal":"96bc6253b74b9973e16c4f71b897d29ab7a652314cfa6968119e7ae74f54196a"}},{"id":"VRCE-7-50-15","kanda":7,"kandaId":"uttara","sarga":50,"verse":15,"english":"He shall beget on Sită two sorts. Having thus related to Dasaratha the past and future of his family the highly effulgent great ascetic Durbāsā became silent.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-20"],"status":"unreviewed"},"source":{"sanskritLocator":"7050015","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d99301d53d2ff084ee6959e0306e561572ef8e27f6cf3ee1229d6fbb827fedc3","compact":"290e15da02c1caca0f3d1d5f8570b388260ba27b417ce498ff1cc088d46c71c1","nasal":"290e15da02c1caca0f3d1d5f8570b388260ba27b417ce498ff1cc088d46c71c1"}},{"id":"VRCE-7-50-16","kanda":7,"kandaId":"uttara","sarga":50,"verse":16,"english":"He being silent-the great king Dasaratha, having bowed to the two high-souled ascetics, again returned to his city Ayodhyā.","alignment":{"type":"1:1","confidence":0.469,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-21"],"status":"unreviewed"},"source":{"sanskritLocator":"7050016","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"074b139022865543acc5f81fa492101792c9718c9ae9ed0eb6045ce7b8401514","compact":"969e3a14945a9b35cef12e18b92bec7b2f4c11338caa258ab9954dfab39ae161","nasal":"969e3a14945a9b35cef12e18b92bec7b2f4c11338caa258ab9954dfab39ae161"}},{"id":"VRCE-7-50-17","kanda":7,"kandaId":"uttara","sarga":50,"verse":17,"english":"I had heard there all there words of the great ascetic Durbāså. Up to this time they are lying in my heart. Rsis' words shall never prove fruitless.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-51-22"],"status":"unreviewed"},"source":{"sanskritLocator":"7050017","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bfdbcf4fa081d246a96171c184cf867fa27140928570fba6cad7f3b975425d44","compa