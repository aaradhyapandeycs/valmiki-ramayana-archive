[{"id":"VRCE-7-92-1","kanda":7,"kandaId":"uttara","sarga":92,"verse":1,"english":"Hearing the wonderful words of Bharata both Rāma and Lakşmaņa were greatly delighted. And then Rāma said to Lakşmaņa.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-102-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7092001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de25c67d188993f153608e74090e27161d89e477d03c3677cce339f49194a15b","compact":"809c7489b56ca5f3374447ce1262239eb57036fc41f4eac786d7223d11981bd0","nasal":"809c7489b56ca5f3374447ce1262239eb57036fc41f4eac786d7223d11981bd0"}},{"id":"VRCE-7-92-2","kanda":7,"kandaId":"uttara","sarga":92,"verse":2,"english":"O Saumitri, your two sons, Angada and Candraketu well-versed in religions, perfectly qualified in governing the kingdom and highly powerful.","alignment":{"type":"1:1","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-102-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7092002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"33099f3735ba81d08079a3d9e8f3d50f2985bbd45949df462d62146ea41e8085","compact":"78bb222fef895080964157b1f3b67b4940b2b0d5679358b5f9865d4ee9b77e62","nasal":"dd8c68f609d48229eb2167ce06528b99fbb3ac32f9b2fee1eb90419f351d70ad"}},{"id":"VRCE-7-92-3","kanda":7,"kandaId":"uttara","sarga":92,"verse":3,"english":"I shall therefore install them on throne. O gentle man, do you find out such country where those two skilful archers may unobstructed roam about.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-102-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7092003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a17397a080366ebdf588f977c60aea781ca71900768da549e8fcf09e77a16e86","compact":"7f2df57d68091c6ee7881f4900433eea6