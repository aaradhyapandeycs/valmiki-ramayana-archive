imate","confidence":0.14,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-23-48"],"status":"unreviewed"},"source":{"sanskritLocator":"7011039","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"918f5e6bf21db865f96d3d1aede460b517e7194d6f13f83d687ea872c99fe23a","compact":"42d074e03f65b05570a4bb77a0affbd6b40d32199c386492b015c7af0a96c2c0","nasal":"d67ee014b77f43a346372c4f6873eba01a5c823313538bb2d3dc50aaf2c477d6"}},{"id":"VRCE-7-11-40","kanda":7,"kandaId":"uttara","sarga":11,"verse":40,"english":"Having been installed, that night-ranger the Ten-faced one dwelt in that city; and that city teemed with night-rangers resembling dark clouds.","alignment":{"type":"1:1","confidence":0.904,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-11-39"],"status":"unreviewed"},"source":{"sanskritLocator":"7011040","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"21620db4917a85b62889aec633eb44303153c0344463f2bd1338b7495fab540f","compact":"d0f9d536cd34bf4aab100a0c9ea03d3eed2b09863dad7a3d483713565c47d3b6","nasal":"d0f9d536cd34bf4aab100a0c9ea03d3eed2b09863dad7a3d483713565c47d3b6"}},{"id":"VRCE-7-11-41","kanda":7,"kandaId":"uttara","sarga":11,"verse":41,"english":"The lord of riches, for the sake of his father's dignity, dwelt in a palace situated on the hill bright as moon-light, graced with ornamented superb piles; even as Purandara dwells in Amaravati.","alignment":{"type":"1:1","confidence":0.535,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-11-40"],"status":"unreviewed"},"source":{"sanskritLocator":"7011041","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"36923ee321019f769f3ab0f0e07824c18a81e9007eb8a0c0f65342153fd66928","compact":"a70bb9435c39bb378287276bc08fea605c7fc09cf015b1e5182cd85eb5df0661","nasal":"c3510c5e9536bf5351bef9aaedcc2a9f86e5708e929e5a81b4bb07cfd63e1c66"}}]
