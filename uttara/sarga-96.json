[{"id":"VRCE-7-96-1","kanda":7,"kandaId":"uttara","sarga":96,"verse":1,"english":"There upon beholding Räma with his head downwards and poorly like to the moon possessed by Rāhu, Lakşmaņa, delightedly and with sweet words, said.","alignment":{"type":"1:1","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-106-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7096001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de8f2d3ffd3fc1b718b9ef5457f8250fde7bc75e3a1f8cfac308a4b01d94c94e","compact":"bd75d0469034f88e00ff6cd8772ebdcc45d9923c6b1497e16bbc563ca239184f","nasal":"bd75d0469034f88e00ff6cd8772ebdcc45d9923c6b1497e16bbc563ca239184f"}},{"id":"VRCE-7-96-2","kanda":7,"kandaId":"uttara","sarga":96,"verse":2,"english":"Be not aggrieved for me, O you having mighty' arms. Such is the course of time; the movements of creatures are destined by their pristine actions, good or bad.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-106-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7096002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"63fe6ac79b50baca996740d3607cd7db5bc1d6162f1ec2fda639c98afaaf0414","compact":"a5fe092292d8815596cb0866a903d31dc517a2544e6a81706adf89646ee0d66f","nasal":"a5fe092292d8815596cb0866a903d31dc517a2544e6a81706adf89646ee0d66f"}},{"id":"VRCE-7-96-3","kanda":7,"kandaId":"uttara","sarga":96,"verse":3,"english":"O gentle one, do you satisfy your promise of slaying me without any hesitation. O Kakuthstha, those, who cannot carry out their promises, repair to hell.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-106-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7096003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b93996816b3c0657d1f147ea503ca35e8dd70758e3c64c4052a