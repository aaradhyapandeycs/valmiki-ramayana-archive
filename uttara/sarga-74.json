[{"id":"VRCE-7-74-1","kanda":7,"kandaId":"uttara","sarga":74,"verse":1,"english":"According to the command of Räma of unwearied actions, the warders went to the princes and communicated to them (the arrival).","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-83-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7074001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ae87848ceb89ade6e783cdf485a46955fa5820921fcc0d7b7f51ed767ddbad7","compact":"dd1b13c1ab4455c7889515f7ed7c660b261b9a082a27779cf05bdcdf0a93a61a","nasal":"dd1b13c1ab4455c7889515f7ed7c660b261b9a082a27779cf05bdcdf0a93a61a"}},{"id":"VRCE-7-74-2","kanda":7,"kandaId":"uttara","sarga":74,"verse":2,"english":"Beholding Bharata and Lakşmaņa present, Rāma embraced them and said.","alignment":{"type":"1:1","confidence":0.794,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-83-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7074002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"803e1e508e10a0bbfdb2cb4054f666ba7db701fc0bdb9a6a1145db99674d0b64","compact":"527ef70a0a3cd4b4afa7c54ef0510bf16b6e7c1a2f1982c4460850d1b32f791b","nasal":"527ef70a0a3cd4b4afa7c54ef0510bf16b6e7c1a2f1982c4460850d1b32f791b"}},{"id":"VRCE-7-74-3","kanda":7,"kandaId":"uttara","sarga":74,"verse":3,"english":"I have, as promised, performed the work of the excellent twice-born one. I wish now to perform a Rājasūya sacrifice, the source of religious glory, the destroyer of all sins, inexhaustible and un-ending.","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-83-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7074003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"353f97bcb66a874b7f5cd56f688c1e8a59302d6ab4ed1f6507983d395d9be612","compact":"41e7582c14b3d49a5c565a5d4d60b84a6f2e3e