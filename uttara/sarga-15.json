[{"id":"VRCE-7-15-1","kanda":7,"kandaId":"uttara","sarga":15,"verse":1,"english":"And snapping those weapons and resisting (those volleys of) arms, they smote at the Räkșasa fighting alone by hundreds and thousands.","alignment":{"type":"approximate","confidence":0.523,"method":"fuzzy-nearby-witness","duttRefs":["DUTT-7-21-23"],"status":"unreviewed"},"source":{"sanskritLocator":"7015001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7f59467910c0988661c652c558ca1358236b3f67bfd3ec22cd2f448cabc53948","compact":"de7079ff0658cc41a23e5a066bea5bd0afa7745c17aa31ce6af70b315e50c3af","nasal":"2e75fa4a4ac7f6da12df9f496b68a3b5e661921a7a34e09f08890b75ad6b279f"}},{"id":"VRCE-7-15-2","kanda":7,"kandaId":"uttara","sarga":15,"verse":2,"english":"Thus addressed, the mighty-armed and invincible Mānibhadra, surrounded by four thousand Yakşas began the fight.","alignment":{"type":"1:1","confidence":0.4,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-15-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7015002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d4ae187813527610e5d672c0584fd39e6115ce2aee9d51113e945f031ff22df9","compact":"76f8629d2acf275c33c28fd796a45fb6769c6431d76d26f3a9e52cd12bed7063","nasal":"76f8629d2acf275c33c28fd796a45fb6769c6431d76d26f3a9e52cd12bed7063"}},{"id":"VRCE-7-15-3","kanda":7,"kandaId":"uttara","sarga":15,"verse":3,"english":"And attacking the Rākşasas with maces and clubs and bearded darts, and with darts tomoras and bludgeons, the Yaksas rushed at (their adversaries).","alignment":{"type":"1:1","confidence":0.525,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-15-4"],"status":"unreviewed"},"source":{"sanskritLocator":"7015003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"08c9222238cd81731fd3e24a3eadbf7c6071ef4fadde40ae6fc4f75573430263","compact":"4b2d478e57f362156daab42ae9df39f9d4ed9b1