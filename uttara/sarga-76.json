[{"id":"VRCE-7-76-1","kanda":7,"kandaId":"uttara","sarga":76,"verse":1,"english":"Hearing the words of Laksmana, Rama, the slayer of enemies, said:-0 you of firm vows, do you at length, describe the destruction of Vrtra.","alignment":{"type":"1:1","confidence":0.866,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-85-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7076001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dd7d430a92f5f005a2d719cda9f26c39da53c9593990f5e3a5c9a57dcd6d1e3f","compact":"d3a9595f9c7764fe9e0c8c5809f31e1859f5388a079967e1628cf370bc35f225","nasal":"d3a9595f9c7764fe9e0c8c5809f31e1859f5388a079967e1628cf370bc35f225"}},{"id":"VRCE-7-76-2","kanda":7,"kandaId":"uttara","sarga":76,"verse":2,"english":"Hearing the words of Rāghava, Lakşmaņa, the enhancer of Sumitra's delight, again took up that theme.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-85-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7076002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7386e971677d7359f809e144a6d0d71eeae5de57056674af1889ebb03a55cd09","compact":"2d969c041723bcd024d2c8359bd60942ac4769ffe9c95eb2925bd771c04771a3","nasal":"b62b17dbadac9cae32d6fc1a36a646cd55970cfc9d31c2cccc5b002a5a7b625f"}},{"id":"VRCE-7-76-3","kanda":7,"kandaId":"uttara","sarga":76,"verse":3,"english":"Hearing the words of Indra and other deities Visnu replied.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-85-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7076003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"76e49873725404a5c8b8968e43ac2ca4da1aa47f1b54033570a1bd85d3a826b5","compact":"1caf03a3dc8f1fb2bbf7a9a5570111523d798633640327522088812d4e76c0e0","nasal":"b40da71a00f33a7626b3bde3da109acab2a9c36781b95e3c599cfaece581a604"}},{"id":"VRCE-7-76-4","kanda":7,"kandaId":"uttara","sarga":76,"verse":4,"english":"From before I am bound with the high-souled Vrtra by the ties of friendship. For this, even for your satisfaction, I shall not (myself) slay him.","alignment":{"type":"1:1","confidence":0.657,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-85-4"],"status":"unreviewed"},"source":{"sanskritLocator":"7076004","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5bdc9a60a2dc854950cc09d3b1c017871c4114b6acd9c0898af8a0d43754a412","compact":"8af52a1b2a3fe2b3164e77380bd29c184b88222f1b13c2bc115c99ca20e2df10","nasal":"8af52a1b2a3fe2b3164e77380bd29c184b88222f1b13c2bc115c99ca20e2df10"}},{"id":"VRCE-7-76-5","kanda":7,"kandaId":"uttara","sarga":76,"verse":5,"english":"Again I am to afford excellent felicity to you. I shall say the solution by which Indra will able to slay him.","alignment":{"type":"1:1","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-85-5"],"status":"unreviewed"},"source":{"sanskritLocator":"7076005","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"efbadb32d347e58e7938863f94232e43756faf30ceae39290a5853be3f97f84b","compact":"a7f5e1910d4fbcacc3b8c9d1d3b6dd279443a394194e6d529f068a1196aac6ee","nasal":"a7f5e1910d4fbcacc3b8c9d1d3b6dd279443a394194e6d529f068a1196aac6ee"}},{"id":"VRCE-7-76-6","kanda":7,"kandaId":"uttara","sarga":76,"verse":6,"english":"I shall myself divide you into three classes and then forsooth your king shall be able to destroy Vrtra.","alignment":{"type":"1:1","confidence":0.613,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-85-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7076006","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"53566c1351f7f6e293dde4a0214b4f99f30464b6557b35d005634b348c173e71","compact":"ddf575d10967eb469e5fbff2a5e6394e1bf5cd0ab26117695ce005991a879633","nasal