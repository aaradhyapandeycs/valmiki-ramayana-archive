7.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c72557b3fd2a243383ea56d6f8ec5f87cf6756f082199e664dfd307c1b784215","compact":"9046803af1421d1346a9cf4f3417fdc8cc395e4753287174c2863bd9eb9942f2","nasal":"dcd447bf36daa90cf80d0d03dd7935589b97027ff4cecacc3a960ff503739d3f"}},{"id":"VRCE-7-26-31","kanda":7,"kandaId":"uttara","sarga":26,"verse":31,"english":"Having said this, the Raksasa ravished her. Being released from his grasp Rambhā became divested of her ornaments and garland and became like the river agitated by the elephants. Her hairs were dishevelled and her hands were trembling. Like to a blossoming creeper shaken by the wind, she, trembling and bashful and with folded hands, went to Nalakubara and fell down at his feet.","alignment":{"type":"split","confidence":0.468,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-26-31","DUTT-7-26-32"],"status":"unreviewed"},"source":{"sanskritLocator":"7026031","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5682b02fd0e50b0e081d479fe4ca19a88b7aac983b8a03c94e07eb78bf444a48","compact":"60af78e1b16aeafdba5723adeff825460ffb5c02051c29ec1f2595c66b397907","nasal":"ff734cba73dc8094eec2ef67e541b544ecd4dddd0f5fe796fd657dd14619f619"}},{"id":"VRCE-7-26-32","kanda":7,"kandaId":"uttara","sarga":26,"verse":32,"english":"Her hairs were dishevelled and her hands were trembling. Like to a blossoming creeper shaken by the wind, she, trembling and bashful and with folded hands, went to Nalakubara and fell down at his feet.","alignment":{"type":"grouped","confidence":0.83,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-26-32"],"status":"unreviewed"},"source":{"sanskritLocator":"7026032","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b97b657357eaf2bf62aeb331a6582d4b07af1e05d8f0b5d3c8be8449b60e2651","compact":"3a51c918668eed42409133abaeb70dd04235525d83642cc15ae17565a9d21679","nasal":"3555514d1530887d60db54c