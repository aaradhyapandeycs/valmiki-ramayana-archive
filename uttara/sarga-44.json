[{"id":"VRCE-7-44-1","kanda":7,"kandaId":"uttara","sarga":44,"verse":1,"english":"The princes were all waiting with a poorly heart when Rama, with a dried countenance, addressed them, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-45-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7044001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"89aa7fa47d1fb68f232e582ea0816438609a719000ce226ba3f253f39ec49222","compact":"e345d2a61b6412c6c904602748bd5b0c96e3ffed8351ba06f872ed3aa455e2b4","nasal":"e345d2a61b6412c6c904602748bd5b0c96e3ffed8351ba06f872ed3aa455e2b4"}},{"id":"VRCE-7-44-2","kanda":7,"kandaId":"uttara","sarga":44,"verse":2,"english":"May good betide you-do not act against my desire. Hear, what the citizens have been talking about me and Sītā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-45-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7044002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f99dfd7fb5c96aa1547abe379f246224b675033c1755115e8a59aba7dfa3d53f","compact":"5bb7713d1bd93a2da5219af1752af2a06c771d33ed5eb835e73d42d3893aa1d8","nasal":"5bb7713d1bd93a2da5219af1752af2a06c771d33ed5eb835e73d42d3893aa1d8"}},{"id":"VRCE-7-44-3","kanda":7,"kandaId":"uttara","sarga":44,"verse":3,"english":"The citizens as well as the inhabitants of provinces have been showering censures upon me. I have been pierced to the very vitals by those accusations.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-45-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7044003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7009abed3ae25bb32e97ee94438759f53e73211a9851f985761677131ddbf553","compact":"47c521b913cd8d9a19ce009fe68ca5d951176b832db8ea954b10b2699e061e7e","na