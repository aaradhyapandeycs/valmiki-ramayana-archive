grouped","confidence":0.522,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-7-16"],"status":"unreviewed"},"source":{"sanskritLocator":"7007018","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3960419ab8366bb95dabf52e8f23b2fc1559861f37c664023e3c3e898b99a2b5","compact":"82ba91f38a8a3787678627699cf8daf28a4e18c7523d9cb12c220d1c9a18105f","nasal":"cd3c2bd1def8d2935991c153782498e0a2bce998a9b87c605ad5061f7501e08d"}},{"id":"VRCE-7-7-19","kanda":7,"kandaId":"uttara","sarga":7,"verse":19,"english":"Even as an elephant pursuits a tiger, a tiger a wolf, a wolf a dog, a dog a cat, a cat a snake, or a snake a rat, so the mighty Vişnu pursuit the Rākșasa host; and others, (struck down by him), measure their lengths on the ground.","alignment":{"type":"grouped","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-7-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7007019","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f51b0fef34efe1e3c742215d158dfe8ab5367a9fc155a148015bdce19745e758","compact":"7eb70d567a0cbe5386bbcece2fea4ec73982421c31ba8f022e5142b4f5c4f843","nasal":"7eb70d567a0cbe5386bbcece2fea4ec73982421c31ba8f022e5142b4f5c4f843"}},{"id":"VRCE-7-7-20","kanda":7,"kandaId":"uttara","sarga":7,"verse":20,"english":"Even as an elephant pursuits a tiger, a tiger a wolf, a wolf a dog, a dog a cat, a cat a snake, or a snake a rat, so the mighty Vişnu pursuit the Rākșasa host; and others, (struck down by him), measure their lengths on the ground.","alignment":{"type":"grouped","confidence":0.517,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-7-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7007020","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c0422fa937a2dc23cf10fe473137a19c0428e9064e77d00c0022eca798a9c5b","compact":"3948429e0824aa79bb8febc8ae9491fc22b548cbc1fe7a2651a3ba2d54ab73a3","n