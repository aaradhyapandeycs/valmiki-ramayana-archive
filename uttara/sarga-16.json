[{"id":"VRCE-7-16-1","kanda":7,"kandaId":"uttara","sarga":16,"verse":1,"english":"O Rāma, having, vanquished his brother, the lord of riches, the king of Räkşasas went to the great wood of reeds, where Mahasena was born.","alignment":{"type":"grouped","confidence":0.442,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-16-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7016001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e183e6375e36d9c78054b1c4d453d57fc2c64cf41948af91c98769d36bb302e5","compact":"1e60d11433783b2632c7a7250fa693ca45fa03ba7199ecd525ee7695ed60d5d9","nasal":"1e60d11433783b2632c7a7250fa693ca45fa03ba7199ecd525ee7695ed60d5d9"}},{"id":"VRCE-7-16-2","kanda":7,"kandaId":"uttara","sarga":16,"verse":2,"english":"The Ten-necked Rāvana saw the great golden wood of reeds. Furnished with networks of solar rays, and appearing like a second Sun, and ascending the mountain, he was surveying the heart of the forest, when, O Rama, Puspaka was (suddenly) deprived of its motion.","alignment":{"type":"grouped","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-16-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7016002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d4c53dc101429ce4726e396687ab54ca4b339126b2cbca53ef165221710af433","compact":"08b0f19146c4c53a8330ec33273ad68140b047a11a73f3a5d5050e32926ca415","nasal":"08b0f19146c4c53a8330ec33273ad68140b047a11a73f3a5d5050e32926ca415"}},{"id":"VRCE-7-16-3","kanda":7,"kandaId":"uttara","sarga":16,"verse":3,"english":"The Ten-necked Rāvana saw the great golden wood of reeds. Furnished with networks of solar rays, and appearing like a second Sun, and ascending the mountain, he was surveying the heart of the forest, when, O Rama, Puspaka was (suddenly) deprived of its motion.","alignment":{"type":"grouped","confidence":0.453,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-16-2"],"st