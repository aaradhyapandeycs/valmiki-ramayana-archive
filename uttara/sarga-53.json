1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-61-22"],"status":"unreviewed"},"source":{"sanskritLocator":"7053023","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"52875ccdf1bfb809c5074332bc65775ca2a0ff44cb0a84cef5388efb2e5141e4","compact":"37d9a0817007d5d61ba3ab0365b869a9eacaaa60e89e2a404e59da5d98ac91cf","nasal":"37d9a0817007d5d61ba3ab0365b869a9eacaaa60e89e2a404e59da5d98ac91cf"}}]
