[{"id":"VRCE-7-2-1","kanda":7,"kandaId":"uttara","sarga":2,"verse":1,"english":"Hearing those words of Rāghva, the exceedingly energetic Kumbhayoni spoke as follows.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7002001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29f49cf86453f341223562efa72221628bd1cf80da4cadf6130ae018aa68b253","compact":"c01a1e530904adb4afc31a6609b471b5785d3b74e472e8de374bb2140b9e335c","nasal":"b28b4f003d49e583eec6c0dc72eb471e2627c0af7ae5ece88102233614abc54a"}},{"id":"VRCE-7-2-2","kanda":7,"kandaId":"uttara","sarga":2,"verse":2,"english":"Having regard to his (Indrajit's) energy and might, I shall relate to you the history of his race, in the light of which you will perceive why Rāvana's son had been capable of slaying his enemies, but could not himself be slain by them.","alignment":{"type":"approximate","confidence":0.213,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7002002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bc253575ba2ac1fcf6c61ab0d1f56c07c6abb0e1d016650e18974bb1c2be644e","compact":"a330017f4a427839c0cae7a5a27ab8c267f8c1c7e797b79b17891294986ac753","nasal":"a330017f4a427839c0cae7a5a27ab8c267f8c1c7e797b79b17891294986ac753"}},{"id":"VRCE-7-2-3","kanda":7,"kandaId":"uttara","sarga":2,"verse":3,"english":"I shall, O Rāghava, describe to you Răvaņa's race and birth, as well as the boon that had been conferred on him.","alignment":{"type":"1:1","confidence":0.943,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7002003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62c3a75dd8fbdd308662c9b77911e2403c08982f060436daa3d473a8acd08565","compact":"e17a5