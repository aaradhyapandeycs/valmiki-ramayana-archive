erprints":{"exact":"c647472d52cf6b327d53f448ea0394a7fe01a33b7f2c125c91a3b3c06ef4871d","compact":"41787d575f2812a9237aa6b2b859a29b03a9e5c6e5e73e61dcb983ba7115be33","nasal":"41787d575f2812a9237aa6b2b859a29b03a9e5c6e5e73e61dcb983ba7115be33"}},{"id":"VRCE-7-2-25","kanda":7,"kandaId":"uttara","sarga":2,"verse":25,"english":"Having given away his daughter, the king went (back) to his asylum; and the girl stayed there, gratifying her husband with her virtues. And that best of ascetics was gratified with her character and behaviour. And well pleased (with her), that highly energetic one said.","alignment":{"type":"split","confidence":0.433,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-24","DUTT-7-2-25"],"status":"unreviewed"},"source":{"sanskritLocator":"7002025","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b0fb330ab50c902c37dd45b1ab3e1b002d1378b9166017b9229488c266b800eb","compact":"468b6e17c0ccd21563da68cd0bd4dc9e77c8300d4bac1c8e6ab856800e49ee96","nasal":"5a896aba80b1ce76c4f5720fc7f9f887064a1080a2373f0c59725467d7f29572"}},{"id":"VRCE-7-2-26","kanda":7,"kandaId":"uttara","sarga":2,"verse":26,"english":"'O you of shapely hips, well-pleased am I with you with your wealth of worth, and therefore, O exalted one, I will today confer on you a son like to yourself, who will perpetuate both the lines*-being celebrated as Paulastya. *(i.e. maternal and paternal lines.)","alignment":{"type":"1:1","confidence":0.548,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-26"],"status":"unreviewed"},"source":{"sanskritLocator":"7002026","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"21dfc7a9502529597fb14c60ee4b14cae03c8bb378b16d0962547b9f86d621cb","compact":"e531e8bf2b3cc76b0f716c82a9658bedfcc9fb7187478106e27b37d64b23d360","nasal":"e531e8bf2b3cc76b0f716c82a9658bedfcc9fb7187478106e27b37d64b23d360"}},{"id":"VRCE-7-2-27","kanda":7,"kandaId":"uttara","sarga":2,"verse":27,"english":"And as you had heard the Veda recited by me, so, without doubt, he shall be named Visravā.* *(From the root, Śru-to hear.)","alignment":{"type":"1:1","confidence":0.812,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-27"],"status":"unreviewed"},"source":{"sanskritLocator":"7002027","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a7ac57d74dcee119e1c6e1bd682974667241c4e906d6493494bea37f9d064baf","compact":"1728d3fef0cca4b29dcac3d41fe913becdd801232d00bd3702203bbcf4c97ab7","nasal":"1728d3fef0cca4b29dcac3d41fe913becdd801232d00bd3702203bbcf4c97ab7"}},{"id":"VRCE-7-2-28","kanda":7,"kandaId":"uttara","sarga":2,"verse":28,"english":"Thus addressed, that noble damsel with her soul wrought with delight, in a short time brought forth her son Visravā, famed over the three worlds and furnished with virtue and fame: versed in the Vedas, of an impartial spirit, and ever engaged in observing vows. And the ascetic, Viśravă, was furnished with asceticism even like his sire. ever","alignment":{"type":"grouped","confidence":0.623,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-2-28"],"status":"unreviewed"},"source":{"sanskritLocator":"7002028","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ffac861a76e103aa566d6b41e1de85288a826df42f8db292f6b3f4598fccbdea","compact":"156533ca45f58680d03667d111ba2ed822fa1fdaf8b3896cb1ed6a08d9dc066c","nasal":"9c0689bb987cfd572ddd4a4adb91116a94eb06ec4e1a0a6191ea810b95985e19"}},{"id":"VRCE-7-2-29","kanda":7,"kandaId":"uttara","sarga":2,"verse":29,"english":"Thus addressed, that noble damsel with her soul wrought with delight, in a short time brought forth her son Visravā, famed over the three worlds and furnished with virtue and fame: versed in the Vedas, of an impartial spirit, and ever engaged in observing vows. And the ascetic, Viśravă, was furnished with asceticism even like his sire. ever","alignment":{"type":"grouped","confidence":