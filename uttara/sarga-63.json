-72-17"],"status":"unreviewed"},"source":{"sanskritLocator":"7063016","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a72c74acbc903e4b857aa21f4e864daa0367456ecc9973d0760357a03d21cd2a","compact":"88c37d1fee144951c638497baca5199b64c21bdad75f4da50875a75eac170833","nasal":"27c099443b293de19278b078fa1d3f0e2a246909a6e0f30d4860a10feafbb9c4"}},{"id":"VRCE-7-63-17","kanda":7,"kandaId":"uttara","sarga":63,"verse":17,"english":"The high-souled Lakşmaņa and slayer of enemies Bharata followed him on foot for some distance.","alignment":{"type":"1:1","confidence":0.893,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-72-18"],"status":"unreviewed"},"source":{"sanskritLocator":"7063017","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"538c0cd9bfec68b3a61df8db242a48e509dfd4dfe7e5e5424ba570153bfe5ae0","compact":"4ed7f8ebcf0336364b9c2577d9ab30b8569597afd6b1cedc896f3287641b3ae2","nasal":"4ed7f8ebcf0336364b9c2577d9ab30b8569597afd6b1cedc896f3287641b3ae2"}}]
