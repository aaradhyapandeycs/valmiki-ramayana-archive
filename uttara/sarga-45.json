[{"id":"VRCE-7-45-1","kanda":7,"kandaId":"uttara","sarga":45,"verse":1,"english":"The night being over, Lakṣmaṇa, with a poor heart and dried countenance, addressed Sumantra, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-46-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7045001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"231b4189f2965c62da2f97570b3bc163733937b8bf39862b78220917bcd49c6a","compact":"51d0a929d133f5a21b2e25993e9c3b8deaeb78c4c0269c649d85223aef6f2619","nasal":"9f61809981c0c8e8d1a4e5d581d4dad954e5b5628b4eeaab8bacb5da6fa7ee01"}},{"id":"VRCE-7-45-2","kanda":7,"kandaId":"uttara","sarga":45,"verse":2,"english":"O charioteer, do you soon yoke quick coursing steeds to an excellent chariot, and for Sītā place an excellent seat on the car. At the command of the King, I shall take Sītā to the hermitage of the ascetics ever engaged in pious actions. Do you soon bring the chariot here.","alignment":{"type":"grouped","confidence":0.631,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-46-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7045002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dd6f14ab8dada18dadfd80624ad8efa6ee1ae80445ca7211d078ce48924d5317","compact":"5f4849ddbd3d58a16f47e86c5727d723d192a13f0a7b955dbadd4e3b8b89196f","nasal":"5f4849ddbd3d58a16f47e86c5727d723d192a13f0a7b955dbadd4e3b8b89196f"}},{"id":"VRCE-7-45-3","kanda":7,"kandaId":"uttara","sarga":45,"verse":3,"english":"O charioteer, do you soon yoke quick coursing steeds to an excellent chariot, and for Sītā place an excellent seat on the car. At the command of the King, I shall take Sītā to the hermitage of the ascetics ever engaged in pious actions. Do you soon bring the chariot here.","alignment":{"type":"grouped","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-46-2"],"status":"unreviewed"},