[{"id":"VRCE-7-97-1","kanda":7,"kandaId":"uttara","sarga":97,"verse":1,"english":"Having forsaken Lakşmaņa and being stricken with sorrow and grief Råma said to his citizens and ministers.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7097001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ca0f4520913c9ea8051aa3e67448097785af000b9fcfa8cc7eed51c8f6b19db","compact":"e5bb4f01d9df52d21dda56823d19a694589ee11c57076ab9eff2090b8c5b7cde","nasal":"772bd4694786c135c30b555587fadafd10a2b34979e930a4c1930c3321759ff2"}},{"id":"VRCE-7-97-2","kanda":7,"kandaId":"uttara","sarga":97,"verse":2,"english":"Having placed the pious and heroic Bharata on the throne of Ayodhyā I shall today repair to woods.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7097002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"057cd735c21b2766a5e11d76606c6905ec79dfc6e5776b26148738b69d04714d","compact":"7692afd9edfa6a71f361c50206d88fb7c7c94f32b700bbe44763254d27860bd0","nasal":"7692afd9edfa6a71f361c50206d88fb7c7c94f32b700bbe44763254d27860bd0"}},{"id":"VRCE-7-97-3","kanda":7,"kandaId":"uttara","sarga":97,"verse":3,"english":"Do you, without any delay collect there all articles of installation. I shall follow the way which has been wended by Lakşmaņa.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7097003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f97fa68d553c35ee87afb9c8a6fba9bd0cac819a1e9adbe1d53c15e61466d8f","compact":"3583d58e045f2d1e54f0c824aeeecb894d23ebd5fc2a997280ea9755f0d50c70","nasal":"3583d58e045f2d1e54f0c824aeeecb894d23ebd5fc2a997280ea9755f0d50c70"}},{"id":"VRCE-7-97-4","kanda":7,"kandaId":"uttara","sarga":97,"verse":4,"english":"Hearing the words of Raghava, the subjects with their heads downwards remained motionless like so many dead bodies.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-4"],"status":"unreviewed"},"source":{"sanskritLocator":"7097004","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8a3ebc3ad4bf114d5c91a80bda50fe16f51d83dc035d09ae577de051e1b7fabe","compact":"55bd891a357e5aeabab7644c4c3f7ce6770593873f9c98b9da348093530ceb31","nasal":"4852acc06c35584f15e34c79b591031a4df7615c2ddbe1d9ebe8b1281aff9f12"}},{"id":"VRCE-7-97-5","kanda":7,"kandaId":"uttara","sarga":97,"verse":5,"english":"Hearing Rāma's words Bharata was also stupified and speaking ill of the kingdom, said.","alignment":{"type":"1:1","confidence":0.523,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-5"],"status":"unreviewed"},"source":{"sanskritLocator":"7097005","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ed6ae489f6194341e6059d535e4573c8405780b46180485d984ce1e859a7c9b3","compact":"d64d87e0fc70912b7d55347d007d2eece4cfa0764b9389639b615dab07287496","nasal":"d64d87e0fc70912b7d55347d007d2eece4cfa0764b9389639b615dab07287496"}},{"id":"VRCE-7-97-6","kanda":7,"kandaId":"uttara","sarga":97,"verse":6,"english":"O King, I swear by truth, that far from kingdom I do not wish to live in heaven even without you; O King, of these two princes, Kuśī and Lava do you place Kuśī in Kosala and Lava in North Kosala.","alignment":{"type":"grouped","confidence":0.544,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7097006","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1596a42f8e74b227059ede04da41dea618042e40e53319916ce62f1d0d70a4d5","compac