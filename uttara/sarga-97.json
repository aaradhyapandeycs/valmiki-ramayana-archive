dition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83b384b1b5e74b8d1147e66f616477fd2f82d4366e535925a8e1311db6af792e","compact":"8b725f976e628192def9596ddb6a6c1162e896f1293ded8e8bc535799a14560a","nasal":"9d99b77f44d7f3a20b63e708f83d5ceac14c87a643e2ba1390d77ff77cf27695"}},{"id":"VRCE-7-97-10","kanda":7,"kandaId":"uttara","sarga":97,"verse":10,"english":"Behold, O Rama, the subjects have placed themselves on the ground. Do you, therefore; apprised of their intention, satisfy their desire.","alignment":{"type":"1:1","confidence":0.771,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-9"],"status":"unreviewed"},"source":{"sanskritLocator":"7097010","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"81cc07e7c0a20018409cfef3ce0387e41fa2f809fe8f8e047e90c142a5855b40","compact":"cdfcfea0ea679b9863ca9f75180e24d243777a996f3805b2bd5094ead9683266","nasal":"cdfcfea0ea679b9863ca9f75180e24d243777a996f3805b2bd5094ead9683266"}},{"id":"VRCE-7-97-11","kanda":7,"kandaId":"uttara","sarga":97,"verse":11,"english":"Raising up the subjects according to the words of Vasistha Rama said:-What good can I do for you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-10"],"status":"unreviewed"},"source":{"sanskritLocator":"7097011","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a02dc4c406939da1ba92a00df46938bbedc7df5f4f6e5aff5d0bbf8a731a0c16","compact":"aa45a01fc03ed2aa41ed5395e0e294433306a4f528e9a6313030833d789f8e9d","nasal":"aa45a01fc03ed2aa41ed5395e0e294433306a4f528e9a6313030833d789f8e9d"}},{"id":"VRCE-7-97-12","kanda":7,"kandaId":"uttara","sarga":97,"verse":12,"english":"Hearing Rama's words they said:-0 King, we shall follow you wherever you shall go.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-11"],"status":"unreviewed"},"source":{"sanskritLocator":"7097012","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8f474063c4d91c3890a8b51d7b7b33df2ff42e7480700a0f95b0396e6fe7090e","compact":"4f25b8469955bfbd2b0dfdf25bc3c6768f2e10303364037c8ea9a6a3f7fdcd5f","nasal":"54887ca2ee156986d018e7c33983c9d53074d817c3e72cebcc13ab856515a92e"}},{"id":"VRCE-7-97-13","kanda":7,"kandaId":"uttara","sarga":97,"verse":13,"english":"O great king, by this we shall be greatly delighted. We pray for this boon only. Our delight consists in following you in everything.","alignment":{"type":"1:1","confidence":0.345,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-14"],"status":"unreviewed"},"source":{"sanskritLocator":"7097013","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a5a0e60e95cda7ced072bce23101e3dc38212e10c8928cc08a68a67ad1e5eedd","compact":"d7c98e73c00bca97b127d5a046c6ef4e8b6ccf22ecf11657266126c20b55a322","nasal":"d7c98e73c00bca97b127d5a046c6ef4e8b6ccf22ecf11657266126c20b55a322"}},{"id":"VRCE-7-97-14","kanda":7,"kandaId":"uttara","sarga":97,"verse":14,"english":"If you have any love or affection for the citizens do you permit them that they may follow your good path with their wives and children.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-12"],"status":"unreviewed"},"source":{"sanskritLocator":"7097014","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"acaabdcc6ce13cb6c2fe20789d0b3c109fd847c3825afa595d033b7472dc3202","compact":"e0353fc3799c299db70212642cc3149f9dd9a5fc633a455f3c5aa250222226b7","nasal":"e0353fc3799c299db70212642cc3149f9dd9a5fc633a455f3c5aa250222226b7"}},{"id":"VRCE-7-97-15","kanda":7,"kandaId":"uttara","sarga":97,"verse":15,"english":"O lord, if you do not forsake us, let us all go wherever you silt,-be it a forest an intractable tract, a river or an ocean.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-13"],"status":"unreviewed"},"source":{"sanskritLocator":"7097015","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb0bfbee455fe7207a4b60c10a3f686ecf643c2caad0adc3f81e3c51850a5fb4","compact":"9725bbc70d8115c9e7d880caba4ad61d2ac56fcee689c2c1bbe46a47022fb86c","nasal":"18c9ae08999e573357c5cce124a4ada2f1b59d134751810aad75d4f4841dae54"}},{"id":"VRCE-7-97-16","kanda":7,"kandaId":"uttara","sarga":97,"verse":16,"english":"Observing such a firm devotion of the citizens Rāma agreed to that. Thereupon having gone through his duties he installed Kuša in the kingdom of Kosala and Lava in the northern country. Lava and conferred open each of them thousand chariots, Ayuta Nagas, Ayuta horses and various jewels and riches he established them in their respective kingdoms. Having thus settled the princes he despatched an emissary to Śatrughna.","alignment":{"type":"grouped","confidence":0.449,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-107-15"],"status":"unreviewed"},"source":{"sanskritLocator":"7097016","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87831dfe8afaa4778d3e39d9e849ed2cf0bbc9f9fe18472b7a5285a56cd1fa9e","compact":"1f9f9610b75d5b0c6571b945fba6bbfef147f74187c87d33aa54b16ddf0cbb9c","nasal":"ea24bbed9ae0c169b0e641300123fb6916243d5bbb8d7ca6105c27ff804a42c6"}},{"id":"VRCE-7-97-17","kanda":7,"kandaId":"uttara","sarga":97,"verse":17,"english":"Observing such a firm devotion of the citizens Rāma agreed to that. Thereupon having gone through his duties he installed Kuša in the kingdom of Kosala and Lava in the northern country. Lava and conferred open each of them thousand chariots, Ayuta Nagas, Ayuta horses and various jewels and riches he established them in their respective kingdoms. Having thus settled the princes he despatched an emissary to Śatrughna.","alignment":{"type":"grouped","confidence":0.404,"method":"shared-sanskrit-