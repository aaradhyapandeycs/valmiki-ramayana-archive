[{"id":"VRCE-7-47-1","kanda":7,"kandaId":"uttara","sarga":47,"verse":1,"english":"Hearing the ruthless words of Laksmana, the daughter of Janaka, greatly sorry, fell down on earth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-48-1"],"status":"unreviewed"},"source":{"sanskritLocator":"7047001","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb3c212a174d3188c2ff8454b682837ca84d8cf6683c05a2d7daf4c11fa2b97f","compact":"bba889b39b7fb7efb11cfb44d295d016fe7935d3a8e5243be77411d3d26f74ed","nasal":"bba889b39b7fb7efb11cfb44d295d016fe7935d3a8e5243be77411d3d26f74ed"}},{"id":"VRCE-7-47-2","kanda":7,"kandaId":"uttara","sarga":47,"verse":2,"english":"And remaining senseless for some time, Sītā, with her eyes full of tears said to Lakşmaņa.","alignment":{"type":"1:1","confidence":0.661,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-48-2"],"status":"unreviewed"},"source":{"sanskritLocator":"7047002","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f8a5fb6c5e030e0fa652c2a9f3ca10c092a09a995aac59cf738d5db9fee9708","compact":"cf145348616daddc46918e2e3bd8b55f1a7179743285c8495f4c1691c6bd489a","nasal":"cf145348616daddc46918e2e3bd8b55f1a7179743285c8495f4c1691c6bd489a"}},{"id":"VRCE-7-47-3","kanda":7,"kandaId":"uttara","sarga":47,"verse":3,"english":"Forsooth, O Laksmana, the great Dispenser has created this body to suffer miseries, and all my affections are manifest in form today.","alignment":{"type":"1:1","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-48-3"],"status":"unreviewed"},"source":{"sanskritLocator":"7047003","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d48fa3910bd311ab5b63a4fece6bce6c624a653900ffabf6e98075c850c4351f","compact":"04ff792469fbd88adfef2871e11cffef4ec443360743e731f7dae9e2c1221947","nasal":"04ff792469fbd88adfef2871e11cffef4ec443360743e731f7dae9e2c1221947"}},{"id":"VRCE-7-47-4","kanda":7,"kandaId":"uttara","sarga":47,"verse":4,"english":"Methinks, I committed a mighty iniquity in my pristine existence or brought about me albeit I am pure and chaste.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-48-4"],"status":"unreviewed"},"source":{"sanskritLocator":"7047004","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a743f8f68b917b59f16c0b9d3f295a17dd23b2e2b7cc150a12b250a7558087f1","compact":"757d858f9ea071badc0c230e0807c69ea7717985e4a71a0d86165569b0ce7fa0","nasal":"757d858f9ea071badc0c230e0807c69ea7717985e4a71a0d86165569b0ce7fa0"}},{"id":"VRCE-7-47-5","kanda":7,"kandaId":"uttara","sarga":47,"verse":5,"english":"O son of Sumitrā, the affliction of residing in the forest appeared to me as pleasure ere this for I knew that I would be able to serve Rāma's feet.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-48-5"],"status":"unreviewed"},"source":{"sanskritLocator":"7047005","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd696268c5c09b1c81e109a9205a6c95575adc6882a1b18866ea6ee6d0d9cc20","compact":"ab8bef99c91921447d23af9114f2aac2c0eae999da6d265915f102d67173ac23","nasal":"ab8bef99c91921447d23af9114f2aac2c0eae999da6d265915f102d67173ac23"}},{"id":"VRCE-7-47-6","kanda":7,"kandaId":"uttara","sarga":47,"verse":6,"english":"But how shall I, O gentle one, live in the hermitage being divorced from all my kith and kin? and being afflicted to whom shall I express my sorrow?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-7-48-6"],"status":"unreviewed"},"source":{"sanskritLocator":"7047006","sanskritFile":"Ram07.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eef7dc07f7f9e0312524abc7dfa76eb78cd6424c0c70e9ff39be70dbe4341092","compact":"9f4e