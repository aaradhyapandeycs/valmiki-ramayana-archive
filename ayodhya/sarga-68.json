","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a595a60ae9f8e10873ecf799c1cf862fd766e564f76429c0697d8bed50624be7","compact":"eb42849ed3a032df5025271b69e3ca85ee22133b2c6e1186148ed634947de88d","nasal":"18371ca824a6c69180dea8bdd5f3847a8bf36125fbc1eab6563160ba166f299f"}}]
