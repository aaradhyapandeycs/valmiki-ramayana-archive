7"],"status":"unreviewed"},"source":{"sanskritLocator":"2006023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"37c997dd5645374bd729531723809df25fc1e2d344743039ccb215ead57b88da","compact":"7dc83a5020de6d7bf6fa28ad5591d9de668aa75f8c60cd8824fb61dfed3553fe","nasal":"d20a8d200ca18c72409a24b2aead01ff9a170a66e9c938c6f900bb60748e5bfd"}},{"id":"VRCE-2-6-24","kanda":2,"kandaId":"ayodhya","sarga":6,"verse":24,"english":"May the sinless and pious king Dasaratha live long; for it is through his grace that we shall behold Rāma installed.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-6-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2006024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9a50408b6fc4ec2107d39f65f5a8afc1a42b4891b6b2a95191f378fb112b47d3","compact":"0bd3bc966f9cd57b55c4ccf242347d85a32342a46360fe48d46d53280f5a88d7","nasal":"0bd3bc966f9cd57b55c4ccf242347d85a32342a46360fe48d46d53280f5a88d7"}},{"id":"VRCE-2-6-25","kanda":2,"kandaId":"ayodhya","sarga":6,"verse":25,"english":"The inhabitants of the provinces, who having heard the tidings, had come from various regions, heard the citizens conversing thus.","alignment":{"type":"1:1","confidence":0.714,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-6-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2006025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"95ea8480da6eaa068c035b582493c05c16c09f27049474ab1d06806d582ed246","compact":"ae1549bcd6eba9d024589d296490bc6335973161380f1710a3e3b8e9fad38d3f","nasal":"25cf2cdbfaa3064f05275a7833326fe1aacfda996d9b78a86b9f11806f6895a6"}},{"id":"VRCE-2-6-26","kanda":2,"kandaId":"ayodhya","sarga":6,"verse":26,"english":"Desirous of beholding the installation of Rāma, they coming into the city from various directions, filled Rāma's city.","alignment":{"type":"1:1","confidence":0.768,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-6-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2006026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c296f9562a7de6f7efe7aeef012515665c3a8a460018e09e926d3b0ffe6a7dc","compact":"e97f2a94efbb27a9aaeae9f42af5537f0a595e9da1003ca996fe530b19f77c06","nasal":"e97f2a94efbb27a9aaeae9f42af5537f0a595e9da1003ca996fe530b19f77c06"}},{"id":"VRCE-2-6-27","kanda":2,"kandaId":"ayodhya","sarga":6,"verse":27,"english":"As the vast concourse entered (the city),there was heard an uproar like to the roaring of the heaving ocean during the fullness of the moon.","alignment":{"type":"1:1","confidence":0.826,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-6-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2006027","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d77ce6f689c321dc9e4f0a4835c2f8e731ea4c61edecf46974402bfda63fa947","compact":"7301bbeaa1b50b8f8fd5b5107a82f5f4aa565f836d20aed40a34f188dbc1d26b","nasal":"7301bbeaa1b50b8f8fd5b5107a82f5f4aa565f836d20aed40a34f188dbc1d26b"}},{"id":"VRCE-2-6-28","kanda":2,"kandaId":"ayodhya","sarga":6,"verse":28,"english":"Then that city resembling the regions of Indra, being filled on all sides with tumult raised by the dwellers of the provinces who had come to behold (the installation), resembled the ocean when its waters are agitated by the aquatic animals inhabiting it.","alignment":{"type":"1:1","confidence":0.813,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-6-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2006028","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d28de779ff961c41f508d502ae5a70190f1ec9bdbe6407b19d72cb2192648443","compact":"63ed0744e4659ac1168f0319037ff87c44b6d93f6b0eb7d27477ea423f01b953","nasal":"66fdcd90ec61f69c562cd45223b77ab39bd955ad676eec528d4ba46dfaec859a"}}]
