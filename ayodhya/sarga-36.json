],"status":"unreviewed"},"source":{"sanskritLocator":"2036012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dde6cea548d7cb9f6b3ecfe6a57362b0519016026d30b29bf10835ca0f4c7d4a","compact":"5415f3160c0eae3e56c2502726614239b30123df95ef73496c50a6088132f14d","nasal":"7ddfeb2b0db9caa27f5b4f30f0799cf7e7969451f52ead9b26049595148a42f3"}},{"id":"VRCE-2-36-13","kanda":2,"kandaId":"ayodhya","sarga":36,"verse":13,"english":"And with their faces washed in tears, the wayfarers betoken no delight, but all are being exercised with grief.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-41-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2036013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d2bc36edec22d3e0d8993b3c08280251506d6ad653a195c360db620070d88852","compact":"23bf06a06dead33e4c09667fb24c086df3e14eace54df01e137c4334d279a84b","nasal":"23bf06a06dead33e4c09667fb24c086df3e14eace54df01e137c4334d279a84b"}},{"id":"VRCE-2-36-14","kanda":2,"kandaId":"ayodhya","sarga":36,"verse":14,"english":"The cool air does not blow, and no moon of mild appearance is seen, and no sun heats the world, all the entire Earth is overwhelmed with woe.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-41-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2036014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db716cb2d8486bb68a40111894c450a390147b9a85ceabecc1b1fdf48cee5abd","compact":"ac99f9c3b1f45d21a42f561b1606f2c94f7c61d16ce10cd55e1520682f6b51e9","nasal":"ac99f9c3b1f45d21a42f561b1606f2c94f7c61d16ce10cd55e1520682f6b51e9"}},{"id":"VRCE-2-36-15","kanda":2,"kandaId":"ayodhya","sarga":36,"verse":15,"english":"Sons depend not upon their parents, husbands on their wives, and brothers on brothers, and all forsaking each other, think of Rāma only."