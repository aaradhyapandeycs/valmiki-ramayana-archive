[{"id":"VRCE-2-36-1","kanda":2,"kandaId":"ayodhya","sarga":36,"verse":1,"english":"When that foremost of men had gone out of the city with joined hands, there arose a chorus of cries proceeding from the females residing in the inner apartment.","alignment":{"type":"1:1","confidence":0.895,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-41-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2036001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"291563f409c2c00a48d69fb06761cb8f5a6143492458643ab055f2a2a965361b","compact":"5e326c95072576d52ebecef54f5088bbca0c9edb56e91923670cca72f678c0cd","nasal":"56e0a1bcbbdaa61909fe83679bc76742a27fee1a3110c0eaa07585e37f8281ec"}},{"id":"VRCE-2-36-2","kanda":2,"kandaId":"ayodhya","sarga":36,"verse":2,"english":"Where goes he that was the stay and refuge of the friendless, the feeble, and the helpless.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-41-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2036002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8cc51fb236cb45d56ca6ebc0df3fcf3dea7ca12629a06eaeccfd17608c8a4b1f","compact":"6c47b2a253978d13f548a6d89ce822f69fc156de11afba5b327766dddd2b7158","nasal":"6c47b2a253978d13f548a6d89ce822f69fc156de11afba5b327766dddd2b7158"}},{"id":"VRCE-2-36-3","kanda":2,"kandaId":"ayodhya","sarga":36,"verse":3,"english":"He that although falsely accused, used not to be moved by anger, who pacified every enraged person by renouncing things calculated to fan anger and who felt equally for all, where goes he?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-41-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2036003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"48685704ddbfd51b1606ad2502c144a87c0182e84f91e89afb40d40c197aaeb0","compa