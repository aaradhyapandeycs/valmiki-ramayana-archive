[{"id":"VRCE-2-62-1","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":1,"english":"Hearing their words, Vasiştha said to the Brāhmaṇas and the adherents and counsellors (of the king)","alignment":{"type":"1:1","confidence":0.88,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2062001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"709445d234c7c1f1254983276888f3ba4124663d5650128ac69e7216bed52791","compact":"510d3b3928709df18318c740b2b5cc3633b6eea21920ccdf76ae0ecdbbb8cddc","nasal":"510d3b3928709df18318c740b2b5cc3633b6eea21920ccdf76ae0ecdbbb8cddc"}},{"id":"VRCE-2-62-2","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":2,"english":"Bharata, on whom the king has conferred the kingdom, along with his brother Satrughna, is living happily in the house of his maternal uncle.","alignment":{"type":"1:1","confidence":0.527,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2062002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3844454b971d1947530f636d431cbbe98653913eb305d12f5e9226f858018d85","compact":"6ea2f458795ef0b6253fa7a81c024831e53a4464a77ce7849ec8b1b4b180e2a5","nasal":"6ea2f458795ef0b6253fa7a81c024831e53a4464a77ce7849ec8b1b4b180e2a5"}},{"id":"VRCE-2-62-3","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":3,"english":"Let envoys by means of fleet coursers speedily repair thither and bring those heroic brothers. What shall we decide?","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2062003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4b6cdef9b053ca1ee5c3b09b98dbaf03b2a9fd4eafff59bbe321c7bd52ac9ac7","compact":"a2936801f246698f43de476eeb8927dc2803586d074359f17e65d44ed79d14db","nasal":"aadb19f8862177d1bbc2b163572627c586e72e7be8118f48124b8c30af830f3b"}},{"id":"VRCE-2-62-4","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":4,"english":"\"Let them go\", said all to Vasistha. Hearing their words, Vasistha spoke to them, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2062004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b58701bbf0192f90a9625e37719603e16135368230a54dc498ed04ff9aa6eef5","compact":"c681e785261bec52b3b86c2acdb49f9a512bbfe7ea952ae0d453676e815e627b","nasal":"28424345eb735aff63471f2869c66525250e72c981a8fcaef77c62f118718d25"}},{"id":"VRCE-2-62-5","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":5,"english":"Come here, you Siddhārtha, and Vijaya, and Jayanta, and Asokanandana. Do you hear. I well tell you what you are to do.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2062005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"895544bcd770b37d317a6d816da6393f27f08fdb7ac28177e63c3f3b8f243820","compact":"7f373b418556defb37bff7d445ee03b6f4427833299d8ff64a2bdbd3cbe5120d","nasal":"78f6b6dc4c1b3ef62229f8f11f1e6f28fe6fc761e1fffaa4fe10b1cb272ee0c1"}},{"id":"VRCE-2-62-6","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":6,"english":"First going speedily to the royal residence by means of swift horses, do you, renouncing grief, by my order speak these words of mine to Bharata.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2062006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8df9745b07dd1f802dba3d63554aaec41c7a19e08de7561cc1331fa51c4dee0","compact":"25b9b0c9f04bbcaa092442e26037ed99410c7339175584e33cd555065767bd0f","nasal":"25b9b0c9f04bbcaa092442e26037ed99410c7339175584e33cd555065767bd0f"}},{"id":"VRCE-2-62-7","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":7,"english":"The priest as well as the counsellors have enquired after your welfare. Do you at once set out. A business is at hand that brooks no delay on your part.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2062007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f55afd511de02e661d4596517b10d3abd58da51793dd16b88d319e733b77a371","compact":"50f1f99a02c8c5eea57870ef63354da4b5ac80cbed046d282ce3d1a603ba1a2e","nasal":"220269f5e363cfc50cfa67d62cd22d433968d3521a3aa2a05a795f568acc28f3"}},{"id":"VRCE-2-62-8","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":8,"english":"But you must on no account communicate to him the exile of Rāma, or the demise of the monarch, or the destruction that has befallen the Raghu race through this occasion.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2062008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ff277cf7986774aadbc29998177d430d589d123c9090c15931d80b0531da41cb","compact":"d01c96ed02fc005a4b2e7769ad0e5c7ed409fddab68180a7607a075c640784f9","nasal":"e621e1f845bba0b882843d933dd8f9ee10eccd93ffda9291ab643860418b4049"}},{"id":"VRCE-2-62-9","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":9,"english":"Do you, speedily taking silk apparel and excellent ornaments for king Bharata, set off. Then having supplied themselves with the necessaries of the journey, the envoys in consonance with Vasiştha's injunction, speedily went away.","alignment":{"type":"split","confidence":0.596,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-9","DUTT-2-68-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2062009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"37a0d8ae217bb5d73c25212e3bb96cecb8b22a979339a080aac3c58fcc9b40fa","compact":"4899e61bba52e2ec96228ef1d54d72c26eea380a0aa7ad7f7357cd5e5327623d","nasal":"4899e61bba52e2ec96228ef1d54d72c26eea380a0aa7ad7f7357cd5e5327623d"}},{"id":"VRCE-2-62-10","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":10,"english":"Then crossing the Gangā at Hastināpura, and arriving at Pāñcāla, they proceeded west ward through Kurujāngala.","alignment":{"type":"1:1","confidence":0.957,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2062010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b15d10fc6a84665ab026c80a2ccc45d7e588454d9739d571546b06de137e7f62","compact":"e6fbe39d14ae77c92c5e289a183e19f472bab2fc568e2e27ab918d2ac0eb50e3","nasal":"d2257da4413b8ae60bb2b570c1a369055ffddf9ba20dcfc7b22e30ef7908420e"}},{"id":"VRCE-2-62-11","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":11,"english":"And they darted past the Saradanda overflowing with delightful water, beautiful, and haunted by fowls of various kinds.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2062011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4bb9d22b1f87e33b2aca343bb8ac397dd067e1024ad109cd46694753658b24bc","compact":"0a9fa99d3c87889e844ee89aa43a7dec867359a10e61e96452d11628e341a21c","nasal":"62b004d6e7450eaa6b16a56269eb329b8c7d8dbaf07138e88b36a2fd39f08bad"}},{"id":"VRCE-2-62-12","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":12,"english":"Then on the western bank of the stream, coming upon a tree called Satyopayācana presided by a deity, and bowing down to the tree and going round it, they entered the city of Kulinga.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2062012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6619143894c879a11fc5b8c05887c01ffb5d62131cea391d64706477dfde99d2","compact":"746e6c1b037c27e39928418d6ddbe7a1d5fa352d1e4b0ef602931da759249cd0","nasal":"eda009753e0bf0f8ad3351679f0945dde2194527ad909e3da0855753c2a7951c"}},{"id":"VRCE-2-62-13","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":13,"english":"And having passed Tejobhibhavana and arrived at Abhikāla, they crossed the sacred stream Ikşumatī belonging to the Ikşvākus for generations. There seeing the foot-print of Visnu, they desirous of doing the bidding of their master, proceeded a long way, viewing the Vipasa and the Salmali and rivers and tanks and pools and ponds and sheets of water and various kinds of lions and tigers and deer and elephants.","alignment":{"type":"split","confidence":0.271,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-17","DUTT-2-68-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2062013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1732d75c11439b8599e359a161fb7b3395939c96bb86b26d5fec06677f0c869d","compact":"affaaf5e3d55c06a40ced694e713c5cae97733b2a6232e81a98a1f3fa3d9cbf6","nasal":"affaaf5e3d55c06a40ced694e713c5cae97733b2a6232e81a98a1f3fa3d9cbf6"}},{"id":"VRCE-2-62-14","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":14,"english":"And with their vehicles fatigued, the ambassadors, on account of the great distance of the way; speedily reached that best of cities, Girivraja.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2062014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a2d557f239c9386289c564e197abebc89bf7284fc860d88e3b5ebf8a69cdf9e","compact":"ca724fa28eb53773dedc72a9099835e70947c2bd8f831f14832661cf6a5b7203","nasal":"37793fb9ad9dd3483aa9607c8c2f77cc3148b6e338156646cc884880689608f7"}},{"id":"VRCE-2-62-15","kanda":2,"kandaId":"ayodhya","sarga":62,"verse":15,"english":"And for pleasing their master, for the preservation of the people, and enabling Bharata to assume the reins of government, those envoys, casting aside negligence, swiftly entered the city in the night.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-68-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2062015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9ca8c5ba3966dea93b5e482516cd54964edfd356f7e1641c2d69e999169d06fc","compact":"4b193186018104ae829fbabc6571a6e2fb5eed934fd0cf0245b990180450a3bb","nasal":"4b193186018104ae829fbabc6571a6e2fb5eed934fd0cf0245b990180450a3bb"}}]
