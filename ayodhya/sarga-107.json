[{"id":"VRCE-2-107-1","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":1,"english":"Having placed his mothers in Ayodhyā, Bharata steady in his vow, kindling in grief, said preceptors.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2107001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"da1c17e0d85aa1501058adbd60cbc548d036a8d652db92e7877f1bf845ee27c6","compact":"364a026bfd746e45e09398756e41c5ac15b7472ed7645dc40b7a26c5803ed29b","nasal":"364a026bfd746e45e09398756e41c5ac15b7472ed7645dc40b7a26c5803ed29b"}},{"id":"VRCE-2-107-2","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":2,"english":"I shall go to Nandigrāma, and therefore greet you all. There I shall suffer all this grief on account of Rāma's absence.","alignment":{"type":"1:1","confidence":0.848,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2107002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e046ccc2bdb05f73631562f3ed764542f622111532675e73caf3b4832e6e65cc","compact":"85776b163124796b90c87911cf967b9b1360ffcf850d87d505cbaaae2508677e","nasal":"95a0c79fd2c168fa1c21af204854a8f8ac0c59b8791468a753699de02754a305"}},{"id":"VRCE-2-107-3","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":3,"english":"The king has gone to heaven, and my superior is staying in the woods. I shall remain in expectation of Rāma, assuming the reins of government. Verily that illustrious one is the king.","alignment":{"type":"1:1","confidence":0.707,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2107003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9f2643209e0cf67c74599168ef0d401a811a4857527e85fe6d67c7f036394505","compact":"410171f4b1257a51a383f511308b92bde89c30ff6fe1cafc25cf054a1c539dbb","nasal":"410171f4b1257a51a383f511308b92bde89c30ff6fe1cafc25cf054a1c539dbb"}},{"id":"VRCE-2-107-4","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":4,"english":"Hearing this excellent speech of the highsouled Bharata the counsellors as well as the priest Vasiştha said.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2107004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2501068fbf9d5d5be0615c67828a5137e84eac6853ffdb42a78b6ab0a999b358","compact":"789de773fa508be03340ac7ed53c275afa19c22f7aee4e3cff0bfb85303fe474","nasal":"a31919d8e2aef2a8c2d92e3adc2e3f70ff8a953c5e2d2e062a44c5eb3ffb43f0"}},{"id":"VRCE-2-107-5","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":5,"english":"What, О Bharata, influenced by affection for your brother you say, is worthy of you and is highly commendable.","alignment":{"type":"1:1","confidence":0.964,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2107005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d446bd21fb095af3757cb45b4cbd6b37c69defc504b8f50e02808804d21ee9f","compact":"2e97809481a74869f29b2ca48091bd0d5682f6512d22d8e10e9db9f831151d04","nasal":"2e97809481a74869f29b2ca48091bd0d5682f6512d22d8e10e9db9f831151d04"}},{"id":"VRCE-2-107-6","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":6,"english":"Who will not endorse what has fallen from you, ever engaged in serving your friends, established in fraternal love, and who have entered upon a noble course?","alignment":{"type":"1:1","confidence":0.775,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2107006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"abb26