.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"60b66e3731e7e90a3f2b61ae3461426c56ba103ef292b3b8732afa1c2d4bf6bf","compact":"28008a70b340c9f71d3a15b105064f3ea96b97a5531c954f5f910a53a0a91275","nasal":"44a705306bb93ab4836dbd0a75e70de868b336e35293ecaa0d567538d372ab6d"}},{"id":"VRCE-2-107-10","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":10,"english":"And going ahead, all the preceptors headed by Vasiştha proceeded eastwards, in which direction lay Nandigrāma.","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2107010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"32689a0696dbb099f34345006fa681f69616b4e46ed53545856f91533db47802","compact":"6dc8b9b261aaa09fb98a2538e72b1e2ac52180bd0b4bdd89215e29243910113c","nasal":"30908894c2bc0377fab4cbf03bbea89152a91173318db1ef11272e657f5e8aba"}},{"id":"VRCE-2-107-11","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":11,"english":"And the forces, filled with elephants and horses and cars, although not called, set out on Bharata proceeding, as well as all the citizens.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2107011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8cdda34e5155ee527fda041348d70c14e3094f7a49f072163970e91d76d4fafb","compact":"2895efe90df167e8e4851e14b77d9b321edf795b292ba9b8ebab88c5d3e15625","nasal":"24d83789de67e4803bda34f38bd08482d0bda9736328e5f90ef55bca8ae38b93"}},{"id":"VRCE-2-107-12","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":12,"english":"And ascending the car, the virtuous Bharata attached to his brother, speedily went to Nandigrāma, holding the sandals (of Rāma) on his head.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2107012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3377d2f5cf1090c46993380c0c3a4781b2f91acab26923a1e0a59abfac157a4a","compact":"80c725247dd82bc18a630b762c8cb74197fd42ccb2f9270438dfae5fc7f375ae","nasal":"95acc2dd7765e59d95e20d7d6351005e54ef5f1127880e3860a285af76c5dd45"}},{"id":"VRCE-2-107-13","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":13,"english":"Then entering Nandigrāma in a short time, Bharata swiftly alighted from the car and addressed his preceptors, saying.","alignment":{"type":"1:1","confidence":0.714,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2107013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ff4f08348b16f487f011cc1f4dd647a5fb4f736f9322fd4e98a0219123da6a5a","compact":"6037c8f41caa84e7ea5b90dd016f238b012389fe44d2b5d16fd0503042a852a5","nasal":"e672c234a9f79bc974561ace815003e9b7bed7a3b5a25b0d2b25f66c8811aa7d"}},{"id":"VRCE-2-107-14","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":14,"english":"This monarchy has been consigned to me as a trust; and these gold-decked sandals shall carry on the work of government, protecting what the people have and securing to them what they have not.","alignment":{"type":"1:1","confidence":0.532,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2107014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b17fa796ffaae32bb699fdb89d4f7b45d224e2ee9c04b4088a74fd626d9c1650","compact":"c47f1415376bee53588247535a7456d75594919622a02ee7cb61047245fab7a2","nasal":"c47f1415376bee53588247535a7456d75594919622a02ee7cb61047245fab7a2"}},{"id":"VRCE-2-107-15","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":15,"english":"Again speedily putting these sandals on Raghava's feet, I shall behold them with the sandals on.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2107015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4b62fb131134b7dcf5cda6843dd16d58e4c9c7394225343dba56f78cc3b87a9d","compact":"bf10f6f0ec9daa496e6db37cf167dd9af9dad7934dfcf70a97db6ae2078934f2","nasal":"bf10f6f0ec9daa496e6db37cf167dd9af9dad7934dfcf70a97db6ae2078934f2"}},{"id":"VRCE-2-107-16","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":16,"english":"On Rāghava coming (back), I shall, my burden being cast upon him, making over the kingdom to him, engage myself in serving my superior.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2107016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3412fe5c45a558322b13ad5249d596b9c6de45474c193ee2c7d2ccfe9c22db1","compact":"ce5c4c43049ef9c5c7eddcda19d4e76a7cfb5d30102a6f26db17a601cd8c44bd","nasal":"ce5c4c43049ef9c5c7eddcda19d4e76a7cfb5d30102a6f26db17a601cd8c44bd"}},{"id":"VRCE-2-107-17","kanda":2,"kandaId":"ayodhya","sarga":107,"verse":17,"english":"And having rendered to Rāghava the trust in the shape of these sandals, this kingdom, and Ayodhyā, I shall be washed form my sin.","alignment":{"type":"1:1","confidence":0.964,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-115-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2107017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af0325af88960d43bf6b9331e297a2ef4beab2502eb785b5c76430f8f6b844b2","compact":"fee56d4679f67d94f64e073530e62e5ff7f844c82929c9cdc8d246c1bc374844","nasal":"fee56d4679f67d94f64e073530e62e5ff7f844c82929c9cdc8d246c1bc374844"}},{"id":"VRCE-2-107-18","kanda":2,"ka