[{"id":"VRCE-2-42-1","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":1,"english":"Then with depressed spirits, and exceedingly afflicted, with tears flooding their eyes, smitten with mortal grief, the inhabitants of the city went back from Rāma to the city. And with their lives appearing as ready to go out, those unsteady ones came to their respective homes, and surrounded by their wives and sons, washed their faces with copious tears.","alignment":{"type":"grouped","confidence":0.95,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2042001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c2934cfa89f81ed974169b80b2d906e08942963d513f978e45deee43ccae378","compact":"d2f5c4208b35cd03d65ad4afee20a0507afed70b0d1aebdcd5357c5fbd1c4407","nasal":"d2f5c4208b35cd03d65ad4afee20a0507afed70b0d1aebdcd5357c5fbd1c4407"}},{"id":"VRCE-2-42-2","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":2,"english":"Then with depressed spirits, and exceedingly afflicted, with tears flooding their eyes, smitten with mortal grief, the inhabitants of the city went back from Rāma to the city. And with their lives appearing as ready to go out, those unsteady ones came to their respective homes, and surrounded by their wives and sons, washed their faces with copious tears.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2042002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80d329b4b3d9c88e1389e7df3b8dcbd9b6a0934752c1c8735128dcc772b9d616","compact":"5cf2510317fabbd9de1a5bdbc5c167612b01b68dc6eb05db9bffcff9b93825c2","nasal":"5cf2510317fabbd9de1a5bdbc5c167612b01b68dc6eb05db9bffcff9b93825c2"}},{"id":"VRCE-2-42-3","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":3,"english":"They forgot to rejoice or make merry, and the traders did not spread (their stores), and stalls did not grace the place, and the householders did not cook, and people did not rejoice on recovering lost property or gaining a profuse accession of wealth, and mothers did not feel any delight on beholding their first-born.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2042003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ce73c0eeac621c27341da093a8b5a06eb27adbf4d51602382c1aedd74a88b0f4","compact":"cb93105f9d2da0ef4bebf2a31568c103ae07919531f6ed206fd2cec71f060ddb","nasal":"56c8044fabdeed071a6f1dd96cb319682a4c6993ec263aa2687a7a31079c086b"}},{"id":"VRCE-2-42-4","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":4,"english":"They forgot to rejoice or make merry, and the traders did not spread (their stores), and stalls did not grace the place, and the householders did not cook, and people did not rejoice on recovering lost property or gaining a profuse accession of wealth, and mothers did not feel any delight on beholding their first-born.","alignment":{"type":"grouped","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2042004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3ddd3ba37f9b9b6358ef4a8a8885548be56b3ad407511f3e029e099908b39726","compact":"5e9ccf8c3a357cef7476f35b35c8ee93d812b6c9586bb0ba0bd04035dfce3511","nasal":"e1319b5771ddb2cb152f71af8c41df23021e994abec18a804535ac92d3ac32e9"}},{"id":"VRCE-2-42-5","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":5,"english":"And in every home females afflicted with woe, weeping child their husbands coming home, with the following words as (drivers) spur elephants with hooks.","alignment":{"type":"1:1","confidence":0.77,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2042005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a826d26d69765d0e8ddd846937d7a8a56093b48e0d9581e10b2dab5a45acb7c","compact":"52f4042005868c1fbf1ffea4c3f7aa97214be94412a31c9333dfddee80f20876","nasal":"31550e0ac93568b38cc61e3195cec736ba3534a5d97647405ea234a1eb40b952"}},{"id":"VRCE-2-42-6","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":6,"english":"Of what use are their houses, and wives, and wealth, and sons, and comforts, to those who see not Rāghava (in their midst?)","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2042006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ce54bd8f76c2cc28febbc583012b7184935d3f749d08fa16c192deacd35d5e7","compact":"713daba71b6af26419051ba0439f0ae6966fae60623173540e8eb65c8bcbe590","nasal":"23ce8177855312399c36756ebae980f8f82b2b635fb5a2fe71de6a62e3dd2a21"}},{"id":"VRCE-2-42-7","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":7,"english":"There is one only good man in this world even Lakşmaņa, who along with Sītā is following Käkutstha Rāma to the woods.","alignment":{"type":"1:1","confidence":0.948,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2042007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a04f76c88ffc63e1e7b8ebf681ef560eb2b9c3235b762d16b5fd3bbf4a7b3181","compact":"1ca9e9b606a942e30e5ab009fc175f1ef427eec1c7ac7d8c8fdc34724ad4f41d","nasal":"1ca9e9b606a942e30e5ab009fc175f1ef427eec1c7ac7d8c8fdc34724ad4f41d"}},{"id":"VRCE-2-42-8","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":8,"english":"Those streams, assemblage of lotuses, and pools are blessed by which bathing in the sacred waters, Kakutstha will pass.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2042008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3691bd2c9fa2cde7b14b35b2e110b4980a2ef75aa59a815b35243b36a8529743","compact":"587f01ae6545492315e97218b4c1eeb40d5ac5c65e3360928845bef08c502dbc","nasal":"587f01ae6545492315e97218b4c1eeb40d5ac5c65e3360928845bef08c502dbc"}},{"id":"VRCE-2-42-9","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":9,"english":"And romantic forests and woods, watery expanses of mighty volume, and mountains with flat spaces, will grace Kākutstha.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2042009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a33396577524c3a368ca97fcd20ccaba24a42543e238174445dce391ef73c5fc","compact":"e7c7926797f89ea378338d4088014a005a281bde98c40a98bfd7e12497914321","nasal":"e723ee58c97b150eae2a0dc37b54573f1a5f2a34a7cd648a0aa58b7f6bab29f4"}},{"id":"VRCE-2-42-10","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":10,"english":"And forests and hills to which will repair Rāma cannot go without paying him homage like to a welcome guest.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2042010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e08790f4e549a4cd49c9f963954ec338677f7024a22c674c083ef2056b38c343","compact":"0f3a3136d8c4fbfc448e6548526dec367ce4e369db15c4d02718cf8cf9ec186a","nasal":"6a1640924567504082906ca415aaccfef77dd52f2b6b1b81617c107724141733"}},{"id":"VRCE-2-42-11","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":11,"english":"And wested with flowers of various hues and putting forth frequent shoots, trees, swarming with bees will show themselves to Rāghava. And hills from regard will show to Rāma arrived there the choicest flowers and fruits even out of season and will supply him with fountains of pure water.","alignment":{"type":"split","confidence":0.663,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-9","DUTT-2-48-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2042011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"960b64ce3852bfe26fa6b45a8483d272ecfbff62cb90309cc6a0dcb96be985d8","compact":"ecce0a5f043a61123cae0f902a90a94332ec38b90f35e74c4c71433482187380","nasal":"4757d6c047ef74fe4bd84b0eb18aebabe213388d2087f1ea9b2f5970eccea027"}},{"id":"VRCE-2-42-12","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":12,"english":"And hills from regard will show to Rāma arrived there the choicest flowers and fruits even out of season and will supply him with fountains of pure water. And presenting him with many a charming fountain, trees will delight Rāma at the tops of mountains.* Where Rama is, there is nor fear or failure. That mighty-armed son of Dasaratha is heroic. Let us while he is yet ahead within a short distance of us, follow Rāghava. *The meaning is, Trees will please Rāghava by spreading for him a bed of leaves and flowers.","alignment":{"type":"split","confidence":0.535,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-10","DUTT-2-48-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2042012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee3a732d454dac2a172af73187caac6602c2e8a018edbd194d2f25fc5437a1e3","compact":"45826207e22f8a9f8582cd25e57eace61e38d71d563d16a089e14288ff976a47","nasal":"6b2e5b8744955273486d0ba5cf9980833c45d502f2503958a194baee81f9f0f5"}},{"id":"VRCE-2-42-13","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":13,"english":"And presenting him with many a charming fountain, trees will delight Rāma at the tops of mountains.* Where Rama is, there is nor fear or failure. That mighty-armed son of Dasaratha is heroic. Let us while he is yet ahead within a short distance of us, follow Rāghava. *The meaning is, Trees will please Rāghava by spreading for him a bed of leaves and flowers.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2042013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0c84c76d8e19dac91af8a2fb7d4507d494b8643a2e907cf94807ab827467a6d9","compact":"36a659ac340a820dc9aea665b292976b3768579d57e4ca20dcd3599aba9ec404","nasal":"36a659ac340a820dc9aea665b292976b3768579d57e4ca20dcd3599aba9ec404"}},{"id":"VRCE-2-42-14","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":14,"english":"And presenting him with many a charming fountain, trees will delight Rāma at the tops of mountains.* Where Rama is, there is nor fear or failure. That mighty-armed son of Dasaratha is heroic. Let us while he is yet ahead within a short distance of us, follow Rāghava. *The meaning is, Trees will please Rāghava by spreading for him a bed of leaves and flowers. Even the shadow of the feet of our master, so high-souled, would bring us happiness. He is the lord of all these, he is the refuge, he is the accomplishment of our religious duties.","alignment":{"type":"split","confidence":0.575,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-11","DUTT-2-48-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2042014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"beadc9e7393d9d632075c8e01a3e4867e196c453d6a9eb8f03b76c38c6fa4412","compact":"a5a0f2e712ac88b0c3115e78b5612cf07c8b1f518a28092e36ec48af7d24615e","nasal":"33ec2ef20202ddf7ee107e72c9e96cd40377c87f5043a7dfdd6f565cfa8b9010"}},{"id":"VRCE-2-42-15","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":15,"english":"We and you, will serve Sītā, and Rāghava. Thus afflicted with grief, the women of the city spoke to their husbands.","alignment":{"type":"1:1","confidence":0.681,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2042015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5cfeeabeb99d220a40d91e8cdbd6d6d2c7afaa75a2c203767ccc7e8bde85844e","compact":"5b153f1987ddb26bc90225fe4ba261241c1b1d5fb8ae99b25a4fe33dc0f6a482","nasal":"b875ccfc7c49f5625bb804067cf217d919721fc63f6fc54fea6397cd22055922"}},{"id":"VRCE-2-42-16","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":16,"english":"In the forest Rāghava will attain for you the unattainable and protect what is attained; and Sītā being a female will do the same for these (women.)","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2042016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e567d97decc9dc59098c995482f01feaeddd75a667a43697d1b552d910de2056","compact":"483d5c9fba52a36d66012f254dc98f7de855722175734b82d45d77c45d7a86e9","nasal":"483d5c9fba52a36d66012f254dc98f7de855722175734b82d45d77c45d7a86e9"}},{"id":"VRCE-2-42-17","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":17,"english":"Who will take pleasure in residing in a dwelling where the heart dies within itself, which is devoid of delight, where the people are always agitated with anxiety and which is exceedingly disagreeable?","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2042017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19b137a40a62699a06e53cded8a79bb5b751c6d5d452e85f3c728ea97161f530","compact":"3acc806ecba0c5ae287d3890015cf6ec0c75ae5bc8445a01f55c71c1499de3fc","nasal":"0fb90d8874fb2dd9a0c03d01f10360295ba787b8129c80215ceeb9c35ca9541c"}},{"id":"VRCE-2-42-18","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":18,"english":"If this kingdom devolves on Kaikeyi it will be divested of all virtues and will be like to one without a master. And of what avail then is our life itself, not to speak of sons and wealth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2042018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a3e2a043450474df736ea33bca75e1a8a2075c7fedf888143b982c3273161ed7","compact":"b15fb28820f0d3b7550dc7534832c55890bcdcf6fee8dbd6943c131070288510","nasal":"b15fb28820f0d3b7550dc7534832c55890bcdcf6fee8dbd6943c131070288510"}},{"id":"VRCE-2-42-19","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":19,"english":"Whom else will that stainer of her line, Kaikeyī, forsake now, who for the sake of wealth has forsaken her son and her lord?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2042019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"84895fc6dd04c8178e32bb23df898c3fc3795f73c575c65319776e9c5a7e0338","compact":"70af1bf5bee4e7c7d4f23aaeacd13744612c0bcdfde0a0bec48b0f13d3d8e919","nasal":"70af1bf5bee4e7c7d4f23aaeacd13744612c0bcdfde0a0bec48b0f13d3d8e919"}},{"id":"VRCE-2-42-20","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":20,"english":"We swear by our sons that so long as Kaikeyi is alive, we living will never stay in her kingdom, although we may be maintained by her.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2042020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"49fd28b0ac7be594eaac050e7139a5d600a25a967f6f6cf6cfa6bc5d872b7ba8","compact":"6fa8c8fb9e0c05e209543f161ce93bdc34806d411495b2ecd05a96e32379ebae","nasal":"4ce7bb11373a78aa69310965692cb37702a5aeb2cd97da5b4461d22f33bc6176"}},{"id":"VRCE-2-42-21","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":21,"english":"What happiness can be ours by living with that wicked and unrighteous one who lost to every sense of shame is bent upon exiling the son of the foremost of kings?","alignment":{"type":"1:1","confidence":0.701,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2042021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cb98cb7b83cf091c9400f9e065b5ff93bc0b41e388b0151d9dc0fd3584d375e9","compact":"f9bdef639ac8210828d2992bcecb9fea76223ab745258120acf291a6a7e7db09","nasal":"f9db7f976a4d37bfd224843cc735f438cb9e9d57ecfe793136d3f87cd3999427"}},{"id":"VRCE-2-42-22","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":22,"english":"On Rāma retiring to the forest, the lord of earth will surely not live; and Dasaratha dying, it is evident everything will come to naught.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2042022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"33ea1ac5e9d7e66ac1747da8e0dcaf06ed5f2962e340071aa41419d8f208674a","compact":"4b81a511aeee09b1d472bec7f82c7fdd16a2b37525e42a61db9e7f9e1312060f","nasal":"3b22ff1a90c9b2701f5218b18ea3842a68c9a1a9ed93c13bce31f6cfe4a900c6"}},{"id":"VRCE-2-42-23","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":23,"english":"Do you, your virtue exhausted, and oppressed with grief, pounding poison, take it, or follow Rāghava, or remove to such a place that the very name of Kaikeyī may not reach your ears.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2042023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fcc39cfa1435378222f05cf10597b938e3531e419f128326788b365297aac9f5","compact":"1d3333816e0e566ac846a1d173b7872da739f5e76a17f918a87cb17ed458d926","nasal":"1d3333816e0e566ac846a1d173b7872da739f5e76a17f918a87cb17ed458d926"}},{"id":"VRCE-2-42-24","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":24,"english":"Rāma has been deceitfully exiled along with his wife and Lakşmaņa; and we are bound to Bharata like to a (sacrificial) beast before one that is to slaughter it.","alignment":{"type":"1:1","confidence":0.651,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2042024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2511e6636063aac08677308e13e5d4fc241d4df32117b4aae176b04f72431ece","compact":"cad4d526c39d541c31c26e83d93b384632cf79de0f1cf1f05ccbf5a26195ece5","nasal":"cad4d526c39d541c31c26e83d93b384632cf79de0f1cf1f05ccbf5a26195ece5"}},{"id":"VRCE-2-42-25","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":25,"english":"Thus lamenting in the city, the females thereof burning in grief became distressed like people stricken with panic on the occasion of a plague.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2042025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4dbdbc106a3fa770b6f44ec58592fcdb1d5c11c066797c4cd924ec48b9ab0cd9","compact":"5226bb8e3b44c968e1d79059769f0feacde0bacf6786e5c8b74a1fdcebe87f98","nasal":"e2f69597c7d644c5f1073c20d0b588c51202c0c7ae966ebd2decbe7719a55a7d"}},{"id":"VRCE-2-42-26","kanda":2,"kandaId":"ayodhya","sarga":42,"verse":26,"english":"Distressed for the sake of Rāma as if it was a was son or a brother of theirs that was banished, the women weeping forlorn, lamented with senses lost; and Rāma was to them more than a son.","alignment":{"type":"1:1","confidence":0.84,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-48-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2042026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7af9458a06f1d957ca02cd4ac284821282fd110896fa5672fcb874291272ba7d","compact":"9f482e08807e1680d95e65d6613e9722121531dd7087393c4b590b74cf814aad","nasal":"9f482e08807e1680d95e65d6613e9722121531dd7087393c4b590b74cf814aad"}}]
