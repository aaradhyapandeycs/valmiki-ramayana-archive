[{"id":"VRCE-2-33-1","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":1,"english":"Hearing the words of that worthy, Rāma conversant with modesty, humbly addressed Dasaratha, saying.","alignment":{"type":"1:1","confidence":0.821,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2033001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a1b220fe98e6fd573212c0f9c78d62a3915743e52436cc9d5c2451f59149097","compact":"70997341a8bbaf3a12627251af49c5fe896cd91a0f48b0d5038b55f687a7dc66","nasal":"70997341a8bbaf3a12627251af49c5fe896cd91a0f48b0d5038b55f687a7dc66"}},{"id":"VRCE-2-33-2","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":2,"english":"What O king, have I, that am renouncing everything and am going to dwell in the forest subsisting on what the forest yields, to do with a following?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2033002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c4f8f547418213f09531e88cecac0829db0d48dcc5972680e597387570b090c9","compact":"2580e442de32776583d5a698ef5fefb2f908292d4c17a7f732d905bf5a79e45e","nasal":"b4a1ddcd48a574135e636c9e0d250721f162b1f0d0e3b845106f68440fc262b2"}},{"id":"VRCE-2-33-3","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":3,"english":"Of what avail is a person's attachment for the tether of a goodly elephant, when the elephant itself is renounced by him?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2033003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd7cde9212f1c9fc970d9d38cb72a8914fc77969d6d3b0d3bedd2a8599e15f8d","compact":"ecad30e3750d9a7b4284360019dede3bb006aa055cbf4691b7a3b2148c6a3502","nasal":"44005b9c1a5b8f9d2d72cfd7c5ea4bd6c0ac9755ec62d7861ac79a0a0144a9a4"}},{"id":"VRCE-2-33-4","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":4,"english":"Thus it is with me, O foremost of righteous ones. What shal! I do with the army, O lord of men? I will confer everything on Bharata. Let them bring me a venture of bark.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2033004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"52fb822250f1c94c8e99ab13eb9d4860e5df6aaa8b1011b37f620723e80e31c1","compact":"a743c1f45a9ee7a94ee60cc722e333bdc9829deb48401719563d6392cf4017a3","nasal":"e481793a6728502aced312f167256a3085fcbbeaa3a9d9df164b3909dc8d392d"}},{"id":"VRCE-2-33-5","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":5,"english":"And for me who will go to the forest and reside there for fourteen years, bring a hoe and a basket.","alignment":{"type":"1:1","confidence":0.66,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2033005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6555a33c87ecff57218b30b43ebe5881dc4140611f8e447b55cf0256145f54f3","compact":"ab58162392bfd079457e89c73e962104888baa20bd1d136cf82a13839502ec67","nasal":"ab58162392bfd079457e89c73e962104888baa20bd1d136cf82a13839502ec67"}},{"id":"VRCE-2-33-6","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":6,"english":"Thereupon Kaikeyi herself brought a bark dress and that shameless one said to Rāghava in the presence of all, “Do you wear this.”","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2033006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"58535577d4aaf1c542755e28abd6aa9ac6a4bc1f191ae95c49e50308746d4694","compact":"d0c0d1cea64bf8f0e8c831d1eb0349ddb6b1d0f0452f3087ba57a22a60e740b1","nasal":"d0c0d1cea64bf8f0e8c831d1eb0349ddb6b1d0f0452f3087ba57a22a60e740b1"}},{"id":"VRCE-2-33-7","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":7,"english":"On this, that foremost of men taking those two pieces of bark from Kaikeyi, left his fine attire and put on the ascetic garb.","alignment":{"type":"1:1","confidence":0.932,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2033007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17f167159d896ca35b6f459e614cdf89fbbcfde7ce1f397b7d0371dbfc14ed82","compact":"004f918115dee1088d4c1c3a828df915bdc0b8f6fc6f443dfa6045dc930df581","nasal":"004f918115dee1088d4c1c3a828df915bdc0b8f6fc6f443dfa6045dc930df581"}},{"id":"VRCE-2-33-8","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":8,"english":"And Lakşmaņa also, renouncing his choice raiment, put on the dress of an anchorite before his father.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2033008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d3d123929f5b0fd9ea007362b05112a8c8efc4b42eb3e166c315e56cd5506e14","compact":"b64fd02d9efa9c02d3ef5447edba3806c426520fa94aab1ea7b0680bfa9b88c9","nasal":"b64fd02d9efa9c02d3ef5447edba3806c426520fa94aab1ea7b0680bfa9b88c9"}},{"id":"VRCE-2-33-9","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":9,"english":"Then Sītā clad in silk apparel, eyeing the ascetic covering meant for her, became agitated, like a doe at sight of a noose. And afflicted with shame, that one graced with auspicious marks, Jänakī, sorrowfully took from Kaikeyī the Kuća and bark; and with tears flooding her eyes, that one cognizant of virtue and having her gaze ever fixed upon it, thus addressed her lord resembling the king of the Gandharvas, “How do the ascetics dwelling in the woods put on their dress? Saying this, Sītā, ill at ease became embarrassed.","alignment":{"type":"grouped","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2033009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72380a172de4a844d2196bba8e3425b0c070b2e5321b7b866d293e73bf94ae92","compact":"4202e9dfee514f41cc4d59570551461f1f435ea1a242dee52534fe7e91916023","nasal":"4202e9dfee514f41cc4d59570551461f1f435ea1a242dee52534fe7e91916023"}},{"id":"VRCE-2-33-10","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":10,"english":"Then Sītā clad in silk apparel, eyeing the ascetic covering meant for her, became agitated, like a doe at sight of a noose. And afflicted with shame, that one graced with auspicious marks, Jänakī, sorrowfully took from Kaikeyī the Kuća and bark; and with tears flooding her eyes, that one cognizant of virtue and having her gaze ever fixed upon it, thus addressed her lord resembling the king of the Gandharvas, “How do the ascetics dwelling in the woods put on their dress? Saying this, Sītā, ill at ease became embarrassed.","alignment":{"type":"grouped","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2033010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c17ef1db8dce9e384eb5b4787ed495fbeca0739430d5f68de670f97d9d4d53e","compact":"89a500c79457be160e4360dfaf241f2fffa79b45997f901816efdbae61b6f15b","nasal":"a6892fa27c05463e632851b0217e6f2f46831706e93dee7e0c411682d86107d4"}},{"id":"VRCE-2-33-11","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":11,"english":"Putting on one piece on her neck and holding the other in her hand, the daughter of Janaka, feeling uneasy, stood overpowered with shame.","alignment":{"type":"1:1","confidence":0.719,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2033011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"97983d860a4cd24b2d23dca6dda225d53bf8d984a1c7871c35790f4e217b65ad","compact":"f563094aa1128ef1853ef413b50204de7cfc4ce2db7508d197d29e0a425a1c50","nasal":"138f85f4fdbfb4d89bfe433e8f7f3f37d59aa4e233d473ebe9668b577e8e79a3"}},{"id":"VRCE-2-33-12","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":12,"english":"Thereupon that best of righteous persons, Rāma, speedily coming up to her, fastened the monastic garb over Sītā's silk attire.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-37-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2033012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"039f0a8b67f57a07790225205a0f5083a313bdb543177f485594e5256375ce30","compact":"8a5094481075ebf9abcb865380ae126f15246115573ebfa13bac85f18c6cbca7","nasal":"97f8a9e1ed7c1381ee10d729d0d3e8d37687f3dc03388f8fc13e1269371e6d1d"}},{"id":"VRCE-2-33-13","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":13,"english":"When Şītā, having a husband although seeming as if she had none, was putting on the ascetic guise, the people got into a wrath and exclaimed, “O Dasaratha, fie on you!\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2033013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0093eb75306d542874519fd69b87b8adc3449ba23672648345c0b8a160ef7c8a","compact":"d711bf4a6c52b6eb5f089fd7630f9465694c1080b957838dcc4f6ef0081dd844","nasal":"d711bf4a6c52b6eb5f089fd7630f9465694c1080b957838dcc4f6ef0081dd844"}},{"id":"VRCE-2-33-14","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":14,"english":"Aggrieved at the uproar that arose there in consequence, the lord of earth banished from his heart all regard for life, virtue, and fame. And sighing hot, that descendant of Ikşvāku spoke to that wife of his, saying, O Kaikeyi, Sītā deserves not to go in a Kuća dress.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2033014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b61f491e1a7a75abd1300736d8f4762efb53203085d6ce9c9ee78398fad9e2aa","compact":"b55c3756d205484dbb8d5ec86d525298b17e438da5a140a20d8f8ca132a88c6c","nasal":"8aa6f9cf439bb48900098e5d74cf9844cf728e532f7a7742b7ccbe27d5a428fa"}},{"id":"VRCE-2-33-15","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":15,"english":"Surely, O nefarious one, the banishment of Ráma is enough for you. Why then do you bend your mind to perpetrate these atrocious sins?","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2033015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"92de85a7bc8a71f66acbbcbdfd0bdc0a7042b7d97835550eb9848b385ab30833","compact":"a4d0a98542132a6dbb94c9e6ff0b9093d85cd3684c5956b143783d70b6d14ec8","nasal":"a4d0a98542132a6dbb94c9e6ff0b9093d85cd3684c5956b143783d70b6d14ec8"}},{"id":"VRCE-2-33-16","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":16,"english":"Thus commissioned to the forest, Räma who was seated sealing his lips, said.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2033016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f34959c6064b5de41a3b5a8d00a42b528ab4c9539301ed5b6e9bc9e1f5301190","compact":"c5eaaefeff859cd03444a9b9f26c2f8ebcf9504cd544a10ceebcda4c406fe2cb","nasal":"8fc2eb165a7b815c5a04b6d30f16735f1b0f9fd9b85da25d06eeeff4e11446c5"}},{"id":"VRCE-2-33-17","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":17,"english":"O righteous one, this my mother is aged and famous and of lofty spirit. May she not meet with improper treatment at your hands! It behoves you, O bestower of boons, to show greater honour to her when she shall be deprived of me and be plunged into a sea of grief and afflicted with unprecedented woe.","alignment":{"type":"grouped","confidence":0.951,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2033017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d22930ff85da9ad7e3701fd0d06a8819a1e5e104b722758b8d7752f64dd8b58e","compact":"66815e36754c3d139a55da0386da6769283406c0d97c9044048e109b0a59ac6e","nasal":"66815e36754c3d139a55da0386da6769283406c0d97c9044048e109b0a59ac6e"}},{"id":"VRCE-2-33-18","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":18,"english":"O righteous one, this my mother is aged and famous and of lofty spirit. May she not meet with improper treatment at your hands! It behoves you, O bestower of boons, to show greater honour to her when she shall be deprived of me and be plunged into a sea of grief and afflicted with unprecedented woe.","alignment":{"type":"grouped","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2033018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9ae77eea438f26b82d0201a58b87c2fff31e5304002d4f205a516de199be427","compact":"cd5f6f222b5b3fceaf063db4da7a990f275e95103b652c3a45e655b7d5445805","nasal":"ee9376399256ccc43c4ab6e23b5df20792f0e4820e6850ccee110363c89439fc"}},{"id":"VRCE-2-33-19","kanda":2,"kandaId":"ayodhya","sarga":33,"verse":19,"english":"O you comparable to the mighty Indra, you should so behove with my mother smitten with my separation, that exercised by grief in consequence of my residence in the forest, she may not, renouncing life, repair to the mansions of Yama.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-38-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2033019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e778a412cee109a7e7f0a98f70627c9c2c4d35f2a72d20b6eee27a334412dc4f","compact":"bc110d79e012253eab3f6b2df414e6cf21cfe05b5b18fe51939d4a7881338fdc","nasal":"82d5a874229b4652d3293131b9ad64d29774b9c08a86afada6d16497a34c2f24"}}]
