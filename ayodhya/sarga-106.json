[{"id":"VRCE-2-106-1","kanda":2,"kandaId":"ayodhya","sarga":106,"verse":1,"english":"Arriving by means of a car emitting a low and solemn sound, that lord, the highly famous Bharata speedily entered Ayodhyā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-114-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2106001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c5363c144fb82f64159f07911c12cfb900f7300522bf61ce3e250b4003942a8","compact":"bece1fee807f0de04dd1b9d2e598757d1a927c6e8fc976b3827af954641f13cb","nasal":"77a03dc44321830f4968b2fd72454c0e46abbe01eb5664b46a65296ca8b9e229"}},{"id":"VRCE-2-106-2","kanda":2,"kandaId":"ayodhya","sarga":106,"verse":2,"english":"Ranged by cats and owls, with the doors of the people's dwellings remaining closed; like a night enveloped in darkness gloomy; and invisible; resembling the beloved wife of Rāhu's enemy, Rohini, brilliant with the lustre of the latter, when she is forlorn in consequence of her lover being afflicted by that planet.","alignment":{"type":"grouped","confidence":0.982,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-114-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2106002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"94bd6366f559fdd15cb8e36f3038698f25f86a6dbed3f7d16061e3838f666b42","compact":"fc497ec84bc41032fd0139b7f8102734f2626621c810a0994d4321479d5d81f4","nasal":"fc497ec84bc41032fd0139b7f8102734f2626621c810a0994d4321479d5d81f4"}},{"id":"VRCE-2-106-3","kanda":2,"kandaId":"ayodhya","sarga":106,"verse":3,"english":"Ranged by cats and owls, with the doors of the people's dwellings remaining closed; like a night enveloped in darkness gloomy; and invisible; resembling the beloved wife of Rāhu's enemy, Rohini, brilliant with the lustre of the latter, when she is forlorn in consequence of her lover being afflicted by that planet.","alignment":{