tRefs":["DUTT-2-7-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2007016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f2fc8c86fc480d1156701de5efa3ce529c97bc2984d7fb304c78e64738e89ca3","compact":"47dfb39fc37eaaf39f630db30e6040a832cf19f3f96be4f76bbeee9478006866","nasal":"47dfb39fc37eaaf39f630db30e6040a832cf19f3f96be4f76bbeee9478006866"}},{"id":"VRCE-2-7-17","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":17,"english":"I have been sunk in a fathomless fear; and afflicted with grief and heaviness. And as if burning I, seeking your welfare, have come to you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2007017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1be28fb4a702e60ef12a03243e093f1acc0764251695dc50670519552526b1a2","compact":"ab51f9af42ea9ec59b03e13372ca0f83cab5a4e3fb5aa014d4e79f2c7551fdc8","nasal":"ab51f9af42ea9ec59b03e13372ca0f83cab5a4e3fb5aa014d4e79f2c7551fdc8"}},{"id":"VRCE-2-7-18","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":18,"english":"For, O Kaikeyi, great wax my grief on witnessing your sorrow; and my advancement progress along with you there is no doubt about this.","alignment":{"type":"1:1","confidence":0.707,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2007018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"06b3affd740bea9d43eb99c7b890520018214f1a18d1546cf6b04fefe645865b","compact":"0244f5156217690fc49c054f9837fd80359e93c9284073f5070b89c9f9cb8675","nasal":"0244f5156217690fc49c054f9837fd80359e93c9284073f5070b89c9f9cb8675"}},{"id":"VRCE-2-7-19","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":19,"english":"Born in a race of king you are the queen of this lord of earth. Why did not you then realise the sternness of royal morality.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2007019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"002525cb05668f149618e55ada7d766c257ec1baa6761b6750e542050519d274","compact":"91c77c3a8ecca8fdc710d8f14ab7b79a0a0a32ee51145e712a3c22722ea247ec","nasal":"91c77c3a8ecca8fdc710d8f14ab7b79a0a0a32ee51145e712a3c22722ea247ec"}},{"id":"VRCE-2-7-20","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":20,"english":"Your maintainer speaks most morally; but is crafty for all that: he speaks blandly, but has a crooked heart. Him you take as of blessed condition, and therefore are gulled.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2007020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f061cfe63b4dfc782208a035a185cb687118d4d4a18fa4d474b19279809e16d6","compact":"22ecf57cedf145842a3dc01ae15c238848e507743841de426aa9381f74710f61","nasal":"22ecf57cedf145842a3dc01ae15c238848e507743841de426aa9381f74710f61"}},{"id":"VRCE-2-7-21","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":21,"english":"Speaking to you soft words bare of substance, he will, his heart on the alert, to-day compass the welfare of Kausalyä.","alignment":{"type":"1:1","confidence":0.757,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2007021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"223bf09e1b73c33e3529f41e1ded325ae506ec814171ee859b5aadbc4c34911f","compact":"4246f2c31b3af5e8534123f33f7fea2042089c977bf6f4181a3c740a3691c7fb","nasal":"f3bd0cc98f401760f3384b13c745e7a2035e9dc64a2131b7d0c33350cfec81be"}},{"id":"VRCE-2-7-22","kanda":2,"kandaId":"ayodhya","sarga":7,"ver