[{"id":"VRCE-2-7-1","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":1,"english":"A woman, brought up with Kaikeyī, who formerly served as a maid-servant the family of her maternal uncle, at her own will, ascended the palace resembling the moon.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2007001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"28decd6049a87dcb72cca127f9c56dc2e91fa9794a5fe55d1a24a43d9fd942b3","compact":"8d9417527bdee58ca0f525e19bdcdab3aa505b08507e961f375822fad7b06dbf","nasal":"57207f99b32801361d6d6710f3c6c977a7a4217dbced07bef7da8f78ed224d9b"}},{"id":"VRCE-2-7-2","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":2,"english":"Mantharā beheld from the palace the highways of Ayodhyā well watered all round, and strewn with lotuses, and adorned with standards bearing gay pennons.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-7-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2007002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"57044216db75b1aae0d29c21f6f61c44cf34d9dd9f2ee294c1b8e63db831025f","compact":"d905bb0cbc639eafc21794fd9720dd0aa151c0dd9f6fbe9c7cb2347c32d1080d","nasal":"62c7148c00a597959d81fb59dfb6c71e9f5c3e84b8afb535ce230f7e753b4ddd"}},{"id":"VRCE-2-7-3","kanda":2,"kandaId":"ayodhya","sarga":7,"verse":3,"english":"With thoroughfares and roads leading along undulating lands; sprinkled with sandal water, and crowded with men who had performed their ablutions, and echoing with the accents of regenerate ones bearing garlands and sweetmeats in their hands; and resounding with the sounds of musical instruments; and filled with many folks; and singing with Veda chantings; and with its horses and elephants delighted, and cows and bulls emitting roars.","alignment":{"type":"1:1","confid