shEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b4a0dc709bddf7aaac62e8de1ddf9817bf8d323af2f8efbf6f8d9f57959ede0","compact":"2e2708a213887c6403813b4f0261b1f9e69b8028857fef287e3b997c993aae9b","nasal":"178d6e0ed2ccf31eb5b40de806e9010bed121f6c6f3d0a644f31348386ce2504"}},{"id":"VRCE-2-108-7","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":7,"english":"Does not Sītā engaged in serving you, having to serve me, now minister to you as a woman should?","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2108007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3a2f6d1c38ac7bac31b05426a24a816b7a92d08bd8237d7d8db22fe8cc2dc9c","compact":"89efdf1adf5577dcffb8adeee7b7a47c4c1ece11c037a0b229026ecff61ee6cc","nasal":"89efdf1adf5577dcffb8adeee7b7a47c4c1ece11c037a0b229026ecff61ee6cc"}},{"id":"VRCE-2-108-8","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":8,"english":"Thereat a certain aged and decrepit ascetic, with his frame trembling said to Rāma ever kind towards creatures.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2108008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8ec602adecc94feebbfc77e75de0c544ce4c5ce1f5cec16d8f81e28facb65aa8","compact":"2ab47a400fd0439d214b66eb306458fa617ad4fa49a9e5a72fce437ef5a19b66","nasal":"2ab47a400fd0439d214b66eb306458fa617ad4fa49a9e5a72fce437ef5a19b66"}},{"id":"VRCE-2-108-9","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":9,"english":"Where is the falling off of that one of excellent character, engaged in offices of beneficence,-more specially with reference to ascetics?","alignment":{"type":"1:1","confidence":0.839,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2108009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"59d399364e101f034ff056553bc8d27fdd4e6b2e92cf46e368425afd59c410ad","compact":"807359335df985b58d5b214caeefd7bae286bd3914c30721bfb427e206e7394e","nasal":"807359335df985b58d5b214caeefd7bae286bd3914c30721bfb427e206e7394e"}},{"id":"VRCE-2-108-10","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":10,"english":"This fear arising from Rākşasas afflicts the ascetics because of you; and they, extremely agitated, converse with each other (on the subject).","alignment":{"type":"1:1","confidence":0.928,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2108010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"028142be8a08f60947fe51796cb4ab5cc36cbea306e39954a7325d42e9ec3d43","compact":"b935ad42050d68989c9687df4d96ec24096b8f3dc6b9f5afd77fb4955ec5fca8","nasal":"3361c2f01ea8cbe38fcdc2c3f4c373080de92e9acc9c57c5e2900b81976ef41d"}},{"id":"VRCE-2-108-11","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":11,"english":"A Rākşasa named Khara, a younger brother of Rāvana, has been harassing the ascetics dwelling in Janasthāna. And Dhrsta also a fearless and wicked Rākṣasa feeding on human beings, and the unrighteous Avalipta, cannot bear you, my child. As long, my child, as you have been residing in this asylum, the Rākşasas have been plaguing the ascetics.","alignment":{"type":"grouped","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2108011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7c9d1d9abeb4c88eb10247ab4711bd49500a72e932f0efa378ae6f4fecb467e3","compact":"38e179d4573318993c364d312e0bc2690002e74a5e98bc6202cbff0fb4c461e6","nasal":"d4a2c3e765a90ada9a29fc19f35976d7f123af5a246b768ba66708ec0cb887a6"}},{"id":"VRCE-2-108-12","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":12,"english":"A Rākşasa named Khara, a younger brother of Rāvana, has been harassing the ascetics dwelling in Janasthāna. And Dhrsta also a fearless and wicked Rākṣasa feeding on human beings, and the unrighteous Avalipta, cannot bear you, my child. As long, my child, as you have been residing in this asylum, the Rākşasas have been plaguing the ascetics.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2108012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"464e3d848a139d329f00ed00f20b7432f2a29010b3c37825e77436d66adac472","compact":"6946e1b3c7a415fea5194586d027b07b03a4fa4e23cb43329a6a2d1325c7cc30","nasal":"6946e1b3c7a415fea5194586d027b07b03a4fa4e23cb43329a6a2d1325c7cc30"}},{"id":"VRCE-2-108-13","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":13,"english":"A Rākşasa named Khara, a younger brother of Rāvana, has been harassing the ascetics dwelling in Janasthāna. And Dhrsta also a fearless and wicked Rākṣasa feeding on human beings, and the unrighteous Avalipta, cannot bear you, my child. As long, my child, as you have been residing in this asylum, the Rākşasas have been plaguing the ascetics.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2108013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"631704ff6e1fe954be2e6eb90d056fac04cec8e8eea9b59ea9d07b377ad0cdef","compact":"8c3228fffb0af2f16293c2765a8ebf2871355b8f473d81fef97c1ddec0f32745","nasal":"2cf35f0f3bd34af934664580d065e1ba83a244cf43249929d1e0fd36d4788f11"}},{"id":"VRCE-2-108-14","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":14,"english":"And they show themselves sometimes in disgusting shapes, sometimes in horrible and dreadful ones, in various frightful forms capable of frightening folks. And they throw execrable and unclean things among the anchorets, and torment those that happen to come before them.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2108014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de257096ed770c399be76e92e846ab86aa5a5dcbe6ad0c981031c817d836cbfe","compact":"ca434055e7c903e79f661ffc2395a096bab89da9487eb68400cfdeb449e79032","nasal":"f959e4df839e8a0be89ac4b93533b6f81a7813a9f70538c8976c9b40b88ddb77"}},{"id":"VRCE-2-108-15","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":15,"english":"And they show themselves sometimes in disgusting shapes, sometimes in horrible and dreadful ones, in various frightful forms capable of frightening folks. And they throw execrable and unclean things among the anchorets, and torment those that happen to come before them.","alignment":{"type":"grouped","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2108015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4147d79f6596302fc3f982db98db7b8c4c682608a77ee4a5357350a09dc5a393","compact":"756ab54685682d5552f8fbc548b8f433187888dec43e980d3bb9fc7ba3b13dfe","nasal":"02ef530368891012ffd976f85496d89199486e4f366d7e86170b981eaa0b4755"}},{"id":"VRCE-2-108-16","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":16,"english":"And they take delight in approaching asylums unperceived, and slaughtering ascetics, after having bound them by means of their arms.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2108016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4635632f64a9f73907f2a33d396c19e5779063d3bf027c23432cf2a81356ebe5","compact":"fa81d671c37881995801ba68321343d428b64bc0b2c6f7a62767aa34ba7b806b","nasal":"5e911d9b92a3ade1fc7a6e9fb1532a225601d1f35d65654799811a2b4173a29e"}},{"id":"VRCE-2-108-17","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":17,"english":"And on the occasion of sacrifices, they throw away the vessels containing sacrificial articles, pour water on the sacrificial fire and break vessels containing water.","alignment":{"type":"1:1","confidence":0.819,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2108017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"524132ae366de58c9b0c7f9d137fe151c6102b9f21e8b63b298e7677a0b3fe51","compact":"3bf72a5144622cfc67128453dbbdb838a80b12189e6461b3117e64afb7fe45f4","nasal":"7c4a037b0c60367dd5f6f22d19756ff54734a4fb76af49cc88df9e1ac24eca09"}},{"id":"VRCE-2-108-18","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":18,"english":"Eager to renounce this asylum infested by those wicked ones, and removing to another place, the sages today have been exhorting me (on the subject).","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2108018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b56ef5565e230547f61bef959b99d02cb7761bd065c268c9545392bdb8aa79c1","compact":"5d81937fb0ac41d2b674b646d75cf72778ce68231f45f4285c003051dc7fbb2d","nasal":"cd237ed58041f6e71dd5db48c48a192a5c96ac6e4427f65d2662750cb11127fe"}},{"id":"VRCE-2-108-19","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":19,"english":"And, O Rama, ere this, those wicked ones have slain ascetics. Therefore would renounce this asylum.","alignment":{"type":"1:1","confidence":0.769,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2108019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d8e6fbc01c6c7f9dabd7e8288a6f62757565d8f137b878eab8e40e1daed5c3aa","compact":"f094dc99d6c3c033ff575b18303c2bef3bf3762d9de83cc2a31f865b1a3cd43f","nasal":"f094dc99d6c3c033ff575b18303c2bef3bf3762d9de83cc2a31f865b1a3cd43f"}},{"id":"VRCE-2-108-20","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":20,"english":"Not far from here is a picturesque wood abounding in fruits and roots. Thither shall I betake myself together with my own folks.","alignment":{"type":"1:1","confidence":0.782,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2108020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e90e2ecf8e7ca248e36f40eed2d8fef16dec704f20f0054ebeb6fddc6d7cc810","compact":"6e908c5775904de19272973a5ca2d508ca4ff8da61709f9f5ef470da57e74571","nasal":"86cde88141c6116176382a4e9d03320ad11ae26ddd634cf0474183e8788fb223"}},{"id":"VRCE-2-108-21","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":21,"english":"Khara shall also annoy you. If you think it proper, go hence in company with us. we","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2108021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3fb1f1db5b0788ee7a3c4c7e796cfbe10d4ff7706a64230fca1d59ea5034dfa","compact":"58420be311cca42b4c406f67557ea1956ab40035d9e8fe124a0e39f7819c5017","nasal":"58420be311cca42b4c406f67557ea1956ab40035d9e8fe124a0e39f7819c5017"}},{"id":"VRCE-2-108-22","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":22,"english":"O Rāghava, although you are vigilant, able, and in all ways capable, it would be unpleasant for you to dwell here now in doubt.","alignment":{"type":"1:1","confidence":0.544,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2108022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c98f81790291aa79977e6916774e82f103e7ef21f6455b2253201d27cb245ac","compact":"8cbacf3bf85bd4b79b69132d8ba1bdfc1845fe62166a7bb57b40398f78feb305","nasal":"8cbacf3bf85bd4b79b69132d8ba1bdfc1845fe62166a7bb57b40398f78feb305"}},{"id":"VRCE-2-108-23","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":23,"english":"When the anxious ascetic had said this, Rāma could not console him by his words.","alignment":{"type":"1:1","confidence":0.814,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2108023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02438e7deb21ee09bc63d4357bf2d24d1a451968a0bc6b11f6b471d6b05b1bd9","compact":"98b3e98a6f099f7d67ff55f8b86d0b834dc20bb0c96fab6e1404ebe632261bb3","nasal":"a7be8d2dcb1dd38f29e9018305ad6020e24b79959358c65b03cc33fba9f142df"}},{"id":"VRCE-2-108-24","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":24,"english":"Then having paid homage to Rāma, and spoken to him and encouraged Rāghava, the patriach ascetic renouncing the asylum, went away along with his own people.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2108024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"147b72464dfe671240eb8b9f2fba73a1351d8ef152cfdee55b972b35ae9fd7c3","compact":"fc7a960e91d49914edca0b79f4a914602af6b3a5e28ab111c34d686caab81ab7","nasal":"2acc311d3b6389b4de738aa23cd4d2d065fb0abde5befb51d58728a88eb927b1"}},{"id":"VRCE-2-108-25","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":25,"english":"And Rāma having (for a time) followed the sage who was departing from that place, and having paid him respects, being permitted by them, well-pleased, and advised (as to what it behoved him to do), came to his quarters reposing there.","alignment":{"type":"1:1","confidence":0.695,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2108025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0456dd46685e14e3deaeb0d4abd97e40c60610eea6c1baad67730a38cf8a384a","compact":"96c581ec7c1fc0dd914b8444ca4d54d7818c47aab55a7efc14b3a8ae0ae337ee","nasal":"96c581ec7c1fc0dd914b8444ca4d54d7818c47aab55a7efc14b3a8ae0ae337ee"}},{"id":"VRCE-2-108-26","kanda":2,"kandaId":"ayodhya","sarga":108,"verse":26,"english":"(Thenceforth) Rāghava never for a moment left that asylum forsaken by the sages., Rāghava having such qualities in his character as were likely to stand the sages in stead, the ascetics (that remained behind) ever followed Rāghava.","alignment":{"type":"1:1","confidence":0.39,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-116-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2108026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"89218c2b4514c6bcd10e340c3e4ad03e831578612ab7e9b62d903feaa870aab7","compact":"2279e624c3390e45e5d1babae43d9508a1d33449b48297f9b1bb37feced2f0e4","nasal":"2279e624c3390e45e5d1babae43d9508a1d33449b48297f9b1bb37feced2f0e4"}}]
