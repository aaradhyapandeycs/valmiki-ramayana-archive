am02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"805e7e208db2cfa15a24fdb0a387d32f4f4e084526ea2738ec07ea19a73df886","compact":"3dc9a3bcc4ed1c44ec0c12257b8396358db8777d448d84fe5aee702f1add4863","nasal":"3dc9a3bcc4ed1c44ec0c12257b8396358db8777d448d84fe5aee702f1add4863"}},{"id":"VRCE-2-1-35","kanda":2,"kandaId":"ayodhya","sarga":1,"verse":35,"english":"He therefore gave them to understand that the installation of the high-souled Rāma of countenance resembling the full moon would dispel his grief, at the same time that it would be universally hailed by the people. Therefore, influenced by his affection (for his subjects,) and with the view of compassing his own as well as their welfare, the righteous monarch urged expedition (upon his counsellors;) and that lord of earth brought together the prime and noble from the various regions and countries of the earth.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-1-40"],"status":"unreviewed"},"source":{"sanskritLocator":"2001035","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4935ccfc65ec753d863e33ea31641544009a3434a547ce7d282db93597f46df9","compact":"8becd69915217b47100b7925fb9ba7e5eb4f35c5f1c5f8fd8fdbd73404bbde84","nasal":"8becd69915217b47100b7925fb9ba7e5eb4f35c5f1c5f8fd8fdbd73404bbde84"}},{"id":"VRCE-2-1-36","kanda":2,"kandaId":"ayodhya","sarga":1,"verse":36,"english":"Facing and eyeing the monarch, those kings sat them down on different seats pointed out by the former.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-1-44"],"status":"unreviewed"},"source":{"sanskritLocator":"2001036","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"70725afc66f42893c87e447d704cc31a301533fd6d2c0dfaaa605fc984af9226","compact":"59e6f3e136002c105a3f1aea1853468d7170a3a32bacb5f2028d8f0964ecb822","nasal":"59e6f3e13