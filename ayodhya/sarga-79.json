"},"sanskrit_fingerprints":{"exact":"2931f02d04cb2c3953ee76c0959d01a199e69d37132a12a15c8ebe245f546e2d","compact":"9fcc72ff53e04e98cbe46d6fcdea3c1a556e7d11f92f058725344ba12bc7f8ab","nasal":"d433065e53c9f8edd851fa996ca57a9ab9cfb228d031eb0b542afd5da9f75b17"}},{"id":"VRCE-2-79-10","kanda":2,"kandaId":"ayodhya","sarga":79,"verse":10,"english":"I go to make Kākutstha dwelling in the woods, turn back. Other intention cherish I none. O Guha, this I tell you truly.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-85-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2079010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"717ffa695f71ab9fb16dd24dc35e520c3c63669279b4ec49527f561afe1cdbb7","compact":"66ea03c2815e2911ff6eacdc300a2e192e4d84b7d4d279feb9f1c292040353f3","nasal":"dfda642a1c96f9c524f733acaa8019a9276f06096d553948f59e1268b8979d2c"}},{"id":"VRCE-2-79-11","kanda":2,"kandaId":"ayodhya","sarga":79,"verse":11,"english":"Having heard Bharata's speech, Guha with a countenance lighted up with delight, again cheerfully addressed Bharata, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-85-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2079011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05f9c2c6fbb7ba17a6f61132b8e50eb298afa5f40a95d21539ec71a61dbfe117","compact":"eb0b73586b784667f155db3f13daf6e071ba4287ce079e02f98fb5c6ccb5e320","nasal":"ddcac6eacc7d8ec4557fb0f7a78cd00d208d23316fad693694309dd48291903f"}},{"id":"VRCE-2-79-12","kanda":2,"kandaId":"ayodhya","sarga":79,"verse":12,"english":"Blessed are you! Your like find I none on earth, inasmuch as you wish to resign a kingdom that comes to you without search.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-85-12"],"status":"unreviewed"},"source":{"sanskritLo