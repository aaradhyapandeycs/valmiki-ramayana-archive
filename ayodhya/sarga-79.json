[{"id":"VRCE-2-79-1","kanda":2,"kandaId":"ayodhya","sarga":79,"verse":1,"english":"Thus addressed, the exceedingly wise Bharata answered the lord of the Nişādas, in words fraught with sense and reason.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-85-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2079001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a50f07b899b70442841387998b5ec6f06cde7df2aee4a199faa904b69ae607b9","compact":"e05cab5076e1eb8ad53acc321a7a044dadf6f0433f7db54660f801c970d06b5c","nasal":"1733dd861f509c2ccb76ab1aad005a78d04ee5078441edb75f6a493380dc46a2"}},{"id":"VRCE-2-79-2","kanda":2,"kandaId":"ayodhya","sarga":79,"verse":2,"english":"Your great desire, O friend of my superior, is surely as good as attained; since you of mighty energy have set your heart on entertaining my army.","alignment":{"type":"1:1","confidence":0.607,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-85-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2079002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"849957b433f3b6702700017e80542d4ea9bf4cc1c40bfba107596b79cef344a0","compact":"3437b4401e7e1460470eb2b32e3bfd2f25d6727033fe8d38ab3c312cffa38b94","nasal":"3437b4401e7e1460470eb2b32e3bfd2f25d6727033fe8d38ab3c312cffa38b94"}},{"id":"VRCE-2-79-3","kanda":2,"kandaId":"ayodhya","sarga":79,"verse":3,"english":"Having said these fair words to Guha, the graceful and highly energetic Bharata again addressed the lord of Nişādas.","alignment":{"type":"1:1","confidence":0.609,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-85-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2079003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"94cc15a1aa25a76724d05502aae574c48d71e1f643e4ad6e0e1be3074dfed963","compact":"104dd6a5cfcb63de67b1cb68110fbc2fb9eb35519f8c3efb629064