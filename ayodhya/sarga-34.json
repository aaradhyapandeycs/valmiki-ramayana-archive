:"af8a2d7fd938d62c644373415a4f2e0e89d6e61785c4fb25502179eb2693458f","compact":"9c9c89cb7a54754442c8b9fa95687ba90449f27d115d4f36b6319032e6e0ab83","nasal":"cd6ef6b4fe1782359fc92b9999a8160d35aec3fa446ef8ed55534bf19b5bbdc4"}},{"id":"VRCE-2-34-21","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":21,"english":"Therefore although my son is going to be banished to the woods, you should by no means disregard him. Whether he be wealthy or poor, he is to you like a god.","alignment":{"type":"1:1","confidence":0.741,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2034021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aae4149ab4f69f4f46f7415ef8ba19104a31974f47fce495e8d11c3afcdec489","compact":"2d11a0da9b09571dff21f9eecde3cf223bad1fdae992b48e353983b38e252062","nasal":"f22c77a5386e36b18a69b07d759a248167cefcff1f428a451f34085912a50d40"}},{"id":"VRCE-2-34-22","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":22,"english":"Hearing her mother-in-law's words fraught with virtue and interest, Sītā facing that lady, said with joined palms.","alignment":{"type":"1:1","confidence":0.785,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2034022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cbe15fc26037aa0af4d38e68e98f498c2a6cb83c32772112d63dde3e9d9a142b","compact":"bd8539c09600de672a2f914ce01b2fe14bc842ac98e3be0cd038f786addea25b","nasal":"1e00469d073e3ca4ee95e72b3681db4388243d7ff217e32f3164bcd132e9a553"}},{"id":"VRCE-2-34-23","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":23,"english":"I will do all that the noble one says. I know how I should act by my husband. I have heard all about that (from my parents.)","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-26"],"status":"unreviewed"},"source":{"sanskritLocator":"2034023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a5e1c355bcd6c56e0b00d82a52a005d9d4c918cd5b5e7ce8fba44eee6a31628c","compact":"26b83bd9926d6954f2e904d64906e2ecbb88cd36eebd0f8e7461c361d7de4430","nasal":"26b83bd9926d6954f2e904d64906e2ecbb88cd36eebd0f8e7461c361d7de4430"}},{"id":"VRCE-2-34-24","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":24,"english":"The worshipful one ought not to place me on the same footing with unrighteous persons. As brightness does not depart from the moon, so I cannot swerve from virtue.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-27"],"status":"unreviewed"},"source":{"sanskritLocator":"2034024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a39c3e4a0fd13d0680f88753ddce6579072ff9c05dbbd46b1b6c0a75b31b008","compact":"bba3761a7c2bb561c59d30ee85591bc321de294850623a6f53502dea3f4e7b95","nasal":"7a202eac52c1b0411f82e2cd7379cc2c88a697153ad903dd79dfaceadfc2e77c"}},{"id":"VRCE-2-34-25","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":25,"english":"The Viņā without strings does not sound; and the car without wheels does not move, so although having an hundred sons, a woman without her husband cannot attain happiness.","alignment":{"type":"1:1","confidence":0.683,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-28"],"status":"unreviewed"},"source":{"sanskritLocator":"2034025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d31fccd11e9778ef64fbd6db4ffe2ac7106f84ddbe0238be81de8d73c2e8263","compact":"eeb51e74689dd498976f54826a29c80ed984df497ee7f47fa4158894e52dae58","nasal":"3ba0c4242376e929a19aeff3163c11adf0ae8daaf6d1190ea6993368ace3e57a"}},{"id":"VRCE-2-34-26","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":26,"english":"The father gives in measure, the father and the son give in measure, but who does not worship that bestower of riches fineless', the husband?","alignment":{"type":"1:1","confidence":0.696,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2034026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e4662b2ab111bebf1c5b1a649d47479638d720ac387c8473c1cdea0fea65dca1","compact":"f389acf3aa6dd1e8f76964d7192eba60ada26e404413c64ebb1c81f7df9192a8","nasal":"f389acf3aa6dd1e8f76964d7192eba60ada26e404413c64ebb1c81f7df9192a8"}},{"id":"VRCE-2-34-27","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":27,"english":"O exalted one, having learnt from my superiors the principal as well the minor duties, shall I disregard (my lord)? A husband is a deity to the wife.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-30"],"status":"unreviewed"},"source":{"sanskritLocator":"2034027","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c87ebd72571eb53229b8be7038ef7e38b5b1a8aa525255b3a4cecb8033430379","compact":"73962eacf73fcb9a6e9a023c84293c6e0c0993bc8222478e1531b98b6da49173","nasal":"73962eacf73fcb9a6e9a023c84293c6e0c0993bc8222478e1531b98b6da49173"}},{"id":"VRCE-2-34-28","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":28,"english":"Hearing Sītā's words which went directly to the heart, Kausalyā endued with purity of spirit, out of fullness of bliss and bale suddenly shed tears.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-31"],"status":"unreviewed"},"source":{"sanskritLocator":"2034028","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d436da65c344fbabbbe457e1ac313decca32fdead100a7f0838e85ce3be29c8d","compact":"57273f5684c9bf07bbdf2cca7f39d96d05aebd7d92bfcbeb6f6ae955278ad777","nasal":"57273f5684c9bf07bbdf2cca7f39d96d05aebd7d92bfcbeb6f6ae955278ad777"}},{"id":"VRCE-2-34-29","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":29,"english":"Then with joined hands that foremost of virtuous ones addressed his mother, who, duly honoured by all, was seated in the midst of his other mothers, saying.","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-32"],"status":"unreviewed"},"source":{"sanskritLocator":"2034029","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a77ed3fc9b8af3c540ea5ba188af63725b2ee6afd35fac41702c8e2bdfee3dfc","compact":"337bd8a0417209c90b647fa2b645f61b486dd38db99ae3ab751336a5885ecd9b","nasal":"e72eb14276f5b1cb0d2cf32a0f1e7eed1254d73ce614f287d9a4edf378da6d5d"}},{"id":"VRCE-2-34-30","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":30,"english":"O mother, without indulging in grief, you should minister to my father, and the term of my abode in the woods will shortly expire.","alignment":{"type":"1:1","confidence":0.597,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-33"],"status":"unreviewed"},"source":{"sanskritLocator":"2034030","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b5a233a0da7c6eea6be7810e3f2d8368afdff83fa5d24c331d1a9b27b74c03cd","compact":"bf5993d61233170abb79542ffceb4092e0febf589edb206ee0f7dbadf359d72f","nasal":"74ec95b00dea004f5f9c26f17c0e3b99cce17769d6656ad503318bf4a509bb2e"}},{"id":"VRCE-2-34-31","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":31,"english":"You will find these five and nine years pass away as if in a sleep. Then again, getting me, you will see me surrounded by my friends and relatives.","alignment":{"type":"1:1","confidence":0.563,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-34"],"status":"unreviewed"},"source":{"sanskritLocator":"2034031","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e3ff3c5fc3739de82c4a8a2cc068dc17e82b5c0517a419c898e5265acb1122e","compact":"aa12a00cd2e10034a12327