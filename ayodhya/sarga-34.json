[{"id":"VRCE-2-34-1","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":1,"english":"Hearing Rāma's words, and seeing him dressed like an ascetic, the king in the midst of his wives was deprived of his senses.","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2034001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"71739434c212f62b62193177e3b32900ae72df2472fa53ef999984680366ff0d","compact":"59c3b3f47a6e9da8e39f1d7316a5e3ef52b84b3b5d664c2bafeb265a71bd1cd2","nasal":"59c3b3f47a6e9da8e39f1d7316a5e3ef52b84b3b5d664c2bafeb265a71bd1cd2"}},{"id":"VRCE-2-34-2","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":2,"english":"And burning in grief, the king could not eye Rāghava, nor seeing him could that one of arilicted mind answer anything.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2034002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"afb8ae9197b0a7c1540b3676dc432d431467b307ff73b7dcdd2f6d6818a8bea5","compact":"dae42df333224d50675de2b7edb5d6ca4c5393ae9d1985c3aef40eb4a3e69cf0","nasal":"dae42df333224d50675de2b7edb5d6ca4c5393ae9d1985c3aef40eb4a3e69cf0"}},{"id":"VRCE-2-34-3","kanda":2,"kandaId":"ayodhya","sarga":34,"verse":3,"english":"Then remaining unconscious for a while, the mighty-armed lord of earth oppressed by grief began to bewail, thinking of Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-39-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2034003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a288fdcc878e22438b0c3f63684f28978428ce3ad2e649b719098ba6f6f28a18","compact":"7abe2ce5784d6bd4972049077fe769e36078310cbbf59c78b5841e8537903328","n