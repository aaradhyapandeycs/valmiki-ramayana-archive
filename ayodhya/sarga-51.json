krit_fingerprints":{"exact":"51771df65d24315bef9b8ce7b66fe7be4c20106d41fee0daa5f17d2a90ccb913","compact":"2dad74059aa63e05412969c517f7dd6ed9f056c88bc6effecfd7ea6ccb616638","nasal":"25e14776d20bf572b7d7bd540dd456fbf5618af721a0ee1677bbc55816caecad"}},{"id":"VRCE-2-51-14","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":14,"english":"With his face muffled, Sumantra proceeded on the highway towards the palace of Daśaratha.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2051014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2bd73b11ae67db21ad70ce2266fb0f544cab5edbd5eebf318767f2b65b1ee1a1","compact":"5bc694e7e8fb3bc180eb39bf906f334d175d06deef8ab52d14c0373eb91614d1","nasal":"b83a33917a2b703d7c9f5dd584efd2d231939506c034fe3d4a66ab971e47a6bc"}},{"id":"VRCE-2-51-15","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":15,"english":"Swiftly alighting from the car and entering the royal residence, he went past seven apartments thronged with people.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2051015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"853a0f933b2353887b3f6c713133ee40e86da42a0923045341b95a74720dbd71","compact":"cadf6a934b6a1ff9679dfa0f7d3b04012ce53cc347b20575dc2e53e54732db16","nasal":"cadf6a934b6a1ff9679dfa0f7d3b04012ce53cc347b20575dc2e53e54732db16"}},{"id":"VRCE-2-51-16","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":16,"english":"Waxing still more aggrieved, the females looked at each other with their expansive and transparent eyes fast flooded with tears. And then he heard the talk, as toned down it proceeded from the royal mansions, of the wives of Dasaratha afflicted with grief for Rāma.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2051016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"32d26e7f23af5b4573449973a060dbcb6f7350e7327f2bc2e076777c5d794d75","compact":"5f7a4099e6f30917e19af8c98813ec94a06cc9758351336204dc42bc2f8e699d","nasal":"9385c8bd571a83268be3814d466db7392d76ed3addaa5872c8c729f9d45f280b"}},{"id":"VRCE-2-51-17","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":17,"english":"Going in company with Rāma, and returning without him, what will the charioteer answer Kausalya bewailing (for her son)?","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2051017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4dea5d1c42cd0418096b728cce8c417b7b1993468dfb338edf34cf28cdbe4c10","compact":"d01657b5dce8a562e6a51055dec3ed5c56d646caf44eb3d7793ae9d4c624a524","nasal":"583a9f24824e26c4ec5616762c40b1164cb0b3608380622ed26e75b6d92ca03a"}},{"id":"VRCE-2-51-18","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":18,"english":"Surely life is miserable, yet is incapable of being renounced, since, although her son leaving (the installation) has gone away, yet Kausalyā still lives.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2051018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd230de94e1283fcdfea7a524ecd6c0b5e7692cc0fbc64c6963a9df73fe3dd8d","compact":"04081dd9dec0170e59bc2a3ea79fe884033052a8bb080e98a6f638db4f7bab5b","nasal":"04081dd9dec0170e59bc2a3ea79fe884033052a8bb080e98a6f638db4f7bab5b"}},{"id":"VRCE-2-51-19","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":19,"english":"Having heard those words of the queens, fraught with truth, Sumantra burning as it were in grief, at once entered the (next) apartment.","alignment":{"type":"1:1","confidence":0.708,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2051019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"44f6b7ad2e20f1c17e54acb6d0a57befd9d58debcab60cb6f2d31ef9d6304464","compact":"3d94e43774247f6ca19df29d424fdc46d63c414e2b1f25a80448fc44b0f4ec3f","nasal":"3d94e43774247f6ca19df29d424fdc46d63c414e2b1f25a80448fc44b0f4ec3f"}},{"id":"VRCE-2-51-20","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":20,"english":"And entering the eighth apartment he beheld in a gloomy chamber the king distressed and in a pitiable plight, woe-begone for grief for his son.","alignment":{"type":"1:1","confidence":0.642,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2051020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79899c9eae46285bd63e931f3e282aa5650f30dc2390b1d6245e13966215194d","compact":"0ced6d41b151e3a8827f60f3b51dacd6dd54690ef83323c05d568b166f1fa935","nasal":"f9e1b4db24e4e273dc70e48bb6d4cdbca7d07f9e26ad8f99a6008966891ab418"}},{"id":"VRCE-2-51-21","kanda":2,"kandaId":"ayodhya","sarga":51,"verse":21,"english":"Thereupon presenting himself before the monarch, Sumantra saluted him and then conveyed to the king the words of Rāma as he had uttered them.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-57-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2051021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"baf0d5958feea8e9d8ca758fa52a81b2a43f45cf2afbe9fb9e81999f76b0468f","compact":"bb20853dee43b97eef2c292ab38866b10d31daa60c15380863e4d8000e9a92d2","nasal":"f5e5e3785ded9ce42e708058a535e63518420ec8581de16e7b9053bfaf2e17f8"}},{"id":"V