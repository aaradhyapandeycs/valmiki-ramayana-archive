[{"id":"VRCE-2-15-1","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":1,"english":"Rāma, having his friends delighted, ascending the car, and viewing the city adorned with pennons and flags and incensed with Dhūpa and Agaru, entered the high way, crowded with people and containing houses coloured as the pale white clouds, and the place between the two rows whereof scented with Dhūpa and Agaru.","alignment":{"type":"grouped","confidence":0.525,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2015001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4bda20ef3d25bc953577fda6b93a6e663c01055249c33b0acae8ead5fe301272","compact":"6b7009b682a5e3f1685479c5820a788ec073bd7e24fdf329a432f9bc2832f0f1","nasal":"3adbea7d04da5e9cf1361f2336da89a2e775fc143d71fdd0d28867fd57cdf9f7"}},{"id":"VRCE-2-15-2","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":2,"english":"Rāma, having his friends delighted, ascending the car, and viewing the city adorned with pennons and flags and incensed with Dhūpa and Agaru, entered the high way, crowded with people and containing houses coloured as the pale white clouds, and the place between the two rows whereof scented with Dhūpa and Agaru.","alignment":{"type":"grouped","confidence":0.483,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2015002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ad89e57b38e11c10db459543ab143e9824df2cafd1e01402f90d3e74e107db50","compact":"f0243d29bc16543e86d35b0c6ed5c9c5eab029de12030b42e1f388115e675779","nasal":"fffceddf96a960e61496fb04fa471ab9e04e81ca15d99b2f825510758334d25a"}},{"id":"VRCE-2-15-3","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":3,"english":"It was a splendidly spacious road decorated with a coilection of sandal, Agaru and other fine scents, with silk and red cloth, with pearls holed and other valuable crystals and strewn with various flowers and filled with edibles multiform. Like to the lord of celestials in heaven he saw this high way and the court-yard covered with curd, clarified butter, fried paddy, Dhüpa, Agaru and sandal, and embellished with garlands and other scents.","alignment":{"type":"1:1","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2015003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"56ccd88457751c09e37284e9d4b92bdc55b6493962f9a0a1cc5e8cb0ca705adc","compact":"9bfc092bb50259af85b08f084dd117f17b6921e2a8aa1ee540635c4d0333d163","nasal":"9bfc092bb50259af85b08f084dd117f17b6921e2a8aa1ee540635c4d0333d163"}},{"id":"VRCE-2-15-4","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":4,"english":"Having heard benedictions uttered by many in the following strain and paying proper respects to all, he wended his way.","alignment":{"type":"1:1","confidence":0.671,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2015004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e81b71a388385d360d154330b894e7e995b3a74f56441819386801fe8f7e6dcf","compact":"b39e4f455630d8125f3aa76569cec9454f72ccad54d472d7997e77a0aed26681","nasal":"b39e4f455630d8125f3aa76569cec9454f72ccad54d472d7997e77a0aed26681"}},{"id":"VRCE-2-15-5","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":5,"english":"Being installed this day do you following in the footsteps of your fathers and grand-fathers cherish and protect us.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2015005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af40f5007bb6e560e346786e1788fc08b69f8f2bda8dc3b48dbe045ad5185c7a","compact":"5bd7790fb98c6d9f6249e2ad527ebff4f45d843324b8b1e9547589d260f238c2","nasal":"5bd7790fb98c6d9f6249e2ad527ebff4f45d843324b8b1e9547589d260f238c2"}},{"id":"VRCE-2-15-6","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":6,"english":"You taking the reins of government we shall live more happily than what we were under your ancestors.","alignment":{"type":"1:1","confidence":0.705,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2015006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"11eaf237cf138fc19797d3debb1f27922d58a76c2dff7b2aaf0419af45fd9f12","compact":"4ba757a154d4daef399e775c86931143c9b1f1171a55c7106e71e2c07cf88d33","nasal":"4ba757a154d4daef399e775c86931143c9b1f1171a55c7106e71e2c07cf88d33"}},{"id":"VRCE-2-15-7","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":7,"english":"Seek not we earthly comforts or the highest things (in the life to come), if we can only see. Rāma installed in the kingdom issuing out from his father's abode. There is nothing more pleasant to us than the installation of the highly energetic Rāma on the throne.","alignment":{"type":"grouped","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2015007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8c4c6aee8a93287106403684a896eb4c9a0a577f76ec1e76e62acc87a660919e","compact":"d8585043e0b8f02bdb95b194fa3e53ef29300d56d7be4dc44627311b86214bfe","nasal":"140406d60b82272d92369d42c719df527b605fa869517a32246816a43c9ce545"}},{"id":"VRCE-2-15-8","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":8,"english":"Seek not we earthly comforts or the highest things (in the life to come), if we can only see. Rāma installed in the kingdom issuing out from his father's abode. There is nothing more pleasant to us than the installation of the highly energetic Rāma on the throne.","alignment":{"type":"grouped","confidence":0.9,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2015008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7f934ecc7ecd5eee7de97fee89bc6c4a7f5ced9e3108198169e729b611511b43","compact":"d6ab62f252c46998d0d166d09305a485dde2288fb8dd4fd70b02b316a6f6efe6","nasal":"d6ab62f252c46998d0d166d09305a485dde2288fb8dd4fd70b02b316a6f6efe6"}},{"id":"VRCE-2-15-9","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":9,"english":"Rāma, hearing these and other auspicious words from his friends eulogising his own self, went on his way without being moved.","alignment":{"type":"1:1","confidence":0.651,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2015009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a18c31be2f111668096594981a1572f3b11a3f98666d1dc377ce033956cd265","compact":"80af7a65e9df884407365270dab1cfb89ec513b02a69f72469b8e9890493259e","nasal":"80af7a65e9df884407365270dab1cfb89ec513b02a69f72469b8e9890493259e"}},{"id":"VRCE-2-15-10","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":10,"english":"Rāghava passed away, but not a single person could withdraw his eyes and mind from that best of men.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2015010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f6368796c27b4f8687705ac083acd60c8b92ecfd39f7e0ee2e0fd276bc8ff5c","compact":"7d1e016d90f988abecb0c920f2a23cec2802f8c19267bfe87711edd487eb76f8","nasal":"7010bba41e674dab43a579fa83ebbfd55bf2435052f21a481f1c0c0a96752982"}},{"id":"VRCE-2-15-11","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":11,"english":"That righteous one showed mercy to all, old and young, of the four castes, and hence, they were all obedient to him.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2015011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aef755c066cde470ee115d75874fe169f9b4d17a7dab6667c361005b6d188172","compact":"9ae513999b81964f1e3df13bc2e0fe049e7a631971f975d989913c62f2fbe476","nasal":"9ae513999b81964f1e3df13bc2e0fe049e7a631971f975d989913c62f2fbe476"}},{"id":"VRCE-2-15-12","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":12,"english":"He proceeded leaving on his left side the junctions of four roads, the path leading to temples, the religious fig trees and altars, and reached after all the family dwelling of the king, with its palatial tops piercing the sky, looking beautiful, resembling mass of clouds, white as the celestial cars and high as the hill Kailāsa, and with sporting houses sporting with pearls. And the son of the monarch, shining in beauty, entered into the palace of his father, the best on earth resembling the abode of Mahendra.","alignment":{"type":"1:1","confidence":0.635,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2015012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af8106888584b0d74bd80a4f06fc734d05c2aca0d1210de1468454d257f7e08a","compact":"9dd5d7c5a1462c79971281db9b3bcd39c1065c6627c015db8ce2af73f7af7fc1","nasal":"022826da544aaee995e222c58ebfeb75afde9dc35b2ac9e9cdb9853c526ff853"}},{"id":"VRCE-2-15-13","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":13,"english":"And in this way passing by all, and ordering his followers to go back, entered the inner apartment.","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2015013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"15e088654330fd3f2bb52c756c507dfa9eccc000e7b032b9f6ce8c79fb6408ca","compact":"37c744c5f026b83e00ac8ef11e2223d5334f698437338a3031826dc93d4e31c7","nasal":"7e2abc4304d82220ebc9ff9cb1a2c3557da4b981da2d59ceeda18fab96fb9bf7"}},{"id":"VRCE-2-15-14","kanda":2,"kandaId":"ayodhya","sarga":15,"verse":14,"english":"That son of the king entering into the presence of his father, all were extremely gladdened and were eagerly expecting his return like to the lord of water expecting the appearance of the moon.","alignment":{"type":"1:1","confidence":0.968,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-17-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2015014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2732d82ec8418f7c719c51b8b69b6fe4547e55ddb482f3e273d0b8b65d2d6cf3","compact":"f9a0e4382c8d7d46beb320ab86eadcc241b296b74396215cb563dd928856661a","nasal":"8d6708bc2d72d8934c8069093dddeb008c0fc77f7e987e7d1e34888a46559fa7"}}]
