[{"id":"VRCE-2-76-1","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":1,"english":"And then the intelligent Bharata surveyed that assembly filled with noble, and worthy personages, resembling the night of the full moon.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2076001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bc560e51642a34ae699ea1b5feb40fb91c829c00163244ec773ed9f7d00ba33c","compact":"917ac5a8a65b243d544418e99d42049c0a98156f65f8849819edd280df413ed4","nasal":"a3857acf3ee4cd0fc150f29de0916c507acca35d463756979c4cbfe06d9f1daa"}},{"id":"VRCE-2-76-2","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":2,"english":"And that august assembly was ablaze with the brilliant hues proceeding from the attires of the honourable persons seated according to rank. And that splendid assembly filled with learned people looked like he night of the full moon after the clouds have dispersed.","alignment":{"type":"split","confidence":0.466,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-2","DUTT-2-82-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2076002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b4870f1297b5074fff6b33db29690f041316815232361f9aba2775fd1d2aff43","compact":"8cef1525dc9bdb9388a93469da38c8f13f353e17ed292e14f0243cc743719d1b","nasal":"438861c1be11a83f15ecc021b38b8adde1b82534a2b18197ea9ebb1347f0b8da"}},{"id":"VRCE-2-76-3","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":3,"english":"And seeing all the subjects of the sovereign gathered together, the priest cognizant of virtue softly spoke to Bharata.","alignment":{"type":"1:1","confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2076003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit