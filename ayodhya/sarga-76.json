r":"2076011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9575baefef774cf6cf4b0383d247af2f4ebfe40e996c33632625a39d1c981f2","compact":"83de57c0b6a21193da92d066377c26f1079194b5a05b0869532aa0bb369e8d41","nasal":"83de57c0b6a21193da92d066377c26f1079194b5a05b0869532aa0bb369e8d41"}},{"id":"VRCE-2-76-12","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":12,"english":"First-born, and foremost in merit, righteoussouled, and comparable to Dilipa and Nahuşa, Kākutstha deserves the kingdom, just as Dasaratha did.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2076012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"90daca76d87d034fac8991186fe9b0a868b5a9cb23e8c460a485ccf10cd8eede","compact":"608e66c50381c2ef76bc1a39c6e4fc1b283ed6d5e6867a357834f4e2d525a962","nasal":"608e66c50381c2ef76bc1a39c6e4fc1b283ed6d5e6867a357834f4e2d525a962"}},{"id":"VRCE-2-76-13","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":13,"english":"If I commit myself to this sin dishonourable and calculated to bring me to perdition, I shall in this world bring disgrace on the race of the Ikşvākus.","alignment":{"type":"1:1","confidence":0.823,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2076013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19c1208b56686a8f4cbe7b60a30a1d46bfce9415f3d979521b5a65e5897c0245","compact":"b3a6ea86108df8ba383ce17de48a10f36a3ed1ed698bea9710493e9e133da921","nasal":"b3a6ea86108df8ba383ce17de48a10f36a3ed1ed698bea9710493e9e133da921"}},{"id":"VRCE-2-76-14","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":14,"english":"I do not at all relish the sin that has been committed by mother. Remaining here with joined hands I bow down to Rāma gone to the forest fastness.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2076014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de85d361509799b1af5596a996d45c98832e88eb35af1b37289496e8072a6fe3","compact":"b4eeceaa200bd90a58f9ce9f259cbf234d06460591c2952648f0ea13595967f6","nasal":"a3635a527c0ac2ae8b78d2631bd393c517090f6cdcbc66e16a69d939c66577bb"}},{"id":"VRCE-2-76-15","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":15,"english":"I will follow Rāma. That best of men is the king. Rāghava deserves the dominion of the three worlds themselves.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2076015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c5a141bf13609935b32f34df61144869c31c97bb7b0c5a5438d777d07a156f8b","compact":"de4c08651d717004904d7cb5a5c40af45079789a9bcb03a745380172a234569c","nasal":"de4c08651d717004904d7cb5a5c40af45079789a9bcb03a745380172a234569c"}},{"id":"VRCE-2-76-16","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":16,"english":"Hearing words informed with those righteousness, the entire assembly with their minds intent upon Rāma, from joy shed tears.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2076016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05ea5b40a9aecb808e26ffd782fe2789bbb124c8e278ab70cfd365c9af6616cb","compact":"0d71dd3e8a6ed3fc96ec899eea9e6749d4413c9fc578c060becff5360d0dbb56","nasal":"0d71dd3e8a6ed3fc96ec899eea9e6749d4413c9fc578c060becff5360d0dbb56"}},{"id":"VRCE-2-76-17","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":17,"english":"If I fail to bring back the noble one from the forest, I will like the exalted Lakşmaņa remain even in that forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2076017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c50d96b26814aec164c484f59000d524061ddee3d8b42e38fe836c8621c1278","compact":"822148139def7bb213037b58354c79a6255e488468ba6a7efe0b8ae86665349e","nasal":"822148139def7bb213037b58354c79a6255e488468ba6a7efe0b8ae86665349e"}},{"id":"VRCE-2-76-18","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":18,"english":"I will in presence of this mixed assembly of pious and honourable persons following every perfection, adopt every expedient to bring back Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2076018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee355311b2810b1a2aa0fb100a6e96cc78471768d489a3d147bb01e85de0575e","compact":"e7b0d6533a5bc16844ff516c37c54a0ea43e0d1536e2940a9d220de5ca66682f","nasal":"e7b0d6533a5bc16844ff516c37c54a0ea43e0d1536e2940a9d220de5ca66682f"}},{"id":"VRCE-2-76-19","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":19,"english":"Having said this, the virtuous Bharata attached to his brother spoke to Sumantra skilled in counsel, who was by, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2076019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f3dcff4ca4ae0e2537164d6ef387707711129ecdabc0598c42cc14c469fb4f5","compact":"3068744cbb6fe81f8c1b8a46e99cfc73c515ca39f36096fce5d06025748bbf3e","nasal":"c56bc9ce6efba561046a5fc14ef53e9a13d9e47ea281d1f1bf258ea3b5c29223"}},{"id":"VRCE-2-76-20","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":20,"english":"Up, and go, O Sumantra at my command. Do you make known this journey and bring the forces.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2076020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a6767a11bd6d2d2f541e75a1598c1d5aa04e9d2d19decc00fd8d06b36224fef1","compact":"cb93cc35a89fe2d8d102008b0f7735b91279cb05327a44d8c05c7fa8b6f1a309","nasal":"bc05716c2c48ea25546cce702f98c6bd3b8fa0426c38789503a8072316b079f8"}},{"id":"VRCE-2-76-21","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":21,"english":"Thus accosted by the magnanimous Bharata, Sumantra with a cheerful heart issued orders concerning everything desirable as he was ordered.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2076021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c5da42dd369214fa7fce69d2340f5d84a8668f53fa5b06663ccd66bf5e3c622f","compact":"0de1abe651d5ffcba14c71d7ca2063ac5051f7297ca2be55d5945dbbd5c26a75","nasal":"0cd4ba243a5e7a5c4ca9b6d8af96f0159e13620c966784d0f045a357c744f942"}},{"id":"VRCE-2-76-22","kanda":2,"kandaId":"ayodhya","sarga":76,"verse":22,"english":"Hearing that the army had been ordered to march forth for bringing back Rāma, the subjects as well as the generals of the forces became exceedingly delighted.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-82-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2076022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9a0a91b87297c67febfa5d28620293a4d1590e5e917bc51da3b477873b5df16","compact":"91c54f11da682626dbfac04a08c3bf592a0c0ce558121f0723de380c87c280b6","nasal":"91c54f11da68