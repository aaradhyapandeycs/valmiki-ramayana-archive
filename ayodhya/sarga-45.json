itFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0a78ba96d6b0c17bd27e337f1a47b4698cd363b65a4ebf59dc1511b277724b1f","compact":"9ef00cf38bdd62669c0f4ad75fae1afc2178a9de6e5c55f2333238f0a5308409","nasal":"9ef00cf38bdd62669c0f4ad75fae1afc2178a9de6e5c55f2333238f0a5308409"}},{"id":"VRCE-2-45-17","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":17,"english":"Frustrated in his desire, my father, foiled in his endeavours to confer the kingdom on Rāma, will, exclaiming 'All is lost,' 'All is lost,' give up the ghost.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2045017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72ab5ad8f908bd9f40f5aa9a11cbb62cd4f76de2b4e4bfacbbd0b98dff50cfd0","compact":"8abd60d9aaac10927a1543c6e86815b64865e6920aaf1a0a4925e2899c25b6f7","nasal":"8a4ff701aaddb4505b0ff7cd0cfe6894b8db626fee2d601137743d018bd72270"}},{"id":"VRCE-2-45-18","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":18,"english":"Surely they are blessed that when the time shall come when the king will die, will perform the funeral rites of that descendant of Raghu.","alignment":{"type":"1:1","confidence":0.782,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2045018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ad6344d61e821565115cd7066d7373aa9930db148d6ebd838e5ff88ba0214aaf","compact":"b7247c6f666826b6ba6886fd7acb2fddadc738339998fbd8d287eab5ef64aec2","nasal":"415ff5ccf527b0a4eb808b40ca3acca84d4f27a1c843f98dceb36cef5bd7a195"}},{"id":"VRCE-2-45-19","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":19,"english":"They will happily range the capital of my father, furnished with fair looking terraces, with its highways laid out orderly, having lordly edifices and palatial residences, graced with excellent courtezans, abounding with cars, elephants and horses, resounding with the notes of trumpets, the abode of all auspiciousness, filled with portly and contented folks, rich in gardens and villas, and celebrating popular festivites.","alignment":{"type":"grouped","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2045019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8743d591f4a232eaddc815994df744b722f1fb48c67fa846faa33c4c0f981e86","compact":"dbb9ba34e44888cf5e7e9da33df6a633f9124d0cb3782b1d7ebd9969f31508f7","nasal":"7e15f423bc6a501c3f7387a05795405a9189947b051b0fdd5dcfb6301cdacee4"}},{"id":"VRCE-2-45-20","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":20,"english":"They will happily range the capital of my father, furnished with fair looking terraces, with its highways laid out orderly, having lordly edifices and palatial residences, graced with excellent courtezans, abounding with cars, elephants and horses, resounding with the notes of trumpets, the abode of all auspiciousness, filled with portly and contented folks, rich in gardens and villas, and celebrating popular festivites.","alignment":{"type":"grouped","confidence":0.625,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2045020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd307d47923f5cd25d136246cdd979ef54a3cf5621442d99c9f38812ee8663fa","compact":"07f80693b21a99abee7a9d571de078451c20888c0bfd9bcb95e489ee31fed742","nasal":"07f80693b21a99abee7a9d571de078451c20888c0bfd9bcb95e489ee31fed742"}},{"id":"VRCE-2-45-21","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":21,"english":"They will happily range the capital of my father, furnished with fair looking terraces, with its highways laid out orderly, having lordly edifices and palatial residences, graced with excellent courtezans, abounding with cars, elephants and horses, resounding with the notes of trumpets, the abode of all auspiciousness, filled with portly and contented folks, rich in gardens and villas, and celebrating popular festivites.","alignment":{"type":"grouped","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2045021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0915bdcc6898d7c7299d309c6953495d209a2e205858d296c4546c55fca939ff","compact":"9a1d27de6660663654f23b74134538738ca632ba30a3ae65b5ef09ba8bcad2ed","nasal":"5d78db0c6c8f3bb74b3a38f6aeee39154f4a6a237ece5419567f7dbdf0bf60bd"}},{"id":"VRCE-2-45-22","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":22,"english":"If we remain in peace, we shall returning from the forest with that one firm in promise, enter Ayodhyā?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2045022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e09b472a36193a23c3951d0cafb3426e9b4eb70a9ba3d9560f81ca1cd42f61d7","compact":"12cbf26b7e5553a863169e441c0afb6356326cfc63b2101b0e47d36c64e2a618","nasal":"2ad16eea2f1af5a8f65d0007f9ce1cdf2dc3e3d764c52abf4295fa2a4d373120"}},{"id":"VRCE-2-45-23","kanda":2,"kandaId":"ayodhya","sarga":45,"verse":23,"english":"As the high-souled son of the king oppressed with grief was thus lamenting sitting up, the day broke.","alignment":{"type":"1:1","confidence":0.898,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-51-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2045023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af49283dbfd4babbe906599164668289128d36c9392021454463b0e8c485a8de","compact":"e68583ad2f6f4d0b6c3bb6a76d49ed4c36062a32