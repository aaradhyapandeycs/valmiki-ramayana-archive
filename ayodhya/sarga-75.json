[{"id":"VRCE-2-75-1","kanda":2,"kandaId":"ayodhya","sarga":75,"verse":1,"english":"Then seeing that the night in which had been performed the auspicious preliminary ceremonies, was about to be spent, eulogists and genealogists hymned Bharata with consecrated hymns.","alignment":{"type":"1:1","confidence":0.629,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-81-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2075001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"877ff2ab5453090eb93ace6b0a51c678e58f47b8c038945eee944b1cf64fff56","compact":"93d7fe76f4a4d0272bbc3ac7d36203c7d3099aee122f573dcbd6b6dfac605199","nasal":"f083357b9889ca89966e7fff4b2c2000a2f6d8b392539a6ebdf5d8cc26a51a62"}},{"id":"VRCE-2-75-2","kanda":2,"kandaId":"ayodhya","sarga":75,"verse":2,"english":"And then sounded the kettle-drum, beaten by a golden stick, announcing the departure of the night; and people sounded conchs and other instruments by hundreds furnished with soft and loud sounds.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-81-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2075002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d022f34091e5248f60fab1d2f4c41e3acdd5eb821685d204e8c71c58379fa2f7","compact":"27a0f8bbb5cc252e292661bfd6186fcb6169725ea5428a27d007a79d1d6b18ba","nasal":"fa7bafc88027ef5fd3dce2bd46149ef00f378ae124725443800bf025c999b930"}},{"id":"VRCE-2-75-3","kanda":2,"kandaId":"ayodhya","sarga":75,"verse":3,"english":"And as if filling the heavens, those powerful blasts of the trumpet repeatedly rendered Bharata burning in grief the more aggrieved.","alignment":{"type":"1:1","confidence":0.911,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-81-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2075003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d