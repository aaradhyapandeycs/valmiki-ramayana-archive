-sanskrit-ngram","duttRefs":["DUTT-2-118-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2110017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c4d7bb45cf4896d9027348c93a28ed740bc79b47da507be4ce51419c9802f0a8","compact":"1a47283c7d339299b85220baaa1bfda238fb59df9dd2e88bdf98cd56cba7bbe1","nasal":"8bc78c2cb8bafe30bcacdbc02ebd17c4819378a2efa028f0f12cdc258f518b4e"}},{"id":"VRCE-2-110-18","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":18,"english":"This noble and grand garland, this apparel, these ornaments, and this precious paste for adorning the person, presented by me, let these, O Sītā, grace your person. These, worthy of you will never be tarnished.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2110018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6094cdf28385745cae7ccca152326ca7e64730bcc4dd6cd69f1c0ae5fb525754","compact":"36daf572c82b88f347361ca67a37b400cea6eb532e4a6ee5d506a00916220fd9","nasal":"36daf572c82b88f347361ca67a37b400cea6eb532e4a6ee5d506a00916220fd9"}},{"id":"VRCE-2-110-19","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":19,"english":"O daughter of Janaka, daubing your person with this excellent paint, you will grace your husband even as Śrī does the undeteriorating Visnu.","alignment":{"type":"1:1","confidence":0.735,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2110019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"caeaa6e3118488325a4ce999157db9334de5f84a832aa062d2640d3f57592910","compact":"17bb393140e71dd0a3535f7c2c953028504ca0fdb326b16701a7bb65c599895a","nasal":"2acfa65fce03ca4602d0fe102442e212002ea7bb61ea63712698a3d8b1e5b61f"}},{"id":"VRCE-2-110-20","kanda":2,"kandaId":"ayodhya","sarga":110,"vers