[{"id":"VRCE-2-110-1","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":1,"english":"Thus addressed by Anasūyā, Vaidehī devoid of malice, honouring her words, began, “That you should instruct me is no wonder in you.\"","alignment":{"type":"1:1","confidence":0.78,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2110001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"301e754bc2250b8d272238fc35bf22173d2ecb7e5e0d6341e5b22eb005b4c139","compact":"b500fde49d17c2857fd1b294c9b64a5847fae0a26bfe5c0a8486e3bf99aa9e85","nasal":"7f342746b79731b337fb1c8c9d24bd6894466eb40027b34d62e3ad0b8a945c24"}},{"id":"VRCE-2-110-2","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":2,"english":"I know that a woman's spiritual guide is her husband. Even if a husband should be poor and of a disreputable character, he should be ungiudgingly obeyed by the like of me. one","alignment":{"type":"grouped","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2110002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3d08748e0fb2bbb05188336fe61f7828512e8ebb33fc1de8e021ff302f6f06fa","compact":"0646ac40bb7db7531a213c7e7359a526e1fed7f681a4575462f76fe65e56d8b0","nasal":"0646ac40bb7db7531a213c7e7359a526e1fed7f681a4575462f76fe65e56d8b0"}},{"id":"VRCE-2-110-3","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":3,"english":"I know that a woman's spiritual guide is her husband. Even if a husband should be poor and of a disreputable character, he should be ungiudgingly obeyed by the like of me. one","alignment":{"type":"grouped","confidence":0.431,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2110003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2dc53beb1a4