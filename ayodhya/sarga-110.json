tt 1891–94"},"sanskrit_fingerprints":{"exact":"80a2cd64a20be2bd31bd4f43a1fbb939056605d10380de1334adb8c61b021dd5","compact":"a3769a48a84d7865ee06bbe14054fe2297163660f6132c345be0ca3bf94507c8","nasal":"86e4609f476f24e05ecd4f041ea5e6858a4f2a1839eb815ba3fb43eab893f671"}},{"id":"VRCE-2-110-40","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":40,"english":"Having obtained the bow, my truthful father said, 'No fear!' inviting at the same time the kings to an assembly of sovereigns.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-38"],"status":"unreviewed"},"source":{"sanskritLocator":"2110040","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1740eadc5048a5df7b07c7420c846458ac19bb63222fd8bc3a7fb69269e0c113","compact":"dc3d05138e109f4af51b8974ab4104a0ceb27716127df49b535f023e95d18cf7","nasal":"2a0fcd7bbd76f4c0e6772e08a65f7949842478de0abdd3acf18549ac03376580"}},{"id":"VRCE-2-110-41","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":41,"english":"He that, raising the bow, shall string it, shall doubtless receive my daughter for his wife.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-39"],"status":"unreviewed"},"source":{"sanskritLocator":"2110041","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3ae721b623ea39e6502d49781b452d3b64ebc3662caa0bbab4c74a72e6960b44","compact":"5fc0b8c27ce5469ccb1852be420c1b01a643d7fdc681f224e4a78290940a6e29","nasal":"5fc0b8c27ce5469ccb1852be420c1b01a643d7fdc681f224e4a78290940a6e29"}},{"id":"VRCE-2-110-42","kanda":2,"kandaId":"ayodhya","sarga":110,"verse":42,"english":"Seeing that best of bows in weight resembling a hill, the kings saluting it, go away, unable to move it.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-118-40"],"status":"unreviewed"},"source":{"sanskritLocator":"2110042","sanskrit