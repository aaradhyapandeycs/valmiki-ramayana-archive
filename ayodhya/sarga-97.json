[{"id":"VRCE-2-97-1","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":1,"english":"Knowing Bharata as devoted to his superior Răma along with his brother Lakşmaņa, asked him.","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2097001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"69e6e65baa8789774a3b72e83d76ca8bdb2a0105ad418b3cf468c5b0f56553b5","compact":"8c6a0105168478ca7d2d2f76be37e477ce6862a5849e1eaa47665cdb8ea94d81","nasal":"8c6a0105168478ca7d2d2f76be37e477ce6862a5849e1eaa47665cdb8ea94d81"}},{"id":"VRCE-2-97-2","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":2,"english":"What for is this (visit of yours to the woods)? I wish to hear as clearly related by you the reason why clad in blackdeerskin and wearing matted locks, you, leaving your kingdom, have come to these regions. It behoves you to tell me all this.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2097002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02b295172d4455ae60f85f580d3b36e70c5946130ec81295f187c443ab20ace7","compact":"a6cac84ecdac14baf38690b2c42fb0cc261fa67c161c6475a050bada21af470b","nasal":"a6cac84ecdac14baf38690b2c42fb0cc261fa67c161c6475a050bada21af470b"}},{"id":"VRCE-2-97-3","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":3,"english":"What for is this (visit of yours to the woods)? I wish to hear as clearly related by you the reason why clad in blackdeerskin and wearing matted locks, you, leaving your kingdom, have come to these regions. It behoves you to tell me all this.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2097003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6de12e82f56f40d0241cb07d925d459ac1d3c23ae83918e7456e8d81190eefc8","compact":"76f23f210d68d68e0ba1fed85b1c504362496b00670b033f9aecaad7792c90a0","nasal":"9ead93bcf105df4da45ffdf898a2b0fce06e81ecba99dae70d4d0129e0f287c3"}},{"id":"VRCE-2-97-4","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":4,"english":"Thus accosted by the high-souled Kākutstha, Kaikeyi's son, suppressing his grief by a strong effort, with joined hands said.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2097004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4b70f6b7389ef446349a17211c0647c69e112702f175971fac7b649e6560b053","compact":"037843cca797d7bbdb66778532dd291f27b5a2858062e036768ccf56c7091012","nasal":"dfc05fcc03c14da7be4b2bafc56c61ce653d9e0b3ad340d891f3efcc2d27c0be"}},{"id":"VRCE-2-97-5","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":5,"english":"O noble one, forsaking us all, our father possessed of mighty arms, having performed this terrible task, in consequence of being urged by a woman, my mother Kaikeyi, has gone to heaven afflicted with grief on account of his son, O repressor of foes.","alignment":{"type":"grouped","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2097005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"899a2483461fffa1656fa0487f6877dd888eb9c61a07ad17b0806d8c637146fa","compact":"6d81051343397b0d0c7db2323f8ffb5d8ef03be81972a32b7defaf2c3d0caf97","nasal":"6d81051343397b0d0c7db2323f8ffb5d8ef03be81972a32b7defaf2c3d0caf97"}},{"id":"VRCE-2-97-6","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":6,"english":"O noble one, forsaking us all, our father possessed of mighty arms, having performed this terrible task, in consequence of being urged by a woman, my mother Kaikeyi, has gone to heaven afflicted with grief on account of his son, O repressor of foes.","alignment":{"type":"grouped","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2097006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0336ae4b71be6a2ba9ecbd7d48128bbf51ba5c48164acc7923fc3b4047b8d235","compact":"f7b4068b910034f0005693eeb51284b724d586ef32ae3e0cc388848f6f692465","nasal":"f7b4068b910034f0005693eeb51284b724d586ef32ae3e0cc388848f6f692465"}},{"id":"VRCE-2-97-7","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":7,"english":"And she has committed a signal sin capable of destroying her fame. And without obtaining the kingdom which she had coveted as the fruit of her action, a widow tried with grief, my mother will fall into a terrible hell.","alignment":{"type":"1:1","confidence":0.804,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2097007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"18fb5322fc0568ea83dc8a55a7ff1ce9e05c26d68ab631e2ada4435d6a7c6f6f","compact":"8e392e9f67022f1989b0f54963ddc093ddcab1f3f83a9aa6fbccce4e605f8d79","nasal":"8e392e9f67022f1989b0f54963ddc093ddcab1f3f83a9aa6fbccce4e605f8d79"}},{"id":"VRCE-2-97-8","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":8,"english":"Now it behoves you to extend your favour to me who have become your slave. Do you this very day get yourself installed in the kingdom, like to Indra himself.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2097008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aa7294c6852af6b705ca5a58652cb8439190b5ddd6e1e10c195453c1eac71902","compact":"ac79d43c059583c60585196fbabc3303ae98d540cb66d2aad482afd502c6982a","nasal":"a9b5e1196fe26440f1d942a654ede3124968fa1ed4e26d0e27f750fc2c1f20e2"}},{"id":"VRCE-2-97-9","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":9,"english":"All these subjects and our widowed mothers have come to you. It behoves you to show your favour to them.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2097009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2fe819e09dc9609ad2e50eb6ec463633c9d95e762c54c446b2319e2c5ab78986","compact":"9d1e20ad1c313216d924c11fcf231d606c48a4ab12125ea19db97f79eaff7510","nasal":"9d1e20ad1c313216d924c11fcf231d606c48a4ab12125ea19db97f79eaff7510"}},{"id":"VRCE-2-97-10","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":10,"english":"You are the first-born; and meet it is that you should get yourself installed, O bestower of honour. Therefore do you receive the kingdom righteously and fulfil the desire of your friends.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2097010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a55675b10fd98dbd0a78ec9f48bdb4af91b8f85f1a606bf9d7c06aa967e9c81","compact":"93a37ca6e6b2e8c9628d01b690c852336666d95da08151f16540d949279c2c71","nasal":"93a37ca6e6b2e8c9628d01b690c852336666d95da08151f16540d949279c2c71"}},{"id":"VRCE-2-97-11","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":11,"english":"And like the autumnal Night on having the unclouded moon, let the entire Earth cease to be a widow on having you counsellors. It behoves you to show your favour to your brother, disciple, and slave.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2097011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6d3f78e2fe90db37a43e102bcab613d38bd68c4a65cacbfb31eec379d1c61a14","compact":"3b7f7dc9c503c6caab932617605624e8ffcec3d13bc1d4097af67486a46b0c67","nasal":"3b7f7dc9c503c6caab932617605624e8ffcec3d13bc1d4097af67486a46b0c67"}},{"id":"VRCE-2-97-12","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":12,"english":"And like the autumnal Night on having the unclouded moon, let the entire Earth cease to be a widow on having you counsellors. It behoves you to show your favour to your brother, disciple, and slave.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2097012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"47c85d36ea06280987ec1e4895b6c557cbdec38e02e888071aa9d4ec928f9897","compact":"1b419d67c2a6e9351330530f5a47429934d91aa0cf0eb1d443d9f3ccdd5f58e4","nasal":"1b419d67c2a6e9351330530f5a47429934d91aa0cf0eb1d443d9f3ccdd5f58e4"}},{"id":"VRCE-2-97-13","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":13,"english":"Therefore, O chief of men, you ought not to pass by this honoured band of ancestral ministers, who have always been serving this race.","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2097013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"65cec12965e8c6ee3844bba0bebbc2e1bf528f3eaf7d9e52ba03aeeda0ec9bc1","compact":"75939f16b0717cf38573ba8e90adb7451881251434bcd0c7e02e4be4fcca2e2b","nasal":"08f19205da826979bba4934b8261ded8cc99278871d824462698feda0a1ecee6"}},{"id":"VRCE-2-97-14","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":14,"english":"Having said this, with tears flooding his eyes, the mighty-armed son of Kaikeyi, Bharata, again took Rāma's feet on this head.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2097014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f651a5a9f08c92925be76b8406584bfa2c1f2e395cc84c55be2eb0b04043f9be","compact":"856ae3214c989da8c9bc210d8709750a1808e82b1e953ad8ae8d644780d5cc94","nasal":"856ae3214c989da8c9bc210d8709750a1808e82b1e953ad8ae8d644780d5cc94"}},{"id":"VRCE-2-97-15","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":15,"english":"Thereupon Rāma embracing his brother Bharata resembling a mad elephant, and sighing again and again, said.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2097015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c3ca4478ae66db47f0c24628b7b165d935993da4f8c3738168fde05b1afe780","compact":"960e03041eb134c20c5726a5a4384af705d3b0e1cae7318315d5d30ccb3364df","nasal":"2d2e201e706bca128c438568121ac74f6d6f5ef355ebd76852204a88f1b3041b"}},{"id":"VRCE-2-97-16","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":16,"english":"Of a high race, possessed of strength, endowed with energy, and vowed to sterling worth of character, how can one like me commit sin for the sake of dominion?","alignment":{"type":"1:1","confidence":0.688,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2097016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7c75995546843e30e2f9c8315fdab05701e04fdb1162d08d93bc1772c6b1d597","compact":"a27f2396bc998c37017056fe5f19a847e73d1d7f2d2a0cbd7270c8f5ca866557","nasal":"4dce8f36a78c6faab64f9f7d1bca3c2131d0dffb5595a84b3c5914f686eb62e8"}},{"id":"VRCE-2-97-17","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":17,"english":"Fault find I none ever so small in you, you destroyer of foes. Nor does it become you from puerility to tax your mother.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2097017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e6cc34de2305158a3d7ec3b8af41b2fc8d4dcddfa1a29519e63e35ec78e58670","compact":"24b9f5d73dc9841ac63e4603b9eed44d2c50a29d3ee72f2b0db36066884f9401","nasal":"24b9f5d73dc9841ac63e4603b9eed44d2c50a29d3ee72f2b0db36066884f9401"}},{"id":"VRCE-2-97-18","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":18,"english":"O you conversant with morality, O foremost of those observing righteousness, in respect of virtuous conduct a mother should be as much regarded (by a son) as a father is.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2097018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fa6300fce24cb4fc119b29c088f4694689fad75f42197b0c224894ea28c134cb","compact":"8e49ed22c0f9f138f0a151008b3fc82c34e93f3e09389e362531063c23d96f70","nasal":"8e49ed22c0f9f138f0a151008b3fc82c34e93f3e09389e362531063c23d96f70"}},{"id":"VRCE-2-97-19","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":19,"english":"How can I, O descendant of Rāghava, having been told by my righteous father and mother, 'Go to the woods', act otherwise?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2097019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8defef196ed379cf97e19dac5f94ba65214326d6e76575aa1bb4f967176ee318","compact":"9038fff9ebc13a9f94971611814d19007b745e6b5b709d13fcb7e0dd283fdf45","nasal":"9038fff9ebc13a9f94971611814d19007b745e6b5b709d13fcb7e0dd283fdf45"}},{"id":"VRCE-2-97-20","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":20,"english":"You ought to receive the kingdom, Ayodhyā, honoured of men; and I ought to dwell in Dandaka dressed in bark.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2097020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd440aeec78740783a83ab16ff03d62c2501393d909f6415fa3a501587ffcd04","compact":"67d26f3af292bb606b70b48e825cd36a05b0728c79c932e97701e8d8d685959d","nasal":"b31bbf155254234a00a9b88124b1d37bab444946309fbeb9ce511041d6bd75f3"}},{"id":"VRCE-2-97-21","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":21,"english":"Having made this division of duties in the presence of all, and also enjoined this, the mighty monarch, Dasaratha, has ascended heaven.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2097021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3b3491af00faf5fc9b8bee2bb196320a7a34a73bfd5e75a64e1637fc0a8c612","compact":"95c11e12b6078170128405df63732cc5f9514469e4b5df3422330de1b8e0ec7a","nasal":"95c11e12b6078170128405df63732cc5f9514469e4b5df3422330de1b8e0ec7a"}},{"id":"VRCE-2-97-22","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":22,"english":"That superior of all, even the virtuous king, is your evidence. It behoves you to enjoy that which has been assigned to you by your sire.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2097022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"11b517b03c828fb8224f4a6305d311086f39398d8aeb125fedec80c69695ec99","compact":"b632d8a13a958b766ad55351f23d790de59ad89f305662dc03c35a842216badb","nasal":"b632d8a13a958b766ad55351f23d790de59ad89f305662dc03c35a842216badb"}},{"id":"VRCE-2-97-23","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":23,"english":"And, O mild one, taking refuge in the forest of Dandaka for fourteen years, I will act the part that has been set apart for me by my magnanimous father.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2097023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c026b218742674ef1cd87ce2428479b8d442a479a2027f00ed0cc1040160003f","compact":"dca8bcd22e32cdbc8d238ac8aecbd18889f4b6a2930e31d84be280e8322fbd2f","nasal":"a7ecddb2e1c74abda0d95be3310d0d64455f0e790e4734ef11e8c8604f04d767"}},{"id":"VRCE-2-97-24","kanda":2,"kandaId":"ayodhya","sarga":97,"verse":24,"english":"What has been assigned to me by that one respected by all men, my high-souled father resembling the lord of celestials himself, is my prime good; the masterdom of all the worlds I would decline (should it be opposed to the will of my sire).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-101-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2097024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"859cbe31dfc2182eec411acb78b629a1229dada45a6ad01eb46bd2e3b7733dfb","compact":"ee605cf956c3f6201386bfd9ebec000e6c8339ea0561b7dd1cdf3397d17524c5","nasal":"ee605cf956c3f6201386bfd9ebec000e6c8339ea0561b7dd1cdf3397d17524c5"}}]
