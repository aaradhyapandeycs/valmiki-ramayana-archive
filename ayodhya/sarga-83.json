[{"id":"VRCE-2-83-1","kanda":2,"kandaId":"ayodhya","sarga":83,"verse":1,"english":"Having spent the night there on the banks of the Gangā, that descendant of Raghu rising early in the morning, said these words to Satrughna.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-89-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2083001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ab12de0d577739d904f6aa19d490ec5c02dff01942bbb139d3ce01c479c2d32e","compact":"a6287ee7f3a15b590bd4cfb36181b330acb825165f0cf214cc46d633487e67aa","nasal":"fe120981f1799d084eed46cc48dd854044b1d69379dad4be094c363cbf1f3d85"}},{"id":"VRCE-2-83-2","kanda":2,"kandaId":"ayodhya","sarga":83,"verse":2,"english":"O Śatrughna, arise! Why sleepest you? Bring you at once that lord of the Nisādhas, Guha, Good betide you! he will take the army (over the stream.)","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-89-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2083002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"14eb31ce53148cbd68155097e9deadf205805e7931b842a3427d39404589a57e","compact":"6eec0a9b063f275d9931398bf6b490de9e1dd64db48908270151f3fafede9dc0","nasal":"6eec0a9b063f275d9931398bf6b490de9e1dd64db48908270151f3fafede9dc0"}},{"id":"VRCE-2-83-3","kanda":2,"kandaId":"ayodhya","sarga":83,"verse":3,"english":"Thus urged by his brother, Śatrughna said, \"Thinking of that noble one (Rāma), I have not slept, but have remained awake in a like manner. *i.e., as you have done.","alignment":{"type":"1:1","confidence":0.764,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-89-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2083003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f0c587434b784c76ec06f92db6f3db75b6582575dc1018c7f42f8baecb