[{"id":"VRCE-2-77-1","kanda":2,"kandaId":"ayodhya","sarga":77,"verse":1,"english":"Rising with the morrow, Bharata anxious to behold Rāma, speedily set out ascending an excellent car.","alignment":{"type":"1:1","confidence":0.766,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-83-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2077001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ca61ecdcc5d5769f54d2a734cd87567950b382d295df8590eb7e34069759c57a","compact":"3e6c9f02dcabc4b9d58aa01861a7503252645bc7e2732b965c9c743aa3cc63b5","nasal":"a6a951e2f3db30413b429d46b67d5896a0bd925d9fc4d5b2e14ab1890df8c96a"}},{"id":"VRCE-2-77-2","kanda":2,"kandaId":"ayodhya","sarga":77,"verse":2,"english":"Before him went the councillors and priests, ascending cars resembling that of the Sun yoked with steeds.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-83-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2077002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b403d7256cac33339f4e651df616df3be176624db07ce546a61f6f25e4c90bb5","compact":"eab4ce63a3102284e6df08e26b8578351e4c64a9fa0e43fd90e9359df807a883","nasal":"5eb06d718828ebb0c959ff5bda5c5ce2575ed1fd03e6e60470b3232fd929be28"}},{"id":"VRCE-2-77-3","kanda":2,"kandaId":"ayodhya","sarga":77,"verse":3,"english":"And a thousand elephants duly consecrated went in the wake of that son of the Ikşvāku line as he was proceeding.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-83-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2077003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d312197e65046bb551b3e5e42f89c17fbfd1706d48eac6bd07055c2689362620","compact":"976621af4c54f74f61ce7f19ebf1428d6823d63358e7058779221612f606ec52","nasal":"f135a7e66e469ed8fb9a2efc93617d5bed929857c