2,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-83-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2077006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"989052cd88b50e756c206831233ad65b55fdf04f139ed206be4eaf5f310b28ee","compact":"397448d1309c2f6664160762f485b5c1cefe044156969bd090dd766e41e701ec","nasal":"397448d1309c2f6664160762f485b5c1cefe044156969bd090dd766e41e701ec"}},{"id":"VRCE-2-77-7","kanda":2,"kandaId":"ayodhya","sarga":77,"verse":7,"english":"And the honourable persons (belonging to all the three orders) went with the object of beholding Rāma in company with Lakşmaņa.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-83-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2077007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8f6558a74feae8def8f65a57555df3308c1a796f41cec731e70c193f1758663a","compact":"054032aa3b4c734c4ea05b90225af410706013993870678c13da636485794017","nasal":"054032aa3b4c734c4ea05b90225af410706013993870678c13da636485794017"}},{"id":"VRCE-2-77-8","kanda":2,"kandaId":"ayodhya","sarga":77,"verse":8,"english":"They with glad hearts variously conversed with each other, “When shall we see the mighty armed Rāma sable like to a cloud, of steady strength, firm in vows, the remover of the world's grief?","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-83-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2077008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f82790108703b82dc1a87c4419868fa8d14d30b0b3b86bb53f3306589d5fd5d0","compact":"beaef8125321b75f4c8517388c0d69aee0f836a6f38ad3190fa6e582bbffe0d8","nasal":"beaef8125321b75f4c8517388c0d69aee0f836a6f38ad3190fa6e582bbffe0d8"}},{"id":"VRCE-2-77-9","kanda":2,"kandaId":"ayodhya","sarga":77,"verse":9,"english":"As soon as we shall 