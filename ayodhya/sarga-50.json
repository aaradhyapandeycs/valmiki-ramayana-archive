[{"id":"VRCE-2-50-1","kanda":2,"kandaId":"ayodhya","sarga":50,"verse":1,"english":"When the night had been spent, that best of Raghus gently awakened Lakşmaņa from his light sleep.","alignment":{"type":"1:1","confidence":0.787,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-56-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2050001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"30348612e821a5d31401bf9918b4a21949855674950a3c8b262a31db99d34efa","compact":"30271b7f3cbb2271318dd78f23485c85a6eb5eab67b0e7c781ccc24af197e01e","nasal":"a4d93268157e97e44e73450c2912b6c441fff6188ce735e389ec4d4d59fdd16a"}},{"id":"VRCE-2-50-2","kanda":2,"kandaId":"ayodhya","sarga":50,"verse":2,"english":"O Sumiträ's son, do you hear the dulcet notes of the birds in the woods. Let us proceed. O repressor of foes, the time of our departure is present.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-56-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2050002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"919dcbb67182dc5821e7dd0bcc3aa1898e3ec80dad1c919d06feb5dbff47266c","compact":"bf2e8d4cd5bc6f8794009620920b015a442b0dc466b5fe101bd06b75bfa1a327","nasal":"bf2e8d4cd5bc6f8794009620920b015a442b0dc466b5fe101bd06b75bfa1a327"}},{"id":"VRCE-2-50-3","kanda":2,"kandaId":"ayodhya","sarga":50,"verse":3,"english":"Awakened at the proper time, Rāma's brother left off sleep and drowsiness and clinging fatigue.","alignment":{"type":"1:1","confidence":0.391,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-56-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2050003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"76fc6169ac3c279d5b098714d61a3b0b45e5650ae7878cb4268dfff97f3d62d2","compact":"ce904d70330f030453aafdf58706cc21e34fe19050d5c309aed1c56a595d7274","nasal":"3d6801107185fd8210