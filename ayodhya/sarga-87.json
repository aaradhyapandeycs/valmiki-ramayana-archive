[{"id":"VRCE-2-87-1","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":1,"english":"Afflicted by the mighty force on its way with banners (displayed), those inhabitants of the woods, leaders of elephant-herds, took to their heels in company with the herds themselves.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2087001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d21433c5828efecbaf84c24e8d4b1fc6eedf6d1716f019983f7ba8e9507d49cd","compact":"5cb68c4430a1c6c5b5da9c8c228d74bfb14513afd37c851a08400e7e68b675d8","nasal":"5cb68c4430a1c6c5b5da9c8c228d74bfb14513afd37c851a08400e7e68b675d8"}},{"id":"VRCE-2-87-2","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":2,"english":"And bears and Prsatas and Rurus were on all sides seen in the forest-ways, and on hills and rivers.","alignment":{"type":"1:1","confidence":0.625,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2087002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"41d7f807a1b9a788852fe986717b1715cbb3d58d1a1258445b6d70f294135b22","compact":"fea1b28bb601f72b3c13b4cabe9885784de35ea85d26d1ee01aa748da1c14c55","nasal":"72794f57868fc768d6de1b992a091bcf1c3dffa913064ea14ec431b0a07df5da"}},{"id":"VRCE-2-87-3","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":3,"english":"And that virtuous son of Dasaratha with a glad heart held on this way, surrounded by that vast army consisting of fourfold forces, raising a tremendous uproar.","alignment":{"type":"1:1","confidence":0.951,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2087003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb88d273d4d9a3cc11a1522cbd8c04648d5d0c449dd828fbc426105cbabeed6d","compact":"b2028460e42d89828215886c539c46556275b910caa605ccbc6339be6fe31a0c","nasal":"adbb1bd63ca34af5fa31f5b720d8b9592ff9ab0964b83a5946aa26de6c13d8f3"}},{"id":"VRCE-2-87-4","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":4,"english":"And that army of the high-souled Bharata resembling the waves of the ocean, covered the earth quite, as clouds in the rainy season cover the welkin.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2087004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f1168b1d37e8b58f6ffb8f5ee153787f3e5ef2843696d53b3ce26a8d207c820","compact":"91045841e653191c1937849adabf75501998934ba4ef87043eddadada47f8d78","nasal":"f2a4df61d50954863e9fdd724bbafd0f0a59974942f9344a456c879438ec9c3b"}},{"id":"VRCE-2-87-5","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":5,"english":"And filled with steeds and mighty elephants, the earth at that time for a long while remained invisible.","alignment":{"type":"1:1","confidence":0.789,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2087005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f824019dde918110a3d40cb9d517c28db1800be8d179ee95b75e6d6f5bfd8ef1","compact":"09269caa6fab27e9912482ba919e6ea497ea338ddc489b3f372500d39111491a","nasal":"09269caa6fab27e9912482ba919e6ea497ea338ddc489b3f372500d39111491a"}},{"id":"VRCE-2-87-6","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":6,"english":"And having proceeded a long way, the graceful Bharata, with his bearers extremely tired, said these words to that foremost of counsellors, Vasistha.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2087006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"35398c563dfbc00f1b9ee9983aacb6e427604b46385b78b1f674627f8d6e9858","compact":"8758a569a65ee7e7a9a7eb62305d751abdba465fefa82cb24f60fea41336fd03","nasal":"f6ba39e219160240f88b433f19020f8da38ebe9f0f478c266c7ed15f2784a62c"}},{"id":"VRCE-2-87-7","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":7,"english":"From appearances, and from what I had heard, it is evident that we have arrived at that region which Bharadvāja had told us of.","alignment":{"type":"1:1","confidence":0.765,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2087007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2aed0d7ad4477daab07fe38ff6ddf2a5095b0b4dc822f40359ff7fb1c7c2708d","compact":"7291ddfaec3069bf46bf744a076e8d9fa63cb6459c5a11b286b89e9d14057bf2","nasal":"7291ddfaec3069bf46bf744a076e8d9fa63cb6459c5a11b286b89e9d14057bf2"}},{"id":"VRCE-2-87-8","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":8,"english":"This is the mountain Citrakuta and that the river Mandakinī. And from a distance this forest appears like dark clouds.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2087008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85335367d82ba4e892ca82b47b598dd198386f48d8f61e64cb14dd5280a97e79","compact":"a62d09009adbd1f792ceb6ecf2030002e40e6799605e9d07128a15710a69ff1e","nasal":"0964cd4f0bf529d262f545143e6f5f0c4c7330ae78ac406077ba2da02ef3c1cd"}},{"id":"VRCE-2-87-9","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":9,"english":"And now our elephants resembling hills afflict the romantic sides of Citrakuta.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2087009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6935a24935b7bb8003b84a0ed030d714108a332fb753f0c4ca20ff5018786515","compact":"d580fbbb655d2860d9d318ae682033b9a523e80e41145885f1df3284285224c7","nasal":"5de4255be3e11ac4ec4cdf20555fb570b308dd91480ae1405a2b382706b5a263"}},{"id":"VRCE-2-87-10","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":10,"english":"And the trees scatter blossoms over the sides of the mountain, even as after summer sable clouds pour down showers.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2087010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17c65da4a711ef8cab52934c4a855df94b7f2a6ef65016d643fd57013fca9c8c","compact":"9a4d8f1b1b8475cc243e1adc8c334f8d1b632344ac3aefb1ab67e81a88c2d2b4","nasal":"b2ff61a51a5402fecc67c9c34c1a5ee8f9a1fd7c4014e4491fbea498bd7ec041"}},{"id":"VRCE-2-87-11","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":11,"english":"O Śatrughna, behold the realms inhabited by Kinnaras, scattered with steeds, like the main with makaras.","alignment":{"type":"1:1","confidence":0.623,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2087011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3ceceec7d2ba583c958bb9b260e449435d5bfcc146fc4053a718b403718addcc","compact":"9a61b8a7d7185960c55c5851956cb647305ffb38b113527db4c54b309da28cda","nasal":"d086ed6ef07657aa0222b4490487cc8220e00db20a73e5c96ff63b04d09a0f67"}},{"id":"VRCE-2-87-12","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":12,"english":"And these herds of deer furnished with celerity, being urged on, roam about like masses of clouds in the sky in autumn, propelled by the winds.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2087012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b654b2658dffa683a507cac3869ae85f5edf45dab4e300414cf1727a94a9156f","compact":"9eee29be993a01394f63fb02142dc706e735c1386b2e8a2f5f96ae39a633b866","nasal":"ce2807a3d0efb60d621b2baf348557bbef2159a7640174725d2cf656b2ec1b11"}},{"id":"VRCE-2-87-13","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":13,"english":"And like the people of the south, these warriors bearing shields resembling clouds, are adorning their heads with ornaments of perfumed blossoms.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2087013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27541c7f57ada95342389bedf4c0556ea2eede8e56b9c490500fb7da4b6b064c","compact":"70272e35a608d04e4b0257693acc722a688620b962407f01dc72f195d80c5245","nasal":"62f9b682454d3a9a585474ac6733fef687904b9e96bb65c03aff765aed05d6c7"}},{"id":"VRCE-2-87-14","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":14,"english":"And this forest, although void of men and dreadful in appearance, at present appears to me like Ayodhyā teeming with people.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2087014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f561627ac39720ea35155ab7c4948c78f7004524ebae41bd7fbc4ed82bc6db60","compact":"ddf285d4ce028da474aa9234806ef286b01dbc6607e7998f309a95567ae76d92","nasal":"ddf285d4ce028da474aa9234806ef286b01dbc6607e7998f309a95567ae76d92"}},{"id":"VRCE-2-87-15","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":15,"english":"The dust raised by the hoofs (of horses) stands covering the sky: anon the wind bearing it away, compasses my pleasure.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2087015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"22f1df3a9e0ec36aeb40e42f6378c4bbd87a9d4cf688d1a8590c0e7612b5a1dd","compact":"4e6ff3806c8d2bd470781bfe201d0be937682ed360be243bc2bd1cf788d07fd9","nasal":"21d6a2746eecd88c141507d0132cee5a9762b04fef31fe9f02eed76643231ad3"}},{"id":"VRCE-2-87-16","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":16,"english":"And, O Satrughna, see how fast these cars yoked with steeds and driven by skilful charioteers, are proceeding in the forest.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2087016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8f94c38af7857277a5af8dbd3048fa9d8e388d986c81c464f1995d1ae6d8fbc8","compact":"2aa0d43427999d1247b66243b13e1c5ddf475d573a036c3e02e49794fda10e1c","nasal":"e8452e35eb21814ef313a9ea051af3b2aaf80b833c954656f28e9b503d26166b"}},{"id":"VRCE-2-87-17","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":17,"english":"And behold these beauteous peacocks, which, being frightened, take refuge in the mountain, the home of feathered tribes.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2087017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19c5d66a130b74ab161652611f4f0bf973a5e8c192b66c232e104ae9eafb4441","compact":"f8c82babe64f5dee9179112fc52a9b5c8d321164bb4a12c7069c3fb286372fc5","nasal":"f8c82babe64f5dee9179112fc52a9b5c8d321164bb4a12c7069c3fb286372fc5"}},{"id":"VRCE-2-87-18","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":18,"english":"This country appears to me exceedingly lovely. This abode of the ascetics is like to the way to heaven itself.","alignment":{"type":"1:1","confidence":0.82,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2087018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"21fd9611d97d4e4c479df0fdca7be56866cc92a24c136bbad2b883870b35cac6","compact":"c4ef98ebc3eee176578be9069936deec384d28279103b92f3775598577e502df","nasal":"c4ef98ebc3eee176578be9069936deec384d28279103b92f3775598577e502df"}},{"id":"VRCE-2-87-19","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":19,"english":"Male and female deer and Prşatas in the forest, beautiful to look at, appear as if variegated with flowers.","alignment":{"type":"1:1","confidence":0.983,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2087019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0f463153480ce7f164380edb051ad99c5bb051beebc0843e849ab9712decdfad","compact":"bc796b89ee7be4b9462384494db5a592854881016e5264986e08b7a92ea4238b","nasal":"b89c8227ce4daba48849705b3cd727301e072f4a88a5b231c9a4ecd857612a19"}},{"id":"VRCE-2-87-20","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":20,"english":"Now let the soldiers go advisedly and search this forest, so that they light upon those chiefs of men, Rāma and Lakşmaņa.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2087020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42629a829a5244b5f1fbdf3532363f153048a4b418a6d3ee7022d0ce1f81f9ea","compact":"abc56e1b4f1d493f6b0a46127b1b234c1a4439121e3d3c4788d07fdc070407e5","nasal":"adb4105331f9e446db21091dc8892280b147106eb88ff43a301f78ac8c4a9f00"}},{"id":"VRCE-2-87-21","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":21,"english":"Hearing Bharata's speech, persons with weapons in their hands, plunged into the forest, and those heroes presently discovered the top of a (column of) smoke.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2087021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"abc33e83e9c1461068d17e22363e12459e1588a81a96205becb158de00a72bac","compact":"0d581645ba63ceafc58533da28b2cfd366a01a001082b96d3b9f7a24a02d9f17","nasal":"0d581645ba63ceafc58533da28b2cfd366a01a001082b96d3b9f7a24a02d9f17"}},{"id":"VRCE-2-87-22","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":22,"english":"Having seen the top of the (column of) smoke, they came before Bharata and said, \"Fire cannot exist where there is no man present. Therefore it is evident that even here are those descendants of Raghu.”","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2087022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"619719963991e399291ddef3d3fb0ae3d096af4e808b1f82b1fd27267f5d068b","compact":"1b229613f3407a65a68b14670cff6756dab4fad0eba025725d149f78c74f7c3c","nasal":"1b229613f3407a65a68b14670cff6756dab4fad0eba025725d149f78c74f7c3c"}},{"id":"VRCE-2-87-23","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":23,"english":"But if those foremost of men, those subduers of their enemies, the princes, be not here, there are others, being ascetics, resembling Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2087023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2e0af4d30817d7c6cb7f492cb9014a99c169dc985784b627f6bdc0375024b1b9","compact":"6213fd05683206b9297fc5f2adc8b78559ad80af783fae6fa15b2d04dbd3f93e","nasal":"1c0d38d3d0a2e2f63408bcefca2855de85907136aea9a1d1acc9fe5835f105dd"}},{"id":"VRCE-2-87-24","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":24,"english":"Hearing their words acceptable to the pious, that afflicter of hostile ranks, Bharata, said to the entire army.","alignment":{"type":"1:1","confidence":0.635,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2087024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"89d4eb0f032c52e445efcc499f211eae34803d7eb4e5785017d21fcd02af9d9e","compact":"6abd8676f857ad34f8c5dabaa33fd5b485c59002d8f200b3e09c3794ed468302","nasal":"6abd8676f857ad34f8c5dabaa33fd5b485c59002d8f200b3e09c3794ed468302"}},{"id":"VRCE-2-87-25","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":25,"english":"Do you carefully stay here: do not proceed further. I myself will go, and Sumantra and Dhrti.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2087025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"024d3c69ca5793b6e508839ed29eb31937af3c07da282e1acbf6e9fbade739b2","compact":"e9fbd389ac32bfbaa11810b0457dd2e90b8fb80cc4c9d52ed1ee9103ddd45aee","nasal":"1fda2fb211fa11425582289617ac34095c4f4189517c8f67bba78c097c9eb506"}},{"id":"VRCE-2-87-26","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":26,"english":"Thus desired, the troops remained all about that place. Bharata went away, keeping his gaze fixed in the direction of the top of the column of) smoke.","alignment":{"type":"1:1","confidence":0.823,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-26"],"status":"unreviewed"},"source":{"sanskritLocator":"2087026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d64766cd5d1f98ab9ca8a6c5c6755671444cffdbf66ea62124a91eb448f6441","compact":"9514504998c6787eb8b6072527e00cfd0639136e455356fb0646a30966cb2193","nasal":"2e263cf5ab698323b233b0dbd68cd46b52fa64975f400cae6b25dd680e807063"}},{"id":"VRCE-2-87-27","kanda":2,"kandaId":"ayodhya","sarga":87,"verse":27,"english":"Desired by Bharata to halt, that army, looking in the direction of the smoke, rejoiced soon on learning that the beloved Rāma had arrived (at that place). Desired by Bharata to halt, that army, looking in the direction of the smoke, rejoiced soon on learning that the beloved Rāma had arrived (at that place).","alignment":{"type":"split","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-93-27","DUTT-2-93-28"],"status":"unreviewed"},"source":{"sanskritLocator":"2087027","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a45f42c9f7e79c66d4bd06c88591f9e41d88d65a918fb018bfbd9e09e70da6e4","compact":"fff7e357a26081229c7f08e4a3953bd05b1c05169d1618d4ab775adb7cf70a03","nasal":"fff7e357a26081229c7f08e4a3953bd05b1c05169d1618d4ab775adb7cf70a03"}}]
