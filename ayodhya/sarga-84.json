":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f84cd8f5293c103b4e121b57e52a3f5a1abbe139e924146e6291961b2deccb90","compact":"c2f1b998554045de18ba863d11dd77a3380438cda04b36c9dadacef603bea6e0","nasal":"3fc0cf30feffaebc4b8024aae2bb7a80e9da9b59c3969e02e301f5641720ee0e"}},{"id":"VRCE-2-84-16","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":16,"english":"Whatever my mother has said in relation to me, does not express my wish, I am not satisfied with that, nor do I endorse her speech.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2084016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87ed3c6fd99ca01df4a44ad84db14d8057e3d665463209f3815befe292f29889","compact":"6f0d0df603fe52f78c10c7c2e7ee39c2ecc62261c6a6ac78f5d1d6d798c2c7fd","nasal":"0816ada0771581b0d25f2202fc8b2ba70e613793ea932372848e2efece40ca78"}},{"id":"VRCE-2-84-17","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":17,"english":"I, intending to pacify him, and going to that chief of men, with the view of taking him to Ayodhyā and of paying homage to his feet.","alignment":{"type":"1:1","confidence":0.774,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2084017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1d62e348d56401a1983aae90cc2eaa7731fd011df2df0a25b1a8af2ad988095b","compact":"451d76bb721eaf453ec7f57a58c5c37a9992081aa5525a69a57a5a74a7ec5665","nasal":"c16594243b8a3d6ecb02df1240b27550518f4ca1b0675313f8d42cc30e80a0c0"}},{"id":"VRCE-2-84-18","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":18,"english":"Thinking me as already gone, you should show your favour to me. O reverend Sir, tell me where stay at present Rāma, lord of the earth.","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2084018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"34cb0cfb7fa19fbddcff66aa9d434afa0ccc2e2e4474a87912e01d1388f89986","compact":"b075def3ecc9760d9535d9518ff00fcb85aa8d0cf60ea6fd38bc1be9ec51a7ce","nasal":"b075def3ecc9760d9535d9518ff00fcb85aa8d0cf60ea6fd38bc1be9ec51a7ce"}},{"id":"VRCE-2-84-19","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":19,"english":"foremost of men, even this is worthy of you. Serving superiors, restraint of the senses, and following the pious, are ever found in one sprung in the Rāghava line.","alignment":{"type":"1:1","confidence":0.688,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2084019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8452f10d54dbb6c2319966827a30857ac5ee99a9091733ae820f45c610ccaa3","compact":"87da26175c812c5fca9bed7a1bdecbe28abb9901e1512a156c8bdc9af989d0e4","nasal":"87da26175c812c5fca9bed7a1bdecbe28abb9901e1512a156c8bdc9af989d0e4"}},{"id":"VRCE-2-84-20","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":20,"english":"I know that even this is your intention, but for the purpose of making your mind all the firmer, I had asked you in this wise; so that your fame might greatly increase.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2084020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04939ef3975c27aa9e08752f2ac2df8204780e51b8923b190c5791e00867422f","compact":"25d6aa06dd189780a4c51d03dbe3a1941a3e3173cc687a7f910b72f1f9c0dae7","nasal":"25d6aa06dd189780a4c51d03dbe3a1941a3e3173cc687a7f910b72f1f9c0dae7"}},{"id":"VRCE-2-84-21","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":21,"english":"On the morrow you will set out for that region. Do you to-day sojourn here along with your counsellors. O wise one, do this at your pleasure, O you understanding interest and desire.","alignment":{"type":"1:1","confidence":0.677,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2084021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cf4ac823d43674b72da185a781bcbfb65538b1c13745a8470528a4be7a89710c","compact":"d58f5dd77477573cf46c45fe644fd57f5bbf7d8613194272ec4adc59c796c006","nasal":"e25a82f6746fd1148ce8f216b4a58591d4d7ddb35f5178acfd321c695a2a32f8"}},{"id":"VRCE-2-84-22","kanda":2,"kandaId":"ayodhya","sarga":84,"verse":22,"english":"Thereat the gently-looking and highly famous one said, “Be it so;\" and the king's son made up his mind to spend the night in the great hermitage (of the saint).","alignment":{"type":"1:1","confidence":0.826,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-90-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2084022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6669a253e0edc7ef862bf37198d2041f44b00d9c64f6819ad718dd03b735c20b","compact":"d0063a2d1f59c945f37352911dabbb8b4ef24736bceef288fd05169c0c8ebd4a","nasal":"d0063a2d1f59c945f37352911dabbb8b4ef24736bceef288fd05169c0c8ebd4a"}}]
