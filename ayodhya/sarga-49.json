[{"id":"VRCE-2-49-1","kanda":2,"kandaId":"ayodhya","sarga":49,"verse":1,"english":"Having spent the night there, those princes, repressors of their foes, after paying their obeisance to the Maharși, set out for the mountain.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-55-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2049001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7424f81dd4a7bc1632583d8a1c99a4c3f2aa03896f2d915013e0ed2ed6f3074d","compact":"f4d8d6627e7b671aa83387f20d735e1b565f4ec93e345a157682556208b59bf2","nasal":"f4d8d6627e7b671aa83387f20d735e1b565f4ec93e345a157682556208b59bf2"}},{"id":"VRCE-2-49-2","kanda":2,"kandaId":"ayodhya","sarga":49,"verse":2,"english":"And that mighty ascetic, Bharadvāja having truth for his prowess, addressed them, saying.","alignment":{"type":"1:1","confidence":0.329,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-55-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2049002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"865c17610c8979775af599c9fc2f73955db5e52ba7c942fea3ed7c7685a4820a","compact":"c585625786d25ef4134f159c5259c85beae868002261c892218d9e8f4adf699c","nasal":"c585625786d25ef4134f159c5259c85beae868002261c892218d9e8f4adf699c"}},{"id":"VRCE-2-49-3","kanda":2,"kandaId":"ayodhya","sarga":49,"verse":3,"english":"Arriving at the Kalindi running in a contrary direction, you will, O Rāghava, behold a goodly bathing place well-worn by foot-passengers. There constructing a raft, do you cross over the river who is the daughter of the Sun.","alignment":{"type":"1:1","confidence":0.508,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-55-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2049003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a556247ef4f6da218f74a98d1ebc40f13312b762f17104c0527b9a3ed3e8f77c","compact":"56ff517977d645bf78a9a10ea74bc128f67d1c1eba498635ff2cce6af4f5405c","nasal":"ddecfcb7a0c1b983923ab18c1961fab1f2c86de99d0e1cac6eae308301804034"}},{"id":"VRCE-2-49-4","kanda":2,"kandaId":"ayodhya","sarga":49,"verse":4,"english":"Next coming to a gigantic banian tree with green foliage, named śyāma, surrounded by various trees and inhabited by ascetics of accomplished purposes, let Şītā with joined hands offer humble supplications to it. Having come to the tree and, whether staying under it or proceeding along, after passing only a Krosa, you will, O Rama, see a wood abounding in Sallakis, Badaris, and other wild trees belonging to the Yamuna.","alignment":{"type":"grouped","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-55-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2049004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cc9c5318a2b9803502afbd547da80497eb9973ddde04bb122d7a1e4e9a74eab5","compact":"16161bf19766360bddc5b79ba2741e735b2cf468b7ae0ab4446e1a5cf812a398","nasal":"fb1a56350c89f76bf3738de31055821ee1335e2841ae8448ffe6d4d46bfee5aa"}},{"id":"VRCE-2-49-5","kanda":2,"kandaId":"ayodhya","sarga":49,"verse":5,"english":"Next coming to a gigantic banian tree with green foliage, named śyāma, surrounded by various trees and inhabited by ascetics of accomplished purposes, let Şītā with joined hands offer humble supplications to it. Having come to the tree and, whether staying under it or proceeding along, after passing only a Krosa, you will, O Rama, see a wood abounding in Sallakis, Badaris, and other wild trees belonging to the Yamuna.","alignment":{"type":"grouped","confidence":0.387,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-55-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2049005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dd961c190b924cf4844d56cf2bbd0493d94d775e9c77cd0cb2f16213f7d612a4","co