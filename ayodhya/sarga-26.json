[{"id":"VRCE-2-26-1","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":1,"english":"Hearing these words of Rāma, Sītā greatly sorry, with tears in her eyes, spoke gently to him the following words.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2026001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e517f6f6d4fa5358629d9b1df8efd4b975e7d77aeb5d653b23e9912549a830e4","compact":"1adfa1561d81d645be37869ee0b62f8e682ea282bd7b3b13ec62bca92e317bab","nasal":"8c62fb667052c56edee649b9d2bd2cc8a6e2731aae5ab05142cc1b13c5b68c64"}},{"id":"VRCE-2-26-2","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":2,"english":"The evils, thus enumerated by you of living in the forest, do you know, appear as so many good qualities to me, who have been made forward by your affection.","alignment":{"type":"1:1","confidence":0.971,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2026002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"54ab1ee8eb3286b9dc3085aa21c1845f180c17f9f8efe7398143e62e34aaac5f","compact":"f97570e0c08ec49ce57885ca0937d2a466e6823b8098f6591e9adb3f4b79ff36","nasal":"f97570e0c08ec49ce57885ca0937d2a466e6823b8098f6591e9adb3f4b79ff36"}},{"id":"VRCE-2-26-3","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":3,"english":"I shall follow you, taking the permission of the respected ones, without you, O, Rāma, I will renounce my life.","alignment":{"type":"1:1","confidence":0.967,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2026003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6742b5d744f594df5746934f6b79384db7de70af7e7b85dd25ff1763ca426c1b","compact":"d357002af9258597797a3e8a53e45199067845a77476fc0f98a0f726b0229487","nasal":"9a2f488a62f37b5bb1a78cbb2532708131c0d6d59039eaa335d204cf3f17d827"}},{"id":"VRCE-2-26-4","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":4,"english":"If I live by you, O Rāghava, Sakra, the lord of celestials, shall not be able with his mighty power to defeat me.","alignment":{"type":"1:1","confidence":0.552,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2026004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"45a4ab260f5678951a4e30044e0e33e4b0720546a3a2570dd2528f678e1c1ded","compact":"faed855c04b8f506270a62574dab499a5d9fab2e9452548e9f3c27217ea89657","nasal":"faed855c04b8f506270a62574dab499a5d9fab2e9452548e9f3c27217ea89657"}},{"id":"VRCE-2-26-5","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":5,"english":"'A woman, without her husband, cannot live' this truth has been pointed out by you. O Rāma, to me.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2026005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b188f13d588d8b41059188e859f44937f52b4b8c97268190e4ab7b76f6a9314","compact":"0ecb9f663574049bdf5406f4dd5286e6c8ac64035bf4abc4fc044f3540d9d1ae","nasal":"0ecb9f663574049bdf5406f4dd5286e6c8ac64035bf4abc4fc044f3540d9d1ae"}},{"id":"VRCE-2-26-6","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":6,"english":"Besides, I heard before, O you of great intelligence, in my paternal house from the Brāhmaṇas that I should live in the forest.","alignment":{"type":"1:1","confidence":0.906,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2026006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8a504adc371402dd9b362705708893d1fa3f070b060c3050f2a7a0af9ee1584","compact":"2241f400e93b99482855a44906b227b59b3c1459637a644a38fe5a8d2299a1a4","nasal":"014a63ea982c9953ee6c97fb0575325e7cf5daa2422d98dd9a4d11c77f062b7d"}},{"id":"VRCE-2-26-7","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":7,"english":"I have heard this from the Brāhmaṇas versed in palmistry, and I have all along been anxious.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2026007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e496f07bfa7960935ec82b5bbde79c23f029eb55b5d64ef70a325174a7d9fb2","compact":"c84d13dc91902ae1c45b0e17f212582035eb8135bf4ac88c43cb44d49a4f0aa2","nasal":"c84d13dc91902ae1c45b0e17f212582035eb8135bf4ac88c43cb44d49a4f0aa2"}},{"id":"VRCE-2-26-8","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":8,"english":"O mighty hero, to go to the forest; I shall therefore obtain permission and go, O dearly beloved to the forest with you; nothing can make it otherwise.","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2026008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b7f9cd878ec56bba78f9d296d77500e5fe1dc084ae0d8861b6593c00594cd11","compact":"c81272b899ab22f7611317d4cc3ab725bf8713b03d84e24dffca269ef2957fb5","nasal":"c81272b899ab22f7611317d4cc3ab725bf8713b03d84e24dffca269ef2957fb5"}},{"id":"VRCE-2-26-9","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":9,"english":"I shall secure permission and follow you; the time has arrived; may the Brāhmaṇas be of truthful words.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2026009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55f9602c0a44e2ab04188827b5d1cb19818d2d70b934ab04fe28eef92dfb9cf8","compact":"a10696dc2e48b9d61c485d4c2df43c701c21254ec88b4980f9e538cafab42372","nasal":"d6b7fb8799b72b7cfdb8cc3590ac8c0cadbe577ee2d88207d3e80848e9b3bcfa"}},{"id":"VRCE-2-26-10","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":10,"english":"I know, O great hero, that there are many evils incident to living in the forest; but they generally befall those men who have not their senses subdued.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2026010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a313d9e8fab7c98005cc55318af1a219db528c824e8224e3d2960f36315e0c3a","compact":"dd997916dc1d5d3e03faf812549aa207e60596aff680b657f0360a9f24623318","nasal":"9275ce5c66b5d2f041c48d507b2d6dee8df8bbdb074f40223ca3448957d9acd0"}},{"id":"VRCE-2-26-11","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":11,"english":"I heard, when I was a girl, that an ascetic woman of well-disciplined character, came to my mother and apprised her of my future abode in the forest.","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2026011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"658f9998efb8bd64b569ec59b3125b7330ce8ab4f4b7df188800e63722be18c2","compact":"9da88992908b020bb7996fd4df0c04e3df401a04e4d7489aaeced457f9f98b73","nasal":"9da88992908b020bb7996fd4df0c04e3df401a04e4d7489aaeced457f9f98b73"}},{"id":"VRCE-2-26-12","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":12,"english":"I had requested you, O my lord, many times before in this house to take me to the forest with you for enjoyment, and you ware pleased to agree.","alignment":{"type":"1:1","confidence":0.557,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2026012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1317756c8b409835475c76363c4d971dbcb5cb763f959c5ca2df9e269d480bf","compact":"e5b138dd37d21a97e787201690f4af07c592153af2399acdd8a14a96359ae54d","nasal":"2532cb13afdee90964c83f21e7ca1172095a54c7bbac6ad7d95cb15497f3c37d"}},{"id":"VRCE-2-26-13","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":13,"english":"For your welfare, O Raghava, having received your permission to follow you, I like to serve you, O great hero, while living in the forest.","alignment":{"type":"1:1","confidence":0.725,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2026013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bf4046369c2e97c25c65d370e53f8c27cf70bd492054a590367ee42e731c7764","compact":"368dccbd0557edcd63b81d7786102def79c17c3c2347d5ded82b1966342e8de6","nasal":"368dccbd0557edcd63b81d7786102def79c17c3c2347d5ded82b1966342e8de6"}},{"id":"VRCE-2-26-14","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":14,"english":"O you, pure-hearted one, surely shall I become sinless if I follow my husband, out of affection; for my husband is my Divinity.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2026014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"baf8171f9663b638b46db7b78f9942bac51599d71c81c9e936d69509727ccee5","compact":"cd8868b6decd3d5def3fc7dccff2f5efcac62ee1606eb44ee0fb3d80903d6e0b","nasal":"ae36fca7445f5d2250f2ec94a958f6fa1d59a1d79a55a8b66f5531b7605a220e"}},{"id":"VRCE-2-26-15","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":15,"english":"I have heard this pious report from the Brāhmaṇas of great fame that even in after life your company is greatly beneficial to me.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2026015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"020c099d0232d8a2c6224d365e6f0405ff49b5bc1d55e588732315402b7407b7","compact":"87d7faa66330f5b45657879710339a0a8df7737907949f1ed1e0fd5a70d83453","nasal":"87d7faa66330f5b45657879710339a0a8df7737907949f1ed1e0fd5a70d83453"}},{"id":"VRCE-2-26-16","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":16,"english":"She, who has been given away as wife by her father to one, with due rites of gift peculiar to each class, touching holy water, shall be his, even in her after life.","alignment":{"type":"1:1","confidence":0.848,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2026016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7dab3b2763c83a596b4a97dad81b498381453ca4e14d844ed5059d074bb34f19","compact":"92d7d5af7a27e6106babbfef77864313579bd5b0a0061769a9a3bd13d683b0f5","nasal":"92d7d5af7a27e6106babbfef77864313579bd5b0a0061769a9a3bd13d683b0f5"}},{"id":"VRCE-2-26-17","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":17,"english":"For what reason then did you not wish to take your wife with you who is of good character and devoted to her husband? Do you take me.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2026017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8c22d48def419a9600ff8f5af4ab9ce096d00604f147d417a876fdf1d41b7431","compact":"b9cb070555f9cfda059f2f6c6a88e267cc4f73ff0ccdb7717665d6cd4bf9f0a1","nasal":"b9cb070555f9cfda059f2f6c6a88e267cc4f73ff0ccdb7717665d6cd4bf9f0a1"}},{"id":"VRCE-2-26-18","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":18,"english":"O Kākutstha, who am poor in spirit, devoted to my husband, ever given to your service, and participating equally in your joy and sorrow.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2026018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9454e870e01aea182d87d465dc2d3db59fc7f4a88efb33b4c0b8c6650ba08a1d","compact":"2340cd99e21541acd7ad6f313ad2ae2430fe701a4b68db052d956381e9b02819","nasal":"2340cd99e21541acd7ad6f313ad2ae2430fe701a4b68db052d956381e9b02819"}},{"id":"VRCE-2-26-19","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":19,"english":"If you do not purpose to take me with you, surely will I do away with my life by drinking poison, entering into fire, or drowning myself in water.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2026019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b978a60794676c50d19664981eb69c2db5b64392866a6d2a96408358f0ed30a","compact":"3269ba76a3e25149fc98f7e6cf6ad6dab510bf6d2fa99b319b9148da3368548d","nasal":"3269ba76a3e25149fc98f7e6cf6ad6dab510bf6d2fa99b319b9148da3368548d"}},{"id":"VRCE-2-26-20","kanda":2,"kandaId":"ayodhya","sarga":26,"verse":20,"english":"She begged Rāma in these and various other means to take her with him, but that mighty hero did not consent to lead her into the lonely forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-29-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2026020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e815aadf48b8ec3aa03398809462cb435b447eaba126eabf154ce05e667cc499","compact":"32752bdfe71f60719ebe8ae47665224b945e025fc90b751fbded5e5563be4136","nasal":"32752bdfe71f60719e