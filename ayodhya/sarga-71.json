:"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2071011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"56f6b5f4a99450ede40d9e3d379ea6baba776d4dfa2ecb4dadaba1e953c7be29","compact":"df8c37c7b3df5fc3bfedd1c309e48926ba0603daa680385af4bc945678e6b5b2","nasal":"df8c37c7b3df5fc3bfedd1c309e48926ba0603daa680385af4bc945678e6b5b2"}},{"id":"VRCE-2-71-12","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":12,"english":"And devoid of sense and like a madman, he in grief of heart began to lament remembering all the virtues of his father again and again.","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2071012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8373f1a5f634499bcb609d0304976698e3be651197b67690f4fd72660fa186d3","compact":"20ce3cd4222aac3a2f258b2a767d40558fcf194c30a544888e92f622f1944882","nasal":"0061a4684bc3aa47ae2c396a65dd7400b1db9aa27d1e372ebf9761710a28cd98"}},{"id":"VRCE-2-71-13","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":13,"english":"This terrible sea of grief owing its origin to Mantharā, containing its ferocious aquatic animal in the shape of Kaikeyī, and incapable of being disturbed in consequence of the bestowal of the boon drowns (us).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2071013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b39e5bd6e725f9d5aa243ef8cf0f9def97b7f04d328476231edbe1d26e4fdfdf","compact":"0478044beadb3c2ab015f43765a88ccc793e2c111cbcd900e92558dc127cbfee","nasal":"c5e09fb03d876536d7d4b663a95cc4fbb286c2fca99db8221edb7837b2386e91"}},{"id":"VRCE-2-71-14","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":14,"english":"O father, where have you gone, leaving the tender and youthful Bharata fondled by you, to lament (your loss).","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2071014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"37935799de3cd74aa954107bf42c27d5f544c273b2a7307261b0deb0990207c5","compact":"17b9587922152cbf8312c0703b626264c033c5a29ad267c47816d7bc97151c52","nasal":"396c7bbcd3d6c2cb332e77bf047d08dc8d52017426ed0054b2a5c70024254223"}},{"id":"VRCE-2-71-15","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":15,"english":"You did use to confer on us eatables and drinkable and attires and ornaments. Who will now do so?","alignment":{"type":"1:1","confidence":0.662,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2071015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"222112fe0d8242b0b6d5a9c750faa796f93ea4c56d1b75cefa16eeec2c11ac6e","compact":"ddbf8e56cc410adb7ba95d39129f80d11db9bde74c320686a0c773b283ebbb48","nasal":"7c520daed73eebe612792790a00f922d752b0bcd0f25fd59207613fec24ad26a"}},{"id":"VRCE-2-71-16","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":16,"english":"Deprived of you, the high souled king cognisant of duty, the earth albeit her time of riving is come, is not yet riven.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2071016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f07e4e721c276b0f5a8f7f6ccc5382a4a7964aea454e48434115e8e38001870e","compact":"a8b299cb23688e24bd715513c530454ddde0a23c02deb22541157fc78a67276d","nasal":"a8b299cb23688e24bd715513c530454ddde0a23c02deb22541157fc78a67276d"}},{"id":"VRCE-2-71-17","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":17,"english":"My father having gone to heaven and Rāma having sought the woods, how can I live? I will enter fire.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2071017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b63497ac082f4e395d709ea206f55bd806b9ca64a04a4d68b992b56b101ac32","compact":"991f105a96f4a061c013ae7c5dab2171c6b7b667c998e53d2940628c8ff3159d","nasal":"cc9e2b59022acca54fbdde5139aa92635f87f82c9c6a03d7042314c7f659955e"}},{"id":"VRCE-2-71-18","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":18,"english":"Bereft of my brother and sire, I will not enter the empty Ayodhyā governed by the Ikşvākus. I will repair to the forest of asceticism.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2071018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"affe5dbc6a418e316ff6e0c6b077fbc5304b77eeb1ecda3ded6de65973558cf7","compact":"ae8b7ef2e0475b89d6bdaa7d57d59c9c3250efee239096856f09cb3715fb57f6","nasal":"ae8b7ef2e0475b89d6bdaa7d57d59c9c3250efee239096856f09cb3715fb57f6"}},{"id":"VRCE-2-71-19","kanda":2,"kandaId":"ayodhya","sarga":71,"verse":19,"english":"Hearing his lamentations and seeing that disaster, all the followers became all the more distressed.","alignment":{"type":"1:1","confidence":0.812,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-77-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2071019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c7683581999e92564c98f2c29b4016e4f7f8adc84a45d8e9bafd48eedeae0eec","compact":"9900677934b0f89d8a7657ae1df7922f106de31661fa22ec443d63aded96534d","nasal":"9900677934b0f89d8a7657