[{"id":"VRCE-2-38-1","kanda":2,"kandaId":"ayodhya","sarga":38,"verse":1,"english":"Then seeing the king lying down stupified with grief, Kausalya, aggrieved for her son, spoke to the lord of earth, saying.","alignment":{"type":"1:1","confidence":0.951,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-43-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2038001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ea651ca305731ea97b0f6986caa16fdbd672d3a8d5648df469239fc60024810b","compact":"864919abe36b554ecd5950891bc7fd3d487ac9907f91166ebca4d57cab1c7034","nasal":"4c264d9ae15e0a2c96a4663a9208007239e051e74f9c2aa67b32bb5dfd3a50b0"}},{"id":"VRCE-2-38-2","kanda":2,"kandaId":"ayodhya","sarga":38,"verse":2,"english":"O best of men, having vented her venom upon Rāghava, the crooked Kaikeyi will go about like a she serpent that has cast off her slough.","alignment":{"type":"1:1","confidence":0.462,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-43-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2038002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e7df684251932f37c6e40c6567eb7e033db191a049e1cdc4506809668e14634","compact":"9df97ab9c716489344e7113577a2e8e003eae1d94ede42a51005c8755ad94e26","nasal":"5026cc5b831949cba5476deb334d2e91aa207de92591e728f2419a67a1531dd5"}},{"id":"VRCE-2-38-3","kanda":2,"kandaId":"ayodhya","sarga":38,"verse":3,"english":"And that fortunate one having by her endeavours attained her end, will frighten me the more like a wicked serpent in one's house.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-43-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2038003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"df79525e17893d0c7ba62e4a12395bc678a3a7bbcabad4c74076e92ac2d3abd6","compact":"d2f65be1f1fab2ec6f76be8941e34d030db954ac330d9e8c