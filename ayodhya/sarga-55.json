[{"id":"VRCE-2-55-1","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":1,"english":"On that foremost of those capable of charming people, the righteous Rāma, repairing to the forest, Kausalyā crying in grief said to her husband.","alignment":{"type":"1:1","confidence":0.661,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2055001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d19cb196fb01b8c40daa74be803446cc4f65d5518694939744fd348b4cb9e65","compact":"da060185658db2e033de7443e3ca60771af35a0c29bf0508a46b5736683f19fd","nasal":"da060185658db2e033de7443e3ca60771af35a0c29bf0508a46b5736683f19fd"}},{"id":"VRCE-2-55-2","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":2,"english":"Your great fame has spread over the three worlds; and the descendant of Raghu is kind, munificent and fair-speaking.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2055002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fa5b2a1a89c8074f3f3bff8c321013ff085fbbc7325680e80047273bbc57c36e","compact":"ca828f208fa01bde375aa66fa3cb82acff8b97af9b57c7eab5d4626158ddf095","nasal":"ca828f208fa01bde375aa66fa3cb82acff8b97af9b57c7eab5d4626158ddf095"}},{"id":"VRCE-2-55-3","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":3,"english":"Why then have you forsaken those foremost of men along with Sītā? Brought up in happiness, and now brought to misery, how can they bear it?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2055003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e8dd8cf182dbd43dcd5906183c59e025bda76939bee06b44d2c43bb5c953ee1","compact":"4fce2c581acf49012b6aafba5a3d51f1ac2b96afdc12bb2807ee08f6b577103a","nasal":"4fce2c581acf49012b6aafba5a3d51f1ac2b96afdc12bb2807ee08f6b577103a"}},{"id":"VRCE-2-55-4","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":4,"english":"How can the youthful daughter of Mithilā of slender make, tender, and deserving of happiness, bear heat and cold?","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2055004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1bb7dce22cbd695d0edc472164cfec7b30df60d1195c33bfe530153f75da20dd","compact":"4cfd3539e0de23b7dc3dde6eadcf457471eee804ee1b1a203446b8c2f58e0858","nasal":"4cfd3539e0de23b7dc3dde6eadcf457471eee804ee1b1a203446b8c2f58e0858"}},{"id":"VRCE-2-55-5","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":5,"english":"Having formerly partaken of (excellent) rice with curries, how will Sita feed on wild rice?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2055005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"38cf34031ad1d189178a6898b3a20a4fa8fe678330d1acfe363ebfd96af6ad60","compact":"47aa4f772eff9f6d02a629e8a772408ef4747dabd48c8f1b537e40f3771e7605","nasal":"47aa4f772eff9f6d02a629e8a772408ef4747dabd48c8f1b537e40f3771e7605"}},{"id":"VRCE-2-55-6","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":6,"english":"Having heard excellent vocal and instrumental music, how will Sītă hear the frightful cries of carnivorous lions?","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2055006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"865610879c93af27c58d568c93a7369642dbdb5a449e54f8f4cda5f03a79b7ed","compact":"ec5a0df912