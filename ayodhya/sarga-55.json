":"2055009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ef1d2647f1bcfafa92fc889f8d65ebcb3469bd83334a5117ab4f933166579488","compact":"bbc5da1e0ad0918ff6e92b0dd51cec37dd56948405ab9e2bbf8808b91745072a","nasal":"469bc129480986e6e7eb03b3f1111fca9d7a7be5a1b7b1fa7fa37c0d40dd2358"}},{"id":"VRCE-2-55-10","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":10,"english":"If after the expiration of the five and ten years, Rāghava does return, it does not appear likely that Bharata will renounce the kingdom and the exchequer.","alignment":{"type":"1:1","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2055010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"896836e086d2f07f04a3fcc19f1c4e3210db4eebc78e8d20bdd5ea0fe7e12320","compact":"e9a8b8245bcdd6523d2a8d0139a147773fcc9ddbadfe2b766a0cc13274333c92","nasal":"a170ae7b4b480688636e9965f9fcff3540843206e236e354e589b4e6994b72bd"}},{"id":"VRCE-2-55-11","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":11,"english":"Why will not an elder brother and one who has sterling merits, O monarch, disregard a kingdom which has been thus enjoyed by his younger brother?","alignment":{"type":"1:1","confidence":0.592,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2055011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0ed978755ac15e4e4d3e1c122551f312f423780a119ce3ea24defcbaf4b0fd9","compact":"0d899f403ee94ce0ff27da6ed09fc902d1670c385a5397af77a70c772bf392a5","nasal":"0d899f403ee94ce0ff27da6ed09fc902d1670c385a5397af77a70c772bf392a5"}},{"id":"VRCE-2-55-12","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":12,"english":"A tiger does not like to feed on food procured by others. Even so that tiger-like personage does not regard anything that has come to be tasted by another.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2055012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"020a7f2a5da465993f5fcc76dcded38f223164632d66c7fafe5f6c223cf0b3a7","compact":"aa7de42dfccdced8720b2ce5454790a31acc12296d3a9120a15c84d7fcda38e8","nasal":"aa7de42dfccdced8720b2ce5454790a31acc12296d3a9120a15c84d7fcda38e8"}},{"id":"VRCE-2-55-13","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":13,"english":"Clarified butter, sacrificial cakes, Kusa, stakes of catechu having been used in one sacrifice cannot be used in another.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2055013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ceb38b81a9fa6e9d28d0556b2cd70f7861ca5103f94a2c38122dc60bf8835f5","compact":"04a5fe5a3bfe773ad2d1ea7d175793e43edd3c533ad869c74820d4d491ad5c06","nasal":"3c2fbb648f3e14da2e4f66225caf22e979c552744ef843dca4f6df6e9f4e1bcb"}},{"id":"VRCE-2-55-14","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":14,"english":"Even so this kingdom which has been already enjoyed, like to liquor deprived of its essence or a sacrifice whose soma has been eaten, cannot be accepted by Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2055014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f1f3723be92c2e3c16aa04aee79ba0e548619340544be6a360be72c1336bbd50","compact":"bbab401a5b7c009ee844388a0e0b24d5876dcf3ef539dbbc38982c61f73da0c1","nasal":"3af7ac9f0b38b3be9a6b435a82cd2bcf0565499b96fc444a6da6826d217e347d"}},{"id":"VRCE-2-55-15","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":15,"english":"Such an ill treatment Rāghava will not put up with, even as a powerful tiger cannot bear the rubbing of its tail (by another).","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2055015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c5dbc7268f48f5cfa3d72feb69f36d9d83361e332b1faf3831cc2ded4b469029","compact":"1324f3110bf23f45d7d0ddabac813adc09919718a53a0cacf7e63b7e3cec5027","nasal":"1324f3110bf23f45d7d0ddabac813adc09919718a53a0cacf7e63b7e3cec5027"}},{"id":"VRCE-2-55-16","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":16,"english":"But such a man of men, possessed of leonine strength, and graced with the eyes of a bull, has been destroyed by his father, like a fish destroying his offspring.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2055016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"36f384acc2d164346da273c8a15ebbb894651d306488240ba76d29fd19ae2907","compact":"ba062444e4e732ef5db76b297af2d84cce16d8ad3e4a3d673fec0bfa3e420afe","nasal":"ba062444e4e732ef5db76b297af2d84cce16d8ad3e4a3d673fec0bfa3e420afe"}},{"id":"VRCE-2-55-17","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":17,"english":"If you had believed in the morality prescribed in the scriptures, and which is followed by the twice-born ones, you would not have banished your son. But disregarding such morality, you have banished your virtuous son.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2055017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"34720f46fd398c1c2331d679b813d683d3ff785ff5e7f9dd313894abe1ec9c55","compact":"58aed38459e39891d527ec2107de8f8e4aaea54126de62bd2efe0118d9a6b763","nasal":"58aed38459e39891d527ec2107de8f8e4aaea54126de62bd2efe0118d9a6b763"}},{"id":"VRCE-2-55-18","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":18,"english":"One of the refuges of a woman is her husband, a second is her son, and a third is her relatives; and a fourth she has none.","alignment":{"type":"1:1","confidence":0.612,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2055018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"36215f1eac634d8198a8692a0116ba45661c03d7e4f29e81aad91c891d3ae23f","compact":"26889d79a17a9b09a6d7fee9b876ab3571744b80416d9f9b29a94414f88f2c5a","nasal":"26889d79a17a9b09a6d7fee9b876ab3571744b80416d9f9b29a94414f88f2c5a"}},{"id":"VRCE-2-55-19","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":19,"english":"But you cease to be mine; and Rāma has been sent to the woods. I do not like to go into the forest; so I am entirely undone by you.","alignment":{"type":"1:1","confidence":0.426,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2055019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0aa043806b39b85e49f33d56f7bbfc11c0bb342957214458b6b06236f4659ff7","compact":"79cd531d0e5ce648f380e7dde27b10a9ef04769e3c17577e3bae1241dfc143f1","nasal":"dfbf9def3dae04721886a7097f962de58d3e1be36dc3c97efb4bce966d197d93"}},{"id":"VRCE-2-55-20","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":20,"english":"This kingdom, your own kingdom, has been destroyed by you; destroyed are all along with the counsellors; destroyed am I with my son; and destroyed are the citizens: your son and your wife are alone delighted.","alignment":{"type":"1:1","confidence":0.559,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2055020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e10da5d97a231bef8f47d38c7fee7350cfa5d73a442e5b8912177d225036056c","compact":"3be62c7b2539109dcae49954c8a1359e6d260972eed3fa19b2c7f93afb953aaf","nasal":"8c1aaafecd9b56ff88d04647cb6752be35b7224b36ca174aae431f02ea0df036"}},{"id":"VRCE-2-55-21","kanda":2,"kandaId":"ayodhya","sarga":55,"verse":21,"english":"Hearing these words uttered in heart-rending accents, Dasaratha exceedingly distressed, became senseless. And being afflicted with grief, he again remembered his evil act.","alignment":{"type":"1:1","confidence":0.708,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-61-26"],"status":"unreviewed"},"source":{"sanskritLocator":"2055021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"60c463ffa692f6ae55cb4911eb48a2e54a65f80c8b6bbb7ca255afb6bbc80a7e","compact":"54a0defd926948e859a4cb9a50f936af7294c6e9e0d1799259d175c07849423c","nasal":"54a0defd926948e859a4cb9a50f936af7294c6e9e0d1799259d175c07849423c"}}]
