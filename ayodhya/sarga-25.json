[{"id":"VRCE-2-25-1","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":1,"english":"And consoling her whose eyes were stained with tears, that virtuous-souled one spoke to her the following words with a view to prevent her from going.","alignment":{"type":"1:1","confidence":0.444,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2025001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9f0e2f2e4f65152b6f261ea4425a33b8ce5037f1a9346e2703e2ad638ac203c1","compact":"3ab5195e1c92ccaf61f9aba60bafbc4f707a8b1964cc739bde668c7972351292","nasal":"3ab5195e1c92ccaf61f9aba60bafbc4f707a8b1964cc739bde668c7972351292"}},{"id":"VRCE-2-25-2","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":2,"english":"Oh Sītā, you are born of an illustrious family and ever intent on the performance of religious deeds; do you practise virtue here as it may conduce to the happiness of my mind.","alignment":{"type":"1:1","confidence":0.774,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2025002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3185cd16cd7d6c44675b5cabe88a4a97dcb59f72d13536836d0624d35da90ff7","compact":"e1f5b1b0a06b8234edd18870275c11c35f1541d7f43608017de3116d3c75651d","nasal":"e1f5b1b0a06b8234edd18870275c11c35f1541d7f43608017de3116d3c75651d"}},{"id":"VRCE-2-25-3","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":3,"english":"Oh Sītā, Oh you of the weaker sex, Do you act up to my counsels; there are evils enough in the forest, do you learn them from me who am about to dwell in it.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2025003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80493c2a4ecc89cd45e5ac05d676197f192ca291aa435daab3fa6d4615731e54","compact":"8d08e022f1d3c0afbc40c692f4de4be12be9d152be97f5e458d906abe6759755","nasal":"c5d517c4d520382d09eb1e14efb3cad1a886d872b9aa5a76f3557cc73a0cf1b7"}},{"id":"VRCE-2-25-4","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":4,"english":"Renounce therefore, Oh Sītă, your intention of flying as an exile to the forest, which for its impenetrableness is said to abound in evils.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2025004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dd648c8bdc07c3f06e767a09a651113675ebac25d1bc95b4f4a87a7535981233","compact":"6c77f9f52c02ad26dd00d5c685060277a9e1012e4cb0a369c90092846340d76b","nasal":"d1fef8201e35aa119503e9947a16afb7db7329b9cd6dd176b6b636b79530728b"}},{"id":"VRCE-2-25-5","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":5,"english":"It is for your welfare that I give utterance to these words; happiness there is none, it is always covered with miseries.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2025005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7b1c726d57daef680159ee4b6dbf394b99774c6a60ef36a29df3372b7f14df20","compact":"82d909643ddc0861dfe3ac47301ca6b8f94b29450f263f3aed99b8f324e28f45","nasal":"82d909643ddc0861dfe3ac47301ca6b8f94b29450f263f3aed99b8f324e28f45"}},{"id":"VRCE-2-25-6","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":6,"english":"The roarings of the lions living in the caves of mountains, swelling with the sounds of the water-falls, produce a very painful impression upon the ears; so the wood is full of misery.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2025006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"47365dc29505ac2e1de1fc7d971c3751e764723a77c6b43b7cc513fbdbd95403","compact":"ad2d2fc28bf58ed71925ebbabe5cf969a7c8cf5f84b74dff2f186c0efe0ab13c","nasal":"16dc16f4c4ee0b4285757fca28810028cc623db7e708bc6adeab782e7bc4457d"}},{"id":"VRCE-2-25-7","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":7,"english":"Being exhausted with the toil of the day, the dwellers of the wood have to sleep in night on the bed made of leaves fallen from the trees on the surface of the ground; so the wood is full of misery.","alignment":{"type":"1:1","confidence":0.892,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2025007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a861448941c042ed70ff50353c655feb69d065e46a68d3a27b060360037f3136","compact":"eb16c1bc30cb1bfd9d0bbd16f3c86c83e3d278f520334cb405609d612fe35e1a","nasal":"067e7118feeeedfaa762d3eac210ca3627d2fc10114ba4dd9051af0605f31b90"}},{"id":"VRCE-2-25-8","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":8,"english":"One has to fast, O Maithili, according to his might, to wear matted hair and bark, to adore the deities and his ancestors according to due rites, every day to serve the guests that come to him, and observing the rules of asceticism, to bathe every day thrice, namely, in the morning, in the mid-day and in the evening; so the wood is full of misery.","alignment":{"type":"1:1","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2025008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2bbb7abeda6433925818f3864afd1cdba6d0d8997dfc374a581fa66b069983de","compact":"fd1e6eb55eb30c95f10e5fd58395cb86db904c5875319dd69a087db4ced682d4","nasal":"f1f8adb561126a934a884759bea3a79abfc99f5882c34fd6ab7ef997ede57010"}},{"id":"VRCE-2-25-9","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":9,"english":"There are always violent winds, darkness hunger, and great fear; so the wood is full of misery.","alignment":{"type":"1:1","confidence":0.61,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2025009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ed046739fe1cfd7d2d270541ae2eb73d22c1733afea07b7b350d4c7346b0834","compact":"60317bf13607f0abbbfd1a2afd85d9079dc443081e54ae6e9c26fca327290e81","nasal":"4bcabfda83c059aed1a29504c5e572d40943bb9c19206a3f15cf6c0b5ab9a6c1"}},{"id":"VRCE-2-25-10","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":10,"english":"Reptiles, many and of various kinds, creep there on the path, O excellent lady, with haughtiness; so the wood is full of misery.","alignment":{"type":"1:1","confidence":0.574,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2025010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4ca5893ebd1c5928b322b987e4754cc873ef37f6af7582c073b52ae1aa6227a9","compact":"dfd07881ce68148fc2c2be54d3ae8652ee016df9ca1c121952cacfc25265ed7b","nasal":"c2441b985aa5db3da7c83d7843116ce1087099f5bce91b98324e5aaadfb01471"}},{"id":"VRCE-2-25-11","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":11,"english":"And snakes living in the rivers and of crooked course like them, always await the wayfarers, hindering the passers-by: so the wood is full of misery.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2025011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c1f3cb108fc1ccbc775c8f2f4fc8e24eff0649c22cd62b2509cb245f6b52e0ba","compact":"d9446eae2da7b64f6246b3b1b8296b7c23e49c484f38bab11d68930ace598da8","nasal":"b725dfc36975be1393863f95af31bf5f5189b87deedff9f52223e1d5d2937966"}},{"id":"VRCE-2-25-12","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":12,"english":"Birds, scorpions, insects mosquito's and wild gnats, always disturb the dwellers, O fair one' of the weaker sex; so the wood is full misery.","alignment":{"type":"1:1","confidence":0.947,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2025012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d4d354a4d755326f93717431e3d37038dd848d86daac09daf73406f8e35b0d60","compact":"1d1470ffbbf350a74a10203a61cab32d589a4b0b010367907b68a617a7cc843c","nasal":"758f65c7c6f9deb3835daecc5ab35cc5b1be906b6e9a3a3ef03e4a0771dc05f3"}},{"id":"VRCE-2-25-13","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":13,"english":"There are trees full of thorns, having their branches moving to and fro, and the kusa and kāsa grasses with thorny blades constantly undulating; so the wood is full misery.","alignment":{"type":"1:1","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2025013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fbe231cebe51171e9533e5357a369fd1e527d3dbcd55342c8d2832631eb7701a","compact":"d31b7502371bd3ff436bc7f6dc26438ea9b071c3df10498a6450f584fc3987f6","nasal":"4b24e30079adbebe3e8753e49a01fabac1b5cc03cbbf4d6c835cfe7ee44a3cae"}},{"id":"VRCE-2-25-14","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":14,"english":"You should not therefore go to the forest, it forebodes no good to you. Weighing well, have I concluded that the forest abounds in innumerable evils.","alignment":{"type":"1:1","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2025014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f9e387f6339d4256abb15d98d6c74e05415658d05d03c945e98cc890d3b9c78e","compact":"afd943d6e8b38e341029afe69f439f2971b3f44c07ab69faad4cf0b3aeb309f4","nasal":"27bef94f5529f7b0a5f6e7e9283673a7a4ebec2ff8060ff29e26ba547f35e090"}},{"id":"VRCE-2-25-15","kanda":2,"kandaId":"ayodhya","sarga":25,"verse":15,"english":"While the high-souled Rāma, resolved thus not to take Sītā with him to the forest, she, greatly sorry, did not accept his words and spoke to him in the following way.","alignment":{"type":"1:1","confidence":0.671,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-28-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2025015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0cba0b71a32618192889f070ac98be398597272e6a6d1dfff836bf6759f21f8","compact":"0af8a53d7cb05ed2bca708433bb49daac6b13630dd7ae9130ed8d4d84ea177f3","nasal":"0af8a53d7cb05ed2bca708433bb49daac6b13630dd7ae9130ed8d4d84ea177f3"}}]
