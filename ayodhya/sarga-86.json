.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-92-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2086014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd56d5bb555fa34955619e12abc6ea4adccc9effc71b5e20ed6d57f37a9b528e","compact":"06db738514b6668c6d10f14cc30b1033d9257559762c5887cf2f48171a516154","nasal":"06db738514b6668c6d10f14cc30b1033d9257559762c5887cf2f48171a516154"}},{"id":"VRCE-2-86-15","kanda":2,"kandaId":"ayodhya","sarga":86,"verse":15,"english":"Lean and trembling and in woeful guise, Kausalyā along with the noble Sumitrā, with her hands took the feet of the ascetic.","alignment":{"type":"1:1","confidence":0.787,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-92-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2086015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27ec05ce75171613991b89326b02a83d1a9d4eea415a833cb26737e67424672a","compact":"fb26bcd95144891ad56bee0031e9d94b3d4776831bac93c47372d7d90e9b50ae","nasal":"0a49e1b03f90bda194e28abf7cc107e977cceb231110bac8e851904a6b977c3b"}},{"id":"VRCE-2-86-16","kanda":2,"kandaId":"ayodhya","sarga":86,"verse":16,"english":"Depised universally because of her unrighteous desire, Kaikeyi also bashfully took hold of his feet and, having circumambulated the mighty and venerable anchoret, stood near Bharata in dejection of spirits.","alignment":{"type":"grouped","confidence":0.815,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-92-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2086016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4908cc560983494cd563752e48cf840f91bb9e76a58649a539e93c3232a40d3","compact":"7f7debad36a8696e2a4874646b9cf0511b5172bffd3b85b209e394d67aee7395","nasal":"7f7debad36a8696e2a4874646b9cf0511b5172bffd3b85b209e394d67aee7395"}},{"id":"VRCE-2-86-17","kanda":2,"kandaId":"ayodhya","sarga":86,"verse":17,"