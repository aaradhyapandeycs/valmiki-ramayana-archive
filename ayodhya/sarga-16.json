6053","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0687e4afe96431b4f1e2cd7b13978c379c25514bb540fd241d5f7852cdb64765","compact":"714f1aecb3f5483764ca8211cfff7636734cfdcf4779b88f9d87de5cf500bcb2","nasal":"714f1aecb3f5483764ca8211cfff7636734cfdcf4779b88f9d87de5cf500bcb2"}},{"id":"VRCE-2-16-54","kanda":2,"kandaId":"ayodhya","sarga":16,"verse":54,"english":"Worshipping the feet of the king lying insensible, and those of vicious Kaikeyi, that greatly effulgent one went out.","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-19-27"],"status":"unreviewed"},"source":{"sanskritLocator":"2016054","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6cebeccc30e99f911d3c7a4fd03a1ee3db150efead591feb05861e63e8926eec","compact":"cac251639f888a948e3c2497da4b86f6160ba4138a87ff58f3c817a1f67fd25c","nasal":"ec7c9eeef828cb720bac6b7049254f7f2d6a1d3865bd3a272f1bc6cdc6db1915"}},{"id":"VRCE-2-16-55","kanda":2,"kandaId":"ayodhya","sarga":16,"verse":55,"english":"And reverentially going round his father and Kaikeyi, and issuing out of the female apartment, Rāma saw his own friends and relatives.","alignment":{"type":"1:1","confidence":0.907,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-19-28"],"status":"unreviewed"},"source":{"sanskritLocator":"2016055","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cad21ae18185376ddc6d4e48b2a245b7027d93d50e11ca34d17206fe4b384c91","compact":"dc5ce3d2247748416d219373561d102bc4b85503aeaa06aafb004f1854ddab28","nasal":"d796f8c3ef2707bd74ae50e6a09747e006d7a05d2369a82c8033ee849d6e9967"}},{"id":"VRCE-2-16-56","kanda":2,"kandaId":"ayodhya","sarga":16,"verse":56,"english":"Then followed him Lakşmaņa, the enhance of Sumitra's joy, greatly angry and with his eyes full of tears.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":