-ngram","duttRefs":["DUTT-2-76-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2070017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"01e4e550d2ad26b4c864f9d89da2996a85dfe0e6a0761170b0723841355316f2","compact":"323df1ec447c5804c2e654ab119b8ab466be7c354dbcaf9e9809420a6e299b68","nasal":"834c4472525cfc4ac6da16cf9e2f02be5816c6f7d7e06597655d1811acded1ee"}},{"id":"VRCE-2-70-18","kanda":2,"kandaId":"ayodhya","sarga":70,"verse":18,"english":"Then offering oblations into the fire, the Rtvigs began to recite japa; and as laid down in the scriptures, Sāma-singers chanted Sämans.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-76-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2070018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1e33c0cf2c504ab5e1d965e48ac59586fa89ea57f2e8b5e1077a8420af583355","compact":"405c9de34af076bbedbe5c980b4e54981bebe6b57f8c6e13c2cafdc7c408628c","nasal":"405c9de34af076bbedbe5c980b4e54981bebe6b57f8c6e13c2cafdc7c408628c"}},{"id":"VRCE-2-70-19","kanda":2,"kandaId":"ayodhya","sarga":70,"verse":19,"english":"By means of litters and other conveyances, each mounted according to her rank, the wives of the king went out from the city, surrounded by aged men. And Rtvijas went round the corpse on the king who performed many sacrifices leaving it on the left side.","alignment":{"type":"grouped","confidence":0.848,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-76-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2070019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55b3d70d637d569b24c962471c5cdb68b3d2f8707a9210204134f81bd97a8e4a","compact":"cacd834072d232ca1280d780ebeec79de69d2fd6a8e0dc1b2ae01f6569cf1ea2","nasal":"288fc58a80d349ad5d5921edf367d0fb57c111f2351a56e2482133987623f1aa"}},{"id":"VRCE-2-70-20","kanda":2,"kandaId":"ay