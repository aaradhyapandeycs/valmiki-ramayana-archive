e":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7152e92328bbc2d9914afbc769638cfdc1cfac333f958583ed0cc8d5b546e9d","compact":"0851f44d0a5c840a9560f8319888ad37cf8c5d47320f66810515142c29ec3538","nasal":"0851f44d0a5c840a9560f8319888ad37cf8c5d47320f66810515142c29ec3538"}},{"id":"VRCE-2-23-18","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":18,"english":"Whereupon spoke to that weeping Sītā, the descendant of Raghu thus:, Oh Sītā, Oh you born of a great family, versed in the knowledge of religion and intent on the performance of religious rites, my father has banished me to the forest! Do you hear, Oh daughter of Janaka, how has this calamity befallen me.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2023018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f8e8c0a753fccd8b8c1b0431603a6bbd15e5507e0e27799834095a41edd958b","compact":"c02228d243d2b22a8bae82603c5f6be66292da02dbc87a12d58bc61b2e3b11ec","nasal":"ac4b0a4ec2384a857505ba56a89528296e35e72d09e67fddd2d058f38ab6efdb"}},{"id":"VRCE-2-23-19","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":19,"english":"Whereupon spoke to that weeping Sītā, the descendant of Raghu thus:, Oh Sītā, Oh you born of a great family, versed in the knowledge of religion and intent on the performance of religious rites, my father has banished me to the forest! Do you hear, Oh daughter of Janaka, how has this calamity befallen me.","alignment":{"type":"grouped","confidence":0.714,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2023019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"685c985194cb4559118149d5dcb2b5a180b70ab79215cbd53186050b96ba7a66","compact":"8746568c7ce0cff969528f8dc327745d479a382dcc03d09d2491ebb711ab88b1","nasa