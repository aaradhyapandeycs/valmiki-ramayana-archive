[{"id":"VRCE-2-23-1","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":1,"english":"Rāma, intent on repairing to the forest, and treading in pious tracks, after duly saluting Kausalyā and beautifying the royal road, crowded with people, captivated their hearts by means of his high accomplishments.","alignment":{"type":"grouped","confidence":0.89,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2023001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b33679c8b4fe67c28af29cd0d23956e2ad7b22cc892fd343cd1f2c8b549a8ee","compact":"41ee8b295c6404a87ad57d63bd948b52e0e1485b54b7c678738e8f06c5526287","nasal":"41ee8b295c6404a87ad57d63bd948b52e0e1485b54b7c678738e8f06c5526287"}},{"id":"VRCE-2-23-2","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":2,"english":"Rāma, intent on repairing to the forest, and treading in pious tracks, after duly saluting Kausalyā and beautifying the royal road, crowded with people, captivated their hearts by means of his high accomplishments.","alignment":{"type":"grouped","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2023002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"63aafd1d7c686a401c15d92d0d6539b9b526bfab33950aedc9fc6ddac2303b91","compact":"52b2e1c9d6835b26212cecb8616ea9d5bf82d1cc9d8b75f6c430e76e7fdfca3f","nasal":"3cec825d6f958851cbd41fc2b5d3a4c0ad24ccb2ca84b7800303a529a99e288c"}},{"id":"VRCE-2-23-3","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":3,"english":"Vaidehi, ever engaged in ascetic rites, did not hear of all these affairs; there was in her heart only the thought of Rāma's installation.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2023003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"23450ae47651b9898d56ffeca1f4b4a87eff5ed6df6b01e80ac4a8245ef32c5e","compact":"ce7965b65298822a6fa01cc08a3cb637aa0d658c013e0bf2867528c80614e472","nasal":"ce7965b65298822a6fa01cc08a3cb637aa0d658c013e0bf2867528c80614e472"}},{"id":"VRCE-2-23-4","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":4,"english":"That daughter of the king, after offering her service to the deities according to the proper royal rites, was eagerly awaiting the approach of Rāma with a grateful and pleased heart.","alignment":{"type":"1:1","confidence":0.866,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2023004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a893eb75ff5ea1da5d7e35fadbaa10d02942c42c2ef1328234edd1be497f94a9","compact":"b8a07bfe9ee48a8f62ae8f4e62204e0b6c15762db81571ee0acbcfea3bd4ed9a","nasal":"b8a07bfe9ee48a8f62ae8f4e62204e0b6c15762db81571ee0acbcfea3bd4ed9a"}},{"id":"VRCE-2-23-5","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":5,"english":"Entered Rāma this beautiful abode, excellently furnished and filled with people highly delighted, having his head hanging down a little with shame.","alignment":{"type":"1:1","confidence":0.791,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2023005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3578f4d7bc9039859ada7c930f57f310e22d06526e393b9d917a0c299d9fdabd","compact":"210fa539597481ca9b764a4a5cb8f3582290c5f0d4c23163c3fc76d3acc24d26","nasal":"5c657327afb7110710d196721ba04dbe399e9dd52bc5a9d5215e72b51a604036"}},{"id":"VRCE-2-23-6","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":6,"english":"Sītā, seeing her husband, racked with sorrow and troubled in mind with anxiety, rose up trembling from her seat.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2023006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b75576fe9ace4de84de7f91dc514948a838a4048026b1d4de8a4c765555a7549","compact":"329c355dcc76bd9ac71c209879efd21a8009949d67615e11ff4f5f6de9f024f9","nasal":"548faad1abdb4350dd1c810b7076d4b575a486aff67ae8957e521cddc2552826"}},{"id":"VRCE-2-23-7","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":7,"english":"Finding him with face pale and perspiring, and incapable of containing grief within, Sītā sore distressed with sorrow addressed him, saying, Oh my lord, why do I perceive such a change in you?","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2023007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d8b1b4359139d150fb9b8c6b0f1293174226ed98fcfb829ab75f616f7dc38c17","compact":"56b7f1dbaa7eef7f4c9a885527148df69dcc7b072fe0ea860ecf66c9e27dc6df","nasal":"d448b5dd93d89dfe1a9f40d2758b0c38373d9e9bb9e56f570ac7243eaff33325"}},{"id":"VRCE-2-23-8","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":8,"english":"To day the constellation Puşya is in conjunction with the moon, and planet Bịhaspati is presiding over this conjunction, this day has been declared as the most auspicious one by the learned Brahmins, then why do you cherish such a sorrow in the mind?","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2023008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29e19ec375a086cfe9c02ef9944716c2a6fd2b897ca774721f8c2b77971cc436","compact":"d288093044b02fef5dc3d7dddd9decf8dd7b83e35ea23549757a62d48317f0ff","nasal":"d288093044b02fef5dc3d7dddd9decf8dd7b83e35ea23549757a62d48317f0ff"}},{"id":"VRCE-2-23-9","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":9,"english":"Why has not your charming face been placed under the shade of an umbrella having hundred ribs and white as a watery foam?","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2023009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ea5d6206b2976d4bb14e849f991ab2b2acdefbe1a9c346acc90ce1fcea3e6301","compact":"206077904c2e57fbfa2cd1b118a550bcf2b5d2345a1c8fd526a7cde99344d3ec","nasal":"206077904c2e57fbfa2cd1b118a550bcf2b5d2345a1c8fd526a7cde99344d3ec"}},{"id":"VRCE-2-23-10","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":10,"english":"Why do not the servants fan you, having eyes like lotus' petals, with chowries white as the moon or a goose?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2023010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d0237279140aa3b1b8dac13bf72ff96122c3af326e4127d3d8a6eac697f4276","compact":"b12ddcbcc70f05436e0b5c8bdbd779f4bf2bfafe22a63cb82aeda2bc4e6f6d69","nasal":"9dfe92e0de01d30b5decaa8188eb11f2194b7324380792452157fc30d7302f73"}},{"id":"VRCE-2-23-11","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":11,"english":"I do not see you, Oh best of men, eulogised with auspicious songs by the panegyrists, encomiasts and family bards.","alignment":{"type":"1:1","confidence":0.795,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2023011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2e684bd7d5f7197d8d138008cc459278b02ea7fafb2b3d48d588577bbe467da2","compact":"9a3edaf2c57f07b20842e99c2cb50faa2d9b4a7eb6d04844a2594a393143e8fd","nasal":"9ce6a52325301c4e4a597ed4d99f9133defad560679b8b06a5f86b27c01cf959"}},{"id":"VRCE-2-23-12","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":12,"english":"Why do not the Brahmins, versed in the Vedas, observing the formal rites, sprinkle on your head honey and curd, after washing it duly?","alignment":{"type":"1:1","confidence":0.594,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2023012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5dee4767f58220ecb7f7a59a25d9569a7ca46e08a44b7c5ef82fefa835c1f04d","compact":"6b035481583206f43563041b32b0deaef093272654a133cae638241e130831ae","nasal":"6b035481583206f43563041b32b0deaef093272654a133cae638241e130831ae"}},{"id":"VRCE-2-23-13","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":13,"english":"Why are not your subjects, citizens urbans, and leading members of society dressed and adorned, willing to follow you?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2023013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd520d5ca275b8c170bada7f5f954b36f5656c4702d2668466cd8c29a8a9bb80","compact":"36be98a22e669918118205d963b94f4066d7f815af493d66c20e55c472c0f4e3","nasal":"f848a21e0a9541e6e2c18d12a0f1fc5361750d0c3c5b63489242c2c5e73d3777"}},{"id":"VRCE-2-23-14","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":14,"english":"Why does not that excellent sport-chariot go before you, having four fast going steeds, adorned with golden ornaments tied to it?","alignment":{"type":"1:1","confidence":0.716,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2023014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c917e3f47d9da932eb97d14fff8d6f2efb745584d788a00b24d6