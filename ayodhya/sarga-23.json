0.606,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-21","DUTT-2-26-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2023022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f5fddb19b6c4172a8fca58b1d9eecaf4971dcad0d59ca01b6cd4a1d87ea47f9d","compact":"a24009ae175a1cc16e6b00535bfcc5b8c289accd3d5d8bed4f36d7a9e045cb3a","nasal":"8e9b990878d82ad19b05ac20b630027337093bbd9c9c43ff28b4772f143d22d0"}},{"id":"VRCE-2-23-23","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":23,"english":"And myself bound to fly as an exile to the wood, have come here to see you; do you not praise me ever before Bharata. Those who are crowned with prosperity cannot bear another's praise; is it therefore behoves you not to extol my virtues in the presence of Bharata.","alignment":{"type":"grouped","confidence":0.92,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2023023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"06c8ac3d3e4f5b9cdf7303b6b98ae7a345621035fdd32594d10a7c78dea7242f","compact":"dd3786a224304e23aaa47b200d3e11035617994740c16513958cbc1f10b39d9c","nasal":"d130ca460ef8eaacfa41596297bf7d1122b87fed3654c12661584400c3ac796c"}},{"id":"VRCE-2-23-24","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":24,"english":"You should not extol me even in the company of your friends; you shall be then able to live with Bharata as one favourable to his party.","alignment":{"type":"1:1","confidence":0.661,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2023024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a8c26c17e60e6ee350b3c88d70b9bd79448d6187468c786c2e08f4cbf66ed4df","compact":"10adf13da5b99e394d7f4afbeaf68343a46cd8da4abdd9e7abbd601c8de3a23f","nasal":"10adf13da5b99e394d7f4afbeaf68343a46cd8da4abdd9e7abbd601c8de3a23f"}},{"id":"VRCE-2-23-25","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":25,"english":"To day shall I repair to the forest for redeeming my father's vows; do you, Oh high minded one, live here in undisturbed mind.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2023025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"673037c10174cb1dd73c463dd3d7c3496bba810eff76062716962a181f861faf","compact":"b124f2d9b9af57e438dcddaf522b865d825cd1345735309c5119289985ef7bae","nasal":"b124f2d9b9af57e438dcddaf522b865d825cd1345735309c5119289985ef7bae"}},{"id":"VRCE-2-23-26","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":26,"english":"Do you, Oh sinless and auspicious one, live here engaged in religious rites and fasts, when I shall wend my way to the forest inhabited by the great ascetics.","alignment":{"type":"1:1","confidence":0.83,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-26"],"status":"unreviewed"},"source":{"sanskritLocator":"2023026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0af14ba480e54f713a6e9c3eda8e5750ae7b4c3f9fcd6c49717c32b05bd0e2cb","compact":"9287c15ca804d90c826579c631b99e6d875433ecf8aa8908359dae6884f9ad73","nasal":"9287c15ca804d90c826579c631b99e6d875433ecf8aa8908359dae6884f9ad73"}},{"id":"VRCE-2-23-27","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":27,"english":"Rising from the bed early in the morning, adore the deities, every day, and then bow down to the feet of my father Dasaratha, the lord of men.","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-27"],"status":"unreviewed"},"source":{"sanskritLocator":"2023027","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3cff52237c0c0f6f14591b367813327a504572ff202543334410cea5d236453","compact":"8f5a88a5b9d9ddc069cae5f6200d3bcb448bd1dc9894f6e32d094e41337d9b87","nasal":"dbf68cedbd8edc63f33c504fedeca28c9a04439ea710b571b199bc24c11e5e0b"}},{"id":"VRCE-2-23-28","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":28,"english":"My mother Kausalyā is old and much pressed down with sorrow; do you show proper respects to her, considering it to be a pious deed.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-28"],"status":"unreviewed"},"source":{"sanskritLocator":"2023028","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fd05bfeb843d6bb16916aeedec87c8229f691589ca2036499c2693e5e3396398","compact":"757dc822e5321531a050bb8a7466d1e69b5ef9f8f75ff649387c2b7f6b63889f","nasal":"757dc822e5321531a050bb8a7466d1e69b5ef9f8f75ff649387c2b7f6b63889f"}},{"id":"VRCE-2-23-29","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":29,"english":"You should then bow down to my other mothers who all minister to me, with equal love and affection.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2023029","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5969de9750530fad6b59dc1a83b5e110987cb3441b3341c403a5a38dcf9a13f3","compact":"f2bd0bffc83cde9c8bce8a44f74d1abbe30a54a619994df43887185b4e022924","nasal":"b5fb9dd5dfaf169ccc0e96ec55dc7332e366a3f1d6b6ed6ac58ccbb8504dfb0e"}},{"id":"VRCE-2-23-30","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":30,"english":"Should you specially regard Bharata and Śatrughna like to your sons or brothers, who are dearer to me than my life itself.","alignment":{"type":"1:1","confidence":0.791,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-30"],"status":"unreviewed"},"source":{"sanskritLocator":"2023030","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"319951675e9cdffd8685effb8512b6f70b1f547f43a402c28049d22cf8d8ec43","compact":"86a8776efc02b51ba4992cfa1fefa4dda600e6f01e7711dea7b006d869a614a8","nasal":"86a8776efc02b51ba4992cfa1fefa4dda600e6f01e7711dea7b006d869a614a8"}},{"id":"VRCE-2-23-31","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":31,"english":"You should not do, Oh Vaidehī, any such thing as might be unpleasant to Bharata, for he is the king of the land as well as of the family.","alignment":{"type":"1:1","confidence":0.509,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-31"],"status":"unreviewed"},"source":{"sanskritLocator":"2023031","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e8fd2c25b987803320e998b4b2a63a5da40081c73657eace8a6a5d1ed0fad7c0","compact":"4e2cd44ea82172ebe7a6067d07d236ed5492bb0bafd765684ae031bc9c85e8b0","nasal":"4e2cd44ea82172ebe7a6067d07d236ed5492bb0bafd765684ae031bc9c85e8b0"}},{"id":"VRCE-2-23-32","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":32,"english":"The monarchs are always propitiated by being served with assiduity and good temper; they are offended when any thing contrary to it happens.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-32"],"status":"unreviewed"},"source":{"sanskritLocator":"2023032","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d0156b54e1454901c88577baf7aff5d9abcb63181df371474f44e81d55ffc5eb","compact":"e63c63a5b304c99e78f9758e027eb2e6f9a357409d6d6db918a4a5821b5f86e9","nasal":"0b1459eaf1deb4a2306c12fb6ebd731a75038a1241344e5a2e7fba124353ea06"}},{"id":"VRCE-2-23-33","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":33,"english":"They renounce even their own son, born of their lions, when they find him bringing about their mischief, and admit into their favour persons devoted to their welfare bearing no relationship whatever.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-33"],"status":"unreviewed"},"source":{"sanskritLocator":"2023033","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7538ee1168223cec02ec740b07164c580651cee6f40a67a2ea146af2f5d52ba4","compact":"aba7e8b7feac4887cd84afac7090f99c36ca84ed8eae32d81df781d1ccf182e8","nasal":"a45082436c7ff77387c58db564bef071e0eee692135151d0337dcc111cc08075"}},{"id":"VRCE-2-23-34","kanda":2,"kandaId":"ayodhya","sarga":23,"verse":34,"english":"I am going to the forest, Oh my darling, and you shall live here. Oh excellent lady, abide by my word as did you never formerly falsify it.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-26-35"],"status":"unreviewed"},"source":{"sanskritLocator":"2023034","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a968a6487f47483d45c20ac0ae46a1d21820e30c6b76b3642dc49a67ce4dced","compact":"4cc59bb695ba01836cb2fbd71a2e9116528f95f847111029aa113e81e1ef5ec6","nasal":"4cc59bb695ba01836cb2fbd71a2e9116528f95f847111029aa113e81e1ef5ec6"}}]
