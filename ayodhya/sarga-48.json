_fingerprints":{"exact":"c5e71d5929510a96bddd897e56a5f9631ab6a89a7f82d90c47552ae75e2ad909","compact":"5acf6c9d57817bfd2ef8ed250e5de98b69721e015b4f1e70e84497e59082fb23","nasal":"8aac26aae6794c1ec832d398d7f5cb7f912bb358bb4c6473dcd8b4f4be1938ac"}},{"id":"VRCE-2-48-7","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":7,"english":"All these various trees with their wood hewn away by foresters are seen in the asylums.","alignment":{"type":"1:1","confidence":0.683,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2048007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78b0281b421b9cfea475d57c3a8a4d03f0a00b640c9cecb778b78c7af97beb55","compact":"9fdbef02c34a19992c229b8580debe0c80009ccdf0fd88a08ca53095a74097e8","nasal":"fba5c3b86e7c52efe2b039ef83c1e42e6a3a10ea39e881c75d4c93a4c8362ac3"}},{"id":"VRCE-2-48-8","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":8,"english":"Thus having proceeded at ease, you bowmen when the sun stood aslant, arrived in the vicinity of the ascetic's residence on the delta of the Yamunā and the Gangā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2048008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"259f7d2a0e5616bc3917181684f611d97a00d6b266073b4861c0da80b5dbe6c6","compact":"cc4c4d442b4f736ef275289f6a98384f83a4a43286ba53524988d24a4048850b","nasal":"939616e49a8331410dc0a7ff214b4d1867ad2202afbe2140421bee7a14eddae3"}},{"id":"VRCE-2-48-9","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":9,"english":"Proceeding awhile on the way, Rāma, in presence of the asylum, came up to Bharadvāja's place, frightening beasts and birds.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2048009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b757ec50edc4a657d634288ae3d97824a737a7d64361dee38d63e849312acf5d","compact":"25e2ba1fbcf3fe6ed4050492705eb3dd5290fa872412e085c7fc09e5032223b9","nasal":"25e2ba1fbcf3fe6ed4050492705eb3dd5290fa872412e085c7fc09e5032223b9"}},{"id":"VRCE-2-48-10","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":10,"english":"Arriving at the hermitage, the heroes desirous of seeing the ascetic, stood at a distance with Sītā behind them.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2048010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fc82184efd739d6347187f17d9d7302fe7857ceb53d9cd1696de9cdd80a8eb12","compact":"27f7f90a74f5446c853cd80e9a5886b44435c1fe6d4565d03e748c241ce97163","nasal":"c288723085ebfa8311f90a3f6d45b3b0d9a65163bb97ddc0698132e8a7577af2"}},{"id":"VRCE-2-48-11","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":11,"english":"And as soon as entering in, that exalted one saw that high-souled anchoret of accomplished vows, who had attained spiritual insight through austerities, sitting surrounded by his disciples after having finished the Agnihotra, Rāma with joined hands saluted him along with Sumitra's son and Sita.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2048011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d10b00d1519b2fef18da4a5c4d01a20afae6b19b28fd9ad48b199ee35f47bfcc","compact":"bb8ec1a98ade4d88557c8d7b57279f3f14a402f319e39f2c8f541e0c8a055756","nasal":"108a585d509e0cba8d7bde55df8672f78647956a450ddff0f4fa2d6d7de4902c"}},{"id":"VRCE-2-48-12","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":12,"english":"Then Lakşmaņa's elder brother imparted to B