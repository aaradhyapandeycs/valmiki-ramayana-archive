[{"id":"VRCE-2-48-1","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":1,"english":"Having passed the auspicious night underneath that might tree, they, when the sun had risen in unclouded splendour, went away from that place.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2048001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b488d1e78b1519be10166f28e8c750faf3ffae404da328edd74c49e3664147c3","compact":"bc1b7a2c60204ac44fb75b60906d8278884758de48b4f2d5f6d7e2ec617e6afc","nasal":"bc1b7a2c60204ac44fb75b60906d8278884758de48b4f2d5f6d7e2ec617e6afc"}},{"id":"VRCE-2-48-2","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":2,"english":"Then dividing into a mighty forest, they proceeded in the direction in which the Bhāgirathi Gangå meets with the Yamunā.","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2048002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9c8d148247a8459a614bc0af39c5f9d0cb010dadf639d9ed1002ff65ab0feb5d","compact":"0638c0874fb7f6a7d34e08f13777ef1c8cb0acb2b7bf79c831332eb59b3f4500","nasal":"5a573b219c2c00e54822ac9621559a916e8aaa506e4271f2972fd9dac32e3ca9"}},{"id":"VRCE-2-48-3","kanda":2,"kandaId":"ayodhya","sarga":48,"verse":3,"english":"Those illustrious ones went on, viewing at intervals various fields and delightful lands which they had never seen before.","alignment":{"type":"1:1","confidence":0.775,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-54-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2048003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8bb20254b772e04b1744f392932704d73b02ac4e0a921aabf135d06a191b712a","compact":"7accf484d9698d99b20d11428c66e678487e068972c8befe2