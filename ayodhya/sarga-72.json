act":"8ae012c5c9bd41d5aa2d767b9978b2586f4da8b30d18960d1614907fb0bb0a25","compact":"8429acff5357205c7261189612f097ce260f3fe33b3d13f1b3e61284b542f037","nasal":"48c2f8053ebdeeeae26d268ac7b1f4dbbb2048d96a95e0b04b7197da7561ab47"}},{"id":"VRCE-2-72-18","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":18,"english":"And that foremost of men possessed of strength holding her, began to reprove Kaikeyī with harsh speech.","alignment":{"type":"1:1","confidence":0.774,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2072018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2723e11f2941614f839c53c0d912aaef8ba1de429c09bdae31926bbb568cc4bc","compact":"ba795fb86a3a93ea968957093a6e7eb3d0eedbb8a31cc6fc214679843c74a23a","nasal":"ba795fb86a3a93ea968957093a6e7eb3d0eedbb8a31cc6fc214679843c74a23a"}},{"id":"VRCE-2-72-19","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":19,"english":"Extremely hurt by those rough words, Kaikeyi terrified on account of Satrughna, took refuge with her son.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2072019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ae2718d8fc56cf5cad45a3a7db771fa364c6ec2b483caf7241f1b6fd8a35ebf","compact":"a27aaf253ab27a7f129fc23835ada06e71a3307951a29d597c37c943980dd307","nasal":"a27aaf253ab27a7f129fc23835ada06e71a3307951a29d597c37c943980dd307"}},{"id":"VRCE-2-72-20","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":20,"english":"Thereupon casting his eyes on Satrughna, Bharata said, “A woman is incapable of being slain by any. Do you therefore excuse her.”","alignment":{"type":"1:1","confidence":0.973,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2072020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"08c1df98083dd72fee8342c1b2a23c88bec7da3928df3f19db9f7ed97af08aaa","compact":"896931e579c545b1ba6040eafc441fdee9a7f5dfb10df89be0e478cb6f15cad3","nasal":"896931e579c545b1ba6040eafc441fdee9a7f5dfb10df89be0e478cb6f15cad3"}},{"id":"VRCE-2-72-21","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":21,"english":"I myself would have slain this wicked Kaikeyi of impious deeds, if the righteous Rāma should not be displeased with me on account of my slaying my mother.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2072021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"03bab79d8925d915d10f56a86f3a373b471ffed551ce7c314e63268dde7fcedd","compact":"165143b00bd13e27bff065cb23aaf0a4bf897d1f33a7cc585e96aece7f3acf04","nasal":"165143b00bd13e27bff065cb23aaf0a4bf897d1f33a7cc585e96aece7f3acf04"}},{"id":"VRCE-2-72-22","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":22,"english":"If Rāghava knows that the hump-backed one has been slain, he sure' will speak neither with you nor me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2072022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b66aef9d2989635a2164184dad0b8ab8cdbd00e7b64cfb152f97b9ded1d5fec","compact":"22f5aceb3b700e05014b9483772f2601ec6b5529a64af8eae6e6dce26d2d9ede","nasal":"22f5aceb3b700e05014b9483772f2601ec6b5529a64af8eae6e6dce26d2d9ede"}},{"id":"VRCE-2-72-23","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":23,"english":"Hearing Bharata's words, Satrughna, younger brother to Lakşmaņa, refrained from that wrong and set free the hump-backed woman in a swoon.","alignment":{"type":"1:1","confidence":0.769,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2072023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fac56d96656f3792d117a91d7a1112182d0d927d471aad506e4ef59e3f660865","compact":"e091d6b02115bf693b2476aacfe7f3c1e75953c9e48f9bfc6aaed7b6a81fce8b","nasal":"937b52f5e05b17108f57bc21cfd6899d56946f758c410853e6e1ae602261f707"}},{"id":"VRCE-2-72-24","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":24,"english":"Thereat, sighing hard in exceeding grief, Mantharā flung herself and Kaikeyi's feet, weeping piteously.","alignment":{"type":"1:1","confidence":0.982,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2072024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fd07377df12d6cd63d327b3e68b25a48c3c937a872578ccfba61c941d8bb0f50","compact":"a101502d4d19b929f5bfbd0f97576a909a4fa62a8ce4cf882e67d1df5dcc8660","nasal":"41a8f87d001984933b0542fa94048a1c374f85cd9c691ec2dd165a35f482fe4b"}},{"id":"VRCE-2-72-25","kanda":2,"kandaId":"ayodhya","sarga":72,"verse":25,"english":"Seeing the hump-backed one deprived of her senses in consequence of the pushing she had received at the hands of Satrughna, Bharata's mother consoled that distressed woman, who appeared like a Krauñci that had been entrapped.","alignment":{"type":"1:1","confidence":0.878,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-78-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2072025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f99f1e19da358e8315af90077f929101a26557827149004060858c8cd2b0ab9","compact":"5e01ec73bb097f5c81cfc89fc67f673397401f87f0c9c004015c6315e43a6946","nasal":"0d3a93f1c6684665c2d550be29c508695196192d35bade0a39c4c42947d3df5e"}}]
