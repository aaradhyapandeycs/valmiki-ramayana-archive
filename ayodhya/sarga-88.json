[{"id":"VRCE-2-88-1","kanda":2,"kandaId":"ayodhya","sarga":88,"verse":1,"english":"Having spent a long time in that mountain, that lover of hills and woods, Dasaratha's son resembling an immortal, anxious to pleasure Vaidehī as well as to please his own mind, showed the variegated Citrakuța to his wife, like Purandara to Sacī.","alignment":{"type":"grouped","confidence":0.784,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-94-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2088001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"14d5f8834213d44a9e42558930d99285f29d8d7f930e9dd8a6917d7439dee0ba","compact":"080ae9a7f76fdde931b5410388864a717003ab0329b8bdf5fda69c114d694aca","nasal":"6d33dbe8cfe1a45a90d8d41c106a8442a5aca38234870ae9a56beb1f1be4404d"}},{"id":"VRCE-2-88-2","kanda":2,"kandaId":"ayodhya","sarga":88,"verse":2,"english":"Having spent a long time in that mountain, that lover of hills and woods, Dasaratha's son resembling an immortal, anxious to pleasure Vaidehī as well as to please his own mind, showed the variegated Citrakuța to his wife, like Purandara to Sacī.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-94-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2088002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f30bb3e07516ca4e596dcdb174d7c0f3179cf390cec858e8a87a7940c4f1937e","compact":"69bcba38ae8acd7af626c67241c4c22bcbca9981bfa4feef3c46e8f66358a841","nasal":"69bcba38ae8acd7af626c67241c4c22bcbca9981bfa4feef3c46e8f66358a841"}},{"id":"VRCE-2-88-3","kanda":2,"kandaId":"ayodhya","sarga":88,"verse":3,"english":"O gentle one, neither deprivation of the kingdom nor separation from friends afflicts my mind on beholding this romantic mountain.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-94-2"],"status":"unreviewed"},"source":{"sanskritLo