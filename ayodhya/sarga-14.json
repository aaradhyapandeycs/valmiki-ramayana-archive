:"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"133e436b9150984217e11994986192d64417d97e3a379f55fe74cb84d698a151","compact":"3c930437969ca9b429d01e372176edad950a7f7d2c414106b15e37e752f7b557","nasal":"3c930437969ca9b429d01e372176edad950a7f7d2c414106b15e37e752f7b557"}},{"id":"VRCE-2-14-25","kanda":2,"kandaId":"ayodhya","sarga":14,"verse":25,"english":"This Rāghava going shall obtain through the grace of the king great wealth, and all our desires will be gratified when he will become our governor. It is a great gain to the subjects that he is going to get for ever the entire empire at once; he being the lord of the people no body shall witness any misfortune or unpleasant thing.","alignment":{"type":"split","confidence":0.634,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-16-34","DUTT-2-16-35"],"status":"unreviewed"},"source":{"sanskritLocator":"2014025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2c030f8acbea3c163e1c38c1116bd2ee2464257459f99a49f23726dded995de6","compact":"3db3cc4cba66e9fd5514697928ea0c1313c06624fe6da161a6a90694111df484","nasal":"3db3cc4cba66e9fd5514697928ea0c1313c06624fe6da161a6a90694111df484"}},{"id":"VRCE-2-14-26","kanda":2,"kandaId":"ayodhya","sarga":14,"verse":26,"english":"Like to Vaisravana he began to proceed, being dignified by the horses and elephants going before sending forth great sound, and eulogised in various metres by persons singing his glory, by the panegyrists and by men tracing his noble ancestry.","alignment":{"type":"1:1","confidence":0.482,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-16-36"],"status":"unreviewed"},"source":{"sanskritLocator":"2014026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"92af7340c729aa20c70359c8ebb457b3853d9296e555bc5c593a900244d95f13","compact":"83545cbde4e9f3d072bdf75a6e2fccb8d1a9d244cfdbe5359b35f2523f2151e2","nasal":"83545cbde4e9f3d072bdf75a6e2fccb8d1a9d244cfdbe5359b35f