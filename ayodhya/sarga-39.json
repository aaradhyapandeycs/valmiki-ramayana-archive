[{"id":"VRCE-2-39-1","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":1,"english":"As that best of ladies, Kausalyā, was thus lamenting, Sumitrā ever abiding in virtue, spoke to her these words consistent with righteousness.","alignment":{"type":"1:1","confidence":0.644,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2039001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a7cdd6509cbe48e524881280256304f1daee9fa69444559585962cb007f0cd50","compact":"978d464347dac3748eb7e9a4d44c24bd3f1651a29e6542d47b4bd789ebd76c8c","nasal":"af99ec7325eccc5425d96e9aa745a6406bede86f5b8a477c5485f710037325b7"}},{"id":"VRCE-2-39-2","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":2,"english":"O worshipful one, your son is crowned with all qualities, and is the best of men. Why then do you bewail thus, or weep bitterly?","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2039002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e55ecbeec6a65d4a5479b45379744ecdba6ca7f8e04a285a13cfd917c4e3bd0c","compact":"6204eb9a0441df5e40b897ee2d3ff9ed0190e684ec14fbfac227b9b6d26ca8d9","nasal":"6204eb9a0441df5e40b897ee2d3ff9ed0190e684ec14fbfac227b9b6d26ca8d9"}},{"id":"VRCE-2-39-3","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":3,"english":"Since, O revered one, renouncing the kingdom, your mighty son wendeth (to the woods) with the view of fulfiling the intention of his high-souled and truthful sire, the worthy Rāma staying in the duty that is completely observed by the good and the performance of which always bringeth welfare in the next world, should by no means be lamented.","alignment":{"type":"grouped","confidence":0.958,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2039003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4f98df9e808b7dffd1a4e7c0d61d416ce07d105b63f90ca721db6bbfb5643d02","compact":"03cd7d91d635b21c25909fe1e28780cb3f0e21c8fde5641bf7d43a0a4daf9649","nasal":"03cd7d91d635b21c25909fe1e28780cb3f0e21c8fde5641bf7d43a0a4daf9649"}},{"id":"VRCE-2-39-4","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":4,"english":"Since, O revered one, renouncing the kingdom, your mighty son wendeth (to the woods) with the view of fulfiling the intention of his high-souled and truthful sire, the worthy Rāma staying in the duty that is completely observed by the good and the performance of which always bringeth welfare in the next world, should by no means be lamented.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2039004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b83cf653090d8363b7e832069e9f1a188f124ed18c156642df208d0116781cb","compact":"0dc3c15380d46395cc17c9cbb91795cfcdfa77ead96dd0f3aa202990760f259d","nasal":"0dc3c15380d46395cc17c9cbb91795cfcdfa77ead96dd0f3aa202990760f259d"}},{"id":"VRCE-2-39-5","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":5,"english":"That sinless one, Laksmana, kind to all creatures, will minister to Rāma in the best way possible, and this is to the advantage of that high-souled one.","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2039005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"30cb7f9ae3a08ff403e1475b72fd5249ad0f346259a49e1b3d647681729e39d5","compact":"f98f932d8a5bda81a58d7648357df565471e4b0869985a24fd59e5b730005283","nasal":"f98f932d8a5bda81a58d7648357df565471e4b0869985a24fd59e5b730005283"}},{"id":"VRCE-2-39-6","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":6,"english":"And experiencing the hardships that come of living in the forest, Vaidehi deserving of happiness follows your righteous son.","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2039006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"30af4ecbf062912108a243ace7680a1b6eba29be6c919fce5a685597bfe80b1a","compact":"6fe371891cfdf018dce68c482fda3a5a514ec5987cfa916fe54d31c4e6f3f0fb","nasal":"6fe371891cfdf018dce68c482fda3a5a514ec5987cfa916fe54d31c4e6f3f0fb"}},{"id":"VRCE-2-39-7","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":7,"english":"What is wanting to that maintainer of all, your son of subdued senses, intent upon truth and the observance of vows, who is spreading his banner of fame over the world?","alignment":{"type":"1:1","confidence":0.734,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2039007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a53e259b476a6d83569b08b9e22c9d56877924e12390235fbeea3f06e2b47db0","compact":"b28b6feb496e2b41859dfe1c19a071a637eb1e11b04f89f6544982117269d90c","nasal":"b28b6feb496e2b41859dfe1c19a071a637eb1e11b04f89f6544982117269d90c"}},{"id":"VRCE-2-39-8","kanda":2,"kandaId":"ayodhya","sarga":39,"verse":8,"english":"Acquainted with Rāma's manifest purity and high magnanimity, the Sun himself will not dare burn his body with his rays.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-44-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2039008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8417e39759a8ca7d144996ebf70d60d5c757831d06f984857d5edbde0ff216e","compact":"e9bbe356089bf5c6ba53cbb4981706c1f43c18b39daccc772f01e81368d6