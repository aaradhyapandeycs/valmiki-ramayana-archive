"],"status":"unreviewed"},"source":{"sanskritLocator":"2005023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"43a22d11dd2444da1f81caca6f970bc062d505b749662af6ed4c10624c6e6d54","compact":"8a8613df85cdcb7c4a762cd715ae77475e30b63073372e67d8715b9f47a2a14d","nasal":"a9ddae956bdd3788f6bc1813b7d34aa46a33b989fa338ae146eb33db2a842635"}},{"id":"VRCE-2-5-24","kanda":2,"kandaId":"ayodhya","sarga":5,"verse":24,"english":"Even as the moon illumines the firmament crowded with stars, the handsome king entered his mansion, like to the abode of the mighty Indra, and thronged with females excellently attired, gracing it (by his presence).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-5-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2005024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a238b78c7117e1928ed006500e7f1c15a4f7cc7f8b5ceecf84f1889702a93c18","compact":"4a2a7b68b924cc043d73e28c6357cbcae2f8a6011e056bd55e3bbcdc7a56c637","nasal":"0e07f10a5b274cc4d60d21814465f6034b98342cac8c4c7f31f53ed68c03e439"}}]
