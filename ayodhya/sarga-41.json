817352305a94fd5900d116a22ad74f340c78c760700e6f5ac999bcbbee0","nasal":"27c3a898ebeb87dca5107aba1c646f4f9c6a06135fe641bdec594c052826d7a0"}},{"id":"VRCE-2-41-18","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":18,"english":"These citizens have determined upon making me turn back from the forest, they would rather renounce their lives than give up their resolve.","alignment":{"type":"1:1","confidence":0.863,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2041018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ee8c82bc3ebe47859319c6ee26e15f034e1a54a35d596771f016232e045134f","compact":"38cee73ad83c521dab10a411e4cb29e3cadd39dd826f7088d1bb12ff0888f250","nasal":"2424e6ff5ad9c91d2bf82b0a9f3de971d28d69b86254b3528828a4e4a32c2ffa"}},{"id":"VRCE-2-41-19","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":19,"english":"Let us while they are asleep ascending on our car, swiftly go our way without fear of molestation.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2041019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fc37f926caf88d5702fdef99fe72245dc3db10a74f5283bb2dad941f8604a14b","compact":"9f5ce81a4b508c794bfd50894af529d435993757ac71402298964df4c3641729","nasal":"7c5192ea83bb3c45843c270e96731e287c86dcbedaab01daae72d0a642735d14"}},{"id":"VRCE-2-41-20","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":20,"english":"Attached to me, the denizons of Ikşvāku's city will not again indulge in sleep underneath trees.","alignment":{"type":"1:1","confidence":0.723,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2041020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ceb4dfa7bc7c0e14e08b01a0bc0b41a6f79b5568800f39547599453d71e6a6ab","compact":"d6e541bb248b08fd0b535c04625f1934f7d9e919a787ac3fddb26ff7d3d03502","nasal":"d6e541bb248b08fd0b535c04625f1934f7d9e919a787ac3fddb26ff7d3d03502"}},{"id":"VRCE-2-41-21","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":21,"english":"A prince should deliver citizens from the calamity they bring upon themselves; but he should by no means drag them into those which he himself has brought on.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2041021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a66f21bc0d8b4014de92339ceb2b8bea109bc3aacb15dea48ca016905c04380","compact":"c961113ce48f8d92f3a13a694a712e73edf4420522476dc24523fb1d63d71026","nasal":"c961113ce48f8d92f3a13a694a712e73edf4420522476dc24523fb1d63d71026"}},{"id":"VRCE-2-41-22","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":22,"english":"Then Lakşmana spoke to Rāma like to manifest Virtue on earth, \"O wise one, even this is relished also by me. Do you speedily ascend (the car.)\"","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2041022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3e8de0774579869482bc860113179c84209dbf75e98a204f72d7154a9988956","compact":"4ddde414cbbf4397775c0d12fe47859dcb3da42b71113669ccedb83212fbb78f","nasal":"4ddde414cbbf4397775c0d12fe47859dcb3da42b71113669ccedb83212fbb78f"}},{"id":"VRCE-2-41-23","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":23,"english":"Thereupon the charioteer bestirring himself, yoking the excellent horses to the car, said to Rāma with joined hands.","alignment":{"type":"1:1","confidence":0.691,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2041023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"14d990b9cdb377d69fe48d66d2e1b2e987517c64cc279b5a269ce30dd9d4d736","compact":"678ac32d33aac6159c320906b396d52d4c3841b1cfeba4332fbe9016a3c5bd93","nasal":"9e8d1f48c32cc8aa4ee96c1adda9202484a742cf285e7bec23d2b713aa153438"}},{"id":"VRCE-2-41-24","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":24,"english":"But with the view of deluding the citizens, Rāma said to the charioteer, \"O charioteer, do you ascending the car proceed northwards; and having proceeded swiftly for a while, do you turn the car. Do you carefully act so that the citizens nay not perceive this.\"","alignment":{"type":"grouped","confidence":0.839,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2041024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"07b71afed9fdc2c70762a5a0d85ff12d11ad912c741029792cd0470f37071500","compact":"225b4adf5360ea04ed6b3da6ef6b884a88b527873d36e73003cefe0d01444e47","nasal":"225b4adf5360ea04ed6b3da6ef6b884a88b527873d36e73003cefe0d01444e47"}},{"id":"VRCE-2-41-25","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":25,"english":"But with the view of deluding the citizens, Rāma said to the charioteer, \"O charioteer, do you ascending the car proceed northwards; and having proceeded swiftly for a while, do you turn the car. Do you carefully act so that the citizens nay not perceive this.\"","alignment":{"type":"grouped","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2041025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2dbfa19a263ca9a968265572f6810a37808429f329db04a39a5b0a7ef19e9685","compact":"3db8bb7e2ae3af9a2d9e5dedea84cb5720753f7edc6e09126ccdc22f49142a08","nasal":"3db8bb7e2ae3af9a2d9e5dedea84cb5720753f7edc6e09126ccdc22f49142a08"}},{"id":"VRCE-2-41-26","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":26,"english":"Hearing Rāma's words, the charioteer did accordingly, and having returned said to Rāma to ascend the car.","alignment":{"type":"1:1","confidence":0.719,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-30"],"status":"unreviewed"},"source":{"sanskritLocator":"2041026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"606ba2f70e7260c988ba036716ffb813806cd8d55ac7a6048ccf8c31c6205b05","compact":"41393f10c6cddea9689ce21057e56ca23c85d3585a770ff382c4abe3685e5fe6","nasal":"71275ddb0af8a24d032914d6c7eea83c14dca9f094c45d45384827a68772648f"}},{"id":"VRCE-2-41-27","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":27,"english":"Ascending the car after equipping himself, Rāghava crossed the rapidly-rushing Tamasā abounding in eddies.","alignment":{"type":"1:1","confidence":0.719,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-27"],"status":"unreviewed"},"source":{"sanskritLocator":"2041027","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de06b28f10df130d082dbea234d85e7c5eede05e399451b349c2998c9efae289","compact":"9423d2d253c68fb5bde348c68b892b512b5c7600bb2178dbd5759de4916862ee","nasal":"dff00c33ed727348c35e3282ac3c9d929805e374eb94993b927a3b48f99d3fe1"}},{"id":"VRCE-2-41-28","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":28,"english":"Having crossed (the stream), the auspicious and mighty-armed one came upon a safe and goodly-high way capable of inspiring even timid people with confidence.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-28"],"status":"unreviewed"},"source":{"sanskritLocator":"2041028","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a6219449d9f9c6ac1974d5086ca0b728be1dbafe3dcf0e4f51f32b2e4ca715c","compact":"f081a885e608ff5f779b55ecbe45874e091630b43368984518f9