[{"id":"VRCE-2-41-1","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":1,"english":"Then Rāghava pausing on the banks of the Tamasā, looked at Sītā and spoke to Sumitrā's son, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2041001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e9eb29a43dacf801f7710fc65746dbc1a6ae77f9e5ea23289ddc4e7cb3a4ae3","compact":"7437d6360b2e5f559ddafd7077de8479365f638597411a4a52da10b6e54270bd","nasal":"7437d6360b2e5f559ddafd7077de8479365f638597411a4a52da10b6e54270bd"}},{"id":"VRCE-2-41-2","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":2,"english":"O son of Sumitrā, this is the first night of our exile into the forest. From this day it behoveth you not, good betide you, to suffer your mind to grieve (by dwelling on past joys.)","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2041002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e6cdc99eb5e244b64a1dcc5668618533692e380cc0216d14722830dc280a1ad5","compact":"15cddc6c73516236d0aaea66e20885f8b6b25933d94864d36ae30e22e8319750","nasal":"069a1cc881e4643c429feb5dd5dece83b0db1d896368f5c7c9eb4e5bd61de9a4"}},{"id":"VRCE-2-41-3","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":3,"english":"The empty forest resounding with the cries of beasts and birds returned to their abodes, covered with gloom, seems to weep on all sides.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2041003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a5c585e65530adc6b802b60c3cb4a628740da52616bb61e2fb6a55f4e53650c","compact":"640b628fb475c7d03e3b095e4942f2e1da4f409395e568939fda24d9342b8e5d","nasal":"099588d05a2a2d81c4c57e197e6ef8c023c90a8b9d32c566fafa521c6023cfd3"}},{"id":"VRCE-2-41-4","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":4,"english":"Doubtless to-day the men and women of Ayodhyā, the metropolis of my father, are bewailing us retired to the forest.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2041004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9b151af60205eaccee4e44b0a600ff84616f50c25ec6b4b5baf435f85784809c","compact":"9b1c3afefd6da8729baa2f38811345f2ba6b7382fce899876097b531eba74b0b","nasal":"9b1c3afefd6da8729baa2f38811345f2ba6b7382fce899876097b531eba74b0b"}},{"id":"VRCE-2-41-5","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":5,"english":"But surely the virtuous Bharata will console our father and mother with words fraught with virtuc, interest and profit.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2041005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e336dfbafbdcdf1a66e673eb0cc13bf89c2dd7744862171d1fd81593e54996b","compact":"b433dfd4273c57f4f3e75d515bd8f276f5e9026b5c05c6702d8079ffeb5cdead","nasal":"b433dfd4273c57f4f3e75d515bd8f276f5e9026b5c05c6702d8079ffeb5cdead"}},{"id":"VRCE-2-41-6","kanda":2,"kandaId":"ayodhya","sarga":41,"verse":6,"english":"Reflecting again and again on Bharata's sincerity of soul, I do not, O mighty-armed one, bewail either my mother or my father.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-46-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2041006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c952c869458c4cbeb02bd24fb7930