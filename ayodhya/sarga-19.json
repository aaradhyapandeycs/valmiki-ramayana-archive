[{"id":"VRCE-2-19-1","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":1,"english":"Here after holding the equanimity of mind with patience self-possessed Răma spoke thus to the son of Sumitrā, his dear brother, and friend, who was greatly sorry, had lost his patience and was pressed down with this misfortune of Rāma, and had his eyes inflated with anger like to an infuriated elephant.","alignment":{"type":"grouped","confidence":0.77,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2019001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"421e91e56ee9e813f0ad1ba2fead8e9288f6b245798468542635947831325f99","compact":"a3fb6562eae204838e86150960844e4abce47fde793e914cdd1157d9db3186ff","nasal":"c8dfc3670d477c323489bd79f56b1d6df9db901b9c26408e98a3d5421ee36a97"}},{"id":"VRCE-2-19-2","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":2,"english":"Here after holding the equanimity of mind with patience self-possessed Răma spoke thus to the son of Sumitrā, his dear brother, and friend, who was greatly sorry, had lost his patience and was pressed down with this misfortune of Rāma, and had his eyes inflated with anger like to an infuriated elephant.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2019002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e631a60a87a06b04deee62f33d8091a6763b555b30eba6e397ab52b1cd9c12d8","compact":"10e0ab5c6266b4e4a87799ea200d3d1e535f3a7cf09fc06540e692f04d468b1f","nasal":"10e0ab5c6266b4e4a87799ea200d3d1e535f3a7cf09fc06540e692f04d468b1f"}},{"id":"VRCE-2-19-3","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":3,"english":"Oh son of Sumitrā, do you take that amount of trouble for preventing now the collection of materials for installation, as did you take beforehand for collecting them.","alignment":{"type":"1:1","confidence":0.625,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2019003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee70fead153cb570de1dc6238df6911e3e8813b2c7b288de9bca0e97fdfb27b3","compact":"f5055e394a2d0ad97a7057293c654fdf5017cdfb9d774d3d5db2dabdd5f97e43","nasal":"f5055e394a2d0ad97a7057293c654fdf5017cdfb9d774d3d5db2dabdd5f97e43"}},{"id":"VRCE-2-19-4","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":4,"english":"Do you act therefore in such a way as will remove the apprehension from the mind of our mother (Kaikeyi), who is troubled at heart so greatly on hearing of my installation.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2019004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"330e033e7f340c621903f7179ffbaa3ec006f7495fe7d0dc896f5d58b4eedf0c","compact":"ec457c1c2ae22c6564ffba8390dc09aad61ad72e341e2a7f465a463746b32e6b","nasal":"577474be21c66c29101aec185e484fee5aa3bc11aaef0e0c85582138dc6d5f12"}},{"id":"VRCE-2-19-5","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":5,"english":"Oh, son of Sumitra, I cannot neglect for a moment the trouble which has arisen in her mind on account of this fear.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2019005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c2c9d2119f2034fceb027d2071fcf08b788b635fa97d6689189d62588f16c221","compact":"3fa0edeb101e87a2dfe0ca74ad77e560fcfe995a4778f321fd99f9f979e4883e","nasal":"d123adb2a5b06e2bf62ce89fd668cebe0b9556ca5a175d124051339176875e11"}},{"id":"VRCE-2-19-6","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":6,"english":"I do not remember to have done on any occasion wilfully or unwilfully any thing that is displeasing to my father or mothers.","alignment":{"type":"1:1","confidence":0.688,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2019006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5732b5f2a00fa9676c68e68cdc5baffd6893ed5b40980ab2f95a83cc9b8f4dc3","compact":"0c8bf7ded500e00857e650a6755c734e65298ec728c56424b4562d5ef830faf7","nasal":"0c8bf7ded500e00857e650a6755c734e65298ec728c56424b4562d5ef830faf7"}},{"id":"VRCE-2-19-7","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":7,"english":"My father is of truthful words and vows and he has been greatly terrified by the fear of the next world; may his fear disappear now.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2019007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e99d4900b837cf06dafcb6d504d45f50cbb5d81341f22045acee2e34ba78d440","compact":"671b726d292fa61bd345c3464a672fd0dc1befd4bc8dc19b35fc507cfb20fef6","nasal":"671b726d292fa61bd345c3464a672fd0dc1befd4bc8dc19b35fc507cfb20fef6"}},{"id":"VRCE-2-19-8","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":8,"english":"If this work of installation be not stopped, my father shall be greatly pained at heart thinking that his vows shall not be fulfilled and his sorrow will also ache me.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2019008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a26e26e2988c23bcf5d9010cfb963fec70275ca70f1ea6edbec24559143aa894","compact":"76df868829fb0f902708ed698bb553fa53372b370af4a58d741ffba6bd58c128","nasal":"76df868829fb0f902708ed698bb553fa53372b370af4a58d741ffba6bd58c128"}},{"id":"VRCE-2-19-9","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":9,"english":"And it is for this reason, Oh Laksmana, that I purpose speedily to retire from this city to the forest, renouncing the preparations for my installation.","alignment":{"type":"1:1","confidence":0.967,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2019009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"793aaeaae0d217faf6ad3a4d52e047fc9103c27e2aecf36b472fdb4e3c060de9","compact":"602e1067d07ec1aa3d8f752a296b603c7ec0609d41861465101ad738b95db526","nasal":"46dd53735b7a389db9642c14e3a32fe2b456b3c6fbc04c2edfe6237039adf948"}},{"id":"VRCE-2-19-10","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":10,"english":"On my wandering away to the forest to-day, the daughter of Kekaya shall have her ends attained and shall install Bharata on the throne without any disturbance whatsoever,","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2019010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4dcabf6169c5b0a459cb68cb14ffaa6f2e3d78ce38c580d6b0ca0f9dc145e8f","compact":"6ecc1794d340651d506e980cc46de7210cbcd4d8862b575e55896ee15e92215a","nasal":"6ecc1794d340651d506e980cc46de7210cbcd4d8862b575e55896ee15e92215a"}},{"id":"VRCE-2-19-11","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":11,"english":"Myself going to the forest, wearing. bark, tiger-skin and matted hair, Kaikeyi shall attain the happiness of her mind.","alignment":{"type":"1:1","confidence":0.849,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2019011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c442d7b2024ae532ac0e18080f13aecb9e52cebb4e6e80f319fc4af91fd8fad5","compact":"8516a0585d404b8cc07fd813a0ab14458894fb96cc97966d61d6bebd41fe950d","nasal":"ca91b25dcaec266ee6fc640b21d07f7b5007851d47d65a6cbff73e7bef653de1"}},{"id":"VRCE-2-19-12","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":12,"english":"That great One, who' has inspired Kaikeyi with this mode of mind and has kept it firm, I cannot offend. I shall repair hence without any delay.","alignment":{"type":"1:1","confidence":0.863,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2019012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"25004fc0a71a005a99bb0a7c717ac0ccdd973743513b22d5c6ea78475301f446","compact":"419fdcc78b5edf69b3d4433b2bfafeb38c6ea4c0393b4f050a003b052d0cadc2","nasal":"419fdcc78b5edf69b3d4433b2bfafeb38c6ea4c0393b4f050a003b052d0cadc2"}},{"id":"VRCE-2-19-13","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":13,"english":"Do you regard, Oh Laksmana, destiny as the only cause of this transfer of the kingdom, although attained, and of my banishment.","alignment":{"type":"1:1","confidence":0.783,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2019013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"48d5200006c5be3f7a1d24240fc4dea213667123217cc8f9055e841f7e245ba0","compact":"8e733485aa200220050ad796aa9bf3f1a69b268016f263fcfd481ee918f5e38d","nasal":"f09d7c55c142f3f1215eb19a09166d44a831fc297157c5c933e904a01ff3874b"}},{"id":"VRCE-2-19-14","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":14,"english":"Had not destiny been instrumental; in bringing about this; determination in Kaikeyi, she would not have been so much persevering in the infliction of misery upon me.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2019014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e03f0e65e5969a27fc69b5d513b62aac5a8d3daf972cc7798ef76af28fe2996c","compact":"17accf865980cf40bca8b9bd5cc516c8a8ec7ffe31fb7656ff4e72298a5257e2","nasal":"18dc6fc993f51f6e8772eda523c90fd429b7b694e881927d372a11996bf486f3"}},{"id":"VRCE-2-19-15","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":15,"english":"Do you know, Oh gentle Laksmana, that I have never made any distinction in my mind between my mothers, nor did Kaikeyi make any such thing before between me and her son; consequently it is destiny only that has made her press for the prevention of my installation and for my exile with harsh and cruel words, or else why should she, a daughter of a king and possessed of an excellent temper and high accomplishments, speak painful words to me in the presence of her husband like to an ordinary woman.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2019015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c0b60e55ecd7544fabdddb9ca8f960efec66f7b54c1c0e9c9fa402c4f74b6a4","compact":"aa1d205ed39a24f668f034bde58a31616690300cfbc0c0ad2ebc4086958fe04d","nasal":"3853488d8c3c594faef0970bd95691ec160bb6ab6dc91b7287594fb8042220c5"}},{"id":"VRCE-2-19-16","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":16,"english":"Do you know, Oh gentle Laksmana, that I have never made any distinction in my mind between my mothers, nor did Kaikeyi make any such thing before between me and her son; consequently it is destiny only that has made her press for the prevention of my installation and for my exile with harsh and cruel words, or else why should she, a daughter of a king and possessed of an excellent temper and high accomplishments, speak painful words to me in the presence of her husband like to an ordinary woman.","alignment":{"type":"grouped","confidence":0.766,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2019016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bab130033e69dd16014ba2d4b819268c785cf2fb553f0eb69f504c412d6cbc75","compact":"94c005b709d6493558bacb3b0a6d83dce0ea1de553100088132ff14c50e6bd1c","nasal":"94c005b709d6493558bacb3b0a6d83dce0ea1de553100088132ff14c50e6bd1c"}},{"id":"VRCE-2-19-17","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":17,"english":"That which is above comprehension is Destiny and it is beyond the power of creatures to avert its consequences; and evidently it is through this Destiny that have sprung up this distemper of Kaikeyi and my loss of kingdom.","alignment":{"type":"1:1","confidence":0.771,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2019017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3885984c5d10cf6689e99583d92762de0ea9b84739f16a2e021d09f65b1d9572","compact":"e8568acd1bc8ce474f5bb005943cc142034f8c74b6d64931082f6ee5197e63e3","nasal":"94f6fefa06bef2d5c9a4e747acbdfabcc9b3fa0985be2eea0dd634529f965848"}},{"id":"VRCE-2-19-18","kanda":2,"kandaId":"ayodhya","sarga":19,"verse":18,"english":"What man dares wiinstand Oh son of Sumitrā, this (terrible) destiny bidden from our view until known by the consequences of action destiny is the prime source of all those inconceivable causes which occur with reference to happiness misery, fear, and anger, profit and loss, birth and deliverance.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-22-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2019018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc4c13b23a10b6c74467c64652e328797d4603d3fd5e40