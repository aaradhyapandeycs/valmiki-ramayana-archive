[{"id":"VRCE-2-80-1","kanda":2,"kandaId":"ayodhya","sarga":80,"verse":1,"english":"Guha, acquainted with the forest, described to Bharata of immeasurable prowess the regard the high-souled Laksmana bore to Rama.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-86-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2080001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"25744c24604e6d57f6223bed2c6d5631f58d8cc3a806493ede80d2ebf13c732e","compact":"ed224aeb72d370eeb0d3e704139213b7beaf8deb7291c763b80b37b52159c4c8","nasal":"ed224aeb72d370eeb0d3e704139213b7beaf8deb7291c763b80b37b52159c4c8"}},{"id":"VRCE-2-80-2","kanda":2,"kandaId":"ayodhya","sarga":80,"verse":2,"english":"To Lakşmaņa crowned with every virtue, waking up, holding the bow with the arrow fixed on it for the purpose of guarding well his brother.","alignment":{"type":"1:1","confidence":0.957,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-86-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2080002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7c53238ed8469a8ba382c4d491a89cdec042379b7e917198d2d0b6c6fc0150b8","compact":"f7509d0c3c1701bfc943e4b51bb8354df4484220b88307667a3ae74d45af518b","nasal":"61e03ab92bad2736b5b3cd31fba3db5b6834c638d6c766fe4fedc2575dd7e4c8"}},{"id":"VRCE-2-80-3","kanda":2,"kandaId":"ayodhya","sarga":80,"verse":3,"english":"I said, “This easeful bed has been prepared for you, my child. O son of Raghu's descendant, cheer up! Do you lie down at ease. All these people can bear hardship; but you are meant for comfort. For protecting him religiously, we shall wake.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-86-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2080003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bf0