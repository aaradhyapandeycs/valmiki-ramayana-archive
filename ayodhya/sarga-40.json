[{"id":"VRCE-2-40-1","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":1,"english":"The people, who yarned after Rāma having truth for prowess, followed him repairing to the forest.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2040001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb49beebd2e19c1fda619c0b311c1087916f72b42930429989dcce8097bbe548","compact":"ac9321aab6c33231ba260dc5ad2332f547305df415b0ac3f4394ad3909a75ec4","nasal":"a522bbdf4a3319e9b51c8fa2ccab4674ba29559d3f7513df7674f826b61e029a"}},{"id":"VRCE-2-40-2","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":2,"english":"Even when the king in the interests of his son had with much ado restrained himself, these, following Răma's car, did not desist.","alignment":{"type":"1:1","confidence":0.557,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2040002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8718e196e3df4a470c360a12c157fe20a998b31abb820d02f04c52075fa48d11","compact":"37659e2f3541f1ce7e3641e7d29aa35c48446d6f26b8fc4c013fe3afd63872bc","nasal":"831464cec1706b8fe100965ca50d84c93ae9c7d8d42d5ef0256791734fab4a1e"}},{"id":"VRCE-2-40-3","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":3,"english":"That illustrious one crowned with every perfection was dear to the inhabitants of Ayodhyā like to the full moon himself.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2040003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4fb5f24f592240daa4da65bebcdedd655dd3ac6a871d6731c3e954efabbd222e","compact":"ad8dc6eeb2c6577be7e37ab41b41da2bd4f79bc88fb14f0ad3077ff7a00ffb72","nasal":"5700d9f99922f1686aea6f89f8180b2c22a674810e2847194ecbb8f90e5aa43d"}},{"id":"VRCE-2-40-4","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":4,"english":"Although besought by the subjects, the truthful Käkutstha having pledged his word to his father, kept on going to the forest.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2040004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d2c566139b0d15ff909c852fc6b177fb3aa2cd4cc80ff5e75a846c99551f3537","compact":"c4e0e8b173b9adeda2b4567bb28d991ee6d497ac126a03d0020a530fc5ea17ce","nasal":"c4e0e8b173b9adeda2b4567bb28d991ee6d497ac126a03d0020a530fc5ea17ce"}},{"id":"VRCE-2-40-5","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":5,"english":"And affectionately eyeing them as if drinking them with his sight, Rāma touchingly addressed those subjects as if they were his own, The love and regard which the inhabitants of Ayodhyā have for me, let them, for pleasing me, extend in full measure towards Bharata.","alignment":{"type":"grouped","confidence":0.688,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2040005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"53bad638b95c846eb83092917cc16d958cbb4d31f1cc42641cbf6dea479e855d","compact":"6b10e6c72b407a3aacd6cc4ae24b8b9f4c39d7e60e6d58880e1ccf52b41678ff","nasal":"60b287e36fb04695a110a1798e0ff898f3b6d8e7178d3fdd84136271cc44d039"}},{"id":"VRCE-2-40-6","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":6,"english":"And affectionately eyeing them as if drinking them with his sight, Rāma touchingly addressed those subjects as if they were his own, The love and regard which the inhabitants of Ayodhyā have for me, let them, for pleasing me, extend in full measure towards Bharata.","alignment":{"type":"grouped","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2040006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d5c200ab41980f2258caafced108869f568df9990428a7fca21814d7ac59d95","compact":"62e25d5b7f397714c1c88d28a02f7744d213f54b33cce6c3568eca0d30154ece","nasal":"70de48b453b10fd9b520bbc56baf692897c9de566e84a379d9d77a9c836d7fe0"}},{"id":"VRCE-2-40-7","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":7,"english":"That enhancer of Kaikeyi's delight bearing an auspicious character, will duly compass your happiness and welfare.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2040007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"90bbb459ff1943017efa7471bbd27d7adca5f69c78e268c75c29e2400d0ef0e2","compact":"feb5382878513d16b2adc49a5c867fec5c821513cf28213e617b9e38684de123","nasal":"eb5cae849876d8a4ccbcca1b07c51f37313e26b804b2ae0086a19297e853a002"}},{"id":"VRCE-2-40-8","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":8,"english":"Aged by virtue of his wisdom, although young in years, and mild albeit furnished with heroic virtue, that remover of fear will make a fit ruler for you. son","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2040008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"70eb1d7b3eb76015b742c5280b28c17b2129c9cb7b79b490f54b1e2a13184005","compact":"01e9d3a195bc63fb1321a1ef7b9af37250fa072547a79d23398988ee728e36bd","nasal":"01e9d3a195bc63fb1321a1ef7b9af37250fa072547a79d23398988ee728e36bd"}},{"id":"VRCE-2-40-9","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":9,"english":"Crowned with every regal virtue and selected as the heir-apparent (by the monarch), he is more meritorious by far than I am. I behove you to obey the order of your master.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2040009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a74598ad88b4c28c7c93ad63c14ae0d3ad264273ae4041a161cd2b361a97865c","compact":"1f3c58386d5a8106eabd0a534c1464f5c9d642d4bf17714ce779c83f3f622743","nasal":"1f3c58386d5a8106eabd0a534c1464f5c9d642d4bf17714ce779c83f3f622743"}},{"id":"VRCE-2-40-10","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":10,"english":"And seeking my good, it beloves you to act so that when I shall have gone to the forest, the king may not grieve.","alignment":{"type":"1:1","confidence":0.963,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2040010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cc1585746f1a3979f2bfa00d55bf6f3c8d221267ebc9bad90f87174e0e5ab696","compact":"de004cea23bc3d5d018dae8d2b3cbe881d862930f0b04b3465895e031f425b31","nasal":"de004cea23bc3d5d018dae8d2b3cbe881d862930f0b04b3465895e031f425b31"}},{"id":"VRCE-2-40-11","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":11,"english":"But as Daśaratha's son was bringing home to the people that their duty lay in obeying the royal Mandata, they desried that even Rāma should rule them.","alignment":{"type":"1:1","confidence":0.547,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2040011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8e88e3e46d5e5f3b62d618b09807e12947bbcf63f9c892c060b61ce2bee409a6","compact":"c44db0cbceb0d4236bc990a7c8a3b2fc822ab936ce19eca8159f7c8bcee2e7b0","nasal":"c44db0cbceb0d4236bc990a7c8a3b2fc822ab936ce19eca8159f7c8bcee2e7b0"}},{"id":"VRCE-2-40-12","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":12,"english":"Rāma in company with Sumitrā's attracted the inhabitants of the city subdued by his virtues, who stood with tears in their eyes.","alignment":{"type":"1:1","confidence":0.717,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2040012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27609045dc8c452ccadba3cef66dde070c7f78c7106340781f67ea9f92ee65eb","compact":"2ca2b1e01689699b76c700484c6cbdc591215fcad1573e3cd83f7f4c8157d3af","nasal":"2ca2b1e01689699b76c700484c6cbdc591215fcad1573e3cd83f7f4c8157d3af"}},{"id":"VRCE-2-40-13","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":13,"english":"The three kinds of the twice-born ones, viz., those old by virtue, respectively, of age, wisdom, and ascetic energy, the old folks with their heads shaking through length of years, cried from a distance.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2040013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"75b653168668b3a11dc05c199db304a3ff6f1425e47d2aa230f8bef3e1cbfefb","compact":"acf48edf2f7c7b07cc8d2054631dcff5d7c174087188fd0b8a61bc2558c96587","nasal":"cbc6bcb89e63f1e796145cb0848a88156c6c8820b3afe89f7e226a53f2003249"}},{"id":"VRCE-2-40-14","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":14,"english":"O you fleet coursers boasting of exalted extraction that bear Rāma away, do you desist, do not go; do you do even what is for the good of your master. Pure of spirit and heroic and ever firm in noble promises, that master of yours should in justice be carried (to the city) and not to the forest away from it.","alignment":{"type":"split","confidence":0.531,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-13","DUTT-2-45-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2040014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a057d15396d2a83cf98958e1ff2e85e6648c882eeca7a939dae590545a96919","compact":"5e8675f3dc349b7499d72618fcb2dea4e207508575e85e0cc78ccec9373affdf","nasal":"c3e674d7a353c80217b34d2ded2874ea97ee37a571110eac03f773b263efe2fe"}},{"id":"VRCE-2-40-15","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":15,"english":"Suddenly seeing those old Brāhmaṇas thus lamenting distressfully, Rāma speedily descended from his car.","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2040015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"91d6d2d45c7836a3e17becca57924e613a05eb70739a3667c6b644652ffb4f7a","compact":"1c7f2b872696ee912cfb58ddd07f483de4f19d2db4d670a00ae5d8b7103c8f22","nasal":"1c7f2b872696ee912cfb58ddd07f483de4f19d2db4d670a00ae5d8b7103c8f22"}},{"id":"VRCE-2-40-16","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":16,"english":"Along with Lakşmaņa and Sitā, Rāma bound for the forest, began to walk near them on foot.","alignment":{"type":"1:1","confidence":0.906,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2040016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bdc93b3608605ea95b2931383be22207ceb1ec4df4390cad4afed06de25056f6","compact":"712337c16f5b82140505ba66c42725c32df73310239f2d13003f464c2114fc59","nasal":"712337c16f5b82140505ba66c42725c32df73310239f2d13003f464c2114fc59"}},{"id":"VRCE-2-40-17","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":17,"english":"Endowed with kindness, that friend of the good, Rāma, could not by proceeding on his car bear to pare with the Brāhmaṇas that were following on foot.","alignment":{"type":"1:1","confidence":0.731,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2040017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"43243a98f928aaba4ea1d5fc2fb371f1784b63d1659eae1421fd5da55c948684","compact":"916f5a5aae6689387313213b982f1109718501ce61f6d74cb4aaeac379d4f5ca","nasal":"916f5a5aae6689387313213b982f1109718501ce61f6d74cb4aaeac379d4f5ca"}},{"id":"VRCE-2-40-18","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":18,"english":"Seeing him thus going, the Brāhamaņas with agitated hearts, and burning in grief, addressed Rāma in these words.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2040018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e0587eac313aefc47d62b0f7a2ad30885eaec2e207a5b6ebd2e0f02fc89ad15","compact":"1b55583d1522151424c1f16829305eab97baba847ba80448eeef91f825979b80","nasal":"c8516ca3c61a50673ece2190facb7dbf5a1587a0742984d3768d9412de7babd3"}},{"id":"VRCE-2-40-19","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":19,"english":"The Brāhmaṇas in a body are following you ever seeking their good, and mounting on the shoulders of the regenerate ones, the (sacrificial) Fires are walking in your wake.","alignment":{"type":"1:1","confidence":0.964,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2040019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"63b85e696ac08ab62a338d3a78ef876ca5a062ecb8df7ce8745751605c88dc0a","compact":"bd5f30193a9a66f705d8774e0cf8e370cbc4b1438ec43886eb991b6b93094f15","nasal":"b42e9daa13bc16f6ddbadf8cef81548ea9a212b01fba5f3d16d6ce86af679ebf"}},{"id":"VRCE-2-40-20","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":20,"english":"And behold these raised umbrellas of ours got from the Vājapeya sacrifice, that like to autumnal clouds follow at your back.","alignment":{"type":"1:1","confidence":0.717,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2040020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0548cddc9cc92d3b152dbdc08443b08ca1c144e3b096416c627d26bb88297dbc","compact":"a31b185b0e6429825acc3e07fd547a8bb1bf2fdb0ef78d6c7251ce79c23da426","nasal":"a31b185b0e6429825acc3e07fd547a8bb1bf2fdb0ef78d6c7251ce79c23da426"}},{"id":"VRCE-2-40-21","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":21,"english":"With these umbrellas got at the Vājapeya sacrifice, we will afford shade to Rāma destitute of his own white umbrella, when he shall feel the heat of the (solar) rays.","alignment":{"type":"1:1","confidence":0.941,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2040021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b9bed5b7ae6a1d6eabc7d3f291e90f40bdccfb910bd85720fdb38a352b70bb27","compact":"8aa42e52f1ea300c70510dc2f06d9f44d727bef244d2c0c2587bf9657deb676b","nasal":"8aa42e52f1ea300c70510dc2f06d9f44d727bef244d2c0c2587bf9657deb676b"}},{"id":"VRCE-2-40-22","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":22,"english":"That intelligence of ours which ever follows the Vedic Mantras, is now, O child, ready to follow you to the forest in your interests.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2040022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5da29574d24e343f250c5914064a83e7781dcc211eb41298993cfe1debe240c4","compact":"ca3c20c71398c04ab3e1a98f9fbddf8d43f9038dde25efc6ab951aaded3fcfbc","nasal":"c831dcfa14dde6a964fc15866c238ba43a0c6739b877059bfbdbaed060b723a6"}},{"id":"VRCE-2-40-23","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":23,"english":"That best of treasurers, the Vedas, resides in our bosoms; and our wives protected by their chastity shall abide in our homes.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2040023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8a383514315cb1e95ec9b983e53f66598fc2f406508911ee919bebbe8e051619","compact":"58d81f2f8af8b2f43b7ccc8f81408439b9f316ef6c283d18479d76ac4a1758ae","nasal":"ffbd3e320c7f4dd3aa05387ec57c6ccac9a14c662cb1ed68f04713f606de7b42"}},{"id":"VRCE-2-40-24","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":24,"english":"As we have already made up our minds to follow you, it is useless to fix our hearts afresh. But if you overlooks virtues, what becomes of abiding by righteousness?* *Another reading is; What becomes of the virtue that we expect at your hands?","alignment":{"type":"1:1","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2040024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"633a89dd42ce81171d60d0877f94ee82c1857d0804558b9381d1c83c180bf790","compact":"b3b6994c5a2857e7c571b5f8eaba6406a9fbf411164a2419539ebff411522fe8","nasal":"b3b6994c5a2857e7c571b5f8eaba6406a9fbf411164a2419539ebff411522fe8"}},{"id":"VRCE-2-40-25","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":25,"english":"O you that are ever firm in virtue, we beseech you by humbling to the dust our heads covered with hair white-hued like cranes, do you desist.","alignment":{"type":"1:1","confidence":0.914,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-26"],"status":"unreviewed"},"source":{"sanskritLocator":"2040025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8af7b463e1c79df7a88a1d25be764b7c514b40667c2f94ae4234e0aefdd4de2e","compact":"98685ea89d61f0d7ceeeba3d0184e1b7a8c9bb4bb6ba85fee87b03ea44c140d2","nasal":"98685ea89d61f0d7ceeeba3d0184e1b7a8c9bb4bb6ba85fee87b03ea44c140d2"}},{"id":"VRCE-2-40-26","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":26,"english":"These numerous Brāhmaṇas that have come hither have entered upon many a sacrifice. The completion of these, O child, depends upon your return.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-27"],"status":"unreviewed"},"source":{"sanskritLocator":"2040026","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b770e0ec7c3a5afb6c122ec133c8690d0e1df8a58e07bf251651a7fcb176291c","compact":"ed2551014500a0c3a7f6eb6409ffac0fe5e8914261a922ab1e47e321d2df148d","nasal":"ed2551014500a0c3a7f6eb6409ffac0fe5e8914261a922ab1e47e321d2df148d"}},{"id":"VRCE-2-40-27","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":27,"english":"All creatures mobile and immobile cherish you with high regard. All these beseech you. Do you show consideration to those that regard you.","alignment":{"type":"1:1","confidence":0.61,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-28"],"status":"unreviewed"},"source":{"sanskritLocator":"2040027","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e0cf63b4d8fa7d813452bd0d205e4212607f4212bcdd1ff34c37d7e39c0ebbf","compact":"946e571d83d6b47e15d1857cee66911c54043999a4d98a20403d7ff7d0ab3407","nasal":"1c5d50701cac9dee4e3906add59b16840949527693b6356182bcb6e564438ba0"}},{"id":"VRCE-2-40-28","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":28,"english":"Tall trees deprived of motion in consequence of being fast rooted to the earth and incapable of following you, are prohibiting you by sounding with the wind.","alignment":{"type":"1:1","confidence":0.688,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2040028","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77d22eeb099ab1822111d8a2a729d77c4dbbd51a261d6069025650d391621b08","compact":"c61ed51f2ba7295d7943a9023907c110b2c72780e4670352a44fccf465727eaa","nasal":"44549fd2321517e6df98a97cecd80efb66c18d316b0f1436ac341405088ff3b8"}},{"id":"VRCE-2-40-29","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":29,"english":"And birds staying upon trees and neither manifesting any motion nor seeking for their food, beseech you to have compassion upon all creatures.","alignment":{"type":"1:1","confidence":0.671,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-30"],"status":"unreviewed"},"source":{"sanskritLocator":"2040029","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c98c9505d59253bb63ee2cb5c2e0dd112a2234e859e77fd4f6d65174f55bcd2c","compact":"8332a86d150b70b83e4dc3235f7603333631853cac1910b6447d9899e3ab7580","nasal":"1ee79c327e4c707c4d9f10ad53eff1657bc5e492ceb409656d0317073e005417"}},{"id":"VRCE-2-40-30","kanda":2,"kandaId":"ayodhya","sarga":40,"verse":30,"english":"While the Brāhmaṇas were loudly demanding the return of Rāma, he found the darkness to descend as if forbidding him.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-45-31"],"status":"unreviewed"},"source":{"sanskritLocator":"2040030","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3936c9e22338a15468e6ea17862b060499c0a7fcb25ed5aa4b59b3f97efc7d39","compact":"f6439e25e77cb779b814e244e4ef91eba4fe83bef2357e141a39d7264a2c31f6","nasal":"a1d75fcd35afa933dc4ca1ad730aa366c6c7c42a047b91698de21117c7f41641"}}]
