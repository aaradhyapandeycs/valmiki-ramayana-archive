[{"id":"VRCE-2-32-1","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":1,"english":"Then that descendant of Ikṣvāku afflicted because of his promise, sighing and his heart filled with the vapour begot of sorrow, again addressed Sumantra, saying.","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2032001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e32450c6c097841e0c24f90367fff697bfbd254529f9cede7116eb6955a706b","compact":"441135dc0d254eb021492723ad30d06a2f2b3efb540734af1beace47b3e0c36f","nasal":"a8af7c5927708954fc50d578488c74ad252a4fa7d3868a2a617e07c7c23471b9"}},{"id":"VRCE-2-32-2","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":2,"english":"O charioteer, do you speedily Marshall the army consisting of the four kinds of forces for following Rāghava.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2032002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8348e836aa6c3690a17ffb3180411e1ff22a0edcccc5d987d27fea076e1b2acd","compact":"fb3bd5fb435a92d8bcffeddbc9f8579fddfbbebda31fb09fc71158244539a92e","nasal":"fb3bd5fb435a92d8bcffeddbc9f8579fddfbbebda31fb09fc71158244539a92e"}},{"id":"VRCE-2-32-3","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":3,"english":"Let sweet-speeched courtesans and opulent traders grace the extensive army of the prince.","alignment":{"type":"1:1","confidence":0.678,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2032003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bc3b85e332fbacbb97e959935e39da03a22af57c3b7139646ed0baf418a78914","compact":"28b169fc33edfd3b43d1b169d4ade0ebdf87329916ec5db4cef3739e7d3c46df","nasal":"20d0b8df339f7094198bc95de017f8f83d8c8efbd4997be9ae65a55b6c23bd8c"}},{"id":"VRCE-2-32-4","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":4,"english":"Giving them immense wealth, do you also send with him those that depend on Rāma, as well as those with whom he delights to wrestle.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2032004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dee11a8d38c9387d999458755fbce786c4908f92d65eb3130a39717b8369f533","compact":"3a4402fabd37aa468e9878d13d4aa5396c8f4c6aa6ffae58ecce59d9f6d52234","nasal":"0e58a9556bfc13cc2738ebccb127a5dd0c775afd4c82ea30e9f4461caa30bf09"}},{"id":"VRCE-2-32-5","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":5,"english":"Killing deer and elephants, and drinking wild honey, and beholding various rivers, they will ultimately forget this kingdom.","alignment":{"type":"1:1","confidence":0.903,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2032005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"023af48cd2f49861bd6e6fc48fadeb7968f4fba5124d35a4c4446440e78ce058","compact":"166e38fadc93c505fc1064455a8bc44d8e73f739dd340f9665862db48978ab48","nasal":"ea7b3707b5292480f75be9def5d594449e329315cb4d45217c4ad64adba78513"}},{"id":"VRCE-2-32-6","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":6,"english":"And let our granary and treasury follow Rāma who is to reside in the forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2032006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f6cb831cde119eb31bcd06f1ef90fe858693c9e264e8df0be01d1885d610ca2","compact":"b6d13309bb56035f673b3a10966b65923eef283acfcd15ac05b2dcd752d5c4c7","nasal":"7777733d7e0763ae0232728acb4fee0da07c136896ba0272551c5bc0466dde54"}},{"id":"VRCE-2-32-7","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":7,"english":"Performing sacrifices at holy spots, and dispensing the prescribed Dakşiņās, let Rāma happily reside in the forest in the company of saints.","alignment":{"type":"1:1","confidence":0.723,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2032007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d7b0c8af6a503209f4f2c89fa2664753bc26567dd90871f64852dbbcaf41a151","compact":"708995c223e24bb9bc004ed44e9a4ebe9c96e6553b8bb460c9bf35278ac0aca4","nasal":"708995c223e24bb9bc004ed44e9a4ebe9c96e6553b8bb460c9bf35278ac0aca4"}},{"id":"VRCE-2-32-8","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":8,"english":"The mighty-armed Bharata will govern Ayodhyā. Therefore, do you furnish the auspicious Rāma with every object of enjoyment.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2032008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b8e6e2969b973abdf0deea0e358379c6b09536054889c24c3e1c16472b40dc83","compact":"719cdc9b129dbb3daae76d983546baa165ba90a5b65c13bd9368a535a4d4eaf5","nasal":"719cdc9b129dbb3daae76d983546baa165ba90a5b65c13bd9368a535a4d4eaf5"}},{"id":"VRCE-2-32-9","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":9,"english":"When that descendant of Kākutstha said this, Kaikeyi was inspired with apprehension: her countenance became blank, and her utterance was choked.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2032009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"82a6f41d9e4a04c946404edc3d99ce855e1d74f0425d113bcf4c15a7dc3cc0bc","compact":"01893944efa11569b56e0cea16670ed8e3660fe1bc9b9aff97741347f56f74f3","nasal":"7091eb85557cdff43df10cc051d58af57446cb96bf5c284ae12ec68b102e7229"}},{"id":"VRCE-2-32-10","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":10,"english":"O righteous one, like to a liquor whose lees alone have been left, Bharata will not receive the kingdom tasteless and denuded of all substance.","alignment":{"type":"1:1","confidence":0.531,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2032010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"51a6de3d8a9a777c34baaf4f73fa6a4e409ed3d2068778b55d1fd53820521846","compact":"ef7ab81d5b2cf57a11bf73fa8ca56f78731e570ea39c3de3d43032fb9575c3dd","nasal":"1475c7f68eee0fde60b4ae5514033714d4b9efff883fea6c66a4e6a07a1b4a93"}},{"id":"VRCE-2-32-11","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":11,"english":"While the shameless Kaikeyi was speaking thus sternly, king Dasaratha said to that one of expansive eyes. O worker of mischief, why having laid the load upon me, do you torment me? O ignoble one, why did you not ask for this, when you did first solicit the boon?","alignment":{"type":"split","confidence":0.646,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-13","DUTT-2-36-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2032011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cc72e81a2e02b5bbc567dbf8594b9872792bdeb6dd9cfab654a1e02e0b7f9c4a","compact":"888086528b78c252118800e3b48d920f12ee007f92fefb88fed4da4014bdce5f","nasal":"44d89714b9704ef97e442dcf03b6cd5c987944146943c110e5cd307e84bab9a8"}},{"id":"VRCE-2-32-12","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":12,"english":"Hearing these wrathful words of the king, that beauteous one, Kaikeyi, waxing doubly wroth, addressed the monarch, saying. Even in this line of yours, Sagara deprived his eldest son Asamañja by name of the enjoyment of the kingdom. In this way this one deserves to go to the forest.","alignment":{"type":"split","confidence":0.521,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-15","DUTT-2-36-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2032012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bec6e4b9049d171e56052ab4e6dfe5d19f2f88e7fab3755ab31a08ea33211fa8","compact":"476b0436e32a7ea5860bda9d17f683ad3c7d189cf6e6115806112eb058125501","nasal":"9b730599f97941f86b1d7d9fdcd5da8a346d93ced79e70a3fb3698a17f915f5f"}},{"id":"VRCE-2-32-13","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":13,"english":"Thus addressed, king Dasaratha said, \"O fire!\" and all present were afflicted with shame: but Kaikeyi feigned not to understand all this.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2032013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"827e569c54965f6eee88763a5c4e404b374cc258fcbba22bdf7c02e1898b472f","compact":"c12aac79d42f0615b941d352dae1ddfa64ec365c9fd6a13ce7394d6c2fef0506","nasal":"5b09dea33ffb6800373b22a5ff1e839a31a548ff02a35a7f2b9fe16fdcf15875"}},{"id":"VRCE-2-32-14","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":14,"english":"Then a notable, aged, pure-spirited personage held in high esteem by the monarch, named Siddhartha, addressed Kaikeyi, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2032014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"88894b0084b553e33406678180f63fd676639e70ce262cce3e6530cbd2654caa","compact":"f680b89b1827cf2604a70f507d67ff27378f24aa075479821314902ad93d9eb2","nasal":"f680b89b1827cf2604a70f507d67ff27378f24aa075479821314902ad93d9eb2"}},{"id":"VRCE-2-32-15","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":15,"english":"Asamañja by way of sport catching people on the way, used to throw them into the waters of the Sarayū, and that wicked-minded wretch made merry over the same.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2032015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"97f956b0a6a434d589748e5a258f9381efc7df36d2db4445213661370c2cd5bf","compact":"14df483eaa078a98d91b57536c9e1364a63c97c65ef3f55c77ee104f44abc5c2","nasal":"16ade395a5439dc04a03f274b137474afe57217b75ca85d07c8d44f961327a85"}},{"id":"VRCE-2-32-16","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":16,"english":"Seeing him do so, the citizens in a body, waxing wroth spoke to the monarch, 'O enhancer of the kingdom's prosperity, do you either banish Asamañja or us.'","alignment":{"type":"1:1","confidence":0.676,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2032016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"60de27eb8f39feae41323a903cebc9bc7dc5b999dd313a3a91ab9cc4bc0b9d58","compact":"a511b889c17a011002ea694e353ad171b6ea14a1b7e60f7325454583427e24ad","nasal":"d6f3346b14660776feae8159cef1a2e439dac0fdc7c6ae9ad4682cf7f4598a79"}},{"id":"VRCE-2-32-17","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":17,"english":"To them he replied, 'Whence is this fear of yours?' Thus asked by the monarch, the subjects said.","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2032017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"61415b287fcecdb468a653e41c15bd67d391ce8fc9699d04d93541d557cabcc4","compact":"2df92aacf519795b86c28f9e63094c2f636311b452cc1d54bfcd54becdc01d88","nasal":"2df92aacf519795b86c28f9e63094c2f636311b452cc1d54bfcd54becdc01d88"}},{"id":"VRCE-2-32-18","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":18,"english":"“Through his impudence this one of perverted sense by way of diversion throwing our sons into the Sarayū, finds extreme delight.'","alignment":{"type":"1:1","confidence":0.568,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2032018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5194547b0e014b61b5efef265303ba61ba8aa397b666b7ca73ba09ec8b0e45df","compact":"0e46ed1926f1a2abaf633bed8797cfcc1283c5b706f643b390fb64efecb6042d","nasal":"8a81f1ead475a7fe8e7c37c7eb8cf05165b61f40ee28d51d46d24037dbc6482a"}},{"id":"VRCE-2-32-19","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":19,"english":"Hearing these words of his subjects, that lord of men, with the intention of doing good to them, forsook that mischievous son of his.","alignment":{"type":"1:1","confidence":0.892,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-23"],"status":"unreviewed"},"source":{"sanskritLocator":"2032019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb1beb199b61d66455e70695fddacf22d20700b25930e45f120468dcffd31b44","compact":"46969d9dec15d3204efe6089e02befb7b3ea329d057a772f4c6578d7032fb7bd","nasal":"46969d9dec15d3204efe6089e02befb7b3ea329d057a772f4c6578d7032fb7bd"}},{"id":"VRCE-2-32-20","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":20,"english":"Thereupon that worker of iniquity went to the forest and went about seeing mountain fastnesses. Thus did the virtuous king Sagara renounce his son. But what offence has Rāma committed that he is to be banished?","alignment":{"type":"1:1","confidence":0.772,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-25"],"status":"unreviewed"},"source":{"sanskritLocator":"2032020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ba0404f9850f5a76fec631f7e2822d640617a4f50e3368c27b8ece95414a2e49","compact":"39557fa29541432789f5da396dcb7578812e7fbe3a30523434ee7867cab6b0cc","nasal":"39557fa29541432789f5da396dcb7578812e7fbe3a30523434ee7867cab6b0cc"}},{"id":"VRCE-2-32-21","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":21,"english":"Hearing Siddhārtha's words, the king, his voice waxing exceedingly feeble, addressed Kaikeyī in words surcharged with emotion.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-29"],"status":"unreviewed"},"source":{"sanskritLocator":"2032021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d5a9e1700316a41a475c34fd58df9c7833cbebfc8e69bc92149044ce359785d5","compact":"3f07835c98369e36de792940bd3f129227a0cdd1f18efa4fd74b035c0c5bb91f","nasal":"8df51d0f41ea487b806568d0dbd835ce461504871668ce98fc0444932339e204"}},{"id":"VRCE-2-32-22","kanda":2,"kandaId":"ayodhya","sarga":32,"verse":22,"english":"Forsaking my kingdom, forsaking happiness and treasures, I will to-day follow Rāma. Do you with Bharata for the king, forever enjoy dominion according to your heart's desire.","alignment":{"type":"1:1","confidence":0.659,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-36-31"],"status":"unreviewed"},"source":{"sanskritLocator":"2032022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0cdd1d0747fc8d2c3ef8dc4839a444275a0e96100a398a60aae54158c1779ae7","compact":"4c3c6414db08fbb5f12723b2765dc83eaa2c78f73ee660cb0103f3ba695ca639","nasal":"77e761884d3c82faac71469efd4c5516e5731ae772e89855b84d4a1b7c24cc9f"}}]
