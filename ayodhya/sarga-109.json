2109014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ebd458d44827360afb167de2d3c28cf8572540b62cc9b512356b48a0d899d44e","compact":"32f02ecd1bf97c2754acd6a6d5ca80a2939b8b210c758badfb6d1e61223bd619","nasal":"32f02ecd1bf97c2754acd6a6d5ca80a2939b8b210c758badfb6d1e61223bd619"}},{"id":"VRCE-2-109-15","kanda":2,"kandaId":"ayodhya","sarga":109,"verse":15,"english":"O princess, you have heard what has been uttered by the ascetic. For the sake of your own welfare, do you speedily resort to the female anchoret. Do you without delay resort to the ascetic Anasuya, who is worthy of being associated with, and who has by virtue of her acts attained renown among men.f","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-117-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2109015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f8d54d661d6fb7b5b35cca39427c3343e3783ffa38777d47954b4a2c6e5a801","compact":"1ccd73e4372a23dbcd3627e9b9dd1b116796165ce6b04c82e3577de7b69ab52a","nasal":"1ccd73e4372a23dbcd3627e9b9dd1b116796165ce6b04c82e3577de7b69ab52a"}},{"id":"VRCE-2-109-16","kanda":2,"kandaId":"ayodhya","sarga":109,"verse":16,"english":"O princess, you have heard what has been uttered by the ascetic. For the sake of your own welfare, do you speedily resort to the female anchoret. Do you without delay resort to the ascetic Anasuya, who is worthy of being associated with, and who has by virtue of her acts attained renown among men.f","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-117-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2109016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19ce06aa994d6023b3c2151a0888cbab525e9f446ba5ddd7d7ea7c828514841a","compact":"b9e64bebab43a79a2d52efe80d5ee41df7a447f00fe777a6f9cca3395f3f