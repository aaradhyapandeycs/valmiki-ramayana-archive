m02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"35af6754c45c295a3ccde082c94af472ca3ecd2d9bcf8aa9e1ea080ce1397711","compact":"0e26bd4423f8eeb3fd45a984cdc03a875946d80445fd8b4dff6d2574b074c54f","nasal":"bcdcdd1b98ab25d3e3478e88426487bf616aa100f466cfdcd9dc028c57cb9798"}},{"id":"VRCE-2-99-18","kanda":2,"kandaId":"ayodhya","sarga":99,"verse":18,"english":"O Bharata, let the umbrella barring out the rays of the sun, afford cool shade to your head: I shall happily seek the dense shade of these forest trees.","alignment":{"type":"1:1","confidence":0.71,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-107-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2099018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5d7e264f913945a9e6adb4fcea339c781595b87e2d15b73d7cce1a063da73bb7","compact":"355bded715e9ce8df70eb45e2528e0e2a5fe66e1d90e7a4a45e3c87dc7e6f8ed","nasal":"355bded715e9ce8df70eb45e2528e0e2a5fe66e1d90e7a4a45e3c87dc7e6f8ed"}},{"id":"VRCE-2-99-19","kanda":2,"kandaId":"ayodhya","sarga":99,"verse":19,"english":"Śatrughna endued with cleverness is your helper: Sumitrā's son is well known as my best friend. We four worthy sons of that foremost of monarchs will keep him established in truth, O Bharata. Let not your mind despond.","alignment":{"type":"1:1","confidence":0.772,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-107-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2099019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"773cb48cb936a5dc88bb29aee371e9f266b9434d9028ce6aca9f88ff66a94eb1","compact":"eaa97527b98d64bbc852b0d837cd6fba4bc4f11d815f98f7784155e4b4291004","nasal":"a9bd54b12d8be0acc94a1c576e5cb2154434936b648b812393d5391882ce9a6f"}}]
