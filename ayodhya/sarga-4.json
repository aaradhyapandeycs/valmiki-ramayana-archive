[{"id":"VRCE-2-4-1","kanda":2,"kandaId":"ayodhya","sarga":4,"verse":1,"english":"When the citizens had gone away, the king versed in the time and place of ceremonies, after deliberating with his counsellors fixed the time (of the installation.) And his conclusion was even this: \"To-morrow the Pusya will be in; and to-morrow should my son, Rāma of eyes like lotus-leaves be installed as heir-apparent.\"","alignment":{"type":"grouped","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-4-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2004001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3eef5f5ce8cc35a59d3c902870db5588462898ba6f5f51c3f633f214728e3b0b","compact":"95eb7801d7f4791eecea204a5417324234940fb6b6c27e08d12a06a4e2e20bff","nasal":"5b09922ff91595b412f561ef0f77fe7893be2609dbff2f85b38f1d4e029014c3"}},{"id":"VRCE-2-4-2","kanda":2,"kandaId":"ayodhya","sarga":4,"verse":2,"english":"When the citizens had gone away, the king versed in the time and place of ceremonies, after deliberating with his counsellors fixed the time (of the installation.) And his conclusion was even this: \"To-morrow the Pusya will be in; and to-morrow should my son, Rāma of eyes like lotus-leaves be installed as heir-apparent.\"","alignment":{"type":"grouped","confidence":0.484,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-4-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2004002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5bdb465befa3ce1583a99445f220d6e32fa5c874237ff9ce8688eec650df8f1a","compact":"733c8564fb477eecc6b9c832e1c006cb852ee2f37fb680e7bba51e02492626f2","nasal":"733c8564fb477eecc6b9c832e1c006cb852ee2f37fb680e7bba51e02492626f2"}},{"id":"VRCE-2-4-3","kanda":2,"kandaId":"ayodhya","sarga":4,"verse":3,"english":"Then entering the inner apartment king Dasaratha said to the charioteer Sumantra, \"Do you again bring Rāma here.'","alignment":{