":"9e5c453b259c0ba32b0ffc7b9694e7dcc5bd319d797542ceaff5d626d6f5ae48","compact":"c81680280501bb26c4f486c5cbb3eb6c2b65f3eb5e926eea08c66e73a166d964","nasal":"0dd276bb281b84f4d32e6420b281ddb7eafa80775f0cad0da925bd1148a227c7"}},{"id":"VRCE-2-4-45","kanda":2,"kandaId":"ayodhya","sarga":4,"verse":45,"english":"Having said this to Lakşmaņa, and paid reverence to his mother, Rāma with their permission went with Sītā to his own quarters.","alignment":{"type":"1:1","confidence":0.769,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-4-37"],"status":"unreviewed"},"source":{"sanskritLocator":"2004045","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"093631be8fbcfcbf239868bcb556bbce3706413f1df0fd0f7300b685e4f1d755","compact":"3752bbdcd9dc40ddacf3010fdab3ea46d84bc80529897290f77c147615526e6d","nasal":"3752bbdcd9dc40ddacf3010fdab3ea46d84bc80529897290f77c147615526e6d"}}]
