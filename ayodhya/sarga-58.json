91–94"},"sanskrit_fingerprints":{"exact":"62104995626eea96b8ee6b62b6e8f5e331839550a3183a142fc99ecc80d6c5ae","compact":"889d77653ccf46f4b7064a5249f3e1947109ee6ea6e956dd7bdf648bd3ad16da","nasal":"bf5880766a8aafb8812e3934c82c22a3a018e23d1858880896c0ece73d2a1d92"}},{"id":"VRCE-2-58-31","kanda":2,"kandaId":"ayodhya","sarga":58,"verse":31,"english":"Do you stay my son, in my behalf. Tomorrow you will go to Yama's mansion with me and your mother.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-64-32"],"status":"unreviewed"},"source":{"sanskritLocator":"2058031","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a300eab51d7b80313a69c678eb385e838dd31ac819ad7c3d4f34532e5586149f","compact":"c6770199ddff42b398099bcea20497e76c6b8eed17db5bb19bea9c8f61dfd442","nasal":"46ee3b5fb0fa7f7d734f50f6f57ef056e20f195e49efbda24d0147aef4370fc4"}},{"id":"VRCE-2-58-32","kanda":2,"kandaId":"ayodhya","sarga":58,"verse":32,"english":"Distressed with grief and rendered miserable in the forest, both of us deprived of you shall soon repair to the abode of Yama.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-64-33"],"status":"unreviewed"},"source":{"sanskritLocator":"2058032","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac99f6478046f498a72d31d2a8669ac47584e25b346495dbb246aa8423231594","compact":"a8b3a85999186cba500fd774837923afa2dbffdf395518caff1adc0ee477b830","nasal":"a8b3a85999186cba500fd774837923afa2dbffdf395518caff1adc0ee477b830"}},{"id":"VRCE-2-58-33","kanda":2,"kandaId":"ayodhya","sarga":58,"verse":33,"english":"Seeing Vivasvata's son, I will say to him, Do you, O lord of justice forgive me, and let this my son, continue to maintain us, his parents.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-64-34"],"status":"unreviewed"},"source":{"sanskritLocator":"2058033","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2389c65d09c6dd58683f864285b3a8ea58370486495e08a524f0e9e93dd01d65","compact":"7cefdc746189402e9a1a2315a30a457cab5f1dc96698aacd212eb9e7e4a4afb6","nasal":"7cefdc746189402e9a1a2315a30a457cab5f1dc96698aacd212eb9e7e4a4afb6"}},{"id":"VRCE-2-58-34","kanda":2,"kandaId":"ayodhya","sarga":58,"verse":34,"english":"You, my son, are sinless, although slain by this one who has done an unrighteous act; and by the force of this truth , do you repair to the world of warriors. Do you, O son, go the supreme way that is gone by heroes who without turning back from the fight, are slain in open encounter.","alignment":{"type":"grouped","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-64-36"],"status":"unreviewed"},"source":{"sanskritLocator":"2058034","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c3989dac78134b4315fd65e2541a60569b95886a2be69dbaf18ad66d6ec50e6","compact":"bc102de4096db8840614d10934642bc8e3f6aba3ed94cb2007f4812a3fef2c57","nasal":"bc102de4096db8840614d10934642bc8e3f6aba3ed94cb2007f4812a3fef2c57"}},{"id":"VRCE-2-58-35","kanda":2,"kandaId":"ayodhya","sarga":58,"verse":35,"english":"You, my son, are sinless, although slain by this one who has done an unrighteous act; and by the force of this truth , do you repair to the world of warriors. Do you, O son, go the supreme way that is gone by heroes who without turning back from the fight, are slain in open encounter.","alignment":{"type":"grouped","confidence":0.791,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-64-36"],"status":"unreviewed"},"source":{"sanskritLocator":"2058035","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de2872a7ec722dcae157f7b4af02438ddf959152a94d33a796af45eae4214693","compact":"14d2397dce0b381db20f432f6d25d8a0445a0ed937d81f6389713c38353f87be","nasal":"1562322