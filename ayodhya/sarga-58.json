s":["DUTT-2-64-64","DUTT-2-64-66"],"status":"unreviewed"},"source":{"sanskritLocator":"2058056","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eb5d543e9293bc7bbf2b461d79693f651641991605fbc4994387ef3ef22390ef","compact":"57177ca5a67d1631926cfad7557aa9df9f213a66077d8213a4031d1e78294706","nasal":"d87b636307c121016115bc49645015a1b1410dc09aacc587c25b9eae5e4214e2"}},{"id":"VRCE-2-58-57","kanda":2,"kandaId":"ayodhya","sarga":58,"verse":57,"english":"Thus that distressed lord of men, smitten with 1e exile of his beloved son, that one possessed fa gracious presence, when the night had been alf spent, wrought up with the violence of his notion, departed this life.","alignment":{"type":"1:1","confidence":0.562,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-64-67"],"status":"unreviewed"},"source":{"sanskritLocator":"2058057","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4aa553e74c8368430333fd6fae85e1526fccd9dd70ab5fea7d7a76fc7fb3400","compact":"0115263219167acca8dd0c4bccdb83eae79745a5be756ecedc8867dd840141ec","nasal":"0303a675a6783301ccaa409a2b0c50b6ccfbaec3edd07117f6caba0fe1d16da3"}}]
