[{"id":"VRCE-2-21-1","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":1,"english":"Seeing Räma determined upon carrying out his father's behest's, Kausalya with her voice choked with vapour begot of tears, spoke to him the following pious words.","alignment":{"type":"1:1","confidence":0.824,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2021001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ef8d03d51253b8fc1900c9299530addac2b9cd88028d0d6d0ef183fb5cabba6","compact":"ff56afa06e63ea1081f116e0a121b0c98e95ff4a92b04f815e5a3c07aa1c5027","nasal":"ff56afa06e63ea1081f116e0a121b0c98e95ff4a92b04f815e5a3c07aa1c5027"}},{"id":"VRCE-2-21-2","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":2,"english":"How shall this virtuous-souled one, beloved of people and who has never experienced misfortune before, live on grains gleaned, being born of me to Dasaratha?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2021002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f9df6380347c2b3219e3aa3f170a0886b7cbfef6c12af48f11d1a79a9514ab58","compact":"884466b9a671bb527d8b60316c4695fa07c01d76db5176a5facb027c681488ea","nasal":"236ff5ca19e11cfdd05631c311d60f519c617f92b2da4ec70d2837df88625cb0"}},{"id":"VRCE-2-21-3","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":3,"english":"How shall that Rāma live upon fruits and roots, whose servants and attendants fare on well cooked rice?","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2021003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"169499aede2524a333b26d4cae841a638e40e966a006dd6070951b41e0074b65","compact":"0927e02735fb4729d385267d471246f86d569ee74adf7ca217bc7627edfa569f","nasal":"338899493d9ad41b1e96218b75cb181602d28cf185d86909cb9d193f349ce352"}},{"id":"VRCE-2-21-4","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":4,"english":"Who shall believe, or believing who shall not be afraid, that his highly accomplished descendant of Kākutstha, favourite of the king, is going to be exiled?","alignment":{"type":"1:1","confidence":0.821,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2021004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2dad1e17a72bcd6b59d4a7e388106487946576239511e10747b70840159b0b57","compact":"43ee94b840e7a85a54cf58786bd7d26d8bb62d1c02eadbd68fd4a4ca2bf6f7dc","nasal":"77005ba4306227a5eb5cdd2e06eccbaa3c8e17de32566f6dbca32984130ce5b9"}},{"id":"VRCE-2-21-5","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":5,"english":"This great and incomparable fire of sorrow issuing from my mind, inflamed by the wind of your absence, increased by the fuels of lamentation and pain, and kindled by hard sobs, obtaining the oblations of tears, vomiting the smoke of vapour begotten of anxious thoughts, the result of counting upon the days of your return, shall consume me, making greatly lean, when deprived of your presence, as does the fire burn the dry grass in summer.","alignment":{"type":"1:1","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2021005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4df3a1a6b592265599c1e63b3d1b156361fef34658716dcbcc8db54334fa630a","compact":"cca90e3459adf1d5cb8f05fb23bb71b2ef9793d353d351da34488d69d19a8640","nasal":"cca90e3459adf1d5cb8f05fb23bb71b2ef9793d353d351da34488d69d19a8640"}},{"id":"VRCE-2-21-6","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":6,"english":"Like to a cow following its young one shall I follow you, Oh my darling, wherever shall go.","alignment":{"type":"1:1","confidence":0.662,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2021006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c9e9956384e0697f61bcaa9141348c31e610b917f952e931310460535bc477c5","compact":"77192c902a5178f3b83325774084ee49b2e5094676d87d81fd80c27c4872f65e","nasal":"b185d5e8aaae4c2b1a6f3779bbd8202f2a3f3b20349f33013b515041dc4cf58f"}},{"id":"VRCE-2-21-7","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":7,"english":"Hearing those words of his mother, Rāma that best of men, spoke the following words to her, who was greatly troubled with sorrow.","alignment":{"type":"1:1","confidence":0.986,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2021007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"57a7d1b3b148f3d0d21c03a7aae895d95f234b4b2cee06d23519f84af0d24fc8","compact":"761bb7088f6c433194ab68e39b3f104cb4d3a20999487db1932be76457c3c24f","nasal":"761bb7088f6c433194ab68e39b3f104cb4d3a20999487db1932be76457c3c24f"}},{"id":"VRCE-2-21-8","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":8,"english":"\"The monarch has been duped by Kaikeyi” myself resorting to the forest, surely shall he resign his life, if cast off again by you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2021008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7ad6c38da265c1de0ae75ccc25ba41199ff2586cdd4b86addfcb7843cd4098e","compact":"fc980fac8764bc22b386ffa55974618facc3f15ec97fa9e9f5a18e35c6b125c6","nasal":"61956f4f388f14f4c55c2578e54d23911143dd060ca47f43201fe4619ab7b67a"}},{"id":"VRCE-2-21-9","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":9,"english":"There is nothing more cruel for women than the forsaking of their husband; it does not behove you therefore, to think even of this opprobrious action.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2021009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e6281e900967ea3b08a8bc87ab103cae1cbb8b591f02cf9e769210015752729e","compact":"53b2d7291fe799c46417f9ba1cbafacf0357dfc0f667b4b646e1b06caad4a1ab","nasal":"53b2d7291fe799c46417f9ba1cbafacf0357dfc0f667b4b646e1b06caad4a1ab"}},{"id":"VRCE-2-21-10","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":10,"english":"Do you serve this descendant of Kākutstha, my father, and the lord of the earth as long as he lives, know you this to be the eternal virtue","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2021010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"57e7572f7fe51e50343c45997a8d3ee75313103d6ce36b6bbc8ed80078e09342","compact":"0ff3136a7d9240b96fb581c97e4d39bd2a5b52ddbf313f9a031714d926495c50","nasal":"0ff3136a7d9240b96fb581c97e4d39bd2a5b52ddbf313f9a031714d926495c50"}},{"id":"VRCE-2-21-11","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":11,"english":"Thus addressed by Rāma, Kausalyā of auspicious looks, being gratified greatly, spoke to him, the remover of her sorrows. “Truely it is.\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-12"],"status":"unreviewed"},"source":{"sanskritLocator":"2021011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"76184b1e81b896699f24c000823273df1c93cf71164b8800c0f6f9a992e148e0","compact":"e5d4cc8437a573a0c6852ab1b897bfcb290318c67dc080e67f12dfd7c3e14ac5","nasal":"e5d4cc8437a573a0c6852ab1b897bfcb290318c67dc080e67f12dfd7c3e14ac5"}},{"id":"VRCE-2-21-12","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":12,"english":"Rāma, the foremost amongst religious men, being spoken thus, said to his mother, who was greatly disturbed with sorrow, again in the following strain.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-13"],"status":"unreviewed"},"source":{"sanskritLocator":"2021012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1bbfa4ac3ba9e29cfc597cbbdce772bd3e0fb0a7c80228a695bdb3647978579f","compact":"3f220fb88de5b28f54dc1bfb0edf44f8e936a5e35719e2c3f2a3ca149f797c1c","nasal":"3f220fb88de5b28f54dc1bfb0edf44f8e936a5e35719e2c3f2a3ca149f797c1c"}},{"id":"VRCE-2-21-13","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":13,"english":"“Proper it is both for you and me to carry out father's words” he is your husband, and my best preceptor and the lord and master of all people.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2021013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9c89e660a23b7eb9414a7931fc44ea0466040d35ca8e99d2fc1e04b68e073845","compact":"4371da5ff706391f18f3a5aeb492b242f0eec7de9d2295e39fd22a61daa6b76e","nasal":"4371da5ff706391f18f3a5aeb492b242f0eec7de9d2295e39fd22a61daa6b76e"}},{"id":"VRCE-2-21-14","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":14,"english":"With great pleasure shall I abide in your words after passing these nine and five years in the great forest.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2021014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3425cb899fb04e6969cfd23b490351b6b1957d88475d6f20791a3eb25d5cbfb","compact":"dade27ae7d808b12d420b47e642edb23c4bef052692b2aaff7e20f2edf68f72c","nasal":"0e516680ff5445a71b20c002b0f533f6c20d56d5f7ccfb2f53414041225d5e0d"}},{"id":"VRCE-2-21-15","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":15,"english":"Thus addressed, Kausalyā, bearing great affection for her son, sorely pained and having her eyes full of tears, spoke to her beloved son the following words.","alignment":{"type":"1:1","confidence":0.823,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2021015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"63030ada1d53a6210dcd8aff5c74413fe706a0e94fca4e122c4e89549eb36bbc","compact":"e9804c48e590f4f4ec3923abe084edb3c12c2f05d78f76acecd19d124847def7","nasal":"e9804c48e590f4f4ec3923abe084edb3c12c2f05d78f76acecd19d124847def7"}},{"id":"VRCE-2-21-16","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":16,"english":"Oh Rāma, I shall not be able to live amongst these co-wives, if are you resolved to go to the forest for the discharge of your father's behest; do you take me with you, Oh Kākutstha, like to a wild hind.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2021016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4ddbd3584ce834d47d5fa3e7310e134671ac48882002b05696c5ab2b8fe8e176","compact":"35a1ab1327aa8d0bbdfed1cd4e768dd0dcd4b8bc9b1926748c32d9840407370e","nasal":"35a1ab1327aa8d0bbdfed1cd4e768dd0dcd4b8bc9b1926748c32d9840407370e"}},{"id":"VRCE-2-21-17","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":17,"english":"Rāma, suppressing his feeling, spoke to his mother who was lamenting, thus, saying:, Husband is the deity and master of the wife as long as she lives; so the monarch being the lord can deal with you and me in any way he likes.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2021017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9109bbcd4866259f5e1e35764a8fab49e984d840fe1f9f98ac5f90fc284a9af8","compact":"1e612ba3c79a7b07d3ea52e2d351c628b545752a8fba2827e36a51ddd0486a34","nasal":"d1ce722c0a04fd24e654ccf3bb3bf74bcb12d19f789f221cb2c8eaa61d6e3109"}},{"id":"VRCE-2-21-18","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":18,"english":"That highly intelligent lord of men living, we should not consider ourselves as without a master. Bharata is also pious and beloved of all people in speech, he, intent on the performance of religious service, shall attend upon you always.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2021018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"81b8071ea8e2c12e483d2dd851f1bafabe57b6dc92906ab56d4a9aa6bf9268f8","compact":"1e03ed2f18d5b8fb70379b940d465eb97f7fcdc52e5987808a4d4bca5985c4fc","nasal":"1e03ed2f18d5b8fb70379b940d465eb97f7fcdc52e5987808a4d4bca5985c4fc"}},{"id":"VRCE-2-21-19","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":19,"english":"Do you now take care that on my retiring the monarch does not wear away by the pangs of my separation, that this terrible sorrow may not kill him. Do you look after the welfare of the old king always.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2021019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0372c767ea4569690101cabef09fac2983e16efdb117ed7f48a6b5a881fd21e","compact":"017fa6dd704ad5a17972d0d8a6a7fc92c054697e57c3a8ab738c79412b958777","nasal":"dc47e416a7dfe5314a08b676759df66422b5bd58b97938cd9570914a05452d57"}},{"id":"VRCE-2-21-20","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":20,"english":"The woman, who serves not her husband, being engaged in excellent religious rites and fasts, shall fare wretchedly in the life to come; and a woman gets at the excellent abode of the celestials by serving her husband.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2021020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"546d276886078bf686a5c1799d7c5d9334cce377bf6810d62c8ccca5b6bef18a","compact":"b0aa03104fe5b12746c2ff6be72b10c12df0d2904d7023428d046987c0120658","nasal":"b0aa03104fe5b12746c2ff6be72b10c12df0d2904d7023428d046987c0120658"}},{"id":"VRCE-2-21-21","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":21,"english":"Even those who do not worship and bow to the celestials should serve their husbands alone being intent upon their welfare. Such is the virtue that should be always pursued by women according to the Vedas and Smſtis.","alignment":{"type":"1:1","confidence":0.523,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2021021","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"facbf207952e6698473ab993d8c83fdbe68fbd58593ea7607a3da5c5dba45e13","compact":"882f5ba68babd18a37a4d9b01c18d578a0bd9e9e21fcbc1a7f6f7bb18ba231ec","nasal":"882f5ba68babd18a37a4d9b01c18d578a0bd9e9e21fcbc1a7f6f7bb18ba231ec"}},{"id":"VRCE-2-21-22","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":22,"english":"Do you beguile your time, Oh worshipful one, expecting my return, by worshipping the celestials with flowers and oblations to the fire and serving well the Brahmins. Engaged in discipline and fasting and devoted to the services of your husband you shall attain your best desire, on my return, if this foremost of pious men lives then.","alignment":{"type":"split","confidence":0.414,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-23","DUTT-2-24-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2021022","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7721fa852d437731de2f3ae7d72d5ea0f3e534b5799e46f4c16e956fcd6c2141","compact":"714f3cd4629922f216f469212637812dc99d07c0193c47170ba572165acbb4bd","nasal":"7c6319608061b3f72caf7b0236593aecf415ee1777ec958bbec435e29a6f9265"}},{"id":"VRCE-2-21-23","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":23,"english":"Engaged in discipline and fasting and devoted to the services of your husband you shall attain your best desire, on my return, if this foremost of pious men lives then.","alignment":{"type":"grouped","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2021023","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"283cc9a7144a203044fe63cfe4ca6027ad277ac2142a35470b589a8fc1689cbd","compact":"75eb6a1f811131492e6b2e0a600997350314981a18f1620a1ec1051a4aef0147","nasal":"75eb6a1f811131492e6b2e0a600997350314981a18f1620a1ec1051a4aef0147"}},{"id":"VRCE-2-21-24","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":24,"english":"Being thus accosted by Rāma, Kausalyā being distressed with the thought of separation from her son, spoke to him with tears in her eyes the following words. Go you my son, with an earnest heart; may you fare well; my anxiety shall be removed on your return.","alignment":{"type":"split","confidence":0.62,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-25","DUTT-2-24-27"],"status":"unreviewed"},"source":{"sanskritLocator":"2021024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"23dad7b4816d2be63c9a97f55ced8c140906b853f2d2dce40c79704cdeb8b9a9","compact":"da67586c46ea150c2d0f95347ee89f599a43a0c67d25c6b159247c010e5dc0fe","nasal":"da67586c46ea150c2d0f95347ee89f599a43a0c67d25c6b159247c010e5dc0fe"}},{"id":"VRCE-2-21-25","kanda":2,"kandaId":"ayodhya","sarga":21,"verse":25,"english":"With great earnestness, the worshipful one began to eye Rāma, determined to go as an exile to the forest and spoke to his auspicious words and became desirous of performing benedictory ceremonies.","alignment":{"type":"1:1","confidence":0.635,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-24-32"],"status":"unreviewed"},"source":{"sanskritLocator":"2021025","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"10a0a6bd62fe57bb721cb332501124a295c60a5137a4b84f5b1eddcec8f448ce","compact":"047378d7828d7381fa27688e621e91e15a81b6b283a69424c7e3d74d33eb97ad","nasal":"ffe82b56819785f8237f596c36c595eede15d793cbaf4a70340b79dca59c3b19"}}]
