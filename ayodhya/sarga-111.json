[{"id":"VRCE-2-111-1","kanda":2,"kandaId":"ayodhya","sarga":111,"verse":1,"english":"Having heard this grand story, Anasāyā cognizant of righteousness, smelling the head of Mithilā's daughter, embraced Sītā with her arms.","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-119-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2111001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"edb6d498702dd226f832fb39ec705f742094a342c1e04656fdea71e4a79ae3b8","compact":"e159cdec346545f294a17368269f4da6ee5fd974e3895e42dafb0fd511936a28","nasal":"9d0174e28d482327f79c3a3f4cfba2d094592c3c2c4f648b7c4d4f989bd07343"}},{"id":"VRCE-2-111-2","kanda":2,"kandaId":"ayodhya","sarga":111,"verse":2,"english":"I have heard all that you, describing the selfchoice, have spoken sweetly and beautifully in articulated letters and feet.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-119-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2111002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a61e3d1840bc03e15180b328dd5b9705d7a0165d772789678839433f38077e93","compact":"4e37fcc8c7d9f3fae9637e1a22ee8ad34fc8b9f20eadc5a02171412d6c763462","nasal":"4e37fcc8c7d9f3fae9637e1a22ee8ad34fc8b9f20eadc5a02171412d6c763462"}},{"id":"VRCE-2-111-3","kanda":2,"kandaId":"ayodhya","sarga":111,"verse":3,"english":"O sweet-speeched one, I have been delighted with your narration. But ushering in the auspicious night, the graceful Sun has set. And there are heard the notes of feathered ones, which, after having gone about in search of food, are resting now for the purpose of sleeping.","alignment":{"type":"grouped","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-119-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2111003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"s