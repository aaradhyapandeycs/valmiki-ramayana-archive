ition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6820f27f634d3009f3d9d4f78caf014c47e0b3de0e52e917b5ec9d3c538479bb","compact":"7b7d3beef4f3f9d35411e69f4349c6de7feca8f4d17ed252c7c166d184ba3069","nasal":"7b7d3beef4f3f9d35411e69f4349c6de7feca8f4d17ed252c7c166d184ba3069"}},{"id":"VRCE-2-111-18","kanda":2,"kandaId":"ayodhya","sarga":111,"verse":18,"english":"Thereat the righteous ascetics ranging the forest said that all the sides of the forest were infested by Rākşasas. “Ferocious beasts feasting on blood, and Rākşasas, O Rāghava, living on human beings, wearing various shapes, abide in this mighty forest.\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-119-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2111018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d20c594e8f0aa8d2b7cf545fd62f5b72f041687b52e28d980ed6f45c9cdd3fc","compact":"72cc612b1594937968a5b03f93cd72a015f224e197fa4b15c40252cfe2f68856","nasal":"72cc612b1594937968a5b03f93cd72a015f224e197fa4b15c40252cfe2f68856"}},{"id":"VRCE-2-111-19","kanda":2,"kandaId":"ayodhya","sarga":111,"verse":19,"english":"This is the path of the Maharșis, who procure fruits in the forest. By this way you will be able to enter the impracticable wild, O Rāghava.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-119-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2111019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a59dd9c5e1d664007520fb387229f239ee069ad67dcd1952fad97b26b04ac1e5","compact":"1f0c5da70c8d314e362075a79878cbedc54b5bca31c4403c9da8bc028bc09963","nasal":"fb0550a80ec89ff5daba2755bb202f6dbc5a957f2b65f62b0f97524bb6ec0a6e"}},{"id":"VRCE-2-111-20","kanda":2,"kandaId":"ayodhya","sarga":111,"verse":20,"english":"Thus addressed by the ascetic twice-born ones, and having been blessed by them, that rep