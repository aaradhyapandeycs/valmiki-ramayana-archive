91–94"},"sanskrit_fingerprints":{"exact":"95ad44eb0349870f55210e0b42d5fbab35fe9705f9bbfadc0ccadff8a4f8c59c","compact":"3e1efc46078115bef62e902b735388595bcb0cbe4ca43eff638aa0172376b51e","nasal":"3e1efc46078115bef62e902b735388595bcb0cbe4ca43eff638aa0172376b51e"}},{"id":"VRCE-2-94-15","kanda":2,"kandaId":"ayodhya","sarga":94,"verse":15,"english":"Do the (auxiliary) kings know only those acts of yours that have been accomplished or those that are well nigh so, and not those that you intend to set yours hand to?","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-100-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2094015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e39be37678fd12d4ce68adf62ba7b3c31c69988d16e9631796c39aeb65169fc","compact":"da9aad703bd81f218cef82574cb8831d02362135a4f7c0d4664b880d2f96b1ab","nasal":"da9aad703bd81f218cef82574cb8831d02362135a4f7c0d4664b880d2f96b1ab"}},{"id":"VRCE-2-94-16","kanda":2,"kandaId":"ayodhya","sarga":94,"verse":16,"english":"Do others through inference or appearances come at a knowledge of your counsels, although undivulged to others by yourself or your counsellors; and (do you and your ministers) attain to a knowledge of others' counsels?","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-100-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2094016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85429c02bb873b4e6ab919a455e20d8031782073356e5f92f78516cc5c780c14","compact":"83cc14b41d4fa3d23f7afd26e3ee93345219194f479960793ec29bddc3546750","nasal":"9572eadb3b0fa99d6c829237f2108d9946d63ddfb849f62d2dc859ba20f5b64a"}},{"id":"VRCE-2-94-17","kanda":2,"kandaId":"ayodhya","sarga":94,"verse":17,"english":"And passing by a thousand dunces, do you set your heart on having a single wise man? In times of pecuniary stress, a wise man stands in excellent stead.","alignment":{"type":"1:1","confidence":0.671,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-100-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2094017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b5bea9d02748612d9d4b113c28858b0075a0eeb8cc8c85feabb19e4f49b6014","compact":"de38d67e63054d52face764307a67be1b97b9ada00aabb7ee11f7bbd2b4c70d8","nasal":"fddc3db5cd476a98b658e3183a25e202d6eb1cac9fd3684caf1870e510782b61"}},{"id":"VRCE-2-94-18","kanda":2,"kandaId":"ayodhya","sarga":94,"verse":18,"english":"And although a king might be surrounded by a thousand or ten thousand fools, yet he can count upon no assistance (at their hands).","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-100-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2094018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9febd3aad2a76fd31157f63f5f44feb55ebdf469253bc7f94338762bcd1abf8a","compact":"d30a578328759f30ee7e772e5ddaf68acca62d920d72a67b0e377e1e32abc0cd","nasal":"d30a578328759f30ee7e772e5ddaf68acca62d920d72a67b0e377e1e32abc0cd"}},{"id":"VRCE-2-94-19","kanda":2,"kandaId":"ayodhya","sarga":94,"verse":19,"english":"And a single able counsellor, intelligent, heroic, and sagacious, bring great prosperity upon a king or a prince.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-100-22"],"status":"unreviewed"},"source":{"sanskritLocator":"2094019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"461136b5f91eb9be16d3d485d489c24566c0c1a488af88566c34704f9943fae1","compact":"a657b2e11699e239116e8e8738493c37c433e14aa2e5b0ed8189d6ed2e17e141","nasal":"a657b2e11699e239116e8e8738493c37c433e14aa2e5b0ed8189d6ed2e17e141"}},{"id":"VRCE-2-94-20","kanda":2,"kandaId":"ayodhya","sarga":94,"verse":20,"english":"And, 