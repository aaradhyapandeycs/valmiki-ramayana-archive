. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6dfd7aa2dd0225c0f5ab288786638bf90a92d0e6113a41ab5a0f4bb44782b69b","compact":"286d3c8f38174d75f12c0a7f2a550daf3f6a3a0d8e65290dd2dafbb50a08499a","nasal":"6da357acbcb6c67a514212e72ff0c580103984228391ee54c4f57de3ff7925cc"}},{"id":"VRCE-2-64-24","kanda":2,"kandaId":"ayodhya","sarga":64,"verse":24,"english":"Protected by the forces and the courtiers of his maternal grandfather dear to him like his ownself, the magnanimous Bharata who had his foes removed, taking with him his brother, Śatrughna, departed from the abode (of the king), like Siddha issuing from the regions of Indra.","alignment":{"type":"1:1","confidence":0.544,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-70-30"],"status":"unreviewed"},"source":{"sanskritLocator":"2064024","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4239bed761e64b5bc64930494199eccbc82ecf2b7be9f07e354de3aa571e285e","compact":"99457fa18d09d714fc31512501c6ec99e3ab20d608a530b3a3e9bb026e74fa54","nasal":"92336d8f625828c844af38528bd2cbc32ba6537cc3b567f86f065a95b3c67890"}}]
