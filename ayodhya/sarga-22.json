[{"id":"VRCE-2-22-1","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":1,"english":"Kausalyā subduing her sorrow, and touching holy water, began to perform auspicious ceremonies for Rāma, and spoke to him saying Do you, Oh best amongst the descendants of Raghu, repair now, as I cannot dissuade you, but do you return speedily and, follow the footsteps of great ones.","alignment":{"type":"1:1","confidence":0.942,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2022001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fda70d718fcd3f6ca50183ff5a77bb67d35f08f0075b8033bad19c42651149cc","compact":"7f8ee1d808f7c59fbb8817130b6d75158995266ce80beeef1ed650dfbf420c24","nasal":"635478104af614aff9ce140e66eccf6bd699caaeba33ceecdcba490bdb659030"}},{"id":"VRCE-2-22-2","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":2,"english":"Oh best of men, may Sādhya, Viśvedeva, Marut, the great ascetics, the sustainer, and the preserver of the creation, Pūşan, Bhaga, Aryamā, Lokapālas, headed by Indra and others, the six seasons, the months, day, night, moments Srutis, Smrtis, and virtue protect you, Oh my son, on all sides.","alignment":{"type":"grouped","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2022002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0bd23d638485d418f8d7ee803db1d1f7bf577d76f2cd6646e6b657510901c97","compact":"a4ecb1bca87de66ec90b13e3a7f11c69df7c201e4ac536980deb7af5e173722f","nasal":"a4ecb1bca87de66ec90b13e3a7f11c69df7c201e4ac536980deb7af5e173722f"}},{"id":"VRCE-2-22-3","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":3,"english":"Oh best of men, may Sādhya, Viśvedeva, Marut, the great ascetics, the sustainer, and the preserver of the creation, Pūşan, Bhaga, Aryamā, Lokapālas, headed by Indra and others, the six seasons, the months, day, night, moments Srutis, Smrtis, and virtue protect you, Oh my son, on all sides.","alignment":{"type":"grouped","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2022003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2ff18294632ebe83a73874ec2ab70eb4160550b7367238e8a916fcf8b22d4815","compact":"9ef828eac96f7b7d5997de8f8dba7511cd8829a766b4ac0a932428013b94b38e","nasal":"6f9ee86ff048546cdad725efb8656760ef6e6f006fd83de84cac6b27438ab883"}},{"id":"VRCE-2-22-4","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":4,"english":"Oh best of men, may Sādhya, Viśvedeva, Marut, the great ascetics, the sustainer, and the preserver of the creation, Pūşan, Bhaga, Aryamā, Lokapālas, headed by Indra and others, the six seasons, the months, day, night, moments Srutis, Smrtis, and virtue protect you, Oh my son, on all sides. May the great deity Skanda, Soma, Brhaspati, Saptarsi, Narada, Moon and other ascetics protect you.","alignment":{"type":"split","confidence":0.389,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-7","DUTT-2-25-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2022004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"74b438ab8d7ad82f892c8b2829176184a43c5d4835c2db5f098de06e72b50f99","compact":"08fe23d9896a5801150de6698825c82df4ac697db325efae0d281ebc9c01c4d6","nasal":"8cd229a1a478e728d7b286787163b401a2f523f9e617c3a14faefb62e7cd49fd"}},{"id":"VRCE-2-22-5","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":5,"english":"May the great deity Skanda, Soma, Brhaspati, Saptarsi, Narada, Moon and other ascetics protect you. May the encircled regions with their lords, being pleased with my eulogy, protect you, Oh my son, always in the forest, When shall you repair to the wood, may the mountains, oceans, Varuna, the heaven, sky, earth, air, things movable and immovable, planets and stars with their presiding deities, day, night, and evening protect you.","alignment":{"type":"split","confidence":0.33,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-8","DUTT-2-25-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2022005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"544d9dfcd5968efd49ed32488fe7c27240e4149ce2197c0686ca8a1cd8a191bf","compact":"aa3ba9bdce3443cb40b0c618a20abbc00832bf09ed9460fb1d4602822f92eab6","nasal":"8a2f84ffaddedcd7d693eb1b42c8e482ced19d025a1ba770e73aaa779180a73f"}},{"id":"VRCE-2-22-6","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":6,"english":"May the apes, scorpions, wild gnats, reptiles and insects make you no harm; may not the elephants, tigers, terrible looking bears, hogs, buffaloes and other horned animals hurt you.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2022006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27408ef2daca6d30421b280d4f9a7aff40708ef43718c354780c8f30919454ee","compact":"ecd45306f770688ba63b2e80464c1ec8087d240bd291ef683e70a88f598836c5","nasal":"ecd45306f770688ba63b2e80464c1ec8087d240bd291ef683e70a88f598836c5"}},{"id":"VRCE-2-22-7","kanda":2,"kandaId":"ayodhya","sarga":22,"verse":7,"english":"May the apes, scorpions, wild gnats, reptiles and insects make you no harm; may not the elephants, tigers, terrible looking bears, hogs, buffaloes and other horned animals hurt you.","alignment":{"type":"grouped","confidence":0.886,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-25-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2022007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e1c43db976f44121b8add604e50832d893d19a72d31e937c3ed0fa8572be68b5","compact":"1898c2d1bc97383c074a52466a70249209e5236886841736b89dbb94d