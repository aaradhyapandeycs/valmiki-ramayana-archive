[{"id":"VRCE-2-54-1","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":1,"english":"Then like one possessed by an evil spirit, and trembling again and again, Kausalyä lying down on the ground like one dead, spoke to the charioteer, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2054001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dbad7cf375b0874402b190ac3cc251d350bc956db35aec6ee5ca7498fd255510","compact":"f47c5741e16c29fd5bbcec7116f38e1edbd73a9840856646552352ffe373b74a","nasal":"f47c5741e16c29fd5bbcec7116f38e1edbd73a9840856646552352ffe373b74a"}},{"id":"VRCE-2-54-2","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":2,"english":"Do you take me where Kākutstha is and Sītā and Lakşınaņa: without them, I cannot live for a moment.","alignment":{"type":"1:1","confidence":0.735,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2054002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a9d6f4375a2143ab3320e39bac6daf8fdc85c6f61e615f6171010f2cc16cfb80","compact":"ecc665fa8629c4e61b7e3108f39d4dfea8d28d8ab42a9d37b7a68069557748df","nasal":"ecc665fa8629c4e61b7e3108f39d4dfea8d28d8ab42a9d37b7a68069557748df"}},{"id":"VRCE-2-54-3","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":3,"english":"Do you without delay turn the car. Do you take me also to Dandaka. If I do not follow them, I shall repair to the mansion of Yama.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-3"],"status":"unreviewed"},"source":{"sanskritLocator":"2054003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"385e366b2acac64d294f973904fbbcabf9c6cf723f677ae57cc8361e066401c0","compact":"477effc9af4dc5f37d4d7013cbd34580c6d33a4de106d89aeb278b8a6f4c1e8d","nasal":"2e28a1e9cee1120f6ad84d5d76430278e5b8219dece78cb981bcef336091e7b3"}},{"id":"VRCE-2-54-4","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":4,"english":"Thereat the cahrioteer with joined hands comforted that exalted lady with ready words faltering and choked with rising vapour, \"Do you leave grief and sorrow and the violent emotion. Renouncing grief, Rāghava is living in the woods.\"","alignment":{"type":"grouped","confidence":0.695,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2054004","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"195be58b079350a7f3fab3d2542ecb81a3892ba4842956450748c2166eaa6c0c","compact":"34baba56a743e772f5a5089867182ffcf05a74b68fbc20fd6fdd0b20e077024a","nasal":"414a5b447a78d06b1148db1f297ed46bd55ade4602976b4d85fe311cd913fb8d"}},{"id":"VRCE-2-54-5","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":5,"english":"Thereat the cahrioteer with joined hands comforted that exalted lady with ready words faltering and choked with rising vapour, \"Do you leave grief and sorrow and the violent emotion. Renouncing grief, Rāghava is living in the woods.\"","alignment":{"type":"grouped","confidence":0.792,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-4"],"status":"unreviewed"},"source":{"sanskritLocator":"2054005","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9f92cff687ecf223bda517ed15f6182c550d72b7e0779ea700ce266c706ffd03","compact":"5f76ca538497d46d28855280a1fa12a44e2321b1d5138a2661f99e526433b74f","nasal":"5f76ca538497d46d28855280a1fa12a44e2321b1d5138a2661f99e526433b74f"}},{"id":"VRCE-2-54-6","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":6,"english":"And in the forest, the righteous Laksmara, having his senses under control, is ministering to Răma's feet and is thus adoring the gods for happiness in the next world.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-5"],"status":"unreviewed"},"source":{"sanskritLocator":"2054006","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83597cac3e5a4f0c3fca60fa596154a53a4cc1727768e76ed171bc0570033df3","compact":"90f82aea11c98ec97012517fe31a1a9fab213ba7b9d022e997362a38224aff3a","nasal":"8f2d57d6b10a110d6f7eaf4f6788b5fa72e6bfdeca258e33d4cb02b662efcd93"}},{"id":"VRCE-2-54-7","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":7,"english":"And even in the lonely woods, Sītā as if remaining at home, having fixed her thoughts on Rāma, is living a life of love.","alignment":{"type":"1:1","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-6"],"status":"unreviewed"},"source":{"sanskritLocator":"2054007","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7cf0e3e5214b9c4b50360751df8fb0a1898d8d0070a56c6011a6a1ea94f945c6","compact":"fa332daf511343745b7185548eeb84702de6c4144fedcf00a8734634fb6afa5f","nasal":"474e1398d2395a1a8cef88f79e4b25c0251c520cc2c6f75d378fe39797c618d8"}},{"id":"VRCE-2-54-8","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":8,"english":"And there appears not the least trace of any distress afflicting her; and Vaidehi seems to me as if she were meant (by Nature) for a life away from home.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-7"],"status":"unreviewed"},"source":{"sanskritLocator":"2054008","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e75f9fe8a546ea5f9495b708b21ef0889eb244d04d8c5b1568246eb23a0f02ce","compact":"eb1cefb51b82a0a2dd642b83e544e58fe332d27cb46a90dea120e08f494ad59d","nasal":"eb1cefb51b82a0a2dd642b83e544e58fe332d27cb46a90dea120e08f494ad59d"}},{"id":"VRCE-2-54-9","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":9,"english":"And as forinerly going to urban villas she disported, she disports now even in the lonely forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-8"],"status":"unreviewed"},"source":{"sanskritLocator":"2054009","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d0313962241b37091380b1e212b84a35879c79ce047aff7984cfc584642d12e","compact":"d3dcb8f76c6f5e8d1ff0eff1325c3696cf74f6f53360a91f3c0469dfc01ecc22","nasal":"d3dcb8f76c6f5e8d1ff0eff1325c3696cf74f6f53360a91f3c0469dfc01ecc22"}},{"id":"VRCE-2-54-10","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":10,"english":"And although living in the lone forest, that one of a countenance resembling the infant moon, sports merrily like a girl, in the garden represented by Rāma's self.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2054010","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a963923d6b428b17e8884b71a40eb2eaedbd9114429fed438bd76501d0840e06","compact":"df8fa0debad01c0f033c8398e32c0fe3561343ef8d16995a4df4ee67aceb9dea","nasal":"eadd30cf885540574ebf27af50dc8fcc07bcd8481f25ef005d44e30bd5ebeb1b"}},{"id":"VRCE-2-54-11","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":11,"english":"Ayodhyā without Rāma would have seemed a wilderness to her whose heart is fixed on him and whose very life depends upon him.","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-10"],"status":"unreviewed"},"source":{"sanskritLocator":"2054011","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"946dcb02a72b88b34c4e8e42db704ccd230ef6364299f895d80eb93ec2f9b96e","compact":"ad4eafcd1b5c8080a7bda4d38765f27b82104b11654cce7654e754c33cb5baa2","nasal":"ad4eafcd1b5c8080a7bda4d38765f27b82104b11654cce7654e754c33cb5baa2"}},{"id":"VRCE-2-54-12","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":12,"english":"Vaidehī is now asking (Rāma) concerning the villages and towns (in their way); and observing various trees and the courses of the rivers, Jānaki, asking Råma Laksmana (for information), is learning all about them. And Sītā sports as she used to do in arbours stationed at the distance of only one krosa from Ayodhyā.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-11"],"status":"unreviewed"},"source":{"sanskritLocator":"2054012","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f96db209dfc5d7b2113881521116168efe50970116a936a0867e593b5104cc7a","compact":"88db4f78a955772729988fd8e01fff961f75606b2dfca81d5167441d457529fd","nasal":"88db4f78a955772729988fd8e01fff961f75606b2dfca81d5167441d457529fd"}},{"id":"VRCE-2-54-13","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":13,"english":"Neither through the fatigue of travel, nor the influence of the wind, nor excitement, nor the sun, has Vaidehi's lustre resembling the lunar light suffered any diminution.","alignment":{"type":"1:1","confidence":0.733,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-14"],"status":"unreviewed"},"source":{"sanskritLocator":"2054013","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"044fe6ed4af09aba2d0a900486fb53718d8f81683784e049410a386815d017ee","compact":"2b77eab015e0c4afef0c5fedd8c24fae14b8d65d7404e1713224496e699caea0","nasal":"5b944d85c68f411153509748e301d20eba01b6f5ffb46af2782e1ba11d073ed7"}},{"id":"VRCE-2-54-14","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":14,"english":"The countenance of that fair-speaking one resembling the lotus and comparable to the full moon in splendour, has not waxed pale.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-15"],"status":"unreviewed"},"source":{"sanskritLocator":"2054014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"873de2722d1867e336e54c61758726bc59d3065aa73da4ad6e7bd1afaf608b49","compact":"1d0fc2c5adf48d82e56f95d50d4f6a43d81fa8ae2049052e46888cefa442431e","nasal":"0a5bdb18a7aed456636d35fd83815c3b43c68bee81ba14c20b4555e241ea090e"}},{"id":"VRCE-2-54-15","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":15,"english":"Her feet now without your dye of the liquid lac, but naturally furnished with the roseate hue of the same, are gorgeous like lotus buds.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-16"],"status":"unreviewed"},"source":{"sanskritLocator":"2054015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ec16d31479df934907873f39a0b66216dd3778a0ed340993bffb592b6ff15b01","compact":"7aa178093c698ce709dd840c4e9b40fb59d42e1e7ba1d5c3730d8f5d243109d3","nasal":"7aa178093c698ce709dd840c4e9b40fb59d42e1e7ba1d5c3730d8f5d243109d3"}},{"id":"VRCE-2-54-16","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":16,"english":"Still Vaidehī decked in ornaments from affection for Rāma, goes gracefully rebuking with her bangles the wavy gait (of cranes).","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-17"],"status":"unreviewed"},"source":{"sanskritLocator":"2054016","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3b7abdb8ff139e57591d56c0b6bdcfe7534d4c0f03db61f4d9d6ea01ccf7a93","compact":"6dbc6dfae19f12c756b66f6d0bc14f31569e5227e5a9e7da443421f99b85ee24","nasal":"6dbc6dfae19f12c756b66f6d0bc14f31569e5227e5a9e7da443421f99b85ee24"}},{"id":"VRCE-2-54-17","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":17,"english":"Supporting herself on Rāma's arm, Sītă arrived at the forest, is not inspired with fear on beholding either an elephant, or a lion, or a tiger.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-18"],"status":"unreviewed"},"source":{"sanskritLocator":"2054017","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7af5c51f4261d1728e06dd0f5c4f01459b65657aa0e78aa3deddc76d3f28caaf","compact":"0be60ff263281e322948b54662572f4a59142fb65154c97f2797c73031b34474","nasal":"0be60ff263281e322948b54662572f4a59142fb65154c97f2797c73031b34474"}},{"id":"VRCE-2-54-18","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":18,"english":"Therefore they are not to be bewailed, nor your own self, nor the lord of men. This history of Rāma will endure for ever in this world.","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-19"],"status":"unreviewed"},"source":{"sanskritLocator":"2054018","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b74d4201e1dcffae7a0cfc85ae8882a90c62df3a23ec4c9e0b897f869d8fee69","compact":"77b8c111f26a6f0a70d416b876991bb0cf43d6b9d4b47c43272baa82d951f060","nasal":"77b8c111f26a6f0a70d416b876991bb0cf43d6b9d4b47c43272baa82d951f060"}},{"id":"VRCE-2-54-19","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":19,"english":"Renouncing grief and with cheerful hearts, well established in the life led by the Maharşis, they living in the forest on wild fruits as their sustenance, are maintaining the noble promise of their sire.","alignment":{"type":"1:1","confidence":0.89,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-20"],"status":"unreviewed"},"source":{"sanskritLocator":"2054019","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"731ef169168a9007c3d758bf1767935fef5670fb19aedb6cbd6c4ba459679812","compact":"334a830bf96cd1491dd271b234dc3740f61a45b0d6f352987fbe1fb5be3ef5f1","nasal":"8ed69890f269b63cdce593efc2d79bf98ff5cf05bdf565babd1ecddc7ec4743c"}},{"id":"VRCE-2-54-20","kanda":2,"kandaId":"ayodhya","sarga":54,"verse":20,"english":"Consoled by the truth-telling yet sweetspeeched charioteer, that lady oppressed with grief for her son, ceased not to wail loudly, \"My beloved,” “My son,\" \"Rāghava.\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-60-21"],"status":"unreviewed"},"source":{"sanskritLocator":"2054020","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d143c2f4e4845ec11e1a2f8666e1193d29ae70005768d4415d8e34a792f520e1","compact":"2d0832ae92f4cb9e1303de89f8f6336a2cfe73c950c4d32f77c5f5c312f26ae6","nasal":"2d0832ae92f4cb9e1303de89f8f6336a2cfe73c950c4d32f77c5f5c312f26ae6"}}]
