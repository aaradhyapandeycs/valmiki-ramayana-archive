"sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8dce1b5158005e06ad7e1b00dd24bc1ba9041d648497888e67f24965a61f18e3","compact":"4bcd1d57bf820ac88445de96f3525c4b07f3ccd6934224eace26992392b5cac9","nasal":"920b78696913054be71a0985bcc5c408716fd59029fe3666867d8fa46d833a82"}},{"id":"VRCE-2-9-32","kanda":2,"kandaId":"ayodhya","sarga":9,"verse":32,"english":"Your countenance is like the bright moon, Ah! O Manthara, how lovely do you look! Your hips are smooth, and is decked with chains; and your thighs and legs are of large proportions. O Mantharā, O you clad in linen garment, O graceful damsel, with your pair of spacious humps, you go before me like a she-crane.","alignment":{"type":"grouped","confidence":0.345,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-9-37"],"status":"unreviewed"},"source":{"sanskritLocator":"2009032","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cddbcc0cbdb479aa0a4b2651219c0c9989d53f2a02745716cefa1028413f61f3","compact":"a84de28cd40673124910e7841c057685a2e283af8647861c9ac16b00aa8d2278","nasal":"ee3cc9e4014ad8a66f63e94f2318d8318165a6229d57728c76c139031cc0b5c3"}},{"id":"VRCE-2-9-33","kanda":2,"kandaId":"ayodhya","sarga":9,"verse":33,"english":"Your countenance is like the bright moon, Ah! O Manthara, how lovely do you look! Your hips are smooth, and is decked with chains; and your thighs and legs are of large proportions. O Mantharā, O you clad in linen garment, O graceful damsel, with your pair of spacious humps, you go before me like a she-crane.","alignment":{"type":"grouped","confidence":0.71,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-9-37"],"status":"unreviewed"},"source":{"sanskritLocator":"2009033","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"32df7a73f646d8e8effddd21ea8a622d5d0ff1bcda4ec44d7841cbd0cbd9d236","compact":"f934d5b166e3f075d0bdf395b69b01b85d89c2fc3655ea55fbf40d45