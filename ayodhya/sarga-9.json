[{"id":"VRCE-2-9-1","kanda":2,"kandaId":"ayodhya","sarga":9,"verse":1,"english":"Thus addressed, Kaikeyi, with her countenance flaming in wrath, sighing hot and hard, spoke to Mantharā, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-9-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2009001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d0ffccc1c1ed2e65c1290b23bc9949c3d8e7817e7ef7d7c63395d748573b5701","compact":"1e19161abe9e1b03069afa1423b118063b9bf0be21e8730ba1f0a4d9f6470eb9","nasal":"4d0fd7168f4b055f44b76d94bffd5543487278d9a392a4acd0a46eadc6d77c3d"}},{"id":"VRCE-2-9-2","kanda":2,"kandaId":"ayodhya","sarga":9,"verse":2,"english":"Even this very day will I speedily send Rāma into the forest and without delay install Bharata in the royal heir-apparentship.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-9-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2009002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4ae9c8f9135772b08783bebb4a4d9c0154fd9a9259f6f9d80426aad36d12d642","compact":"a55d80b999eff3bf7e870c0f428f577454b82b6472535b3bcd7fc1cb2699ce76","nasal":"a55d80b999eff3bf7e870c0f428f577454b82b6472535b3bcd7fc1cb2699ce76"}},{"id":"VRCE-2-9-3","kanda":2,"kandaId":"ayodhya","sarga":9,"verse":3,"english":"Do you tell me the means. By what means, O Mantharā, Bharata will gain the kingdom, and in no wise Rāma.","alignment":{"type":"grouped","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-9-9"],"status":"unreviewed"},"source":{"sanskritLocator":"2009003","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"58357b8e36669c56c51276603d6ea7bf91b81c284ae50a1316ce86251ebacab5","compact":"246c4807f6e7dfae04006262ae2881297a4050ac810ba44bc06d9037259d63dc","nasal":"b8c1bd3db054acd607d25224