[{"id":"VRCE-2-73-1","kanda":2,"kandaId":"ayodhya","sarga":73,"verse":1,"english":"Then on the morning of the fourteenth day, the ministers of the king assembled addressed Bharata in the following words.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-79-1"],"status":"unreviewed"},"source":{"sanskritLocator":"2073001","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"82a399072bd86212201a03c64fff6c8b9cf0cbda734a0c62b5fb5b720aa35c5a","compact":"a8497e3e0e2651a96e7aa10652051c379140941fee57f667d106c581d402cb8d","nasal":"a8497e3e0e2651a96e7aa10652051c379140941fee57f667d106c581d402cb8d"}},{"id":"VRCE-2-73-2","kanda":2,"kandaId":"ayodhya","sarga":73,"verse":2,"english":"Having exiled his eldest son and the exceedingly strong Lakşmaņa, Dasaratha who was the superior of our superiors has gone to heaven. Do you, therefore, O illustrious prince, become our king. Having been permitted by the king you will commit no fault (by doing so), as this kingdom is without a master.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-79-2"],"status":"unreviewed"},"source":{"sanskritLocator":"2073002","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e3594c40cdade9898c305f949bf2855006ab8b1c88e485c223195bbda0bf8c8","compact":"4efc6a324a1ef78983949c1652a638a70da6ad11ccdea5d7a2bdd314f865e4be","nasal":"4efc6a324a1ef78983949c1652a638a70da6ad11ccdea5d7a2bdd314f865e4be"}},{"id":"VRCE-2-73-3","kanda":2,"kandaId":"ayodhya","sarga":73,"verse":3,"english":"Having exiled his eldest son and the exceedingly strong Lakşmaņa, Dasaratha who was the superior of our superiors has gone to heaven. Do you, therefore, O illustrious prince, become our king. Having been permitted by the king you will commit no fault (by doing so), as this kingdom is without a master.","alignment":{"type":"grouped","confidence":1.0,"met