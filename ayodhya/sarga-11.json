],"status":"unreviewed"},"source":{"sanskritLocator":"2011014","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b5ca579dc978c667cabeadf4403306792b9f2d6ac2a4a2efeb486921f75154c","compact":"c8e34d5c1a4fc47449a1cd6440b50f3072f04ec734a4c7cb574f74fabb0469f6","nasal":"c8e34d5c1a4fc47449a1cd6440b50f3072f04ec734a4c7cb574f74fabb0469f6"}},{"id":"VRCE-2-11-15","kanda":2,"kandaId":"ayodhya","sarga":11,"verse":15,"english":"Thereat seeing that his favourite dissatisfied wife persisted in urging the banishment of his son, the king struck with grief, again fell down to the earth, senseless.","alignment":{"type":"1:1","confidence":0.94,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-2-13-24"],"status":"unreviewed"},"source":{"sanskritLocator":"2011015","sanskritFile":"Ram02.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de6e0b39aba740a011f951dbf731261d8679de3e0b2d942a119480fd160b92bc","compact":"fc887860c1d09c95d1a71004af48d87e8457a6de631838487da6ad47c379f981","nasal":"fc887860c1d09c95d1a71004af48d87e8457a6de631838487da6ad47c379f981"}}]
