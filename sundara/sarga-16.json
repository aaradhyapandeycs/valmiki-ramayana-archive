:1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-18-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5016024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0a06a01dcf79b7296b6c3e835c4852de01012155fc9a73c29398690fb6bddc1","compact":"b929787be749de71c121e772479f5c08247db12bb337545ab5144de3fb7fb390","nasal":"fb6eef5a0948a047748c1e79d3e3b72581d0ea1f4b9c569c383617850a4f03d2"}},{"id":"VRCE-5-16-25","kanda":5,"kandaId":"sundara","sarga":16,"verse":25,"english":"That highly energetic monkey beheld that effulgent (Rāvana) surrounded by excellent damsels like to moon encircled by stars. And beholding him the monkey reflected—“This must be Rāvana-for he is the person whom I saw sleeping in an excellent apartment in that city.” Thinking this, that highly effulgent son of Maruta-Hanuman leaped (high upon another branch).","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-18-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5016025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f78914d6c556148356a1bb9ab158f1194c1b8a57ed841c6bdaede1c6e80bb0f3","compact":"635ca876395f5b4ac1475fa365e4abf0579019bc37e105d639eda0538bc2b62b","nasal":"4d9b1518fc8c72f6151ad742f7da6e7db2322f35f8a29d87a71ac96c85e48777"}},{"id":"VRCE-5-16-26","kanda":5,"kandaId":"sundara","sarga":16,"verse":26,"english":"That highly energetic monkey beheld that effulgent (Rāvana) surrounded by excellent damsels like to moon encircled by stars. And beholding him the monkey reflected—“This must be Rāvana-for he is the person whom I saw sleeping in an excellent apartment in that city.” Thinking this, that highly effulgent son of Maruta-Hanuman leaped (high upon another branch).","alignment":{"type":"grouped","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-18-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5016026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d705d824edd47188f2b2363935b7b19f729f3798ebfe0072df5e14de90227741","compact":"c14c9a973afe030258f6b39018d91f62696700ba78579ce29f28529046fc4a6e","nasal":"d7c0994e4bc3c81eda3c8a05673686bf485cc5580d188afe1e63d29bec6d17eb"}},{"id":"VRCE-5-16-27","kanda":5,"kandaId":"sundara","sarga":16,"verse":27,"english":"And effulgent as he was, that highly intelligent monkey hid himself on a branch covered with leaves, being unable to stand before the effulgence of that Rākșasa.","alignment":{"type":"1:1","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-18-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5016027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d339fba732da5cdf5dc533d0bfac713ac37e357875aefa040e4a8c81d55896f","compact":"a8438171eb4cbc1034bf164ab584551a607f1f65a22d53f1bb9382e90fbf7fd8","nasal":"0ab536255d0b556d55fefd6e5a569c90402ad97647dd3149f483cc8c25b8c7b2"}},{"id":"VRCE-5-16-28","kanda":5,"kandaId":"sundara","sarga":16,"verse":28,"english":"Rāvana proceeded in that way, being anxious to behold the blue-eyed Sītā, having spacious breast, excellent hips and a lock of black hair.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-18-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5016028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7face5faec25eddb43f65738dc40f4cae9de17f5012d1b407ef66cc6f181f7c7","compact":"51dd0c6819008bd849ca0736478a66cb9fec22c0b13c836200c01267692e5a19","nasal":"7b90b8128a42749bfaf30a9c4ddeeab92bab143f39299d33ee6f85bb43494a96"}}]
