5-57-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5055026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee1a72ca9b09a8d4a4d473b11f98af8913d201d517dec8ad0898075319973d5b","compact":"fca099800d7cb78cec1bec28bf3dad01fb195f9ab616c9340275e03d9a2aa2d3","nasal":"fca099800d7cb78cec1bec28bf3dad01fb195f9ab616c9340275e03d9a2aa2d3"}},{"id":"VRCE-5-55-27","kanda":5,"kandaId":"sundara","sarga":55,"verse":27,"english":"That blameless one is guarded by dreadful Räkşasīs. The girl wear a single braid of hair, and burn to attain a sight of Rāma. She is faint in consequence of fasting, and dirty, wear matted locks and is emaciated.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5055027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4f86e6fb92098eb97f45fd01afcca00ec2ea97221ff1e7fcb26386611b9f05cd","compact":"182fa979773a592fe8bf802d56e5722b5c9f9da28a0d682256cb98398c909892","nasal":"26ad96807158ee16fa410a2ab93682573b712a7e326eff083fc0473e4c1dbde9"}},{"id":"VRCE-5-55-28","kanda":5,"kandaId":"sundara","sarga":55,"verse":28,"english":"Hearing the words, \"I have seen\" from the Wind-god's offspring resembling ambrosia, all the monkeys were filled with rejoicing.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-32"],"status":"unreviewed"},"source":{"sanskritLocator":"5055028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"97a6dd07aff4ecf112dd211e5a26fe8302ea6b0daef3d4d0217f0df341591e04","compact":"7b00f57e9d34ceb81154991bfaf54975cf829726df666b2066d4445ca1ba0137","nasal":"7b00f57e9d34ceb81154991bfaf54975cf829726df666b2066d4445ca1ba0137"}},{"id":"VRCE-5-55-29","kanda":5,"kandaId":"sundara","sarga":55,"verse":29,"english":"And thereupon, some of mighty ones roared, and some shouted, and some blustered, and some raised ululations, and others stormed (in return).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-33"],"status":"unreviewed"},"source":{"sanskritLocator":"5055029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"909c227162c6742d863c7b5bf415846d94930f1000ffe60e631907a78a8d7fc4","compact":"04fd39d1a982e2cda15fbec29a6c1d7c5912033e1ff7250928a4f8fd603e4f4b","nasal":"e2715b19c4b99affb85fc469734b05d91b66cfb35c67deecf2b64f7d6245e899"}},{"id":"VRCE-5-55-30","kanda":5,"kandaId":"sundara","sarga":55,"verse":30,"english":"And some elephantine monkeys in joy upraised their tails, and some lashed with their long and broad tails.","alignment":{"type":"1:1","confidence":0.554,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-34"],"status":"unreviewed"},"source":{"sanskritLocator":"5055030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f4803514bcea59208cd4885a0ee70e15ef600ba8ff48d1ec66bcad5ae6090f6b","compact":"6f95bf9eb0e72c3e08c62c88c9cc7ec2bffdbec376d28bcc93a6c57d8bbb0ed0","nasal":"93a9070e2a308fa348a6fb9ac21cae5de1c4a7dde7f1fbfb6f687e8c72ff0df3"}},{"id":"VRCE-5-55-31","kanda":5,"kandaId":"sundara","sarga":55,"verse":31,"english":"And others, transported with joy, bounding up to the mountain-summit, touched that foremost of monkeys, the handsome Hanumān.","alignment":{"type":"1:1","confidence":0.585,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-35"],"status":"unreviewed"},"source":{"sanskritLocator":"5055031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0fed3e727384595d97b8d218a083eec1447717342498660788c1e2ebad803699","compact":"47c4a7469073d83e6cbc87898d66a05eae6581b4c79093952ecec310090c6193","nasal":"04df328ebeafb4a0c611b1a651bfc2b2e6a627448a3a55ecb5e427baa3cd627a"}},{"id":"VRCE-5-55-32","kanda":5,"kandaId":"sundara","sarga":55,"verse":32,"english":"When Hanumān had ended, Angada said these excellent words in the midst of the heroic monkeys.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-36"],"status":"unreviewed"},"source":{"sanskritLocator":"5055032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"295f494d33e1b5b3ee744a65984d4b692ed594148999abf180ae6ba035b13b65","compact":"506e31082141196656186a7b60d7c49e482c8a3db99dd2f05ef27da79dd4c1ba","nasal":"51c7ae7692139e751b7bae17c17348c4cadd86aa5e1920aaa1d1ecca96788913"}},{"id":"VRCE-5-55-33","kanda":5,"kandaId":"sundara","sarga":55,"verse":33,"english":"There is none, O monkey, that is like to you in strength and prowess. As having bounded over the spacious main, you had come back (here), you are, O excellent monkey, the only giver of our lives. By your grace it is that, our end attained, we shall meet with Rāghava.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-37"],"status":"unreviewed"},"source":{"sanskritLocator":"5055033","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb0852c2f4973b0147352c141004ffb02cc910fc9bc868f1060526453bc6573a","compact":"358bde309c3997e6b3e5de71760ddae454fb14e516db46178f25efdcefe35bbb","nasal":"358bde309c3997e6b3e5de71760ddae454fb14e516db46178f25efdcefe35bbb"}},{"id":"VRCE-5-55-34","kanda":5,"kandaId":"sundara","sarga":55,"verse":34,"english":"Oh for your fidelity! Oh for your prowess! Oh for your fortitude! By luck had you seen that exalted one, the illustrious wife of Rāma, by luck it is that Kākutstha shall forego his sorrow in consequence of separation from Sītā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-38"],"status":"unreviewed"},"source":{"sanskritLocator":"5055034","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3e909962e0e154cf62968dea872b2ea9eff766e55c6c9bc4d66360ce3103622a","compact":"139a48945bd4f80412ea8bf370d40d982ce3871e8319b2c27bce00c0c5e8c0e1","nasal":"139a48945bd4f80412ea8bf370d40d982ce3871e8319b2c27bce00c0c5e8c0e1"}},{"id":"VRCE-5-55-35","kanda":5,"kandaId":"sundara","sarga":55,"verse":35,"english":"Then surrounding Angada, Hanumān, and Jāmbavan, the monkeys, exceedingly rejoiced, sat down upon a spacious stone. And having sat them down on the spacious rock, the monkeys became eager to hear of the bounding of the main and of (Hanuān's) seeing Larkā, Sītā and Rāvaņa And they stood with joined hands looking wistfully into Hanumān's face.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-39"],"status":"unreviewed"},"source":{"sanskritLocator":"5055035","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e35c33864d665143eab920a93d8af6be6933914a7b1931f7e330fe374fc96d0b","compact":"3a0e9b4755637e2331654b7f4b000647313daa28d3ce572e2b15a52d01c8fc92","nasal":"df2c16cc9e0c9b0c8f6b8f2e03e751f060312f513f7119e920a9ab7dfb51c769"}},{"id":"VRCE-5-55-36","kanda":5,"kandaId":"sundara","sarga":55,"verse":36,"english":"Then surrounding Angada, Hanumān, and Jāmbavan, the monkeys, exceedingly rejoiced, sat down upon a spacious stone. And having sat them down on the spacious rock, the monkeys became eager to hear of the bounding of the main and of (Hanuān's) seeing Larkā, Sītā and Rāvaņa And they stood with joined hands looking wistfully into Hanumān's face.","alignment":{"type":"grouped","confidence":0.92,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-39"],"status":"unreviewed"},"source":{"sanskritLocator":"5055036","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2c9254aa386585dfc40327f02f633a14c90ea5876174ebcbdf35c282c8422bb9","compact":"37b4b7ffe6c6ed0e935c0e5e0c2b96cae7f1238d27461d