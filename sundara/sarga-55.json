[{"id":"VRCE-5-55-1","kanda":5,"kandaId":"sundara","sarga":55,"verse":1,"english":"And springing up like to a winged hill, that one endowed with energy, with energy, the untiring Hanumān, began to swim on the ocean of the firmament having for its blown lotuses and lilies, snakes, Yakșas and Gandharvas; with the Moon for its comely Kumuda; (Lily) and with the Sun for its Kārandavas; charming to behold; having Tișya and Śravaņa for its swans, clouds for its mosses and grass, Punarvasu for its mighty fish, the red-bodied one (Bhama) for its huge aquatic animal, Airāvata for its spacious island, Swati for its sportive swan, breezes for its billows, and moonlight for its cool waters.","alignment":{"type":"grouped","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5055001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"09c4b2876b7a690bfef81ffd823d9902eff4550758e7d3495c586c9ae6907e00","compact":"262d61b2e1caa3e52221d8ab6cfd0fcc0b3656c9aca176de5e17e4a1569b3024","nasal":"a1b60c8595f4bf72c4993ea5584795ea6a4e17db5f6aefa669f7c7ba2bcb0e90"}},{"id":"VRCE-5-55-2","kanda":5,"kandaId":"sundara","sarga":55,"verse":2,"english":"And springing up like to a winged hill, that one endowed with energy, with energy, the untiring Hanumān, began to swim on the ocean of the firmament having for its blown lotuses and lilies, snakes, Yakșas and Gandharvas; with the Moon for its comely Kumuda; (Lily) and with the Sun for its Kārandavas; charming to behold; having Tișya and Śravaņa for its swans, clouds for its mosses and grass, Punarvasu for its mighty fish, the red-bodied one (Bhama) for its huge aquatic animal, Airāvata for its spacious island, Swati for its sportive swan, breezes for its billows, and moonlight for its cool waters.","alignment":{"type":"grouped","confidence":0.897,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-57-1"],"status":"unreviewed"},"