s":"unreviewed"},"source":{"sanskritLocator":"5009039","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0e01e5c9936fb76691768f96a1a8fcd89858bec6c9c01b3e366105b78ff941e","compact":"03487b64060d3cb34be3588aaf4b13add87ea9898801586a50520f1f91f4c270","nasal":"9e30c4b126cade1ca2c0a19c0bd9d259da7d6444111e191dfdb57ff01e629335"}},{"id":"VRCE-5-9-40","kanda":5,"kandaId":"sundara","sarga":9,"verse":40,"english":"I could not search for Vaidehī elsewhere; for in the matter of search, people always search for women even among women.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-11-32"],"status":"unreviewed"},"source":{"sanskritLocator":"5009040","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"47d6e66f7c346bbc99151535518cf8dab082cc2ac59d5c780a98218071499776","compact":"17da3de8b7a63c9e5fa603b226ff67059fe10f428321a453525542af77c0f9ee","nasal":"8a962803f487be29e5eaf6931a68b7027b4910caf6f5822bbd9f6bd97f3d07e3"}},{"id":"VRCE-5-9-41","kanda":5,"kandaId":"sundara","sarga":9,"verse":41,"english":"People search for creatures among the species to which they happen to belong: none scarchets for a lost lady among female deer.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-11-33"],"status":"unreviewed"},"source":{"sanskritLocator":"5009041","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"894dc28b5e12edf21544133fd8f9cfa2584946a618b2ee545443847f7154581f","compact":"fbe37f17aa4695cd1f596692e832d3c9e395e5f2cabe8109732d32545aac6964","nasal":"fbe37f17aa4695cd1f596692e832d3c9e395e5f2cabe8109732d32545aac6964"}},{"id":"VRCE-5-9-42","kanda":5,"kandaId":"sundara","sarga":9,"verse":42,"english":"Therefore have I with a pure heart explored the entire inner apartment of Rāvana; but Janaka's daughter I see not.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-11-34"],"status":"unreviewed"},"source":{"sanskritLocator":"5009042","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e9f2e37cd24583f16f41455083c3634da3c5b75f684f5ae0107e57e7d316447e","compact":"41e118e8adb67e94522e53eb9ae5150b55ef2d2fbe9caac3a2e186d2d8869f01","nasal":"29f70b5cb5e27b0bd3e34fb188b8b192207c4784e16f7ddc6eac72c5f8f5d102"}},{"id":"VRCE-5-9-43","kanda":5,"kandaId":"sundara","sarga":9,"verse":43,"english":"Hanumān endowed with prowess saw the daughters of gods, and Yaksa, and Nagas; but he saw not Jānaki.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-11-35"],"status":"unreviewed"},"source":{"sanskritLocator":"5009043","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eda4c9496092328050b4c2e5416fff52c1e009d3ea86ccf4fec795e7a6defbb0","compact":"24b730ab310318d37cb3376aa4e01ab812dc40d45081621acc0378ef1e7e3b3f","nasal":"8422ca0004832a9455b3083622111c3ebe0064b5877b70bb68c232e6f6515fed"}},{"id":"VRCE-5-9-44","kanda":5,"kandaId":"sundara","sarga":9,"verse":44,"english":"And not seeing her, that hero, having beheld other magnificent dames, coming out of that place, set about searching for Sītā (afresh).","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-11-36"],"status":"unreviewed"},"source":{"sanskritLocator":"5009044","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5db1e478b40bac7c1bbd041f60755d60698089e1ab65f8ad4a2da2e3ff2a203c","compact":"7c4327cca59e0a44e9253f0e1836e66ddf2ab2966a247860bca2164e13dead1b","nasal":"7c4327cca59e0a44e9253f0e1836e66ddf2ab2966a247860bca2164e13dead1b"}}]
