kritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d44aee3f0b15cca8a6066d01cf0158d8fc1e47e47fafb29e262aec5167aba640","compact":"f12bc359160c6325e7e08705b54dc63928e6bd0b43a98636b948f9817bc45414","nasal":"23e512387c2f72dba185f93e5ae4af04d978ef02eca5b60840dd4ff0d7f743a3"}},{"id":"VRCE-5-60-28","kanda":5,"kandaId":"sundara","sarga":60,"verse":28,"english":"Let us all proceed there where our lord, the spacious-necked Sugrīva live with Rāma.","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5060028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e3d9077792a46bd05e816cf5daeffd5d49fe2cb05c51bff476c412200345d9a7","compact":"217dc99735b03e82c6a51e125cc4878d7baf360f3d7243b60d1bf3df9fa404d9","nasal":"a4eb00259fd39a0d1aa13de9cffb37932b7811967fca7140400affcaf4c6f771"}},{"id":"VRCE-5-60-29","kanda":5,"kandaId":"sundara","sarga":60,"verse":29,"english":"I shall relate to him all the unfair dealings of Angada and forsooth shall that wrathful king punish all these monkeys","alignment":{"type":"1:1","confidence":0.773,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-22"],"status":"unreviewed"},"source":{"sanskritLocator":"5060029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"663bcb38d63c55207f241a9149fac2763680223b928c1e5517da8fc77e737016","compact":"9c5aaaf9b5d1efcead88c5220d12f0cb749867b159169f57083f8ee5eeb160af","nasal":"580f8c7656352a017fd0a3efab0ce8884b766dfc09c0e77c76973b956f8cb731"}},{"id":"VRCE-5-60-30","kanda":5,"kandaId":"sundara","sarga":60,"verse":30,"english":"The picturesque Madhuvana is the most favourite orchard of the high-souled Sugrīva. It was enjoyed by his forefathers and is not even approached by the celestials.","alignment":{"type":"1:1","confidence":0.885,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-23"],"status":"unreviewed"},"source":{"sanskritLocator":"5060030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3fe612bf1b66466755e817f6da9ed730d3259234b9f417f96a3bf23b3400aeff","compact":"f19afae7beb93824ea07ade03d1f36501a47b376b365e158174f485f803c0db9","nasal":"f19afae7beb93824ea07ade03d1f36501a47b376b365e158174f485f803c0db9"}},{"id":"VRCE-5-60-31","kanda":5,"kandaId":"sundara","sarga":60,"verse":31,"english":"And meting out punishment to these monkeys, eager to drink honey and almost half dead, Sugrīva shall slay them as will as their friends and relatives.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5060031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2d7493adbcf22956cc1469ddf3d9ca7cb37be8bd60faed415b5bc0e657762ee4","compact":"54651b399e56c823a8791a4bd7144b7635063082c88878d183612a962b734b76","nasal":"432182954023c4e950c3016f4d4ff8a8158ec7a47f4801e773ba75dbe2d0d630"}},{"id":"VRCE-5-60-32","kanda":5,"kandaId":"sundara","sarga":60,"verse":32,"english":"Those vicious-souled ones are worthy of being slain since they have transgressed the royal mandate. And then shall my wrath, arising out of impatience, bear fruits.","alignment":{"type":"1:1","confidence":0.617,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5060032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb2e2c12358a0d4538f1655ec405c6535af6faeb2c4e14cd45f06cecbbb172c6","compact":"0680abe26b3fe8dafa11519b8fc662f47322a0253433eb53e7cbce6a48af49a6","nasal":"0680abe26b3fe8dafa11519b8fc662f47322a0253433eb53e7cbce6a48af49a6"}},{"id":"VRCE-5-60-33","kanda":5,"kandaId":"sundara","sarga":60,"verse":33,"english":"Having thus spoken to the guards of the forest the highly powerful Dadhimukha leaped high up in the welkin and went away with them.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5060033","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"63023187625a7d8809f0c78538bd9d432c66c31696407c246e9455eeb55fa836","compact":"a89cf025b3e64671dc1daf4d4f5dd96fa414484e9a20045258423882e24316aa","nasal":"a89cf025b3e64671dc1daf4d4f5dd96fa414484e9a20045258423882e24316aa"}},{"id":"VRCE-5-60-34","kanda":5,"kandaId":"sundara","sarga":60,"verse":34,"english":"And in no time he reached where the highly intelligent \"Niether monkey/Sugriva, the offspring of the sun, was.\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5060034","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e662313a373b047229ab9584f1c0bfa3a1e4db828c85bd1c0ea8d14882039466","compact":"00a5cceea58ad1fcebe106979b90c83492a5858d300efa9cb6e2dd4ff09fbd24","nasal":"8dc7933b651e32bdb21bfe230361fbfbecb6dcb2b8e1b24b566673bfd95f5676"}},{"id":"VRCE-5-60-35","kanda":5,"kandaId":"sundara","sarga":60,"verse":35,"english":"And beholding Rāma, Lakṣmaṇa, and Sugrīva and the level ground he descended from the sky.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-62-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5060035","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c57e6bb9ae7256821bd489abae08ba3fe5ec10ab16bbeb6f45be76e52025e737","compact":"caeae18fea6bd4f2f488a406385022c5db6dcb9462623ba458276349907abe8d","nasal":"ba3e062b57b8385fedb18d07e433ee3d52c1ea8e871e4a206af183a788387067"}},{"id":"VRCE-5-60-36","kanda":5,"kandaId":"sundara","sarga":60,"verse":36,"english":"And descendin