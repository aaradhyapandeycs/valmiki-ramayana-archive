[{"id":"VRCE-5-65-1","kanda":5,"kandaId":"sundara","sarga":65,"verse":1,"english":"Being thus addressed by the high-souled Rāghava, Hanumān, related to him all of what Sita had said,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-67-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5065001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e32cd6ba715826a4ef4d13853082a4cce4c100e1597e4f7166d44748f9e31b03","compact":"f6cc32533f8cf10041d02fe0410c9701e217f6cd3e8adca68dd26ab157a8291b","nasal":"f6cc32533f8cf10041d02fe0410c9701e217f6cd3e8adca68dd26ab157a8291b"}},{"id":"VRCE-5-65-2","kanda":5,"kandaId":"sundara","sarga":65,"verse":2,"english":"O foremost of men, the worshipful Jānaki, related as a token, all the incidents at the Mount Citrakūta from the beginning to the end.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-67-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5065002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2f7b87342a7ed314c5457346051bcab2aa25fc296a59c6ea1c875308cfb02778","compact":"78bd49c2c2f961d3aaf2c6a566d29edf465c609c889b5e201d864668456d5413","nasal":"78bd49c2c2f961d3aaf2c6a566d29edf465c609c889b5e201d864668456d5413"}},{"id":"VRCE-5-65-3","kanda":5,"kandaId":"sundara","sarga":65,"verse":3,"english":"Sleeping happily with you, Janaki one day awoke before, and in the meantime, a crow wounded her breast with its beaks.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-67-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5065003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"df4ad4ace900b8a1952b463d324e4a7cef9d2b56eb1714f1d92b899727d1afff","compact":"75eb17454561dff5242ca516db7679a497fa5e7e43a90753a2f9ce6ca866c462","nasal":"494ff05e321