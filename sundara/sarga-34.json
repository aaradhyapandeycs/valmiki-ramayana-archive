[{"id":"VRCE-5-34-1","kanda":5,"kandaId":"sundara","sarga":34,"verse":1,"english":"The highly effulgent son of the Wind-god, Hanumān, to create Sītā's confidence, again addressed her with the following words.","alignment":{"type":"1:1","confidence":0.812,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-36-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5034001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a3e39f1b25fe6eec59e6256d663596b4963a6458eef8713cea085d6ca73e3879","compact":"e30992c37360fc568f0d503119ed1d34b97808ada031b386886aa1413aa09964","nasal":"e30992c37360fc568f0d503119ed1d34b97808ada031b386886aa1413aa09964"}},{"id":"VRCE-5-34-2","kanda":5,"kandaId":"sundara","sarga":34,"verse":2,"english":"O great dame, I am a monkey, the messenger of the highly intelligent Rāma. Behold this precious ring with Rāma's name engraven on it, given by your high-souled lord and brought as a token to create your confidence. Do you take heart and may good betide you, there will be an end of your grief soon.","alignment":{"type":"1:1","confidence":0.924,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-36-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5034002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"728d11752cae272eb529d0649037678f693a8198da2e94e0a0c8f7ae16920e70","compact":"db93586a97616d0f48af510c327a3e5d2aa0429d53ea6fe8f79954b58ec9a9ec","nasal":"3da3ab8e606311827a0201b439ea1f83a78b4c7fe6fae9a19288c2a9429564aa"}},{"id":"VRCE-5-34-3","kanda":5,"kandaId":"sundara","sarga":34,"verse":3,"english":"Taking the ring that used to deck her lord's finger and looking at it, Jānaki seemed to have actually got her lord.","alignment":{"type":"1:1","confidence":0.625,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-36-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5034003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dcb7375b43faaabdf96a69c9e30ab0529f134f337a2b6623707d31b52f1d546f","compact":"8467bb08461fd7b3226aa6074c4c8032d0396722a22d0f7432587eb6e4d8a33a","nasal":"0f49724736b5e14ba507e3d230b6cbd2e6be269ee7cc709f3e86baef12dbc171"}},{"id":"VRCE-5-34-4","kanda":5,"kandaId":"sundara","sarga":34,"verse":4,"english":"Her graceful countenance, having large eyes, looked, with delight, like to the Moon released from the possession of Rāhu.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-36-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5034004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac29153ef48999bc1f1636d8339c790b4a641a485064605151d63da8a7fb0895","compact":"b3e79bf239156d44b3345d4e7236ad646d6ea2a6e8f36117fb04f3c5136f22e3","nasal":"1d78e8fafaf769ecc0a18c2a7b0fec7a332b09011cc2594f3c08cad3a0ce1b7f"}},{"id":"VRCE-5-34-5","kanda":5,"kandaId":"sundara","sarga":34,"verse":5,"english":"And greatly delighted at her husband's news that modest damsel, affectionately welcoming Hanumăn, applauded that great monkey.","alignment":{"type":"1:1","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-36-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5034005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7dd00131a3e8ba4824b39aa530403c5727baf644b57e2e463141adcbe00225d","compact":"c91ae4273a38823134c7867bb151febf25c37ee0b988cb1dfb5d8ab6689098ab","nasal":"c91ae4273a38823134c7867bb151febf25c37ee0b988cb1dfb5d8ab6689098ab"}},{"id":"VRCE-5-34-6","kanda":5,"kandaId":"sundara","sarga":34,"verse":6,"english":"O foremost of monkeys, you are brave, powerful and wise, since you had alone smitten this abode of the Rākşasas.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-36-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5034006","sansk