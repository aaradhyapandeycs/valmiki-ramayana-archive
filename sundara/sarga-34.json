hared-sanskrit-ngram","duttRefs":["DUTT-5-36-44"],"status":"unreviewed"},"source":{"sanskritLocator":"5034045","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"da76ff46c418c6ad3a92feb61604935f0ae445752c0dd026371bce4eca12f546","compact":"03a28432259990b043d0863d56cdac6c80d0e50e00fb76c3e24425cd83a8e47a","nasal":"255a34c5478cfe4cdc97a47fb6844d47ca116bd64dcf8f9458cbf9fa2f8784ea"}}]
