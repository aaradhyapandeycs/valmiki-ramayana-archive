atus":"unreviewed"},"source":{"sanskritLocator":"5012027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cc07285f492d1bc1652c4be75703a8a87d0fbf5e634d10a46b41cbd8e8efed8d","compact":"2385bb7bdaddf8d928b5762cb61451b6af3d12d8a324e3e1210b2002db828cec","nasal":"0de1bab83cccbfa9217d5ee2d0b4499da30a46edbd77b2687e47cd4a41a15bb0"}},{"id":"VRCE-5-12-28","kanda":5,"kandaId":"sundara","sarga":12,"verse":28,"english":"Thereupon that foremost of monkeys beheld there a mountain-the most picturesque in the world, resembling clouds, having high summits, covered on all sides with peaks and filled with hilly abodes and various trees.","alignment":{"type":"grouped","confidence":0.842,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-14-20"],"status":"unreviewed"},"source":{"sanskritLocator":"5012028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"be14199e05fbad4d6f1b97a9babfe99976709f3ce70d0305fac46567ebb3b465","compact":"d812dbc10f98f15691bc137867c76967f81a3e0af6747eb5300925e943c4e045","nasal":"d812dbc10f98f15691bc137867c76967f81a3e0af6747eb5300925e943c4e045"}},{"id":"VRCE-5-12-29","kanda":5,"kandaId":"sundara","sarga":12,"verse":29,"english":"That monkey beheld there a river falling down from the mountain like to a damsel falling down from the lap of her beloved. And the branches of the trees touching the water (of the stream) resembled a fair damsel prevented by her dear companions from forsaking the company of her beloved).","alignment":{"type":"grouped","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-14-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5012029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"307ccc17377e7c891ce83ca088c5e94c722aa1f924ae11d0ed2de687956c7079","compact":"38f92c92b0dc64056da84a473fb726c83f9c883037028a1d4de5984cc54e6240","nasal":"e8817ce2a4e639a64fcf4141c6865ca42c8