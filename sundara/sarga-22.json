efs":["DUTT-5-23-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5022012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b0eefb76910d0d76c04465a5296bc5907f6467ab8a351817fa9bd6ea8917f19","compact":"7e7573f460acb4e77735fa5baa91afb50f434b3f479e2a6457105a5ae4444451","nasal":"c54cdd1854bc4686ff30ea7d94c986edefa2b12beac7785d81f2355e22cc4688"}},{"id":"VRCE-5-22-13","kanda":5,"kandaId":"sundara","sarga":22,"verse":13,"english":"The large eyed Sītā, encircled by the Rākşasīs, remained there sunk in grief. And all those hideous demons, showered reproaches, from all sides, on her, greatly reduced, of a poorly countenance, and wearing a soiled cloth.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5022013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"50ce5dd379252511c524dc6a56f562817d2258b574d796836bd4f0481c6bc886","compact":"5026142cab1e238fb1f6fda2aa84d9a9cbc1264b7e9a90f631dbf42098dbece6","nasal":"5026142cab1e238fb1f6fda2aa84d9a9cbc1264b7e9a90f631dbf42098dbece6"}},{"id":"VRCE-5-22-14","kanda":5,"kandaId":"sundara","sarga":22,"verse":14,"english":"The large eyed Sītā, encircled by the Rākşasīs, remained there sunk in grief. And all those hideous demons, showered reproaches, from all sides, on her, greatly reduced, of a poorly countenance, and wearing a soiled cloth.","alignment":{"type":"grouped","confidence":0.818,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5022014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4d0edc3295421881ae63de6de8c8b6e4d0cd7d7af7060c6c996c2d3a3c4fbfe","compact":"9e3c71cea08ae6fb3cb7eddaa67b8bd3e414c4aa794a83545cd56477992b013c","nasal":"09a1f64631b2af5352b09ea0f56fd7cf8003c668570c6b2b8ef839fcb9fea02d"}},{