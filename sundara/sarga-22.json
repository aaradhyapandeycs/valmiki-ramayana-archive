[{"id":"VRCE-5-22-1","kanda":5,"kandaId":"sundara","sarga":22,"verse":1,"english":"Thereupon all those Rākşasīs, having terrible faces again and again pursued Sitä with reproaches rough and rude.","alignment":{"type":"1:1","confidence":0.468,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5022001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"70c0f037d71a6eddc6784ffee3205362a70b0c16aed00733a1e24dc08febb599","compact":"4d783c083826c778de76fcb22ef423077d0b191ed51cadf1dff65e975e489ec6","nasal":"4d783c083826c778de76fcb22ef423077d0b191ed51cadf1dff65e975e489ec6"}},{"id":"VRCE-5-22-2","kanda":5,"kandaId":"sundara","sarga":22,"verse":2,"english":"Why do you not desire, O Sītā, to live in his inner apartment, liked by all and abounding in costly bed-steads.","alignment":{"type":"1:1","confidence":0.827,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5022002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f6f882c9c135b3581082acfdcceff4df372f195b7ab65575b2ebd06556f3a75","compact":"711cd9eac0dae1f69b7434b2a36bb77402b1cd827d507e89e2002d7c2e73dfba","nasal":"ebaf53ff53740ecdd5bdcdf2e745bb4e54acc86f160f698631ea3f5871365e37"}},{"id":"VRCE-5-22-3","kanda":5,"kandaId":"sundara","sarga":22,"verse":3,"english":"O woman, you regardest highly to be the wife of a man. Do you turn back from Rāma-your desire shall never be satisfied.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5022003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"787c903cc5a96d167cd808d9a08f3c68bd923cca4155e08d59ddbd6bba8724fe","compact":"b4624348d4af95c29416d1fef55cf84a90150ad8b1ef876b211d031b2cf22602","nasal":"ea0aba939322