a3386c4848d5ae210d101","compact":"c2c100302171c6774148f50a92313ea6620685d1b40d3185d382f09f5d0198be","nasal":"c2c100302171c6774148f50a92313ea6620685d1b40d3185d382f09f5d0198be"}},{"id":"VRCE-5-22-7","kanda":5,"kandaId":"sundara","sarga":22,"verse":7,"english":"A woman can never be the wife of a Räksasa. Eat ine up if you will, I shall never follow your words.","alignment":{"type":"grouped","confidence":0.626,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5022007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ff1d80e688b7f865cd05d715256598bbdf132657850ea817b4f46f5ad7771503","compact":"84a289c255808ff133a72ab47beafba93705d9ed8d050d84daac826b7b1819fe","nasal":"84a289c255808ff133a72ab47beafba93705d9ed8d050d84daac826b7b1819fe"}},{"id":"VRCE-5-22-8","kanda":5,"kandaId":"sundara","sarga":22,"verse":8,"english":"Hearing the words of Sītā, all those Rākşasīs despatched by Rāvana, almost beside themselves with ire, again covered her with reproaches rough and rude.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5022008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b3decd54d1deff977684cdd95d166fd381ad7039e4441841c0add6f038512ac2","compact":"33caf9cd4c45d11f2e6d378b543a522fb245fc86102d285bea756f2ce32b543f","nasal":"dded46864969c136a8c63074c35df32231570b5357cc2dadd5254d5dfe8ae90b"}},{"id":"VRCE-5-22-9","kanda":5,"kandaId":"sundara","sarga":22,"verse":9,"english":"Hanumān remained all along speechless and hidden on the ſinsapā tree. And that monkey heard all those demons remonstrate with Sītā in this way.","alignment":{"type":"1:1","confidence":0.731,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-23-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5022009","sanskritFile":"Ram05.txt","engl