[{"id":"VRCE-5-59-1","kanda":5,"kandaId":"sundara","sarga":59,"verse":1,"english":"All the heroic monkeys, headed by Angada and the great monkey Hanumān, approved highly of the words of Jāmbavān.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-61-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5059001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d091bf60a0ab0015acba62442a1fbf5a815ef51e3a6d63d376168e92d5f8cdd3","compact":"218423897fb38630aa7f69524a002dfa007c64b60489d173eb44c9c65c897246","nasal":"1846ff128ed94e707e2fdbcffa4a013e1f91498337bee6c4e24eb8b1372a875a"}},{"id":"VRCE-5-59-2","kanda":5,"kandaId":"sundara","sarga":59,"verse":2,"english":"And these leading monkeys headed by the Wind-god's son proceeded leading from the summit of the Mount Mahendra.","alignment":{"type":"1:1","confidence":0.792,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-61-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5059002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"16fe2869952c106f673324d49862f8fb0385668f156db8ae8a678d67081a0c89","compact":"92cc80217da3380efe050e69c8ba1353b1e1f200d655a1d8bbeeb7a32ce242f3","nasal":"a4c9a69dd1b356afb3487dbf84ffc3866e88cbd6f79029601171e359992498e7"}},{"id":"VRCE-5-59-3","kanda":5,"kandaId":"sundara","sarga":59,"verse":3,"english":"And there highly powerful ones, having huge persons, resembling the Mount Mandara, covered the welkin as if like so many mad elephants.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-61-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5059003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4dc0de4cc0b860cdf65c44ee51daaf589043ff9ddd8386416bde817f68a03304","compact":"f60f9f65e99986d59ed41dca1045009b69c998c0b1a10d6f2635a6fa5c4524d2","nasal":"cff