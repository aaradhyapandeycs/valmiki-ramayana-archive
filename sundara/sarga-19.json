_fingerprints":{"exact":"449c1b5a51fcf001c8e72e1aa12da3e734684f8f7aebb3a3fbd0eab2f069eabb","compact":"83159e237e25790c7ee37dd0883030a13e79433742c7a6b2c81eba6be9fb1108","nasal":"83159e237e25790c7ee37dd0883030a13e79433742c7a6b2c81eba6be9fb1108"}},{"id":"VRCE-5-19-25","kanda":5,"kandaId":"sundara","sarga":19,"verse":25,"english":"Janasthāna has been devastated, the host of Rākṣasas has been killed, and you had been disabled. Truly you had perpetrated an impious deed.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-21-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5019025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0736a58be921179a924c4914651ba3b9c2199a11d7ddc70f9c0f6f6125de61c4","compact":"6422b6798dd0487fa3dea0343b7e23eded1a7e33c05bbeff570b8e01c6ec404d","nasal":"6422b6798dd0487fa3dea0343b7e23eded1a7e33c05bbeff570b8e01c6ec404d"}},{"id":"VRCE-5-19-26","kanda":5,"kandaId":"sundara","sarga":19,"verse":26,"english":"O Rākṣasa, those two lions among men going out to enquire about the illusive deer, I was ravished by you, entering the empty hermitage O vile wight. And like to a dog incapable of standing before a tiger, it would have been impossible for you, to wait there in the presence of Rāma and Laksmana.","alignment":{"type":"grouped","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-21-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5019026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f57178888df5126ed1be37614e02077afededa60a56b276099f6fc48cb31b990","compact":"1034aebe2822fde52658d66596c64af9ac2ac2dd1ec5f3c42aad415281e5ff7b","nasal":"1034aebe2822fde52658d66596c64af9ac2ac2dd1ec5f3c42aad415281e5ff7b"}},{"id":"VRCE-5-19-27","kanda":5,"kandaId":"sundara","sarga":19,"verse":27,"english":"O Rākṣasa, those two lions among men going out to enquire about the illusive deer, I was ravished by you, entering the empty hermitage O vile wight. And like to a dog incapable of standing before a tiger, it would have been impossible for you, to wait there in the presence of Rāma and Laksmana.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-21-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5019027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9ea648e078787b4494b9431564f28484d37f3265f309bd019ae996e82c78d432","compact":"f44b63c154b33ec8b0e12eb6804cda27084493a00285cc6fb3307d29a6709076","nasal":"3fe1fa35231d47bfdb8352c716b16bc980177fdb84d35075738c3e5cef266188"}},{"id":"VRCE-5-19-28","kanda":5,"kandaId":"sundara","sarga":19,"verse":28,"english":"If do you engage in conflict with them, your wealth and friends shall be of no avail to you (and you shall be discomfited) like to onehanded Asura Vſtra by the two handed Indra.* *The allusion is-the mighty Asura Vrtra fought with Indra for a long time even after he had his one hand chopped off.","alignment":{"type":"1:1","confidence":0.901,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-21-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5019028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"24ee43d5efddd9d4fbaeaa9b7db6a8145d17a4caada8b0a733fb450abba5e8db","compact":"ad7662f388ff63dd9b4eb4ec6dcaadcfa77759d203f63f14af762d71672cadbc","nasal":"7f5bf81936bc563b11a1fc4da4554961f463926add013e0bba48434341be78c8"}},{"id":"VRCE-5-19-29","kanda":5,"kandaId":"sundara","sarga":19,"verse":29,"english":"Soon shall my husband, with the assistance of Lakşmaņa, draw out your life with arrows, like to the sun drying up, by his rays, shallow water.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-21-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5019029","sanskritFile":"Ram05.txt","englishEdition"