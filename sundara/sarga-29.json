[{"id":"VRCE-5-29-1","kanda":5,"kandaId":"sundara","sarga":29,"verse":1,"english":"Meditating thus the highly intelligent monkey speh in accents, sweet and in such a tone as they mighty be, heard by Vaidehī.","alignment":{"type":"1:1","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-31-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5029001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d39f436acea754882e4e41c305e3e62c744b57d7339e239073f2402ba7bcc51","compact":"d61c553cb5d41da119b7e51e02e1d5ae29b4c13724c970e590c0e4f45a577b23","nasal":"8969089b81789f10ca33c145b45a94127cf321308a88243aeb48bb27c277ea0a"}},{"id":"VRCE-5-29-2","kanda":5,"kandaId":"sundara","sarga":29,"verse":2,"english":"There reigned a noble and pious king named Dasaratha, highly glorious among the Ikşvākus, the lord of the warrior-cars, steeds and elephants.","alignment":{"type":"1:1","confidence":0.353,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-31-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5029002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"14a0ac95556ade6c2186a292085f6f1fc9e79603c0820d8f92c18fb833651d77","compact":"c2d1760a85b0aad2e0ce05ae0ec5727573c6ded79e5df4c00996d46ad80e0dab","nasal":"bf224257a48f81a79b1775f63f4e0c5571515bed756b9db0272c2328ae95e7aa"}},{"id":"VRCE-5-29-3","kanda":5,"kandaId":"sundara","sarga":29,"verse":3,"english":"Devoid of envy, high-minded, kind, having truth for his prowess, the foremost of the Ikşvāku race, wealthy and the enhancer of wealth; gifted with royal marks; highly beautiful; the foremost of the kings; famous all over the world of many occans; the conferrer of happiness and himself happy.","alignment":{"type":"grouped","confidence":0.747,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-31-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5029003","sanskritFile":"Ram05.txt","englishEdition":"M. N