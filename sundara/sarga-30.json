[{"id":"VRCE-5-30-1","kanda":5,"kandaId":"sundara","sarga":30,"verse":1,"english":"And beholding that tawny-coloured monkey like to a mass of lightnings and wearing a white cloth, hidden on the tree Sītā's mind was greatly agitated. And she saw there the humble, sweetspeeched monkey, appearing graceful like to a collection of full-blown Asoka flowers and having eyes resembling burning gold.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5030001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"68a71e7e908026fa299ea2ec494836d4885910546abb0ac36835c95f84baf8bc","compact":"bc948421da9eeb22fe42dca0bcebd207fac36944e29cadd527adc59afb932da8","nasal":"769c07cb0b73e4048e39442ed31f569963516e9028d4c39eba78958641301957"}},{"id":"VRCE-5-30-2","kanda":5,"kandaId":"sundara","sarga":30,"verse":2,"english":"And observing that foremost of the monkeys, sitting humbly, that daughter of the king of Mithilā, again greatly amazed, thought.","alignment":{"type":"1:1","confidence":0.53,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5030002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"57bc1254e1b62d6184be410c6104d11467cd6cfeea0e428523758eb613026bc8","compact":"4758255d52e827af8520586ac6d361bb985408c1a7b77f8e1163ec07e3337ba1","nasal":"5ffe91a6bbb555692497d403e3ebf03891e3874ff8093190530a7a7dcb12b157"}},{"id":"VRCE-5-30-3","kanda":5,"kandaId":"sundara","sarga":30,"verse":3,"english":"And beholding him Sītā was almost out of breath with fear. And regaining soon her sense the large-eyed damsel again thought.","alignment":{"type":"1:1","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5030003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"daec9ddd4f370f1f74c960ebfbfa755e0126877cc2f4986e6826062617d8153a","compact":"172c41a1f4663ef2fd75824b938c4830ef88a9f1ce12456bb0a6497a883b4a91","nasal":"fad9291c2b5f72dd9f5638af1a16dc5bb35432bff24b4f6f9fb2e2b6ff392400"}},{"id":"VRCE-5-30-4","kanda":5,"kandaId":"sundara","sarga":30,"verse":4,"english":"I have seen a very inauspicious dream to-dayto see a monkey in a dream is reckoned inauspicious by the sages. May good betide Rāma, Lakşmaņa and my Sire the king of Janaka.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5030004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8cba2e6231515e9adaa6f033772f0793205d0b144da6467a396a45e283ae7830","compact":"a1ef3c6a42e849bcddd2c3a9cd0bb9dd4d81d1061f5eb05074bac08496111f3f","nasal":"a1ef3c6a42e849bcddd2c3a9cd0bb9dd4d81d1061f5eb05074bac08496111f3f"}},{"id":"VRCE-5-30-5","kanda":5,"kandaId":"sundara","sarga":30,"verse":5,"english":"It is not dream, I have not slept, worn with grief and trouble as I am. Apart form my lord having the countenance of the full-moon, I have no happiness.","alignment":{"type":"1:1","confidence":0.802,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5030005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0a43c5fa80ffb1b3aa7e4490cb56c78df1b1c95bf281686585ff436184c249b6","compact":"bd5aee2d273827284537a6546c1f709be1896e9d767db6cc0b5fefe90dac8801","nasal":"d3fbd3cf9c443fe539b1ff400ef2cdfd02fd775c3c2173f1c8c70cf854694081"}},{"id":"VRCE-5-30-6","kanda":5,"kandaId":"sundara","sarga":30,"verse":6,"english":"And therefore his form appearing in my mind is distressing me to-day, who am entirely sunk in his thoughts. And thinking of him always I see him before me and hear his words.","alignment":{"type":"1:1","confidence":0.892,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5030006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"027b6b58be65e1cf56dcb07bc8549640dcdef637c095eff1deb1b3f21b62f2e4","compact":"7e861db18feeeda6fa2bea3bfd0ecf8e892517dfc193a9379fed37ee2c59a026","nasal":"b571f617c3f532f59bffd32e7cac30b49fe6313cdf5f8e29a943296c2a28c070"}},{"id":"VRCE-5-30-7","kanda":5,"kandaId":"sundara","sarga":30,"verse":7,"english":"Methinks this is but a phantom of the mind. And thinking this I still behold the same. But an imaginary object can never have a form. And I still find a distinct form addressing me.","alignment":{"type":"1:1","confidence":0.91,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5030007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a0b62c68194e7d83e1355105b9b452d9dc46edcbc9d0d06cafad926dad15935","compact":"892a4a2e569a662db33258940ccd9f8ca2ffe135d00895ddda63fb412932fb12","nasal":"c3a46bafea01420d8f0a381ad98ecb3c8e8839d91542fe4f482d4fec5baba86e"}},{"id":"VRCE-5-30-8","kanda":5,"kandaId":"sundara","sarga":30,"verse":8,"english":"Be glory to Vācaspati, Indra, the self existent Brahmā, the lord of fire and may they so grant that the creature who has spoken before me, be real and not imaginary.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-32-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5030008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4df8044f22ee1fbe9da37a7ffbdf9d1a3f79122970a116c79efeec2c3e618928","compact":"ec8f0f6a04344500cca775e478481d633d6537fcd8e5094c3333b1ee7d2ebaff","nasal":"49cb66a0dcae38c4019270a37f459985ca52b18380c2a8cf272f9505f5ec9f6e"}}]
