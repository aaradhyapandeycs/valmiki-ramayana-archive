[{"id":"VRCE-5-64-1","kanda":5,"kandaId":"sundara","sarga":64,"verse":1,"english":"Being thus accosted by Hanumān, Rāma, the son of Dasaratha, placing that jewel on his breast, wept with Laksmana.","alignment":{"type":"1:1","confidence":0.709,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-66-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5064001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd27f8981f383f0626d93b348e468ba115c11f9062802c6cce1b18eac16364ff","compact":"49d133433c4b1e87ecd59a1d60f2ad7e5e0f0bcc69a9cfacea9127a5d0605d4e","nasal":"49d133433c4b1e87ecd59a1d60f2ad7e5e0f0bcc69a9cfacea9127a5d0605d4e"}},{"id":"VRCE-5-64-2","kanda":5,"kandaId":"sundara","sarga":64,"verse":2,"english":"Beholding that excellent jewel, Rāghava, stricken with grief, with eyes full of tears, spake to Sugriva, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-66-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5064002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c57deb79f00f9bfd999f870cdcb52d4fa550000e73b30929221bf99714e5ab2","compact":"5b960a2a08afaf2467dac75cb9b01709370990ed5a3f66b311dafff64c5aa378","nasal":"5b960a2a08afaf2467dac75cb9b01709370990ed5a3f66b311dafff64c5aa378"}},{"id":"VRCE-5-64-3","kanda":5,"kandaId":"sundara","sarga":64,"verse":3,"english":"Forsooth my heart melt on beholding this jewel as milk trickle down from the udders of a cow on beholding its calf.","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-66-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5064003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d6d75c5da1d4b8ddd62aa0a9e0076ea9322ad6827ce544ebf5e088a019bbb1dc","compact":"7530ce2ab8e1acbd0684431beb6d25bc2023040aba837b0414f68db1249e7884","nasal":"7530ce2ab8e1acbd068