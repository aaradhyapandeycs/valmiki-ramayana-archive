[{"id":"VRCE-5-26-1","kanda":5,"kandaId":"sundara","sarga":26,"verse":1,"english":"Hearing those unpleasant words of Rāvana, the lord of Rāksasas, Sītā, racked with sorrow on account of her husband, became terrified, like to a she-elephant, worsted by a lion on the skirt of a forest.","alignment":{"type":"grouped","confidence":0.911,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5026001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8843e84beeff768f472ecd2ad6f3ca1d58b155404497a4f97ea97321764f5a6e","compact":"43708564b2b7e502ec28cfb0de79ee68ec9abe972493151eac2f256fcf00a5c0","nasal":"3f71715aca4154e256180f55e08c897d99350cae806ca49252f76ed6a8db2490"}},{"id":"VRCE-5-26-2","kanda":5,"kandaId":"sundara","sarga":26,"verse":2,"english":"Threatened by Rāvana and encircled by the Rākşasīs, that timid damsel bewailed like a girl cast off in a lonely forest.","alignment":{"type":"1:1","confidence":0.612,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5026002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cde68656baacff70de350c9c5cdf2e404720fc9d4e588f824a42704af26745df","compact":"c90a554abca5d2a2598a707987611f0ad7d06d4e6b23a81473024fd7b49e46a9","nasal":"fa0f56dabcc2624a9543693d9624e4f2629b0733fd3582ae7e4502bdf6c4dadb"}},{"id":"VRCE-5-26-3","kanda":5,"kandaId":"sundara","sarga":26,"verse":3,"english":"Truly the sages say that death in this world dose not come untimely. Or else would I have, vicious as I am, lived for a moment, being thus sorely threatened.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5026003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d0272478936d73df41007f61f1948bffa503affe320a05f0efef921db20c264c","compact":"969bd28bbf8847617aaabe3e3e461417fc12da867eea722aad418c5e03f7bb86","nasal":"fd7fe3bc13b21aeaf2c6a61ad0474b5f35f2e93d274b8b122bcf27ca16f926ef"}},{"id":"VRCE-5-26-4","kanda":5,"kandaId":"sundara","sarga":26,"verse":4,"english":"Forsooth, my mind, divested of happiness and full of misery, is firin or else why is it not broken in sunder like to the summit of a hill clapped by a thunderbolt.","alignment":{"type":"1:1","confidence":0.718,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5026004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ca0a6f62d0d3f29c982f72544a70a11f81fb48aba73202cf8afd6e18d4b0cc1c","compact":"cda26ac5d7c4f29f53095a76f4bd71d974dc265af5e1306be7caaa0e4b0a13d6","nasal":"33b9aaada9454f328c398981f50cdf5daadddc4b5270eed00f94d213d60e2c7e"}},{"id":"VRCE-5-26-5","kanda":5,"kandaId":"sundara","sarga":26,"verse":5,"english":"Nor am I to blame for this. I am worthy of being killed by this demon of uncomely presence. As a Brāhmaṇa cannot impart instructions in Vedas to the people of other castes so I shall not confer my mind on Rāvana.","alignment":{"type":"1:1","confidence":0.628,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5026005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"07362cfd5d939c3f4105b6b59f54c91f903b14940c2dea7f7608fe6c56a94aca","compact":"0fff6f0a8c4e564311bbb2d1e9f462f16b702cb7413d41a18bbf4fb1d44694d9","nasal":"641d8d57a8df52baee23d163de6fa9040165e0e253720e44f105a99532eeb3ba"}},{"id":"VRCE-5-26-6","kanda":5,"kandaId":"sundara","sarga":26,"verse":6,"english":"If that lord of the people dose not come within the appointed time, forsooth shall that vile lord, of the Rākşasas, mince my limbs with his arrows like to a surgeon cutting off the limbs of an embryo. (This passage clearly indicates that there were proficient and skilled surgeons at the time when Rāmāyaṇa was written.)","alignment":{"type":"1:1","confidence":0.775,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5026006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"468caae36bf6d26e8fbec3bd515bc8ea52677a0589963b8b6c093b3ce0180027","compact":"4aef467e4bb3f5b178b37cf3c51f43cbf8da505e43df7d1da166d7a09b6d2d1f","nasal":"e594e0c0dcabb21eb192a616269c7b3bb51eb56e69f2af10b82f65642308a880"}},{"id":"VRCE-5-26-7","kanda":5,"kandaId":"sundara","sarga":26,"verse":7,"english":"Two months shall pass away in no time and I shall have to suffer the pain of death, overwhelmed with sorrow as I am, like to a thief, confined in stocks, at the command of the sovereign to receive death the next morning.","alignment":{"type":"1:1","confidence":0.759,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5026007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b506aa7eedb6969f51c2ae95817e7af9e13850f192d1bb671316739317063c43","compact":"95fd5e22276e07ef5dae46e095395484e3974e35faf6d7b96d87df79f18a77fe","nasal":"9397366f6af6ac03487e755df0b5874210604d675f6349041d19e82cedc10283"}},{"id":"VRCE-5-26-8","kanda":5,"kandaId":"sundara","sarga":26,"verse":8,"english":"O Rama! O Laksmana! O Sumitra! O Rama's mother! O my mothers! I am worsted in this ocean of grief, like to a bark, driven hither and thither by the blast, in the midst of an ocean.","alignment":{"type":"1:1","confidence":0.9,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5026008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"566637914089e53eb4fd6304dc4e1f2a32974ff24af4a91181f4f52fa3af3ccb","compact":"c88f36d89cf3547134799694862848930bcf7d337b7c0ff180f9f24e625d7d46","nasal":"c88f36d89cf3547134799694862848930bcf7d337b7c0ff180f9f24e625d7d46"}},{"id":"VRCE-5-26-9","kanda":5,"kandaId":"sundara","sarga":26,"verse":9,"english":"Verily for me, those two powerful, lion-like sons of the king, have been killed by (this demon) effulgent like the lightning and assuming the semblance of a deer.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5026009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d41830236906f98bb770247e61c15f758c34def96459a02b73bdffd7b3aee5b6","compact":"f756a03ba613c77c602298d99f371cadd76ea106ed641f05709c71de8eaf3f56","nasal":"2ebe3b04f4a05cbf5021416cf6f6fa61b34b04c338baf28ea60f989330787e62"}},{"id":"VRCE-5-26-10","kanda":5,"kandaId":"sundara","sarga":26,"verse":10,"english":"Unfortunate as I am, forsooth I was tempted then by death wearing the shape of a deer and thus foolishly lost Rāma and Lakşmana, the sons of the worshipful sire.","alignment":{"type":"1:1","confidence":0.686,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5026010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"047b4ac45b81f4ef4292dcbb302a647ccb869f0b426681e879dc3ec1629514fb","compact":"2e3afd3896b8f1af7ec9c7d7a87cea903660debc6dde8ba8dd8d0db8f2c8cc66","nasal":"2e3afd3896b8f1af7ec9c7d7a87cea903660debc6dde8ba8dd8d0db8f2c8cc66"}},{"id":"VRCE-5-26-11","kanda":5,"kandaId":"sundara","sarga":26,"verse":11,"english":"O Rāma, O you of truthful vows, O you of long arms, O you having the countenance of a full moon! O my life! engaged as you are in the welfare of the people, do you not perceive that I am about to be killed by the Rākşasas.","alignment":{"type":"1:1","confidence":0.915,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5026011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ba86c9736e3409005db3150f3e625b5d1db31fc52a12db93b1caa80d04fc247","compact":"2eac879170aa5d4c95742e25ac225684daeb472b296ce4957e710dd4c8c24271","nasal":"d6601d1e1665e67d2360ac0654a1ff3c599d339910ca5f75eb61264900db0e66"}},{"id":"VRCE-5-26-12","kanda":5,"kandaId":"sundara","sarga":26,"verse":12,"english":"Alas! this my devotedness to my husband, my forgiveness, my lying down on the bare earth, my observance of religious vows, my wife-like virtues, are lost like to service done for an ungrateful wight.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5026012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bbb4e51f7e7e29827a25eb6781672028706cb692240915b51218d22f7a216221","compact":"a75ac1cb576e3605ef0b613ea7ba030a60c53848f614a10382ad2fcc5a334029","nasal":"a75ac1cb576e3605ef0b613ea7ba030a60c53848f614a10382ad2fcc5a334029"}},{"id":"VRCE-5-26-13","kanda":5,"kandaId":"sundara","sarga":26,"verse":13,"english":"In vain are my pious rites, and in vain is my devotedness to my husband since I do not behold you, am pale and feeble in your absence and have given up all hopes of seeing you.","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5026013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d40a94752715006fb449155df55abbc128c52a3ce41d0724e7775e7c9824afd7","compact":"d2e167d5fea0abc1c72173eeca2dc8a187e6ff5267d9c38711e652c69bc9cba3","nasal":"d2e167d5fea0abc1c72173eeca2dc8a187e6ff5267d9c38711e652c69bc9cba3"}},{"id":"VRCE-5-26-14","kanda":5,"kandaId":"sundara","sarga":26,"verse":14,"english":"And duly satisfying your sire's command, and returning successfully from the forest, you shall fearlessly sport with many a damsel having large eyes.","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5026014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7bee2fdc8f244501d33c1375182611da08bf49a93f922f02f0009fc4c74d134","compact":"27222141a39b3ab9ba74fd4800196a5ceafcd4d7003f5c628d7a13e3966bd973","nasal":"c828187b9ebc8980fdec07253036bcda9c26015b6bbef57cc45613fc46793b7f"}},{"id":"VRCE-5-26-15","kanda":5,"kandaId":"sundara","sarga":26,"verse":15,"english":"(But for me) O Rama, I was for my own destruction, devoted, soul and heart, to you. Oh! fruitless is my asceticism and wifely virtue! Oh fie on me! I shall renounce this my unfortunate life.","alignment":{"type":"1:1","confidence":0.941,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5026015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"41daeee4a7bb3ac995f2f2f2dc611c3a9289794c9b2d98d398d3cfe5c771f51f","compact":"5b845f4983df513dd1900ccc6592334dd979ce913cd9ae7fa90d4ac293229378","nasal":"5b845f4983df513dd1900ccc6592334dd979ce913cd9ae7fa90d4ac293229378"}},{"id":"VRCE-5-26-16","kanda":5,"kandaId":"sundara","sarga":26,"verse":16,"english":"I desire to do away speedily with my being by means of poison or a sharp weapon. But there is no one in this city of the Rākşasas, who bring me this poison or weapon.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5026016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e955fa3f8a99bc207346189b36922b7e1558a3d4a7c6914f62b7c60193fe15ce","compact":"c4c5661b413c0b21eae1ec15fa01161c300c29652035717af2702d7da7a5d43b","nasal":"c4c5661b413c0b21eae1ec15fa01161c300c29652035717af2702d7da7a5d43b"}},{"id":"VRCE-5-26-17","kanda":5,"kandaId":"sundara","sarga":26,"verse":17,"english":"Bewailing thus in various accents, and remembering Rāma with all her heart, Sītā, having her countenance dried up, and trembling, got at the biggest tree enveloped with flowers. And thinking thus, Sītā, stricken with grief, took up in her hand, her braid of hair and thought—\"I shall soon hang myself with this braid and reach the abode of Death.\"","alignment":{"type":"grouped","confidence":0.511,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5026017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"610a9fa31656454eba1748ea203ca8d732693e6c65072e3ef0eda3bf7889008e","compact":"29385bcf489d0704e2db76513fae59c2b4ab10cf9b1456fd0027239d293fce5f","nasal":"f0c2c17dddb539e8985a070a02328e6fc40bfe3553dc4c2efab5879d3869335a"}},{"id":"VRCE-5-26-18","kanda":5,"kandaId":"sundara","sarga":26,"verse":18,"english":"Bewailing thus in various accents, and remembering Rāma with all her heart, Sītā, having her countenance dried up, and trembling, got at the biggest tree enveloped with flowers. And thinking thus, Sītā, stricken with grief, took up in her hand, her braid of hair and thought—\"I shall soon hang myself with this braid and reach the abode of Death.\"","alignment":{"type":"grouped","confidence":0.927,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5026018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"48bc8717f806f5debf74ae12c19e9664981665340ecf8dffa883ac567cb7d582","compact":"a551b4167293de86edd1171a1f1c94e4c43fb39910283142f2f568f802ecf3b4","nasal":"56077f05dfa209b847ae2029f8020720d9ed73f2211a3fb7077ae0c3b6f1856c"}},{"id":"VRCE-5-26-19","kanda":5,"kandaId":"sundara","sarga":26,"verse":19,"english":"And that one of tender person reached the tree, and holding a branch, began to think of Rama, Laksmana, and the glory of her race. And on her person were perceived many auspicious marks, well-known in the world, removing grief, fostering patience and announcing the advent of future welfare.","alignment":{"type":"grouped","confidence":0.69,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5026019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e73afe02d3a235a33f9df6c6f42b09130506ef4dc9f74c8de4b89d69def8c941","compact":"b19a18473991cb73567d4d3e10d26dfbd9b9e1908ad0d6a30924a91235c4e26b","nasal":"159b3b644bceafd8f648259ff1594feeefefef9a2cfa84023b4277cf29bf2b81"}},{"id":"VRCE-5-26-20","kanda":5,"kandaId":"sundara","sarga":26,"verse":20,"english":"And that one of tender person reached the tree, and holding a branch, began to think of Rama, Laksmana, and the glory of her race. And on her person were perceived many auspicious marks, well-known in the world, removing grief, fostering patience and announcing the advent of future welfare.","alignment":{"type":"grouped","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-28-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5026020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e895355d067142733911d90dfbde4b21fca0a29f56f8197e40229a8ce72fa130","compact":"abd5669b9dc1b0a3d05403171003706633c004d1663b6c4ec1f0211169312b5a","nasal":"abd5669b9dc1b0a3d05403171003706633c004d1663b6c4ec1f0211169312b5a"}}]
