nglishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e1604b3d602045806635e503eb7f1b8dc1bef3842c6f8696167566b063b46f4b","compact":"06cc02ffe2f6651bde909fa41789b0b06e0e294a45b16baa360ed078e396025a","nasal":"d2a8f41abcd67c70fc74e9e445ea74685d26d0e0c757fb2dc1728a602c29497f"}},{"id":"VRCE-5-37-48","kanda":5,"kandaId":"sundara","sarga":37,"verse":48,"english":"And soon shall you behold the assembled heroic monkeys, endowed with the prowess of lions and tigers, and the splendour of the monarch of monkeys, and having nails and teeth for their arms.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-39-45"],"status":"unreviewed"},"source":{"sanskritLocator":"5037048","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d5f606993f1a2c6dc92cab99ebc0f254c276a8c478757f795e51bc41a3cd1e3","compact":"6d5097dfda75b887e9c7213306ee0a0c35058bd88f35be262d0cf76ce129c493","nasal":"77418122d5a1162daa7c94637eaa017bbda64bbaea8a0b2067d0f0d8ec6f1806"}},{"id":"VRCE-5-37-49","kanda":5,"kandaId":"sundara","sarga":37,"verse":49,"english":"And you shall, O noble one, behold innumerable companies of choice monkeys, resembling hills and clouds, roaring on the plateaus of Malaya in Lankā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-39-46"],"status":"unreviewed"},"source":{"sanskritLocator":"5037049","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d3d53490758cd3c936a19a90dd5d1d7dff3a5255ff4989ee0c75a9e749ab9c5","compact":"3cc9a013018d2854400a4b6fcb2f8c5ba948e60e88718e755a6697bc3feaa242","nasal":"e0c2aa08b51118ca153db7672e5b16f64978d0e8670290ed9249917d18f6c669"}},{"id":"VRCE-5-37-50","kanda":5,"kandaId":"sundara","sarga":37,"verse":50,"english":"Like an elephant tormented by a lion, Rāma afflicted in the vitals by the dreadful shafts of Manmatha, dose not attain ease.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-39-47"],"status":"unreviewed"},"source":{"sanskritLocator":"5037050","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8206c479814734b473dcd07953ed2ccdc8413d031edb1750a65148e3e51a2813","compact":"a5c790ff6c55f98ea96139fe6bca3ad609811fd44b7b038b78a5775f208fd2a7","nasal":"a5c790ff6c55f98ea96139fe6bca3ad609811fd44b7b038b78a5775f208fd2a7"}},{"id":"VRCE-5-37-51","kanda":5,"kandaId":"sundara","sarga":37,"verse":51,"english":"Do not weep, exalted one, in sorrow. Let not fear take possession of your heart! Even as Sacī meet with Sakra, shall you, O auspicious one, meet with your lord.","alignment":{"type":"approximate","confidence":0.233,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-39-48"],"status":"unreviewed"},"source":{"sanskritLocator":"5037051","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eb97359db6ba7d901e3432808203394b2c7fa5b062079a0e0ebdac0be9f9fc8b","compact":"af6bbc85fb974b9faceefe719a37ab79478af2b4be6a6cee19ecbc6102281133","nasal":"af6bbc85fb974b9faceefe719a37ab79478af2b4be6a6cee19ecbc6102281133"}},{"id":"VRCE-5-37-52","kanda":5,"kandaId":"sundara","sarga":37,"verse":52,"english":"Who is greater than Rāma? And who is equal to Saumitri? (i.e. Sumitra's son, Laksmana) And these brothers resembling Fire and the Wind, are your help.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-39-49"],"status":"unreviewed"},"source":{"sanskritLocator":"5037052","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d538aeac1bbe4c69fd18275c155f17b4e3a5c46f9f7d0aa21d605a629efa7313","compact":"420bc7353b31cb1e472d90642944b13538e3b00299d13d0f4eef10ad788abe17","nasal":"420bc7353b31cb1e472d90642944b13538e3b00299d13d0f4eef10ad788abe17"}},{"id":"VRCE-5-37-53","kanda":5,"kandaId":"sundara","sarga":37,"verse":53,