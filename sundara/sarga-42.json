[{"id":"VRCE-5-42-1","kanda":5,"kandaId":"sundara","sarga":42,"verse":1,"english":"Commanded by the lord of Rākṣasas, Prahasta's son, the powerful Jambumali, having large teeth, went out bow in hand.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-44-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5042001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ffbc51aab5c568c143f74717395bca1f1bc26a864104bfc90b1ea574d4a6a15b","compact":"06639cf688a1b01d631fb0b6b4904cab2c715fc469cb77fd3be926b2a71b32d4","nasal":"d2867107d2a8d278304960b03bec15c3973813f868b66af9cd9aabb3d343a5a1"}},{"id":"VRCE-5-42-2","kanda":5,"kandaId":"sundara","sarga":42,"verse":2,"english":"He wore a red wreath and attire, with a rings; and he was huge, and terrible, with his eyes whirling, invincible in encounter.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-44-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5042002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8884f579dbb70242e110061a6b82e3eaab964a653d660bf18232ed509004e093","compact":"c444f0c9cf83dcf4e67105a4579993feaaed8be622c731c2eab2962052ea68fa","nasal":"f96bb33c7c72207a4d8ccbbaed3f45cb708b73d20d364aeacac67c333db9e156"}},{"id":"VRCE-5-42-3","kanda":5,"kandaId":"sundara","sarga":42,"verse":3,"english":"He impetuously stretched a graceful bow, resembling the bow of Sakra, and roaring like vajra and the thounderbolt. (For distinction between the two, vide ante).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-44-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5042003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"26c6da7be0ba7db8c025a7344cdfe74562569d97bb16502125a3517977c742c1","compact":"dacce5886b4ff61632d79207e01c4a674732