"compact":"1bfadb2f61efbb571a158047c495c27edd505c29b69b8dd10184bec662d444eb","nasal":"1bfadb2f61efbb571a158047c495c27edd505c29b69b8dd10184bec662d444eb"}},{"id":"VRCE-5-10-24","kanda":5,"kandaId":"sundara","sarga":10,"verse":24,"english":"Seeing that the endeavours of the monarch of monkeys, as well as the bounding over the main, had come to nought, the offspring of the Windgod was plunged in thought.","alignment":{"type":"1:1","confidence":0.853,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-12-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5010024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ebf90c83b08a1cb30ba0e0dc0b8c6cc929ddea8c4fa57fe1016661f599de9f24","compact":"22ac6a1e54fbe9b508e62bb1d55be55f328f8a7a2b86262baa8e7d943b3080c0","nasal":"49a0f69c670bf46bab241f563451381b6b9a5a1ee0769deaee85637c90c51123"}},{"id":"VRCE-5-10-25","kanda":5,"kandaId":"sundara","sarga":10,"verse":25,"english":"Descending from the aerial car, Hanumān, son to the Wind-god, his senses deprived by sorrow, was again wrought up with anxiety.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-12-22"],"status":"unreviewed"},"source":{"sanskritLocator":"5010025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"216ec655170fdf6338f3d814b7c180353d4d1baabac07874f4184add6bfd304d","compact":"650cdf0615c42af655ba706602becff182db475fb500a55b94bec471a50ee71c","nasal":"66f06b53fbef3617ddb5496ade73a69ec29713d58377c9c44921fa4a98632c05"}}]
