[{"id":"VRCE-5-23-1","kanda":5,"kandaId":"sundara","sarga":23,"verse":1,"english":"Those hideous Rākşasīs thus threatening her with reproaches rude and rough, the daughter of the king Janaka began to weep.","alignment":{"type":"1:1","confidence":0.947,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5023001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d809a278b6fcc390969fbb748e667331fd62c9f4aabe8b87f54cd0b923006116","compact":"0f3f9f64b9b9721c9bbe4910841c20c4f37ba2e64723e39d0aee8fb3e9e131de","nasal":"dffa402726e6b27d831d9c274191bd4c5ff17e7b9dd80245c1b5f033f3f70e7f"}},{"id":"VRCE-5-23-2","kanda":5,"kandaId":"sundara","sarga":23,"verse":2,"english":"And being thus addressed by those Rākşasīs, Vaidehi, of subdued soul, being greatly terrified, said, having her voice choked with vapour.","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5023002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e1557d34e0031b08213964fced2d610d499b98cddd4182d1155194bf6400f101","compact":"0a95a126cb2f6cfa11d9d3c528f94f5e3869c3d54b2486980df31d1ac71de420","nasal":"0a95a126cb2f6cfa11d9d3c528f94f5e3869c3d54b2486980df31d1ac71de420"}},{"id":"VRCE-5-23-3","kanda":5,"kandaId":"sundara","sarga":23,"verse":3,"english":"A woman can never be the wife of a Räksasa. Eat ine up if you will, I shall never follow your words.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5023003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78bbe29b9ddddde91ebe1b546ba9f2e3adf905fbf0276e18e1b4f32a2f609608","compact":"ce83207f1f4113d759434996bb950d3b048b733cd648c4ecc67b89fd1cfe9ff4","nasal":"ce83207f1f4113d759434996bb950d3b048b733cd648c4ecc67b89fd1cfe9ff4"}},{"id":"VRCE-5-23-4","kanda":5,"kandaId":"sundara","sarga":23,"verse":4,"english":"And being surrounded by the Rākṣasīs and threatened by Rāvana, Sītă, resembling the daughter of a celestial, stricken with grief, could not console herself.","alignment":{"type":"1:1","confidence":0.655,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5023004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"629d12cbcb0f55814f7f8c3a7a218656a38114a322a6c6282f448c6ece79b2cf","compact":"a16d4c53fd96c4e17cff05ef4beaef8163a4d3163d338908938bcad83893a306","nasal":"a16d4c53fd96c4e17cff05ef4beaef8163a4d3163d338908938bcad83893a306"}},{"id":"VRCE-5-23-5","kanda":5,"kandaId":"sundara","sarga":23,"verse":5,"english":"And trembling, she shrank from their presence like to a strayed fawn surrounded by wolves.","alignment":{"type":"1:1","confidence":0.905,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5023005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f1eb7102640b38db7f484558851ce5781cf4165a469b92687f6f81219b9f4a53","compact":"6bd64283684789cf9bf73eb044966c89918a36394e1fd2d28249230dba938cf6","nasal":"abc48f80d6e09e3d71a21b635d4c57aafe1d79d9089698631ad78bea4503b162"}},{"id":"VRCE-5-23-6","kanda":5,"kandaId":"sundara","sarga":23,"verse":6,"english":"And resorting to a flowery branch of an Asoka tree, she sunk in grief, thought upon her lord.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5023006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"92d9aebc0cc99c0ca68b97d12dca605466c290cb8bd97ee8e3c178eceb598030","compact":"b65c3a9e32deb6dfdaf3d2b940a78db0e67710097c15944b2199bb56598c19a9","nasal":"c97791a62f10807c25e57a029f66e4e9236417ae8c0368c92125e3f64a0961a2"}},{"id":"VRCE-5-23-7","kanda":5,"kandaId":"sundara","sarga":23,"verse":7,"english":"With tears she bathed her beautiful breast and oppressed with woe, she could not reach the other bank of the ocean of grief.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5023007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"042d8cfbb54556790c8e835943403b2903ec7e9dfaca9a4a5527753da830db47","compact":"0820884f2ec7fe95da58ffbb5f8458b6a76519fe923b4a7429ea7eb6237728b5","nasal":"e151f998e0d91fed99cd5bb950b50c3ae565cd6d0d5329f550fdc40b12bcf8c0"}},{"id":"VRCE-5-23-8","kanda":5,"kandaId":"sundara","sarga":23,"verse":8,"english":"Like a plantain tree shaken by the breeze, she shook and fell down trembling (on the earth). And being afraid of the Rākşasīs, her cheeks forsook their native hue.","alignment":{"type":"1:1","confidence":0.815,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5023008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dcbfea7ba57e769888278175100a70a036a5fe73f79937d9e3d2c900d268ebea","compact":"a50f0678d8938ff6c1dd57f13fa727db7d5fd466f2ccf6da2a3560e1041f946a","nasal":"a50f0678d8938ff6c1dd57f13fa727db7d5fd466f2ccf6da2a3560e1041f946a"}},{"id":"VRCE-5-23-9","kanda":5,"kandaId":"sundara","sarga":23,"verse":9,"english":"And herself trembling, her pretty long lock of hair also shook and appeared like a serpent moving this way and that.","alignment":{"type":"1:1","confidence":0.607,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5023009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e3a03e003851b12699b0a648dc4a1eb4d598ac2b5a354ef1e278f4c267b3bd25","compact":"97ab048dda6d747660a4cdcc787042966b0426fc679c3d813e268adf2d6a622e","nasal":"2c4f7cfa203bea4e5ebe61d17618745cb7f1ed17fe6482329f1f250158560ec1"}},{"id":"VRCE-5-23-10","kanda":5,"kandaId":"sundara","sarga":23,"verse":10,"english":"Overwhelmed with grief and beside herself with ire, the daughter of the king of Mithilā, wept and exclaimed sorrowfully, O Rāma, and again, O Laksmana, O mother Kausalyā! O queen Sumitrā! true is the saying of the wise that death dose never approach untimely the male or the female.","alignment":{"type":"grouped","confidence":0.69,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5023010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fc4190d2d0de4f63dee94dfce66903237a50502fa21e8318f160918df89c74a9","compact":"b3dac91a63ed1cc83540390e2db02bba1231af6155daab222a02f0b63e49b8f4","nasal":"df04b7ae41b9d9865a847de04c1b028f070eb9f90f9d2b343bd7668364d5bfdb"}},{"id":"VRCE-5-23-11","kanda":5,"kandaId":"sundara","sarga":23,"verse":11,"english":"Overwhelmed with grief and beside herself with ire, the daughter of the king of Mithilā, wept and exclaimed sorrowfully, O Rāma, and again, O Laksmana, O mother Kausalyā! O queen Sumitrā! true is the saying of the wise that death dose never approach untimely the male or the female.","alignment":{"type":"grouped","confidence":0.508,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5023011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"90869c7c3403a6298239ff1cf98baebb295d8b8aaf10b7b23e26b95ba4eee6f3","compact":"218da1925b88d77e532ae0ca3dd6f7f498d55931fb3654250ce5f6f4caa3d153","nasal":"218da1925b88d77e532ae0ca3dd6f7f498d55931fb3654250ce5f6f4caa3d153"}},{"id":"VRCE-5-23-12","kanda":5,"kandaId":"sundara","sarga":23,"verse":12,"english":"Overwhelmed with grief and beside herself with ire, the daughter of the king of Mithilā, wept and exclaimed sorrowfully, O Rāma, and again, O Laksmana, O mother Kausalyā! O queen Sumitrā! true is the saying of the wise that death dose never approach untimely the male or the female.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5023012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9dc2bff40d8eabccec9612575724731a0dc9a3b74f5d0487f04c5b42e06cdd18","compact":"ac49967f4ebd83665437f9b5b1e4ced1df5c9bf4bb97bd12b6416f45616e922e","nasal":"d48b35e8882efaa4fd361c3c1da407d62e21a07a2f2d287f2de16fdf6838b3f4"}},{"id":"VRCE-5-23-13","kanda":5,"kandaId":"sundara","sarga":23,"verse":13,"english":"Or else I would not have lived for a moment, separated from Rama and oppressed by the Raksasis as I am.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5023013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"50796b63d17c3649c31ec5b9cc3ad7ad0c5d8075d1063d1863c5b8c29444dedd","compact":"891c7f3de764c6b29bde8eb71274bb4ae10108cd868edf24febadc1bac6fe220","nasal":"891c7f3de764c6b29bde8eb71274bb4ae10108cd868edf24febadc1bac6fe220"}},{"id":"VRCE-5-23-14","kanda":5,"kandaId":"sundara","sarga":23,"verse":14,"english":"Limited is my virtue, and therefore I am to die the death of a poor deserted thing like to a bark driven by the blast in the midst of the ocean.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5023014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9b6c1e35922838944b400ff49330efc91c932f12c29a9689d8a29da463a7c41b","compact":"7760b2448a34d53ddd33c1d46e8b779b21e8af9d7dc8720d0311f5e45f4468b1","nasal":"7760b2448a34d53ddd33c1d46e8b779b21e8af9d7dc8720d0311f5e45f4468b1"}},{"id":"VRCE-5-23-15","kanda":5,"kandaId":"sundara","sarga":23,"verse":15,"english":"Debarred from my husband's sight and tortured by the hideous demons, I shall sink, oppressed with woes, like to the banks of a river, washed by the water.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5023015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b5c5475b1749ceaaff247d44c393ddae8b079a7bccc8f04b6c7625b1b2255326","compact":"6dbdfe2ab4c5a7d0431c1ef34a76e967d3f9087ff7840a1adcc78ad450eb318b","nasal":"12a86b2bbf632b07317e226984cb7bc590a9eb45fb88c29fffafaf8cc4e5b3b4"}},{"id":"VRCE-5-23-16","kanda":5,"kandaId":"sundara","sarga":23,"verse":16,"english":"Oh blest are they who have been resting their eyes upon my grateful and sweet-speeched lord of leonine gaits, having eyes resembling lotus petals!","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5023016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e131860c546629a332a63ae55181a550a5dc220c0e2a3f40890492fe9d271781","compact":"a1526cc8441ff73d6fbc67523782cf986258ef3de4f8175da2b6006cc641dbe3","nasal":"b8b13ade94609d5210b02ed41d61c7c19615503e544e49fb2912e6f197e5e05d"}},{"id":"VRCE-5-23-17","kanda":5,"kandaId":"sundara","sarga":23,"verse":17,"english":"And separated from Rāma of subdued soul, it is as difficult for me to breathe as for him who has drank up virulent poison.","alignment":{"type":"1:1","confidence":0.774,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5023017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"94f780fc5f6230f9e2b394725a3467549d5498a2f4fa92811940ee7b32772e65","compact":"d9289fa036333b273fcde1e73f85804dfa7fd100f81ffb6fb04f2ac47b8851ee","nasal":"d9289fa036333b273fcde1e73f85804dfa7fd100f81ffb6fb04f2ac47b8851ee"}},{"id":"VRCE-5-23-18","kanda":5,"kandaId":"sundara","sarga":23,"verse":18,"english":"What mighty iniquity had I perpetrated in my previous existence that I have met with this terrible disaster!","alignment":{"type":"1:1","confidence":0.452,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5023018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7e9a49eeaf2c66ee7063b5a147b950305ab594fa9455e541a61142a02d4cb9b6","compact":"e9d222a1b3588c96609f1bcb44d4b4d0bdd3e793af353b6ecf2aa319ed31da45","nasal":"0fcc35a082b8abd468b02e95aa8534a842101689e5267dae63a49abd0afd8b23"}},{"id":"VRCE-5-23-19","kanda":5,"kandaId":"sundara","sarga":23,"verse":19,"english":"I wish to renounce my life under this load of grief-but alas! I am surrounded by the Raks asis and cannot meet Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5023019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8c69bf3f010b60e9aedf7018d7a51db74f42efaa6fe83f0a81d78abbdea785dc","compact":"ee7c7612c844b814bbbdf038ff168f3354c73c900bc7601e440880b69f3a858b","nasal":"e0a6e51632a7372084cb28c796fc55851a96d22df37ec5b63feb0881069117dc"}},{"id":"VRCE-5-23-20","kanda":5,"kandaId":"sundara","sarga":23,"verse":20,"english":"Oh! cursed is this subject human life, that they cannot renounce it even at their pleasure!","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-25-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5023020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0c00445d11677e64f8969846a17dced02b7501756cea68b89c811bd40d413bbd","compact":"129f3eeef23cbb17a49ff819a7555e2030c42c2254a899eb991d844209736871","nasal":"02c2c034110b67815bb58aae5ab399e0daff87c364321772e8d6508d64ca9e87"}}]
