[{"id":"VRCE-5-28-1","kanda":5,"kandaId":"sundara","sarga":28,"verse":1,"english":"And the powerful Hanumān, heard from the beginning to the end (the bewailings) of Sitā, the story to Trijatā's dream and the threats of the Rākşasīs.","alignment":{"type":"1:1","confidence":0.957,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5028001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b99e479af1bb9dbe063d0e4c7fb575fa9e816abc46daa6726a219ee54463616d","compact":"12202f1b2bce6b17814af17ceba4bc6e5fe0406b887c8cf3d578ef07c8d2d1ae","nasal":"c8026a95619bbb24ee9fed76d536d9ac042caa6588ba88c2949454c3e2fb8684"}},{"id":"VRCE-5-28-2","kanda":5,"kandaId":"sundara","sarga":28,"verse":2,"english":"And beholding the worshipful damsel, living in the forest of Asoka, like to a celestial damsel in the garden of Nandana, the monkey-entered in a maze of anxious thoughts.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5028002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72056782f203a790d466b1e9a1c7faa0de26b04d32edd6a1a04726e45cf46fde","compact":"53fe26cad353c572d9e80af0e36e06dbdc533ae50c260c32eb015acd80efdc34","nasal":"b00299dd9b28a61c84602737e5f0b3baa2838d658edb0e9c224b02c54958376a"}},{"id":"VRCE-5-28-3","kanda":5,"kandaId":"sundara","sarga":28,"verse":3,"english":"At length my watchful eyes have seen her, whom have been seeking in vain, the thousands and millions of the monkeys in all directions and quarters.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5028003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee62b25a4e0520add789d2c708a8351bc95ae5350f74491a5056e4dd52a181fe","compact":"1ace945563d6aa5ab71caa5922209ad7f7e92819f99ec32c2284fb3d7d42e96f","nasal":"062762282375c2d27744e4e35758775d4048251c1e40e47ea86d597e01a643b9"}},{"id":"VRCE-5-28-4","kanda":5,"kandaId":"sundara","sarga":28,"verse":4,"english":"Truly have I seen her today, engaged as I have been as a spy to estimate the strength of the enemy and am ranging secretly everywhere. I have seen minutely the city of the Rākşasas, and the strength of Rāvana the lord of Rākşasas.","alignment":{"type":"grouped","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5028004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a7e6988ea8a4a33cdf3e945003f61cae336c309449908c512243730a30ae1004","compact":"e156989313d106dccd75faba2eb3c8867c63d4f9433b98b8d7ee8c60525b6cc9","nasal":"e156989313d106dccd75faba2eb3c8867c63d4f9433b98b8d7ee8c60525b6cc9"}},{"id":"VRCE-5-28-5","kanda":5,"kandaId":"sundara","sarga":28,"verse":5,"english":"Truly have I seen her today, engaged as I have been as a spy to estimate the strength of the enemy and am ranging secretly everywhere. I have seen minutely the city of the Rākşasas, and the strength of Rāvana the lord of Rākşasas.","alignment":{"type":"grouped","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5028005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fce46ba7ce64323d69b89e2d8ced86c35bf93ff55bd393650561f522e25aefcc","compact":"65d36322e83d475600c2a0700bf6047e9f01977698b01590ff568e9415201273","nasal":"65d36322e83d475600c2a0700bf6047e9f01977698b01590ff568e9415201273"}},{"id":"VRCE-5-28-6","kanda":5,"kandaId":"sundara","sarga":28,"verse":6,"english":"It now remains to console the spouse of Rāma of incomparable power, and kind to all, who pants for her lord.","alignment":{"type":"1:1","confidence":0.913,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5028006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"73f3d5301a9c14c8c9c10c1bc481342b090b816d3e98cdb47fe4ad98710148ec","compact":"774034f405672648f737bba287a4170137f476f9ca8ada2088e94e4d7ea4b3c8","nasal":"d862f1ff78c90068ae26e8d93c519c1c77881b735cf1dffebf9bae0c0bc77086"}},{"id":"VRCE-5-28-7","kanda":5,"kandaId":"sundara","sarga":28,"verse":7,"english":"I shall console this damsel, having the countenance of the full moon, who had never seen grief before, and who shall not soon reach its end.","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5028007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f07520c28b94adf039dee16ccd08e7abbf5e253625a870a8a63e5af8f748b1b0","compact":"f126bf30dfecf403cc2e42d4e760dc3c83fe3c21e60567066f5e40940d4931c3","nasal":"951f7f18157ba9c303c7b63dacc92181c6bcf545949380113888a622ee274d62"}},{"id":"VRCE-5-28-8","kanda":5,"kandaId":"sundara","sarga":28,"verse":8,"english":"And if I go away without soothing this chaste lady, who is almost senseless with grief, I shall be blamed of neglect of duty.","alignment":{"type":"1:1","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5028008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d4fae1c916dfeeecfc0b16b95fc99a7fe764663f2dc13a311818fea3395504ea","compact":"f0d17ef754576c6520d645a5588543bf7e022002f1f436512c0593f5b5ac603e","nasal":"f0d17ef754576c6520d645a5588543bf7e022002f1f436512c0593f5b5ac603e"}},{"id":"VRCE-5-28-9","kanda":5,"kandaId":"sundara","sarga":28,"verse":9,"english":"And if I go away, the royal daughter, the famed Janaki, finding no means of safety, shall, for certain, renounce her life.","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5028009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9b4f45dc3d470c6812c6bd8126ea5b92a2ba59b9c0595e6d3f27e3db79ce5b8","compact":"0312cb1955aac8830ed3bc7673f5f4f51dbd0b944478649ced7768ff8d77e51c","nasal":"c941a880ac0b4232b16616d87f4e3e25d2fbf7429039848172bdda43189b73b0"}},{"id":"VRCE-5-28-10","kanda":5,"kandaId":"sundara","sarga":28,"verse":10,"english":"She is worthy of being consoled like to the great armed (Rāma) having the countenance of the full-moon and anxious to behold Sita.","alignment":{"type":"1:1","confidence":0.966,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5028010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f2eac8799e872a036d53ea2f6ecae6597ca1fb5d9c0dc73a2f17c3dcaecace8d","compact":"34f0341fe606f63a4696a40af2cbedde59d175783a40888ec15afe9a70def17c","nasal":"3e73dcb1b10f8977b3ea6e108ea790a4dfe942e1b6cdbff8ef5c104c775f8a32"}},{"id":"VRCE-5-28-11","kanda":5,"kandaId":"sundara","sarga":28,"verse":11,"english":"It is not proper to speak before the Rākşasas-What shall I do them? I am in very great difficulty.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5028011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c24cda3e18ab779acdc65cb8b62f3a97c38320363fd79ff3523d28d5697f1830","compact":"dd52137c82da683e868821589569ce1862748b3b35df1758b8e299a20fc1c0a8","nasal":"dd52137c82da683e868821589569ce1862748b3b35df1758b8e299a20fc1c0a8"}},{"id":"VRCE-5-28-12","kanda":5,"kandaId":"sundara","sarga":28,"verse":12,"english":"If I do not console her at this later end of the night, surely shall she renounce her life.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5028012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7c1af3730b0a006f932eec3cf9caac357be511de8571098554b6f8ac9ef576f","compact":"fec1f787cf8b5b02efe25769bcb113f779da61b70bc2472dd687fcd3ea71e3e4","nasal":"fec1f787cf8b5b02efe25769bcb113f779da61b70bc2472dd687fcd3ea71e3e4"}},{"id":"VRCE-5-28-13","kanda":5,"kandaId":"sundara","sarga":28,"verse":13,"english":"How shall I answer Rāma, without consoling Sītā of comely stature, when he will ask me “What message from my Sītā?”","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5028013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f6aaace559215c7358b40646a107c5d389c4f85e42eac640e9de53840af3ff11","compact":"8348399d6bfaa8fc1643e31c08b72f28c24a0435c4a4914af494e598c1bb3904","nasal":"8348399d6bfaa8fc1643e31c08b72f28c24a0435c4a4914af494e598c1bb3904"}},{"id":"VRCE-5-28-14","kanda":5,"kandaId":"sundara","sarga":28,"verse":14,"english":"And if I speedily repair hence without any information regarding Sītā, surely shall Kākuthutha scorci me lifeless with the fire of his angry eyes.","alignment":{"type":"1:1","confidence":0.716,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5028014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e11bb254cd189b07d9e7ac4568222676b1ad3a7b2755b729438a904ffc730f74","compact":"da5cf1e92ae1d6e7fbe18cd29afc692de4fcb879a64f2ea54ba80ff115806212","nasal":"da5cf1e92ae1d6e7fbe18cd29afc692de4fcb879a64f2ea54ba80ff115806212"}},{"id":"VRCE-5-28-15","kanda":5,"kandaId":"sundara","sarga":28,"verse":15,"english":"And if I urge my lord the king (Vibhīşaņa) to bring his hosts here for Rāma, in vain shall be his toil. (For before that Sītā shall renounce her life.)","alignment":{"type":"1:1","confidence":0.918,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5028015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7d36092cb3affbae8236a75e0a342a2bf0f1161ce197a92257a1910b98fc0dfb","compact":"f732a38179880f1e11a2a302b2f4e461691c81bc13a15d39c0e7bfa281a8d0d4","nasal":"f732a38179880f1e11a2a302b2f4e461691c81bc13a15d39c0e7bfa281a8d0d4"}},{"id":"VRCE-5-28-16","kanda":5,"kandaId":"sundara","sarga":28,"verse":16,"english":"And seizing the occasion when she shall be free from her demoniac guards, I shall console her in her dire distress.","alignment":{"type":"1:1","confidence":0.629,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5028016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c690f788009af23217e6afec337752220002abda5a0dd482ae12ad7b98ca9e7","compact":"80719fa791e37c47bead7e787f8296cb721b7cd9c377cbe9bd06570564f2e662","nasal":"13615c93c23718b683b9342144b84b59e59dee2a5c2a0a297160d468f5cc175e"}},{"id":"VRCE-5-28-17","kanda":5,"kandaId":"sundara","sarga":28,"verse":17,"english":"And a puny monkey as I am, I shall speak in Sanskrit (The language refined by the strict rules of grammar) which men delight to use.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5028017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c43238b60be5db22b6383b2255984c882294274dde7c0d3207fd2dc2330833d","compact":"07d1a64e3a6340537bf8c981f772b7ce686908e1b5346313b29dab9dfff46bc1","nasal":"07d1a64e3a6340537bf8c981f772b7ce686908e1b5346313b29dab9dfff46bc1"}},{"id":"VRCE-5-28-18","kanda":5,"kandaId":"sundara","sarga":28,"verse":18,"english":"And if I speak Sanskrit like a Brāhmaṇa, Sītā shall be terrified considering me Råvaņa.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5028018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6183f87cafda6fdb2f41e6fe1c4b200e75f2ae2202ca45ff88e28488bc909194","compact":"ebe1111af377dc11002ae1d5974951e99932ce7f97ba21123f3429b0a7cdbb0e","nasal":"ebe1111af377dc11002ae1d5974951e99932ce7f97ba21123f3429b0a7cdbb0e"}},{"id":"VRCE-5-28-19","kanda":5,"kandaId":"sundara","sarga":28,"verse":19,"english":"Must I therefore use the language of a common man or else I shall not be able to console the dame of a blameless person. (This passage clearly indicates that Sanskrit if not spoken by men, and women of the upper classes of the time when Rāmāyaṇa was written, was at least understood by them, and was commonly spoken by men of priestly class and other educated persons\")","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5028019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c960b6b8d8e7c446759daaed430bc8bafa0e3ca7b7bc3945392b782796bb5ffc","compact":"b1fda17a23f088b39b0d284df82059fca33797cf136a8fd392f3bcf932f23a45","nasal":"7d883bb60fe40bdd9fffa3fa44ad7d53c7a22946bd4ae2d81812b5ad0db64f07"}},{"id":"VRCE-5-28-20","kanda":5,"kandaId":"sundara","sarga":28,"verse":20,"english":"And beholding my monkey shape and hearing my human language she might be afraid again, terrified as she had been before by the band of the Rākşasas.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-19"],"status":"unreviewed"},"source":{"sanskritLocator":"5028020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42581c4c9d6782d773f61e11cc6dccabab32250b799208a51def40f010436c54","compact":"2b161e8ff6709925ad31f3599adf19aafd16f486320dc2250250d79353f651aa","nasal":"2b161e8ff6709925ad31f3599adf19aafd16f486320dc2250250d79353f651aa"}},{"id":"VRCE-5-28-21","kanda":5,"kandaId":"sundara","sarga":28,"verse":21,"english":"And considering me Rāvaņa wearing shapes at will, that large-eyed and high-minded dame, shall cry piteously for help.","alignment":{"type":"1:1","confidence":0.82,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-20"],"status":"unreviewed"},"source":{"sanskritLocator":"5028021","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b968096f88d174e622a6a1149317652bc3b7687b0a13750cff946817883711d5","compact":"035a5793072c03680dfe0f05dc9b365b13eaecbe7cde2269f444995ef0f61a40","nasal":"035a5793072c03680dfe0f05dc9b365b13eaecbe7cde2269f444995ef0f61a40"}},{"id":"VRCE-5-28-22","kanda":5,"kandaId":"sundara","sarga":28,"verse":22,"english":"And Sītā making a sudden noise, those terrible Rākṣasīs resembling Death himself and arined with various weapons, shall at once arrive there.","alignment":{"type":"1:1","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5028022","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f124d1de0324522312b02d9637481520cf7f0a0429ce90b4fdf8d3fa2d67d749","compact":"46ecdd8b9dddba4aa42cefb4d9b74f3d7e4dd82e6a09cd8dfee02339aebfdfa5","nasal":"bd68991d82bceaca128fbf7f66e0c1e1fa1f43e2a72960d9e5922252181dc06c"}},{"id":"VRCE-5-28-23","kanda":5,"kandaId":"sundara","sarga":28,"verse":23,"english":"And thereupon casting their looks all around and finding me out, those highly powerful and grim-viasged demons shall try to kill or catch ine.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-22"],"status":"unreviewed"},"source":{"sanskritLocator":"5028023","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"74c92d0ef72bc3e1932bca2cecf6d093183bea6ead36e59fa2b742b2d21ca968","compact":"08d2ae8f7bc19db79e96f7a6f72054fd6a910646c32d1a72b6d11cb10133399b","nasal":"08d2ae8f7bc19db79e96f7a6f72054fd6a910646c32d1a72b6d11cb10133399b"}},{"id":"VRCE-5-28-24","kanda":5,"kandaId":"sundara","sarga":28,"verse":24,"english":"Beholding me leap from branch to branch and trunk to trunk of big trees they shall be greatly alarmed.","alignment":{"type":"1:1","confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-23"],"status":"unreviewed"},"source":{"sanskritLocator":"5028024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c352dcdacacb0ecf39b44640a839d3e14ad256e76e35c8c7bea191b5bc2c06b1","compact":"4d1f97955d8548d343998a6f48a0c2f898e658c285f4f997d69cdfe86be0398f","nasal":"2e1f0169741c6d80ed55bddd061ec339694157dfa7357d35cd1b74dd50632029"}},{"id":"VRCE-5-28-25","kanda":5,"kandaId":"sundara","sarga":28,"verse":25,"english":"And espying my appearance while ranging in the forest, those Rākşasīs greatly terrified, shall fill the wood with their wild shouts.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5028025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"97a5bb702df633293bc99c2ea6b170c84ea366e993e3b4da6a37be70abdcd702","compact":"053a0296aa21fe8ee1ca2a60f53429d444c441a45a83519de841f2a2ee6a7955","nasal":"053a0296aa21fe8ee1ca2a60f53429d444c441a45a83519de841f2a2ee6a7955"}},{"id":"VRCE-5-28-26","kanda":5,"kandaId":"sundara","sarga":28,"verse":26,"english":"Then they shall call (to their assistance) all those Rākşasīs engaged in guarding the abode of the lord of the Rāksasas.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5028026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"624c3eb377857cf41fe09943879d7faf22f1682b8aa05d59a5afb18dac924c32","compact":"0a876d5f121eb7e310d79b6eb6a708241d3336ec85dc2d948fc6b72e66839cc9","nasal":"a3ca1a5a4e420571e5b534838a4861b48ef29f59b443ad02ebb9df6b46c0557c"}},{"id":"VRCE-5-28-27","kanda":5,"kandaId":"sundara","sarga":28,"verse":27,"english":"They, greatly agitated, shall with vehemence arrive here, armed with dirts, arrow, scimitars and various other weapons.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5028027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3a47709bb977cab38fcaea7413ce3578e3c6bb6df6b73aafe41d6e3cb8baaeda","compact":"d555788c20eb149f3a1cea33d86ea47d3c243383665572553617d414827e92f9","nasal":"d555788c20eb149f3a1cea33d86ea47d3c243383665572553617d414827e92f9"}},{"id":"VRCE-5-28-28","kanda":5,"kandaId":"sundara","sarga":28,"verse":28,"english":"Being surrounded by them on all sides, If I do kill that host of demons, tired, I shall not be able to bound over the main.","alignment":{"type":"1:1","confidence":0.403,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5028028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8514c23316e13b9d1e650d41c4f921f308a146dacedbfe12dbb0d112834aca7a","compact":"a8395c87b625b92f3500f8f266f05a44e37faa703034b31dffa207991ac82753","nasal":"a8395c87b625b92f3500f8f266f05a44e37faa703034b31dffa207991ac82753"}},{"id":"VRCE-5-28-29","kanda":5,"kandaId":"sundara","sarga":28,"verse":29,"english":"And if that host of skilled demons, succeed in making me a captive, too shall be in their hands and Sītā shall remain ignorant of my object.","alignment":{"type":"1:1","confidence":0.719,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5028029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9543c1624c360d34f8ba315266a8f5e172736aaf7bf3a0fcc017de0a4ce5692","compact":"d0de0b8a8c9f91be10c9902459088e5266bdabaea6aceccf63a8f813fe005fa6","nasal":"d0de0b8a8c9f91be10c9902459088e5266bdabaea6aceccf63a8f813fe005fa6"}},{"id":"VRCE-5-28-30","kanda":5,"kandaId":"sundara","sarga":28,"verse":30,"english":"Or the Rākşasas, pernicious as they are, shall kill the daughter of Janaka, and there shall the great work of Rāma and Sugrīva, be spoiled.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5028030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bacedaabb4f2aa4ff8d81f3c4c3be37bbfbadae82c0409b743fb55c2ac930460","compact":"7e96d5aa41a4cd9ea4d4b9132960f30e0b3b07656cafe248a851e8e758f2ec64","nasal":"25540cd8e335d4aeaf8829c5afb5968c162645cc0e74f179da77acf3f0c43819"}},{"id":"VRCE-5-28-31","kanda":5,"kandaId":"sundara","sarga":28,"verse":31,"english":"And Jānakī live in this secret place, girt by the ocean, guarded on all sides by the Raksasas, difficult of being got at and having all avenues to it shut up.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5028031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a43ca55656de8a1aa614f7adea1afff03c9245dc1ca7fd1069954942d0b076ac","compact":"b59cbfd10261a1b18cd5e18128db2067541abedf9101d76f8ea7bea278f8b1a0","nasal":"b59cbfd10261a1b18cd5e18128db2067541abedf9101d76f8ea7bea278f8b1a0"}},{"id":"VRCE-5-28-32","kanda":5,"kandaId":"sundara","sarga":28,"verse":32,"english":"If I am killed or captured by Rākşasas in battle, I do not find any who can help Rāma in his enterprise.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5028032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b79e041cb915576e36fb5d79bd6827869850f1965499327699aab53dca3af14c","compact":"ca0acf0ce1a3a2c8dc326d55f191a90cd40595e080a2568b11a39a547c385c6d","nasal":"ca0acf0ce1a3a2c8dc326d55f191a90cd40595e080a2568b11a39a547c385c6d"}},{"id":"VRCE-5-28-33","kanda":5,"kandaId":"sundara","sarga":28,"verse":33,"english":"Myself killed, I do not find any monkey who can leap a hundred leagues across the sea.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-32"],"status":"unreviewed"},"source":{"sanskritLocator":"5028033","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bbb425484c32b63244e10ee64a9faf8088689ac118ebd33ef48bf0d4b36d5eff","compact":"5d6e37b3906c62bec98cec6ac39f18f3eba2bda719e5db4abb03ac57cbf1cfd8","nasal":"3f10a1a74e4cbf5783c9dc740825f5ebf5b797c3e3037eb6d620a4d519041c4a"}},{"id":"VRCE-5-28-34","kanda":5,"kandaId":"sundara","sarga":28,"verse":34,"english":"I am capable of destroying thousands of Rākşasas, but I shall not then be able to get at the other shore of the great ocean.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-33"],"status":"unreviewed"},"source":{"sanskritLocator":"5028034","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"64ee84a7b65ac925e9ac68a55ff1b749a15a846381cd7309bef80b44f062a895","compact":"86049188ca4897be5b25e6d433baeea149ca74b7b4cb5666cee5a43188dc5f42","nasal":"0a0a93916be453b10514204faa169da369eebbe557099d094a9a2cd519aa8a91"}},{"id":"VRCE-5-28-35","kanda":5,"kandaId":"sundara","sarga":28,"verse":35,"english":"Victory or defeat is uncertain in a battle-I do not (therefore) like to engage in such an uncertain (act). What wise man merges certainty in uncertainly?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-34"],"status":"unreviewed"},"source":{"sanskritLocator":"5028035","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"711d626295af606b5d08ba569e05f9066417abab934ee48816ff63ab7edf11ff","compact":"407c43ae00e2cade2701dccefbb3fee8d6525249167e34c159f1f5a8c3e66a9e","nasal":"407c43ae00e2cade2701dccefbb3fee8d6525249167e34c159f1f5a8c3e66a9e"}},{"id":"VRCE-5-28-36","kanda":5,"kandaId":"sundara","sarga":28,"verse":36,"english":"It is a great sin in me (I own) to talk with Sita-But she will die if I do not talk with her.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-35"],"status":"unreviewed"},"source":{"sanskritLocator":"5028036","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"165a29ab30ff2cd7845f995d7108561069f2c2d26ca1d30264067649e82b1900","compact":"565d628e138731aca2d8e5feb389007613536b36bd852c8fbc3d47a6a74fdd88","nasal":"565d628e138731aca2d8e5feb389007613536b36bd852c8fbc3d47a6a74fdd88"}},{"id":"VRCE-5-28-37","kanda":5,"kandaId":"sundara","sarga":28,"verse":37,"english":"Works, almost accomplished, when entrusted to an inconsiderate emissary, are generally spoiled, out of season and out of place, like to darkness driven by the appearance of the sun.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-36"],"status":"unreviewed"},"source":{"sanskritLocator":"5028037","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b08533e6af432e348f09aacee8f7320371fa79451dd9463738e93d70e13cff0b","compact":"31281f239ca760ac1b863d343c6613dc9a82113b80a17f8e21e2cea805a4d48b","nasal":"fc3a89e9b4952c021024ba6dfc56c2c818ea984e57ac6b1a5e12695e2902407a"}},{"id":"VRCE-5-28-38","kanda":5,"kandaId":"sundara","sarga":28,"verse":38,"english":"All those works, which are generally taken in hand after duly deliberating over their propriety and impropriety, are generally spoiled by those emissaries who are proud of their learing.","alignment":{"type":"1:1","confidence":0.731,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-37"],"status":"unreviewed"},"source":{"sanskritLocator":"5028038","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f721fcca3dd3d5b2db577d180d783760c51b4cad128132e5067d8ef37c11e9fd","compact":"129c65880f09fa7d1ca893cf8901bc810c21e0f3f5179b20c652cfbcb3b5ce3f","nasal":"35092433a1247685d43e5a1ba1aa124bec4018a031a660119e3bf27218258674"}},{"id":"VRCE-5-28-39","kanda":5,"kandaId":"sundara","sarga":28,"verse":39,"english":"What shall I do, by which my work is not injured, I am not blamed of foolishness and my crossing over the main dose not become fruitless? What shall I do so that Sītā might listen to me without being terrified? Thinking over this, the intelligent Hanumān arrived at a conclusion.","alignment":{"type":"grouped","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-38"],"status":"unreviewed"},"source":{"sanskritLocator":"5028039","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"723f03b9da85f7502c756a9cf8a0d700d913c848352c6b5f661b940c288ca575","compact":"57be7c04cdcbf3238f48dc73018731c5039be374dd0f6120ab5bd7b849731052","nasal":"76d67fc4ff2e96b8680c655577de5b8d56b5b9ed4f5d858dc9013d719d387c0f"}},{"id":"VRCE-5-28-40","kanda":5,"kandaId":"sundara","sarga":28,"verse":40,"english":"What shall I do, by which my work is not injured, I am not blamed of foolishness and my crossing over the main dose not become fruitless? What shall I do so that Sītā might listen to me without being terrified? Thinking over this, the intelligent Hanumān arrived at a conclusion.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-38"],"status":"unreviewed"},"source":{"sanskritLocator":"5028040","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8de289455a6fc3303c882070973a3d19b675255e610033bb03273a9a867cc4e6","compact":"08bba42db027f30ae5d432c777f0822055e827e0e7cf609116fa49b11b08e65d","nasal":"0c38258ba45c7d04fd106542179a109cb4f4dd77aeda2356efb96ab934727f53"}},{"id":"VRCE-5-28-41","kanda":5,"kandaId":"sundara","sarga":28,"verse":41,"english":"I shall not disturb her, speaking (all on a sudden) about Rāma of unwearied actions, dear to her and to whom.","alignment":{"type":"1:1","confidence":0.652,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-39"],"status":"unreviewed"},"source":{"sanskritLocator":"5028041","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f023c75f2231ea550a43278c4537154896ed9721867dc68045473ad358ec1405","compact":"2b59b7346772ce84a306bdc71d6f77647552b3390d16bd8a01c938aa0672a7fb","nasal":"1dc67b1bbb16e9944b82264c201d8ea51d19d8af29ed0fc78696ff1dba017ff5"}},{"id":"VRCE-5-28-42","kanda":5,"kandaId":"sundara","sarga":28,"verse":42,"english":"She is firmly attached. Uttering the name of Rāma, the foremost of the Ikşvākus, and of subdued soul and lauding his piety and fame in sweet accents, I shall so manage that Sītā might hear and believe them.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-40"],"status":"unreviewed"},"source":{"sanskritLocator":"5028042","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42e1452c599fae33ec584ff61d864daee7704209ee491cf73f9ccb1bafca0936","compact":"70f2dcce3099fab2340f36138982540fec179771bf134ea141658685278ecf72","nasal":"70f2dcce3099fab2340f36138982540fec179771bf134ea141658685278ecf72"}},{"id":"VRCE-5-28-43","kanda":5,"kandaId":"sundara","sarga":28,"verse":43,"english":"She is firmly attached. Uttering the name of Rāma, the foremost of the Ikşvākus, and of subdued soul and lauding his piety and fame in sweet accents, I shall so manage that Sītā might hear and believe them.","alignment":{"type":"grouped","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-40"],"status":"unreviewed"},"source":{"sanskritLocator":"5028043","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"93072cd57bf7162f6e88d2d2e7a3f14bfb79fa52be201e25bb2d0607bcda9e17","compact":"2ecd7312913b39e143cded200e101232f55ca33c5ebe3b4d38a45fbef84e6622","nasal":"2ecd7312913b39e143cded200e101232f55ca33c5ebe3b4d38a45fbef84e6622"}},{"id":"VRCE-5-28-44","kanda":5,"kandaId":"sundara","sarga":28,"verse":44,"english":"Beholding the spouse of that high-souled lord of the earth and engaging in this train of thoughts, Hanumān, stationed on a branch of the tree, spoke the following sweet words.","alignment":{"type":"1:1","confidence":0.802,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-30-41"],"status":"unreviewed"},"source":{"sanskritLocator":"5028044","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"44aba530b1bdfc81e9289a0a0db4c7215f75199fee86c3fac2a53fe357900cf7","compact":"a0591c1f1b97374ad1771cadaf8ba114d3eefb941a452ff1169a5e12b67c5f1d","nasal":"748f56504d6190686767f0ab00d7c32988bf6fb080700dd176cf03b1b8bddabe"}}]
