tt 1891–94"},"sanskrit_fingerprints":{"exact":"b8505950a9d9c9e8a8a32954ddb0b465544fc079189b377cfc833498d494b5ec","compact":"03cbe27244a51c924896738229bdec9b4affdcc52e2e5796591494c5593c51b8","nasal":"03cbe27244a51c924896738229bdec9b4affdcc52e2e5796591494c5593c51b8"}},{"id":"VRCE-5-18-7","kanda":5,"kandaId":"sundara","sarga":18,"verse":7,"english":"Do not fear me, O worshipful damsel, confide in me O my beloved one, and become attached to me. Do not give way to grief.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5018007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9b3c6ad9a70d429a6f39238c3bb4e6e80c1d901d8104126bcadd1d106f7e58f1","compact":"597a0f21ac6fe127365948d3ddf1de117d96edc88633984c538ffc8195fece69","nasal":"597a0f21ac6fe127365948d3ddf1de117d96edc88633984c538ffc8195fece69"}},{"id":"VRCE-5-18-8","kanda":5,"kandaId":"sundara","sarga":18,"verse":8,"english":"A single lock of hair, to lie down on earth and useless fast-these do not become you.","alignment":{"type":"1:1","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5018008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7485099f08ec8c663053114044ada827b655a6858cab7b08cfea37cb41b74bd2","compact":"9014a8a0c03f9b4b3acacf94115f62b00aacc1ad15f057f394d9aeac17ea5b1a","nasal":"2e8dde6e8def309a4034301ab35c3ffaf59a365f64d63843df96ed699a7c19bd"}},{"id":"VRCE-5-18-9","kanda":5,"kandaId":"sundara","sarga":18,"verse":9,"english":"Attaining me, O Maithili, do you enjoy excellent garlands, sandal, ornaments, costly wines, beds, seats, songs, dancing and music.","alignment":{"type":"grouped","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5018009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e59dd264dbddb2d6d97ca534b9fc20067785879a670ee7081d2371c16ce671b0","compact":"b5d254c3bcb64a9c2ede575a4a99faabd6439436dae707ae0d036c155e2d43af","nasal":"26018cdc8b7675af49a26a562571151f8f69b986a42664fa25e62275d152bbaf"}},{"id":"VRCE-5-18-10","kanda":5,"kandaId":"sundara","sarga":18,"verse":10,"english":"Attaining me, O Maithili, do you enjoy excellent garlands, sandal, ornaments, costly wines, beds, seats, songs, dancing and music.","alignment":{"type":"grouped","confidence":0.655,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5018010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4186ebc5a2436661777447b8dbfa3db80eaba22673ed8bb35084b9cc2ad656d5","compact":"d90e2d56c501e9a52329a0ea1be767cb28b4194ed13f1d9f16602ef8c6097e4e","nasal":"d90e2d56c501e9a52329a0ea1be767cb28b4194ed13f1d9f16602ef8c6097e4e"}},{"id":"VRCE-5-18-11","kanda":5,"kandaId":"sundara","sarga":18,"verse":11,"english":"You are a jewel of a female; do you not therefore remain in this guise. Put on your ornaments therefore. How shall you remain unadorned obtaining me, O you of a beautiful figure?","alignment":{"type":"1:1","confidence":0.653,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5018011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e8ac7f3d1b9a1623b4fd0a1a8f43686b6f020c64aa1b9fa680b68e40566c5288","compact":"62a4633265f889c1ba44b6633c853e7583ec65c18fafe5f09e9690d027cab89a","nasal":"bf7c226df7df3c497eb129798737a0f7ed92f768db368c5699b72104ee2aeb09"}},{"id":"VRCE-5-18-12","kanda":5,"kandaId":"sundara","sarga":18,"verse":12,"english":"This your beautiful youth is passing away, which like the current of a river when once gone, dose not turn back,","alignment":{"type":"1:1","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5018012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e3afadd5f22ce25951640c068f12247e0f751152cb5a635ac39b4e1a4c02b65d","compact":"7e4129a81cfe45f26638d72a8fa20aced1ddf3d944954ec6a087401c9ca768a2","nasal":"7e4129a81cfe45f26638d72a8fa20aced1ddf3d944954ec6a087401c9ca768a2"}},{"id":"VRCE-5-18-13","kanda":5,"kandaId":"sundara","sarga":18,"verse":13,"english":"O you of a fair look, having created you, the artist of Gods, the maker of celestial beauties, has ceased from his work, for a match of your beauty I find in none.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5018013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"88795a504116c1859ca76e30ba983d0000e044c37b61618ba91e2ed7b94d8ff9","compact":"1f0d0e420f2f4aaddc686729b8d637bb3bf5fc8374c6c99a071892b9b5a0dfa1","nasal":"1f0d0e420f2f4aaddc686729b8d637bb3bf5fc8374c6c99a071892b9b5a0dfa1"}},{"id":"VRCE-5-18-14","kanda":5,"kandaId":"sundara","sarga":18,"verse":14,"english":"Who is there, O Vaidehi, who can withstand the influence of amour, getting you, gifted with beauty and youth? (What of others) even Brahmā, the grand-father of the celestials, is moved.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5018014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8bb23af4e898cca1704803e125c5fdabf9c10c73e44629e4c520cbee02c5a38","compact":"bbc512e2ffd0eb3c9c39852b7fe62d31b1e50463e20075a85d104f8295d9738f","nasal":"bbc512e2ffd0eb3c9c39852b7fe62d31b1e50463e20075a85d104f8295d9738f"}},{"id":"VRCE-5-18-15","kanda":5,"kandaId":"sundara","sarga":18,"verse":15,"english":"O you having a moon-like countenance, and well-developed hips, whatever limbs of yours, I behold, I find my gaze fixed therein.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5018015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d31ebfcfd3ee003f5255edfc5c8e66a2f2b395ddb9a43406dcec13a104e80ac4","compact":"8c7930bf75319c4dbfc2cb67fdee3303ea1c20f0479ae4c21888e70056e9b97f","nasal":"8c7930bf75319c4dbfc2cb67fdee3303ea1c20f0479ae4c21888e70056e9b97f"}},{"id":"VRCE-5-18-16","kanda":5,"kandaId":"sundara","sarga":18,"verse":16,"english":"O Maithili, do you become my spouse, and renounce this delusion. Do you become the foremost queen of all my excellent wives.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5018016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ab4a6997b16c09a7d3f6a8d99eab9a973f8fad5b77db684a2bd09c6af7b3feae","compact":"dcfee4c0d5a4145493d307827876ae378bf55064465b0dcf392cf6ecb0ac290f","nasal":"dcfee4c0d5a4145493d307827876ae378bf55064465b0dcf392cf6ecb0ac290f"}},{"id":"VRCE-5-18-17","kanda":5,"kandaId":"sundara","sarga":18,"verse":17,"english":"O timid one, all the jewels that I have collected from the three worlds, and all my kingdom I shall confer on you.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5018017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"99fbad31c1ddfeb6b432874239c3223d6c2f685602d5ec7f1206bd032525aef1","compact":"7ac784b5642714b38eeb760f5885c545c009fc8fd6e518089a768c61497bd8f5","nasal":"7ac784b5642714b38eeb760f5885c545c009fc8fd6e518089a768c61497bd8f5"}},{"id":"VRCE-5-18-18","kanda":5,"kandaId":"sundara","sarga":18,"verse":18,"english":"O sportive damsel, for your satisfaction, I shall conquer the whole earth, engarlanded by many cities and bestow it upon Janaka.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5018018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"75128ba3840f6ab1f71410471bfaad036dddc303d36ecee7682a2baea171aa84","compact":"6771091f0a7a05d187c7e4e1185d81faaf5208585d18fdc90501fe5c6da4a95b","nasal":"6771091f0a7a05d187c7e4e1185d81faaf5208585d18fdc90501fe5c6da4a95b"}},{"id":"VRCE-5-18-19","kanda":5,"kandaId":"sundara","sarga":18,"verse":19,"english":"Find I none on this earth who can withstand my prowess. Do you behold my matchless prowess in battle.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5018019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05189efedbde5229e192f15e72b0308bb4106006f48846c95f1a54ec8acfc909","compact":"654cc90cbf13b60ec46fd1d4694cc059d89aac1dea7e2d48011f2059aed9ecdb","nasal":"92a6024588ec90e8a428a3acea46b3272e631403187b4f263254107e3f25a296"}},{"id":"VRCE-5-18-20","kanda":5,"kandaId":"sundara","sarga":18,"verse":20,"english":"The celestials and Asuras are incapable of withstanding me, defeated as they were by me in battle and their pennons struck down.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-19"],"status":"unreviewed"},"source":{"sanskritLocator":"5018020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85a0b9f07fb24509708a7c1f973cf192c7527f5bf1a027942477f9a453e746e2","compact":"cad89a7a9dcd964228efbe352a3affc6788444ec92