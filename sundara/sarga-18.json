7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-23"],"status":"unreviewed"},"source":{"sanskritLocator":"5018023","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f43ad332e82fabb6f344a78d2a3654f6479c4d32f44ee259f953fa7a334775c0","compact":"0fdabaff0a59df95980ebdad317f77a6c5ad3b9ab94b465844ffa884ce7b2faf","nasal":"282f95959ecb233c69e2edf262be45f20a5b8014e9e061b0e14b65d1b7e4cd48"}},{"id":"VRCE-5-18-24","kanda":5,"kandaId":"sundara","sarga":18,"verse":24,"english":"Ogently lady, O you of great renown, do you observe my prosperity. What shall you do with Răma, wearing bark, O you of pleasant presence.","alignment":{"type":"1:1","confidence":0.763,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5018024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"972a5e0a26e6d32e5b8a78253d27169cfc4696ad4513084d6b9de1e337b6f3f7","compact":"a2bb4f63add924219309a7922a334124769c41ac5878cabe285ba2aa3d8d6fb1","nasal":"a2bb4f63add924219309a7922a334124769c41ac5878cabe285ba2aa3d8d6fb1"}},{"id":"VRCE-5-18-25","kanda":5,"kandaId":"sundara","sarga":18,"verse":25,"english":"Rāma has ceased from his endeavours for gaining victory. He has lost all his beauty, lives in the forest, is engaged in observances and always lies down on earth. I fear whether he is living still.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5018025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"be2d9f3c93f2352fcec32b09512b4b86fc7d4ae3a7b6ff2f18e78ee3afc1b0fd","compact":"fdb2141881825832eee789b8c72842c543d896073a45a7aa22854bc55168a9ae","nasal":"c5d6d5c3f94ed2f8cba5973bc0c104dbbd272259ae6bbda87b849375b2d6c912"}},{"id":"VRCE-5-18-26","kanda":5,"kandaId":"sundara","sarga":18,"verse":26,"engl