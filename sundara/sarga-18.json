[{"id":"VRCE-5-18-1","kanda":5,"kandaId":"sundara","sarga":18,"verse":1,"english":"Thereupon Rāvana, with sweet words and gestures, expressed his own desire to Sītā, poorly, deprived of joy, encircled by Rākşasīs and leading the life of an ascetic.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5018001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fff0fdb043a061beea993e394fd1bb3e4002311179e652778f35b016bb08bc34","compact":"73f0bf42322ac810bc3641c1f2cb314d230d421a8f8c48c8e9d38574adae5e6c","nasal":"aa760b1c616a00a9755a3232978d6b20e5f89420e821503db3861c1b06fec79c"}},{"id":"VRCE-5-18-2","kanda":5,"kandaId":"sundara","sarga":18,"verse":2,"english":"O you having thighs like the trunks of elephants, while you had, beholding me, hidden your breast and belly, perhaps you are afraid of exposing your person to me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5018002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0c48c7e428761841dabcb8dfa6818e0b6a46c959dcbeaf4c1d4d79f8a0e31097","compact":"b81923f64d6a3b0916f0b15df98ca31031ded0bdb200927bba336ec24f12afaa","nasal":"56b24083a256c5ff5f0d31f9ece759a48c427caf5b94036b7e81e4c3b18b5175"}},{"id":"VRCE-5-18-3","kanda":5,"kandaId":"sundara","sarga":18,"verse":3,"english":"I do long for you, O you having expansive eyes; do you esteem me, O my dear one, O you gifted with all accomplishments and pleasant to all persons.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-20-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5018003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7e4704eca39d08ba8b431dc77882ef3a423d8