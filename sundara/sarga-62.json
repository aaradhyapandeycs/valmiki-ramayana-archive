[{"id":"VRCE-5-62-1","kanda":5,"kandaId":"sundara","sarga":62,"verse":1,"english":"Being thus addressed by Sugrīva, the monkey Dadhimuklia, delighted, bowed to him, Rāghava and Laksmana.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5062001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42534baaf796802f7670a0c1f8f1a6f67d71521767790ba6c19f49ede2154be0","compact":"fe8a34c740ac178b1f568b4f7dcc1af4b67f3b90b93d618e5063442fa6482f2a","nasal":"fe8a34c740ac178b1f568b4f7dcc1af4b67f3b90b93d618e5063442fa6482f2a"}},{"id":"VRCE-5-62-2","kanda":5,"kandaId":"sundara","sarga":62,"verse":2,"english":"And adoring Sugrīva and the highly powerful descendants of Raghu, he along with other heroic monkeys, leaped up in the sky.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5062002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b62a05b244dd8fee42a61bd43f2dfa4ef362d93de90e5f9c62c7e52fc6626807","compact":"4591d2f902cf8d9f747e47989cbbd1121a41cde1998b1b38c86472003d993861","nasal":"4591d2f902cf8d9f747e47989cbbd1121a41cde1998b1b38c86472003d993861"}},{"id":"VRCE-5-62-3","kanda":5,"kandaId":"sundara","sarga":62,"verse":3,"english":"He went away with the same speed with which he came and leaping down on the earth from the sky, entered the orchard.","alignment":{"type":"1:1","confidence":0.849,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5062003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"feb34bff87d384ca863d5595fd2f6cc0c810963373e930356caa4b0fbe8c6590","compact":"d0bb2424b0ac8435e6f4d58ca9ef84517aa1e6422fc79a601fe846d2f6e34418","nasal":"d0bb2424b0ac8435e6f4d58ca9ef84517aa1e6422fc79a601fe846d2f6e34418"}},{"id":"VRCE-5-62-4","kanda":5,"kandaId":"sundara","sarga":62,"verse":4,"english":"And entering that forest he beheld all the leaders of the monkeys spending the hours delightedly, having passed urine, the outcome of honey.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5062004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"050ea71572e2df265f9bafe3545d04a17d2aef6c879540312dacabf3a3e4b9ca","compact":"44c6c875a55e6618ae8c058fb5cd5833bb16bce585c7e86feba79c22d478f2fa","nasal":"44c6c875a55e6618ae8c058fb5cd5833bb16bce585c7e86feba79c22d478f2fa"}},{"id":"VRCE-5-62-5","kanda":5,"kandaId":"sundara","sarga":62,"verse":5,"english":"And approaching them, the hero, with folded hands and delighted, addressed Angada, with the following words.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5062005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"495a0d02797d8b700bfcf5eabe950cb1c5eac7929ad4f52938acf72706e287a0","compact":"37172bc6d222f57b84c5b4d3953558a1c7b177ac789c675cd749146391dd1813","nasal":"ab124dcc4a8adba0f3c33d0505327b2d23fd7184a4c38656a3a374e13cb00485"}},{"id":"VRCE-5-62-6","kanda":5,"kandaId":"sundara","sarga":62,"verse":6,"english":"O gentle one, do you not take offence, for these monkeys, protecting the garden enraged, unwittingly prevented you.","alignment":{"type":"1:1","confidence":0.765,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5062006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cf0513f9ff6d4cb8e39fa58cab8d58df697112a460f4ddc24c220878ac916051","compact":"4d094d5382392fdd1c943fcd5768025e82bcaf768f9f9c1fc2acacf057741199","nasal":"988ea9c71ceea8fab572f86212a1b8c9fa2fb7099d5f6c17f09d750c322d3e14"}},{"id":"VRCE-5-62-7","kanda":5,"kandaId":"sundara","sarga":62,"verse":7,"english":"O you of great strength, you are worn out with your long journey, do you drink your own honey, you are our prince and the master of this garden. It behove you to forgive us for our wrath arising out of ignorance. Like to your sire before, yourself and Sugrīva are the lords of these monkey hosts, O you foremost of them and none else.","alignment":{"type":"split","confidence":0.357,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-7","DUTT-5-64-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5062007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1aff0315a55d686373a563abf52fc1530a9aa39e5f419d0793179e83ecb47d8","compact":"7d14b4ed9999139af3b9c469eed3787586291adb79757e799656e87cf92f8e6d","nasal":"abe3954ecbb2a0448211a5412dcce6ddc847f478e9d02a792cbbd680236930e9"}},{"id":"VRCE-5-62-8","kanda":5,"kandaId":"sundara","sarga":62,"verse":8,"english":"It behove you to forgive us for our wrath arising out of ignorance. Like to your sire before, yourself and Sugrīva are the lords of these monkey hosts, O you foremost of them and none else.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5062008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f9f1a87d258e9877d8f6a696d5053ca0173a0ca66899c48a89e4697eaab80342","compact":"abc57138259cee6b524496c6dfae23ee59215fc5a1b1d6808cdf0f2319ccfe9b","nasal":"abc57138259cee6b524496c6dfae23ee59215fc5a1b1d6808cdf0f2319ccfe9b"}},{"id":"VRCE-5-62-9","kanda":5,"kandaId":"sundara","sarga":62,"verse":9,"english":"O innocent prince, I have related all about this to your uncle. When I described to him, the arrival of all these forest rangers, as well as of yours accompanied by them, and the destruction of this garden by you all, he was not the least offended, rather delighted.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5062009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6360691d42056824f17d83da9874347faa3cdf32748da9453d437f194a0437ae","compact":"3b4d620bac679e88ab7b929d29e25aad15d2097d10efda2480d6ee33235f4119","nasal":"3b4d620bac679e88ab7b929d29e25aad15d2097d10efda2480d6ee33235f4119"}},{"id":"VRCE-5-62-10","kanda":5,"kandaId":"sundara","sarga":62,"verse":10,"english":"O innocent prince, I have related all about this to your uncle. When I described to him, the arrival of all these forest rangers, as well as of yours accompanied by them, and the destruction of this garden by you all, he was not the least offended, rather delighted.","alignment":{"type":"grouped","confidence":0.739,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5062010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29f8e924568d82521c3f25020f3cfa000cc97d39affaa42c6ffffeedd981b554","compact":"387b7727f9093b61d2f68259b2278840d4b6a0279ae33e900459d75df1a027dc","nasal":"387b7727f9093b61d2f68259b2278840d4b6a0279ae33e900459d75df1a027dc"}},{"id":"VRCE-5-62-11","kanda":5,"kandaId":"sundara","sarga":62,"verse":11,"english":"And worked up with joy your uncle Sugrīva, the lord of earth and monkeys, said “Send them all here speedily.\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5062011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e948598f9d09b7059f07312340283e54c10eab93fda3e60e99b54217d2ec50de","compact":"897ccf892ba89cae3bff8f7744fe65c21f8779607fde477788e5c6bf1719d29b","nasal":"897ccf892ba89cae3bff8f7744fe65c21f8779607fde477788e5c6bf1719d29b"}},{"id":"VRCE-5-62-12","kanda":5,"kandaId":"sundara","sarga":62,"verse":12,"english":"Hearing those words from Dadhimukha, Angada, the foremost of the monkeys and skilled in speech, addressed them all, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5062012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"81568623eb1166f689e43794aef5f1f2d8688f67b3eac95fca6869c89b3654b3","compact":"1b15e600baf98cd7f3c0232b683926941609ea79a9339a44a318b29f886e4c91","nasal":"2f74262e40b404aaf6e836facd1e7c1296bcd13d69ee2a2d488aca787a1e29c3"}},{"id":"VRCE-5-62-13","kanda":5,"kandaId":"sundara","sarga":62,"verse":13,"english":"O you leaders of the monkey hosts, I fear, Rāma has heard all about this. Dadhimukha relates everything joyfully and hence I infer this. And our work finished, O slayer of foes, it dose not behove us to remain here (any longer).","alignment":{"type":"1:1","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5062013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ce736ac69e006c015ca1ca3fdc65a59a7602c2d1f1918b39c5695ed424367392","compact":"75849d131c3fce005f4530ae87b55c7ce5a8f126e29d1053bfb6deaf7fbf6ec3","nasal":"7e151574789fcfc0edeab4b6a7f6c6c9e7464c9648a62d7f05c818b81e96c56a"}},{"id":"VRCE-5-62-14","kanda":5,"kandaId":"sundara","sarga":62,"verse":14,"english":"You have all drunk honey at your pleasure and there is nothing left and you should now go where the monkey king Sugrīva is.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5062014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e4de52e6b20640db665844cb85769bdb7218052d3fa79d04e93a2d1d2026f06","compact":"cd493e531814fe457da69bcb582a1176b82756f803b973c1e6d431669795bae8","nasal":"7f0a81cbeb88b9b91dc26510fbcb6a7b088452e9106a223e985c2e3f0ce0e3dc"}},{"id":"VRCE-5-62-15","kanda":5,"kandaId":"sundara","sarga":62,"verse":15,"english":"O leading monkeys, I shall follow what you will in a band desire me to do. In action I am subordinate to you all.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5062015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19c2c5f58b7965f87bacd9089b0127f07e1dd61bdf15a3dfd38ea478eb0233dd","compact":"9ec17c6aab3996c097fb2347760d4b09730e1a9d5351832cdc95325da67c7841","nasal":"1c1c8297db9b948a1d235bb5821151f6a44666a7c0fd40602d5cb32846b281c9"}},{"id":"VRCE-5-62-16","kanda":5,"kandaId":"sundara","sarga":62,"verse":16,"english":"I am not justified to command although I am a prince. You are all of accomplished actions, it is not proper to repress you forcibly.","alignment":{"type":"1:1","confidence":0.95,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5062016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d63685cba8834ddd9b764a174144f03095b37c083049fbcb34680a059fc70a9f","compact":"853aa0588ae47fed5665bc02c8f1b1740e67d34161c829245750bf9a3a7ed68c","nasal":"853aa0588ae47fed5665bc02c8f1b1740e67d34161c829245750bf9a3a7ed68c"}},{"id":"VRCE-5-62-17","kanda":5,"kandaId":"sundara","sarga":62,"verse":17,"english":"Hearing those sweet words of the prince Angada, the monkeys delightedly replied, saying.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5062017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"09667d1c35c1d66504317247b08552f5f81cb755e50ac2560fe45d823553b6f8","compact":"84a8fbc847258e919e41e1be072ba89172101b460262d7ad1144a9fc178dd39b","nasal":"02864b02271c75e52238b1e528051f69d85ca0d597f1d9db269842d5c3e14822"}},{"id":"VRCE-5-62-18","kanda":5,"kandaId":"sundara","sarga":62,"verse":18,"english":"O king, O foremost of monkeys, who else can speak thus being a master? Any one else, we think, is proud of his wealth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5062018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f5a5a7b1a9167a805aa7c794ea631427e7cdbf7419bc0b2ab236e73d13bd888","compact":"722654c836b9ac382f022bc53d15c1857408e0942576a67685d1b99fba643521","nasal":"722654c836b9ac382f022bc53d15c1857408e0942576a67685d1b99fba643521"}},{"id":"VRCE-5-62-19","kanda":5,"kandaId":"sundara","sarga":62,"verse":19,"english":"Such like words become you only and none else. Your humility speaks of your future greatness.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5062019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05a7ef817cf8c165e89f5fab1dbea6a37508d411d45699e60fed367897e8d0fe","compact":"370cbc7b44e210894866e5a43622b998c84d97cd62b91d9b14e3ad7369d4b050","nasal":"370cbc7b44e210894866e5a43622b998c84d97cd62b91d9b14e3ad7369d4b050"}},{"id":"VRCE-5-62-20","kanda":5,"kandaId":"sundara","sarga":62,"verse":20,"english":"We are all anxious to go there, where Sugriva, the king of the monkeys, is.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-19"],"status":"unreviewed"},"source":{"sanskritLocator":"5062020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d674b2b237321b9065eec8fca6dd1d3ffb8e2dfe244b97d2886e4a8fed5d4a7e","compact":"c6107394cc3b2e9115bf16815899fdfa1c4e549b112621bfdc8f7198b9adb89b","nasal":"fc6cbf0bde4e4d78bcc48ce206af2754b738330f33d23604e61dfd3d2c084dea"}},{"id":"VRCE-5-62-21","kanda":5,"kandaId":"sundara","sarga":62,"verse":21,"english":"Verily we speak to you, O foremost of monkeys, that without your permission, none among us, is capable of advancing a single step.”","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-20"],"status":"unreviewed"},"source":{"sanskritLocator":"5062021","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7cee84794f505eb9bf34a8f46ef2d19ab0124a87da6e258b56188998e829de54","compact":"da828615a75b3e7b99635b5e6824f5b5539c7c283b4582d1b0a4f6e2bd4ea168","nasal":"ba6db762b2e76a7fb439828fa53b292c39c01ca3b1c774c92458886ced18496c"}},{"id":"VRCE-5-62-22","kanda":5,"kandaId":"sundara","sarga":62,"verse":22,"english":"They addressing him thus, Angada replied\"All right, let us all go.” Saying this he leaped up in the sky and was followed by all those monkeys, clouding the welkin as if with stones thrown up by a tool.","alignment":{"type":"grouped","confidence":0.559,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5062022","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6933f962754772b7331977de9ed2e04075f9e0016523cab3970551984ed0396f","compact":"766d147eb99c2cf0046bd6e2a2b94b2be329544211c84460ce41893fe4c31eb1","nasal":"e090e5742151c339f54f3fc1a82d1ce1ee039a6c547f976d22b0030a789e26c4"}},{"id":"VRCE-5-62-23","kanda":5,"kandaId":"sundara","sarga":62,"verse":23,"english":"They addressing him thus, Angada replied\"All right, let us all go.” Saying this he leaped up in the sky and was followed by all those monkeys, clouding the welkin as if with stones thrown up by a tool.","alignment":{"type":"grouped","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5062023","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cabfc65564479a7df229628da6bf89f1eec976886a5c1dbdcafdc1aec8837c46","compact":"5b2a13813fef25194bf6afde5d1fca03191dd548963598d157712b15ab323c62","nasal":"c6e6f8ac1239786dd5c4ef017212f56386b00e92043c9f6e1a8f4d575b59cd6c"}},{"id":"VRCE-5-62-24","kanda":5,"kandaId":"sundara","sarga":62,"verse":24,"english":"And placing before them Angada and Hanumān, the monkeys leaping vehemently up in the sky roared like to clouds driven by the wind.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-22"],"status":"unreviewed"},"source":{"sanskritLocator":"5062024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"91c9c6f8850b06cb2970662447a811f1a27ca31a7d0df4ea03119af484a1dd9f","compact":"ffa04aae90eca4b3b8dd04be094cde921dd05a3e83a181c558a3c772918c35dd","nasal":"026c004cce3eea4571e1f2324f0b4802c34f7f0f705c8a7ee10d491c5cc1647e"}},{"id":"VRCE-5-62-25","kanda":5,"kandaId":"sundara","sarga":62,"verse":25,"english":"And Angada nearing, Sugrīva, the lord of the monkeys, spoke to the lotus-eyed Rāma, stricken with grief, saying.","alignment":{"type":"1:1","confidence":0.436,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-23"],"status":"unreviewed"},"source":{"sanskritLocator":"5062025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"81eb46399959e4e9c88cc334d63fa879a6fa4e27de1e6b8b9d7aa45d453e6d0f","compact":"19fd69e392b03ce31720aab8829dc1cb54b175bc440e3ea9da7c83e30dabf66e","nasal":"baa544d09651a99e5df0a9a63590c3d76a845b27c796b7353b885d2641847d2a"}},{"id":"VRCE-5-62-26","kanda":5,"kandaId":"sundara","sarga":62,"verse":26,"english":"May good betide you. Do you console yourself. The worshipful dame has been found out; there is not the least doubt about it. Or else they would not have come as the time is already past.","alignment":{"type":"1:1","confidence":0.839,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5062026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f6278fc4e38a89af0930926892bd14355b47ac591cb6353eaa9f462487a379cd","compact":"096f3727799f1f2e419d7c734af6fcd04e8a4ba0c1d54be9a8e828c656e513d8","nasal":"e5a8195ac014633533f634f4d5ef0f25abbc8b71bc54bcd74a055c3504f441fc"}},{"id":"VRCE-5-62-27","kanda":5,"kandaId":"sundara","sarga":62,"verse":27,"english":"I (further more) infer this from Angada's joy, O you of auspicious presence. Without being successful in his mission, the large-armed prince, Angada, the foremost of the monkeys, would not have come to me.","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5062027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"99dc2df86525b04eb7a7d40e17140731eeaf7bfdefdcdca71559c301c727fc0e","compact":"8906e0db81c1b6140eec12e09a1b8e977da7014592129070b057de6f9dacf1a3","nasal":"9628cecee24b49da1fbe734c08eb35f2ba62b326826dbc28ccb92b74e4b5da40"}},{"id":"VRCE-5-62-28","kanda":5,"kandaId":"sundara","sarga":62,"verse":28,"english":"If the monkeys had engaged in such an unfair proceeding without being successful in their mission, Angada would have looked poorly and his mind would have been overwhelmed with grief and forgetfulness.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5062028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f58b8a2487e435feefa68f7768656cc5c88a23cd5a45c0007e31ddedf1cf8f1","compact":"f259f7cdf11e23da27380362103a4fc8bb7573ee29ba3d6f815a1fa0a321b18b","nasal":"2d20e670545fe300e32514056715e8ffea8a247304f272edbc5ee51f3d23ba32"}},{"id":"VRCE-5-62-29","kanda":5,"kandaId":"sundara","sarga":62,"verse":29,"english":"Without beholding the daughter of the king Janaka they would not have dared to destroy Madhuvana obtained and preserved by my forefathers.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5062029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"316ace4c059710230ad327802d5227addc0901f031cbdd437c54a93c1d04c06e","compact":"69f4a2c6945131001dcb9c9af722b3830071c04d81443b1859bd846fd5afbf04","nasal":"69f4a2c6945131001dcb9c9af722b3830071c04d81443b1859bd846fd5afbf04"}},{"id":"VRCE-5-62-30","kanda":5,"kandaId":"sundara","sarga":62,"verse":30,"english":"Do you console yourself, O Räma, by whom Kausalyā has become the mother of a good son. O you, rigidly observing any religious vow or obligation, forsooth has Hanumān behold the worshipful dame and none else.","alignment":{"type":"1:1","confidence":0.613,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5062030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"32c93fe84d20dab24084868c33d5c9786dcd5a0022f8e63e36e42b6afba546d7","compact":"0f6a496addf91db7da07e5b5bb3c426063928f692636907219a354b08e7b80d4","nasal":"0f6a496addf91db7da07e5b5bb3c426063928f692636907219a354b08e7b80d4"}},{"id":"VRCE-5-62-31","kanda":5,"kandaId":"sundara","sarga":62,"verse":31,"english":"No other wight is so qualified an instrument in encompassing this end. O you of excellent intellect, Hanumān know the art of success, is gifted with intellect, perseverance and courage and is versed in Šāstras. That work cannot fail, which is worked out by Jāmbavān and Angada and presided over by Hanumān.","alignment":{"type":"grouped","confidence":0.441,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5062031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"944d2b86c33df0eadd1871b2c0ea7dbf7cf1109dbfa14a2070839a2756ffad76","compact":"180551200ec73cfc7a03e9a5269c1f0dd0968c6349501e9102f1fb8a99ece53c","nasal":"180551200ec73cfc7a03e9a5269c1f0dd0968c6349501e9102f1fb8a99ece53c"}},{"id":"VRCE-5-62-32","kanda":5,"kandaId":"sundara","sarga":62,"verse":32,"english":"No other wight is so qualified an instrument in encompassing this end. O you of excellent intellect, Hanumān know the art of success, is gifted with intellect, perseverance and courage and is versed in Šāstras. That work cannot fail, which is worked out by Jāmbavān and Angada and presided over by Hanumān.","alignment":{"type":"grouped","confidence":0.692,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5062032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc1b04a7e3c93e79ffaf4970497bd2fdecd88881cfb0b910d81005f3084c0728","compact":"8a83d003caef2c3b76dd5188263d214b3bc5c1a0348e99303409a4a5845319b8","nasal":"dbc7e12371fbc80cce9ba5473a58eb62ed59e514b14b04c48f112ceff8e380eb"}},{"id":"VRCE-5-62-33","kanda":5,"kandaId":"sundara","sarga":62,"verse":33,"english":"Be not laden with anxiety, O you of unmitigated prowess. These monkey have come here excited with pride and drink. They would not have come with such a grandeur had they been but unsuccessful. From their breaking down the orchard and drinking honey I inferred SO.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5062033","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6448628aaee44e13b53bcae5a090ff9d51528764597df405a1182c8193df74e3","compact":"16158be3eb10124b1a5157d8eb515004171a5b5299584a27947d6d36baadb3f1","nasal":"c12042b43229246d9bb6c57e7bdb9ef744c97745b2d186698a780cd9fa866399"}},{"id":"VRCE-5-62-34","kanda":5,"kandaId":"sundara","sarga":62,"verse":34,"english":"Thereupon he heard in the sky the joyous sounds of the monkeys proud on account of Hanuman's work, proceeding towards Kişkindhā and as if announcing their success.","alignment":{"type":"1:1","confidence":0.907,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5062034","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04039629fcf68e5d1469ec3d0b4a5ed2948306447a41962b557c5bc9c81297ba","compact":"973305a7081f8ae7de04492d9810a5aa05f2de561b423949aef03dfb5af471a9","nasal":"7c157fd1b6550ff634d5e55f680962f2deb5a1cd6fb1f0322ab5861354e1553c"}},{"id":"VRCE-5-62-35","kanda":5,"kandaId":"sundara","sarga":62,"verse":35,"english":"Thereupon hearing the noise of these monkeys Sugriva, their chief, being greatly delighted, uplifted his tail.","alignment":{"type":"1:1","confidence":0.617,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-32"],"status":"unreviewed"},"source":{"sanskritLocator":"5062035","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3b295eff7fc42892f1b28b9e167550af05b852a3adfca218f07b7855cb2d5fe1","compact":"d1632726d1e5ed83910713f17b22c1c3ec65b28a7e0611963b00e96ec2c97d94","nasal":"266cd6ee4920f7db8aba1109f664c85c5705692cb3e9aac4918469dfc39c01eb"}},{"id":"VRCE-5-62-36","kanda":5,"kandaId":"sundara","sarga":62,"verse":36,"english":"And placing Angada and Hanumān before them those monkeys proceeded to behold Rāma.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-33"],"status":"unreviewed"},"source":{"sanskritLocator":"5062036","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e92f2d84c797ff8713475ec7ae9a3287adc8e30c9a0a5263ceda3d80c60399c7","compact":"c8b86a4651c941fede5ae40973ecee25c3625c7203b639d0707e41f0c7e7fceb","nasal":"9eaf7ecbf9563929ca03d95bc9a6b213fae590da34f3f561339df8c740b16657"}},{"id":"VRCE-5-62-37","kanda":5,"kandaId":"sundara","sarga":62,"verse":37,"english":"Those heroes headed by Angada, delighted and intoxicated, descended before Rāghava and the lord of the monkeys.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-34"],"status":"unreviewed"},"source":{"sanskritLocator":"5062037","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2a5bc981a2dd04b9e76dd83e35b96384eeccd027fa4125f72cb8c4e9b8e5eeda","compact":"c925528916492ae71434bfe0b8787607c4935c881d6620be028582c09edd839a","nasal":"e267d73254771e424cb5b970564cd0bda7d46086f82ab1a33fa67147d083e42d"}},{"id":"VRCE-5-62-38","kanda":5,"kandaId":"sundara","sarga":62,"verse":38,"english":"And the mighty-armed Hanumān, lowering his head, related to Rāghava, Sītā's spiritual and physical well-being.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-35"],"status":"unreviewed"},"source":{"sanskritLocator":"5062038","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c8dce3f7de5ef0c7d16912f3ca9e30a7b9132b4d993bb795ea62e2fd2ef67d1","compact":"09132496e59541c61458d1ff1aa7632f5d6a978ca5ff60aec43137ca78db8c37","nasal":"09132496e59541c61458d1ff1aa7632f5d6a978ca5ff60aec43137ca78db8c37"}},{"id":"VRCE-5-62-39","kanda":5,"kandaId":"sundara","sarga":62,"verse":39,"english":"And being confirmed thus by the Wind-god's son, Laksmana, greatly pleased, respectfully looked towards Sugriva.","alignment":{"type":"1:1","confidence":0.93,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-37"],"status":"unreviewed"},"source":{"sanskritLocator":"5062039","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"14a1de00e97bab8b645d6dab629e84c68eb34a57991015d00cadcacdb3daf62f","compact":"7d5ef3f885726c9ba983b30b3d5393fdad9602bf48d3fd33a1078e0a6001e05e","nasal":"7d5ef3f885726c9ba983b30b3d5393fdad9602bf48d3fd33a1078e0a6001e05e"}},{"id":"VRCE-5-62-40","kanda":5,"kandaId":"sundara","sarga":62,"verse":40,"english":"And Rāghava too, the slayer of foes, worked up with joy, cast respectful looks towards Hanuman.","alignment":{"type":"1:1","confidence":0.532,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-64-38"],"status":"unreviewed"},"source":{"sanskritLocator":"5062040","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d01057c665405312851168fcc5e66a224fbe640744d98a5a55ec42044ef753d","compact":"6dc65243d0553660e18b11ee21fafa1c927872dbbad7ec452d0b62ae4a5cdfbb","nasal":"b42ba5e85d5ee962fbb2b75ae2893ffdc35634cbf8d8aaba34f52a002a714f8d"}}]
