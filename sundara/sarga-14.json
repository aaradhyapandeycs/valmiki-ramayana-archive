[{"id":"VRCE-5-14-1","kanda":5,"kandaId":"sundara","sarga":14,"verse":1,"english":"Having eulogized Sītā, worthy of being praised and Rāma, endeared by accomplishments that foremost of monkeys again engaged in meditation.","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5014001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"136b62714cd58311a852253430e03f26bcdad231c762c713495e94fd60892a55","compact":"56cc471fd5b84919d7baaf30ae29eaced052a36f2c52d16ac8dcdf46b1e6a7bf","nasal":"9908177a70ff8835eec4a4ec7dc4d754d1472d33083732f5d761047afd5e8d9d"}},{"id":"VRCE-5-14-2","kanda":5,"kandaId":"sundara","sarga":14,"verse":2,"english":"Having reflected for some time, the powerful Hanumān, having his eyes full of tears bewailed on Siita's account (in the following strain).","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5014002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"428fad68dbec5e81c7b08c19856ebc3aa74dea39114b728e260831c70cfd19ae","compact":"1a4b9700b8aa5cdb2a809827d0302527b6a9b2b523e84426c685d3d3177339d7","nasal":"1a4b9700b8aa5cdb2a809827d0302527b6a9b2b523e84426c685d3d3177339d7"}},{"id":"VRCE-5-14-3","kanda":5,"kandaId":"sundara","sarga":14,"verse":3,"english":"No one can withstand the course of destiny since Sītā, being the spouse of the worshipful brother of Laksmana, ever obedient to his elders, has been overwhelmed with grief.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5014003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b2e27ea974923b43aa80ad1275f210041e987440fff3a58d093f1fdffb50