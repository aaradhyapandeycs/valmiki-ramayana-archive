ritLocator":"5014028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"036ec6bbf7e2d488c15c48012c1cadb20d9806ba2b16390acc2efcd4d5734736","compact":"c6034b7311d89d134d45f215a2c14ae73d8e1bb63586ddc510672f90fce4f1e3","nasal":"5e2c012ed3c2f29643de4a41304bd79e028a504fb3ec71ab5811c23b78e402ec"}},{"id":"VRCE-5-14-29","kanda":5,"kandaId":"sundara","sarga":14,"verse":29,"english":"She, patient as the Earth, having eyes resembling lotuses, who was ere this protected by Rāghava and Lakşmaņa, is now being guarded by Rākşasīs having terrible eyes, under the trees.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5014029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fe8a14290f07d6f95ba6a76e89256859a3a4c00013dc198e2e8d269122b6a370","compact":"7e3eaec64de873d09bba6ce8487b87e181bceda9730b69947e3e05232174d70c","nasal":"7e3eaec64de873d09bba6ce8487b87e181bceda9730b69947e3e05232174d70c"}},{"id":"VRCE-5-14-30","kanda":5,"kandaId":"sundara","sarga":14,"verse":30,"english":"Being harassed with continued miseries, the daughter of Janaka has lost all her beauty like to a water-lily crushed with frost, and has come by a miserable plight like to a doe separated from her mate.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5014030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"012b052d8a63358a1c51d0537a2498c5b159047e5d405f2db20b44709726b18c","compact":"47546c86a2ca7ab56659f3f0e54a10f879e4515c3a25a649f6455c2080244bff","nasal":"5ea1495b242a34004fdbc142f82c52e6c0fce469c2c74636b3d5c5b5118f63d7"}},{"id":"VRCE-5-14-31","kanda":5,"kandaId":"sundara","sarga":14,"verse":31,"english":"The branches of the Asoka trees, lowered down with flowers are as if enhancing her grief as also the Moon of many thousand rays, at the expire of the winter.\"","alignment":{"type":"1:1","confidence":0.471,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5014031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4f386dbbc0b06ea1b81bc11a25a44a97eaf74c87e74537ce9f268a0eff55a8c8","compact":"a8f3b7e001fda7f3725eab3c932d517d74eea8e4942165060cfe6578c8ed7de5","nasal":"03886c0f0c0c2a4521372e7bc4a506b2c0390b8ab9f1d6d12e7e63b348c2fc58"}},{"id":"VRCE-5-14-32","kanda":5,"kandaId":"sundara","sarga":14,"verse":32,"english":"Having reflected thus and arrived at ine conclusion that she was Sītā, that powerful leader of monkeys gifted with velocity stationed himself on that tree.","alignment":{"type":"1:1","confidence":0.848,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-16-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5014032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"90e1b64553944da2d6321ade276c70e03cff9bd12c047dbcf8e27be3236c2f21","compact":"4957cb652806104b9c42ce72eedf609f8bfb54f00e5a6d3fd2daffcdbafd6c14","nasal":"ef63eda5b62b8132361978bc9035a5294fccafc385ab792e4f3d7b6727c8140c"}}]
