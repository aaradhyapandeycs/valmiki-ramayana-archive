[{"id":"VRCE-5-44-1","kanda":5,"kandaId":"sundara","sarga":44,"verse":1,"english":"Learning that the sons of the counsellors had been slain by the high-souled monkey, the Tennecked one suppressing the apprehension that was in his heart, restored the balance of his mind.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-46-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5044001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0593f29694ebbbfbeb899a19b557cc8eaea43c33ac8a76d0db550a6f22eeb114","compact":"4744a34deb053f34ffd39fc671685a8954b80a1179dc79d1fafd4a7a14835597","nasal":"0cf262ecae831df992d68d27470439c91b47a841722cd1ee4d2ddc7d1c3b4187"}},{"id":"VRCE-5-44-2","kanda":5,"kandaId":"sundara","sarga":44,"verse":2,"english":"He directed five of the foremost leaders of his forces, the heroic Virūpaksa Yupakşa, the Rāks asa Durdharsa, Praghasa, and Bhasakarma, versed in polity, endowed with the speed of the Wind in conflict and alert on every occasion, to take Hanumān captive.","alignment":{"type":"grouped","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-46-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5044002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ba52add2bfde0536d3d0c9558d5098119a1b0b60eb2a614d6e05104779e77b9e","compact":"24334588cf18d24130f00955b0d7dce9c0b74507a21a7bde8755b2ddcbd9d2a5","nasal":"93adc37a1f3ee301009956e4135feefb455d925c89d5548193e8f47b145e2bc9"}},{"id":"VRCE-5-44-3","kanda":5,"kandaId":"sundara","sarga":44,"verse":3,"english":"He directed five of the foremost leaders of his forces, the heroic Virūpaksa Yupakşa, the Rāks asa Durdharsa, Praghasa, and Bhasakarma, versed in polity, endowed with the speed of the Wind in conflict and alert on every occasion, to take Hanumān captive.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram