[{"id":"VRCE-5-66-1","kanda":5,"kandaId":"sundara","sarga":66,"verse":1,"english":"Thereupon, O foremost of men, out of your love and adoring me for your friendship, that worshipful dame-addressed me again, saying.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5066001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fd1a769a041dfea9b5e20f809f410471fb20a70a59c50e3f09ab97322a2f18f1","compact":"5c46d21724b908dfd71e78989e73d9c2d1ca295361d2cbed0b7782a0b6be9744","nasal":"0adcc425fffe2faba417d20fd5cd92461214c6df33b3b0c16d48465dc68159d2"}},{"id":"VRCE-5-66-2","kanda":5,"kandaId":"sundara","sarga":66,"verse":2,"english":"Do you thus speak every thing to Rāma, the son of Daśaratha, so that he might soon take me hence, slaying Ravana in battle.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5066002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a08b01238f1f01d21aac1e3a6f6d0827a3ae1436ec281f88bfa41e7d562a830e","compact":"9e16c299d629d76c53329ce6a35ce4128fe70b262d095e532ec1194e3589f07e","nasal":"9e16c299d629d76c53329ce6a35ce4128fe70b262d095e532ec1194e3589f07e"}},{"id":"VRCE-5-66-3","kanda":5,"kandaId":"sundara","sarga":66,"verse":3,"english":"O hero, O slayer of foes, if it please you, you may relieve yourself of the toil by living in a secret nook and then proceed to-morrow.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5066003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0a6de4db8fa63d85bea35147a4c4cf9eaf4c19e98f4e9c35ed872e5e9ec6516","compact":"b87109ccc8196f646845c9a545bc823b68bc897a34620cc1a1a9246646572d41","nasal":"02dfe6391822589f2e20fecb14856b49c09c7652030028e45419656505ad8a0d"}},{"id":"VRCE-5-66-4","kanda":5,"kandaId":"sundara","sarga":66,"verse":4,"english":"O monkey, in your company, I do momentarily forget the weight of my grief, unfortunate as I am.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-4"],"status":"unreviewed"},"source":{"sanskritLocator":"5066004","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"871565d660149009ecfad208abcfa4b728e631270516c8c4f1df6d4da957cf03","compact":"8fbedf859584575f311b29824babc596ca01532cad7629bbe5390246e5fbe9d7","nasal":"8fbedf859584575f311b29824babc596ca01532cad7629bbe5390246e5fbe9d7"}},{"id":"VRCE-5-66-5","kanda":5,"kandaId":"sundara","sarga":66,"verse":5,"english":"O you gifted with great prowess, yourself departing, I shall wait for your return, but doubt I very much whether I shall live till then.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5066005","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6da16b3cb7879310c5dcfadd931da4e6014734a6fe6123e8f5ae272f9b696058","compact":"cef51a06113d8f2d8b523b374cc6b02305c3314442b36e0acd186badd6f220b1","nasal":"fa3830a107cc4dd9494cf2e48aac2694c53c278d888f15a9821c7b2dbac309fe"}},{"id":"VRCE-5-66-6","kanda":5,"kandaId":"sundara","sarga":66,"verse":6,"english":"Burnt I shall be with the fear of not beholding you again, wretched and stricken with grief as I am. And so I shall be, hereafter, overwhelmed with a mightier grief.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5066006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bbb455c6c63e868c45bf25ed44cdbd5410c98276c53c1c17d2a9beed2af3bf86","compact":"ed1e13462158ec1918ae38cab4d89349dd0b3f3ecefdb937cc6fd98f850fbbda","nasal":"ed1e13462158ec1918ae38cab4d89349dd0b3f3ecefdb937cc6fd98f850fbbda"}},{"id":"VRCE-5-66-7","kanda":5,"kandaId":"sundara","sarga":66,"verse":7,"english":"O hero, besides, I entertain a grave doubt about your assistants, the monkeys and bears. I do not know how shall the host of monkeys and bears and those two princes cross over the mighty main?","alignment":{"type":"grouped","confidence":0.705,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5066007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"84136745ebae35e35c0077682136433d3b58193f656104d044d6f8b4a8a3e5ee","compact":"debae5b513a7dd4d621d20bdfe330829e8942fa93c38e7566ca1cc8831ae70f8","nasal":"debae5b513a7dd4d621d20bdfe330829e8942fa93c38e7566ca1cc8831ae70f8"}},{"id":"VRCE-5-66-8","kanda":5,"kandaId":"sundara","sarga":66,"verse":8,"english":"O hero, besides, I entertain a grave doubt about your assistants, the monkeys and bears. I do not know how shall the host of monkeys and bears and those two princes cross over the mighty main?","alignment":{"type":"grouped","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5066008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6798144f0ae24f268c27c94d4c1cacfa8a608c8a5fac9e8fb864109b699bdf30","compact":"e3b71307c46096c6bf081c12242198c4059ed4a2c0105adec185a2e1ac835875","nasal":"7a384650cff20836d52e15999e31b6c3263ad8ef11a1f46ff59d9db858b5afae"}},{"id":"VRCE-5-66-9","kanda":5,"kandaId":"sundara","sarga":66,"verse":9,"english":"O innocent monkey of all the creatures three only are qualified to cross over the ocean, yourself, Garuda and the Wind.","alignment":{"type":"1:1","confidence":0.935,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5066009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cb2ed1e7ca8779a32828c870e62194d3937fe0375c758a00a347a7d3b5e0b2b3","compact":"234235c9de717b3506b003dba3242c2cff377de8480e859d21097ecf07af31ec","nasal":"ac50c32918577fedbb7afc6c9829a5ffaebea4d20dae4b651c8e5b64ad87e77c"}},{"id":"VRCE-5-66-10","kanda":5,"kandaId":"sundara","sarga":66,"verse":10,"english":"O you foremost of those skilled in speech, what had you settled about the accomplishment of this hard work?","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5066010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"84ee87e4069ccfb737d2a5ea09084abb5282877f13308f3224e486893babbc24","compact":"277e88d60fe5ba18dadcfdaa6455d4d3aa82343d6eb5a9b81c378c66ed02a136","nasal":"277e88d60fe5ba18dadcfdaa6455d4d3aa82343d6eb5a9b81c378c66ed02a136"}},{"id":"VRCE-5-66-11","kanda":5,"kandaId":"sundara","sarga":66,"verse":11,"english":"True it is that you are alone qualified to accomplish this work, you the slayer of inimical heroes-but such manifestation of your prowess shall increase your glory only.","alignment":{"type":"1:1","confidence":0.842,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-10"],"status":"unreviewed"},"source":{"sanskritLocator":"5066011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"75fffb948182f3016190f0ef8a3a3ac032de5988c8c843c95cc6dd95a4252644","compact":"cd74888932f76138d511273c705b21cdd9d821b82ec659626109ab7313edb004","nasal":"cd74888932f76138d511273c705b21cdd9d821b82ec659626109ab7313edb004"}},{"id":"VRCE-5-66-12","kanda":5,"kandaId":"sundara","sarga":66,"verse":12,"english":"But if Rāma, obtaining victory, can take me hence to his own city, it shall redound to his glory.","alignment":{"type":"1:1","confidence":0.788,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5066012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8799bde6c76271770fcb0cb239272ca145eb9fadd3b98f70e2d5c487c812ba0","compact":"54c2df75d5d499ece9d7b4d92bf6cb81d63a230b3b5d8451b472fdc4ebccdeb2","nasal":"54c2df75d5d499ece9d7b4d92bf6cb81d63a230b3b5d8451b472fdc4ebccdeb2"}},{"id":"VRCE-5-66-13","kanda":5,"kandaId":"sundara","sarga":66,"verse":13,"english":"It dose not behove the heroic Rāghava, to take me away by steal, like to Rāvaņa capturing me from the forest under a disguise.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5066013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"89ab405d42f875cce7b06c0dc3cdcbff8bf844284d0e00ba4e5d9a1fbbf702cf","compact":"f029457239d7f95fd129b4e7414506b1acd6348ca83c8725a3daf2ee672b9882","nasal":"f029457239d7f95fd129b4e7414506b1acd6348ca83c8725a3daf2ee672b9882"}},{"id":"VRCE-5-66-14","kanda":5,"kandaId":"sundara","sarga":66,"verse":14,"english":"Truly it shall be his becoming work, if Kākutstha, the repressor of enemy's host, can take me away, enveloping the city Lankā with his army.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5066014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac4a6820ba4a29dab6259b1bb1a360459959985786b7c816f5f49b0d1082d286","compact":"e631be403f95bca9883d108b929fae4bea94de66f322a24c431bfc44ad429195","nasal":"7e9c44f59c13973ff4dcb05ea8b420e82e64331baa2e0f62cce514ef39153ea5"}},{"id":"VRCE-5-66-15","kanda":5,"kandaId":"sundara","sarga":66,"verse":15,"english":"Do you therefore initiate that work as become that high-souled hero and may display his prowess.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5066015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"22cd63b6df9c378fdd5ecccb9a0f979f284ccf6f8e9825057ef63554e1bdc2a9","compact":"393a8cf6fd28f1629d455b915232821852d1ff7a412f3d1ba9f0a284bcde769d","nasal":"4c0864d2929ca24475dc59843c5d5235b4092830b33d5b2bf662ef9cb5a2c516"}},{"id":"VRCE-5-66-16","kanda":5,"kandaId":"sundara","sarga":66,"verse":16,"english":"Hearing these sound reasonable and affectionate words I gave her the last reply, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5066016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0e2ced1d166722cfc5aeba52a3689ce45047ce2e2ea8f4ad9837ef6d7d0fa88","compact":"4167115b5f3319182cb75feae780b5aed131adc6773ca3d69eb09679b0f2e2d7","nasal":"4167115b5f3319182cb75feae780b5aed131adc6773ca3d69eb09679b0f2e2d7"}},{"id":"VRCE-5-66-17","kanda":5,"kandaId":"sundara","sarga":66,"verse":17,"english":"O worshipful dame, Sugrīva, the foremost of the monkeys, the lord of monkey and bear hosts and gifted with manliness, has resolved upon rescuing you.","alignment":{"type":"1:1","confidence":0.638,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5066017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"de2483556f26ab5ae67a61a0597cda7f9546c623d7c0b5e18afe0fc57272c6b9","compact":"6680a904c71f698d961063c1d3f38fe77d26976a5d99ba241d1e3fc41a6be4e5","nasal":"35d60193d061501d9888ec5dfc906b705c0b4a252312ea9cc428451b5bb10e27"}},{"id":"VRCE-5-66-18","kanda":5,"kandaId":"sundara","sarga":66,"verse":18,"english":"He has under his command a number of mighty and courageous monkeys gifted with great prowess and quick-coursing like imagination.","alignment":{"type":"1:1","confidence":0.557,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5066018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af9be438ca3e4f30f00aa984a4d94db86d7d7675e209e345c245999a750514cd","compact":"73799c4ccd573799191baf5f7e74ee41c5093ad18f41ded0360c4d83c4295062","nasal":"6bf703c60551fed1d7d5ffc7b7e0424ee3707045f0c14c3cc6db13f3a47e6a55"}},{"id":"VRCE-5-66-19","kanda":5,"kandaId":"sundara","sarga":66,"verse":19,"english":"Their course is never thwarted-whether going upwards or downwardsor moving tortuously. They are never exhausted in their actions—highly courageous and of measureless prowess.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5066019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b5362b578972e1c3e2a6b864133c538888b5f68800a817040c56a1abbdbd2d4","compact":"6698fab468cec1cc1ba18f517eaa121db8a1cb89daab76912dcc6d031ccf5426","nasal":"46aebe7bf949f1b713624c47cca942dde07d58483aca92b01898c3b0d61f6110"}},{"id":"VRCE-5-66-20","kanda":5,"kandaId":"sundara","sarga":66,"verse":20,"english":"And those great and powerful monkeys, coursing in the air, have again and again circumambulated the earth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-68-19"],"status":"unreviewed"},"source":{"sanskritLocator":"5066020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f06717eaa310963afbd16ca9e403011a37cb5c75dfa71221faee1a5beb1204a0","compact":"92cc5f0ea9f5e4bb86dfa51433c49b46de57f7f2d5d84e360fc