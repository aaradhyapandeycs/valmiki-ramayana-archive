["DUTT-5-37-38"],"status":"unreviewed"},"source":{"sanskritLocator":"5035040","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8bee3abe4b2b3a1c28a8d101a84d590e6816f78e5ba3d122eb5d4d487ecdc1ce","compact":"d709e42ba427e97842a6fb43757b2802d67c154450b0f0cbc704e8e5134bd0c7","nasal":"0790fc9abccf7bf6468044963271766d47de82ee0ef61bba2d0e0381d6b60d1c"}},{"id":"VRCE-5-35-41","kanda":5,"kandaId":"sundara","sarga":35,"verse":41,"english":"Beholding the Wind-god's own begotten son, Hanumān, resembling a huge mountain, Sītā, the daughter of Janaka, having eyes resembling lotus-petals, said.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-39"],"status":"unreviewed"},"source":{"sanskritLocator":"5035041","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d45f6a46a5ed2ba5322bacc009403cbe8194f89619b4c4f39416ef21e2f585bd","compact":"d94ac8569bc1468a8ce7d11331dcd63a05460dbf0e32477037429be287088d0e","nasal":"d94ac8569bc1468a8ce7d11331dcd63a05460dbf0e32477037429be287088d0e"}},{"id":"VRCE-5-35-42","kanda":5,"kandaId":"sundara","sarga":35,"verse":42,"english":"O great monkey, I know your strength and bravery, they air-like motion and your wonderful fire-like energy.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-40"],"status":"unreviewed"},"source":{"sanskritLocator":"5035042","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f558a8729b0ab8eb2d0dfce9141f25ff5cd8d1d065aaea685e82528199a4831","compact":"43487da4cb13697ce39abc0ffc07cb120673b0579158d94bfa132e1e3e9fd6e6","nasal":"43487da4cb13697ce39abc0ffc07cb120673b0579158d94bfa132e1e3e9fd6e6"}},{"id":"VRCE-5-35-43","kanda":5,"kandaId":"sundara","sarga":35,"verse":43,"english":"What ordinary man can come here crossing the incomparable ocean.","alignment":{"type":"1:1","confidence":0.912,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-41"],"status":"unreviewed"},"source":{"sanskritLocator":"5035043","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79c2ec21a35019915f594b7724fa40c9aea8a3f338eb7cb9dce00d6dfa42b273","compact":"1808ed8aa171d196738464bd78188d19912d5b6ce2db389af370190d0e37a90b","nasal":"0fdc5ccfb7544eca437d2c0fd47a639c36ac58fe79064d6f771674e3b260046e"}},{"id":"VRCE-5-35-44","kanda":5,"kandaId":"sundara","sarga":35,"verse":44,"english":"O lord of monkey hosts, I understand that you are capable of returning and you shall be able to carry me. But I should consider now how the work might be accomplished.","alignment":{"type":"1:1","confidence":0.419,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-42"],"status":"unreviewed"},"source":{"sanskritLocator":"5035044","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"431d8419d8a0f3cfd8ec235cc3650d55533120999357ce4f4bc0386ab3b1c01c","compact":"22f0b4053479ad40e1d37ef9b8ed120f6fba5ad77fb46d7fd793ea7814928080","nasal":"670abedac9ecadcc6f02b221355857be0816e8453cff5b919902a6242a0d3523"}},{"id":"VRCE-5-35-45","kanda":5,"kandaId":"sundara","sarga":35,"verse":45,"english":"O foremost of monkeys, I should not go with you. Perhaps I might lose my sense with your air-like velocity.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-43"],"status":"unreviewed"},"source":{"sanskritLocator":"5035045","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d8361403ffab97d3e56559582c2667d50fea5e81a2c336c3b8d3248de51a86e","compact":"25b1411880ef63bb0040e93def0217f9a1a47b96facb5f0e0ec29ad3a3b5fe35","nasal":"a2707040ac95a45c67215a3a4ca30a66900124cda8146be9f5552facb16249fc"}},{"id":"VRCE-5-35-46","kanda":5,"kandaId":"sundara","sarga":35,"verse":46,"english":"When moving terribly you shall proceed high up in the welkin, perhaps I shall then fall down.","alignment":{"type":"1:1","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-44"],"status":"unreviewed"},"source":{"sanskritLocator":"5035046","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"237e78268a8841aa88082c09b1b9dc73b3e4c2c167fbdf32e4f1a557408ab7a3","compact":"0800351d3c2aa7ec8d36cdbf422c29978fcbdda2d3e85df31803ac545345ac40","nasal":"8129d03de13058b437f7caa3d945af6f9b911504dc449aa4d7bc53f49a7a8750"}},{"id":"VRCE-5-35-47","kanda":5,"kandaId":"sundara","sarga":35,"verse":47,"english":"No sooner I shall fall down into the ocean infested with fish and other animals than I shall be an excellent food to them.","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-45"],"status":"unreviewed"},"source":{"sanskritLocator":"5035047","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aa7704d0fbe53b6ee8493ebe966c110cda2d48d87bedbf7a7c706f7f6fbfcf77","compact":"273095921316ccf8548fa50450f28d5fa1ebcdee4f92b8292350adf3cd43ef60","nasal":"f5666473ecdd7d776c5410e2d084dc8fa3664628163658c3b54298fbe1d2ba69"}},{"id":"VRCE-5-35-48","kanda":5,"kandaId":"sundara","sarga":35,"verse":48,"english":"O slayer of foes, I shall not be able to accompany you. For seeing you carry a woman, they shall surely suspect you.","alignment":{"type":"1:1","confidence":0.766,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-46"],"status":"unreviewed"},"source":{"sanskritLocator":"5035048","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bac2cc3eac8cf5c5034d259bd75d4f2612a9f656730383aad02422c9881b71cc","compact":"6499efd78618303ff270b60be3cbd393e45f5c6ef7224cf0fe76014447c96120","nasal":"afd2f1191f3e158f90347d76fa04eeabd1ac6bb025221ffd2dd474a7e1fa25da"}},{"id":"VRCE-5-35-49","kanda":5,"kandaId":"sundara","sarga":35,"verse":49,"english":"And finding me stolen, those terribly powerful Rākşasas commanded by the vicious-souled Rāvana, shall follow you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-47"],"status":"unreviewed"},"source":{"sanskritLocator":"5035049","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"582485c6b6b8b923d367393147f48cbfd9b083296d641841ddff4f1dc70aea15","compact":"9837921f6ed819118310895e89a58452bf4d39a54b7f0a59d4564e39a0147875","nasal":"9837921f6ed819118310895e89a58452bf4d39a54b7f0a59d4564e39a0147875"}},{"id":"VRCE-5-35-50","kanda":5,"kandaId":"sundara","sarga":35,"verse":50,"english":"O hero, carrying me and encircled by those heroic Rākṣasas with maces and darts in their hands, you shall be beset with dangers.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-48"],"status":"unreviewed"},"source":{"sanskritLocator":"5035050","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d93a5b43c8ab2b44311ad11604f671b94c235e74fd423a103c1e205dd1961dea","compact":"8229ae8c12b946b7cd18e40be71b6d8ad9cacc668b090f2b4a424d31d565012f","nasal":"8229ae8c12b946b7cd18e40be71b6d8ad9cacc668b090f2b4a424d31d565012f"}},{"id":"VRCE-5-35-51","kanda":5,"kandaId":"sundara","sarga":35,"verse":51,"english":"And on the sky the Rākşasas shall be armed with weapons and you shall be without any. How shall you be able to fight and protect me at the same time.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-49"],"status":"unreviewed"},"source":{"sanskritLocator":"5035051","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e98b7ec8c7b1c4a2ad4826e5b5fa740f994e993a943e1faeeff49f53ecfc3d53","compact":"4c64b99b9355f2c419113a326622e21d9c4e4aa126c15fd665ad5210e4521df7","nasal":"4c64b99b9355f2c419113a326622e21d9c4e4aa126c15fd665ad5210e4521df7"}},{"id":"VRCE-5-35-52","kanda":5,"kandaId":"sundara","sarga":35,"verse":52,"english":"When you shall be engaged in conflict with those Rākşasas of terrible deeds, I, O foremost of monkeys, stricken with fear, shall fall down from your back.","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-50"],"status":"unreviewed"},"source":{"sanskritLocator":"5035052","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1daf5ce368b961032e4d174edb99ba9c8c3a8eea7d33f306201dba3414f2b1fa","compact":"cb468d008d4aa4b14667c9aed24c7bc8604d2ad3e3e75bbc5a8bdfdbe03baa3a","nasal":"cb468d008d4aa4b14667c9aed24c7bc8604d2ad3e3e75bbc5a8bdfdbe03baa3a"}},{"id":"VRCE-5-35-53","kanda":5,"kandaId":"sundara","sarga":35,"verse":53,"english":"O foremost of monkeys those terrible and powerful Rākşasas shall be able to defeat you a little. And when you shall be defeated in battle I shall fall down and those vicious Rākṣasas shall carry me away from your hands or destroy me.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-51"],"status":"unreviewed"},"source":{"sanskritLocator":"5035053","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a81f7a5c5cc86d78ac9193bc65c26ac4a6c39922fc61fea1727cd45aadb9c6e2","compact":"b0ad1dcaf9b1abcebb37ed7336ce2093f797dfd08b0d29d94958b951eb32dcab","nasal":"6901a4b325ccbce2b8798b61c4fd2308b4bb0a4bff816ae72edd4d37b8775faa"}},{"id":"VRCE-5-35-54","kanda":5,"kandaId":"sundara","sarga":35,"verse":54,"english":"O foremost of monkeys those terrible and powerful Rākşasas shall be able to defeat you a little. And when you shall be defeated in battle I shall fall down and those vicious Rākṣasas shall carry me away from your hands or destroy me.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-51"],"status":"unreviewed"},"source":{"sanskritLocator":"5035054","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"992fcf778bb67301d5260329f77663eb60be34c356b0002dc465c4cee97762da","compact":"572d52d13050d67ae23221952905c57b82824103679a96af9b029b4580c174ff","nasal":"572d52d13050d67ae23221952905c57b82824103679a96af9b029b4580c174ff"}},{"id":"VRCE-5-35-55","kanda":5,"kandaId":"sundara","sarga":35,"verse":55,"english":"Victory or defeat is uncertain in a battle. I shall thus be distressed by those Rākşasas setting up terrible roars and they endeavours shall be fruitless, O best of monkeys.","alignment":{"type":"grouped","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-52"],"status":"unreviewed"},"source":{"sanskritLocator":"5035055","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d278e231243ea561ddab455e4a1e0b8eca23bba1d655fd108445893c270a2c34","compact":"2b6e927223b217d4abae873ea5912f2a0d912f1767ca6e1bb8511574c80da55f","nasal":"2b6e927223b217d4abae873ea5912f2a0d912f1767ca6e1bb8511574c80da55f"}},{"id":"VRCE-5-35-56","kanda":5,"kandaId":"sundara","sarga":35,"verse":56,"english":"Victory or defeat is uncertain in a battle. I shall thus be distressed by those Rākşasas setting up terrible roars and they endeavours shall be fruitless, O best of monkeys.","alignment":{"type":"grouped","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-52"],"status":"unreviewed"},"source":{"sanskritLocator":"5035056","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"182beab47d2abb30a775b3108d1e54e47a7e3e7e24d0cb707fc9376f26c4f5c9","compact":"4a13c2d0cc846b12c61c3ae4dec18566b642c952d440328f0977eb583c241b0c","nasal":"84ba93f90ee1c1ca671e9a6367f712de6e8dc3e0da8ed1afbf8c41ed73858952"}},{"id":"VRCE-5-35-57","kanda":5,"kandaId":"sundara","sarga":35,"verse":57,"english":"You are capable of destroying the Rākṣasas very easily (I admit)—but Rama's fame shall then be souled if do you bring about their destruction.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-53"],"status":"unreviewed"},"source":{"sanskritLocator":"5035057","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4ab452e8b2803824bf33d3674adfe17daec8ead16a903422d6e5a9e642e35be","compact":"1106e048e6699b3bf55b84cf379c32468bc575a2506ca0a7d85aa53472685e68","nasal":"cbfec341e1a1699408c5955b6edf84e281657247225149d870d7308f2ac91dc5"}},{"id":"VRCE-5-35-58","kanda":5,"kandaId":"sundara","sarga":35,"verse":58,"english":"Or the Rākşasas taking me away shall keep me in such a secret place, that neither the monkeys nor Rāghava shall be able to ascertain my where abouts.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-54"],"status":"unreviewed"},"source":{"sanskritLocator":"5035058","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c6d601c503cd7be246317cf8af9c77cf7dfc359302898beea244f11d96447be7","compact":"f5a6a2d78affab99e86f19ee06ea8d03562b6c67149c31a8c04bd2d3f4b25e9f","nasal":"f5a6a2d78affab99e86f19ee06ea8d03562b6c67149c31a8c04bd2d3f4b25e9f"}},{"id":"VRCE-5-35-59","kanda":5,"kandaId":"sundara","sarga":35,"verse":59,"english":"All your preparations for me, shall thus be useless. And mighty shall be the result of Rāma's coming with you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-55"],"status":"unreviewed"},"source":{"sanskritLocator":"5035059","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"318d682f2f5adf5891517b74e2987196fabad5a7fd864d8902548bbd88d2115e","compact":"1fbd1f691d5443886f6153d9d86b584de2c74de359d57d390de30f71158ed617","nasal":"e335f6dc09112d005decebd1b8bfab79d78acd8dacff8293c1451699a74970d8"}},{"id":"VRCE-5-35-60","kanda":5,"kandaId":"sundara","sarga":35,"verse":60,"english":"O large armed one, the life of Rāghava of unmitigated prowess, those of his brothers and of your royal race are all subject to me.","alignment":{"type":"1:1","confidence":0.731,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-56"],"status":"unreviewed"},"source":{"sanskritLocator":"5035060","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05b5aa7185183d32d91aac32c69bcbe52ba5a144f2c2c113c3ae3071107bf3e3","compact":"498156e4a38b287c961ccc2eafc7373d313210afbe8c2849c9ad753f8ba328f1","nasal":"498156e4a38b287c961ccc2eafc7373d313210afbe8c2849c9ad753f8ba328f1"}},{"id":"VRCE-5-35-61","kanda":5,"kandaId":"sundara","sarga":35,"verse":61,"english":"When they shall give up their hopes of releasing me, they, worn out with grief and anxiety shall renounce their lives along with the monkeys and bears.","alignment":{"type":"1:1","confidence":0.708,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-57"],"status":"unreviewed"},"source":{"sanskritLocator":"5035061","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8633e5df25ae2dd8f55cb7480f74f3f860d8efe21f81d6ddefbc7af23345e4da","compact":"6d1de56f94e2d0dcaca4aed9461375cec0574bf3535112f7eae130772c1117b5","nasal":"6d1de56f94e2d0dcaca4aed9461375cec0574bf3535112f7eae130772c1117b5"}},{"id":"VRCE-5-35-62","kanda":5,"kandaId":"sundara","sarga":35,"verse":62,"english":"O monkey, being guided by my love for my husband, I do not like willingly to touch any body's person but Rāma's.","alignment":{"type":"1:1","confidence":0.757,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-58"],"status":"unreviewed"},"source":{"sanskritLocator":"5035062","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d307f1e9493233222eda845b9d15d8db8fc955aa1c78d69f3dec35582cde8a37","compact":"b12765266b71069185cc1a66a14053da4b58ff38dc1952f80a97d4b3abf2234b","nasal":"b12765266b71069185cc1a66a14053da4b58ff38dc1952f80a97d4b3abf2234b"}},{"id":"VRCE-5-35-63","kanda":5,"kandaId":"sundara","sarga":35,"verse":63,"english":"When Rāvaņa, by force touched my person, I had no other help, for I was then without me lord and therefore was subject to another person.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-59"],"status":"unreviewed"},"source":{"sanskritLocator":"5035063","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a15a63509a1e4229ebd6bf215b89bb9e9a9a23f98ae5a1647b096059af30fc92","compact":"68cd744e474b2e16ecd1801529ac8b3093b57f06618f5aa7fa236c84bd39c9f9","nasal":"68cd744e474b2e16ecd1801529ac8b3093b57f06618f5aa7fa236c84bd39c9f9"}},{"id":"VRCE-5-35-64","kanda":5,"kandaId":"sundara","sarga":35,"verse":64,"english":"If Rāma can take me away from here, destroying the Ten-necked one with all the Rākşasas-he shall then perform the worthy action.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-60"],"status":"unreviewed"},"source":{"sanskritLocator":"5035064","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cad72f0202d29ef52c6991bc41521d846be88331bc2e9e4d34bfe4864bbbed1c","compact":"1f05255b0b4d9b578965ba10fd90584c3515f9fa27cf176db56072bc55449439","nasal":"1f05255b0b4d9b578965ba10fd90584c3515f9fa27cf176db56072bc55449439"}},{"id":"VRCE-5-35-65","kanda":5,"kandaId":"sundara","sarga":35,"verse":65,"english":"I have heard of and myself seen the prowess of the highly-souled (Rāma) unconquerable in a battle. There is none among the celestials, Gandharvas, Nāgas and the Rākşasas who can match him in a conflict.","alignment":{"type":"1:1","confidence":0.722,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-61"],"status":"unreviewed"},"source":{"sanskritLocator":"5035065","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1fff3e99ea41dfdccef8a5540477b9ef623b99789ae39271eebb142b444b99b0","compact":"c5c93ebb18a487b269efe4825c0c042a65fbb891af60cef94c0ab4e150c929ca","nasal":"c9c500510f490991152797852ac4d3ab0fcb1db2176687ceddd64556e429fc03"}},{"id":"VRCE-5-35-66","kanda":5,"kandaId":"sundara","sarga":35,"verse":66,"english":"Beholding that highly powerful Rāghava, in a conflict, like to Vāsava in prowess, holding a wonderful bow and followed by Lakşmaņa, who can withstand his prowess resembling the flaming fire?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-62"],"status":"unreviewed"},"source":{"sanskritLocator":"5035066","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a2eabe152739e0a34376563c9e38577295b34b90f809991592329dff7ffad3cb","compact":"e2d85dc7c619178922059d781cad5b66bf3c075fc62e38d9493019c831285367","nasal":"e2d85dc7c619178922059d781cad5b66bf3c075fc62e38d9493019c831285367"}},{"id":"VRCE-5-35-67","kanda":5,"kandaId":"sundara","sarga":35,"verse":67,"english":"O foremost of monkeys, who can withstand Rāghava in a conflict, followed by Lakşmaņa moving like infuriated an elephant and showering shafts like to the rays of the sun at the time of Dissolution?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-63"],"status":"unreviewed"},"source":{"sanskritLocator":"5035067","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f13b3067aa936403951f796dbcf217948982a035c29f22a4fdbb3c3a63b5875","compact":"02faa278505ed711d41a42005723d99b37c7f870824383537e71a71b36178f01","nasal":"175365862b36948143678f48bb6a0d6625e2b15e4e5018b9f3591868961dcf2d"}},{"id":"VRCE-5-35-68","kanda":5,"kandaId":"sundara","sarga":35,"verse":68,"english":"O best of monkeys do you speedily bring here my dear one along with Lakşmaņa and the lord of monkey hosts. O heroic monkey, do