,"compact":"d7e4b9782d3313f049a1c0bc087a621ecafc2830048f4d1200de481ca14134e6","nasal":"d7e4b9782d3313f049a1c0bc087a621ecafc2830048f4d1200de481ca14134e6"}},{"id":"VRCE-5-35-21","kanda":5,"kandaId":"sundara","sarga":35,"verse":21,"english":"Or I shall release you even to-day from the grasp of that Räkşasa and these miseries. Do you place yourself on my back, O you of a blameless person.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-20"],"status":"unreviewed"},"source":{"sanskritLocator":"5035021","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d1e240506652821f7baa9fc5a0591f148184a93507667bc7587b0ad19a57be81","compact":"d045c69f033c3caea9c45870a672381b44f35239d33406c5bddc3d2100a89126","nasal":"dd37a0a7887818078611d3f103d5ced3dc348e90a6ec456293a536c709985957"}},{"id":"VRCE-5-35-22","kanda":5,"kandaId":"sundara","sarga":35,"verse":22,"english":"And having you on my back I shall leap over the main. I am capable of carrying the city of Lankā even with Rāvana.","alignment":{"type":"1:1","confidence":0.909,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5035022","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4190b4572360cd3a5e7e596bd0eb2381c06934fa1034cf4d0f40d3342d9ac45","compact":"a67619a16af28dff316713f9d1423f8071d8acfcf87c2a3ab9fd28fd99eb007a","nasal":"50e4a13e53efd25055aa34e1e5a96a4384720cf004647a4c40ddc56760b5cb57"}},{"id":"VRCE-5-35-23","kanda":5,"kandaId":"sundara","sarga":35,"verse":23,"english":"I shall restore you to-day, O Maithili, to Rāghava on the mount Prasravaņa, like to fire carrying to Indra, the sacrificial offerings.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-22"],"status":"unreviewed"},"source":{"sanskritLocator":"5035023","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72cca60a10b382fef0d2cc161408330ca4346590351e898298ab60e81c0f3ef8","compact":"66635d2299cb3f4fbfd38255a95c743306e13ad9877068e45c00998ca9256eb7","nasal":"66635d2299cb3f4fbfd38255a95c743306e13ad9877068e45c00998ca9256eb7"}},{"id":"VRCE-5-35-24","kanda":5,"kandaId":"sundara","sarga":35,"verse":24,"english":"You shall behold to-day, O Vaidehi, Rama along with Lakşmaņa, making preparations (for the destruction of his enemy) like to Vişņu, engaged in the destruction of demons.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-23"],"status":"unreviewed"},"source":{"sanskritLocator":"5035024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cfce92832f20046ac132c22de00dbe7fb840c3104fb06b9ce494e6d4d4cc57e7","compact":"427505e2c8af1ea132da616ac5d4414882f1b2833f55bdd0fd2b7eea96f78221","nasal":"427505e2c8af1ea132da616ac5d4414882f1b2833f55bdd0fd2b7eea96f78221"}},{"id":"VRCE-5-35-25","kanda":5,"kandaId":"sundara","sarga":35,"verse":25,"english":"(And you shall observe) that highly powerful one, anxious to behold you and seated like to Purandara on the summit of that foremost of mountains.","alignment":{"type":"1:1","confidence":0.78,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5035025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5390f02cb952e8436c464e153b8ba578eb479eb3f5cb14f29c3ff3deaf1c6de5","compact":"9837d5c673c83a3f6ed844b920600c44d268e46af92995a5f03c7dcd2e155c9f","nasal":"9dc1ce0d90d8c667abd9f8fcb47576bb2979de89cb3cb6018de893005524fd69"}},{"id":"VRCE-5-35-26","kanda":5,"kandaId":"sundara","sarga":35,"verse":26,"english":"Do you place yourself on my back, O worshipful dame, do you not neglect it, O beautiful lady, and be thus reconciled to Rāma like to Rohini restored to the Moon.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5035026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c219eed46ae6f43f0753482d864da82c5189a2efb8ea8b1db8b3e3164ca5f1ed","compact":"e6d523cdd1759d0ab5a207d1657a5d1635f901c74f44a0ebad6f6065afe6509e","nasal":"6408acf92c5a109d3eb33b1519349fd0d4aeec903443860287799bfe0abee6e1"}},{"id":"VRCE-5-35-27","kanda":5,"kandaId":"sundara","sarga":35,"verse":27,"english":"By the time, that we will take in talking thus, you shall reach Rāma like Rohiņi restored to the Moon. Do you therefore place yourself on my back and I shall cross the ocean sailing by the aetherial way.","alignment":{"type":"approximate","confidence":0.18,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5035027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c4aac137b216e7984ab7e00ec73a3e30de20f3af6ec2ebaa4f12cfed67203a4c","compact":"4319aa1d31b711546ac779590b6613cee50a1d22de779235cf1ef68b8834f3c7","nasal":"ebf9ff6eb63fa366364100ac2dda84cc17397632a58e4143e535280ca9c0ac4b"}},{"id":"VRCE-5-35-28","kanda":5,"kandaId":"sundara","sarga":35,"verse":28,"english":"O fair one, carrying you from this place, none among the inhabitants of Lankä shall be able to follow me.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5035028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"200b1f1112f3e1498908cdd55085868cf6db06ca0fdd49005ab16aaac66fea9c","compact":"a25a85064522bf5344f031862571a434def2a160d0e97c8324370234b7de80e1","nasal":"c644c4ed8719cba0e463b59385f9ee04a007ff3c2b279e020f0046b1dcd4306f"}},{"id":"VRCE-5-35-29","kanda":5,"kandaId":"sundara","sarga":35,"verse":29,"english":"In the same way I have come here I shall return by the welkin, O Vaidehī placing three on my back.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5035029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a97ac7edcdd17dbe5a20d5d1807f087d627df446cc25a63a50d8730d1aa3e917","compact":"1dd768d4a19d622de7c5b2dcc7ecddd85b438eaf84df6762a1ee0096377d882b","nasal":"1dd768d4a19d622de7c5b2dcc7ecddd85b438eaf84df6762a1ee0096377d882b"}},{"id":"VRCE-5-35-30","kanda":5,"kandaId":"sundara","sarga":35,"verse":30,"english":"Hearing those surprising words from that best of monkeys, Maithilī, having her entire frame worked up with joy, again bespake Hanumān.","alignment":{"type":"1:1","confidence":0.9,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5035030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5203e2933f9db8c9a46034ecba6290870f66afe665cd2ec0b81449382727f2e2","compact":"343051650750bb84443e3f499dcd9a5680dd8e4cf51c12c6feb16f4e29b294ed","nasal":"7c44422707bce584196e156c2fa356784478399b275e3867ca7521879e72981e"}},{"id":"VRCE-5-35-31","kanda":5,"kandaId":"sundara","sarga":35,"verse":31,"english":"Hanumān, how darest you take me to such a long distance? O lord of monkey hosts, this attests to your monkey-hood.","alignment":{"type":"1:1","confidence":0.679,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5035031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"36ec5fea392feeb0e99f8bad6440613f66e154a3b5bcd0907fae35dba428616c","compact":"749b695ab549b54a63dee51ecce9b488751cdf9ef4ee7dd538e5c4195294e2b8","nasal":"04f4683f82f959434f3a209b9ea422e0839c63eff55f11342ae0d5c3d9262a44"}},{"id":"VRCE-5-35-32","kanda":5,"kandaId":"sundara","sarga":35,"verse":32,"english":"O foremost of monkeys, little-bodied as you are, how do you desire, to take me hence to my husband the lord of men?","alignment":{"type":"1:1","confidence":0.938,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5035032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ba23ae75054d6a1865e5d90b435140acf541724b64cfff43a10d8f26595b3a17","compact":"2a3657f03ea8ae04b35ddd21a87537902aa1797cc185a4f30833932db40208c7","nasal":"f783758022e1c90f07cdc4bf35bfec60e27a6c9a4e6329a33547608550d55e5d"}},{"id":"VRCE-5-35-33","kanda":5,"kandaId":"sundara","sarga":35,"verse":33,"english":"Hearing the words of Sītā, the graceful son of the Wind-god Hanumān reflected aside-This is my first insult.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-32"],"status":"unreviewed"},"source":{"sanskritLocator":"5035033","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db981852ce0fd495c387b7b303aef0dcd381cabc535ddacfe099e20e07c2f036","compact":"5880b9611e584d41a1753ef22570151d68f9a56cf1540c2ca6c0f62a80ef74e5","nasal":"2499cfdf5c3efd49124306cb6f444ba76a3e3a8da7f1cc33906768c02cc70ea8"}},{"id":"VRCE-5-35-34","kanda":5,"kandaId":"sundara","sarga":35,"verse":34,"english":"The lotus-eyed dame is not cognizant of my prowess or strength. Vaidehi should therefore learn that I can assume shapes at will.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-33"],"status":"unreviewed"},"source":{"sanskritLocator":"5035034","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"96c78174e35c03c6fb2da16d1778373ad0d0a550958c3d415d8c83312fea630e","compact":"8a9aca14fc16ea06cf18bcd3cb11f99ad86b86f7d3b634831f797db187733930","nasal":"8a9aca14fc16ea06c