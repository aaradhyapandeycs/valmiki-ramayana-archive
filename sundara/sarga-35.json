[{"id":"VRCE-5-35-1","kanda":5,"kandaId":"sundara","sarga":35,"verse":1,"english":"Hearing those words, Sītā having a moon-like countenance, again spoke to Hanuman, words, sound and pious:","alignment":{"type":"1:1","confidence":0.885,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5035001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6da6a69e42b7f5f002924ae6d8265766b2106cfbd18d863568be41779041adb4","compact":"9a12c5d28faa3ac3f77984fad918bca9d6e521ea423edb44ed1d1f51fcbe1e26","nasal":"78dc96bf4004896501b93896ce9a771bc481532f7f7e6d647c5696cf64f00d66"}},{"id":"VRCE-5-35-2","kanda":5,"kandaId":"sundara","sarga":35,"verse":2,"english":"O monkey, what you had said that Rāma is not attached to any other thing and is worn with grief, is like nectar mixed with poison.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5035002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a9519aafa7981afd791bf34ee5978ca5428f27481797598708557403ddd6caa","compact":"d54f4ae79c5433a6eebc84d2f157457e71af191dd41338fd64eee147baa8dcc7","nasal":"d54f4ae79c5433a6eebc84d2f157457e71af191dd41338fd64eee147baa8dcc7"}},{"id":"VRCE-5-35-3","kanda":5,"kandaId":"sundara","sarga":35,"verse":3,"english":"Whether in the enjoyment of vast riches, or emerged in the abyss of miseries, Death is pulling a man, binding him roughly with a chord.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-37-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5035003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2db21582daa2fb2a59eb7719a04c4d9aa52d50d8874b69b6de74f425339f40ba","compact":"ed8713d8a5091dda776a68768211ce3aea025981392bc5793b70ea4f2681cdb0