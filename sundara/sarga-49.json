[{"id":"VRCE-5-49-1","kanda":5,"kandaId":"sundara","sarga":49,"verse":1,"english":"Seeing the Ten-necked one of mighty energy, that foremost of monkeys, endued with strength, calmly spoke to him words containing sense,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-1"],"status":"unreviewed"},"source":{"sanskritLocator":"5049001","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"064a61ca302fc6335966e1ad8852a6f402e36fd33b1a9bc6c687692ced7440ae","compact":"e46f65bb79586874b272993014e7f0ba2aa899ee5b65760a20d3c3f86eb58785","nasal":"e46f65bb79586874b272993014e7f0ba2aa899ee5b65760a20d3c3f86eb58785"}},{"id":"VRCE-5-49-2","kanda":5,"kandaId":"sundara","sarga":49,"verse":2,"english":"I have come to you at you command of Sugriva, O lord of Raksasas. Your brother, the king of monkeys, enquires after your welfare.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-2"],"status":"unreviewed"},"source":{"sanskritLocator":"5049002","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b039b9384bea61528a7016b7b62bf3c90b6497e6f8cf869eb15b40194030814d","compact":"e0f32e0a05c87d4bb84f91dc845a3a604bcce45b4098e02cec2076e5a7e46e68","nasal":"3ea5ba7c8efbb6772fb11fddcc4b0c589f1531c8e7380ff0cffdc056c41bb29a"}},{"id":"VRCE-5-49-3","kanda":5,"kandaId":"sundara","sarga":49,"verse":3,"english":"Listen to the desire of your brother, the highsouled Sugrīva, and his words fraught with righteous sense and capable of working one's good here and hercafter.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-3"],"status":"unreviewed"},"source":{"sanskritLocator":"5049003","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ecc811a46640066612092c7716bb8479adf432a3c39c94dcf99023a3badfa09","compact":"40f0a6c6c54d