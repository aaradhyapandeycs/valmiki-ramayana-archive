UTT-5-51-5"],"status":"unreviewed"},"source":{"sanskritLocator":"5049006","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"378049de3b54b3d53920b957539988d70d2aa638d6d6c67f5932ca8f554d17e5","compact":"cd9c7406c246fd51f18a39b683facf7904e7af77c77c9a3970d09ec76270227b","nasal":"527984cbcf898ee340748779b3677511c7b184fe8216fc29d12dacd49427e2e4"}},{"id":"VRCE-5-49-7","kanda":5,"kandaId":"sundara","sarga":49,"verse":7,"english":"His name is Rāma, and he is exceedingly energetic, and ever abide on the path of virtue. His spouse, the celebrated Sītā, daughter to Vaideha, the high-souled king Janaka, either died or was carried off in Janasthāna.","alignment":{"type":"1:1","confidence":0.517,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-6"],"status":"unreviewed"},"source":{"sanskritLocator":"5049007","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"45d841148f263994a19c47bf896d4a23e7fc860ad014188ee3f03d21128856c4","compact":"96e374b75c6c0b97cee3470147bbc1e1a22ac0b3f6c4c4548cc38f998139c7ec","nasal":"96e374b75c6c0b97cee3470147bbc1e1a22ac0b3f6c4c4548cc38f998139c7ec"}},{"id":"VRCE-5-49-8","kanda":5,"kandaId":"sundara","sarga":49,"verse":8,"english":"Seeking for that exalted lady, the king's son, accompanied by this younger brother, arriving at Rşyamūka, met with Sugrīva.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-7"],"status":"unreviewed"},"source":{"sanskritLocator":"5049008","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3fcb0aa298b948a191cb98c3a14744e8d690d97802ac32d711b478b16eb4edea","compact":"c937bffcaa5c2c15e0662d474e1944a4ddad94a893a76cf7bd7b75b7a7789202","nasal":"c937bffcaa5c2c15e0662d474e1944a4ddad94a893a76cf7bd7b75b7a7789202"}},{"id":"VRCE-5-49-9","kanda":5,"kandaId":"sundara","sarga":49,"verse":9,"english":"And Sugrīva promised that he would undertake the search for Sītă, and Rāma (on his part promised) that he would confer on Sugrīva the kingdom of the monkeys.","alignment":{"type":"1:1","confidence":0.969,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-8"],"status":"unreviewed"},"source":{"sanskritLocator":"5049009","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"71d8c5407d1670c189af4b99e330c276253bdad2a8e3f8b6ee684414dc627c0a","compact":"54deee3f2138b7953fe8d648901c088c4b14f32c6407f8c3b3e8d34ee7be6b10","nasal":"54deee3f2138b7953fe8d648901c088c4b14f32c6407f8c3b3e8d34ee7be6b10"}},{"id":"VRCE-5-49-10","kanda":5,"kandaId":"sundara","sarga":49,"verse":10,"english":"And, thereupon, slaying Vāli in battle, the king's son established Sugrīva as the lord of the monkeys.","alignment":{"type":"1:1","confidence":0.853,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-9"],"status":"unreviewed"},"source":{"sanskritLocator":"5049010","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"28813a5ccc0dcc5286d463b6394ae48f9d6737440219a25f10f274447333a089","compact":"74b15ab0433b5fcb3f8242eef629ecd5c35b3bdf4b521ff986c2abd0b759968d","nasal":"74b15ab0433b5fcb3f8242eef629ecd5c35b3bdf4b521ff986c2abd0b759968d"}},{"id":"VRCE-5-49-11","kanda":5,"kandaId":"sundara","sarga":49,"verse":11,"english":"And, thereupon, the lord of monkeys, Sugrīva, true to his vow, eager for searching Sītā, despatched monkeys in all directions.","alignment":{"type":"grouped","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-11"],"status":"unreviewed"},"source":{"sanskritLocator":"5049011","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"163b3db9febbcde6d9d4d87db3f86ccaccf72c0da447abc82bcb71190d95c441","compact":"a7c49510022d734694171dd5ed4985e17b73e3518692146e0572be2a8d7d625d","nasal":"a7c49510022d734694171dd5ed4985e17b73e3518692146e0572be2a8d7d625d"}},{"id":"VRCE-5-49-12","kanda":5,"kandaId":"sundara","sarga":49,"verse":12,"english":"And thousands and hundreds and niyutas of monkeys are exploring all sides, below and above in the sky.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-12"],"status":"unreviewed"},"source":{"sanskritLocator":"5049012","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7b133de644478422b0b07b9c615850303845edc8ffc7bca4ecd29e28358c469c","compact":"34438f4269a1160518891617132a7b8dc39f6762e91fe2b8813329e3e59636ee","nasal":"fcecb5f20b4640b04f9d1f226d866cc411ab85a25eb1aa496a1264e6f0a4f481"}},{"id":"VRCE-5-49-13","kanda":5,"kandaId":"sundara","sarga":49,"verse":13,"english":"Some are like Vinata's offspring, (Garuda) and some like the Wind; their Course is incapable of being resisted; and those heroic monkeys are endued with strength and celerity.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-13"],"status":"unreviewed"},"source":{"sanskritLocator":"5049013","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42476c7d94f57b852ded191b578dfd20bc205ca4fa4a0ba549b1c60cf40c8e46","compact":"4e6db706161ecef909de362ba4374991c819a1e2b894beef1ece47308ca08c7b","nasal":"4e6db706161ecef909de362ba4374991c819a1e2b894beef1ece47308ca08c7b"}},{"id":"VRCE-5-49-14","kanda":5,"kandaId":"sundara","sarga":49,"verse":14,"english":"I, Hanumān my name, am the son of the Wind-god. For Sitã, I, desirous of seeing her, have come hither, bounding over the main measuring a full hundred Yojanas. And as I was roving, I came to see Janaka's daughter in your house.","alignment":{"type":"1:1","confidence":0.576,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-14"],"status":"unreviewed"},"source":{"sanskritLocator":"5049014","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5944d4b6bffdd107d92e2579ad997d72b2262db693f0de8d1bf12e7f690036f6","compact":"6ed0b6f6db1c37f5fca1d45e12136050973c69db3a2637d851c169a57a51b6c1","nasal":"427bee5dfea052dea0c7ae8f8cf61b00c84eaba42264f4b6aa40f719137246c8"}},{"id":"VRCE-5-49-15","kanda":5,"kandaId":"sundara","sarga":49,"verse":15,"english":"You are cognisant of righteousness and interest, and had attained prosperity through your asceticism. Therefore, O eminently wise one, you ought not to confine another's wife.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-15"],"status":"unreviewed"},"source":{"sanskritLocator":"5049015","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e4ce26b9256e9f57406df0dd673f34a528b68ad959e80364842fd42e4f79612","compact":"24b3c28e72b6f9876551f46a35db6c29b3a0a8bf78e6f81d37bf1b5501faa84a","nasal":"41df66a4d4d486b6efc2066e7cdeb919f8d7f365a5d5384874fd51042727f8de"}},{"id":"VRCE-5-49-16","kanda":5,"kandaId":"sundara","sarga":49,"verse":16,"english":"Actions opposed to righteousness, and bringing on countless evils, and causing extermination, ill become persons of your sort.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-16"],"status":"unreviewed"},"source":{"sanskritLocator":"5049016","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"51e291e0f8d621761a9be3a8b7d638e7b203b1effa81b722856d2e303e0db018","compact":"df16e8bd6699eb0842aecb48049fa3fa18c5a2b0205251b07ac52aad32b785bd","nasal":"071bdc872af94130167d908aa28a755fe6c2974cb6a5cd64d03167d930b48ed7"}},{"id":"VRCE-5-49-17","kanda":5,"kandaId":"sundara","sarga":49,"verse":17,"english":"Who is there even among celestials and Asuras that is competent to stay before the shafts shot by Lakşmaņa and Rāma in wrath?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-17"],"status":"unreviewed"},"source":{"sanskritLocator":"5049017","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"df9b61575be5d45939cc42f06bf6ecd1c896e3bd6587d7312b8bdb86fcf074c2","compact":"99fbe77dc55d3f8002d835dfe668a6c41ab680e6078ee93b88ac6bf78884ed63","nasal":"99fbe77dc55d3f8002d835dfe668a6c41ab680e6078ee93b88ac6bf78884ed63"}},{"id":"VRCE-5-49-18","kanda":5,"kandaId":"sundara","sarga":49,"verse":18,"english":"There is none, O king, in all the three worlds, that is capable of attaining ease, after inflicting injury on Rāghava.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-18"],"status":"unreviewed"},"source":{"sanskritLocator":"5049018","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d573dc9b86c31c818b3fda493273e9a6f174889dbbccd6f5c59010abca6dafa8","compact":"e549950bf51d29844bc1c9f45211a0c2ea070be8d3c38de9523aaedf0833fd44","nasal":"e549950bf51d29844bc1c9f45211a0c2ea070be8d3c38de9523aaedf0833fd44"}},{"id":"VRCE-5-49-19","kanda":5,"kandaId":"sundara","sarga":49,"verse":19,"english":"Treading the path of virtue and profit, do you pay heed to my speech fraught with good for three times; (Present, past, and future) and do you return Jānaki to that foremost of men.","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-19"],"status":"unreviewed"},"source":{"sanskritLocator":"5049019","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b659b34016e4165c5244cdf7316ba51f380b86029795ea8c77d019f25bf9f433","compact":"ae8ef00235a6bc8e0964ed8e56fd603ec045aa999769c327825677304a9791f1","nasal":"d9e070b8b81eb2b3cda13eb68cbd1ecdc8bcbe247f460e5ba9cafd3316fcdaaa"}},{"id":"VRCE-5-49-20","kanda":5,"kandaId":"sundara","sarga":49,"verse":20,"english":"Seen have I this exalted lady, which was difficult to compass. As for what remain to be done, Rāma himself shall bring it about.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-20"],"status":"unreviewed"},"source":{"sanskritLocator":"5049020","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0a3993ed8238b592bc2cd8ae5fa882e35e3cf48e0f2391b7d65164d64e7032e3","compact":"0a540d6d8e48f8c6c23770f70a1408a5d072ecc23c867a2511a8e64d74b9abb0","nasal":"0a540d6d8e48f8c6c23770f70a1408a5d072ecc23c867a2511a8e64d74b9abb0"}},{"id":"VRCE-5-49-21","kanda":5,"kandaId":"sundara","sarga":49,"verse":21,"english":"That Sītā I have beheld overwhelmed with grief, whom, albeit resembling a five-hooded serpent in your mansion, you know not.","alignment":{"type":"1:1","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-21"],"status":"unreviewed"},"source":{"sanskritLocator":"5049021","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7e7e4d6f95cc6a243ef05ab9b3c595b28312533fce00ef352c55ea825cdbc9d3","compact":"08daec873239ddb9d98f6c0ad68e072ded091c264b75bbe4830cebdd8c9bfcb0","nasal":"86248eae8f307046310191de75f581e45eb7579fd0323aa73f54b11d86936fe5"}},{"id":"VRCE-5-49-22","kanda":5,"kandaId":"sundara","sarga":49,"verse":22,"english":"And even as food thoroughly mixed with poison, being taken, is incapable of being digested, this one is incapable of being subdued even by the celestials and Asuras.","alignment":{"type":"1:1","confidence":0.732,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-22"],"status":"unreviewed"},"source":{"sanskritLocator":"5049022","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0c5e640568a6607a3f21cdd6f0227f02cd01b37a58e83f2bdebe35eb55d487e2","compact":"17ef8d9460f00b6c1175fcb516e309e3b53008d92f97262149df64dc1a6e58d4","nasal":"fc3481ae1369f0e849650b672d208654795fd650017932c840afbde538c69e63"}},{"id":"VRCE-5-49-23","kanda":5,"kandaId":"sundara","sarga":49,"verse":23,"english":"It is not proper to destroy religious merit reaped by undergoing extreme mortification, as well as access of life attained by the same means). (By such an iniquitous act as this.)","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-23"],"status":"unreviewed"},"source":{"sanskritLocator":"5049023","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b5a045f0365a62f6ed05f50ad8d213e83979b1e93a7d787190f1f6324d4e51fb","compact":"2271600856160ccd7b949652d07a3249021aaa100fba03cce2a28f63ef6652b4","nasal":"2271600856160ccd7b949652d07a3249021aaa100fba03cce2a28f63ef6652b4"}},{"id":"VRCE-5-49-24","kanda":5,"kandaId":"sundara","sarga":49,"verse":24,"english":"You deem yourself by virtue of your asceticism incapable of being destroyed by the celestials and Asuras; and herein your great merit (incident to they austerities) is the cause.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-24"],"status":"unreviewed"},"source":{"sanskritLocator":"5049024","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac1fb82a67b7dfd03c8eb915d24d2955d2d9354644fd1b1992ecf3a39bb1f5b1","compact":"8101f1e021ed5f8469ecc83f4629070141486612e70ef20f54b59717550b6260","nasal":"8101f1e021ed5f8469ecc83f4629070141486612e70ef20f54b59717550b6260"}},{"id":"VRCE-5-49-25","kanda":5,"kandaId":"sundara","sarga":49,"verse":25,"english":"But Sugrīva is not a god or a Yakṣa or a Rākşasa. Rāghava, O king, is a mortal and Sugrīva is the lord of monkeys. How can you, O king, save your-life from them.","alignment":{"type":"approximate","confidence":0.571,"method":"fuzzy-nearby-witness","duttRefs":["DUTT-5-51-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5049025","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d1b2ef4d32f0e18de372f63adf7478949fff39e10152c0411a4b1bf050e8967f","compact":"459d034b1cf2a1be2468df00f6c79e2462d434b67866ce74878b695e5fda9dfc","nasal":"2954c00222547c27742b687528ec9b5ebcacca225a96a1ba2eb753a3534a9ca7"}},{"id":"VRCE-5-49-26","kanda":5,"kandaId":"sundara","sarga":49,"verse":26,"english":"But Sugrīva is not a god or a Yakṣa or a Rākşasa. Rāghava, O king, is a mortal and Sugrīva is the lord of monkeys. How can you, O king, save your-life from them.","alignment":{"type":"grouped","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-25"],"status":"unreviewed"},"source":{"sanskritLocator":"5049026","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7712b766c38cd2e03fe123f323e897a096c3982fa1916a82068f6f145cc18e39","compact":"0b2378cc8078efb64f589faf68dae840217cdd34d70561064898f35c58943ed6","nasal":"0b2378cc8078efb64f589faf68dae840217cdd34d70561064898f35c58943ed6"}},{"id":"VRCE-5-49-27","kanda":5,"kandaId":"sundara","sarga":49,"verse":27,"english":"He that, confiding in his strength, commit himself to foul proceedings, cannot count upon his righteous deeds, but his evil ones follow him.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-26"],"status":"unreviewed"},"source":{"sanskritLocator":"5049027","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c67532371709ae5718403d95f2e7fa806e3280fe60502b7d2594ee747956548","compact":"43f0f779dd34c3def7cc9b1d6716f7cb7fd5152b77939b1bd6001d38594643e7","nasal":"43f0f779dd34c3def7cc9b1d6716f7cb7fd5152b77939b1bd6001d38594643e7"}},{"id":"VRCE-5-49-28","kanda":5,"kandaId":"sundara","sarga":49,"verse":28,"english":"Virtue destroy vice, (yet vice like yours destroy all virtue). (The parenthetical part is the commentator's filling in of the deficiency in the sentiment) You, without doubt, had obtained the fruit of your righteousness, and the fruit also of this iniquity you shall reap without delay.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-27"],"status":"unreviewed"},"source":{"sanskritLocator":"5049028","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee041fdd10109a51e700dafa2263e0dcf78a001d25d129d725d1c80cf62b2f9a","compact":"920b89f7e0c6d839a4e93d36c1866664f366472dd2a75690044a36128cad7b11","nasal":"920b89f7e0c6d839a4e93d36c1866664f366472dd2a75690044a36128cad7b11"}},{"id":"VRCE-5-49-29","kanda":5,"kandaId":"sundara","sarga":49,"verse":29,"english":"And taking to heart the carnage in Janasthāna and the slaying of Vāli as well as the friendship of Rāma with Sugrīva, do you understand yours own good.","alignment":{"type":"1:1","confidence":0.651,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-28"],"status":"unreviewed"},"source":{"sanskritLocator":"5049029","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e9b338360c47cffe503a986ddf8a5abc6b8473af50e3d66b2b7b11785c2bd4a9","compact":"e32eb983304aa070045dffa929ca3df3c2d2cc7a7b432d489290fc64c1bcb9b5","nasal":"e32eb983304aa070045dffa929ca3df3c2d2cc7a7b432d489290fc64c1bcb9b5"}},{"id":"VRCE-5-49-30","kanda":5,"kandaId":"sundara","sarga":49,"verse":30,"english":"I, alone that I am, can at my will destroy Lankā with her steeds and elephants and cars; but he whose envoy I am has not yet decided on this point.","alignment":{"type":"1:1","confidence":0.79,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-29"],"status":"unreviewed"},"source":{"sanskritLocator":"5049030","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17605f44bc521487ba57e4ac0f88ccf542faff583ef9a4629734f5198727db3a","compact":"856c0cbcb8b41460ae0e9c28405d2cbd614c3baaf2666dadd36559b2df15023e","nasal":"988076eee6e2a1332f4faddfeb5a9110e9bc561d9f641b2d1dbb77795eee855f"}},{"id":"VRCE-5-49-31","kanda":5,"kandaId":"sundara","sarga":49,"verse":31,"english":"Rāma has in presence of the tawny-eyed (ones) forsooth promised the annihilation of the foe by whom Sītā has been sore oppressed.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-30"],"status":"unreviewed"},"source":{"sanskritLocator":"5049031","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"318c9b0d9b888b3871d3eba8fe4475b76ad11a9af8673df15c124ffbe7494ab8","compact":"ac659f505b57b8a76dd194db1ad9b2fd1ebf47067a1cd25591d9b0decfb8c971","nasal":"ac659f505b57b8a76dd194db1ad9b2fd1ebf47067a1cd25591d9b0decfb8c971"}},{"id":"VRCE-5-49-32","kanda":5,"kandaId":"sundara","sarga":49,"verse":32,"english":"On wronging Rāma, Purandara himself cannot escape scot-free, what shall I say of persons like you?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-31"],"status":"unreviewed"},"source":{"sanskritLocator":"5049032","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"162c25a2db4044a10439c5538c9aecee12bf24703b815020d667f94c8fedcb0a","compact":"a4bc4c7972db16a44e3c2d98872c1b1c566692ecc6d37a43ea121c220a6f9526","nasal":"a4bc4c7972db16a44e3c2d98872c1b1c566692ecc6d37a43ea121c220a6f9526"}},{"id":"VRCE-5-49-33","kanda":5,"kandaId":"sundara","sarga":49,"verse":33,"english":"Her-whom you know as Sītā staying in yours abode-know her for the Fatal Night that shall bring destruction down on all Lankā.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-32"],"status":"unreviewed"},"source":{"sanskritLocator":"5049033","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"70963aa84e38915bf20d57433d49c08a4a3bdaaa7a21107fad7b4ea424e148e8","compact":"5abb23baae0f1b7fe7e035433752b4d0b0ee41d4ec1b21512ab3eb8e27b6c839","nasal":"b921c28ec16cf0f8cd8b967a1b51d46d0962206d0ffbc8f7eb393a6da9c384f9"}},{"id":"VRCE-5-49-34","kanda":5,"kandaId":"sundara","sarga":49,"verse":34,"english":"Therefore, beware of yourself turning about your neck the fatal noose in the shape of Sītā! Do you rather study your welfare.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-33"],"status":"unreviewed"},"source":{"sanskritLocator":"5049034","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c993a9b3c3bdf3b73ef39d41c2ea5f7fe2f28dfb733a0df9a03f645ece2485c2","compact":"b660bd58aecc4ba4831f372514112e8cab9640e6974a98ea0584ea8210808d84","nasal":"f114ad17759053ac5784e4259b93435c3363641e6a1686f7a5e9a306c362c059"}},{"id":"VRCE-5-49-35","kanda":5,"kandaId":"sundara","sarga":49,"verse":35,"english":"You shall behold this city crowned with edifices and stalls, in flames fed by the wrath of Rāma, and consumed by the energy of Şītā.","alignment":{"type":"1:1","confidence":0.621,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-34"],"status":"unreviewed"},"source":{"sanskritLocator":"5049035","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3ab9037419578721c841d436e5f3fcf469ce0232cb955b961c3acf6e3fd806eb","compact":"8c257229691472a9a6ff66953c25b85dbb54d9b5877800279b5d6c4111b3629d","nasal":"8c257229691472a9a6ff66953c25b85dbb54d9b5877800279b5d6c4111b3629d"}},{"id":"VRCE-5-49-36","kanda":5,"kandaId":"sundara","sarga":49,"verse":36,"english":"Hearing the distasteful yet excellent speech of the bold and matchless monkey, the ten-necked one, with his eyes whirling in wrath, ordered the destruction of that mighty monkey.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-5-51-42"],"status":"unreviewed"},"source":{"sanskritLocator":"5049036","sanskritFile":"Ram05.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2d604130bdf210c8d4963afd67d998e6d34b9b614880ec05fc5319f3140d35b9","compact":"d70f762395