[{"id":"VRCE-6-7-1","kanda":6,"kandaId":"yuddha","sarga":7,"verse":1,"english":"Being thus accosted by their lord, the highly powerful Rākşasas, devoid of good sense and ignorant of sound counsel, replied with folded palms, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-7-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6007001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cba52b0d4e2d828d519bd7f0a5aef7a59b0266e8f480b54d74fb060d00d27120","compact":"da30cfcd14d1b7e485dbd6cedfae6675cce9f77793e72b9c0a4d1b51c179271c","nasal":"d1fa9dc2e6312b3de286dbc25faa79ea021048217f84b9bb78d263c70cb4dd4f"}},{"id":"VRCE-6-7-2","kanda":6,"kandaId":"yuddha","sarga":7,"verse":2,"english":"You have, o king, enough of soldiers and various types of weapons like parighas saktis etc. Why are you smitten with sorrow then?","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-7-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6007002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"727335f8542516c41cead215a0c8c522e0b60fed0698e05c024ba052632c3af9","compact":"99590b167e04e1174b991d51761eba4d0ddd4ef0a5f4325857f9f91e0f8014f9","nasal":"a6c459cedf6362b9232a1255ded4520ab5833b136a320b0214d1fdd246fb8fa1"}},{"id":"VRCE-6-7-3","kanda":6,"kandaId":"yuddha","sarga":7,"verse":3,"english":"Repairing to Bhagavatī, you did discomfit the serpents in battle. The God of Death, living on mount Kailasa, encircled by Yaksas, was subjugated by you in a great battle.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-7-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6007003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ce55f06887d93bdc02ada535ec802ddc2361dbab165f5a5d1ccc6c0654234706","compact"