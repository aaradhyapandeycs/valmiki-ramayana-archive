59,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6042006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db8c6a173be169325d9791cfcfefaad022c09e1b5fdfff929713c7d1b572f156","compact":"436449b729a02b1d827a1cb4a61705dfd808fbac7f8ebf1e0612565faa1dcf03","nasal":"436449b729a02b1d827a1cb4a61705dfd808fbac7f8ebf1e0612565faa1dcf03"}},{"id":"VRCE-6-42-7","kanda":6,"kandaId":"yuddha","sarga":42,"verse":7,"english":"Those monkey-leaders, their bodies pierced with shafts and their persons riven with darts, took up trees and crags.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6042007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"473fa9cfd8e17ad6d495b91d3749dfff581b0c15644e2572e7eb0b7e4d305c42","compact":"1a3113e2c2e14292ee8d4fcc949a60644c9588c1d30ab5bec6230e2b4dc009b8","nasal":"7a05e089cc52608852e7a3560c5c7ed13c0b6b3f8f64ee406ac82aeec4579d2a"}},{"id":"VRCE-6-42-8","kanda":6,"kandaId":"yuddha","sarga":42,"verse":8,"english":"Those monkeys, endowed with terrific vehemence, sending up shouts, and proclaiming their respective names, set about tossing the brave Rākşasa rank,","alignment":{"type":"1:1","confidence":0.69,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6042008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0f67c1cd69b1e54d78ebb0512c65084f4ba33739cb7691ca650d74d49a2447dc","compact":"dc6eda2d2061af0a78184edec6079c07b2c9dca7c279db47b4b6ddb2b99d517c","nasal":"289e940a68fceb2442ef24735ef62e4e8f81ca1b73b3673659111cecdcc94882"}},{"id":"VRCE-6-42-9","kanda":6,"kandaId":"yuddha","sarga":42,"verse":9,"english":"The monkeys, waged with diverse rocks and innumerable trees, waxed exceedingly furious.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6042009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f10ab7d391a44eff1310b06dc6a5a2f5c391e63576aaa945199a9929a44236f9","compact":"c5200e36e299f548a830735c63781fba93cfd65ffae0c18cb92fd35d6e6a7899","nasal":"c5200e36e299f548a830735c63781fba93cfd65ffae0c18cb92fd35d6e6a7899"}},{"id":"VRCE-6-42-10","kanda":6,"kandaId":"yuddha","sarga":42,"verse":10,"english":"Sparkling in the glory of victory, the monkeys crushed the Rākşasas and some among them feeding on gore began to vomit blood.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6042010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b0888ddd5e93aa6216051cf31fbefdef8e685d2bd71bc5b3cd19bfbc8cacf1c6","compact":"1fa8a940b7ba8a5030c3ae84b0ea3ede3d550bb39e0ad7b8848ed5d987a15e19","nasal":"1fa8a940b7ba8a5030c3ae84b0ea3ede3d550bb39e0ad7b8848ed5d987a15e19"}},{"id":"VRCE-6-42-11","kanda":6,"kandaId":"yuddha","sarga":42,"verse":11,"english":"And some were severed along their flanks; and, some, slain with trees, were heaped up; and some were crushed with crags; and some were torn with teeth.","alignment":{"type":"1:1","confidence":0.89,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6042011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85232cf54dba0a4ff31d76656ef3af5df50769307dcda9e0df2255dbc8d61a1c","compact":"349bc5ef9488b7f7416ad61a42126aea6ec211c3dec1388bef41bfe9daa8120e","nasal":"7e778c86fbbbea5bf87c8851683802dc07cffeab5ec5479e608b623e53998c5a"}},{"id":"VRCE-6-42-12","kanda":6,"kandaId":"yuddha","sarga":42,"verse":12,"english":"Some being broken down by means of broken standards, and some by means of fallen swords, and some crushed down by cars, the rangers of the night suffered sorely.","alignment":{"type":"1:1","confidence":0.333,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6042012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a9307221dc0d07b3707da3451543dc0fff982cbdcbc501c28d7393194d584af","compact":"737d843cce8c8273a3b93ac98e6b33c7527f8a510d3ff180dd5525ed42a521e3","nasal":"737d843cce8c8273a3b93ac98e6b33c7527f8a510d3ff180dd5525ed42a521e3"}},{"id":"VRCE-6-42-13","kanda":6,"kandaId":"yuddha","sarga":42,"verse":13,"english":"Bounding again and again, the vehement monkeys endowed with terrific prowess, with their finger-nails tore up the Rākṣasas by the mouths.","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6042013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ca5c0a5173d4f71a3ea155f3eb7c42050a0372b0916dca66e520ffb1b9c0b677","compact":"b8b84873ee1a99b6c0a27937b136d4c60563acc1782c943a5074215a1321ce72","nasal":"c3ddb4b14a1ae166603682b8aa695f036a6c3cb1e944c6bc7dc16491bd37809b"}},{"id":"VRCE-6-42-14","kanda":6,"kandaId":"yuddha","sarga":42,"verse":14,"english":"With woebegone faces, and with hair dishevelled, (the Raksasas), stupified with the smell of blood, saught the earth.","alignment":{"type":"1:1","confidence":0.93,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6042014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e441753ffb8053408eddcde0022f45a5d79e7f93687ed19ba93333b56351314","compact":"4dee6a58c4ef0e588e165132568ab0c8935b7328e65355467765a28258386651","nasal":"d7770d00696e424d1eeb3688ad031081ad8266f1297a565bc89c0ef839991f32"}},{"id":"VRCE-6-42-15","kanda":6,"kandaId":"yuddha","sarga":42,"verse":15,"english":"Other Rākşasas endowed with dreadful vigour, waxing wondrous wroth, dealt the monkeys slaps with hands having the touch of the thunder-bolt.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6042015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"343d13a6c885867299d9f46f973081682e8526927483d9abcd63db9730d52c9d","compact":"81623ecec6e852cc1789ac3507e8b2cf82fb501139c5a53db72b3ad9a287bb4d","nasal":"2a11a6a771a4db39d2025d7b1b5059dc32e9ac0806f533abdbceb209659f384f"}},{"id":"VRCE-6-42-16","kanda":6,"kandaId":"yuddha","sarga":42,"verse":16,"english":"Gift with greater impetuosity, the monkeys felled the impetuous (Raksasas) with blows, and feet and teeth; and some were slain with trees.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6042016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"12a4bd563d7ce342e0d494b03eb2edaeda5a7db81b8901566f5d14ddb72c6ab7","compact":"fad8087029e7e74679a2b3b9ea5c22c363a7a6d251f548dc2255cde961642df7","nasal":"3180b166bb8373c66e3de3568c5d90629575f19075494b94e10d320b1c3f4489"}},{"id":"VRCE-6-42-17","kanda":6,"kandaId":"yuddha","sarga":42,"verse":17,"english":"Seeing the forces fleeing away, that foremost of Raksasas-Dhumraksa-flying into fury, began a terrific conflict with the monkeys desirous of encounter.","alignment":{"type":"1:1","confidence":0.792,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6042017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bab9425f71c93a226f071457d5b21e2