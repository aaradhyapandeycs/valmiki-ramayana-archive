[{"id":"VRCE-6-42-1","kanda":6,"kandaId":"yuddha","sarga":42,"verse":1,"english":"Seeing the Rākṣasa-Dhūmrākṣa of dreadful prowess-issue out, the monkeys, rejoicing greatly, eager for encounter, set up roars.","alignment":{"type":"1:1","confidence":0.771,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6042001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"009d8fca99f13f34a85e96c70b431c8832402dc478a880a2d61e233de37dd751","compact":"29c83f72fd8bf1392bcf1d837e2ec7f41d2889f0e8d2844d383ef912b2d969ad","nasal":"4c875e73f8e20a016a19095a89d96cc2d871b7c961cbfe6f1b8d18e4401d28e2"}},{"id":"VRCE-6-42-2","kanda":6,"kandaId":"yuddha","sarga":42,"verse":2,"english":"Then there took place a terrific conflict between the monkeys and the Rākşasas, charging each other with fearful trees, and darts, and maces.","alignment":{"type":"1:1","confidence":0.486,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6042002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ab5dac96dc01b2716d2085a17e590c16ee23bd8a758ffed284c2b7a15c607bdd","compact":"6907a8e584c1888453512ae916f7a6bbf857f4a0d66f0d217dab85a32dd8911b","nasal":"6907a8e584c1888453512ae916f7a6bbf857f4a0d66f0d217dab85a32dd8911b"}},{"id":"VRCE-6-42-3","kanda":6,"kandaId":"yuddha","sarga":42,"verse":3,"english":"The Rākşasas began to scatter the dreadful monkeys on all sides; and the monkeys (on their parts) felled the Raksasas with trees.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-52-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6042003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"64d78e32da956bf461aea22a0574be555cc813e397dc28ed42aa7363853b3d4a","compact":"764ce6bf910a1f613d066ebf39df4a82607b35b