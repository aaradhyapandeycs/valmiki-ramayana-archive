[{"id":"VRCE-6-1-1","kanda":6,"kandaId":"yuddha","sarga":1,"verse":1,"english":"Hearing the words of Hanumän rehearsed properly, Rāma, exceedingly delighted, said.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-1-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6001001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c8cd5d6a33680f3314ba668622082b1054ec70775001e3315a2393af48155bd","compact":"1a38caf0d7ebf127402bbdba04cf6048c3e6412da144a8dacece4a68b9937f6f","nasal":"1a38caf0d7ebf127402bbdba04cf6048c3e6412da144a8dacece4a68b9937f6f"}},{"id":"VRCE-6-1-2","kanda":6,"kandaId":"yuddha","sarga":1,"verse":2,"english":"By Hanumān has been performed a very great deed, rare on earth, and one incapable of being even conceived by any other in the world.","alignment":{"type":"1:1","confidence":0.66,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-1-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6001002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c4400889f3c285265f8452b0494b80d987411ce5316381f7d02e18383a5c0d3d","compact":"d772416182d4b37d0a166a80fab02267211bfd62557089ba0eba5dcc0c78f7e7","nasal":"499b3ba11d2897773fe671b51769f21740e81c1ced3fbe16106638662ea96606"}},{"id":"VRCE-6-1-3","kanda":6,"kandaId":"yuddha","sarga":1,"verse":3,"english":"Save Garuda and the Wind-god, and save also Hanumān, him find I not who cross the wide ocean.","alignment":{"type":"1:1","confidence":0.643,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-1-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6001003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"35e5d7b95d02f79bb6f3b9f0a9cef970e615d546b3d4d39143f6dde4cb5e5ffa","compact":"74d55b4175ae67e0c3dd96639b075864a3b4341b74773881b9ca40f03aef9610","nasal":"74d55b4175ae67e0c3dd96639b075864a3b4341b74773881b9ca40f03aef96