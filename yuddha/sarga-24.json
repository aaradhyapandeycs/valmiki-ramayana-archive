–94"},"sanskrit_fingerprints":{"exact":"d4c446ddc3a892ce8bb4b925af5ff6ff9740616e89be9c2c770a4387eab5ee9a","compact":"f788c6f13c89b81d9e570a6ff92d29b401cf6c3b74a84bcc1b19adf04bdef3fd","nasal":"a53b5ba449fcf82df87222861449281a5d0a8d2c409c5bce2b642b05a11e027e"}},{"id":"VRCE-6-24-31","kanda":6,"kandaId":"yuddha","sarga":24,"verse":31,"english":"And, O Janaki, embracing (your lord) you shall shed tears of joy on his mighty breast.","alignment":{"type":"1:1","confidence":0.721,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-33-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6024031","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2e04b176e6c55950202ef13eaacd4c603f81e9314e5b06ecd271246345e74162","compact":"c6ac462688c8826621e2e9b95b664d7b26c9ce220759aace593378faa71009ab","nasal":"b1273ff2d8b2a1cfe5a357cb5504c88c592274395fe5ddb972ebafc0a1ec1994"}},{"id":"VRCE-6-24-32","kanda":6,"kandaId":"yuddha","sarga":24,"verse":32,"english":"O Sitä, soon shall the highly powerful Răma loosen this braid of your reaching to your hips, which you have been wearing for many a month.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-33-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6024032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ce99e8086b33206791fc085d86b255a534843323354bd42bd92790f7f1dd41e","compact":"7730aca1f85e92f4b8c6c0228013096849de512296a7a7db47fdb438af3bb171","nasal":"7730aca1f85e92f4b8c6c0228013096849de512296a7a7db47fdb438af3bb171"}},{"id":"VRCE-6-24-33","kanda":6,"kandaId":"yuddha","sarga":24,"verse":33,"english":"O exalted one, seeing his face like the full moon risen, you shall shed water begot of ruth, even as a she-serpent casts off her slough.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-33-27"],"status":"unreviewed"},"source":{"sanskritLocat