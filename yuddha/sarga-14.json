reviewed"},"source":{"sanskritLocator":"6014021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d86f4017988ef81df51edc1c71491e090fd938719ca8b4181aed83637f1fcb01","compact":"cc954efbc028782c033f425a000c02845681bfea00796215ecc573401fc851d8","nasal":"4e746aac4ec69e2466a38dbaf7333eb5f0a9e3f34bd438343a96a1f98534b080"}}]
