nfidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-89-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6077010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ab2fa9dc3c0f7f169932f054b2f2f9cc3c9387d3b9055a9759c03d1d6f92e59a","compact":"5ddb6e63ae28b43974a9434856b3b18b4724e7a3b3a3841924416dc6c5e30c5a","nasal":"7a1070fb34ff6ac3b60622ba8ffde696302ac30f5d342bdcaed9f2c761e2379b"}},{"id":"VRCE-6-77-11","kanda":6,"kandaId":"yuddha","sarga":77,"verse":11,"english":"Having slain these many powerful Rākşasas endowed with excess of might, having crossed the sea with your arms, do you cross this foot print of a cow.","alignment":{"type":"1:1","confidence":0.583,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-89-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6077011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d0a751843d7df6999380062e1bb2242b3792ddca74665bf36fd12999c69a25a9","compact":"d0b06b943686c194249b69b907621f5624560da5792ac5b18fef32481715ccb1","nasal":"8ae270cb6c17b3da4d899a3730fc379b4c08dcb314904acf2077ba786fdbfd6c"}},{"id":"VRCE-6-77-12","kanda":6,"kandaId":"yuddha","sarga":77,"verse":12,"english":"This is the remaining force which you monkeys must conquer; all those Rākşasas, that had come forward, elated with the pride of strength, have all been slain.","alignment":{"type":"1:1","confidence":0.722,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-89-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6077012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"560abf4d2068e5c05d1cb2a2c50a198de23eb0736b45a8b51fd1055c3fb007ea","compact":"04caaec10270d8c6b2dc6ed1bf51dca216bd108aa24c94a0a41daf1cbdb5cf72","nasal":"04caaec10270d8c6b2dc6ed1bf51dca216bd108aa24c94a0a41daf1cbdb5cf72"}},{"id":"VRCE-6-77-13","kanda":6,"kandaId":"yuddha","sarga":77,"verse":13,"english":"It is not meet for me to slay the son of my brother, yet, casting off compassion will I for Rama slay him.* *The text has 'brother's son.'","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-89-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6077013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2181408ca49e19882a42cb9521dc0ab7c7d7eb7cef59a7b16b468faccb1ff3a2","compact":"34d3f4aeb639f33f3cbab0cb74e131638910f5c4b3f2831c4c327d19b3015d27","nasal":"34d3f4aeb639f33f3cbab0cb74e131638910f5c4b3f2831c4c327d19b3015d27"}},{"id":"VRCE-6-77-14","kanda":6,"kandaId":"yuddha","sarga":77,"verse":14,"english":"Tears surcharge the eyes of me who seek to slay him. Let therefore Lakşmaņa administer him his quietus.","alignment":{"type":"1:1","confidence":0.455,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-89-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6077014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7195160c0c0a1b906d7899777449e72dd1cdbcd7a2aa22b74701351f8da30dfa","compact":"6e3392e1b6c4a052f594774fd9c53140a7f456d268428694d68ec667070c0184","nasal":"cfd3b1146f6f584676280d126767cdae9d00bd705917f1a063cd37c565f83284"}},{"id":"VRCE-6-77-15","kanda":6,"kandaId":"yuddha","sarga":77,"verse":15,"english":"You monkeys, do you in a body (first) slaughter those that are beside him (Indrajit.)\" Thus exhorted by that illustrious Rākşasa, the monkey-chiefs, were exhilarated and began to flourish their tails.","alignment":{"type":"1:1","confidence":0.4,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-89-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6077015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"32b0564f4898519bf4406de138df54c25f4652ede2f3500eff617763c9f235ee","compact":"0109d22727abcb453ea1a2eb689cf9ce97f96d1277e68b2ea4b96359e9d3f2ce","nasal":"ccb125da4