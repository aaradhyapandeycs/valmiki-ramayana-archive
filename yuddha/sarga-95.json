[{"id":"VRCE-6-95-1","kanda":6,"kandaId":"yuddha","sarga":95,"verse":1,"english":"Thereupon there ensued a mighty and dreadful encounter of two cars between Rāma and Ravana, creating terror to all people.","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-107-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6095001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4ea50553c001d1537dda117a9d9808e5737bacf23efaf038854151b701fe4507","compact":"033e470c13dcca4ff8fe16eae86cfeb2fb1c2675b83b83990fafd6e91c0459b2","nasal":"033e470c13dcca4ff8fe16eae86cfeb2fb1c2675b83b83990fafd6e91c0459b2"}},{"id":"VRCE-6-95-2","kanda":6,"kandaId":"yuddha","sarga":95,"verse":2,"english":"The army of Räkşasas and the mighty host of the monkeys although they had weapons in their hands, became stupefied (for the time being).","alignment":{"type":"1:1","confidence":0.895,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-107-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6095002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9c11a88a2286c8588ded3bfc60432ce10d99ddf74633b435161050b088acffcc","compact":"6869d87f2bf181ceabe90da877d79789ea55389d7e72b2964d7c6ac93883ab70","nasal":"13b560efabd8bbb6ac8d34278bc284766f0cfc8853ba9a90c27c902fe813f387"}},{"id":"VRCE-6-95-3","kanda":6,"kandaId":"yuddha","sarga":95,"verse":3,"english":"And beholding them (Răma and Rāvana) fight, all the Rākşasas and monkeys, having their minds agitated, were greatly surprised.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-107-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6095003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ebaa8906cfe5d43f076a8c55e619778454f55aa824aa08a5b6b797ba58aa3070","compact":"50e74eab79edd550e4aa4a94f0043acf126aa80b23c0a4ff