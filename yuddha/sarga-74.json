t":"94dd5232efbc113e1e4c17d67349f61e778009aff8191eccedb8c042ae30d2fc","nasal":"94dd5232efbc113e1e4c17d67349f61e778009aff8191eccedb8c042ae30d2fc"}},{"id":"VRCE-6-74-7","kanda":6,"kandaId":"yuddha","sarga":74,"verse":7,"english":"Thereupon saying, 'So be it,' the exceedingly energetic son of Sumitrā-that delight of his friends, took up his post there stretching his variegated bow.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6074007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b827de5dbdedbe3911d86f02edab82f7abe51c9d281ff674a064d6dd3112e6fc","compact":"bdd37a9233bdbc5ad53d8296e14ba89289890207d3a6821ccd0f0d4cafd5e0e8","nasal":"3a4b6b2cbfdc38758d95b8848052794f9503a450d6e109d456f6407383dc75cb"}},{"id":"VRCE-6-74-8","kanda":6,"kandaId":"yuddha","sarga":74,"verse":8,"english":"Ravana's son Indrajit, endowed with strength, mailed, and armed with a sword, and furnished with a banner, was seen mounted on a fire-hued chariot.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6074008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e87dec04bb0c05683fc32a14e9c521e66f6bb99199341a623ef46a3d50cc566b","compact":"38bdeb886766766c5c98c84429b7956a41ef14da48e0958befe24844c37a552f","nasal":"2343373a49614b51f590f74cd3e3194b3b9809a1a972c7f7b31060e28aeb171f"}},{"id":"VRCE-6-74-9","kanda":6,"kandaId":"yuddha","sarga":74,"verse":9,"english":"The highly powerful Lakşmaņa addressed Pulastya's son never knowing defeat, saying, I challenge you to the encounter. Do you give me battle, exerting your utmost.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6074009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"069d2c96f55bd13de2662a70cb235c3ee00d7429a501078a676bd77c673fab73","compact":"1aab905b851798eca12777fffffd476404a8afddd6265e62c80ca8665d9f77dd","nasal":"1aab905b851798eca12777fffffd476404a8afddd6265e62c80ca8665d9f77dd"}},{"id":"VRCE-6-74-10","kanda":6,"kandaId":"yuddha","sarga":74,"verse":10,"english":"Thus addressed, the exceedingly energetic and intelligent son of Rāvana, seeing Vibhīşaņa there, spoke to him harshly, thus.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6074010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0aba7a4a93d2364f0847e4c230ba3f50b00d7e29ffab3e358f6dc3001b2d43d","compact":"df28a570f82a5cd10979b1130705aac29c59701609f5ab0006608eafe72bc66f","nasal":"df28a570f82a5cd10979b1130705aac29c59701609f5ab0006608eafe72bc66f"}},{"id":"VRCE-6-74-11","kanda":6,"kandaId":"yuddha","sarga":74,"verse":11,"english":"Born and bred in this Rākşasa race, you are the very brother of my father Why, O Rākşasa being my uncle, did you range yourself against your son?","alignment":{"type":"1:1","confidence":0.735,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6074011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b6f3a6c33c428a4df914795c6aad53c4c75c0687e0e4d20c7f7610dea217f1d8","compact":"e8e9c21e2506ff645288c3bb41f9ca18245d900a9e8b6d167127b4e40a587e24","nasal":"e8e9c21e2506ff645288c3bb41f9ca18245d900a9e8b6d167127b4e40a587e24"}},{"id":"VRCE-6-74-12","kanda":6,"kandaId":"yuddha","sarga":74,"verse":12,"english":"But neither kinship, nor emity, nor race, O wicked-minded one, nor co-birth, can, destroyer of righteousness, avail to make you discern your duty.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6074012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8691dae9b7f7d15e01cc75f3795504a266b132bf6b1990a7cbcc71f9f925e8ea","compact":"6446f06352abd50bae1352c27f772dd575786c0b18d168f336a95fc6aae92e0e","nasal":"6446f06352abd50bae1352c27f772dd575786c0b18d168f336a95fc6aae92e0e"}},{"id":"VRCE-6-74-13","kanda":6,"kandaId":"yuddha","sarga":74,"verse":13,"english":"O you of perverse understanding you are indeed to be pitied; as you are worthy of being reproached by the virtuous; since, renouncing your own, you have espoused servitude under another.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6074013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"61a9ef28ea27582b9cdf1b0a4ab1a5f8f6f54ceb7674008944b169f06b412f07","compact":"92456261f94022d098d4e982cfbd58cf57d42ff5815d195ac9ad9e0115a5c382","nasal":"0b644397ebc24eb930846787c61ca3cc1597d16d4296e45aaebb538b5272fe2d"}},{"id":"VRCE-6-74-14","kanda":6,"kandaId":"yuddha","sarga":74,"verse":14,"english":"Neither by your character nor yet your understanding did you perceive the mighty difference that Leith between living with one's own kindred, and taking refuge with the base.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6074014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"88e39b2c255750e9b8ba5f7574e2a020ceeac407ce76f0c4d7e277087ebc397c","compact":"24813e998fbbae369a01106794258859b9c41703285cdb792097d45fd96fbab6","nasal":"b20a720ab20e9fb1eaf60e534c5b6bc2db954e9b53a56e600783adc99d03ca16"}},{"id":"VRCE-6-74-15","kanda":6,"kandaId":"yuddha","sarga":74,"verse":15,"english":"If one that is not our own, be furnished with every grace, and if one's own be void of all merit, one's kindred, albeit unworthy, is preferable; and he that is not ours, is even always such.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6074015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4afa65e9d070b5134867d2f999d4834f2863f5693370bc3d280ddcb382df1538","compact":"2bd73466331a3b869e213d1d2ec966ddea5feee8d7c839c0cedfb64ab0d7c68b","nasal":"2bd73466331a3b869e213d1d2ec966ddea5feee8d7c839c0cedfb64ab0d7c68b"}},{"id":"VRCE-6-74-16","kanda":6,"kandaId":"yuddha","sarga":74,"verse":16,"english":"O night-ranger, such is this your relentlessness, that, O Ravana's younger brother, you being a kindred, are capable of displaying your manliness (as no other person can do so).","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6074016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"111dbf387df2954a57270c4bc02e7d8b27c00c7ffe2e42554b152f55f0411d53","compact":"58d2e7f476203e1018e5734db20ce10920eeda35df93ccf092a418897f944a83","nasal":"58d2e7f476203e1018e5734db20ce10920eeda35df93ccf092a418897f944a83"}},{"id":"VRCE-6-74-17","kanda":6,"kandaId":"yuddha","sarga":74,"verse":17,"english":"Thus addressed by his brother's son, Vibhis ana answered, “O Raksasa, why did you speak as if in ignorance of my character? O impious son of the Rākşasa chief, do you for ego the roughness which you assume on behalf of my dignity.* *Or, on account of your heroism.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6074017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ca37889c4a11a1f4fbbd8b6d211938b640fd07f1e184cb65541099ff0b24bb2","compact":"e75643552fe8baa727a7c89f97a730de05696319e4d07569346b54d9efc350dd","nasal":"2a8428e4d40e382390d0acbc09e996b58f7e5593755f366dbf50d733228cca8b"}},{"id":"VRCE-6-74-18","kanda":6,"kandaId":"yuddha","sarga":74,"verse":18,"english":"Albeit born in the race of Rākşas of cruel deeds, yet having regard to the first of principles pertaining to men, my character is not that of a Rākşasa. I do not take pleasure in the terrible; not do I revel in unrighteousness.” But how can a brother, although differing from his brother in character, be renounced by the latter?* *Some read Vişamasilena. Then the sense would be: 'How else could a brother bearing a difference in character, renounce his brother' meaning Ravana.","alignment":{"type":"grouped","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6074018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4d2eab031eefdc8e6aac0ac3b14de3a6f2db6a17c2b24dc70caa2aa9c0a81eb3","compact":"195e992f8dd89cf0de8862f4e6fa839025707b805276720e5b2da7fabf5917d5","nasal":"6d5223629e9af1987c36f6f755a005288099a252b7c40d81fae84c8fb35c778f"}},{"id":"VRCE-6-74-19","kanda":6,"kandaId":"yuddha","sarga":74,"verse":19,"english":"Albeit born in the race of Rākşas of cruel deeds, yet having regard to the first of principles pertaining to men, my character is not that of a Rākşasa. I do not take pleasure in the terrible; not do I revel in unrighteousness.” But how can a brother, although differing from his brother in character, be renounced by the latter?* *Some read Vişamasilena. Then the sense would be: 'How else could a brother bearing a difference in character, renounce his brother' meaning Ravana.","alignment":{"type":"grouped","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6074019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eb70d0fdfae171040e477677f8095c9851e96708f14b11bc8a2811876e3ad595","compact":"c7b09d0c30228a8c32548b955b165c8b14801cb9b551bd020366d69332b38f34","nasal":"c7b09d0c30228a8c32548b955b165c8b14801cb9b551bd020366d69332b38f34"}},{"id":"VRCE-6-74-20","kanda":6,"kandaId":"yuddha","sarga":74,"verse":20,"english":"Robbing others property, outraging the wives of others, and inspiring fear among friends, these three vices lead to destruction.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6074020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2ad756e9382c06aa6fad290a76fe7c907e2d76f4e1d4043fea4ae4bbfe866b5e","compact":"a1bf1e276f60b0e7028d3ce53d2a2cb2a1737969dccd8b81a26e05627ab59edb","nasal":"0b4ed298ca374eb37c2e33b258556297da02d5a6fc8382af7e603ed3a78c1809"}},{"id":"VRCE-6-74-21","kanda":6,"kandaId":"yuddha","sarga":74,"verse":21,"english":"The dreadful slaughter of sages, rebellion against all the gods, overweening conceit, anger long-continued enmity, and running amuck of counsel, these sins are sapping the life and fortune of my brother; and they have hidden his virtues even as clouds cover a mountain.","alignment":{"type":"grouped","confidence":0.717,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6074021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3a88d4765b310d28647174e92e7624da817c2955ad9e7b8d64503fb445197e36","compact":"30c7c64aa39154f7ff3fdc76be26b8015f5004e38a27e97472b4ad20281a9809","nasal":"30c7c64aa39154f7ff3fdc76be26b8015f5004e38a27e97472b4ad20281a9809"}},{"id":"VRCE-6-74-22","kanda":6,"kandaId":"yuddha","sarga":74,"verse":22,"english":"The dreadful slaughter of sages, rebellion against all the gods, overweening conceit, anger long-continued enmity, and running amuck of counsel, these sins are sapping the life and fortune of my brother; and they have hidden his virtues even as clouds cover a mountain.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6074022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6141ab9272c70bdddb73a8ba5aacd19f478b6b826aeed1d573061d9009aa00de","compact":"1ce328932ad7937c021276ef6c3dd744796eb01329861ff1e17704af15718323","nasal":"1ce328932ad7937c021276ef6c3dd744796eb01329861ff1e17704af15718323"}},{"id":"VRCE-6-74-23","kanda":6,"kandaId":"yuddha","sarga":74,"verse":23,"english":"It is on account of these vices that my brother, your sire, has been deserted by me. And this city of Lankā will not be, nor you, nor your father.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6074023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"da244c06c8a40625ac33827eed9c6193b7cf5cc82b4f92f12a3aa325612465e4","compact":"39f48b86572387a9c4b625586fd56e78b4d44b575c6829d3e37591f7488536da","nasal":"7d2acba27809d27349449a45e6e4cc82ebba59213ae0d1eed67da5b7a819bbf2"}},{"id":"VRCE-6-74-24","kanda":6,"kandaId":"yuddha","sarga":74,"verse":24,"english":"You are proud, and haughty, and a boy, O Raksasa. You are fettered by the noose of Fate. Do you say to me whatever you like.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6074024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8899a2f518987ff05f0b9fdd57adb2dfb4112310c6b5e9020d7219156097166f","compact":"ee685922ea43a3185d978afef3be17b0e154b1a5a996eee9a7fcbf3d6bba2d4d","nasal":"ee685922ea43a3185d978afef3be17b0e154b1a5a996eee9a7fcbf3d6bba2d4d"}},{"id":"VRCE-6-74-25","kanda":6,"kandaId":"yuddha","sarga":74,"verse":25,"english":"To-day you have addressed harshly me, who have fallen on evil days; but, O worst of Raks asas, you cannot pass this Nyagrodha.","alignment":{"type":"1:1","confidence":0.324,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6074025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c84941e3289f0a899883e8477b2ba443503223842fdc4ce86938f7011faeaf6c","compact":"b125810dd90dd257a217623833aab07b2803a1f7507f17f365184183e1c83266","nasal":"b125810dd90dd257a217623833aab07b2803a1f7507f17f365184183e1c83266"}},{"id":"VRCE-6-74-26","kanda":6,"kandaId":"yuddha","sarga":74,"verse":26,"english":"Having smitten the Kākutstha, you cannot live. Fight with that man-god, Laksmana, in encounter. Being slain, you shall serve the deities in the abode of Yama.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6074026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3bbc2793a52c9fe31e6b0c46a1e6b9d93e704fef17e54367be37f0f03f8b0d2b","compact":"70b525538c6ce5b0c9fdcb4ccdb42a6b3940b79a49928140d3b013e58aba8c11","nasal":"70b525538c6ce5b0c9fdcb4ccdb42a6b3940b79a49928140d3b013e58aba8c11"}},{"id":"VRCE-6-74-27","kanda":6,"kandaId":"yuddha","sarga":74,"verse":27,"english":"Displaying you own prowess, do you spend all your weapons and all your shafts. But coming within the ken of Laksmana's arrows, your will not today go hence, living with your forces.","alignment":{"type":"1:1","confidence":0.913,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-28"],"status":"unreviewed"},"source":{"sanskritLocator":"6074027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78db0413230e7d2ca75044e35cbf48036e208f16dfe4364c9eee3cf6e3045298","compact":"9d0f6c063e9723b904293f58e36ce89c8a4a3783bdca54a52256648a29389811","nasal":"9d0f6c063e9723b904293f58e36ce89c8a4a3783bdca54a52256648a29389811"}}]
