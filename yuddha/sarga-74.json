[{"id":"VRCE-6-74-1","kanda":6,"kandaId":"yuddha","sarga":74,"verse":1,"english":"Having spoken thus to Sumitra's son, Vibhișaņa experienced delight, and taking (Laksmana) bearing a bow in his hand, hurriedly went off.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6074001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e2fe8392263b29d06815580f65611086a28b0483e759edc49067b516bb09dcc9","compact":"0c9d9ea76ca2f863906238944d8fc68f4d6bf23f624561c15f6e276714c23aa2","nasal":"0c9d9ea76ca2f863906238944d8fc68f4d6bf23f624561c15f6e276714c23aa2"}},{"id":"VRCE-6-74-2","kanda":6,"kandaId":"yuddha","sarga":74,"verse":2,"english":"Proceeding some way and entering the mighty wood, Vibhīşaņa pointed out to Lakşmaņa the place (of sacrifice).","alignment":{"type":"1:1","confidence":0.439,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6074002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8c2d2a7172126c630d84fc825a1aa0ec6e79701304cc5d3f54246bc79aced1d","compact":"70e30368c96e971634bb0a2b78a586b357b2476164ad2e2931fad5e804351b50","nasal":"70e30368c96e971634bb0a2b78a586b357b2476164ad2e2931fad5e804351b50"}},{"id":"VRCE-6-74-3","kanda":6,"kandaId":"yuddha","sarga":74,"verse":3,"english":"The energetic brother of Rāvana showed to Lakşmaņa the Nyagrodha, dreadful to behold and resembling a mass of sable clouds.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-87-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6074003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a575967fc2eedb1ab50c5e74b6b06cb853ccde274cecc4f674e021de49b02f71","compact":"5a8dfe57d99c6f4235ed182a3d66f3113e9eaa3f836c35c3e30f58c2af58d773","na