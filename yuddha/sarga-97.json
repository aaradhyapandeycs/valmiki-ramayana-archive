[{"id":"VRCE-6-97-1","kanda":6,"kandaId":"yuddha","sarga":97,"verse":1,"english":"Thereupon Mätali reminding him, spoke to Rāghava, Why did you, o hero, as if not knowing, fear him?","alignment":{"type":"1:1","confidence":0.635,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-108-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6097001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78851eb75891487c8291bf8f82d8b7d6aac6190e7c36eca818fdea7f3129e826","compact":"241dc5141aaec0af781f8a4909b9efe2f7bbb49ea4329c68fdb7f37089bb42e1","nasal":"19e2fb9922d1b4564fb7e5f65e8f72e472241a221fd78376e2f4aa54eb84eabd"}},{"id":"VRCE-6-97-2","kanda":6,"kandaId":"yuddha","sarga":97,"verse":2,"english":"Do you, O lord, discharge at him the weapon obtained from the great Patriarch. The time for (his) destruction, as described by the celestials, has arrived.","alignment":{"type":"1:1","confidence":0.787,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-108-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6097002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fddfa91fdb41ca90444af73a8e267e3fb95c48422b0e22b79170a82201dfd852","compact":"ba4cbd764148ac719b294e94b1e1683ed2443360ecbd6025986b1e5187e3c6fb","nasal":"ba4cbd764148ac719b294e94b1e1683ed2443360ecbd6025986b1e5187e3c6fb"}},{"id":"VRCE-6-97-3","kanda":6,"kandaId":"yuddha","sarga":97,"verse":3,"english":"Being reminded by those words of Mätali, Rāma took up the flaming shaft breathing as if like a serpent.","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-108-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6097003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42674d42d9e60a3f442b8ce7b9255f211264ec342d30d01443b9904110728df7","compact":"fcacbfa1ce30f9afb48abce8a415cfa613445d283fc31012a6f290482984516e","nasal":"