-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6085012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77b11125817f1601e660f844b7f3d5fdeac10e0e9742943f42bd6b5357979774","compact":"0da010fe6b05fe957e9336bd78d34b5a46b5b8c81411073fd8521c4f34e5b00e","nasal":"e43049f6f8fb192ce52805fe676a17a129f0c6ac74473e2bfcef5822b4f83b53"}},{"id":"VRCE-6-85-13","kanda":6,"kandaId":"yuddha","sarga":85,"verse":13,"english":"And hurling that flaming Parigha and displaying his (light-handedness) he stuck his excellent horse there with. And having his horse slain, that hero the Rakşasa Mahodara, ascended his car, and in great anger took up his club.","alignment":{"type":"grouped","confidence":0.433,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-97-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6085013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"14141bd272d9887538642d2aaf89a1828ef42e06ac80ecb784a846af2c665fa3","compact":"8e8beb9470a28624b633b4f85d754620ff26cc6683f80b8b8516a84e6df1c55f","nasal":"8e8beb9470a28624b633b4f85d754620ff26cc6683f80b8b8516a84e6df1c55f"}},{"id":"VRCE-6-85-14","kanda":6,"kandaId":"yuddha","sarga":85,"verse":14,"english":"And hurling that flaming Parigha and displaying his (light-handedness) he stuck his excellent horse there with. And having his horse slain, that hero the Rakşasa Mahodara, ascended his car, and in great anger took up his club.","alignment":{"type":"grouped","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-97-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6085014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"28b4dbb5a697631c05d102bcb864cd1c58be30df3d1515646c8061423e3919e9","compact":"5bed146b7260647f03d2a834a1830dd70f712ec96edc8e9e0c2476585b8f491b","nasal":"5bed146b7260647f03d2a834a1830dd70f712ec96edc8e9e0c2476585b8f491b"}},{"id":"VR