","duttRefs":["DUTT-6-17-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6011012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"99259166986e518e9028d2ada29add811d5adf2508d864679c6cd1960d00c91b","compact":"fa7872a0f5f32f8fe09cbaa5edf7f08d1fa804626d855bb8ee13c6decc55f2a6","nasal":"fa7872a0f5f32f8fe09cbaa5edf7f08d1fa804626d855bb8ee13c6decc55f2a6"}},{"id":"VRCE-6-11-13","kanda":6,"kandaId":"yuddha","sarga":11,"verse":13,"english":"And Ravana, possessed by Death, paid no heed to my well-meaning words, like to one, lying on the brink of death, neglecting the administration of medicine.","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-17-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6011013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"edc0068d6d08d3e5eba3e878026dd8528fd31f81d6f3a03fe624ea3c7031fec3","compact":"a7d90aeba3e926e79ef29c26bc8ca026b70da9b47ffef249dab3cc1ff15034df","nasal":"a7d90aeba3e926e79ef29c26bc8ca026b70da9b47ffef249dab3cc1ff15034df"}},{"id":"VRCE-6-11-14","kanda":6,"kandaId":"yuddha","sarga":11,"verse":14,"english":"Being reviled by him and treated harshly like a menial, I have come to seek Rāghava's shelter, renouncing my children and wives.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-17-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6011014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2ab1056a66c7f4bee9b705e3895ee318052b8695a2534cb478606b89d77cdcfa","compact":"39650cc54caa89490528848c95769462ce25ea8c57342f192c644d39a52a4980","nasal":"39650cc54caa89490528848c95769462ce25ea8c57342f192c644d39a52a4980"}},{"id":"VRCE-6-11-15","kanda":6,"kandaId":"yuddha","sarga":11,"verse":15,"english":"Do you soon mention to the high-souled Rāghava, the refuge of all creatures, that