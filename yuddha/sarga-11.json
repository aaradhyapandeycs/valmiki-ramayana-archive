[{"id":"VRCE-6-11-1","kanda":6,"kandaId":"yuddha","sarga":11,"verse":1,"english":"Having addressed Rāvana with these harsh words, his younger brother, reached in no time, where Rāma along with Lakṣmaṇa was.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-17-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6011001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"615c64acd946d3cc6c4922f87d3ec4b39048f5d8de807b046bb325b1d47499cd","compact":"1f1549165fd9b65207a9a75645203ff242b22cd6d4c09daae84857da9cf03f4e","nasal":"1f1549165fd9b65207a9a75645203ff242b22cd6d4c09daae84857da9cf03f4e"}},{"id":"VRCE-6-11-2","kanda":6,"kandaId":"yuddha","sarga":11,"verse":2,"english":"The leading monkeys, stationed on earth, espied him on the welkin, resembling in size the summit of the mount Meru, and burning like lightning in the effulgence of his own person.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-17-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6011002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8663506128b9886b0f06bc01d100f8dc70d23574590655cef2ba5fc18c1ecf91","compact":"c205f54a7b3858a0df8a6a2a8202c9b2e702ab99e864d620662b0a3cdc039674","nasal":"c205f54a7b3858a0df8a6a2a8202c9b2e702ab99e864d620662b0a3cdc039674"}},{"id":"VRCE-6-11-3","kanda":6,"kandaId":"yuddha","sarga":11,"verse":3,"english":"Beholding him along with four counsellors, the highly intelligent Sugrīva, the lord of monkeys, engaged in meditation along with them.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-17-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6011003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f22223a26be09655d5740547b00486397c8e85f89c7490fdceebab65076ccc3","compact":"60