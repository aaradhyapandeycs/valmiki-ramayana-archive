[{"id":"VRCE-6-3-1","kanda":6,"kandaId":"yuddha","sarga":3,"verse":1,"english":"Hearing Sugrīva's speech, reasonable and fraught with high sense, Kākutstha accorded his assent to it and spoke to Hanumān, saying.","alignment":{"type":"1:1","confidence":0.886,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-3-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6003001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e5f9e2e00ed969de390a2da2490c3e7453b9b00069d5b06ae728d62621dcd771","compact":"fae24411c13f251e0b92fb20f28420e1e17b60a5f795c7c6dce64fc1a0bd63c6","nasal":"0470ec4f8e41cf83e0a546ce2632e84a687ddb946186ea0abf79be76210b2996"}},{"id":"VRCE-6-3-2","kanda":6,"kandaId":"yuddha","sarga":3,"verse":2,"english":"By asceticism, or constructing a bridge, or drying up the ocean, competent every way am I for crossing over this ocean.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-3-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6003002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aad5b6d3b1b87fe89237f15188fc08dae153f4ecbaa503b65f573e627b50e407","compact":"5be3de2e176738551161d5e571e0f6c4d5c822e7498213033a69ee4e4e153021","nasal":"3a419b2759c05aa262bd5e55c1c2b9fc39f5bf9560c0bf87888941fa850ccc7b"}},{"id":"VRCE-6-3-3","kanda":6,"kandaId":"yuddha","sarga":3,"verse":3,"english":"Of impracticable places, tell me how many there are in (Lankā), which are incapable of being come at.","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-3-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6003003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f3cc8e2b875c69a015bfad4f9b473f5ad628d54dec2c7f0a2d4a445f6caf8d96","compact":"977091e80a8f27a3f33866401c43b1dc49239df43c1e9925cbea977efef6b21e","nasal":"7bc2492246db233757