49380a1657343b06f2d8ba26099fcae1bf","nasal":"a1707b2f7bf27ca64492abd41c7a5849380a1657343b06f2d8ba26099fcae1bf"}},{"id":"VRCE-6-104-7","kanda":6,"kandaId":"yuddha","sarga":104,"verse":7,"english":"Seeing the ordinary women you are distrusting the whole sex. Do you renounce this suspicion since you have tried me.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6104007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3757eb34d65268f186e336cf5da6c4133ae846f5e450b5fad9f2dd736ade5ed4","compact":"3bf42381f6f5a9263d9b97f8d2ef0df3ba031ad5663c722ac042d113cd118aeb","nasal":"146bc1bc73854a61d550b15c6606220f46ef294700d2b052aa35ff2ea94df806"}},{"id":"VRCE-6-104-8","kanda":6,"kandaId":"yuddha","sarga":104,"verse":8,"english":"O lord, though my person was touched by another-but it was not in my power; nor was it an wilful act (of mine); accident is to blame in this.","alignment":{"type":"1:1","confidence":0.803,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6104008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f5022bddffdaa51c97751ecfe7ec550965c2b75cd8362e063cf758fd0f8dca7","compact":"681123d92ec2c376692cb09d3f1899ad4264eed5cabd3eefa94dbe69b9db5b9c","nasal":"681123d92ec2c376692cb09d3f1899ad4264eed5cabd3eefa94dbe69b9db5b9c"}},{"id":"VRCE-6-104-9","kanda":6,"kandaId":"yuddha","sarga":104,"verse":9,"english":"My heart is under my control and that is in you;-and what could I do of my body which was subject to another and of which I was not the mistress.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6104009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"575acf19703b37a6cf6c13ecf9f348273fe22a5de00c7f97f6056177c132b123","compact":"81087fead0a49d25cf853b94b4bf03f731d43d7404a8e3ebb7fe2563c7a94cf9","nasal":"81087fead0a49d25cf853b94b4bf03f731d43d7404a8e3ebb7fe2563c7a94cf9"}},{"id":"VRCE-6-104-10","kanda":6,"kandaId":"yuddha","sarga":104,"verse":10,"english":"O you the conferrer of honour-our affection towards one another was increased by our living continually for a long time; even then if you have not been able to understand me I am ruined for ever.","alignment":{"type":"1:1","confidence":0.586,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6104010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f649817428bad1938924e7f4a4897a6af548c7944a0273a2ecb3c75613376e07","compact":"e9b95325d578d40cecf1292063f0915cc226040ce5837bb8798be1f197e6a157","nasal":"e9b95325d578d40cecf1292063f0915cc226040ce5837bb8798be1f197e6a157"}},{"id":"VRCE-6-104-11","kanda":6,"kandaId":"yuddha","sarga":104,"verse":11,"english":"O king, when the great hero Hanumān was despatched by you of Lankā to see me why did you not renounce me then?","alignment":{"type":"1:1","confidence":0.483,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6104011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d00916bdf45461e23c4df98e6a08494e5a89acf05f2e6aabd2bd638a7687f0b3","compact":"cf66318a94879074c03cff4cca24b3cffeca36a7912021208f66210687c89abf","nasal":"a327cece0ffd24ba70161a6ff348580798a774448d39b2373094714ad9f525a7"}},{"id":"VRCE-6-104-12","kanda":6,"kandaId":"yuddha","sarga":104,"verse":12,"english":"Had you deputed the monkey with that message I would have renounced my life there and then, O hero.","alignment":{"type":"1:1","confidence":0.747,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6104012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af200793a9b024b42dd9e32024497d6f513cd272fe1aa69e9f4139e02e9cb5b6","compact":"9fcaf35b1cc9549016c893c508cae757c19c074bd1c37ca6bfe98f12d38760bc","nasal":"6cef3a0e420b03526e0044f9eba014bb7db4e6d8fe660e84337883fb3675dc33"}},{"id":"VRCE-6-104-13","kanda":6,"kandaId":"yuddha","sarga":104,"verse":13,"english":"You would not have been required to undergo this toil at the risk of your own life and giving unnecessary trouble to your friends.","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6104013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c2288f396431642f3c7bd71414340f218a259f102ef7c5c2de10f9659363669a","compact":"0fd4d09e11465a70d5f35bd65b87690c9f3d8ca285b56b476c43e4d0c76506d2","nasal":"0fd4d09e11465a70d5f35bd65b87690c9f3d8ca285b56b476c43e4d0c76506d2"}},{"id":"VRCE-6-104-14","kanda":6,"kandaId":"yuddha","sarga":104,"verse":14,"english":"O foremost of kings, being subject to ire-you did not perceive anything but womanhood in me, like an ordinary man.","alignment":{"type":"1:1","confidence":0.677,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6104014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a9b2eb566ebaa75a06364eaa185ae93fe7f7789d1cb8581237031e823981e16e","compact":"0e9e62f5e253ce00331b898f2fca74c51c2275c2e185bc2e734fa722a200f46b","nasal":"0e9e62f5e253ce00331b898f2fca74c51c2275c2e185bc2e734fa722a200f46b"}},{"id":"VRCE-6-104-15","kanda":6,"kandaId":"yuddha","sarga":104,"verse":15,"english":"Although I am known to have a father but in fact I am born of the earth. You did not sufficiently honour my character, O you conversant with character. are","alignment":{"type":"1:1","confidence":0.783,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6104015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4cdd99b914c395b0a8a7bfc3604669186f77807ad36bcbb4fcf30781def4b442","compact":"8cd92ddc01e49dd909c6c6e675f21e1f9704de36c2f4b5916576d8f27f81213a","nasal":"bc4086977ef089d7f3fed989a9a5dea98cc597d8cecce50397dc5eb3c5955ea8"}},{"id":"VRCE-6-104-16","kanda":6,"kandaId":"yuddha","sarga":104,"verse":16,"english":"Your marriage with me in boyhood shall be disproved and you not sufficiently considering all my devotion and good conduct to you.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6104016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b98c7e789734cded0f8bcd13049853e9be706d2b06747c1600d9310a59d917f","compact":"baebf6048b102025865d58436c892df4c0068e65a966a79f601cc90f8a4d2d42","nasal":"baebf6048b102025865d58436c892df4c0068e65a966a79f601cc90f8a4d2d42"}},{"id":"VRCE-6-104-17","kanda":6,"kandaId":"yuddha","sarga":104,"verse":17,"english":"Saying thus with accents choked in tears and weeping Sītā spoke to Lakşmaņa, poorly and engaged in meditation.","alignment":{"type":"1:1","confidence":0.469,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6104017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"00e30160b18bab4b685bbb727da8f4e8abc20a3f882fefeaf8faf1aa4660ac85","compact":"3f018a52500dc2a1902de74d98429277fe2db952352dcaf55284726d6c905d3d","nasal":"3f018a52500dc2a1902de74d98429277fe2db952352dcaf55284726d6c905d3d"}},{"id":"VRCE-6-104-18","kanda":6,"kandaId":"yuddha","sarga":104,"verse":18,"english":"Make a funeral pyre for me, O Saumitri, that is the only remedy for this disaster. Being thus branded with an unfounded stigma I do not like to keep my life.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6104018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e334bffef97ff0724be85eb203f5e7b052e661924f73856331312b677ec14b75","compact":"94655cde4b01d2cd491de4f62445d3f4444a598a563228e4aa258878e8fa1e39","nasal":"22abd24b2dfd6c0a2e96050b3f66f2a9cff2c07e64e31722f0b2c68baa97e4fe"}},{"id":"VRCE-6-104-19","kanda":6,"kandaId":"yuddha","sarga":104,"verse":19,"english":"To adopt the proper course for me who had been renounced before this assembly by my disaffected husband I shall enter this.","alignment":{"type":"1:1","confidence":0.606,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6104019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"00a9dbdb9ec92cb90f00abab9d7c835f0d50c28042eddeeb56bb0be77a2e2b5a","compact":"70e821a9562af06ab56541296eb46da7fc47612c25761078715ea4745c26c210","nasal":"0c2b0d347efe24eb0b59752162f43465ba57af2774ee974d809dcd6a2c4496a4"}},{"id":"VRCE-6-104-20","kanda":6,"kandaId":"yuddha","sarga":104,"verse":20,"english":"Being thus addressed by Vaidehī, Lakşmaņa, the slayer of enemies, being possessed by anger, looked towards Rāghava.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6104020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ba10a5ecd2d17a5a0f1ab947694c66265e16128dee4c43d35dbd0f20f6e2955e","compact":"2c3138894fbea62054a0811fbcdf8b1da259861d16b29610a608665a3a49a4ba","nasal":"5fa8ee65fd2f41c58c8faa338bdc9afa15ec0ead603ca18b71c3558e3305686c"}},{"id":"VRC