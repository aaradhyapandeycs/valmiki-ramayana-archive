[{"id":"VRCE-6-104-1","kanda":6,"kandaId":"yuddha","sarga":104,"verse":1,"english":"Being thus addressed by Rāghava, enraged, with those harsh words Sīta was greatly pained.","alignment":{"type":"1:1","confidence":0.648,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6104001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ed60e6b95f1622571f40146a2d540a00ef0f9f3f3bd83df0efd2286b320ad90e","compact":"322d630c1b0c1849d07afb5c0b432ad105ed1597663490086d1a47b9c8cd9522","nasal":"322d630c1b0c1849d07afb5c0b432ad105ed1597663490086d1a47b9c8cd9522"}},{"id":"VRCE-6-104-2","kanda":6,"kandaId":"yuddha","sarga":104,"verse":2,"english":"Hearing those words of her lord, unheard of, before the great assembly Maithili was greatly humiliated with shame.","alignment":{"type":"1:1","confidence":0.508,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6104002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"504aecbda1d19906236f1e9de42eaefd156c076d170dc56d34e4e53646abbf4a","compact":"da40872fe02385dca1f10f9d4773f021dc0a2b30dd9f80ce819d1a230453c813","nasal":"da40872fe02385dca1f10f9d4773f021dc0a2b30dd9f80ce819d1a230453c813"}},{"id":"VRCE-6-104-3","kanda":6,"kandaId":"yuddha","sarga":104,"verse":3,"english":"As if entering to her own person (with shame) and greatly pained with these arrow like words the daughter of king Janaka began to shed tears.","alignment":{"type":"1:1","confidence":0.696,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6104003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"09c47b7cfccbcd34186cf26a79d8c15f976321e1ca2a6acda5c5d446c6553497","compact":"ff50aa3fbffd7714ae7571682f2b60e14a635cdfdab51306f29e613594ff4d49","nasal":"7006615