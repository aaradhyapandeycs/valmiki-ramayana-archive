bfa4521ffb3"}},{"id":"VRCE-6-104-24","kanda":6,"kandaId":"yuddha","sarga":104,"verse":24,"english":"As my heart has never gone away from Rāghava, may you protect me, O fire, the witness of the people. As Rāghava consider me vile, who have got a pure character, may fire, the witness of the people, protect me on all sides.","alignment":{"type":"split","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-37","DUTT-6-116-38"],"status":"unreviewed"},"source":{"sanskritLocator":"6104024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db028557f892a3b0aed1fc0334f483f469228e309db8c09ebe8774d0ad9d9349","compact":"90be057e811e270ca3042b656f23e0d80679baecd83425188b6e818a1d5c9028","nasal":"90be057e811e270ca3042b656f23e0d80679baecd83425188b6e818a1d5c9028"}},{"id":"VRCE-6-104-25","kanda":6,"kandaId":"yuddha","sarga":104,"verse":25,"english":"Saying this and going round the fire, Vaidehi, with undaunted heart, entered the flaming fire.","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-39"],"status":"unreviewed"},"source":{"sanskritLocator":"6104025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c4fc4f65cecd05ae06fdaad34bb602e8b6343fbc7bd09b1b9a1767136406ec95","compact":"10f668a5fd1d2a6e06ce2075e466eda80ca0284393f1381a1b6aa6a09f547b72","nasal":"bf81a3e5843bade10d858cb22c2769f4952af1764de76a4be5db60d031d017b7"}},{"id":"VRCE-6-104-26","kanda":6,"kandaId":"yuddha","sarga":104,"verse":26,"english":"The great assembly there, young and old, overwhelmed with grief, saw Maithili enter the flaming fire.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-116-40"],"status":"unreviewed"},"source":{"sanskritLocator":"6104026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"453991a897510d0f7d9f53e4fba987dc2de86859793dd51