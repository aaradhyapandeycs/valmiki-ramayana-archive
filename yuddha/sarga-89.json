[{"id":"VRCE-6-89-1","kanda":6,"kandaId":"yuddha","sarga":89,"verse":1,"english":"Seeing the heroic Lakşmaņa brought down by the dart discharged by the powerful Rāvana and lying drenched in blood, he (Rama) after having fought furiously with the wicked-minded Ravana-and having showered vollies of shafts, addressed Susena, saying.","alignment":{"type":"1:1","confidence":0.682,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6089001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f23f0f54299fff3048a0d80d5a6b455a68c9d747f6efa3640c5888e55f2153dd","compact":"b957a347a79983f80ef739bbd71b3a1ac459dafedf9a070daf61262e278b7ed8","nasal":"d6e9ceb6dd276be0bf805026f62ffe593757f47d6ecf0169e96a154e72f5079d"}},{"id":"VRCE-6-89-2","kanda":6,"kandaId":"yuddha","sarga":89,"verse":2,"english":"This heroic Lakşmaņa brought down to the earth by the prowess of Rāvana, Leith like a serpent, enhancing my sorrow.","alignment":{"type":"1:1","confidence":0.389,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6089002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fd048a44c6743e3df8b5fbfded039d392344559f695949bea6e6c2d96f046b64","compact":"cbfe167f5e1fa1d359aac2a8929d6aa264402bb9d1db44a2db329c98172a7e74","nasal":"cbfe167f5e1fa1d359aac2a8929d6aa264402bb9d1db44a2db329c98172a7e74"}},{"id":"VRCE-6-89-3","kanda":6,"kandaId":"yuddha","sarga":89,"verse":3,"english":"Seeing this hero dearer to me that life, what power have I, with my soul overwhelmed with dole, to fight?","alignment":{"type":"1:1","confidence":0.53,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6089003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1290bbb76e35583253fd14910b56c6b04ca1c7098465fa24d0d1e9d1b0249466","compact":"63f8446c20de526e15d06f3e2a755877b4278295513d091772ba8c0edb72ef62","nasal":"63f8446c20de526e15d06f3e2a755877b4278295513d091772ba8c0edb72ef62"}},{"id":"VRCE-6-89-4","kanda":6,"kandaId":"yuddha","sarga":89,"verse":4,"english":"If this brother of mine graced with auspicious marks, delighting in battle, breathe his last, what shall life avail me or happiness?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6089004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c3ec5db3e6eb9a6e447b0fa2a2174bab1534cec5f4686504878b5a2e9f195a2","compact":"6052248675a4a931f9ac81870b2326e7a0f72c4195638d78d52b210a7684fc4b","nasal":"8ab3cd98822f5512ae767cc1104baee8510ec801119ce3b3bd057c2acca0bda6"}},{"id":"VRCE-6-89-5","kanda":6,"kandaId":"yuddha","sarga":89,"verse":5,"english":"My prowess is ashamed; my bow fall off from my hand; my arrows droop; my sight is dimmed with tears; my limbs weaken as do those of men in a dream; thought racks me; and I even desire death.","alignment":{"type":"1:1","confidence":0.636,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6089005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c6a94d025b2558a87ea7b426e4c468f000a09d9d5bd2e55e82632bb1f5e7f144","compact":"87eb70fdc478ac1076cac451850b4555f4b1cd58641078041b54b37bbf3639ad","nasal":"99b52ad5951e17ca1c60b6113b470221bcfddb24f4a5bf63dbc1d78a5f328e55"}},{"id":"VRCE-6-89-6","kanda":6,"kandaId":"yuddha","sarga":89,"verse":6,"english":"Seeming his brother wounded by the wickedminded Rāvana, crying in preternatural accents and sore stricken in his vitals, (Rāma) overcome by a mighty sorrow, lamented with his senses wildered.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6089006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc17a10b38df1e08d3d810bd1f75ec3bb6d463ea765ef6392f87b72b356f40f2","compact":"11058e6b786d34c984a771b25d4f440e71841ce55dc28f0b46c6425b5bb719f4","nasal":"bb712aa38eab1304429f12a5bd1a9679fbb8e9b4d5085a5992a87e55a623507a"}},{"id":"VRCE-6-89-7","kanda":6,"kandaId":"yuddha","sarga":89,"verse":7,"english":"Seeing my brother, Laksmana, wounded, and laying over the dust of the field, even victory, O hero, does not seem to me sweet. If the Moon is hid from the sight, whom does he then delight?","alignment":{"type":"1:1","confidence":0.462,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6089007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27e2993cacb3a57172068185c87b16ac62407c6e49d90f1ead36fbf27235a61f","compact":"c61e94be0f0c155babdf21f2baf2c1ba3eb175bcb9fc1f256d02918e4d2b82aa","nasal":"c61e94be0f0c155babdf21f2baf2c1ba3eb175bcb9fc1f256d02918e4d2b82aa"}},{"id":"VRCE-6-89-8","kanda":6,"kandaId":"yuddha","sarga":89,"verse":8,"english":"What have I to do with battle? What have I to do with life? I have no more to do anything with fighting, seeing that this Laksmana wounded, Leith in the field of battle.","alignment":{"type":"1:1","confidence":0.638,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6089008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"545638d100c297147117309b0078ea2c731867455d8da9adce288b1bfd8904f2","compact":"758d497f1d755ae9b62dbe94c4cf47889d151c1fd9e666a50d66e7d08a954866","nasal":"758d497f1d755ae9b62dbe94c4cf47889d151c1fd9e666a50d66e7d08a954866"}},{"id":"VRCE-6-89-9","kanda":6,"kandaId":"yuddha","sarga":89,"verse":9,"english":"Lakşmaņa enhancer of auspiciousness is not dead. His face is not distorted or blackened. Do you look at his countenance, which is beautifully bright and cheerful.","alignment":{"type":"approximate","confidence":0.212,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6089009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b5a31c59855ce99ed91de9325235b2a7e3d2d705794034bab1374867b9df676e","compact":"062b9e00540f68929d2ec558d350d9510387a84edb147d504a1da2ecd943b70b","nasal":"062b9e00540f68929d2ec558d350d9510387a84edb147d504a1da2ecd943b70b"}},{"id":"VRCE-6-89-10","kanda":6,"kandaId":"yuddha","sarga":89,"verse":10,"english":"Lakşmaņa enhancer of auspiciousness is not dead. His face is not distorted or blackened. Do you look at his countenance, which is beautifully bright and cheerful.","alignment":{"type":"grouped","confidence":0.353,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6089010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b15173032ee6ca2eaa0bc940db1f9cdffbe917be27756aa0ade97a8d206d1b73","compact":"2f185448cca590512a786e0120d1c3cd901f949d59a989904ef666e89577b355","nasal":"bffad0c1108cad6a8777d7021d4a40a6b6fa44fb188c145efccd12ecae91b0fa"}},{"id":"VRCE-6-89-11","kanda":6,"kandaId":"yuddha","sarga":89,"verse":11,"english":"His hands have palms resembling lotus-petals, and his eyes are pleasant. O king, one dead does not look thus.","alignment":{"type":"1:1","confidence":0.395,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6089011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"73cdc7f4406f1ecf7ee219288aef738983bd0c5aeecb47e941ae262b0566b4f7","compact":"d0d2c815a9d2cb421edf5913f05499a7ef64d1b6f4dd7abd2ed598aebaa1ea74","nasal":"e570cb1704