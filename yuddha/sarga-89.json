":"unreviewed"},"source":{"sanskritLocator":"6089024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d7a300f857ab17c631d2f6ccdbacbad1e358ccc08397b6214710bde86a774a8","compact":"fe49b323f77eab8a90a1d4fe0a2de7ff3875adb486e53c861f64d0efb88ebc46","nasal":"fe49b323f77eab8a90a1d4fe0a2de7ff3875adb486e53c861f64d0efb88ebc46"}},{"id":"VRCE-6-89-25","kanda":6,"kandaId":"yuddha","sarga":89,"verse":25,"english":"Seeing Lakşmaņa rise up from the earth, the monkeys, exceedingly rejoiced, honouring Laks mana, exclaimed, “Excellent! Excellent!\"","alignment":{"type":"1:1","confidence":0.708,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-38"],"status":"unreviewed"},"source":{"sanskritLocator":"6089025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"00c88f319412ed12df2051eb3b71aec20486e83228c552684a1cc76a66e82ead","compact":"695fa08f00a4a0616a2cb6216e652c5ed01aa31e95a49234d793dc9f65ed19cd","nasal":"695fa08f00a4a0616a2cb6216e652c5ed01aa31e95a49234d793dc9f65ed19cd"}},{"id":"VRCE-6-89-26","kanda":6,"kandaId":"yuddha","sarga":89,"verse":26,"english":"“Come!” said that slayer of hostile heroesRāma and with his eyes filled with tears, he deeply embraced Lakşmaņa.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-101-39"],"status":"unreviewed"},"source":{"sanskritLocator":"6089026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e405dc71423238884f3ca8e528847cde33b9dce3634016201af676c759526266","compact":"20cc601b0a13bfe68871563562444fee1a05e5cb80cdcb41d2687ba2705e8811","nasal":"20cc601b0a13bfe68871563562444fee1a05e5cb80cdcb41d2687ba2705e8811"}},{"id":"VRCE-6-89-27","kanda":6,"kandaId":"yuddha","sarga":89,"verse":27,"english":"Having embraced Sumitra's son, Raghava then addressed him saying, “By good fortune it is that, O hero, I see you returned from (the mansion of ) Death.","