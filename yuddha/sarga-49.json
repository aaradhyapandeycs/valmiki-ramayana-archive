efs":["DUTT-6-61-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6049006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b0e88fb46eefc77a68b6dfd7671e1d34228c13f555ecb40cda35929467273bfa","compact":"5229afbbc2041bfe6b354557c9517dcdbf8aa4d744f5b02ac4657d612717f1d2","nasal":"68662968b3eed47041d8b96210315784c9f152976963dd192f32e3afc1c2a5db"}},{"id":"VRCE-6-49-7","kanda":6,"kandaId":"yuddha","sarga":49,"verse":7,"english":"Tell me who he is, whether a Rākṣasa or an Asura. The like of him mine eyes had never before lighted on.","alignment":{"type":"1:1","confidence":0.842,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-61-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6049007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d036ec3d1125a3eac5efc33f4fa216d726bc50940fec49b25563a49224aab69a","compact":"5ec62b860f01e3fc899b73101cf4ea3c02294ef57b6818dabade17c41a064394","nasal":"5ec62b860f01e3fc899b73101cf4ea3c02294ef57b6818dabade17c41a064394"}},{"id":"VRCE-6-49-8","kanda":6,"kandaId":"yuddha","sarga":49,"verse":8,"english":"Accosted by the king's son-Rāma of untiring deeds-the exceedingly wise Vibhīşaņa said to Kakutstha.","alignment":{"type":"1:1","confidence":0.716,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-61-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6049008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c225c22eafa1dfc528aecb0cd7078cb2629fa64bd2241e01622d5c4987334bd8","compact":"a679e7ddc96397a7a81ea99dc235d662d6e9d3e1914af40940e728f5dff25964","nasal":"a679e7ddc96397a7a81ea99dc235d662d6e9d3e1914af40940e728f5dff25964"}},{"id":"VRCE-6-49-9","kanda":6,"kandaId":"yuddha","sarga":49,"verse":9,"english":"By whom in battle Vivasvata's offspring* and Vasava himself had been vanquished this is hethe wondrous powerful Kumbhakarņa, son to Visravā. No Rākṣasa is there that equals this one in size. *Yama-son of Vivasvata or the Sun.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-61-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6049009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ea50b028f54975a2eccab3dff35633ad415efc34c576afd49c8dc88018bb53a9","compact":"fbc14770aabce11010d7335231d7775d4e556354d3393c607f06abe8626611ea","nasal":"7f9d087d0b5080a7593525c1508ddbcaa0613c062a701cf083e5f0f192b53121"}},{"id":"VRCE-6-49-10","kanda":6,"kandaId":"yuddha","sarga":49,"verse":10,"english":"O Rāghava, this one in battle has brought down Dānavas and Yakşas and Serpents' and flesh-feeders and Gandharvas and Vidyādharas and Pannagas by thousands. 1. Bhujanga:-semi-divine serpents. 2. Semi-divine serpents.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-61-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6049010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"61c9c69b8b474c763207fb6cadbba3f9c99b1b2f474fa53f96a30e7994755929","compact":"c724acb3345a5c238f3d8baeae00de4c41639d7c87ce603c950c78cb4e9f5d55","nasal":"3b1e0e8094e9d81131a1d57910d2c62d8a6ade428ee2fb2df388d01c4800c06b"}},{"id":"VRCE-6-49-11","kanda":6,"kandaId":"yuddha","sarga":49,"verse":11,"english":"The immortals themselves thinking the darthanded and fierce-eyed Kumbhakarņa possessed of great strength, as the Destroyer himself, were overwhelmed with stupor and were foiled in their exertions to slay him.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-61-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6049011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"454c82d0fac6573f586a8a62405093e3c983cab926512ee51edd9932294bb049","compact":"a595b25f023091def44e548d1122728692994f95dd