[{"id":"VRCE-6-68-1","kanda":6,"kandaId":"yuddha","sarga":68,"verse":1,"english":"Having read the intention of that high-souled Raghava, he retired from the battle-field and entered into the city of Lankā.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-81-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6068001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"599b71973a5622abbe1eaca659d81827bc3ff704f2c5d5e8fae6b5a9142fd024","compact":"50325e7493fd44faa4d6d470db0dab0b27ac1ab70edd069389729403433ebe32","nasal":"50325e7493fd44faa4d6d470db0dab0b27ac1ab70edd069389729403433ebe32"}},{"id":"VRCE-6-68-2","kanda":6,"kandaId":"yuddha","sarga":68,"verse":2,"english":"And remembering the destruction of many a। quick-paced Raksasa, his eyes were rendered coppery with ire; and that hero, the son of Ravana, issued out of the city again.","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-81-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6068002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb4711619caed768680514cedd405f93e3d3b73a0916aa8c2aa8ae92fe461d6f","compact":"e178518b85bf0d29b10fd3c1b22e199bb3ccf359ea8563e9b918627a7febe57e","nasal":"e178518b85bf0d29b10fd3c1b22e199bb3ccf359ea8563e9b918627a7febe57e"}},{"id":"VRCE-6-68-3","kanda":6,"kandaId":"yuddha","sarga":68,"verse":3,"english":"That highly powerful, Indrajit, a descendant of Pulasta and an enemy of the celestials, issued out, encircled by the Rākşasas, by the western gate.","alignment":{"type":"1:1","confidence":0.765,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-81-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6068003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fe88f4659b556ecb0b8aa4e16f1cd3b9252180b79f6b2bef240df4a11176a7f8","compact":"72ae47bc4c05b547f9caf276be24397b73fe3567fe4a6cc28868018e20787635","nasal":"6b3a117ede93931a86ff7c8b6851b14ef05989c4301823ce40dae8c1ad65baf3"}},{"id":"VRCE-6-68-4","kanda":6,"kandaId":"yuddha","sarga":68,"verse":4,"english":"Then beholding the heroic brothers Rāma and Lakşmaņa prepared for fight, Indrajit spread illusions.","alignment":{"type":"1:1","confidence":0.808,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-81-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6068004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3df9e7afa245d34637a7fca1784cbf636ee7690e57ff1429662ed04447b4a55a","compact":"394968ee0c01d5d7545cb241881624b855ff9d3c09822a68491d230fae54cca6","nasal":"12144b93275b985e5158bf995c18bb1842efa177d85f78cc795faed37328a05f"}},{"id":"VRCE-6-68-5","kanda":6,"kandaId":"yuddha","sarga":68,"verse":5,"english":"Placing an illusory figure of Sītā on the car, encircled by a huge army he began to make arrangements for her destruction.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-81-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6068005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a9972f1921dd694f62a6734045cc97a7a52cfb0daf5f853bce9798e5adbc83a1","compact":"856119c19e284ba6d9ad5e9bd92158ece1141ec3134086523fb976c65ab0a3f6","nasal":"ed2f745e16381dd67b93a91b3b2bd8519a221fe31ff178dd44bc9cd4d0272538"}},{"id":"VRCE-6-68-6","kanda":6,"kandaId":"yuddha","sarga":68,"verse":6,"english":"Desiring to charm all with his illusions, that one of wicked intent, preparing himself to slay Sītā, proceeded towards the monkeys.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-81-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6068006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c956419f987c0f02dcc