":["DUTT-6-51-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6041032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80f3ff0e3ade46ae5fde668b6b80bea47f587be79de125840c1754c6372a41cf","compact":"b0ea713831442bb461ab2faff44683053a0a66d89bbb4154d311c6dfe375484b","nasal":"eaf6da717ccaadce062905b6a810e8571b2db843bc66363d7c47b007ab2ba302"}},{"id":"VRCE-6-41-33","kanda":6,"kandaId":"yuddha","sarga":41,"verse":33,"english":"That god* showered down blood; and the earth shook. And the wind blew awry with a sound resembling thunder. And every side, covered with darkness, appeared dim. *Indra-cloud compeller.","alignment":{"type":"grouped","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-51-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6041033","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"acec1553be9c1ab78b38f20bb76e01dff31e22fb25f04e3c34b5050563ab7ba0","compact":"55f48873387cba0c50f05f1452683861c381bad7ef0cb0a0e07110ffe8d92cc5","nasal":"55f48873387cba0c50f05f1452683861c381bad7ef0cb0a0e07110ffe8d92cc5"}},{"id":"VRCE-6-41-34","kanda":6,"kandaId":"yuddha","sarga":41,"verse":34,"english":"And witnessing those dreadful inauspicious omens at the outset, fraught with fear to the Räkşasas, Dhūmrākṣa was greatly aggrieved; and the Räksaşas marching before him, were stupefied.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-51-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6041034","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db8995e633e1419cc2fc2124cfe94bf9eb5aeb14edecef68d912c6e500b5b5ff","compact":"63c04ac96fa7a78bd67faec3efd0070c4c9543193d1edca46f4d9a95ef1a73a8","nasal":"63c04ac96fa7a78bd67faec3efd0070c4c9543193d1edca46f4d9a95ef1a73a8"}},{"id":"VRCE-6-41-35","kanda":6,"kandaId":"yuddha","sarga":41,"verse":35,"english":"Th