[{"id":"VRCE-6-41-1","kanda":6,"kandaId":"yuddha","sarga":41,"verse":1,"english":"Then Rāvana heard the tumult raised by the highly energetic monkeys roaring in company with the Rākşasas.","alignment":{"type":"1:1","confidence":0.692,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-51-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6041001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9c946d8eb785d4b47ccf7418740d00495c2e6238374587314f4c720383d4fac","compact":"7a26fd6cd3ad175eb9345e349e629ccb73c4cd1720b54ac1d0bb751de3fdd608","nasal":"7a26fd6cd3ad175eb9345e349e629ccb73c4cd1720b54ac1d0bb751de3fdd608"}},{"id":"VRCE-6-41-2","kanda":6,"kandaId":"yuddha","sarga":41,"verse":2,"english":"Hearing that low and solemn noise-that prodigious uproar-Rävaņa said in the midst of his counsellors.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-51-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6041002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8f25c8cecd7f838bb0f3095d6211eda0442d5ae5c589d3deb4ef581d0754d60c","compact":"41f28e1ad1cce8bca785d87cdf2711b2f0e100ad44a905a7ba5a17572f303aa9","nasal":"b8b8b83bb5f79916cf52a516f2b0d67606b120a5a4bff0cac2bef01b48847078"}},{"id":"VRCE-6-41-3","kanda":6,"kandaId":"yuddha","sarga":41,"verse":3,"english":"From mighty roars that are heard of in innumerous delighted monkeys, resembling the roar of couds, it is evident, beyond a doubt, that there is great rejoicing there. And the salt Ocean is vexed with these thundering noises.","alignment":{"type":"grouped","confidence":0.619,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-51-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6041003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0865ca3d6e685cc52a9e79fd6b044f592bc445e35d86e6f084841c8c235833f7","compact":"c