[{"id":"VRCE-6-5-1","kanda":6,"kandaId":"yuddha","sarga":5,"verse":1,"english":"There on the northern shore of the ocean the army was encamped and arranged in order by Nila.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6005001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd67ede7ae3f81cf921aedd8bd0029cdc59c30454999c848b54008f3759f9c9b","compact":"c85c12c397f9327a5f9dedb6bed2327b6fbe9abc252f0719a7ed590db309daf9","nasal":"c85c12c397f9327a5f9dedb6bed2327b6fbe9abc252f0719a7ed590db309daf9"}},{"id":"VRCE-6-5-2","kanda":6,"kandaId":"yuddha","sarga":5,"verse":2,"english":"The two leading monkeys Mainda and Dvivida patrolled about on all sides to protect the monkey host.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6005002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"64a4ad29151d17e23041cdc241ff8f13edd5c484d8e0b5aa9cd30d4c7940b2f6","compact":"24c70f78aa9aff553ede185b9f4cee57a3ac46aa84192660e8652e8e72d32396","nasal":"130b882e50f18a50ce58f130245876a1043359166bf1179a8814a186a83f384a"}},{"id":"VRCE-6-5-3","kanda":6,"kandaId":"yuddha","sarga":5,"verse":3,"english":"The army being encamped on the shore of the lord of streams and rivers, Rāma, beholding Laksmana by his side, spoke, saying.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6005003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f917f077f8e346d67418b7898eebd9a435c78bf93e4f6c677ff00a8d16f59f35","compact":"e9f5fd89a1d0f12334d04ead4d83869fa7b7daf52a4f87018a751a7fa152130b","nasal":"e9f5fd89a1d0f12334d04ead4d83869fa7b7daf52a4f87018a751a7fa152130b"}},{"id":"VRCE-6-5-4","kanda":6,"kandaId":"yuddha","sarga":5,"verse":4,"english":"I know that grief abates as time passes by, but my sorrow arising from the separation of my spouse, is increasing day by day.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6005004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9fda90a3aabd758eeb763ece3298b43c5db0ad26ad35409c010d07b8ae510d4a","compact":"9c2769c011fe7136ae695f9875f9b607c8d775f4ef89465074163ea33bf8acc1","nasal":"d817c48b409c9fd0d4cbd852434c06c7d6b097fd57d8e9b4aeb80a720c9fed81"}},{"id":"VRCE-6-5-5","kanda":6,"kandaId":"yuddha","sarga":5,"verse":5,"english":"I am not sorry that she has been stealthily taken away by the demon-but my sorrow is that her end is drawing high.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6005005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a4ac1036d45d5e999bf1bffe14053a2150bbcb6507dc983d2c61e09ae2269062","compact":"6874e2eccd6ff4e3e149842e422dc460aabef8c6cb98181c1b3c2081b3ca9a1f","nasal":"6874e2eccd6ff4e3e149842e422dc460aabef8c6cb98181c1b3c2081b3ca9a1f"}},{"id":"VRCE-6-5-6","kanda":6,"kandaId":"yuddha","sarga":5,"verse":6,"english":"O Wind, do you go there where my dear spouse is, and touching her person, do you touch me, for I shall then be happy stationing my looks in the Moon and being touched by you.","alignment":{"type":"1:1","confidence":0.861,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6005006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5407bf0011e163ffe5c2444326e5da6fe77bce8381f1b40f6e27e9087aac0828","compact":"ff06d2c63bc9d5423c4bba09f71032578c14ea2cfbddc3caef0f5e01f6d0e742","nasal":"419386f99aa2e81646add7388dec29f6010ebd0d3635e3a8d4be8e95750ed0f5"}},{"id":"VRCE-6-5-7","kanda":6,"kandaId":"yuddha","sarga":5,"verse":7,"english":"Alas! my dear one cried 'O lord, O lord' when she was taken away. Those words, revolving burn me like poison.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6005007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f9b1836a15fd6b830462abcffae319aef6ffc3ba2d16e3b2a3d1589ae26eef39","compact":"51f78512eecd621a6b5251ea57ddf95a2b4c87e12f135112a69d22f8b96f480f","nasal":"51f78512eecd621a6b5251ea57ddf95a2b4c87e12f135112a69d22f8b96f480f"}},{"id":"VRCE-6-5-8","kanda":6,"kandaId":"yuddha","sarga":5,"verse":8,"english":"I am now being burnt down day and night by the fire of desire, having separation from her for its fuel and her thoughts for its flame.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6005008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"190fc85e17e8ec1d72086ceac4069c63d9e4ee74641906d4a85bc08608069aaa","compact":"30a82ea395f0011e8ceaa22b1d5dde911170125cb5acd715a576e5ba685026c9","nasal":"8c3dec5d0c53ef6a2cc4fb6132cc8b593dbfa013e6d12bf3683e677c310fe622"}},{"id":"VRCE-6-5-9","kanda":6,"kandaId":"yuddha","sarga":5,"verse":9,"english":"Leaving you, O Son of Sumitrā, I shall jump into the deep and then shall not this fire burn me any more.","alignment":{"type":"1:1","confidence":0.632,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-5-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6005009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"543a8942e34b7d7cfa57a501d56a3d9cce03a99aabfd32d51dc3c