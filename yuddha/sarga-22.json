},"sanskrit_fingerprints":{"exact":"b9d5131967593ad6bb08d5c0948ca7e768e55fa806af12380632932da57275a0","compact":"2099be25b245a5aebc11affbfff2fa3761e64ed8586f869620713bfc2083b732","nasal":"73d60044468e4449be44c173c7af657df1a8c7c068bdca719d1843210068580e"}},{"id":"VRCE-6-22-19","kanda":6,"kandaId":"yuddha","sarga":22,"verse":19,"english":"Then my mighty forces led by Prahasta slew his host overnight, where was present Răma along with Lakşmaņa.","alignment":{"type":"1:1","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-31-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6022019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2875408f9146196d667888ab39185be4671009d23c460ce74e6d25ed8c09399d","compact":"14b5ad339a1ef34a3d43140f622aea65312e0acc7ed8b2183a5123419ab2e3e2","nasal":"14b5ad339a1ef34a3d43140f622aea65312e0acc7ed8b2183a5123419ab2e3e2"}},{"id":"VRCE-6-22-20","kanda":6,"kandaId":"yuddha","sarga":22,"verse":20,"english":"And repeatedly upraising pattiśas and bludgeons, swords, rods and other mighty weapons; and (discharging) showers of arrows, and darts, and daggers and maces and sticks and crows and bearded darts and discuses and clubs; the Rākşasas discharged these among the monkeys.","alignment":{"type":"grouped","confidence":0.595,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-31-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6022020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e77ee848ecc12683f305975da62c59ccd57400bc552f140e82f8370dc364f2b4","compact":"1f65ebbebaf59785ad3746c709db5bac2a053e671367f8265b9a9bea350ceb3b","nasal":"4c790e1596d2837c3a97d00939dd80e2e417a1317c81b03d3689d50a23ff938e"}},{"id":"VRCE-6-22-21","kanda":6,"kandaId":"yuddha","sarga":22,"verse":21,"english":"And repeatedly upraising pattiśas and bludgeons, swords, rods and other mighty weapons; and (discharging) showers of arrows, and darts, an