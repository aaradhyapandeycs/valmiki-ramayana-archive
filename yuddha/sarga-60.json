130e9dea709701ace572907afd507fb70413963","compact":"3f1fb799698e0279b2438965e8a75b75b53e71b4a4c58482a1209eb09c84a4f3","nasal":"0c84260f660bf7b3edf351425ab2ad06fce10a6d157617a39466b6cbba1a629f"}},{"id":"VRCE-6-60-43","kanda":6,"kandaId":"yuddha","sarga":60,"verse":43,"english":"O Lakşmaņa, this lord of Rākşasas, this foe of the lord of celestials, having obtained the Brāhma weapon, after having brought down the monkey-hosts, are assailing us with sharpened shafts.","alignment":{"type":"1:1","confidence":0.523,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-58"],"status":"unreviewed"},"source":{"sanskritLocator":"6060043","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2084138e1b7337ad969eb7e7c851163b77a6abe4c168babc62ccc801e6ed42a6","compact":"ba4a51ada3b5a9301c793234c232688ebabee820cb38afa55cfc3387efe3e18c","nasal":"4a0e261fd8ea24743062ea4b67b9ab05a4518d918737a4020771c18f6c2a7e17"}},{"id":"VRCE-6-60-44","kanda":6,"kandaId":"yuddha","sarga":60,"verse":44,"english":"That high-souled heedful one, having been given a boon by the self-sprung, has rendered his dreadful body invisible. How can we slay him, who is fighting with upraised weapons, but who has hid his body.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-59"],"status":"unreviewed"},"source":{"sanskritLocator":"6060044","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"050dad3b52754fe11498b599900ab2e026c4c62e080f40dd78575237323d805a","compact":"0f598dcbb9faa9343cd1a0cc0f9d4f9d428ac662e56ea33f8566d5d415082b48","nasal":"cbbd75a3cc498becb67a4f458b7acb3cde2b9ec07069f57cc5535ca707d38da7"}},{"id":"VRCE-6-60-45","kanda":6,"kandaId":"yuddha","sarga":60,"verse":45,"english":"The reverend self-sprung, I deem, is incomprehensible. And this is his weapon, embodying his energy. Therefore, O intelligent one, do you today along with me calmly bear this.","alignment":{"type":"1:1","confidence":0.495,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-60"],"status":"unreviewed"},"source":{"sanskritLocator":"6060045","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"495e65fed0f32d9617be2ee77b35466d49a93219fc7c1c10bbf2f84819957859","compact":"3ac8b17e34dc57014989e0c14fc23c519921e660ff9393096bdfe66ca09b98bf","nasal":"27a3975ecf680e902162ab65336f13d96208c88f8eef81edabb7d91b9e661369"}},{"id":"VRCE-6-60-46","kanda":6,"kandaId":"yuddha","sarga":60,"verse":46,"english":"Let this foremost of them all, this lord of Rāks asas-cover all sides with the showers of his shafts. And in consequence of this, the army of the monkey-king with its greatest heroes fallen, does not appear to advantage.","alignment":{"type":"1:1","confidence":0.62,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-61"],"status":"unreviewed"},"source":{"sanskritLocator":"6060046","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b58def8f5a41f38a9ad2c0d46e60c6746a427d92e39de35d58f48c76ef82b8a","compact":"e20da47795cd1f62aadbebc2ab3ad14335f6c8618b31f84feae34ad6addc140d","nasal":"22853601c11894f6b3468d6b8e25c54ca53dd5a6472ca3d65265a6468a7e5916"}},{"id":"VRCE-6-60-47","kanda":6,"kandaId":"yuddha","sarga":60,"verse":47,"english":"Seeing us also fallen, senseless, and desisting from fight with our joy and anger gone off from us, for certain will the enemy of the immortals, taking the Fortune of fight seek his home.","alignment":{"type":"1:1","confidence":0.389,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-62"],"status":"unreviewed"},"source":{"sanskritLocator":"6060047","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"33b700c2aac92fcb2e1ff594dbeca8dc20060d795593169ce2edb1713508dabe","compact":"0a23196efb5abcc0538d503be9d281bcffd325d530812fa15d3f5bfe6d69aac7","nasal":"0a23196efb5abcc0538d503be9d281bcffd325d530812fa15d3f5bfe6d69aac7"}},{"id":"VRCE-6-60-48","kanda":6,"kandaId":"yuddha","sarga":60,"verse":48,"english":"Assailed by Indrajit with networks of arrows, they were then sore distressed in the field. And having struck them with sadness, Indrajit from joy shouted in the encounter.","alignment":{"type":"1:1","confidence":0.606,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-63"],"status":"unreviewed"},"source":{"sanskritLocator":"6060048","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6183cf76eef4a224fb6504295d5c1bd85df8d1bb8c41b102c8d29379bfd0aaf2","compact":"a95563dba4c321d77ac8b275c9deb7c9b5665e49942dcb6607669ef16abe5971","nasal":"34af80d6b1c631a4b1bd5a7337cb81e1a3cfd5a41bb4306bf305db576a4d5d42"}},{"id":"VRCE-6-60-49","kanda":6,"kandaId":"yuddha","sarga":60,"verse":49,"english":"Having thus worsted in battle that monkey army and Rāma along with Lakşmaņa, he-speedily entered the city ruled by the hand of the Ten-necked one. And extolled by the Yatudhānas, he, filled with delight, related everything to his sire.","alignment":{"type":"1:1","confidence":0.58,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-64"],"status":"unreviewed"},"source":{"sanskritLocator":"6060049","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2c978b4cf57f7995ee027fe25c6d8ed72400a6b7ac749297467e765be0dc1118","compact":"cca275691131d30954683a926bda93d4b9aebd7564110580f94a7b4e723375b6","nasal":"cca275691131d30954683a926bda93d4b9aebd7564110580f94a7b4e723375b6"}}]
