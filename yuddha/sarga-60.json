":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6060022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0a1b7a6b7d16b8afef8a2d5dc5353eceb6de106307fd9d5949b8421f0fbe591b","compact":"b42867dfa895d529fc45f4c372c6e64fbfc7756e0efd678863b2faed1495bfc6","nasal":"b42867dfa895d529fc45f4c372c6e64fbfc7756e0efd678863b2faed1495bfc6"}},{"id":"VRCE-6-60-23","kanda":6,"kandaId":"yuddha","sarga":60,"verse":23,"english":"Spreading fire there, with tomaras representing Kāśa, he seized the neck of a living goat of black colour.","alignment":{"type":"1:1","confidence":0.639,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6060023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3d18d612c2c1cc5e3b87c84c0111b39524159ac181d91808b0a372e4d1908c03","compact":"aa972c585e2719bf84f6975fa2ed91ee343174f779f33c263811230052fed10e","nasal":"aa972c585e2719bf84f6975fa2ed91ee343174f779f33c263811230052fed10e"}},{"id":"VRCE-6-60-24","kanda":6,"kandaId":"yuddha","sarga":60,"verse":24,"english":"Then the kindled smokeless fire blazing up brilliantly, displayed signs betokening victory.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6060024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79611b38694d71ec24db7654fdb158648934f3b2710286ccfe83d063b4df980d","compact":"c2a3eb0092bf991d21edc7b4375c703d31f3995c75f39936a37628c4a640db17","nasal":"395b43e02021cb6bd497e710b0c9865958e6c0cf2682ea9fe894add5440f4f87"}},{"id":"VRCE-6-60-25","kanda":6,"kandaId":"yuddha","sarga":60,"verse":25,"english":"Thereat, with his right tongue whirling, the Deity of fire himself looking like one made of gold, arising, accepted the offering.","alignment":