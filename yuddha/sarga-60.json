3-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6060011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb4a3bc11bc6263f1cd233f9b58d1d36263166d78cb449ae8f5fc65317cc8697","compact":"83a7eaa2bd20f4e55e3ec1e98f1ac35715ba75d7edb2107b37f73beb3422e534","nasal":"173739517d81533878ae90a5c43927e6d33f711c3456582c3d2002e9473744ba"}},{"id":"VRCE-6-60-12","kanda":6,"kandaId":"yuddha","sarga":60,"verse":12,"english":"All sides were filled with the blares of conchs and the sounds of kettle-drums. And then that enemy of the lord of celestials marched forth with impetuosity.","alignment":{"type":"1:1","confidence":0.385,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6060012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3ca351c83c41b55cc110d105ecc9c3b11c053af62b455a180e441f9232fd1f00","compact":"399d519a959bdf292989542073e4734a8d4be61dacd5a0d6ac346202d67dc0a8","nasal":"2bed1d389757e3f9012d02107dfbbfe36b5ee1f003cdf5934baf2d0e83c9e2b3"}},{"id":"VRCE-6-60-13","kanda":6,"kandaId":"yuddha","sarga":60,"verse":13,"english":"And with an umbrella hued like the Moon, that destroyer of enemies appeared like the full Moon stationed in the sky.","alignment":{"type":"1:1","confidence":0.692,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6060013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"359fd63b4d640437ad937344044395c5412bc53301b9ed2c58ec2ab99fa74aa2","compact":"6bf05ef7bcc7c4a2c641449c34532fed816b64292adc67bb1a9ee981e8c4254a","nasal":"2e333b6af6f3032d534764ba065ae97f7edc693fe04ced2c1941ac7063d3feb1"}},{"id":"VRCE-6-60-14","kanda":6,"kandaId":"yuddha","sarga":60,"verse":14,"english":"That hero garnished in golden ornaments that foremost of all bowmen, was fanned by an excellent and graceful golden chowri.","alignment":{"type":"1:1","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6060014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee42701f85524fa28669f3dc5b2779241cee662889036a21e1d852168916f02d","compact":"7111c592df4b75566f29979953510fc1837f1286fc5aadc063e4360e0ccfbbae","nasal":"7111c592df4b75566f29979953510fc1837f1286fc5aadc063e4360e0ccfbbae"}},{"id":"VRCE-6-60-15","kanda":6,"kandaId":"yuddha","sarga":60,"verse":15,"english":"With Indrajit furnished with the splendour of the Sun himself, and possessed of peerless prowess, Lankā looked beauteous even as the firmament graced with the glorious Sun.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-73-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6060015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0d6266a85720616f38ccd971d390185d0e6743e3f874c13992cec78a463bdc0","compact":"ba72537900087aa2b33863f7bf6b40699618dd80bf8e45cfc0d4235322bd8509","nasal":"677949db2916ef41bf77a7e446310b8f8b26710a35e6a3210e96b8030d42ae2c"}},{"id":"VRCE-6-60-16","kanda":6,"kandaId":"yuddha","sarga":60,"verse":16,"english":"Seeing that shower of trees riven by Kumbha, the graceful lord of the monkeys endowed with exceeding strength and prowess, did not feel any mortification.","alignment":{"type":"approximate","confidence":0.132,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-76-56"],"status":"unreviewed"},"source":{"sanskritLocator":"6060016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0dba0f8bf81cc4fd4ab6a5abd79b9ca89e72868a81877dfd804ff6111ba48f1f","compact":"e7c1d619ba2fde3458d187f4ae06032808a5fb17afad2c53f424ebf489679130","nasal":"ee9a7fbcd4910bd14ae4d2494b8963bb55dda52d4bc80be14bac952ed58d34a7"}},{"id":"VRCE-6-60-17","ka