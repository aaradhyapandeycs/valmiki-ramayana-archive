94"},"sanskrit_fingerprints":{"exact":"cd903f8b5bf50c403936b4d950337e1f90ebf4e6b5f4e5fc5d17b889141282d6","compact":"ea56eadd886553ae0a40a64662d8df096a378cd2054b78aa95f40a23add0224f","nasal":"a7edb0725a5814214b71fe14aea0764e8a42f2f53e3b9e892154be692d6838d7"}},{"id":"VRCE-6-23-27","kanda":6,"kandaId":"yuddha","sarga":23,"verse":27,"english":"O Raghava, hearing you slain while asleep, and me staying in the abode of the Rākşasa, she with her heart cleft (in twain), shall cease to exist.","alignment":{"type":"1:1","confidence":0.683,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-32-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6023027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ca062fba9cbe5c3e58b49bca6895bf0735a4fa22393a03a40114a7bcd15a8009","compact":"520e18e18b7e4095aa2e2abc4b01b0a4d1bef5f219948854fc382c55b85c3940","nasal":"520e18e18b7e4095aa2e2abc4b01b0a4d1bef5f219948854fc382c55b85c3940"}},{"id":"VRCE-6-23-28","kanda":6,"kandaId":"yuddha","sarga":23,"verse":28,"english":"Do you, O Ravana, speedily slay me upon Rāma; and, bringing the wife to the husband, compass my best benefit.","alignment":{"type":"1:1","confidence":0.607,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-32-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6023028","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4774f675744f1fbf11a2b5fb6ecd92577c326dcfa2e0cd8b6d285b4262b0b051","compact":"a85253aaaba4620ee8435867ec59dbf66f4eaf95c0e3b8ce7e80974c03c10fae","nasal":"a85253aaaba4620ee8435867ec59dbf66f4eaf95c0e3b8ce7e80974c03c10fae"}},{"id":"VRCE-6-23-29","kanda":6,"kandaId":"yuddha","sarga":23,"verse":29,"english":"Do you join my head to his and my body to his body. I will, O Rāvana, follow the way of my high-souled lord.","alignment":{"type":"1:1","confidence":0.63,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-32-28"],"status":"unreviewed"},"source":{"sanskritLoc