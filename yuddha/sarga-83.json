":18,"english":"In the encounter today I shall, with the monkeys deprived of their breath and clept with my arrows, so cover the earth that it may not be seen by any.","alignment":{"type":"1:1","confidence":0.583,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6083018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0c576e1272400fd98934fbdac1bb5f312b3d34d834c4e736b1856a3eed3a5bb0","compact":"8b1e415ccb570932a4d6415295c873d85799cb57ae77f5108d2d030a51bb6481","nasal":"f45b2466b41de3b821bd057218736bd43a1d6c529155277fb3e02b0bb2e39798"}},{"id":"VRCE-6-83-19","kanda":6,"kandaId":"yuddha","sarga":83,"verse":19,"english":"I shall satisfy today with the flesh of the enemies slain by my shafts, the crows, vultures and others who live upon flesh.","alignment":{"type":"1:1","confidence":0.662,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6083019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83509b945753ec85c0b09b4103e204aadf591438f694ca1f84be633490853857","compact":"58d8a4b19ddd415cc282b715690db9c17eb3f95524e9ae32bce2906220caee01","nasal":"58d8a4b19ddd415cc282b715690db9c17eb3f95524e9ae32bce2906220caee01"}},{"id":"VRCE-6-83-20","kanda":6,"kandaId":"yuddha","sarga":83,"verse":20,"english":"Get ready soon my car and bring my bow. And let the remaining night-rangers follow me in battle.","alignment":{"type":"1:1","confidence":0.783,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6083020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1366a848f0abbb939015ec77d00ac09f87c80d44201e06cc1e277b66ecc7b738","compact":"ee50a382b9dca66e0ba405b241d9f8c1421c888972d9c711e4ef9c13de6a9388","nasal":"17cf392f172d0cd627fa2cb6939db0aeb0ff47d27e1d2b600f