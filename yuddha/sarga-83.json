[{"id":"VRCE-6-83-1","kanda":6,"kandaId":"yuddha","sarga":83,"verse":1,"english":"Thereupon Rāvana heard in every house of Lankā the piteous cries of the she-demons possessed by sorrow.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6083001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7e73662c4892281421e7f1235fcae8fff376e83b3c4cce7fc7db5fad1648a25","compact":"9b25859dec408bd0c41e0260d5e609bdc681e6f75ead65a205acd1ee050e842c","nasal":"28755a3b361be68d17602b13a7adbb95af26f5675b104244acaeac271b5ea142"}},{"id":"VRCE-6-83-2","kanda":6,"kandaId":"yuddha","sarga":83,"verse":2,"english":"And sighing hard he engaged in mediations for some time. And terrible-looking as he was greatly worked up with ire.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6083002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6bf1684a0b5fcce803d70643004cf9fc0ed8b3eb3b86d62af8673d0c95745f32","compact":"57ffd90ff6bc17d0fbbb79cb9566ca467488a54e48daf92b37b92fc4cf790a3d","nasal":"57ffd90ff6bc17d0fbbb79cb9566ca467488a54e48daf92b37b92fc4cf790a3d"}},{"id":"VRCE-6-83-3","kanda":6,"kandaId":"yuddha","sarga":83,"verse":3,"english":"Having his eyes reddened with anger and gnashing his teeth and biting the lips, that one, irrepressible by other Raksasas, looked like the fire of dissolution incarnate.","alignment":{"type":"1:1","confidence":0.937,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6083003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"242183e96fb5b89b0e3e9a099943f6646596d2c237fb6abf76af12dc964d9ef5","compact":"778d57b36bcd0ff681c8cdf209fd4afceb1c57bd6bdce83a