2","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"734487935af45e9762e978b4e900337034173cc2344de35d1de9266eedf89ef2","compact":"dcb577e7f7ed24273eaac08b285904b944885127a075cfd2b455db4c9ad8d898","nasal":"f61e6d2aecd2d54da136555b0b7b98457bd94f3390bfc69ed038d43d4dfd213e"}},{"id":"VRCE-6-83-13","kanda":6,"kandaId":"yuddha","sarga":83,"verse":13,"english":"I shall slay today all the heroic monkeys with my winged arrows. Ascending my car gifted with the velocity of the wind shall I churn today the monkey host with arrow-like waves coming from the oceanlike bow.","alignment":{"type":"split","confidence":0.429,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-13","DUTT-6-95-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6083013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3dc321e016cb163d296e29d78e1404215b330c3e1e2901b8b8c9615245f67354","compact":"813fd0b55fdd0382389e8173d024e9d8c88ce85e3a34e6c49929688b672924e0","nasal":"813fd0b55fdd0382389e8173d024e9d8c88ce85e3a34e6c49929688b672924e0"}},{"id":"VRCE-6-83-14","kanda":6,"kandaId":"yuddha","sarga":83,"verse":14,"english":"I shall like an elephant distress today the monkey-like pools having their countenances for the blown lotuses, and the lustre of their bodies for the filaments.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-95-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6083014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"febf33af46883db9a4323f784d587be7f2453dea8260d5f3ecd7be6bfe04fdba","compact":"538ca261a0511b74b4901b80c9c1167b68cba4bb51a83fa75ce33579a98febe8","nasal":"538ca261a0511b74b4901b80c9c1167b68cba4bb51a83fa75ce33579a98febe8"}},{"id":"VRCE-6-83-15","kanda":6,"kandaId":"yuddha","sarga":83,"verse":15,"english":"To-day in the encounter, the leaders of the monkey hosts, with the