[{"id":"VRCE-6-8-1","kanda":6,"kandaId":"yuddha","sarga":8,"verse":1,"english":"Then that heroic general, the Rākşasa named Prahasta, possessing the splendour of sable clouds, submitted with joined hands.","alignment":{"type":"1:1","confidence":0.853,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6008001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e475d409b3b51214295db329acff1e49cf6d1c44acf5e74f5d6887e235e7aa9b","compact":"f34aff6b6fb040dd2c2378b7b4454d7b64cdc714405b75c524436af8dfb43252","nasal":"d105b8fd7b12ac6551ea0d2aa7040cbd24f25ac954984bbc412ca0d70c78245c"}},{"id":"VRCE-6-8-2","kanda":6,"kandaId":"yuddha","sarga":8,"verse":2,"english":"I am competent to baffle in battle gods and Dänavas and Gandharvas, ghosts, birds and serpents, what then is a couple of human beings?","alignment":{"type":"1:1","confidence":0.508,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6008002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8825c8926291eb044993bc7199e541f28082a8dc0c2c667b9c0fa81f6e6c566a","compact":"26914d98b53b18bc67df13840fbceedcb45bcd37008f18fce904700a7b20700a","nasal":"bd85a3e2f96a08bfd4fcd664e0c06066322cde326c6e0990cb7be3557b251a55"}},{"id":"VRCE-6-8-3","kanda":6,"kandaId":"yuddha","sarga":8,"verse":3,"english":"Having been negligent and confident (in our power), we have all been deceived by Hanumān. But, I living, that ranger of woods shall not (again) go hence with his life.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6008003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bdce6eaa97c47727e895e48b9546fd3cfbcb09e77c295c7a5ee2d8fa4c93843e","compact":"a967a3ab7dd4d87aa9fa7c630516fafbe4b6bbbd27665a7c56fe9ce3e20064b4","nasal":"43b2408ad1f95e8939e62df700948aa66d12ab15f758e650a063978850cd5d2b"}},{"id":"VRCE-6-8-4","kanda":6,"kandaId":"yuddha","sarga":8,"verse":4,"english":"All the earth down to the ocean, containing hills, forests and woods, shall be rendered free from monkeys. Do you command me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6008004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f5c9d073eca1236a7cc915696af8d591c12978bfec2b628d26dcc58dc3b6ca0","compact":"1ed63e5fdb17868e9a00f6d4af5ed1d8acb52faa253031497d85de36dd3c3c7f","nasal":"20d92dd14b769c840d87c7448521bc7d796977b46615f51fe7367ab97c2cf629"}},{"id":"VRCE-6-8-5","kanda":6,"kandaId":"yuddha","sarga":8,"verse":5,"english":"O ranger of the night, I shall deliver (the Rāks asas) from the monkeys; and you shall not have to suffer in the least in consequence of your transgression.* *i.e. the ravishment of Sitā","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6008005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3e72be6359f3472abaebe4cdccedc1a28314bd6c73ae0ce058a885026ccb78d2","compact":"6bbc0c744af035b9cb8025d227cd3dff13e0a657c70bc6019460e8e0bc38a697","nasal":"6bbc0c744af035b9cb8025d227cd3dff13e0a657c70bc6019460e8e0bc38a697"}},{"id":"VRCE-6-8-6","kanda":6,"kandaId":"yuddha","sarga":8,"verse":6,"english":"Then the Rāksasa named Durmukha, growing enraged, said, This overpowering of all of us must not be forgiven-this flagrant discomfiture of the metropolis of the auspicious lord of the Rākşasas as well as of his inner apartment by the foremost of monkeys.","alignment":{"type":"grouped","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6008006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d62f414573987fa74b283716b620aff34c7cb2a18f2101ebf38fa6925e15a3b4","compact":"45c1f113177bb055d806ad09dd002695fb8b9765900200f5516cb26a0b82056c","nasal":"45c1f113177bb055d806ad09dd002695fb8b9765900200f5516cb26a0b82056c"}},{"id":"VRCE-6-8-7","kanda":6,"kandaId":"yuddha","sarga":8,"verse":7,"english":"Then the Rāksasa named Durmukha, growing enraged, said, This overpowering of all of us must not be forgiven-this flagrant discomfiture of the metropolis of the auspicious lord of the Rākşasas as well as of his inner apartment by the foremost of monkeys.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6008007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7793cfaebbbf35593af8987551d3104f054314e63fffe91f50e52aae107b69ce","compact":"871785d770075ddb885afb14373255ca6a7fcd206173a6f3de742d89a8a391e6","nasal":"c716b211cd4cacf1b693cba0dc05bbc044353ec203a12c1a4750b5182ec56c55"}},{"id":"VRCE-6-8-8","kanda":6,"kandaId":"yuddha","sarga":8,"verse":8,"english":"This moment marching alone (from hence) will I exterminate the monkeys, even if they shall have entered the dreadful deep, or the sky, or the subterranean regions.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6008008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"13c1553e84190a17cd70ca226ca197dc441d14ff094fb9f21e9f4c2f10e5b150","compact":"45a90aa713041b0e831878837c4e75352d821d93a329a44f317baff43772e7f3","nasal":"2082de0326e55845e5dd79b6f87af0a549ca852c6e1f48862519632e86c029b4"}},{"id":"VRCE-6-8-9","kanda":6,"kandaId":"yuddha","sarga":8,"verse":9,"english":"Then the exceedingly powerful Vajradańșțra, wielding up a terrific bludgeon, stained with flesh and gore, wrathfully observed.","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6008009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ef7846416bfe8a9c6d067585b8108a4ec2dcc9df283f9b1ecc04d1536921b63","compact":"941af3ed689929f2a6e714c70b934a36c9aa521d50a4632871d5b0bb54bc9cc3","nasal":"941af3ed689929f2a6e714c70b934a36c9aa521d50a4632871d5b0bb54bc9cc3"}},{"id":"VRCE-6-8-10","kanda":6,"kandaId":"yuddha","sarga":8,"verse":10,"english":"Rāma the irrepressible existing, and also Sugrīva with Lakşmaņa, what have we to do with the weak and wretched Hanumăn?","alignment":{"type":"1:1","confidence":0.597,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6008010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7808297b6024b7921ca54b04cbf9b15e0c9da3bb8009328b34e586d371ac80d8","compact":"7a5a78a193513b0de4d82b8a3fbbe747a662f75455740c7cb7b0bc79629da85f","nasal":"7a5a78a193513b0de4d82b8a3fbbe747a662f75455740c7cb7b0bc79629da85f"}},{"id":"VRCE-6-8-11","kanda":6,"kandaId":"yuddha","sarga":8,"verse":11,"english":"This very day, staying single-handed Rāma with Sugrīva and with Lakşmaņa, with this bludgeon shall I return, after having sorely troubled the monkey-host.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6008011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"24d9fb0f3606cc008db05cc301670e8fe8c9b644d121e651f945627f29e26487","compact":"8c2d63fa1c97e83632e9fcd88c152ba60082cf94a814520f5df79ffd2a95fc8f","nasal":"8c2d63fa1c97e83632e9fcd88c152ba60082cf94a814520f5df79ffd2a95fc8f"}},{"id":"VRCE-6-8-12","kanda":6,"kandaId":"yuddha","sarga":8,"verse":12,"english":"Then that hero, Kumbhakarma's son, named Nikumbha, endowed with exceeding prowess, in high wrath remarked to Rāvana, destroyer of worlds.","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6008012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cae928b876984ad09818cacdaa52b384c98972190723478584e1424ffe02b5c3","compact":"ff6c5600a23d8edc279995471e01e97edd55504880a466420d648bb177d87a33","nasal":"f56d23569e422cf4bbed4195473cbbb32938386e535e96ebc4bbdf6b0eee75d0"}},{"id":"VRCE-6-8-13","kanda":6,"kandaId":"yuddha","sarga":8,"verse":13,"english":"Do you, all of you, stay here along with the great king. I alone shall slay Rāghava together with Laksmana, and Sugrīva with Hanumān, and all the monkeys.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6008013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"16e06edef912a5f3b52a692043e69a868c6387ee9fc6ba8f3b25bf5da20b0c93","compact":"acd1bc18c0040dcceb9304c0a1066b23877a4431f6e9e1f9173e63de83a7a6af","nasal":"cd3d738347bd21690bcf07f860e1120005d018d506346ba69d989419f292c189"}},{"id":"VRCE-6-8-14","kanda":6,"kandaId":"yuddha","sarga":8,"verse":14,"english":"Then a Raksasa, named Vajrahanu, resembling a hill, in wrath lapping the corners of his mouth with his tongue, said.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-8-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6008014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b9272c8f6613d3e2b255b90ba7b40cca85343c9af57f5e4a7370f454f250cff","com