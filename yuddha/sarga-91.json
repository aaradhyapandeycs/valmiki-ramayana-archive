[{"id":"VRCE-6-91-1","kanda":6,"kandaId":"yuddha","sarga":91,"verse":1,"english":"Seeing the face of the enraged Rāma endued with under standing all the creatures were overwhelmed with fear and the Earth herself shook.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-102-33"],"status":"unreviewed"},"source":{"sanskritLocator":"6091001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"010810de145c0e61cc206ff4148f00fa3424c7f7e75cc3211402bfe2a0cf16c2","compact":"fb3a1e127b1fa3f1100b6b3e9e8d00e3282375f9116c7280665e64a9ea177682","nasal":"5df2a2a82b7f9f62a205947dd8ff9316bafee26988f6b58f616c85e61da4e8a3"}},{"id":"VRCE-6-91-2","kanda":6,"kandaId":"yuddha","sarga":91,"verse":2,"english":"And mountains abounding with lions and tigers began to tremble, and trees to shiver. And even the deep-lord of streams-was wrought up wondrously.","alignment":{"type":"1:1","confidence":0.617,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-102-34"],"status":"unreviewed"},"source":{"sanskritLocator":"6091002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc58bdc0ba20ee6ae1060b60ef148dc57ab71843dfcf8eff8fd1c64193bbdbc0","compact":"01f9fb9f2d50647b847a5c85f7405f5041b56df4cb09f8dfa3e7cc00222dffd2","nasal":"01f9fb9f2d50647b847a5c85f7405f5041b56df4cb09f8dfa3e7cc00222dffd2"}},{"id":"VRCE-6-91-3","kanda":6,"kandaId":"yuddha","sarga":91,"verse":3,"english":"And rough and terrific clouds in the sky sent forth fierce roars. And stormy clouds rumbling went about the heavens.","alignment":{"type":"1:1","confidence":0.65,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-102-35"],"status":"unreviewed"},"source":{"sanskritLocator":"6091003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"97311a03b8780cdc04bbee2126e8c8b7dddae292f5689d4bb5e829b1c348d2b0","compact":"cd39352490dab810b4b85f27125baf068