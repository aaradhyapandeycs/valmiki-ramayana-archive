viewed"},"source":{"sanskritLocator":"6052031","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d0326c7f5a1916884116db076d5ad5167fd578d347b23bdf8d7ddfe5b8fb7908","compact":"de5c70f14e36871d9172d33b7df4e2b397fc41581c9c23bae9e5be3f279f38fd","nasal":"db270bc0f5c64cf17f9ae2d0818ab61505e300d05c82879a8c337452a866a264"}},{"id":"VRCE-6-52-32","kanda":6,"kandaId":"yuddha","sarga":52,"verse":32,"english":"Losing her charming husband, she from despair and female railty, shall come under your away.","alignment":{"type":"1:1","confidence":0.817,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-64-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6052032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5723627d3e82bbece98166298e41e9bdba79722eb722ff09709fa7297bdea3cf","compact":"bb2d9d86298b1edc6064d654a5170fe9519d3736c958e141a2fbc13316bd62b0","nasal":"56bfce54d577b9252d6f6e16c7fa58efaae1a5aeb6098e2483915eb95b9fb851"}},{"id":"VRCE-6-52-33","kanda":6,"kandaId":"yuddha","sarga":52,"verse":33,"english":"Having formerly been brought up in happiness, she, although worthy of felicity, (ultimately) had come by misfortune. And now finding happiness to be in your custody, she shall unreservedly come over to you.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-64-28"],"status":"unreviewed"},"source":{"sanskritLocator":"6052033","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8437a3b20887a2b5c559976e108827a8d71cb255e8c7f0d5116d97c5ec25b2b","compact":"b4b18e6ff007db6f6659fcae2c0a56bd4450a5cf51861948306a590a1034bda6","nasal":"b4b18e6ff007db6f6659fcae2c0a56bd4450a5cf51861948306a590a1034bda6"}},{"id":"VRCE-6-52-34","kanda":6,"kandaId":"yuddha","sarga":52,"verse":34,"english":"In my opinion this is the proper course to follow. As soon as you see Rāma, evil shall befall you. Remain here. Do not wish (to go to the field). By refraining from fight, you shall acquire great good.","alignment":{"type":"1:1","confidence":0.893,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-64-29"],"status":"unreviewed"},"source":{"sanskritLocator":"6052034","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7274638e1945cfe4b7b1cf1faba2e1137d5499b8a73aff642c217b64d8f8ce59","compact":"ca3d9e4cdbaa898aa4aa4a9b96a2cccba1a79358c3bc4848c50f161dd4b5bdef","nasal":"ca3d9e4cdbaa898aa4aa4a9b96a2cccba1a79358c3bc4848c50f161dd4b5bdef"}},{"id":"VRCE-6-52-35","kanda":6,"kandaId":"yuddha","sarga":52,"verse":35,"english":"O lord of people, by conquering the foe without battle, you without losing your forces and putting yourself to peril, you, O lord of earth, shall attain fame and high religious merit, and prosperity and renown for ever and for ever.","alignment":{"type":"1:1","confidence":0.539,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-64-30"],"status":"unreviewed"},"source":{"sanskritLocator":"6052035","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f45587575b022547bc3bcaba903c06fceadd6b9536b2707adbc4841ed93850f1","compact":"dee15249bc1587f83706fbee266500008268b01b409dff644dce415da0e4e56c","nasal":"d6e4999c3c85f90be940543ad9a50c05260f77e4bc399f12b68f496fc1099a53"}}]
