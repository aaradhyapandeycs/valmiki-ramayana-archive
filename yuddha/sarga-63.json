":"shared-sanskrit-ngram","duttRefs":["DUTT-6-76-45"],"status":"unreviewed"},"source":{"sanskritLocator":"6063021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a2f87ed8955a544844669968cf80817bd5fb01ff3d87435c50c50d31b1d7b78","compact":"dfe7532432f78beb7ea51f978d05d495a5a9d9035589095ccd3d7273fa3debeb","nasal":"18170f402941c8f4e0a6ef38ccb8176406da8344979b28013bd6aa0bc1067819"}},{"id":"VRCE-6-63-22","kanda":6,"kandaId":"yuddha","sarga":63,"verse":22,"english":"Seeing the invincible Angada down like ebbing sea, the foremost monkeys informed Raghava of it.","alignment":{"type":"1:1","confidence":0.705,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-76-46"],"status":"unreviewed"},"source":{"sanskritLocator":"6063022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8613a902220e6342413d734085c77a4c519f72dc7ffd516d902579210b4cd9c5","compact":"f47b18bacc1d5432b2885a1ce41097dde50f3c0a16903a0169c29f9c0e98ea7c","nasal":"805c7abf05fdcc8b8c4f79104127b07e63ad9f264e7e136f874cd44ff0caf08b"}},{"id":"VRCE-6-63-23","kanda":6,"kandaId":"yuddha","sarga":63,"verse":23,"english":"Rama, hearing that Vali's son had come to grief in terrific fight, directed the principal monkeys, headed by Jambavan.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-76-47"],"status":"unreviewed"},"source":{"sanskritLocator":"6063023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"20662b417b9a8770ca3c009f06c6bef3adc326dd14bd0c569683ab5a8422645f","compact":"af188d875c037d32f8deb6a22d9d998b316b2e57365a03fb863d213ef42016b5","nasal":"5d2ef61ac9910f38817ef8d33ed7057ac2eb73f6cba96917fe202fcfcf48c257"}},{"id":"VRCE-6-63-24","kanda":6,"kandaId":"yuddha","sarga":63,"verse":24,"english":"And hearing Rama's command, the monkeys, fired with wrath, charged Kumbha, staying with his bow upraised.","alignment":{"type":