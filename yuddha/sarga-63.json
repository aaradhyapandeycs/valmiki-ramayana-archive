hared-sanskrit-ngram","duttRefs":["DUTT-6-76-55"],"status":"unreviewed"},"source":{"sanskritLocator":"6063032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"621f373c1f6c4f9630556f159bd6b68373f0657f78ead941bd28cf4b4b3aebf8","compact":"d96e97eafd470f3638f6bbf0855f4128df87dd3e692426b9967a97a960065f22","nasal":"78280553234997bda5ac4b1f13f95beb7b8f40d066b2c48ac02093414fbef08e"}},{"id":"VRCE-6-63-33","kanda":6,"kandaId":"yuddha","sarga":63,"verse":33,"english":"By means of his sharp arrows the graceful son of Kumbhakarņa cut off that down-pour of trees covering the welkin; and incapable of being resisted. And being beffled those trees looked like sataghnis.","alignment":{"type":"grouped","confidence":0.277,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-76-55"],"status":"unreviewed"},"source":{"sanskritLocator":"6063033","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b6a9a285227735b696c9e8723e5b55f88755f0d6cceac3f1078a106f48c6a2d","compact":"b1c95efaea9314bfe1775f4dcb6fade5553cf6f53861f1c1555f448dca53825d","nasal":"2d2e0b7a08a23ce99fc9928940070e7fabb2e11ac672050dc82da553ecc8a43b"}},{"id":"VRCE-6-63-34","kanda":6,"kandaId":"yuddha","sarga":63,"verse":34,"english":"Seeing that shower of trees riven by Kumbha, the graceful lord of the monkeys endowed with exceeding strength and prowess, did not feel any mortification.","alignment":{"type":"grouped","confidence":0.827,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-76-56"],"status":"unreviewed"},"source":{"sanskritLocator":"6063034","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e18326dfcc2593cceb71018a4eaa2d0bf302ba57c69858d7b367edbdc382ebee","compact":"e58711543b1bf172fc9bd8b2ed5282a6888e1f230459b9a6a2d3683fd0454b95","nasal":"ab5c370e3f91aad1c985e92d7074c504247fa33ed82b4362382b3e7f18ad37e4"}},{"id":"VRCE-6-63-35","kanda":6,"kandaId":"yuddha","sarga":63,"ve