[{"id":"VRCE-6-35-1","kanda":6,"kandaId":"yuddha","sarga":35,"verse":1,"english":"Then, anxious to ascertain his* course, the king's son possessed of prowess, and endowed with exceeding strength, Rāma, ordered ten of the monkey-leaders. * Indrajit's.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-45-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6035001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0300fdabdda5e586d9d1c2b8858a2e76acb17bf12b3af469bb7ecf17cdadc054","compact":"5216a717f5384af881972d2b8543b2b14e357de8a77b7273386fc07723bbda8a","nasal":"74751208396773b9ee0a6fc16bd7e161623f450c0248ba88510fc16587d5cc03"}},{"id":"VRCE-6-35-2","kanda":6,"kandaId":"yuddha","sarga":35,"verse":2,"english":"The repressor of foes ordered Väli's sonAngada, the vigorous Śarabha, Dvivida, Hanumān, the mighty Sānuprastha, Rşabha and Rşabhaskandha.","alignment":{"type":"grouped","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-45-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6035002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c103da35a95792fc00cf0a6f0ccffba4d32168e296b2fb0a894a448d838aa476","compact":"22ec04dc6111f24a896f386286c80a01c1195d245c62d42f3c5bafea147f52d5","nasal":"ebbc1a6c88ea7b73fc236c5a4234967390b33fb119366d053192a53aa50670a8"}},{"id":"VRCE-6-35-3","kanda":6,"kandaId":"yuddha","sarga":35,"verse":3,"english":"The repressor of foes ordered Väli's sonAngada, the vigorous Śarabha, Dvivida, Hanumān, the mighty Sānuprastha, Rşabha and Rşabhaskandha.","alignment":{"type":"grouped","confidence":0.636,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-45-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6035003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29eab785337a3b371f1b55f72ecbf2740cb4c0c2cda2ff750f3d00397e86bbf4"