[{"id":"VRCE-6-2-1","kanda":6,"kandaId":"yuddha","sarga":2,"verse":1,"english":"Then the graceful Sugrīva spoke words capable of soothing sorrow, to Dasaratha's son, Rāma, who was wrought up with grief.","alignment":{"type":"1:1","confidence":0.807,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-2-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6002001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6519a6bddd23f831a53fc7a011f3c8f08fe98fe86ca7cb8318250cd557f62d9d","compact":"8157d1926315ce8a26d8f53d1b94758c1bee7c2ddbfc2169d052ff603af34ec5","nasal":"8157d1926315ce8a26d8f53d1b94758c1bee7c2ddbfc2169d052ff603af34ec5"}},{"id":"VRCE-6-2-2","kanda":6,"kandaId":"yuddha","sarga":2,"verse":2,"english":"Why, O hero, does you grieve, like one that is base? Let not this be so. Chase away you grief, even as an ingrate resign amity.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-2-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6002002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"912dbccb050fe751b2240b1bb5a1bf5c655f5baccf6cfb73004870a632ef9251","compact":"29febbde509a5e4d59b9bffbf95f8a8e1fd5e9b2db4993fdeecb525570173597","nasal":"29febbde509a5e4d59b9bffbf95f8a8e1fd5e9b2db4993fdeecb525570173597"}},{"id":"VRCE-6-2-3","kanda":6,"kandaId":"yuddha","sarga":2,"verse":3,"english":"Nor, O Rāghava, when the whereabouts of Sītă has been discovered, and when too the abode itself of the foe has been known, do I perceive the reason of your sorrow.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-2-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6002003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"56107435d561ea14daff30c30022f1b321475fe0c215f4b7ae45e37626f067e5","compact":"2b9d51b9f961c3f52d50887febe71d4615