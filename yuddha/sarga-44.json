[{"id":"VRCE-6-44-1","kanda":6,"kandaId":"yuddha","sarga":44,"verse":1,"english":"And witnessing that mighty exploit of the foremost of the monkeys, Akampana waxed furious with wrath.","alignment":{"type":"1:1","confidence":0.95,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6044001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"88f06ff93ab8e0a082a42bc7912c506ce1fc1a2fb062091b21b720997baab8f9","compact":"9ab72a871aeb4e930ea2c697a2a438b7ec67df88f6ae8ecac75865ee07a4f7c1","nasal":"28f810a899f9196a866596293731f2311fa8d78a88a5cb7477935563f9bc812f"}},{"id":"VRCE-6-44-2","kanda":6,"kandaId":"yuddha","sarga":44,"verse":2,"english":"And transported with passion, he, twanging his mighty bow seeing that feat of his foe, addressed his charioteer saying.","alignment":{"type":"1:1","confidence":0.722,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6044002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ec967f9e661b7d5c47d870ee613bbe3bbbc64a28f2df0970c66394af05152707","compact":"f78d6382b3b3483ad371e8e3b91d7c1cb97ac593a86d468fad51a4bfb3eff8a6","nasal":"f78d6382b3b3483ad371e8e3b91d7c1cb97ac593a86d468fad51a4bfb3eff8a6"}},{"id":"VRCE-6-44-3","kanda":6,"kandaId":"yuddha","sarga":44,"verse":3,"english":"O charioteer, swiftly conduct you the car to that same place. These powerful ones are slaying innumerable Rākşasas in fight.","alignment":{"type":"1:1","confidence":0.443,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6044003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ac3f1bc3f9ad5cfb518e0b9f128abcc19cb517ed67ec41b7e9b369f4a3feced","compact":"c4679fd58d625b1bd8d272c9dfa4770250b9c140cc45d12942470dae536fa7ac","nasal":"1d884f9dc10563d2f