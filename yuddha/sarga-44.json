ec7bb1a17241f7272e80b9da65f","nasal":"88cdc8c1f553ba239fdd9bc634a3ba0d1af4bde4891175557f85f4947f9ecd17"}},{"id":"VRCE-6-44-7","kanda":6,"kandaId":"yuddha","sarga":44,"verse":7,"english":"Thereat the monkeys could not so much as maintain their ground in the field, and how could they fight?","alignment":{"type":"1:1","confidence":0.621,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6044007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ae9a2bc4d5ae23b2d2ea6a3db8d6004ddcb07f9dffc3db942a05eeea22a1df6","compact":"ce92417c6a251ae7be69ba7d421043125bffd642709137636791201a4646780c","nasal":"bea05bd53a135ea2057ee4f1a11b38f6bfaf87d67bc2aa00e8c7c35fe0f705d7"}},{"id":"VRCE-6-44-8","kanda":6,"kandaId":"yuddha","sarga":44,"verse":8,"english":"Broken by the arrows of Akampana, they began to fly. and the exceedingly strong Hanumān, seeing his kindred come under the masterdom of Death and follow the course pursued by the shafts of Akampana, advanced (to the conflict). And seeing that mighty monkey, all those heroic prime monkeys together surrounded (Hanumān) in the field.","alignment":{"type":"grouped","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6044008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"552bfe359d1af3483449444d3dcecbc494cbda50b4abfd269aea37ce502f2143","compact":"07516d2f4b453b786d4a4b4cc70b4eff7dea77c22194009d2b3a5bed94455f93","nasal":"c7ebeb17decb08f264878d1088be91001fdc42281180639160f26a7f5734a55e"}},{"id":"VRCE-6-44-9","kanda":6,"kandaId":"yuddha","sarga":44,"verse":9,"english":"Broken by the arrows of Akampana, they began to fly. and the exceedingly strong Hanumān, seeing his kindred come under the masterdom of Death and follow the course pursued by the shafts of Akampana, advanced (to the conflict). And seeing that mighty monkey, all those heroic prime monkeys together surrounded (Hanumān) in the field.","alignment":{"type":"grouped","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6044009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1cbfeaf5d9218917be730204cdd296654a59d0b70163ab8220c84c07757389b3","compact":"afb896e81c2e41153f50c2d402b058435bf6a70747026b993a35c9a040adb8e7","nasal":"afb896e81c2e41153f50c2d402b058435bf6a70747026b993a35c9a040adb8e7"}},{"id":"VRCE-6-44-10","kanda":6,"kandaId":"yuddha","sarga":44,"verse":10,"english":"Those best of monkeys, seeing Hanumán stay, grew strong by relying on that strong one.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6044010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3030e8c4880d3d43fc911ab6aa563e6ddc70ad5b6dae34b57e1c4e004e60a5a2","compact":"a5781e69177ea62c10e8ef951ed124f18ebcbfd3ed311b71ed20f73c41dc90f6","nasal":"c7f8226de14f965f4b0506d8998f98e83267e0a79b17b769aca12cb7e095dc95"}},{"id":"VRCE-6-44-11","kanda":6,"kandaId":"yuddha","sarga":44,"verse":11,"english":"And even as the great Indra shower down rain, Akampana showered shafts on Hanuman resembling a mountain-summit in grandeur.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-56-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6044011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78d133971ff9fc9ae51b038d8578e0758161d685a3c511efef3c93daca3413e1","compact":"ee5fc2662344a173d525d8a0a0a97ca53b296d5aa4a3dad9aadf4055e2cac90b","nasal":"662ffa55474f42cd43be23e876b17671d8a71a1bbf96af4e158a41fc2cec0935"}},{"id":"VRCE-6-44-12","kanda":6,"kandaId":"yuddha","sarga":44,"v