c8c2e84883bc05f31d627786665e7601b90cf5beab57","nasal":"46e7319a5615292ddd8c4dc548d888d7399834d337e07fa4d9d3689e32cd5059"}},{"id":"VRCE-6-21-7","kanda":6,"kandaId":"yuddha","sarga":21,"verse":7,"english":"As soon as I entered, and was scanning that host, I was discovered. And forcibly taken by the Rākşasa, I was pulled by them hither and thither.","alignment":{"type":"1:1","confidence":0.537,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6021007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4505a9b0b97a00af1e2f1b3eec660afb1baae796f4f1acc3297f23fe8593288f","compact":"6465307b9726a2af93d189f2451ae880bfc0c5cb9c093ede082a12a4d177846a","nasal":"0e1a040fa34cc093a401466c634a343c9bd1c911235e145d3c44a33dd8c098f9"}},{"id":"VRCE-6-21-8","kanda":6,"kandaId":"yuddha","sarga":21,"verse":8,"english":"And furiously assailed by the monkeys with thighs, clenched fists, teeth, and palms, I was dragged in the midst of the army by the enraged monkeys.","alignment":{"type":"1:1","confidence":0.809,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6021008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"173a9fe18fbc6f95a3763983793fc79ef4d0bce52385805aa669ba99f702de9c","compact":"2d5b9b8ae0cdad24d6aa675f7334c046abf9a49d8cbb78747787efa9f9c1b5e4","nasal":"649c44cf6efa7c34eb252eed68be0b07dc1a9060b548a33fef51ef977bc99c06"}},{"id":"VRCE-6-21-9","kanda":6,"kandaId":"yuddha","sarga":21,"verse":9,"english":"And, after having been taken all about, I was (at length) taken before Rāma, bleeding, with my limbs showing sorry work, and my senses swimming and paralysed.","alignment":{"type":"1:1","confidence":0.619,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6021009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7def07cd233e212ecf3e3586d33c7cf26b2650b8e06df38710f53bb9d96187a8","compact":"758c8a15762cbbd6161f1943b3c69f1e69be51628f42e148aee39074b2d931cf","nasal":"9424d272b3634d018e4cb417bc7fcbfd06f106bc06905f2ae17e7e65d9e61c1e"}},{"id":"VRCE-6-21-10","kanda":6,"kandaId":"yuddha","sarga":21,"verse":10,"english":"And, having been belaboured by the monkeys, I, on craving his kindness with joined hands, was, at his pleasure, rescued by Rāghava, with, Don't, don't!","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6021010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d1359c580437da517b083a21fee2c4949cc4c5a6c2cd9433f1259c8e16d1a67b","compact":"cffb0e14bcbb840de4593361605a7013e8e63593cceb957f1cf56b7a45708fdb","nasal":"47e5a97d7b6ceec54e8be278a28463c30260e44b73245a48f398176429f107a2"}},{"id":"VRCE-6-21-11","kanda":6,"kandaId":"yuddha","sarga":21,"verse":11,"english":"Having filled up the deep with rocks and crags, Rāma equipped with weapons, stay, occupying the gate of Lanka.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6021011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"894013a98c4bcfcdbb175f255cd0bea528e89f6f206fc4528b47f3d45e7910a7","compact":"a903a66af445278244b30d708be2e4626447612d8879ca2b17b56d055b89a7e6","nasal":"fcb57841e6698032a0b0f64301f6ecb0aa765c4553bd363495c78e74af4ffe8f"}},{"id":"VRCE-6-21-12","kanda":6,"kandaId":"yuddha","sarga":21,"verse":12,"english":"And, letting me off, that one of suspassing vigour, surrounded by monkeys, and, arranging his forces in the Garuda fashion, advance upon Lanka.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6021012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"202010f0289fdba45aed72f00b32d33ac96ef4e62a6f65031c8d88cfd1aa3c8b","compact":"9f0e5774434a158c0c105eb1e91cca0dd8145d9c4f8f1803a0a2d39dd36f712d","nasal":"d1bbf54b9624c5c435e5e2c0c9b347277f35ae71ef770e20ba6d553f2f6222d8"}},{"id":"VRCE-6-21-13","kanda":6,"kandaId":"yuddha","sarga":21,"verse":13,"english":"They advance before the wall. Speedily do one of these things-make over Sītā without delay, or give (him) battle.","alignment":{"type":"1:1","confidence":0.691,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-24-34"],"status":"unreviewed"},"source":{"sanskritLocator":"6021013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fcecd30bbf3b175460e8eb1c002884e07886712d7f15a32dfd678b4c10927d69","compact":"ec37a6498e3058e111a5bfa328764c041f167d9a75594fbddc7347561c0bbd18","nasal":"ec37a6498e3058e111a5bfa328764c041f167d9a75594fbddc7347561c0bbd18"}},{"id":"VRCE-6-21-14","kanda":6,"kandaId":"yuddha","sarga":21,"verse":14,"english":"Hearing this, Ravana, lord of Raksasas, then reflecting in his mind, spoke to Sārdula these pregnant words.","alignment":{"type":"1:1","confidence":0.517,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6021014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"82e317f3d451da28d1049a5d073ee26b07cad61eb844e5b0e3ec4482a1592754","compact":"7ae2e5119e8124c4d22baff3405a3a3ecf633119529734e2ccfa3ea3c20c81aa","nasal":"7ae2e5119e8124c4d22baff3405a3a3ecf633119529734e2ccfa3ea3c20c81aa"}},{"id":"VRCE-6-21-15","kanda":6,"kandaId":"yuddha","sarga":21,"verse":15,"english":"Even if gods, and Gandharvas, and Danavas should array themselves against me, I will not from fear of all creatures, render (back) Sītā.","alignment":{"type":"grouped","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-24-36"],"status":"unreviewed"},"source":{"sanskritLocator":"6021015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c7d27451807b1a7e89203a53889b7269e00064ca447ff4483187ca18d8305ab","compact":"373a3d93611015144c6f0af8b240eb0e0adf4e08ba72390955eab430a1e9ade9","nasal":"d2038dff073b5f98371fa74429086fa26140d567217e5a79b681314cbdec3bab"}},{"id":"VRCE-6-21-16","kanda":6,"kandaId":"yuddha","sarga":21,"verse":16,"english":"Having said this, that exceedingly energetic one again said,You have ranged this army. Who here among the monkeys are heroic?","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6021016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"876d57eeb2c0d1f3ce4ca500e2c3bab62fba2eb2c852109287ca87908b0130d2","compact":"d1606d5d13b6c6b64dc205767c23c8a5a3b09ce4efeddee1c607f238d034866b","nasal":"d1606d5d13b6c6b64dc205767c23c8a5a3b09ce4efeddee1c607f238d034866b"}},{"id":"VRCE-6-21-17","kanda":6,"kandaId":"yuddha","sarga":21,"verse":17,"english":"O amiable one, what is their potency? And what are those monkeys that are hard to approach, like? And, O you of fair vows, whose sons and grandsons are they? Truly relate all this (to me).","alignment":{"type":"1:1","confidence":0.643,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6021017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a53b77bb953acf9f4f132333e781e820458c9891cc90d881d2f771efe1c1c66f","compact":"2f9971efec1a8b152c08d383d493f83279eaf8304dda195829a65f2512473e28","nasal":"2f9971efec1a8b152c08d383d493f83279eaf8304dda195829a65f2512473e28"}},{"id":"VRCE-6-21-18","kanda":6,"kandaId":"yuddha","sarga":21,"verse":18,"english":"Having ascertained their strength and weakness, I shall in this matter adopt my course. Those who wish for fight, certainly take account of all this.","alignment":{"type":"1:1","confidence":0.7,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6021018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a336ca5becb5b409e7b4c6dfe4d5935e15919243cf6d802c9a87de6c0a03a4a","compact":"b015897372272aac261e726faa5ce473835ed85b85f49caa8aab196f7f805df2","nasal":"b015897372272aac261e726faa5ce473835ed85b85f49caa8aab196f7f805df2"}},{"id":"VRCE-6-21-19","kanda":6,"kandaId":"yuddha","sarga":21,"verse":19,"english":"Thus addressed by Rāvana, Sārdula—best of spies-thus began to speak in the presence of Ravana.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6021019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"775735c71cbf42144a3a89dcc745c257fc12672531b5be2de84e424a253d380d","compact":"0e3af9a710575f5c1e5445bc178bfbc41a3a5e1f4490c1778a6cea21866271c9","nasal":"0e3af9a710575f5c1e5445bc178bfbc41a3a5e1f4490c1778a6cea21866271c9"}},{"id":"VRCE-6-21-20","kanda":6,"kandaId":"yuddha","sarga":21,"verse":20,"english":"O king, that unconquerable one in fight, Jāmbavān, is well known as the son Gadgada, king of bears.","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6021020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1560d192132b0a09b686e73ac8c3186eba10bc344d1632a02642bd95587311fb","compact":"95c3c9b06440bfda4ab0f9e18d8f3acbbe8a8bf0a6337f8f101416d268779853","nasal":"68f831b2c8bdedca0f9be2a5b3c6b595c3b23865a157d45ad6977d641aebac74"}},{"id":"VRCE-6-21-21","kanda":6,"kandaId":"yuddha","sarga":21,"verse":21,"english":"The other son of Gadgada is the son of Śakra's preceptor. By which son, single-handed, was done immense oppression to the Rākṣasa.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6021021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e5d23a2407604334faac6ac94d4736683a7bd8a8af38d0d73ca0ba214160479f","compact":"429bad9358528cf30a6553b0b438c97a2e25678efc8c2052c474c75b033fe4b4","nasal":"429bad9358528cf30a6553b0b438c97a2e25678efc8c2052c474c75b033fe4b4"}},{"id":"VRCE-6-21-22","kanda":6,"kandaId":"yuddha","sarga":21,"verse":22,"english":"The righteous and puissant Sușeņa is the son of Dharma. And the mild monkey, Dadhimukha, O king, is the son of Soma. 1. Righteousness. 2. Moon.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6021022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8bbede3be26505ec24adf6040213d6a1646cce0d19f17bb9716c059886d5b1b","compact":"f7b1ca6a980dcef75bba7a93a4f0c37c5e66e4f7d842c79abd2a61b3f6d00dc5","nasal":"38f0f1d567e1b598c399b3e0dcced03dfdcfd7dc9ad84e58a74c9b3a78245395"}},{"id":"VRCE-6-21-23","kanda":6,"kandaId":"yuddha","sarga":21,"verse":23,"english":"And Sumukha, Durmukha and the monkey, vegadarcin (resembling) Death himself, were for certain begot by the Self-create in the shape of a monkey.* *Another meaning is, “The monkey, Vegadarsi who is death himself in the shape of a monkey.\" But I give the acceptable sense.","alignment":{"type":"1:1","confidence":0.906,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6021023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit