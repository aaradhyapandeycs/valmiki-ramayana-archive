[{"id":"VRCE-6-21-1","kanda":6,"kandaId":"yuddha","sarga":21,"verse":1,"english":"Then the spies communicated to Lankā's lord news concerning Rāghava and his host stationed at the mount Suvela.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6021001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"022476f2c64567e0a33169f8c50ef164db04f0229471f73cec219f42f64bbddb","compact":"f25c1d48fb6d6699cafc7a298287b57ad3dc1e9f44a0dff1e4958a3631f2b70f","nasal":"93d8ef34e5c2bb90521228a09fba4520e14c41eae654370531e63349629584ae"}},{"id":"VRCE-6-21-2","kanda":6,"kandaId":"yuddha","sarga":21,"verse":2,"english":"Hearing the words of the spies, that Rama, accompanied by a mighty army, had arrived (there), Rāvana was a little agitated and spoke to Sardula.","alignment":{"type":"1:1","confidence":0.892,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6021002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"57a406a8561f7e8d0c4ffbba37a3bd3301146594e866ccc26f23deecc9af95d0","compact":"8549110736f9ccf97b6d6df9908ae2e841344dc415fd943c382879e986605604","nasal":"8549110736f9ccf97b6d6df9908ae2e841344dc415fd943c382879e986605604"}},{"id":"VRCE-6-21-3","kanda":6,"kandaId":"yuddha","sarga":21,"verse":3,"english":"Your colour has changed its natural aspect, and O ranger of the night, you look poorly. Did not come under the control of the wrathful foes?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-30-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6021003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a25f865ff43f1dfcff65e0e6c1e1b7c6aab58d360b4f3b5a771570c339b86eb5","compact":"0a7d66186f0e4605d3f38fa550264048063d22b5a1a5