[{"id":"VRCE-6-70-1","kanda":6,"kandaId":"yuddha","sarga":70,"verse":1,"english":"Hearing the terrible war-cry of the Rākşasas and monkeys Rāghava spoke to Jämbavän, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6070001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b05708503290fbc9e8ef3f2eeb99a8c1e5af15b63b76629897f1a6109f9d4a3","compact":"f753d84bb0564689b5dd8c99d557a1bbb1734de3da969736637f881589521374","nasal":"70baae6392d44de5935dc18b83a74681e05577e770a8f8f46dd061deed3b731e"}},{"id":"VRCE-6-70-2","kanda":6,"kandaId":"yuddha","sarga":70,"verse":2,"english":"O gentle one, forsooth has Hanumān performed some mighty act for I hear the dreadful sound of the weapons.","alignment":{"type":"1:1","confidence":0.842,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6070002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aa3fa2cbcb7a7e4025ae7bc0cf63a2a3c0849f6eb461390c2dc8216eea2300db","compact":"0ec1819093524719700c4df59abdbf277d858e228c092bc76ac85b4ccc1d7a06","nasal":"0ec1819093524719700c4df59abdbf277d858e228c092bc76ac85b4ccc1d7a06"}},{"id":"VRCE-6-70-3","kanda":6,"kandaId":"yuddha","sarga":70,"verse":3,"english":"Do you therefore proceed speedily, O lord of bears, with all your soldiers to assist that foremost of monkeys.","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6070003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02064d65451b464165f68e55027bc8128a6f12d6ad2d87ca4d84d8efd5224f23","compact":"0908602c933b7b8a07513f0c0094e82bb6b7c8c97b01a98250e3778a72080b55","nasal":"0908602c933b7b8a07513f0c0094e82bb6b7c8c97b01a98250e3778a72080b55"}},{"id":"VRCE-6-70-4","kanda":6,"kandaId":"yuddha","sarga":70,"verse":4,"english":"Thereupon, saying, 'So be it,' that king of bears, surrounded by his forces, approached the Western gate, where the monkey, Hanumān, was stationed.","alignment":{"type":"1:1","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6070004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b92aa14fb7b3a57e7e99c04890b6e874eac1399257798da5a046798b8a9a5c3f","compact":"dd6c2cd226a856817de552e943919e69c3940857f088faea50dded59cd6319fe","nasal":"dd6c2cd226a856817de552e943919e69c3940857f088faea50dded59cd6319fe"}},{"id":"VRCE-6-70-5","kanda":6,"kandaId":"yuddha","sarga":70,"verse":5,"english":"Then the lord of bears saw Hanumān approach, surrounded by monkeys sighing hard, who had faught the fight.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6070005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e2e3488533de31059f5c8c6ee8e8c2d9adea967143f6fca31d4c5ad4e3976180","compact":"bf82516230bb2993732664152a77ecd0428dfd17fb421edf18e306bc368c3d67","nasal":"1c47f67514ed6dac85c6f18cefd4956a370ae8b47d996b1959ff1a885575a149"}},{"id":"VRCE-6-70-6","kanda":6,"kandaId":"yuddha","sarga":70,"verse":6,"english":"Seeing on the way that host of bears dreadful and resembling dark clouds, on the march, Hanumān made them desist.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6070006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"879d9c1bca8ce715e582bdfb7c0ec61f0a4aeb1e9decec8d52206ef33236eca4","compact":"3ea46814fd2eeb9df5476502a6104b778212b7c538e78263b8e50c755ea785b5","nasal":"3ea46814fd2eeb9df5476502a6104b778212b7c538e78263b8e50c755ea785b5"}},{"id":"VRCE-6-70-7","kanda":6,"kandaId":"yuddha","sarga":70,"verse":7,"english":"That illustrious one along with that force, speedily presented himself (before Rāma), and with a heavy heart addressed him, saying.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6070007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2457e07bb8ace1c6714e8ce4f90c0be3ad45df1a22355732d15252af17a1ec97","compact":"b529a0acd47a99f1420ff8bbd545e7e9cf16dbd904682d81d9e7d10b3fdc163e","nasal":"b529a0acd47a99f1420ff8bbd545e7e9cf16dbd904682d81d9e7d10b3fdc163e"}},{"id":"VRCE-6-70-8","kanda":6,"kandaId":"yuddha","sarga":70,"verse":8,"english":"As we were fighting the field, Ravana's son, Indrajit in our very sight slew Sītā, crying (in distress).","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6070008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9ef0ca4f011c7d77dff1839d1d54a58ef76bf46fe5a0c6bf115492759af5c955","compact":"ef7d625261bf50d3e2d0140a2785910e4029fa29704acdf29c348329dfe9a70a","nasal":"ac39f48747f277ada30eb06844334d89c988d02eb6c42ff44577535f8bf1c818"}},{"id":"VRCE-6-70-9","kanda":6,"kandaId":"yuddha","sarga":70,"verse":9,"english":"O subduer of enemies, seeing her (in this plight) I, with my senses bewildered, have been overwhelmed with grief. Therefore I have come to you to inform you of what has befallen.","alignment":{"type":"1:1","confidence":0.908,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6070009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c06eb98570a2eeeeeac96144acd5d5a894f1c4ab8581153cbeb860634b31dd4c","compact":"7653dbe68726c233a4f2dbe72f6612076bf8efbbb189908ccf0b86d6f3b69cf9","nasal":"d3a068f53f19227411f10fe5b04d1f7d3bb739da331cd809cd6a62242d30be8d"}},{"id":"VRCE-6-70-10","kanda":6,"kandaId":"yuddha","sarga":70,"verse":10,"english":"Hearing these words of his, Raghava, overwhelmed with grief, dropped down to the earth, like a tree whose roots have been severed.","alignment":{"type":"1:1","confidence":0.895,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6070010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"633d7310c9ef7939aa3856bb3f171fa9794afe8c30fefecd1ab63174dcb758e4","compact":"66c728e8b62e35b11b08d7d3377f9422b80fd7574fbe0ff5e3356fdb64665929","nasal":"f39298a410a94b9d7e01f43cb3115a50231996f7cf76fe161aacc512e62050b0"}},{"id":"VRCE-6-70-11","kanda":6,"kandaId":"yuddha","sarga":70,"verse":11,"english":"Seeing the god-like Råghava down on the earth, the foremost monkeys from all sides rushed forward and came to where (he was).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6070011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a2a44851bb041f8ecd786deb86351d0a652ec58519406eb767f17b43e792a7c","compact":"a8da647cb33332e256f7725dbd0d4a2360be45df5f7906de6c6bce0b7f587243","nasal":"a8da647cb33332e256f7725dbd0d4a2360be45df5f7906de6c6bce0b7f587243"}},{"id":"VRCE-6-70-12","kanda":6,"kandaId":"yuddha","sarga":70,"verse":12,"english":"With water scented with lotuses, they fell to sprinkling that one resembling a furious fire that has suddenly arisen. 1. Padmotpalasugadhibhiḥ-water scented with padmas-lotuses proper, and utpalas-blue lotuses (Nymphea cerulea). 2. 'Rama,' remarks the commentator, 'was a fire lighted by his grief for Sītā.'","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6070012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2ae201df67b9f9df0abded37e6c0d8b3c5e460879aecbf1ac4bfc631addca858","compact":"347d88abce78f82722a6876616d81d90307ffc04306160b7a58a2c2b3f42a812","nasal":"b12848467c63088e6431e5de559b1441c89cd9fdcf5a44f2d733a65aba57e36b"}},{"id":"VRCE-6-70-13","kanda":6,"kandaId":"yuddha","sarga":70,"verse":13,"english":"Thereat Laksmana, over-come with sorrow, embracing Rāma, spoke to his words fraught with reason and import, “Profitless* virtue is incapable, O noble one, of delivering from calamities you, who have subdued your senses, and who ever abidst in the good path. * 'Profitless, although apparently an epither of virtue, is really the predicate of the sentence. 'Virtue, incapable of delivering you is profitless.","alignment":{"type":"grouped","confidence":0.925,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6070013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"93bc98d43f623cbcbeda9822e8d03f8e6444a71a74d5951279f483c95fff8d26","compact":"d6906b93a5d87e05bf5ae78713543b8305ea593c4ee480b8b963537f88d18904","nasal":"d6906b93a5d87e05bf5ae78713543b8305ea593c4ee480b8b963537f88d18904"}},{"id":"VRCE-6-70-14","kanda":6,"kandaId":"yuddha","sarga":70,"verse":14,"english":"Thereat Laksmana, over-come with sorrow, embracing Rāma, spoke to his words fraught with reason and import, “Profitless* virtue is incapable, O noble one, of delivering from calamities you, who have subdued your senses, and who ever abidst in the good path. * 'Profitless, although apparently an epither of virtue, is really the predicate of the sentence. 'Virtue, incapable of delivering you is profitless.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6070014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a1a7a63d84c417e0385dc13f2e7b784131297c5c8b2643b6a8b2938e4d27128e","compact":"b110a4ef56e521949c03ba9c499840e09217c2fc23313d303b371750b6bfc67a","nasal":"493c168643504c91e0516e02083796ca0fe17203eefc6f2f9dfec503ea67dd7e"}},{"id":"VRCE-6-70-15","kanda":6,"kandaId":"yuddha","sarga":70,"verse":15,"english":"Beings and the mobile as well as the immobile cannot have that direct perception of virtue which they have of happiness. Therefore, I ween, virtue is a non-entity.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6070015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6231fb9da996da07a29ea4f45e38395f6dad9797afbd9d9f1b7688a09bc2d3ac","compact":"8aff4ba69f713b98843e4430ac251dd88dabb7b247662b390eedf96f0b13c079","nasal":"82b0727bd6c8314a88f1d38e82220f87e9d5991d04a3c1fcb52f4cecd10e94b8"}},{"id":"VRCE-6-70-16","kanda":6,"kandaId":"yuddha","sarga":70,"verse":16,"english":"Inasmuch as the immobile (albeit devoid of any regard for virtue) are nevertheless happy and as the mobile also are so, this virtue cannot lead to happiness. (If it were so), one like you would have not been placed in peril.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6070016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8bd1124b45d22795a9c27201e285c0045948f36b26376a3329bc41d51843782f","compact":"2de3ef1f0c9effebbff018a25f1f76f4f518e4f393c809dc2ecb18b6c8073d45","nasal":"a6d0b0a12fcf975bf60a471fc7ee58cda07dfa1ea09017ad24cc0bee0e22d9fd"}},{"id":"VRCE-6-70-17","kanda":6,"kandaId":"yuddha","sarga":70,"verse":17,"english":"If unrighteousness would bring unhappiness on creatures, Ravana should hence to hell, and you possessed of virtue, should not come by misfortune.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6070017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6091af824b298904859c045db96ec225be74508138aeafbec9e904fb173ce30d","compact":"4d1548bd7e66ba5e5be1b1451921c14a6d0ed713ebf064d974481b39523dccee","nasal":"4d1548bd7e66ba5e5be1b1451921c14a6d0ed713ebf064d974481b39523dccee"}},{"id":"VRCE-6-70-18","kanda":6,"kandaId":"yuddha","sarga":70,"verse":18,"english":"Seeing that he is free from danger, and you are in itrighteousness and its opposite are found to have tendencles the very reverse of those assigned to them respectively (by the Vedas). If by means of virtue, one attain the felicity attached to it, and by means of unrighteouness, one reap its proper fruit, then let those that are unrighteous reap the fruit of their impiety nor let those that set their face against sin, be deprived of the fruit of their righteousness, and let those that walk in the way of virtue reap the fruit of their piety.","alignment":{"type":"split","confidence":0.373,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-17","DUTT-6-83-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6070018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3b0c08a9d8759e6166a59fb56bf322aed9d13c7f1589dbd4456c49763a1660d0","compact":"6399000da00995d2eac531dd676fa13b5b36887363c82b1bc9ba53f7fafea93b","nasal":"6399000da00995d2eac531dd676fa13b5b36887363c82b1bc9ba53f7fafea93b"}},{"id":"VRCE-6-70-19","kanda":6,"kandaId":"yuddha","sarga":70,"verse":19,"english":"If by means of virtue, one attain the felicity attached to it, and by means of unrighteouness, one reap its proper fruit, then let those that are unrighteous reap the fruit of their impiety nor let those that set their face against sin, be deprived of the fruit of their righteousness, and let those that walk in the way of virtue reap the fruit of their piety.","alignment":{"type":"grouped","confidence":0.356,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6070019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b038d6c0cb72cb365f66beacf1411ec3db0e4408ee142615669b51aa9cacfea9","compact":"9da5807b23ca5b560d5aa08a922c997221e1d2dd4cb45b791a95fec5b016adf5","nasal":"44f81bce992f7bb8b09e624b178b607169ada8f96804cefdef6c4a57f4e92ac1"}},{"id":"VRCE-6-70-20","kanda":6,"kandaId":"yuddha","sarga":70,"verse":20,"english":"But as prosperity attend those that are established in unrighteousness, and as those regardful of righteousness fare lamentably, these*have not the senses assigned to them (by the scriptures). *Virtue and vice.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6070020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"704d0d26bf6df22f7b1b46de087ac75375085eaaa1cf8c2dc44eb4fc256892aa","compact":"1669b898ea0808821277af041488fb65d1cbeda4b66cca9e9d3c2b9ccef4fedc","nasal":"9487eeba90306984e61bc71c89f5fcbf1feb5dd7ee95733ebac6d2b0c11a1188"}},{"id":"VRCE-6-70-21","kanda":6,"kandaId":"yuddha","sarga":70,"verse":21,"english":"If, O Rāghava, Rāghava, (it is contended that) unrighteousness cut off the wicked, then whom shall Unrighteousness, himself slain by the act of slaughter of the destroyer, slay in his turn?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6070021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f3de1e8e9634b364ad0683f45a9ddf929ebce0fd7718cf1779ef70731c21798","compact":"2bf0524100c6a2862f8bf3a41e20e8d960799f943ae2754cd2d668b86c8ba5ca","nasal":"fd4d617408bb666f52434e28abf00a37f727135692dc89733dca7f2d70fed5af"}},{"id":"VRCE-6-70-22","kanda":6,"kandaId":"yuddha","sarga":70,"verse":22,"english":"Or if it is said that one is slain or slay another by ordinance, then it is destiny, which is touched by the sinful act and not he.","alignment":{"type":"1:1","confidence":0.679,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6070022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d973734d304213570767e3e5001bfc055b97deeb89dd0f998880fa20c1af95e2","compact":"797c39e32b84be380046f327c31ba503fde33be71296cc6232e67838e591875e","nasal":"8059e27f8057185340e9b204f866a80dbe6c55feba370b774daa6e0de3b65005"}},{"id":"VRCE-6-70-23","kanda":6,"kandaId":"yuddha","sarga":70,"verse":23,"english":"O chastiser of foes, incapable of meting out retribution,* unmanifest itself, and non-existent, how can virtue, even if we grant its existence, find out the person that should be slain? *\"In consequence,' remarks Ramanuja, 'of their being devoid of consciousness.","alignment":{"type":"1:1","confidence":0.967,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6070023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ee7c9bf514218d1c8d3b8a9fe97fb889edb1299e25046f6b9e37e336867541ce","compact":"afd6d0ea2105e7376a5880443675f077b09be71512e21c1709333769bd719ef8","nasal":"afd6d0ea2105e7376a5880443675f077b09be71512e21c1709333769bd719ef8"}},{"id":"VRCE-6-70-24","kanda":6,"kandaId":"yuddha","sarga":70,"verse":24,"english":"If, O foremost of the good, it had existed, you wouldst not have come by any misfortune. But inasmuch as you have fallen into this plight, there is no such thing as virtue.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6070024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"43cc148017b8cc6b34c69a43717f431a201f0b725605f4fb8a3d8cc831c1ecf4","compact":"fb5177b125ec29d828fc6ab5325e99bc3aac3cbfb684064cffa3d5aa537f33b1","nasal":"a385b046a9172391e4984297cb8773bfddd92cb257de9c288a3ad7b8ca3114a8"}},{"id":"VRCE-6-70-25","kanda":6,"kandaId":"yuddha","sarga":70,"verse":25,"english":"Or itself feeble and impotent, it take refuge in manliness. And being powerless and bereft of dignity, it should, I deem, by no means be followed.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6070025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b93f9dbe21777ae960d3a1b022f4aba236a730cb96d8864e74871b79ec31c078","compact":"e3d8e18ad87a0f55761d21f4f1cdea58ab081659c14ba76d21da74d48b0a32e2","nasal":"e3d8e18ad87a0f55761d21f4f1cdea58ab081659c14ba76d21da74d48b0a32e2"}},{"id":"VRCE-6-70-26","kanda":6,"kandaId":"yuddha","sarga":70,"verse":26,"english":"If virtue is a property of manliness, then carefully forsaking virtue, do you follow strength as you have hitherto followed virtue.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6070026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac06d79db8fcf9360f1b204be3e751f8fef082433bd95725ee3f58539ed8c3ca","compact":"d0e3c9f535409e9b46c4eb46392bf950a09ca943c5d1c19afe15a01840ae5b66","nasal":"d0e3c9f535409e9b46c4eb46392bf950a09ca943c5d1c19afe15a01840ae5b66"}},{"id":"VRCE-6-70-27","kanda":6,"kandaId":"yuddha","sarga":70,"verse":27,"english":"But, O subduer of enemies, if truthfulness be virtue, are you not bound by that departing from which the king lost his life?* *Explains the commentator, 'King Dasaratha lost his life, because he did not observe his word of installing you in the kingdom. Are you not bound by his word as well?'","alignment":{"type":"1:1","confidence":0.571,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6070027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c7faca3a8bb0591d0fa037be89730b749796eeb7807bdb7e1059ba805b5955b","compact":"00d1a0f8707c97e20dee4af73d45f1013408785830be747802150826ae40f0f9","nasal":"00d1a0f8707c97e20dee4af73d45f1013408785830be747802150826ae40f0f9"}},{"id":"VRCE-6-70-28","kanda":6,"kandaId":"yuddha","sarga":70,"verse":28,"english":"O chastiser of foes, if virtue must be practised above all, or if prowess must have precedence, then the thunder-handed Satakratu would not have celebrated his sacrifice, slaying the ascetic.* *The Logic is all in a jumble; but such is the text. The ascetic was Visvarūpa. The meaning, according to the commentator, is that, prowess is first and virtue next. Indra first used force, and then acquired merit.)","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6070028","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0beda4752efa7dfdab0fa4f374261c26e9a4ead1fcb1c359ac7988ccb402eb1d","compact":"5efa025c0f1c9de0e08737931c216d9f8866c8456d3347793d38b835a7f01588","nasal":"5efa025c0f1c9de0e08737931c216d9f8866c8456d3347793d38b835a7f01588"}},{"id":"VRCE-6-70-29","kanda":6,"kandaId":"yuddha","sarga":70,"verse":29,"english":"O Rāghava, virtue aided by prowess, destroy enemies. Therefore, O Kakutstha, people, for compassing their ends, resort to both virtue and prowess.","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-28"],"status":"unreviewed"},"source":{"sanskritLocator":"6070029","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"51f160e71ddaa94c12d5ff7188a260536f1b64d278f9bdbd9996ae13f874f611","compact":"39aeaec5bf6172b71d955ad17b184bce0a0694a22b7a8ef5bf7b762cdf975ce1","nasal":"39aeaec5bf6172b71d955ad17b184bce0a0694a22b7a8ef5bf7b762cdf975ce1"}},{"id":"VRCE-6-70-30","kanda":6,"kandaId":"yuddha","sarga":70,"verse":30,"english":"This, sire, is my opinion, this, O Raghava, is virtue. But you, having then renounced the kingdom, have laid the axe at the root* of righteousness. **Root, remarks, Rāmānuja, 'which is interest!'","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-29"],"status":"unreviewed"},"source":{"sanskritLocator":"6070030","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7902716571720990d217d14bdda2b46bde01605ec2ba7536b252c84a4a3549d2","compact":"31046d35a4140395420e1a9cf5730f6e6603684deb74d4d7d3127c1bd3665561","nasal":"c9fc884da21407468dc3290a8add433e1267089b2359c57cc32c6f809bf820a3"}},{"id":"VRCE-6-70-31","kanda":6,"kandaId":"yuddha","sarga":70,"verse":31,"english":"Like streams issuing out mountains, all acts spring from wealth flowing from various regions and attaining magnitude.","alignment":{"type":"1:1","confidence":0.724,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-30"],"status":"unreviewed"},"source":{"sanskritLocator":"6070031","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9eab5a13d5635120c65fa2c4d94eb0152b2874612dfb67ca9233452d0c015092","compact":"72abaf60d5085da09c912788e3c4b2503a7db0d2d1df9bcf5ee855275006768f","nasal":"2c349834cb01ea5deef329b8ade981ced70019940dc4418ccc536c1190fae5f2"}},{"id":"VRCE-6-70-32","kanda":6,"kandaId":"yuddha","sarga":70,"verse":32,"english":"Like a shrunken stream in summer, all the acts of that foolish person who has been devorced by wealth, are annihilated.","alignment":{"type":"1:1","confidence":0.671,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-31"],"status":"unreviewed"},"source":{"sanskritLocator":"6070032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5fbd13397e9d65afa47041b2fee5d5ea4626553610f7f954538a3e1850c4b1a3","compact":"923e6cc684cc2cdec836a1193f22503774b9c0174a5b7fdabfb691305fe1ce45","nasal":"a46b71aa502ebea7603d7f146a3bdab9ac9106beeb3b5c4e15690791a5a17550"}},{"id":"VRCE-6-70-33","kanda":6,"kandaId":"yuddha","sarga":70,"verse":33,"english":"He that renouncing riches, within his reach,* hankers after enjoyment, being carried away by his overmastering desire, take to getting at wealth by sinful acts; and then he incur guilt. *The commentator would have gotten riches.'","alignment":{"type":"1:1","confidence":0.571,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-32"],"status":"unreviewed"},"source":{"sanskritLocator":"6070033","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a71a4fe9099cd9569476f5b2178ab137098cfab8c63715dc6c9c7d861c7fcba7","compact":"63c3ff063b4f96b6f669e610b7b0c45eb0843f5001b47f9f90a1143758a4ea98","nasal":"63c3ff063b4f96b6f669e610b7b0c45eb0843f5001b47f9f90a1143758a4ea98"}},{"id":"VRCE-6-70-34","kanda":6,"kandaId":"yuddha","sarga":70,"verse":34,"english":"To him that has wealth are friends, to him that has wealth are acquaintances, he that has wealth is an individuality in this world, and he that has wealth is a learned person.","alignment":{"type":"1:1","confidence":0.684,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-33"],"status":"unreviewed"},"source":{"sanskritLocator":"6070034","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"264596e0a8ec06daef25bad3d92334a24bb2e8fbe89cd67a0a7bb2039985fa0d","compact":"f5dfe40d625d6d835122e46376bee30c3923fe431c2b5be0bfd552250de7623c","nasal":"db23421db217f6de29b83eb441060dd4f7587636b6f24f55e0decd02cde81799"}},{"id":"VRCE-6-70-35","kanda":6,"kandaId":"yuddha","sarga":70,"verse":35,"english":"He that has wealth is powerful; he that has wealth is intelligent; he that has wealth is mighty-armed; and he that has wealth is full of all graces.","alignment":{"type":"1:1","confidence":0.767,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-34"],"status":"unreviewed"},"source":{"sanskritLocator":"6070035","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9212a6919d0e0c14f37138805f3577834b4f19e7f67c1317953d0aa0b602deb5","compact":"7e20992714631f3f278e7a2355f81be20f0cb97839958a57a967f59fd6c202b6","nasal":"c4aac0155f9bca4a0f8702cdeb1dfb67fc6105776a4a3fcf54e9466f5e5c6728"}},{"id":"VRCE-6-70-36","kanda":6,"kandaId":"yuddha","sarga":70,"verse":36,"english":"All these that I have en-numerated are the evils of forsaking fortune. (I cannot divine) what made you, renouncing the monarchy, to adopt such a course.","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-35"],"status":"unreviewed"},"source":{"sanskritLocator":"6070036","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e813f56a7424aa458575ce31f2543ebec4e4d7814316971042067d122108720","compact":"d94d8a859e1730e2664b621c552766c3863a0e3bdc5f1337cc029cd9a52b3388","nasal":"d94d8a859e1730e2664b621c552766c3863a0e3bdc5f1337cc029cd9a52b3388"}},{"id":"VRCE-6-70-37","kanda":6,"kandaId":"yuddha","sarga":70,"verse":37,"english":"He that has riches, has virtue and desire attending on him, and has everything auspicious. That one without wealth, that seek it, cannot secure the wealth of prowess, without riches and desire.","alignment":{"type":"1:1","confidence":0.771,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-36"],"status":"unreviewed"},"source":{"sanskritLocator":"6070037","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6a9e2886cfd3c299ff9912cac85ecf7443ac233cbb8655cb73fda0e7fe6ad277","compact":"35d49966c5488a4e5064d971247ddf30fd017ea4cb71a2007b14cdba0ad59e5d","nasal":"35d49966c5488a4e5064d971247ddf30fd017ea4cb71a2007b14cdba0ad59e5d"}},{"id":"VRCE-6-70-38","kanda":6,"kandaId":"yuddha","sarga":70,"verse":38,"english":"O lord of men, cheerfulness, and desire, and pride, and piety, and anger, and self-restraint, and self-control, all these come from wealth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-37"],"status":"unreviewed"},"source":{"sanskritLocator":"6070038","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7f5c9e01c6472ebdc649ad4dbe541c40efefdd187afefe639c701b1bc2374389","compact":"c484bbe0d5851bf27de9fe8270d6f2d763d703c85d005af2269715b73c8de1b2","nasal":"8f1fc23f1b488314c9c9a68595253d573977c6c2b1ae0a2742e676338b4ea052"}},{"id":"VRCE-6-70-39","kanda":6,"kandaId":"yuddha","sarga":70,"verse":39,"english":"As the planets are not discovered on a stormy day, that wealth, the want of which renders this world naught even to the ascetics practising righteousness, is not visible in you.","alignment":{"type":"1:1","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-38"],"status":"unreviewed"},"source":{"sanskritLocator":"6070039","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"25e5efe10d55d6ccca96774763d36428bc2f7a9df33bcb2ce31827c9dddae1be","compact":"ae4d736275924e6387d54fe4cc10efec24dbca235e905759408684256bb57905","nasal":"38e08a78a64fc5af1f45a07aba1cf5590cc0a8dc9634ac927363035d66c17033"}},{"id":"VRCE-6-70-40","kanda":6,"kandaId":"yuddha","sarga":70,"verse":40,"english":"O hero, you having abode by the words of your superior and having come (to the forest), your wife dearer then life itself has been ravished by Rākṣasas.","alignment":{"type":"1:1","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-39"],"status":"unreviewed"},"source":{"sanskritLocator":"6070040","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"954d37500f1ac2141c3811cf85d2d6416a0ed9795c2bafd87db04f0a34d0a665","compact":"737f149be1b68fdeafe5c56173ada01c7b0d006f5a78426e86b069a1d41d7325","nasal":"737f149be1b68fdeafe5c56173ada01c7b0d006f5a78426e86b069a1d41d7325"}},{"id":"VRCE-6-70-41","kanda":6,"kandaId":"yuddha","sarga":70,"verse":41,"english":"But, O hero, today, O Raghava, by my acts will I remove this huge sorrow that has been heaped upon us by Indrajit. Therefore, rise you up.","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-40"],"status":"unreviewed"},"source":{"sanskritLocator":"6070041","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1591bb4547b133739779eceaf0f89c9e71dd49ea209358ccf564c6fdc0652537","compact":"1174da0ce020ea79441c373d233f10e063327e827917a75269b6aadfd1d991b8","nasal":"3984468526f6a6c3f622346ef259f5b875391c7a646056835493a65f7b7d0547"}},{"id":"VRCE-6-70-42","kanda":6,"kandaId":"yuddha","sarga":70,"verse":42,"english":"Osinless one, urged on behalf of your welfare, I, waxing wroth on hearing of the slaughter of Janaka's daughter, shall with my shafts entirely raze to the ground Larkā with cars and elephants and steeds and the foremost Rākşasas.","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-83-42"],"status":"unreviewed"},"source":{"sanskritLocator":"6070042","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a7b5354f6b1d0dc4a9c7417ccf79fbcf84cad352dea189090c35e5f9d3f8