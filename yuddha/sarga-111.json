lignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6111014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7274d4e14a06a327e76b3c8090283d5c0fe6ca0fdbbcd692c7cf5dcd33c2bf05","compact":"eeb60a0f51b655a2302c72bef7865595c28a72de2bebc451c97a2fab411ac22d","nasal":"211079586d43e40d1516e1cf85d3252aad3076e70dc33322c8e2094354c1c521"}},{"id":"VRCE-6-111-15","kanda":6,"kandaId":"yuddha","sarga":111,"verse":15,"english":"Do you behold there, O Sītā, the huge and foremost mount Rishyamuka abounding in gold and various metals, like to clouds accompanied with lightnings.","alignment":{"type":"1:1","confidence":0.672,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-30"],"status":"unreviewed"},"source":{"sanskritLocator":"6111015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9ccf0ef5bc61a100b60b7eb0b314bd533e55c5518cd5c800b924f99a3e4178d7","compact":"9be8544b0ed4ed12a4e0c8455a88976fc9518d625b13fabb2009e18786d69d17","nasal":"b3eb2892de62c958eb5262916fff963305f86ebcdfdd4ab685297a5fa3bca2b9"}},{"id":"VRCE-6-111-16","kanda":6,"kandaId":"yuddha","sarga":111,"verse":16,"english":"There I was joined by Sugrīva, the lord of monkeys. And there I entered into an agreement, O Sita, for the destruction of Vali.","alignment":{"type":"grouped","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-31"],"status":"unreviewed"},"source":{"sanskritLocator":"6111016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5de4aa50f03e5eb6d36d01a9fd4ba561757f62c0a6bd54908d69275d87797cad","compact":"928e286aafdfd67e670c419f36416a512c9e21540260275bd0d274bfb8a61603","nasal":"f2d39ba12e2f6b03712d1b73daeff0b0527367921cc34a095c98a8e1950191a8"}},{"id":"VRCE-6-111-17","kanda":6,"kandaId":"yuddha","sarga":111,"verse":17,"english":"There is (the lake) Pampa abounding in lilies and skirted by picturesque forest where separated from you, I bewailed piteously.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-32"],"status":"unreviewed"},"source":{"sanskritLocator":"6111017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e3618ee51038c99b10cbe7a21b697f18d7defde0ce956199b55744aef0a0949","compact":"9a820959975ae368c9ffdd64e77eeb0c29bb388690a90c94037eae51ab2e2cd2","nasal":"853fc0dc978a765dfd6ab599c2ddefdbc1c1f40ee366bc736efd9ba28be88056"}},{"id":"VRCE-6-111-18","kanda":6,"kandaId":"yuddha","sarga":111,"verse":18,"english":"And on its bank I beheld the pious Savari. And you I slew Kabandha and Yojanabāhu.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-33"],"status":"unreviewed"},"source":{"sanskritLocator":"6111018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d1eb7f804424f900227b5917f8403772b936bf4ed3253e338bb8018523f8e15e","compact":"0d00aef8269c56ca86ddbefd6dc323d5b976403c000c8a9ac564f38afddb36e8","nasal":"18b5fb294c0e495d7a757448e0d76fe3fb04081d9c3f94a315c1128f13c1aa7f"}},{"id":"VRCE-6-111-19","kanda":6,"kandaId":"yuddha","sarga":111,"verse":19,"english":"Behold there, O Sítā, a beautiful tree, in janasthāna, where, O you ever used to luxuries, for you, the highly powerful and energetic Jag ayu, the foremost of birds, was slain by Ravana.","alignment":{"type":"approximate","confidence":0.186,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-34"],"status":"unreviewed"},"source":{"sanskritLocator":"6111019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c716914d50a5a25ad654fa1150b59f957a63112d8e2dc7030b0a5a5bc8d1199e","compact":"62c2e2bd2ba1b669aabc3705ca773d18dffd47006e9592bd8f53cb24eb58b1e7","nasal":"62c2e2bd2ba1b669aabc3705ca7