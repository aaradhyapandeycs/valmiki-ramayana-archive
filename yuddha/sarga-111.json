[{"id":"VRCE-6-111-1","kanda":6,"kandaId":"yuddha","sarga":111,"verse":1,"english":"Being commanded by Räma, that excellent car, drawn by ganders, with a huge noise, rose high up in the welkin.","alignment":{"type":"1:1","confidence":0.464,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6111001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"365a6b4076ec4d861a83256718abafe1c5796e2218498dc0ec501b2f8d69eb0b","compact":"7d359dca5544cc61a70c21d1917d28c18cb1f3551b8f2e2720208894c231aa1f","nasal":"7d359dca5544cc61a70c21d1917d28c18cb1f3551b8f2e2720208894c231aa1f"}},{"id":"VRCE-6-111-2","kanda":6,"kandaId":"yuddha","sarga":111,"verse":2,"english":"Casting his looks on all sides, Rama, the descendant of Raghus, spoke to Sītā, the daughter of the kind of Mithila, having a moonlike countenance, saying.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6111002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"106ccabfd00aa78e6933d9428e88fdaebf8727e82c36e57931d0d731da5521c4","compact":"199c717b8c56a84af1cd2a5547cc1342ef4e8ee4e47cc1038e39c7841e015fa6","nasal":"86219687e0ebe61ca8c760f6691868d5e28fe0e53616d784071770f87318d1a6"}},{"id":"VRCE-6-111-3","kanda":6,"kandaId":"yuddha","sarga":111,"verse":3,"english":"O Vaidehi, do you behold Lanka, situate on the summit of the mount Citrakūta, resembling that of Kailasa and constructed by Viswakarma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-123-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6111003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5d71e3a4dad4a4fac960410869301d260d4edb9a4f72d1810a438c6f77472af0","compact":"8bde5eb5fb0d315271a9cad21d59f8