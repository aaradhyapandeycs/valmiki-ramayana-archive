[{"id":"VRCE-6-66-1","kanda":6,"kandaId":"yuddha","sarga":66,"verse":1,"english":"Beholding Makarākṣa out for battle, those foremost monkeys leaping on a sudden, addressed themselves for fight.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6066001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"93f93181183dd399d76eb050755b39ab8ff27250e1e61aedd47fd13901cc506b","compact":"cf572e2f94ce74fb2ba2f8b51d2c672f23b71dcab4cd8944d6a006d61c0a9af6","nasal":"cf572e2f94ce74fb2ba2f8b51d2c672f23b71dcab4cd8944d6a006d61c0a9af6"}},{"id":"VRCE-6-66-2","kanda":6,"kandaId":"yuddha","sarga":66,"verse":2,"english":"Thereupon ensued a terrible conflict, capable of making one's down stand on end, between the right-rangers and the monkeys like to one between the celestials and Dänavas.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6066002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9f82960be72aa34e421228fcdd8373f8d7c1a6a8ff74c835d7d54d063d06ccc2","compact":"96d44b7a525c266f74c52550e88986119d4dcbaccf4042666df298ed685b7521","nasal":"96d44b7a525c266f74c52550e88986119d4dcbaccf4042666df298ed685b7521"}},{"id":"VRCE-6-66-3","kanda":6,"kandaId":"yuddha","sarga":66,"verse":3,"english":"Those monkeys and night-rangers crushed each other down with trees, darts, maces and parighas.","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6066003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6a5edb1aac305ab373d2461a5bb17b4126aff6889ece33500dbec691aa0df8ae","compact":"46f164e1ad565123824a9bca5babc56ecf2f7110eb1adfda2ca30d183fff98