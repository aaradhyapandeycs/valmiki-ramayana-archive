-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6066009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"935312ce33dbeb36c9705d06b4ec24e1ef02732b6780f88665a5ddf56c3dd401","compact":"18f1e4b9c11aece2a4cba7793cdc7b81c7991c496dd18a4966020df8acbcc45a","nasal":"adcaf9fe0c02c6931c6a7c7a95b038502a725515dd8219013ed937f3110a0ccc"}},{"id":"VRCE-6-66-10","kanda":6,"kandaId":"yuddha","sarga":66,"verse":10,"english":"Stay, O Rama, let us both fight with each other; I shall take your life with sharp arrows discharged off my bow.","alignment":{"type":"1:1","confidence":0.693,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6066010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"789a2e21d750b8d1e659f13e63a1d090207aa3542e4a14835b95cf00a3b9534c","compact":"6f4bff2e916ab06f33c36be7e165650294ad4dbb070257341fc1e36ac079f972","nasal":"cccb953ea66bfd3d9e36fe556b8c7b6a89c7880fa641429bf69bccfe682e60a1"}},{"id":"VRCE-6-66-11","kanda":6,"kandaId":"yuddha","sarga":66,"verse":11,"english":"You did slay my father in the forest of Dandaka. Remembering your action and finding you before, my ire is excited.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6066011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bb35039480d47cb878ab4b3be26ec43e309e7537937a3ec1f0261dacb9ec30a1","compact":"ad90ba9e60a61e9eb724fb326ed703f4eebf1d00fe9f101ebf27dfdefb7888c6","nasal":"4345143f79540a9df13cd6cf6f6e3b501b966b963b486db73d0a30f627475a7c"}},{"id":"VRCE-6-66-12","kanda":6,"kandaId":"yuddha","sarga":66,"verse":12,"english":"O Raghava! O Vicious souled one! My limbs are being burnt (with wrath) for I did not see you then in that mighty forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6066012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c0dd233afd25985fafd76f1827998fb4ea17c9c65f24e7b83770e42b5d824fc","compact":"56d7ba8cc6620f930e5ece37cc5d36867968b592622de1f5768eb95baa1493d0","nasal":"548a36dc5138c51db469b0c694e50dc5fc40dbf1d89f02254f784f252a647f26"}},{"id":"VRCE-6-66-13","kanda":6,"kandaId":"yuddha","sarga":66,"verse":13,"english":"O Rāma, by my good luck, I have got you today, like to a hungry lion desiring to have other animals.","alignment":{"type":"1:1","confidence":0.831,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6066013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"64135e98d4dd99439f8d474d818f9af11cb6659a2c4d121d33d8b99b8b5b4627","compact":"f9d308aead9921c05f20d5f4d3f346eb065648ead23347d268b67be2fd179e5e","nasal":"1317347dd1ac74acc1c25622b3f6b18ced80aa74dab48c37d05dc01f1ca42a7d"}},{"id":"VRCE-6-66-14","kanda":6,"kandaId":"yuddha","sarga":66,"verse":14,"english":"Being despatched by my arrows to the world of devils, you shall live with those heroes, who had been killed by you before.","alignment":{"type":"1:1","confidence":0.492,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6066014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bcd970c34d58956048ad50435b75bfa578de3de848c57ee1e945928cfb56089e","compact":"f1ea46b6b54afe80ae3914adf5fb860d4df40c2a099fd690f3d8c0828be91b48","nasal":"f1ea46b6b54afe80ae3914adf5fb860d4df40c2a099fd690f3d8c0828be91b48"}},{"id":"VRCE-6-66-15","kanda":6,"kandaId":"yuddha","sarga":66,"verse":15,"english":"What is the use of speaking more, O Rāma, do you hear my words. Let all the people behold your as well as my prowess in the battle-field.","alignment":{"type":"1:1","confidence":0.828,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6066015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3d88e0618f7d28e53278b9d565c532ab50aaa5af028ffcf6fc6a5be552da698a","compact":"ee22a2d3820cd05fe92d36cd453a870936a53325cfa3194f001c78e63049014b","nasal":"89d8f2bfbe271009b35ee5895a1c215a51c0785d2c9a744aec2547eb67368468"}},{"id":"VRCE-6-66-16","kanda":6,"kandaId":"yuddha","sarga":66,"verse":16,"english":"Either with weapon or with clubs, in whatever you are expert, do you fight .with me in the battle-field, O Rāma.","alignment":{"type":"1:1","confidence":0.541,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6066016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f44cd3c31efe47750a8bfd2f2734e1f7c29b1a715475f8f8483291628a0fb07e","compact":"1b30bc1e37de400b6acb2bd96205e8107bf01bfae01798c8c6df905c0ff265ea","nasal":"1b30bc1e37de400b6acb2bd96205e8107bf01bfae01798c8c6df905c0ff265ea"}},{"id":"VRCE-6-66-17","kanda":6,"kandaId":"yuddha","sarga":66,"verse":17,"english":"Hearing the words of Makarākşa, Rāma, Dasaratha's son, smiling, replied to the words of the babbler.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6066017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ac65f46c16bbeff1de9af74f1d276cc07dd30e7684853ce611f37b8768cecc5","compact":"384e66506b9868da04edef07e5a275cefc3d8f2be98f05ef2213c0b89f761580","nasal":"384e66506b9868da04edef07e5a275cefc3d8f2be98f05ef2213c0b89f761580"}},{"id":"VRCE-6-66-18","kanda":6,"kandaId":"yuddha","sarga":66,"verse":18,"english":"I slew in the forest of Dandaka your father with fourteen thousand Räksasas, Trisira and Duşana. O vile one, you being slain to day, with your flesh, vultures and crows, having sharp beaks and nails, and jackals shall be satisfied.* [*Here is another śloka, which is to be found in all N.W.P. texts and in one or two texts published in Bengal-but it has been omitted by many for it conveys the same meaning as the previous ſloka; the meaning is-And the birds drinking your blood shall fly away to various quarters.]","alignment":{"type":"grouped","confidence":0.593,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6066018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"963010da8824c16f0efefb02a3316f47145aaf6ac7103c42d897dd2ddd9966d6","compact":"39108875b9d0c855680f1a4a7a427f6047c4b72137c1c611d5f331d27acd9ed4","nasal":"358d7c11c3b5b8974cc31cb8e193d8aee132dae5cb75c8a1685a5890102f93fd"}},{"id":"VRCE-6-66-19","kanda":6,"kandaId":"yuddha","sarga":66,"verse":19,"english":"I slew in the forest of Dandaka your father with fourteen thousand Räksasas, Trisira and Duşana. O vile one, you being slain to day, with your flesh, vultures and crows, having sharp beaks and nails, and jackals shall be satisfied.* [*Here is another śloka, which is to be found in all N.W.P. texts and in one or two texts published in Bengal-but it has been omitted by many for it conveys the same meaning as the previous ſloka; the meaning is-And the birds drinking your blood shall fly away to various quarters.]","alignment":{"type":"grouped","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-79-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6066019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17b12a44c8f0757982eeba7e9b9aefae4bf7812c791d77688fd756d798879f74","compact":"4db090f588bf71a330d2760e011073b2752ef9db013c4ff7e03e52aa8a68be24","nasal":"40cc5f1d2e4