[{"id":"VRCE-6-107-1","kanda":6,"kandaId":"yuddha","sarga":107,"verse":1,"english":"Hearing those excellent words uttered by Raghava, Mahesvara (Siva) spoke far more important words.","alignment":{"type":"1:1","confidence":0.705,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-119-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6107001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"76d744629912e41730fc346c29fe610e578690789e4c88ff692742add4b23636","compact":"7b008f82c68faf14d2a89595beedaceab0d8c88f1b682a7448afd0ba371319d1","nasal":"7b008f82c68faf14d2a89595beedaceab0d8c88f1b682a7448afd0ba371319d1"}},{"id":"VRCE-6-107-2","kanda":6,"kandaId":"yuddha","sarga":107,"verse":2,"english":"O you having lotus-eyes, O you having huge arms and a spacious breast, O you the slayer of enemies, O you the foremost of the pious-it is a good fortune that this has been done by you.","alignment":{"type":"1:1","confidence":0.783,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-119-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6107002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"08951f24685752e03de1166671f01cb50122b5e10458004adf5f8fd3c1caf34e","compact":"f9abcf8c1d58ceb9430e31af9ee791b563b5139002c48f0bca4aa9aa385603fd","nasal":"f9abcf8c1d58ceb9430e31af9ee791b563b5139002c48f0bca4aa9aa385603fd"}},{"id":"VRCE-6-107-3","kanda":6,"kandaId":"yuddha","sarga":107,"verse":3,"english":"It is by good fortune, O Rama, the dreadful Rāghava, has been removed by you in the encounter.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-119-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6107003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3dd1c864224b1ed5fc292bbee922dd3445cf4fc947e02310a6c4cfd69eef1baf","compact":"fb34dc249a35f551905204f328201fab58dae739027d2f4fc1