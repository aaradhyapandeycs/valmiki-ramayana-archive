[{"id":"VRCE-6-92-1","kanda":6,"kandaId":"yuddha","sarga":92,"verse":1,"english":"On being greatly harassed by Käkutstha in anger, Ravana, delighting in battle, came under the sway of a towering passion.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-103-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6092001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ffe1d79a059af741e54dc7a2787a9adaa40f9eb8ca63540b04257f93b7751ca","compact":"9232fd27b38f4f76caa1e660915dbfd52ecfd5cfe40b13265ea739d29b265067","nasal":"9232fd27b38f4f76caa1e660915dbfd52ecfd5cfe40b13265ea739d29b265067"}},{"id":"VRCE-6-92-2","kanda":6,"kandaId":"yuddha","sarga":92,"verse":2,"english":"And with his eyes aglow, that powerful one from wrath and fury assailed Raghava in mighty encounter.","alignment":{"type":"1:1","confidence":0.557,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-103-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6092002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"56c40f62555d3c68967d8b87695b8e2f0997adf47d99defe36b6216b4ddcffe2","compact":"9f85d3cb72420bf787345116834b0b3527d95e10b755b8e058fe9da06f8be570","nasal":"9f85d3cb72420bf787345116834b0b3527d95e10b755b8e058fe9da06f8be570"}},{"id":"VRCE-6-92-3","kanda":6,"kandaId":"yuddha","sarga":92,"verse":3,"english":"And even as clouds pour down from the sky on a pool, Råvaņa showered thousands of arrows of Rāghava.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-103-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6092003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19e2108b888f0797f91e74aad8b450dc99845deab9270588b22f6f915f1cdc08","compact":"f7faaf01c81d24bcbc29afd4f955891729cc1f08367348cbb93fdfaf6b3f42d8","nasal":"2d8be8286dfef27a8045dd3f2131b174bfe322b529785f42e3726915a1d7a666"}},{"id":"VRCE-6-92-4","kanda":6,"kandaId":"yuddha","sarga":92,"verse":4,"english":"And covered with vollies of shafts discharged from (Ravana's) bow in the conflict, Kākutstha like to a mighty mountain did not shake.","alignment":{"type":"1:1","confidence":0.883,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-103-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6092004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"12aeee11069e77931692b419586a4fa29d451db5a940734cac2ff46045a130d5","compact":"2f9d7104841b479d170899054a831fead89ac8971635bccab6f56e2ae20d4f87","nasal":"b443e916cdd21894ff8fbee8c5d3de58852c3d9276a461d63b1407c99bb5672f"}},{"id":"VRCE-6-92-5","kanda":6,"kandaId":"yuddha","sarga":92,"verse":5,"english":"That one endowed with prowess stood in the field, resisting those networks of arrows, and took up shafts resembling the rays of the Sun.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-103-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6092005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f2bbe79cb79c1f33723a1267e2e7c60938c0b590394fc937479d8da53434e98e","compact":"9d2392fa1a7b8214f077f823e23a065c814de066379c82ef7202cf616528d4e0","nasal":"9d2392fa1a7b8214f077f823e23a065c814de066379c82ef7202cf616528d4e0"}},{"id":"VRCE-6-92-6","kanda":6,"kandaId":"yuddha","sarga":92,"verse":6,"english":"Then the fleet-handed night-ranger, fired with rage, discharged a thousand arrows at the chest of the high souled Raghava.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-103-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6092006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b175006a4261f6e05400843ac6aeb5e9b198b3b5c8bc448a8b7d8f65599ccfc0","compact":"de01c09c42cdfa