":0.971,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-46-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6036014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"190271b78f3acfc196bfc0dbdbdff2b26137d4f542fb9e0eebeba6fea4f57fdd","compact":"447ed53fd691497e379e84c0922ff7b6bb23321d52cd169b9b179d111bfb42f7","nasal":"286219173965e50fde0665be360873e706c869c6f441a992f8923ba1183dbfd4"}},{"id":"VRCE-6-36-15","kanda":6,"kandaId":"yuddha","sarga":36,"verse":15,"english":"He for whom my father was exercise with anxiety and tormented by grief, for whom my sire used to spend nights without pressing his bed, for whom this entire Lankā had resembled a river turbulent in the rainy reason, that same evil sticking by the root of all, has been dispensed his quietus by me.","alignment":{"type":"grouped","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-46-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6036015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dcc0778fbcf1b58ea3bda6f7b384e7c12ad80b1b3b1c1fb92397e94b4b16d2e1","compact":"6ed7e771213cc1a442eb5fe8a24b6976245e4967bb74a7a4cda31535e28b7e7b","nasal":"2c0443c4598875a3c8e36bdf6d747e319e5dacd3df9b26d3a97830b60baa7f28"}},{"id":"VRCE-6-36-16","kanda":6,"kandaId":"yuddha","sarga":36,"verse":16,"english":"And like clouds of autumn, the prowess of Råma and Laksmana as well as that of all the rangers of the woods, has been rendered useless.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-46-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6036016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"793fc56404c408d0f8ce1c9c4c3b6374be0bf9bdeb8ebb1724722e10d6be250e","compact":"f8ec4e895c72e1dfa90805da7677f9b93bfdacc2231812b92747736647138256","nasal":"f8ec4e895c72e1dfa90805da7677f9b93bfdacc2231812b92747736647138256"}},{"id":"VRCE-6-36-17","kanda":6,"kandaId":"yuddha","sarga":36,"verse":17,"english":"Saying this in the presence of all the Raksasas, Ravana's son-destroyer of foesfencing the monkey-leaders, hit Nila with nine arrows, and hurt Mainda and Dvivida each with three powerful shafts.","alignment":{"type":"1:1","confidence":0.301,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-46-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6036017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e7a27f342e54abc0e9846a3d72e5a1104eca6329437f907fb55947feb3b32552","compact":"dec956eca77f53662e914141ed1af97d779fbea6793f4d159bbcba6561fd6cdc","nasal":"dec956eca77f53662e914141ed1af97d779fbea6793f4d159bbcba6561fd6cdc"}},{"id":"VRCE-6-36-18","kanda":6,"kandaId":"yuddha","sarga":36,"verse":18,"english":"And tormenting the monkeys with volleys of shafts and striking terror into them, that mightyarmed one. bursting out into a laugh, said.","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-46-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6036018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4bc71bc36e03b9523ac1edf2da2f4112b2663fdbe92a67e0404a996cf7c0f755","compact":"5168d4d32a9f8c2c10fd28a70ec8b18545daa27a6c1ac5b0af296d24dd5884bd","nasal":"5168d4d32a9f8c2c10fd28a70ec8b18545daa27a6c1ac5b0af296d24dd5884bd"}},{"id":"VRCE-6-36-19","kanda":6,"kandaId":"yuddha","sarga":36,"verse":19,"english":"“Let the Raksasas behold these brothers lying fast bound with dreadful arrows in front of the forces.\"","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-46-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6036019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a8d0f0796e0a80a3a69c810a99458b2adaa02bf8264b6