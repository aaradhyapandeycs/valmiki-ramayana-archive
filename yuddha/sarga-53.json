uttRefs":["DUTT-6-65-17","DUTT-6-65-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6053015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"618a450ddc594f72270b965084268ea350b952e04d1a20897c7e3167a7feb1da","compact":"bb643066f6a1fe935669e5a9b5264ef974e7ca16aa01968ebe356bb0bf56f549","nasal":"bb643066f6a1fe935669e5a9b5264ef974e7ca16aa01968ebe356bb0bf56f549"}},{"id":"VRCE-6-53-16","kanda":6,"kandaId":"yuddha","sarga":53,"verse":16,"english":"Today hungry and enraged, I shall devour up the monkeys. Hearing Kumbhakarma's words. Rāvana said. Go you surrounded by the forces bearing darts and maces in their hands. The monkeys are highsouled, heroic and well-skilled in battle; and if they find you alone or unwary, they may slay you with their teeth, Therefore do you exceedingly irresistible, go, environed by the forces; and destroy the entire party of the foes, who are bent upon doing harm to the Rākşasa.","alignment":{"type":"split","confidence":0.477,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-18","DUTT-6-65-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6053016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7e982140b847ce72683491bedf8c7b300b0da1bdc5672f98d331dd2b1f64e633","compact":"aff6290b076fdafc852ef2600be23279d503675b2dfa4c88ab596df464a47e0b","nasal":"2c74bb38474eb7bb6d1c0ee0b43be057bd73c62e7882ecc7248584bff1e43862"}},{"id":"VRCE-6-53-17","kanda":6,"kandaId":"yuddha","sarga":53,"verse":17,"english":"Go you surrounded by the forces bearing darts and maces in their hands. The monkeys are highsouled, heroic and well-skilled in battle; and if they find you alone or unwary, they may slay you with their teeth, Therefore do you exceedingly irresistible, go, environed by the forces; and destroy the entire party of the foes, who are bent upon doing harm to the Rākşasa.","alignment":{"type":"grouped","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6053017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77b386447037ee113e915df89027bed34a92b57217380f87cc19e5ad50e3c88b","compact":"ab93ac7db8c2f94a3e5c08ed6aa859f5cd7f1c0269b38a2e9d1f8b486ef8efcf","nasal":"ab93ac7db8c2f94a3e5c08ed6aa859f5cd7f1c0269b38a2e9d1f8b486ef8efcf"}},{"id":"VRCE-6-53-18","kanda":6,"kandaId":"yuddha","sarga":53,"verse":18,"english":"Go you surrounded by the forces bearing darts and maces in their hands. The monkeys are highsouled, heroic and well-skilled in battle; and if they find you alone or unwary, they may slay you with their teeth, Therefore do you exceedingly irresistible, go, environed by the forces; and destroy the entire party of the foes, who are bent upon doing harm to the Rākşasa.","alignment":{"type":"grouped","confidence":0.921,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6053018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b9691672f1e2fd50d3f2b95f1b4e03fa8c76967ff8d4c2c6335a403719e6ed3","compact":"96903b2e918a44d54b9bdae5251096a58e6177dc1986444acfc6aa2d21b5ec0b","nasal":"96903b2e918a44d54b9bdae5251096a58e6177dc1986444acfc6aa2d21b5ec0b"}},{"id":"VRCE-6-53-19","kanda":6,"kandaId":"yuddha","sarga":53,"verse":19,"english":"Then starting up form his seat, the exceedingly energetic Rāvana hung on Kumbhakarņa's neck a wreath stringed with gems in the centre.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6053019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"410240348ffba7ad414caaf4daf18915686dd62bc3a98f0385abcdee3d9336f5","compact":"4ca15cd7960c92fd7deb5366e209a178dd815b9a20dab5fb4eb14438052b82f3","nasal":