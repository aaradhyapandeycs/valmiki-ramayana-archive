ngram","duttRefs":["DUTT-6-65-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6053022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77ab866f5126417bad27726e3c0d077d44daf4de17252acad5c444b83bf93f4f","compact":"961478e537b799a7e717a25f4e2069a9b30eb7422395f1dbc58748cc2e8c3f03","nasal":"8f06d6ed4b460334a30d4294f95ed910df3eb4efbcabe58d767f332b6a8afeec"}},{"id":"VRCE-6-53-23","kanda":6,"kandaId":"yuddha","sarga":53,"verse":23,"english":"With his great dark girdle he seemed like the Mandara fastened by the serpent on the occasion of the churning of the sea.","alignment":{"type":"1:1","confidence":0.643,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6053023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2143d21e5eb225bed9bf376ddd6400160c7b12d847bdb04f80e9318f048caa02","compact":"3dd02c4650528369354e758f527763237e298e611c2a5e21a772eac8e567d7a8","nasal":"4c2c25dc4893c15c60c84013a18100027bf5a465f07a16fb2bd3e49038272669"}},{"id":"VRCE-6-53-24","kanda":6,"kandaId":"yuddha","sarga":53,"verse":24,"english":"Donning on his impenetrable golden mail, splendid like lightning, and shining in its own brilliance, Kumbhakarņa appeared like the monarch of mountains enveloped with evening clouds.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6053024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1706247faf21c2097cf2503e18089b7e23fd34721f5ef3555045b5ef201ca387","compact":"57ab56281adf9bc52c60dfde4b64548cdb1329871cb0b32f3286dfb6e87f6a1b","nasal":"b9dfc877acab83b03399935308e0dc7430b79bb22f886c738e9b2f410ef6d383"}},{"id":"VRCE-6-53-25","kanda":6,"kandaId":"yuddha","sarga":53,"verse":25,"english":"Having all his limbs adorned with ornaments and bearing a dart in his hand, the Rakşasas resembled Nārāyaṇa in elation of spirits, when he covered heaven and earth and the nether regions with three paces.","alignment":{"type":"1:1","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6053025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c26cddd03a5e5ab2b362daa9a280c642224ebcca04810e5b761150e300b6334","compact":"01540cf5dd77c35b921a762feb274deb7d9f76d17196c8727e13aa0732e2c5c4","nasal":"feb9da4fd0ba96c1b47793339b4b6be311e4bfb8d27408e923394f0a96835e99"}},{"id":"VRCE-6-53-26","kanda":6,"kandaId":"yuddha","sarga":53,"verse":26,"english":"Then embracing his brother and going round him and bowing down the head to him, that exceedingly powerful one went out.","alignment":{"type":"1:1","confidence":0.49,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6053026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6545554d5bd8e744d8eac8141a724e4fac00a1b409676c5f41a371d7427e0225","compact":"31ed7592b28db8db2a18c6adc063fa527b94b586bd5d9e71cd78115430479f4e","nasal":"6de09baa64e41d5f6f48694d06df1703b613a67f162c20ec3a2e8c0b01e155c9"}},{"id":"VRCE-6-53-27","kanda":6,"kandaId":"yuddha","sarga":53,"verse":27,"english":"Rāvana sent him with choice benedictions, while he caused kettle-drums and conchs to be sounded and force equipped with excellent weapons, to accompany Kumbhakarņa. And high-souled mighty warriors followed that foremost of heroes with elephant and steeds and chariots sending out rattle resembling the rumbling of thunder.","alignment":{"type":"split","confidence":0.546,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-27","DUTT-6-65-28"],"status":"unreviewed"},"source":{"sanskritLocator":"6053027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4e6d02311bb627344a1c2812114dff8e147233ec1b8cd6e2ac089a72f3797d54","compact":"e9e96087aa10b4752663cd6bba507c05497f88f9d0a072b53c34075355d35df3","nasal":"6b1220a645abc30e2dedd3a38d0da0b8279978eca48653106ef01fe172cd7d16"}},{"id":"VRCE-6-53-28","kanda":6,"kandaId":"yuddha","sarga":53,"verse":28,"english":"And mounting serpents and camels and asses and lions and leopards and deer and birds, (Rāks asas) followed the grim Kumbhakarņa endowed with tremendous strength.","alignment":{"type":"1:1","confidence":0.551,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-29"],"status":"unreviewed"},"source":{"sanskritLocator":"6053028","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b919a8d611df88a6313456c5a776ea2142ab05da8b46324df3c7c2c38b13e3fb","compact":"92d7286ed6dee9c99c447396af12864005820b780c381699cdb08624eeeb547e","nasal":"9cb3ad9843f216e3c4545417931f4c9e586e9c8595e967371345c08e71707c36"}},{"id":"VRCE-6-53-29","kanda":6,"kandaId":"yuddha","sarga":53,"verse":29,"english":"And strewn with blossoms, and, with an umbrella held over him, that exceedingly terrible enemy of the Deities and the Dănvas, wielding a dz.: in his hand-went out maddened with the smell of blood.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-30"],"status":"unreviewed"},"source":{"sanskritLocator":"6053029","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cfa28ec5d74829c5a410e7ce04296da45d39d1e09e62686303f0144171c6124f","compact":"1b606d03d68a6130e3d5452b72eb1b1ab325d3c7e3e7c4862bffad739a7bc28a","nasal":"c96c6a3816fb0fb2873335a30fe5e9ae0c6a4673a32575b020975cbde7e833ef"}},{"id":"VRCE-6-53-30","kanda":6,"kandaId":"yuddha","sarga":53,"verse":30,"english":"Countless footmen wondrous powerful and mighty and dreadful and fierce-sighted Räksasas, carrying weapons in their hands, went in his wake.","alignment":{"type":"1:1","confidence":0.704,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-31"],"status":"unreviewed"},"source":{"sanskritLocator":"6053030","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fd8c3df71eff7c77c086de01ac7b639d9c8ea416f92ce4b8cabf35eff5e5d8b3","compact":"a0b687cd606fbce2b36ce2fd51448dcb3363473c5fc74055534923971a96406e","nasal":"a0b687cd606fbce2b36ce2fd51448dcb3363473c5fc74055534923971a96406e"}},{"id":"VRCE-6-53-31","kanda":6,"kandaId":"yuddha","sarga":53,"verse":31,"english":"The Räkşasa measuring each many a vyama and red, eyed, and resembling masses of darkblue collyrium, went out upraising darts and swords and sharpened axes and bhindipälas and parighas and maces and huge talaskandhas and irrisistible Kșepaņis.","alignment":{"type":"grouped","confidence":0.567,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-32"],"status":"unreviewed"},"source":{"sanskritLocator":"6053031","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"346022b0fa1333768383fc7a3e4898aea3d5efc8fcafd23e924f7451d3a8afd4","compact":"f680473115b0b24f05edfb292ec5cfd083ac921b02e314a70ece403c410813f5","nasal":"375ad6b1cc1405feff9204bb2627474f8418a8bd3332034e7400e7a98050263f"}},{"id":"VRCE-6-53-32","kanda":6,"kandaId":"yuddha","sarga":53,"verse":32,"english":"The Räkşasa measuring each many a vyama and red, eyed, and resembling masses of darkblue collyrium, went out upraising darts and swords and sharpened axes and bhindipälas and parighas and maces and huge talaskandhas and irrisistible Kșepaņis.","alignment":{"type":"grouped","confidence":0.487,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-65-32"],"status":"unreviewed"},"source":{"sanskritLocator":"6053032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e7cd1875e60bf2690e54d64713bec719310fb8a2d02685eb401eef7254c438da","compact":"9eeb23f100bfafaf0ae07fdd3699cead04789388cd844efc4ec1df8c844b