06","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"234da4eb48fd470ba58e1b1d4e54f52ca8b6c5ea9b37893ca4c58fbf3015b14c","compact":"427fdd1dc020d301edee56e526abb840188eae152ac768ee1ce07f2a64196b9e","nasal":"f466448051bac3e8cfd747c031cc9aaec50dfb5eb9ae661256923c95ec7aa1f0"}},{"id":"VRCE-6-81-7","kanda":6,"kandaId":"yuddha","sarga":81,"verse":7,"english":"Thus on the eve of sun set there arose a terrible conflict between the Rakşasas and the monkeys.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6081007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2215c5b19f892be94f51a19fe0e18e48835b0b743933a6ed4d41f304ffdcbad8","compact":"f97b6cf00470f13429c1be64e94d0d3d677a0a5ec89e638414a5339906cd2036","nasal":"f97b6cf00470f13429c1be64e94d0d3d677a0a5ec89e638414a5339906cd2036"}},{"id":"VRCE-6-81-8","kanda":6,"kandaId":"yuddha","sarga":81,"verse":8,"english":"They struck each other in the conflict with clubs chitras, Prasas daggers and Parasvadha.","alignment":{"type":"1:1","confidence":0.725,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6081008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a98979578eeab50a3a7c07e22f9be4981fb22723f2513e3e745c4e909768dc44","compact":"bee7fb90cca4fe082fdc4e8845a327b7a89e9c6db69dd8d8c5b8e407bd88adff","nasal":"bee7fb90cca4fe082fdc4e8845a327b7a89e9c6db69dd8d8c5b8e407bd88adff"}},{"id":"VRCE-6-81-9","kanda":6,"kandaId":"yuddha","sarga":81,"verse":9,"english":"Elephants and cars were like the banks of that river of blood, the arrows were like the fishes, and the flags were the trees on their banks and the corpses were like planks afloat there.","alignment":{"type":"1:1","confidence":0.483,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6081009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aaebccce795617cf99a1a8a28f4b316a85138226a9fe574ab0a499b720438570","compact":"04d811a38acacb7d637e61407d45d502187055b85f054c4a4311d39efdc4ec0a","nasal":"04d811a38acacb7d637e61407d45d502187055b85f054c4a4311d39efdc4ec0a"}},{"id":"VRCE-6-81-10","kanda":6,"kandaId":"yuddha","sarga":81,"verse":10,"english":"Being thus wounded and assailed by the Rākşasas, those heroic monkeys leaped and broke down the flags, armours, cars, horses and other weapons.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6081010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"335aabd0a3a5f239e37cc102bcf43f79857403af04db860fa029489821a90120","compact":"1bc4338a294365ceda94b60cc64edc94a42179961fd3cd7d87c2081a41af828f","nasal":"4a699f26198e673d60482dd4ae326394488ab4ad43ffe4e8b26d0d7e17e48a33"}},{"id":"VRCE-6-81-11","kanda":6,"kandaId":"yuddha","sarga":81,"verse":11,"english":"With their sharp teeth and nails they scratched the hair, ears, foreheads and the noses of the Raksasas.","alignment":{"type":"1:1","confidence":0.847,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6081011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1dcbfa5114d876b71e87d7787533c021090cc21d0c9bf62faaa777adea9e0e08","compact":"ae42418e15ca90e23c2eb6ae2f9c202c88847e8dc3d548972fd8a066c743e93a","nasal":"ae42418e15ca90e23c2eb6ae2f9c202c88847e8dc3d548972fd8a066c743e93a"}},{"id":"VRCE-6-81-12","kanda":6,"kandaId":"yuddha","sarga":81,"verse":12,"english":"Like to vultures falling upon a felled tree, hundreds of monkeys fell upon one Räkşasas in that encounter.","alignment":{"type":"1:1","confidence":0.655,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6081012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5d68c435c24236086785061bed6429703996fd0f13d2af772e36b2f0633422b0","compact":"b857011d5f120754320872ae1ef54bc5f9635f73caa62d94cba8bc792213cdca","nasal":"65ad67da4dbd09d4a1bab4723ef9d73762d433041ea22e57c7112ba8a3578e3d"}},{"id":"VRCE-6-81-13","kanda":6,"kandaId":"yuddha","sarga":81,"verse":13,"english":"The Rákşasas resembling mountains, with huge clubs, prasas, daggers and Parasvādhas, struck the monkeys (in their turn).","alignment":{"type":"1:1","confidence":0.747,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6081013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1190c2f74ce0852f90635a5461d8ad6622465845de450a454f95df7135383421","compact":"bb70bd352e23c064273498754409b0dadcc2b82c85289d5b3e112ead7de2e280","nasal":"bb70bd352e23c064273498754409b0dadcc2b82c85289d5b3e112ead7de2e280"}},{"id":"VRCE-6-81-14","kanda":6,"kandaId":"yuddha","sarga":81,"verse":14,"english":"Being thus assailed by the Räkşasas, the mighty host of monkeys took refuge of Răma, the son of Dasaratha, the worthy refuge of all creatures.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6081014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b9a5de20beda338a7c76399d733540057929392260c5a952de49298ea342880e","compact":"4c2a60ad969918e76f5db1a180f32435877f638221baf10b83cfe2f16b721571","nasal":"4c2a60ad969918e76f5db1a180f32435877f638221baf10b83cfe2f16b721571"}},{"id":"VRCE-6-81-15","kanda":6,"kandaId":"yuddha","sarga":81,"verse":15,"english":"Thereupon the highly effulgent and powerful Rāma, taking up his bow, entered the Rākşasa host and began to make a downpour of arrows.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6081015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"69fba7f887dbfdeb9eb365f850ea0571a44782f49ceb2b7ca606c4de294928db","compact":"395c2075a5359cea1c3c63da4f43f9d9e1bff3e52da3c7e63b27773620d8b270","nasal":"395c2075a5359cea1c3c63da4f43f9d9e1bff3e52da3c7e63b27773620d8b270"}},{"id":"VRCE-6-81-16","kanda":6,"kandaId":"yuddha","sarga":81,"verse":16,"english":"Rama entering the field, those terrible Rakş asas, being burnt with the fire of his arrows, could not stand before him like to clouds disappearing before the Sun in the welkin.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6081016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c15e3cc4833ccecf8bb82d6a5df3281cbab2a1fa6e8612e01ec5c6312fa07903","compact":"331ac7baed8b2ead2d1e8c555c8cb53f26684e3fc3ec57cb2f764213bbf81925","nasal":"aba094e942e6ef5a851cc3addee3f8c6609662a6a1e76a58ba63ae1a2acc6006"}},{"id":"VRCE-6-81-17","kanda":6,"kandaId":"yuddha","sarga":81,"verse":17,"english":"The night-rangers only espied the dreadful feats performed by Råma and which were above the power of others.","alignment":{"type":"1:1","confidence":0.907,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6081017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"23e6c50192de6c69c909c8b30e07a81b3c08b2ac317df3f21e1c90abc2f8be55","compact":"11137ef3a402ef8aeea554c02ad2b22849b4c0e724cbddc6718f08f7c38d859e","nasal":"11137ef3a402ef8aeea554c02ad2b22849b4c0e724cbddc6718f08f7c38d859e"}},{"id":"VRCE-6-81-18","kanda":6,"kandaId":"yuddha","sarga":81,"verse":18,"english":"Except when guiding the huge army or driving the cars they could not see Rama like to the wind invisible in a forest.","alignment":{"type":"1:1","confidence":0.808,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6081018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d8ae3da400b06ecca980cbcae6b8c63073decb55589147102dd95ce0a38b91a1","compact":"5fb1f96fd65464b565b8b2fe43606622c6895d07f3c0e4751648a58cc7cb3982","nasal":"ba0f76d172860db3430dfcecac0f9670ed99b0495f688c271fe5d6cb3ccbdefb"}},{"id":"VRCE-6-81-19","kanda":6,"kandaId":"yuddha","sarga":81,"verse":19,"english":"The all beheld the Råkşasas force scattered, wounded, burnt down with arrows, broken and assailed with weapons by Rāma But none could see the quick moving Rāma.","alignment":{"type":"1:1","confidence":0.896,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6081019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d5f86a6e1f139df6fd33b26a465804f7743e941377c33fa3ded3174ad5038cb9","compact":"0848f4c86fef641becb5a73c6f762bd0ed0275a6e35e8087cb54689ef7588531","nasal":"da7066010a1df4e3eae9c39a07fa0d46a0a3bbf1c85ea4167f10b5a76edf0d42"}},{"id":"VRCE-6-81-20","kanda":6,"kandaId":"yuddha","sarga":81,"verse":20,"english":"As people cannot see the soul which governs all objects of sense so they could not see Rāma, who was thus inflicting wounds on them.","alignment":{"type":"1:1","confidence":0.897,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6081020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"db8192b1fe976182bc73d6e3e281cc985841e88d1b69907eec78ddab9c0f94e7","compact":"6a80af29f646a