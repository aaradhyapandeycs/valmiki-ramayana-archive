[{"id":"VRCE-6-81-1","kanda":6,"kandaId":"yuddha","sarga":81,"verse":1,"english":"Entering his court, the king, distressed, and exceeding aggrieved sat him down on the foremost seat sighing like an enraged lion.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6081001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9779084ff6afb39254cd0609376d8b535bbbccf69c933c8d9beedd6576674acc","compact":"f263b5ff71c80e0fe691c12bdf03bf6b55f52d6227889a5c1932d57c34fc7500","nasal":"f263b5ff71c80e0fe691c12bdf03bf6b55f52d6227889a5c1932d57c34fc7500"}},{"id":"VRCE-6-81-2","kanda":6,"kandaId":"yuddha","sarga":81,"verse":2,"english":"And stricken with grief in consequence of his son's death, that highly powerful Ravana, with folded hands, addressed all the heroic Rākşasas saying.","alignment":{"type":"1:1","confidence":0.716,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6081002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7aa35ad17852f4d6fc02ea3086659f2a0678b2bdeb99ba80e1f0452ce7ae08ee","compact":"90b0fe7c818dd2499c169e17071678664e1e48184d61087d151ad07c65bfcacd","nasal":"79218b6bae960fb57085a5e4329f3f29ad2e4a844ad7b65ad7da5fe9af6176ad"}},{"id":"VRCE-6-81-3","kanda":6,"kandaId":"yuddha","sarga":81,"verse":3,"english":"Do you all proceed to battle with elephants, horses and cars. And encircling Rāma only and discharging shafts at him, delightedly, like to clouds, in the rainy season, poring water, do you slay him.","alignment":{"type":"grouped","confidence":0.652,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-93-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6081003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb06d6c9c518306569ed06f482f58fe3daa