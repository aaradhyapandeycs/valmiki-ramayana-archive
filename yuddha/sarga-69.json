 1891–94"},"sanskrit_fingerprints":{"exact":"80ca552d78343908691064768fa79893d6f0a7e3a87c5f31e376479852c080d8","compact":"b2222c863f48df8226130e034f1bd545e6f358b393dcb9dbf90a19844be7d99c","nasal":"b2222c863f48df8226130e034f1bd545e6f358b393dcb9dbf90a19844be7d99c"}},{"id":"VRCE-6-69-10","kanda":6,"kandaId":"yuddha","sarga":69,"verse":10,"english":"Beholding that crag about to fall down on the car, the charioteer moved his horses and it was speedily brought at some distance.","alignment":{"type":"1:1","confidence":0.544,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-82-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6069010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c03e85f55d80cb6b83e1d8dab7b4ebab696d7631077d137e50b63561ec0e3b68","compact":"fd49bdd43b82b9e1ec540176587305bf18146937da75e1955ede1fd2b65b2c57","nasal":"58913a06fb9845342d868a85766842e214fa4000735318ed8bdb084681663fcb"}},{"id":"VRCE-6-69-11","kanda":6,"kandaId":"yuddha","sarga":69,"verse":11,"english":"And not reaching Indrajit stationed on the car and the charioteer, that crag, uselessly hurled, fell down on the earth.","alignment":{"type":"1:1","confidence":0.694,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-82-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6069011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e9791dd9f811cddaa257c5141610cb103259f3dbac905900a1dc77040e43ef4d","compact":"f732aaa8dbc468d46fedf0bd00b05c1ef21221256091c2dbc49c284613b1f237","nasal":"2a4dfde381b5305ce1bd7d9991271b65199a9760681312affb717df5f85c2bcd"}},{"id":"VRCE-6-69-12","kanda":6,"kandaId":"yuddha","sarga":69,"verse":12,"english":"Thereupon hundreds of huge-bodied monkeys, emitting cries and taking up crags and trees proceeded towards him (Indrajit) and hurled them at him.","alignment":{"type":"approximate","confidence":0.214,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-82-13"],"