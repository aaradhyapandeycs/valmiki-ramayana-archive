[{"id":"VRCE-6-69-1","kanda":6,"kandaId":"yuddha","sarga":69,"verse":1,"english":"Hearing that dreadful uproar resembling the sound of Indra's thunder-bolt, the monkeys, casting their looks on all sides fled away.","alignment":{"type":"1:1","confidence":0.614,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-82-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6069001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5cfb0cb6434a70463af4f2906e0ff35456d7de1088b7d602a5594010021e09cc","compact":"aaee96c7a10e116b8ae0d92c347c0b194274617b04a371c52ad3983c6246a829","nasal":"aaee96c7a10e116b8ae0d92c347c0b194274617b04a371c52ad3983c6246a829"}},{"id":"VRCE-6-69-2","kanda":6,"kandaId":"yuddha","sarga":69,"verse":2,"english":"Thereupon Hanumān, the son of Maruta, spoke to them, poorly, terrified and of a sorrowful countenance, saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-82-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6069002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d03680795a3396abbe08ef1b0dc9578ad6fc23d7436f1fb8fe1f6fb7a46c2f89","compact":"475e0db2ca3206ba996e9956c42c8a333cad107fe608836fad6eed3c7a175eb0","nasal":"aa05631f19c2aa81181c60d8ae55375725be888036f2e11479161e739fb430ee"}},{"id":"VRCE-6-69-3","kanda":6,"kandaId":"yuddha","sarga":69,"verse":3,"english":"O monkeys, why do you look so melancholy and why are you flying away? Why have you renounced your earnest desire for fight? And where is your heroism gone?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-82-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6069003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"736790c544f99c71e470add9917b1a728dfb46283c6f3c2cd5dfe715224b38e0","compact":"1527b9e489616ded0a713563b41c569095437035182