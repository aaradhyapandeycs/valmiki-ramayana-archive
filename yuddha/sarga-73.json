DUTT-6-86-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6073017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c06297ace03d8ded568a6763f46e5c9497729625999477565f79896b6e7e2658","compact":"0404ef1bb45ee36dc75e7a4af9de535a181b2d1b6c7ced8025030c2b1aa2eaa4","nasal":"0404ef1bb45ee36dc75e7a4af9de535a181b2d1b6c7ced8025030c2b1aa2eaa4"}},{"id":"VRCE-6-73-18","kanda":6,"kandaId":"yuddha","sarga":73,"verse":18,"english":"In that encounter, the monkey, consuming (the forces) like the fire risen at Doomsday, made that army of Rākşasas insensible with innumerable trees.","alignment":{"type":"1:1","confidence":0.826,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-86-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6073018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b6db38a78f43dbab8652558e2ad83e57057000f7b64d2bb204299f20524c2ec2","compact":"421076b99539a038af32b5d5054922ea94880790013b30836305fe45da66e2fe","nasal":"421076b99539a038af32b5d5054922ea94880790013b30836305fe45da66e2fe"}},{"id":"VRCE-6-73-19","kanda":6,"kandaId":"yuddha","sarga":73,"verse":19,"english":"Finding the Wind-god's son, Hanumān, suddenly spreading devastation among the Rāks asas by thousands, (they) showered (shafts) on him.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-86-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6073019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd4316657385ee473d99302c90fe737b8ae4dc1a4dd4716255866cab947186b2","compact":"5787079c0a1135b0b1bdfaf79d4265be6c306f62bdf8acc329f39a0c7a750b24","nasal":"35a7203e3c3e75b4faeaf2bfd3851704ed5ee4b0675a4f7fd1d94cf4f8d249fc"}},{"id":"VRCE-6-73-20","kanda":6,"kandaId":"yuddha","sarga":73,"verse":20,"english":"Approaching on all sides that one resembling a hill, those bearing whetted darts attacked him with darts; those bearing swords in their hands, with swords; those bearing javelins in their hands, with javelins; with pattisas, those equipped with pattiśas; and with bludgeons, and maces and graceful kuntas; and with hundred of sataghnis, and iron clubs; and with terrific axes; and with Bhindipälas, and with boxes like to thunder-bolts; and slaps resembling the asani. And fired with fury, he (on his part) spread a huge havoc among them.","alignment":{"type":"grouped","confidence":0.565,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-86-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6073020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9825a51d5854a0dbb28ab7ac1a61450d755913a04bef8d7c0563ea1b5f2f18f0","compact":"5437f76f5ad56a5bbf85c01cd8b36582a62eb21ef29481928415dda6f7aad8cd","nasal":"5437f76f5ad56a5bbf85c01cd8b36582a62eb21ef29481928415dda6f7aad8cd"}},{"id":"VRCE-6-73-21","kanda":6,"kandaId":"yuddha","sarga":73,"verse":21,"english":"Approaching on all sides that one resembling a hill, those bearing whetted darts attacked him with darts; those bearing swords in their hands, with swords; those bearing javelins in their hands, with javelins; with pattisas, those equipped with pattiśas; and with bludgeons, and maces and graceful kuntas; and with hundred of sataghnis, and iron clubs; and with terrific axes; and with Bhindipälas, and with boxes like to thunder-bolts; and slaps resembling the asani. And fired with fury, he (on his part) spread a huge havoc among them.","alignment":{"type":"grouped","confidence":0.914,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-86-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6073021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e7aa9806b4fd66212ecd04dfd0f30594e3e4b4c2dd96a1eb1c9e595a170f5d77","compact":"12112d80010294b18ee7fb01a586960f1c60fdce3ba512026ac035807f733a49","nasal":"4edde055685d783bc3b0