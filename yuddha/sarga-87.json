d-sanskrit-ngram","duttRefs":["DUTT-6-99-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6087006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5723d0db726250a045a6a7eed7f22edfeed71f14e90cca07aa2fc66f3b9533e4","compact":"cb6966d21c63d49583e8628e893808b2f5b1550b36212124c87c242a37b8c9bc","nasal":"cb6966d21c63d49583e8628e893808b2f5b1550b36212124c87c242a37b8c9bc"}},{"id":"VRCE-6-87-7","kanda":6,"kandaId":"yuddha","sarga":87,"verse":7,"english":"He created a dreadful darkness with the discharge of his sharp weapons and burnt down the monkeys who fled away to different directions. Dust was raised on the ground by those monkeys assailed and flying to various directions. They were unable to withstand the power of the weapon made by Brahmå himself.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6087007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"eb89c5da43eff29d8c7be7a59a5d80ff2e6a27330ff76bab69fc0e92622fb082","compact":"0b8b3970544fcd36d05ebd957499f7435ac74121209ec6a36bef2cc96616934e","nasal":"854f0c176afd64e5202bc3f0ff06b960a2f5c69cdedaa3d1ad2fb12726389ee0"}},{"id":"VRCE-6-87-8","kanda":6,"kandaId":"yuddha","sarga":87,"verse":8,"english":"Beholding his own army, assailed and cut into hundred pieces by the excellent weapons of Rāvana Råghava dashed forward. a","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6087008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd6a00d03099c5e92728326780a162cf154419dc13a65a5137c50272364439f7","compact":"fb79072a0a2ed136116cbe2d3009181ad211bc6c7d8d57f65db2c0a01033945a","nasal":"fb79072a0a2ed136116cbe2d3009181ad211bc6c7d8d57f65db2c0a01033945a"}},{"id":"VRCE-6