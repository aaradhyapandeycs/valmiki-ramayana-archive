1","confidence":0.722,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6087014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bda678cc258ed905c11357f4ca1d7c715b2bb30cd5018274a158c1481ae9a12a","compact":"d667c060fa8e8e8f6b919ae234499a1793458a32d59b9ef340d489315df2b073","nasal":"d667c060fa8e8e8f6b919ae234499a1793458a32d59b9ef340d489315df2b073"}},{"id":"VRCE-6-87-15","kanda":6,"kandaId":"yuddha","sarga":87,"verse":15,"english":"And desiring to fight with him first Lakşmana setting sharp arrows on his bow, discharged shafts at him resembling the flame of fire.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6087015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"adffa34756d77c99aef8e99c6c975bfb8c356983b58673a1bc9bd08babf190b6","compact":"0de9c89d235b7cbe8100682e5fb9026568a81111c40d782e1f4b40b4241743d5","nasal":"0de9c89d235b7cbe8100682e5fb9026568a81111c40d782e1f4b40b4241743d5"}},{"id":"VRCE-6-87-16","kanda":6,"kandaId":"yuddha","sarga":87,"verse":16,"english":"The highly powerful Ravana too with his arrows stopped the course of those shafts in the sky as soon as they were discharged by Laksmana, skilled in archery.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6087016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6a3b572fbc733d968f6d3f684779032de1dc285153220f56eaf874dbc4a3056e","compact":"6cd7063d158f5a063248af06ac7526f9b05792b4bff002bb231be22128023372","nasal":"6cd7063d158f5a063248af06ac7526f9b05792b4bff002bb231be22128023372"}},{"id":"VRCE-6-87-17","kanda":6,"kandaId":"yuddha","sarga":87,"verse":17,"english":"And displaying his light-handedness, he with one arrow, severed Laksmana's one, with three his three and with ten his ten.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6087017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f823b51c5560bd809369ce85b55a66580b0c66d81c5544325bc855f83839cbda","compact":"b4e17b4d56f985ec26e06b9edb103e1ed37ba185a047209335f4b8f4ca7fa8a4","nasal":"9c97141efe28b321c5b5fe11dfe2e5673de41251e76b6c6101641d5417da18ff"}},{"id":"VRCE-6-87-18","kanda":6,"kandaId":"yuddha","sarga":87,"verse":18,"english":"Surpassing thus the son of Sumitrā Rāvana, ever victorious in battle, confronted Rāma in the encounter, standing like another hill.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6087018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3d6975560d2519fe23064e7ed17ad6330f3a585570decaf4654967e2478eb84","compact":"afdb83af3d1a66bfe02bb5a59d61d04c2be88a29c9676ed56755508f705e0322","nasal":"afdb83af3d1a66bfe02bb5a59d61d04c2be88a29c9676ed56755508f705e0322"}},{"id":"VRCE-6-87-19","kanda":6,"kandaId":"yuddha","sarga":87,"verse":19,"english":"Approaching Rāghava, Rāvana the lord of Rakşasas, with his eyes reddened in ire, began to make a shower of arrows.","alignment":{"type":"1:1","confidence":0.571,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6087019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"41e8d4b8c3f47a7de87f759565f2e64c416590455e844072568cef25f199f943","compact":"3c1d05464091461a6b42d294eb1e6e8843fe56b14492fcab26776c1eaba3f44c","nasal":"3c1d05464091461a6b42d294eb1e6e8843fe56b14492fcab26776c1eaba3f44c"}},{"id":"VRCE-6-87-20","k