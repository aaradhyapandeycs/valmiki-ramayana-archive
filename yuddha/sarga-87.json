[{"id":"VRCE-6-87-1","kanda":6,"kandaId":"yuddha","sarga":87,"verse":1,"english":"Beholding Mahodara, Mahāpäráva and the highly powerful Virūpåksa slain in the encounter Rāvaņa attained to an excess of ire. And ordering his charioteer to hurry on he gave went to the following words.","alignment":{"type":"grouped","confidence":0.54,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6087001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9dc1d015e2f878a9b9d3c6f27573b51f76db1e33bd19ba91ec94d8a03ebe222f","compact":"9a36c5d448d38b723c0055e1e25f0d12f0d32be9cb45c3e3356ac7e019007b24","nasal":"9a36c5d448d38b723c0055e1e25f0d12f0d32be9cb45c3e3356ac7e019007b24"}},{"id":"VRCE-6-87-2","kanda":6,"kandaId":"yuddha","sarga":87,"verse":2,"english":"Beholding Mahodara, Mahāpäráva and the highly powerful Virūpåksa slain in the encounter Rāvaņa attained to an excess of ire. And ordering his charioteer to hurry on he gave went to the following words.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6087002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b09188750827f789b4d7b7f043c3af68e4e044b763e0aa78b693e68879c9a4c6","compact":"467cc8cb1d2557251ece3125ead205cc2a7ec13b0b8012a63cc188d55c46047b","nasal":"467cc8cb1d2557251ece3125ead205cc2a7ec13b0b8012a63cc188d55c46047b"}},{"id":"VRCE-6-87-3","kanda":6,"kandaId":"yuddha","sarga":87,"verse":3,"english":"All my courtiers have been slain and my city is shut up-I shall remove my grief consequent on all these by slaying Răma and Lakşmaņa.","alignment":{"type":"1:1","confidence":0.85,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6087003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskr