-99-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6087025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1e24c5bbcdf8b41c8cb2a6d16a5254cdde43550a835c885463272d382594ec63","compact":"216c44f7040f9aa56efcdf1d118edacfccbb26209eaba0c4125aa22f5a1bbfc3","nasal":"216c44f7040f9aa56efcdf1d118edacfccbb26209eaba0c4125aa22f5a1bbfc3"}},{"id":"VRCE-6-87-26","kanda":6,"kandaId":"yuddha","sarga":87,"verse":26,"english":"The welkin appeared full of windows with that shower of arrows, shot with great vehemence and winged like vultures.","alignment":{"type":"1:1","confidence":0.71,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6087026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4410d9f665736bc9d19f4ee7fbb46512eef8270073f9412d23c90f8cf2dc40c3","compact":"dd15b0f8d553f2ba6a23f4a7ba9f5172b1f7de5c277ff67f462799cb47daba93","nasal":"dd15b0f8d553f2ba6a23f4a7ba9f5172b1f7de5c277ff67f462799cb47daba93"}},{"id":"VRCE-6-87-27","kanda":6,"kandaId":"yuddha","sarga":87,"verse":27,"english":"The earth was stricken with darkness caused by these arrows like to clouds appearing after sunset.","alignment":{"type":"1:1","confidence":0.473,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-99-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6087027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d54e3a1ab21328ac1dbd2e4c1e7d06ef63392d61a41abc183d916f0d33934bd9","compact":"90bc5d0f5fc7623725b8244ebd27a30f9d018fb122389d94c0c3e88b4afa92e0","nasal":"8556dda5f307d1d55d553b6658d45edf9b00993389de2e45f3b75ed1937440c5"}},{"id":"VRCE-6-87-28","kanda":6,"kandaId":"yuddha","sarga":87,"verse":28,"english":"There took place a dreadful conflict between them desiring to slay each other, having their prowess unknown and fighting like Vitra and Vasava.","alignment":{"type":"1:1",