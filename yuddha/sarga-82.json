015423d29cc6a243fdf6dd79136aaa69c82fba574504","compact":"82ebb863bfc066a7fceab0cebfb8242d3df1d48f9144790d9a083400e8956583","nasal":"82ebb863bfc066a7fceab0cebfb8242d3df1d48f9144790d9a083400e8956583"}},{"id":"VRCE-6-82-8","kanda":6,"kandaId":"yuddha","sarga":82,"verse":8,"english":"Why did that ugly-faced she-demon, devoid of all qualities, address Räma, having a beautiful countenance, gifted with many virtues and great effulgence?","alignment":{"type":"1:1","confidence":0.614,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6082008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29b0f39644cb6b6f84deee28f2b45ddaa3cb0fff873bd0333f84f2e85d89d785","compact":"7c7f260e5bd78f7e45047547cb2104a94beffd69310006cdca1e6971a370e178","nasal":"3ca28d2eef829509015d20fbbd6953a3b603996a0e703affd6794ce788560838"}},{"id":"VRCE-6-82-9","kanda":6,"kandaId":"yuddha","sarga":82,"verse":9,"english":"Alas for the misfortune of the Rākşasas, the aged Rākşasaee brought before him such a vile proposal, hated of all and worthy of creating laughter. for the destruction of Khara, Düşaņa and other Räksasas that ugly one approached Rāghava with such a vile intention.","alignment":{"type":"grouped","confidence":0.848,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6082009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"69b8d1949f8343800e58dceed91e9440303bdd4fff246d540c25a29376559a00","compact":"dc96d3a9ccbafec7e9a18df6e148040fa798f5a1b6e3f7b3f358a8328d07f069","nasal":"dc96d3a9ccbafec7e9a18df6e148040fa798f5a1b6e3f7b3f358a8328d07f069"}},{"id":"VRCE-6-82-10","kanda":6,"kandaId":"yuddha","sarga":82,"verse":10,"english":"Alas for the misfortune of the Rākşasas, the aged Rākşasaee brought before him such a vile proposal, hated of all and worthy of creating laughter. for the destruction of Khara, Düşaņa and other Räksasas that ugly one approached Rāghava with such a vile intention.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6082010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"edc72fc96bf31ea2a6e3972664be1a80940c530f46f53735bc1cde2b0f6008ce","compact":"bccc16da0972ba77cdeee43e17da927f1c3ce445a3007726f2adc4c6517de52d","nasal":"bccc16da0972ba77cdeee43e17da927f1c3ce445a3007726f2adc4c6517de52d"}},{"id":"VRCE-6-82-11","kanda":6,"kandaId":"yuddha","sarga":82,"verse":11,"english":"It was for her that Rāvana created enmity (with Răma) and Sītä was carried away by the Ten-necked Rākşasa.","alignment":{"type":"1:1","confidence":0.741,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6082011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c80afc435220772f934765d78d7f569713ac2b5379cc73d1d0b0562402e32c74","compact":"c114f8a7622c56f9c0995f018d0baa077d3ef113ee1d76c2064ad0dd696f4e46","nasal":"c83ec180055abfa77524df6a51abbe27558c903aa45fa63c25f450dc6f43e19c"}},{"id":"VRCE-6-82-12","kanda":6,"kandaId":"yuddha","sarga":82,"verse":12,"english":"But he could not spread his influence upon Sitā the daughter of king Jannak and deep rooted and eternal became the enmity with the highly powerful Rāghava.","alignment":{"type":"1:1","confidence":0.982,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6082012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a785229cb788c7ea0537fa4305f992479b437f42bc6b6e84fe350d35e577c72","compact":"507bdaaa1504720f7cfc87bfef7a3fa3bd5a4a0a605c135b1c8a5ed1c1d99ba5","nasal":"4baa6063b97598b73da0135f314c8063b8855af72ef8096b13c162748a826787"}},{"id":"VRCE-6-82-13","kanda":6,"kandaId":"yuddha","sarga":82,"verse":13,"english":"Beholding the Rākşasa Virādha slain by Rāma alone (Rāvana) wishing Vaidehỉ should have regarded that as a sufficient proof of his prowess.","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6082013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af879c53de9e7a92b490267876f155e31105fb24f616681c049d81344c9ba6b5","compact":"c01044800703e593d03195e72446687cfb7105325170dba3eb1f7eb992cbbf41","nasal":"72c395506728a253bc142708228398d9bd46d1f06f3b91266304eaa14d523bea"}},{"id":"VRCE-6-82-14","kanda":6,"kandaId":"yuddha","sarga":82,"verse":14,"english":"And fourteen thousand Rākşasas of terrible deeds were slain by him in janasthāna with shafts resembling the flame of fire. Khara Düş aņa as well as Tricira were slain by him in conflict with arrows resembling the Sun-this was a sufficient proof (of his power).","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6082014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"48363dc29774a58d8c713b03d299f6ffedef679bd52c1030d28d2795526a06d7","compact":"339eff5e399fced34e2d94ccb1f41e5e5064a399df4aade4a9f562b1987ae07c","nasal":"339eff5e399fced34e2d94ccb1f41e5e5064a399df4aade4a9f562b1987ae07c"}},{"id":"VRCE-6-82-15","kanda":6,"kandaId":"yuddha","sarga":82,"verse":15,"english":"And fourteen thousand Rākşasas of terrible deeds were slain by him in janasthāna with shafts resembling the flame of fire. Khara Düş aņa as well as Tricira were slain by him in conflict with arrows resembling the Sun-this was a sufficient proof (of his power).","alignment":{"type":"grouped","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6082015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f2a95b54697ba6c37447b953177b9552bd0814bee007e30b96c28c44adf599b7","compact":"7dfcc384e61ad25d14e5091f4183497bd624bef03669739ea18c975d7853c0e7","nasal":"02acf58e9d545c4de706e7ef4d3ab4502e77f202d7e16b5f16ec8cb76fb2d9de"}},{"id":"VRCE-6-82-16","kanda":6,"kandaId":"yuddha","sarga":82,"verse":16,"english":"Yojanabāhu and Kabandha, drinking blood, were slain by him, roaring with wrath-this too was a sufficient proof of his power.","alignment":{"type":"1:1","confidence":0.79,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6082016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac0e40a94df95c378b4fc77b026466a42f93814eab9a9040657544dab084f808","compact":"a598064f833b33137db4dbdd7c0796a04812cb938928023c435599a6cecf8fc2","nasal":"b710d55dd573ff3cc041e9181294436b92cdfcfde3d87d0dcd2c0197ad75e14c"}},{"id":"VRCE-6-82-17","kanda":6,"kandaId":"yuddha","sarga":82,"verse":17,"english":"Rāma slew the powerful Vāli, the son of the thousand eyed one, resembling the cloud-that too was the sufficient proof of his prowess. By him Sugriva, poorly and living in the mount Rșyamūka, having all his desires frustrated, was placed on the throne-that too even was the sufficient proof of his power.","alignment":{"type":"split","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-12","DUTT-6-94-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6082017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2bf0ea6f3998aee05af5903b3e0c979fcc89fb5d880ed6763fde2b655bbfe96e","compact":"e36d76d66ca140fd0476e5a0dac09c555bcc5b0497aaabe644d8cea41cfd4498","nasal":"bbdac9841e21241c397b7fba248fafa30ce6f94749e9fa5b3977dde74d4e096f"}},{"id":"VRCE-6-82-18","kanda":6,"kandaId":"yuddha","sarga":82,"verse":18,"english":"By him Sugriva, poorly and living in the mount Rșyamūka, having all his desires frustrated, was placed on the throne-that too even was the sufficient proof of his power.","alignment":{"type":"grouped","confidence":0.5,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6082018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4dc86dd1b5c6c5ca8d5c69c633053cd910e648be0a022cfea9e6023d44144a7f","compact":"80776289094237b64e9acb11fa711019507efe5eaac74c09d48c1d21048d39a3","nasal":"a884b8ea5d03e448c3f1b21441c36b2558033e75080eaaf7361676f10c89f8bc"}},{"id":"VRCE-6-82-19","kanda":6,"kandaId":"yuddha","sarga":82,"verse":19,"english":"He (Rāvana) from foolishness did not like the becoming speech of Vibhīşaņa conducive to the acquirement of piety and wealth and securing the welfare of the Rakşasas. Had the younger brother of the lord of wealth (Rāvana) observed the words of Vibhīşaņa, Lanka would not have been overwhelmed with grief and reduced to the state of a cremation ground.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6082019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2dc3a107d119dbfdf9e9b4e70d5222008e281d2fd4952419c0dd38cddbbe3cc7","compact":"9632185edac698985f2373cafcbf7b81ee7da5a46863ab32da54c3d35a2a98a0","nasal":"9632185edac698985f2373cafcbf7b81ee7da5a46863ab32da54c3d35a2a98a0"}},{"id":"VRCE-6-82-20","kanda":6,"kandaId":"yuddha","sarga":82,"verse":20,"english":"He (Rāvana) from foolishness did not like the becoming speech of Vibhīşaņa conducive to the acquirement of piety and wealth and securing the welfare of the Rakşasas. Had the younger brother of the lord of wealth (Rāvana) observed the words of Vibhīşaņa, Lanka would not have been overwhelmed with grief and reduced to the state of a cremation ground.","alignment":{"type":"grouped","confidence":0.852,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6082020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"93d3f7693da9e0de28a906abf77ab46756fc442d122fa7a9f27169815b2b7fc0","compact":"770bb4981e2cbb4a6428029a4c452cdb534b5f8708ea52c35b20fb488ba911f5","nasal":"c0c3e39f8dc378eabd1b707e13ceee561e75ee557a38ceeac2c5412912a1f057"}},{"id":"VRCE-6-82-21","kanda":6,"kandaId":"yuddha","sarga":82,"verse":21,"english":"Hearing of the destruction of the highly powerful Kumbhakarņa by Rāma of the irrepressible Atikay by Lakşmaņa as well as of his beloved son Indrajit, Rāvana did not come to his senses.* *One śloka has been omitted here by some of the editors which when translated stands thus; When one monkey only Hanumān killed the prince Akşaya and reduced the whole city to ashes with the fire of his tail Rāvana should have come to his senses.","alignment":{"type":"1:1","confidence":0.815,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6082021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6697ad6bbef2ec4799a728dd1f78dfe5bc685c8cbd0a3f3b4cc158fc705fe2d4","compact":"d61610e9f1d8c543546cfec01197d645ad9e61923f239c3428c84962706d415e","nasal":"5d7e2137946c51f59b74786fbb4540e1c18105d416769d52e355769c35340ff3"}},{"id":"VRCE-6-82-22","kanda":6,"kandaId":"yuddha","sarga":82,"verse":22,"english":"There is audible in every house of the Rāks sas, the cry-My son, my brother, my husband is slain in battle.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6082022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8a9a4f63c5eb160abc05f1e62a1d4fe3b692cce2ff39599761cb66077d1113a9","compact":"19d4752e09b6e939798eb458ec0b97b3007da32b263a43c861ab3c329e0ea8f5","nasal":"19d4752e09b6e939798eb458ec0b97b3007da32b263a43c861ab3c329e0ea8f5"}},{"id":"VRCE-6-82-23","kanda":6,"kandaId":"yuddha","sarga":82,"verse":23,"english":"In conflict have been destroyed by the heroic Rāma, thousand cars, horses, serpents and infantry.","alignment":{"type":"1:1","confidence":0.286,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6082023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cf410fd57eec3085df9ef51e30844554d38de66cb07e5d6fb39001ba58536094","compact":"564ff433195e35280ce9508ce32e4a77128211cab7dfe3473e6e489ebf100467","nasal":"564ff433195e35280ce9508ce32e4a77128211cab7dfe3473e6e489ebf100467"}},{"id":"VRCE-6-82-24","kanda":6,"kandaId":"yuddha","sarga":82,"verse":24,"english":"Perhaps Rudra, Visnu, Mehendra or the performer of hundred sacrifices, or even Death, in the shape of Rāma, is slaying us.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6082024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"43f51dd36ae6f8d93321d7f4b70a4ff3ebe5c975190e50b452a253a30ec68b9a","compact":"7549fce2bc44707387930efb429dcc8dcb98f59c4ba01d59888142611a1c19f0","nasal":"210f760204dda5503dc24db0f0025208b8847038c00e5f1735618f658e7424fa"}},{"id":"VRCE-6-82-25","kanda":6,"kandaId":"yuddha","sarga":82,"verse":25,"english":"By Rāma all the heroes have been slaindespair has taken possession of our minds-we do not behold the end of our terror and are bewailing being deprived of our lords.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6082025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e05d1e311bf97a0f5b5ff416193a354209df47530f2d183f950340df699d50bc","compact":"cfaa4c8878601dfb2e202c1a95a4fdcb7ef2a9660e0fbf024905167bd1e49c4a","nasal":"e879e64f4ae6a87cd87fe92b7c24f9d2ba7b3efb544d3f1b0367d7adc3642c0b"}},{"id":"VRCE-6-82-26","kanda":6,"kandaId":"yuddha","sarga":82,"verse":26,"english":"Does not the Ten-necked hero, who has obtained boons (from Brahmă) perceive that a mighty disaster shall befall him from Råma?","alignment":{"type":"1:1","confidence":0.474,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6082026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f1dd83c8d46ec8d04eca2a424a02a84cc312abdce05c53cca036107adffdc0f","compact":"bbd8370dbc53a897dbbe3f5f697e6ee3778aa78820a5fa731c491ce87f91ff5a","nasal":"b81e2dc96f929863a75dcff40819faa00fc3911f9018a7bed453251fc0603fc1"}},{"id":"VRCE-6-82-27","kanda":6,"kandaId":"yuddha","sarga":82,"verse":27,"english":"Neither the celestials Gandharvas, Piśācas nor Rāksasas shall be able to save him from Rāma in conflict.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6082027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9fbd9d4b6ae397765606a084f697bc5cce7d11282c54e41e3717d8f2bc5d90ba","compact":"adcfe93471b8527de3354de30622ef9b2eb737873654f500def2498efaca5648","nasal":"dcecaef566530a6803b2035f4418c5edbcd30883ae41d4c26a924e8808813f2d"}},{"id":"VRCE-6-82-28","kanda":6,"kandaId":"yuddha","sarga":82,"verse":28,"english":"In very battle many an accident befalls Rāvaņa, this bespeaks of his destruction at the hands of Rāma.","alignment":{"type":"1:1","confidence":0.767,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6082028","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d1cfc689154be7831339b3a2b79b40aa7b1c3f1ab70da340f08cbf39e5304598","compact":"5ceccf12f04fdb1324a87796ee72610c97d85df7ce70c607183081064e2b30e2","nasal":"df198efbec31053f10675870b4c3561f0011fc270a230408c234b825b314d3ec"}},{"id":"VRCE-6-82-29","kanda":6,"kandaId":"yuddha","sarga":82,"verse":29,"english":"The great Patriarch, being pleased conferred upon Rāvaņa the boon that no fear would proceed to him from the celestials, the Dānavas or the Rākşasas-but he did not beg of him, security from men.","alignment":{"type":"1:1","confidence":0.807,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6082029","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d83dd54eda7f492e658afca3c8e02fd6b40a73b72da00cd0c1778e9d368c5e0","compact":"7b19a84a22b60525556109f5a34ac4e38183c16e42733a183a6b0d65e9e0de3b","nasal":"7b19a84a22b60525556109f5a34ac4e38183c16e42733a183a6b0d65e9e0de3b"}},{"id":"VRCE-6-82-30","kanda":6,"kandaId":"yuddha","sarga":82,"verse":30,"english":"Forsooth, he is that fearful man who shall slay Rāvana and the Rākşasas.","alignment":{"type":"1:1","confidence":0.839,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6082030","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"70937c0587b98817e7fcee928f9792919e3508d77569e5c1fb9883ad82e032d5","compact":"a4ec618fe19494731d9857846f7d873df463b0daab956f6506b18bcb0f0c256a","nasal":"da15b0058db46ef7e3e2882a33600f3a557b755e8b22c426c667067d0520c658"}},{"id":"VRCE-6-82-31","kanda":6,"kandaId":"yuddha","sarga":82,"verse":31,"english":"The celestials being thus oppressed by Ravana, who had obtained the boon, worshipped the great Patriachs with sever austerities.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6082031","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ac4b524360b7804492e85139b127e75e5b4a5f416ccfd490411ea0ce1612b1e","compact":"fd65fe69a9c46abb9ae1bec2d4d7777c2908ae01683187ef85151c7da8556751","nasal":"fd65fe69a9c46abb9ae1bec2d4d7777c2908ae01683187ef85151c7da8556751"}},{"id":"VRCE-6-82-32","kanda":6,"kandaId":"yuddha","sarga":82,"verse":32,"english":"Being propitiated with them, the high-souled Patriarch, for their welfare, addressed the celestials, with the following pregnant speech.","alignment":{"type":"1:1","confidence":0.614,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6082032","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ff88a4fbcdee9f6c1e3b749346ac23dfde674a324d4e02d96f71344c24cc012","compact":"066e24bd543cb62dd9a6913260f51901115389ae42dda2aba3272b6e66a8cf75","nasal":"066e24bd543cb62dd9a6913260f51901115389ae42dda2aba3272b6e66a8cf75"}},{"id":"VRCE-6-82-33","kanda":6,"kandaId":"yuddha","sarga":82,"verse":33,"english":"From today shall the Rākṣasas and Dänavas roam for ever afraid of the celestials in three worlds,","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6082033","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8125f07f2a0d82ba27f2261d15385da6651593520c4e9a49e6969a90f88434a4","compact":"bd33d8d1226fa9bd09823ff1ae792e39e8d5e3e3c0cb0fafc5ba14f1ec6c2ed5","nasal":"e979ec74e898ce76a976196dbb5e7217baea68494cf03482767ba432a74d01e3"}},{"id":"VRCE-6-82-34","kanda":6,"kandaId":"yuddha","sarga":82,"verse":34,"english":"Thereupon the celestials headed by Indra engaged in propitiating Mahādeva, the slayer of Tripura, and who rides upon a bull.","alignment":{"type":"1:1","confidence":0.723,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-28"],"status":"unreviewed"},"source":{"sanskritLocator":"6082034","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79effc12cc720919c2c090438962e98c71c3b4853d5e3ea84c0db261043348f7","compact":"34c152bd8d3ad88834b92e72b102e8b65d64c01f7cc78d8e45e0b68214721ae8","nasal":"0513ffb9aeb878987190234de517f21d8de1731d7d4119c57ebc3a1d677e64ab"}},{"id":"VRCE-6-82-35","kanda":6,"kandaId":"yuddha","sarga":82,"verse":35,"english":"And being pleased, Mahädeva addressed them saying, For your welfare there will be born a woman who shall be the cause of the destruction of the Rākşasas.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-29"],"status":"unreviewed"},"source":{"sanskritLocator":"6082035","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c11cd7ae6ac878f4c6c7dd2cde27535b6c41d828a6c9981aa613f07267c43ee1","compact":"6f8c82c7f75d8a9d182da9a235f1cdad675943f3807f553bee7d2f84e3c62431","nasal":"d4e420ac37c46139c33f232481418a025d08bd8621acb7b9d4bb9c014db66cd8"}},{"id":"VRCE-6-82-36","kanda":6,"kandaId":"yuddha","sarga":82,"verse":36,"english":"As hunger, being engaged by the celestials, did destroy in olden time, all the Dānvas, so shall she (Sītā) the root of the extinction of Rāksasa race destroy us all with Rāvana.","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-30"],"status":"unreviewed"},"source":{"sanskritLocator":"6082036","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fa5e2e940a8e32df1f572e8d36b0aa0199ce5221319ab329eca172a5ac2728a6","compact":"2b449f18287920a64f8a2f563068e7d273e87631bd528fba3d4c6e612f013685","nasal":"2b449f18287920a64f8a2f563068e7d273e87631bd528fba3d4c6e612f013685"}},{"id":"VRCE-6-82-37","kanda":6,"kandaId":"yuddha","sarga":82,"verse":37,"english":"Alas! for the foolishness of the vicious minded and insolent Răvaņa destruction has faced us and we are overwhelmed with grief.","alignment":{"type":"1:1","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-31"],"status":"unreviewed"},"source":{"sanskritLocator":"6082037","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d43373d1bec06c032231892e409dd03f7ae31e5963bb88fa42e9c7925a8011c0","compact":"fb95ba4cbe6a4512f5734f725f6441f0e1b48948cc5163fd8aa296b26f97fb2c","nasal":"fb95ba4cbe6a4512f5734f725f6441f0e1b48948cc5163fd8aa296b26f97fb2c"}},{"id":"VRCE-6-82-38","kanda":6,"kandaId":"yuddha","sarga":82,"verse":38,"english":"We do not see any such being in the world who can afford us shelter. Rāghava has attacked us like to the fire of dissolution. There is no refuge for who have been stricken with fear as no help re.. hes the elephants in a forest best with fire.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-32"],"status":"unreviewed"},"source":{"sanskritLocator":"6082038","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e2a8559a55e655b2f91313c38441cb95549e78d0c6a0a71314dd5867132c041","compact":"5e5959bf3566e20a04b155d78495eed2ade45227f028a3aa7065f55b55e71c23","nasal":"5e5959bf3566e20a04b155d78495eed2ade45227f028a3aa7065f55b55e71c23"}},{"id":"VRCE-6-82-39","kanda":6,"kandaId":"yuddha","sarga":82,"verse":39,"english":"Thus bewailed piteously and loudly-the she demons holding each other by neck and being stricken with fear and grief.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-34"],"status":"unreviewed"},"source":{"sanskritLocator":"6082039","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprint