[{"id":"VRCE-6-82-1","kanda":6,"kandaId":"yuddha","sarga":82,"verse":1,"english":"By Rāma of unwearied actions, with flaming arrows feathered in burning gold, were destroyed thousands of elephants-many horses with their riders, many a car crested with flaming banners; thousands of heroic Rákşasas assuming shapes at will engaged by Råvana, and armed with clubs and parighas; and golden pennons. Beholding and hearing of this the remaining night-rangers assembled and were greatly bewildered, poorly and stricken with anxiety.","alignment":{"type":"grouped","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6082001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"047d03f255fac2e706dde90648f45a765588dd1696a248cac918caf2ad6939f3","compact":"1d01d7abc2b9f9cd1bfba71abae167e0d2ce3a4d338cee92f18df14020bf7ab8","nasal":"1d01d7abc2b9f9cd1bfba71abae167e0d2ce3a4d338cee92f18df14020bf7ab8"}},{"id":"VRCE-6-82-2","kanda":6,"kandaId":"yuddha","sarga":82,"verse":2,"english":"By Rāma of unwearied actions, with flaming arrows feathered in burning gold, were destroyed thousands of elephants-many horses with their riders, many a car crested with flaming banners; thousands of heroic Rákşasas assuming shapes at will engaged by Råvana, and armed with clubs and parighas; and golden pennons. Beholding and hearing of this the remaining night-rangers assembled and were greatly bewildered, poorly and stricken with anxiety.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-94-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6082002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1eb1d64e4624b108b18588f9b6ae41e4a2ccd7f7d4dcb895d3e892641ad78efc","compact":"9bc6a34bd2722fe557d3e687d11ee94465d9cc5880564d9fafe8d45859fcbd74","nasal":"216d98267ae49886c9954fb9fd0e9642e51