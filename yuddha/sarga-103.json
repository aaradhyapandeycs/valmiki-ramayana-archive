us":"unreviewed"},"source":{"sanskritLocator":"6103020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f1ca682eec14745b0c992e1f0840ffe38b569e7e82bdb201828808f6a7a280d","compact":"df66150ffc34fc3131b0bd72b4a6c76683288f74c9915d45cbc2f04b25752426","nasal":"8ad1c6dab5b529bbe7622ccc305587f289ffb3106fd5f616240533decda2c2b3"}},{"id":"VRCE-6-103-21","kanda":6,"kandaId":"yuddha","sarga":103,"verse":21,"english":"The object, with which I have gained you back, has been accomplished. I have got no attachment for you-do you go wherever you wish, O gentle one.","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6103021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"be6b4976e6b93efa1215fec4de60365065f8174569615ae5af312dcf2c2f48f2","compact":"1a04f34b1e2edf4a36e7fc6fc6321a26ca6f8cacf77d4a4102844fa621c40be0","nasal":"ec273d27d3641998767ea0c824dfe3b1ad924ced07c80a56788c10354b0578d1"}},{"id":"VRCE-6-103-22","kanda":6,"kandaId":"yuddha","sarga":103,"verse":22,"english":"I speak these to you impelled by my sense of duty. If you wish you may live with Laksmana, Bharatga or Satrughna or with Sugrīva or Räkş asa Vibhisana. Do you settle, O Sita, where you may find your own pleasure.","alignment":{"type":"grouped","confidence":0.652,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6103022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"53d7eace73c7c668fcd22254a350a402d8e84018f6dc6257651be9fd6087a33c","compact":"0c0c9e6e88907762701e48b0811f893cf09b3ebc77d9518a28870d6c7914d15c","nasal":"0c0c9e6e88907762701e48b0811f893cf09b3ebc77d9518a28870d6c7914d15c"}},{"id":"VRCE-6-103-23","kanda":6,"kandaId":"yuddha","sarga":103,"verse":23,"english":"I speak these to you impelled 