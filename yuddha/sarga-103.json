d":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6103012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6b32c1489bfa70b0ef05e92876bfe92e5faef68ad1c8cb93079fad4dbfa0f2f3","compact":"6d6e61aa57f42c69412859e6980a4cb017846a36a6d80ac0a76a91109b43d334","nasal":"6d6e61aa57f42c69412859e6980a4cb017846a36a6d80ac0a76a91109b43d334"}},{"id":"VRCE-6-103-13","kanda":6,"kandaId":"yuddha","sarga":103,"verse":13,"english":"As the southern quarter, incapable of being got at by the people, was conquered by the selfcontrolled great ascetic Agasty, so for you slaying Ravana, I (always) anxious to have honour, have removed my insult-as is the duty of a man.","alignment":{"type":"grouped","confidence":0.444,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6103013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c64dec9d69666a7a44798438fdc4d111f18579edf4a342c47b783f9b3e018013","compact":"2c717a8ec349cafdcff459f7b495c13aea4060d2cccad6fd8ebb6d2aca2de477","nasal":"2c717a8ec349cafdcff459f7b495c13aea4060d2cccad6fd8ebb6d2aca2de477"}},{"id":"VRCE-6-103-14","kanda":6,"kandaId":"yuddha","sarga":103,"verse":14,"english":"As the southern quarter, incapable of being got at by the people, was conquered by the selfcontrolled great ascetic Agasty, so for you slaying Ravana, I (always) anxious to have honour, have removed my insult-as is the duty of a man.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6103014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17b432a67b2fca184615c50a545b6eeca847e9886d1efe086b3029887f74fc2f","compact":"405527a9fb481ff650bd89dd21fc6f314c6fede131d653344b1f9df031969d6d","nasal":"405527a9f