[{"id":"VRCE-6-103-1","kanda":6,"kandaId":"yuddha","sarga":103,"verse":1,"english":"Beholding Maithili standing humbly by him, Räma began to give vent to his pent-up feelings.","alignment":{"type":"1:1","confidence":0.713,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6103001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b950080c51344866467523db9d999859a311984736e3afded67a08e5860b0743","compact":"0b1a18f2f9fb9076b69d900e029b105f1f8f9c925a005a5ff3115c8cdbf37f77","nasal":"b2fe0e1cc2982b54b44082c2807efe2b74bd0d4f634e8e4e620dda37d7913ccb"}},{"id":"VRCE-6-103-2","kanda":6,"kandaId":"yuddha","sarga":103,"verse":2,"english":"O gentle one, destroying all the enemies in the arena of battle I have subdued your enemy-I have done all that can be accomplished by manliness.","alignment":{"type":"1:1","confidence":0.393,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6103002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"167847ae9fa79530ea4fdb0228fe8a04c02d04b92eb46b452a8b780385e619f3","compact":"daf8740b3961c82db6eeab0cccc39fb1a55e377fdea607a6c8060ea23a10a0db","nasal":"daf8740b3961c82db6eeab0cccc39fb1a55e377fdea607a6c8060ea23a10a0db"}},{"id":"VRCE-6-103-3","kanda":6,"kandaId":"yuddha","sarga":103,"verse":3,"english":"I have reached the other end of my anger, rubbed off (the insult) for my spouse being taken away by the enemy and have killed simultaneously my disgrace and enemy.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6103003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1c9147460f37652041b6dff262fb8310d51e52d15249af5816074e0ca6effdc8","compact":"4890c3183d9a122c983c1740a42d67b75c0b8a050468639c03179923eea363fb","nasal":"b4a2e66e5ffec8e6b9fb8a6bc65e0eca43bb1611679001f7afc2a5ccf4b0a1de"}},{"id":"VRCE-6-103-4","kanda":6,"kandaId":"yuddha","sarga":103,"verse":4,"english":"My manliness has been displayed today, my laboúr has been crowned with success and today I have fulfilled my promise by my own prowess.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6103004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f7fe02a9f2506be2d29f8691d105960cfd11612e184ab14bd7e7390a6c9d436a","compact":"c18d68b43cc1e31750041bba5b7312776c83f03d5423cd8e6eadc4e60246ff0d","nasal":"c18d68b43cc1e31750041bba5b7312776c83f03d5423cd8e6eadc4e60246ff0d"}},{"id":"VRCE-6-103-5","kanda":6,"kandaId":"yuddha","sarga":103,"verse":5,"english":"That accidental misfortune, under the influence where of you were carried away by the fickle-minded Räksasa in my absence, has been subdued today by me, a man.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6103005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d4386a745e3b12614ee1af0e2236dc6ee0686873ec7266168f415e403777065","compact":"f3d800c251381d714e916a5fcb368d044e73878cf8248f5b657d4be37fc2697f","nasal":"f3d800c251381d714e916a5fcb368d044e73878cf8248f5b657d4be37fc2697f"}},{"id":"VRCE-6-103-6","kanda":6,"kandaId":"yuddha","sarga":103,"verse":6,"english":"What is the use of his manliness, who when insulted, cannot remove it? Even if he be a great man he may be called mean.","alignment":{"type":"1:1","confidence":0.538,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-115-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6103006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fi