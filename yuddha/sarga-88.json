le":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"393dee696df26809bb30ab9c030c11dd7f6a1393a52413eb6077aaa43f0c0523","compact":"9bf78733d07042e1abd93708054ac2d75a5b9611ee05a5153d8c2125917f8437","nasal":"763a4843e5c4c0b05c60514ecb20997cc2f57dcc55b212336f892f3bd2a0aab8"}},{"id":"VRCE-6-88-28","kanda":6,"kandaId":"yuddha","sarga":88,"verse":28,"english":"O you proud of your prowess! as Vibhīşana has this wise been delivered by you, passing by the Raksasa, this dart, discharged from my bludgeon of an arms, will depart depriving you of your life.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-100-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6088028","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55a68ec620b41cede838e393730c973822f0a6bc9629ba20c2d7f468df849eca","compact":"1778879e28d4af1364dae4d1ad74346c61d2fea4c350e6bae6163b88a6ea8442","nasal":"1778879e28d4af1364dae4d1ad74346c61d2fea4c350e6bae6163b88a6ea8442"}},{"id":"VRCE-6-88-29","kanda":6,"kandaId":"yuddha","sarga":88,"verse":29,"english":"Having said this, Rāvana waxing furiously enraged, discharged at Laksmana that dart forged by Maya with his power of illusion, furnished with eight bells, having might sounds,t Incapable of being resisted, competent to finish foes: and flaming in energy-and shouted simultaneously. And hurled with terrific force the dart sending sounds resembling that of Vajra of the thunder-bolt, vehemently alighted at Lakş maņa in that encounter.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-100-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6088029","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17f477856193b49f7eeeee9267a06f1f72131ca3d7674dd4c36b519acbdf607d","compact":"51e2beb5bb47ea141b57cff534aa0656273fc4fc5a9972d549df2d42f5616