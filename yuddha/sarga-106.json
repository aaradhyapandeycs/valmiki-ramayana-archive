confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-118-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6106006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c546b9c1cca206c285fbf7b0e71bc0c073e1cf245e630be6c52d33bc58276e7","compact":"dc74c97f8e1e41111a94a81776efc747b0aa303614d0c8103e500a28128cc0a7","nasal":"dc74c97f8e1e41111a94a81776efc747b0aa303614d0c8103e500a28128cc0a7"}},{"id":"VRCE-6-106-7","kanda":6,"kandaId":"yuddha","sarga":106,"verse":7,"english":"Although shut up in the inner apartment-well protected and guarded by the dreadful shedemons she had always her mind in you and was devoted to you. Although tempted in many a way and remonstrated with she did not think of that Rākşasa in her inner mind. Her heart is pure and she is not spoiled with sin-do you therefore take back Maithilī. Do you not speak otherwise-I do command you.","alignment":{"type":"grouped","confidence":0.573,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-118-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6106007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9db50b4e66029606edc67b7d6524bf6d88f8a63e9bf43c6fd31553e291b946f","compact":"afb8c05d7c56b44ef757d172661dee3a2501c1753248c0c8d3f32b6dbf6c7c24","nasal":"ecae257215baf8d3a1b8f289cceae0c96c4f42f814fc69f573d90d77a5a939d9"}},{"id":"VRCE-6-106-8","kanda":6,"kandaId":"yuddha","sarga":106,"verse":8,"english":"Although shut up in the inner apartment-well protected and guarded by the dreadful shedemons she had always her mind in you and was devoted to you. Although tempted in many a way and remonstrated with she did not think of that Rākşasa in her inner mind. Her heart is pure and she is not spoiled with sin-do you therefore take back Maithilī. Do you not speak otherwise-I do command you.","alignment":{"type":"grouped","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-118-7"],