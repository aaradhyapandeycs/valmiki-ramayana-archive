8-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6075008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5bd8a75466e850216c9ec7e5112eb8a2ac79825b50d36d6805bb87175408574d","compact":"dcf00fbc9451e912187859bb11bbb76c13efa350d2a2ae4db4224178eb1e44ea","nasal":"dcf00fbc9451e912187859bb11bbb76c13efa350d2a2ae4db4224178eb1e44ea"}},{"id":"VRCE-6-75-9","kanda":6,"kandaId":"yuddha","sarga":75,"verse":9,"english":"Hearing the vaunt of the Rākşasa-chief, Rahgu's son, inflamed with rage, with an undaunted countenance, spoke to Ravana's son.","alignment":{"type":"1:1","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6075009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dd422e1aa735daab09a4db85444c9b0e9889e5fd96f3ad13355dd2eaad3ae07c","compact":"3b9e58ad0078e4ab99b1d2097ab304a84c8c2cc3afe14cde6fe074e7dbc8c343","nasal":"eeda3ad12724f766839b23fdd65395869f20ad1c1b7799a4abbd2da9906f0b88"}},{"id":"VRCE-6-75-10","kanda":6,"kandaId":"yuddha","sarga":75,"verse":10,"english":"O Rākşasa, hard is the achievement of the task that you have mentioned. He that compass business by act is alone intelligent. He that compass business by act is alone intelligent. But you, O wicked-minded one, incompetent as you are to bring about your end, attaining your arduous aim by words only, deem yourself as crowned with success.","alignment":{"type":"grouped","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6075010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9f5b7c2b2acc4cf3cba3792513293d722b0d372be47441899ab660cbc335ea76","compact":"7489e01cef4a7dcd12a4e5f5eb80190bf8e7b160c0a2774dbc732311daadff11","nasal":"7489e01cef4a7dcd12a4e5f5eb80190bf8e7b160c0a2774dbc732311daadff11"}},{"id