d76c5746d102e38e5b644ce7576f8806c14662"}},{"id":"VRCE-6-43-25","kanda":6,"kandaId":"yuddha","sarga":43,"verse":25,"english":"And the monkeys forcibly snatching away the weapons (of the Rākşasas), began to rive the Rákşasas with mighty trees and giant crags.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-26"],"status":"unreviewed"},"source":{"sanskritLocator":"6043025","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f764ed0a887e3c2efe9fdac642791b17ef78f814f329781f05ff1802472d8ef7","compact":"63b5c632b571b095dfa8bce82a65eb33c516de42989077ad19502884b89dd6f6","nasal":"a072292fa3d4de72c4af4d5cb39843fef39c8ec0b4d79cc274dfbb6d73921f01"}},{"id":"VRCE-6-43-26","kanda":6,"kandaId":"yuddha","sarga":43,"verse":26,"english":"In the meanwhile those heroes among the monkeys-Kumuda, Nīla and the exceedingly exasperated Mainda, summoned the utmost impetuosity they were masters of.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-27"],"status":"unreviewed"},"source":{"sanskritLocator":"6043026","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d5f550d666cf41e87c1d1c640e6179685e3c19cd626b367844de1863bbc0a837","compact":"3c949c132e87294eac3036a2fd3d892ba23be27c251718485f92284596812026","nasal":"7a2558999c1ddf94e10f5d713beb2e8b7650eadc452d8230cff60041f256b90b"}},{"id":"VRCE-6-43-27","kanda":6,"kandaId":"yuddha","sarga":43,"verse":27,"english":"And those foremost of monkeys and redoubtable able warriors without much ado began to spread quite a carnage in the van of the Rākşasa army, and by means of various arms terribly beat the Rākşasas.","alignment":{"type":"1:1","confidence":0.586,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-28"],"status":"unreviewed"},"source":{"sanskritLocator":"6043027","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_finge