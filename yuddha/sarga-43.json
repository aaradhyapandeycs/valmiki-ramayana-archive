2e491556357659cdb798bd7088454"}},{"id":"VRCE-6-43-14","kanda":6,"kandaId":"yuddha","sarga":43,"verse":14,"english":"And each side desirous of slaying the other, the monkeys and the Raksasas were exceedingly strong and heroic and like to mountains. And each party storming at the other, in that conflict were heard loud cries emitted by those swiftspeeding ones in anger.","alignment":{"type":"grouped","confidence":0.592,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6043014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d108ac7b706c2dd3d541b865d429406e4280940cd6fb221df484b78cfd3061c7","compact":"c743691d8da7fd99252cf638df9c9c418d7e242bd5e24aa48722196eb8ff6e5c","nasal":"c743691d8da7fd99252cf638df9c9c418d7e242bd5e24aa48722196eb8ff6e5c"}},{"id":"VRCE-6-43-15","kanda":6,"kandaId":"yuddha","sarga":43,"verse":15,"english":"And fearful was the dust red-hued that was raised incessantly by the monkeys and the Rākṣasa; and it enveloped the ten cardinal points.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6043015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b617e5052f9de66493fd54f35029a2c9f9e9ccf8d94bd7be1766c1626ceb98ee","compact":"fce29df166c8c413f8c1263ead8542963e83f3488084a880975cc25a1e9e59a6","nasal":"fce29df166c8c413f8c1263ead8542963e83f3488084a880975cc25a1e9e59a6"}},{"id":"VRCE-6-43-16","kanda":6,"kandaId":"yuddha","sarga":43,"verse":16,"english":"In the field of battle, each enveloped with that dust raised, pale as silk, could not be discovered by the other.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6043016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d894a8a6f40f50bfcbc1fdde68e073239907b48eefede72af14430b6ca737216","compact":"eb595f31542bc27eef7679e87323bf63a8240f1881d5e28271ac85ce0b634ca8","nasal":"6d72e7b62b485bc5f3e0307abc53094435463da69aa55cc06cd0c585d3bb4e2a"}},{"id":"VRCE-6-43-17","kanda":6,"kandaId":"yuddha","sarga":43,"verse":17,"english":"In consequence of that dust arising, neither standard, nor ensign, nor shield, nor steed, nor weapon, nor car could be seen.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6043017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c9fe644889cc2233ff525697539224a3b50a421c2927bebaf5d683b9c8326613","compact":"c5de19f5a7f0c5539b18c741214116798f7a101488043dbd44a0709d2f009f22","nasal":"039ae7bb66a07e6aa490c1547dfbed620c9babcda30f1cda31d7bb91d606dba1"}},{"id":"VRCE-6-43-18","kanda":6,"kandaId":"yuddha","sarga":43,"verse":18,"english":"The fierce cries alone of those roaring and rushing were heard in that dreadful battle; but their forms were not visible to the sight.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6043018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0adcda407dc16c2c2be982e570c6030ab3539137933fbd20f44c56bcecafc3b","compact":"c73d851db0902dea4172f790305c2e984f43866be89e8e678ff5dcbcd0cb25ec","nasal":"c73d851db0902dea4172f790305c2e984f43866be89e8e678ff5dcbcd0cb25ec"}},{"id":"VRCE-6-43-19","kanda":6,"kandaId":"yuddha","sarga":43,"verse":19,"english":"In that conflict in the dark then monkeys extremely enraged slew monkeys, and Räkşasas also killed the Rākşasas.","alignment":{"type":"1:1","confidence":0.469,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6043019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"78fa9087e354dd7987cecc994c3aee045ffd6de4f36f405b29ef4e618dc49114","compact":"df94a19131f04a087d958ee3f76439ba19d05fa95853fe69664513a78fef176b","nasal":"df94a19131f04a087d958ee3f76439ba19d05fa95853fe69664513a78fef176b"}},{"id":"VRCE-6-43-20","kanda":6,"kandaId":"yuddha","sarga":43,"verse":20,"english":"And monkeys and Rākşasas slaying (indiscriminately) friends and foes, made the earth wet with blood, and miry.","alignment":{"type":"1:1","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6043020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80b112134b8de3c372913ebdb7f58136f853474a5cd485b5e93c6d6aedca05df","compact":"bfc99e2f300fe3379ebf2b524625f4f668c9776b9ff4af0de604cd7ecb808fb1","nasal":"4e65f6e4397f7effb7b1e73b11597b6c8008c65954cd3a6740aa5cd4595a03ff"}},{"id":"VRCE-6-43-21","kanda":6,"kandaId":"yuddha","sarga":43,"verse":21,"english":"Then with showers of blood the dust was layed; and the earth was covered with corpses.","alignment":{"type":"1:1","confidence":0.84,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-55-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6043021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85a13bcad25ee98a33c69d62a057da4e2777977f00b01e54c6647bce46928ca6","compact":"2f6bc9de8a09ba71b0176846559ed93ff31646dd77843270733d92ddb326424c","nasal":"2f6bc9de8a09ba71b0176846559ed93ff31646dd77843270733d92ddb326424c"}},{"id":"VRCE-6-43-22","kanda":6,"kandaId":"yuddha","sarga":43,"verse":22,"english":"Rākşasas and monkeys fast slew each other vigorously with trees and darts, maces and prasas, rocks, bludgeons and Tomaras, and by means of their arms resembling bludgeons, coped with their adversaries appearing like hills.","alignment":{