[{"id":"VRCE-6-108-1","kanda":6,"kandaId":"yuddha","sarga":108,"verse":1,"english":"Dasaratha having repaired, Mahendra greatly delighted spoke to Rāghava, stationed there with folded hands, saying.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-120-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6108001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3b692498cd4f0843621d64891cffb0c2a26b1ce222e711bf777b9f95206eabf","compact":"16ad88770607ce9e84442b577165727200576d0b7d3b9383c79032a64884077a","nasal":"37e4e934d4872a4eefec46d0b2e6e68d66acbf2bf6ec04ee14fed2434b17b395"}},{"id":"VRCE-6-108-2","kanda":6,"kandaId":"yuddha","sarga":108,"verse":2,"english":"O Rama,Oforemost of men, this our presence here, must not be fruitless, we are pleased-do you ask for what you wish.","alignment":{"type":"1:1","confidence":0.532,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-120-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6108002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f583f892512e2568041dae09e5427b56ef8c7e9b74fa5896d4db7a1b67b459f","compact":"c5d756762bf98f4af0c70cc75744cb01e9bd7a78219c6fcb4b992b39b4b345b9","nasal":"c5d756762bf98f4af0c70cc75744cb01e9bd7a78219c6fcb4b992b39b4b345b9"}},{"id":"VRCE-6-108-3","kanda":6,"kandaId":"yuddha","sarga":108,"verse":3,"english":"Being thus accosted Kākutstha replied to Vibhīşaņa, saying: Do you invite all these monkeys headed by Sugrīva to bath.","alignment":{"type":"grouped","confidence":0.348,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-121-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6108003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"066070d90568966d58950629e10e64f28057947ec04db3fe934c46a7db7d6e0f","compact":"6a140787812498bdb255c40ffa3e62354a8d837d49ed379b402ca604a3a018b0","nasal