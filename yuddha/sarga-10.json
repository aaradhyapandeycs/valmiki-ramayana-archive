[{"id":"VRCE-6-10-1","kanda":6,"kandaId":"yuddha","sarga":10,"verse":1,"english":"Vibhīşaņa addressing him with these excellent and auspicious words, fraught with high sense, Rāvaņa, impelled by Death, again spoke in harsh accents.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-16-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6010001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b19db539059148f859262cdc0be96d39363b8d3a1bc30a7bb0c80fbb08fe0ab3","compact":"e30fbc9a512821e766d13a134dc4aecfdd0ec0359628dae1230e532af0880af1","nasal":"f75a35a6017e725c6a4592687c46094d5407134734cdd17149f3a6ed96b45f0b"}},{"id":"VRCE-6-10-2","kanda":6,"kandaId":"yuddha","sarga":10,"verse":2,"english":"It is better to live with open enemies or enraged serpents than with those who pass for friends but are in reality foes.","alignment":{"type":"1:1","confidence":0.717,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-16-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6010002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4ce50b66a97ced6024057785c5bf98c6837582a6c544139a54df0ad1bd9b5e56","compact":"89f3fbec08d399a9e6cd896fe1700c651599f0185551773dd81bacbd15bae980","nasal":"89f3fbec08d399a9e6cd896fe1700c651599f0185551773dd81bacbd15bae980"}},{"id":"VRCE-6-10-3","kanda":6,"kandaId":"yuddha","sarga":10,"verse":3,"english":"I know well the nature of kinsmen, in all the worlds, O Raksasas, one takes delight in another's misfortune.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-16-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6010003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7b8fd7bb01d77da2ccc264ceb1f5e46fffa20ddb354a5e42a1dd295f3edb383f","compact":"b43d7d615b3e9db7d828ecc6cbe8d4293e390f93bf4c12f1e6c53e07f2fbdd