[{"id":"VRCE-6-54-1","kanda":6,"kandaId":"yuddha","sarga":54,"verse":1,"english":"Then he sent up a mighty shout making the sea resound, and as if drowning the roar of the thunder and riving mountains.","alignment":{"type":"1:1","confidence":0.745,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6054001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2d0f8edcbcd387839296a1289f18347b6316a1c4f73a416ff7639bfd02632b83","compact":"91071390926c05878d213a009d3ece0bd1ddb217ab9625593438d7c0bf0f4ce7","nasal":"5d2065a335a7180dc54068fc42b613eadc7014e9d0b516bbc9866fdf5b34ec31"}},{"id":"VRCE-6-54-2","kanda":6,"kandaId":"yuddha","sarga":54,"verse":2,"english":"Seeing that fierce-eyed one, incapable of being vanquished by Maghavān or Varuņa or Yama, the monkeys began to fly away.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6054002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7d9c4c59a2227ecd100e93513cb504b0a39b79114fe080661f763d9e154dadfa","compact":"2be5f7b9103eec3f5f7ddc739502f964b24399b07966a446316d42d685e8327c","nasal":"02357ff55725d464f677fc3f7e6928c89530bee32972491b92e407f30932257c"}},{"id":"VRCE-6-54-3","kanda":6,"kandaId":"yuddha","sarga":54,"verse":3,"english":"Seeing them scamper, the king's son-Angada said to Nala and Nīla and Gavākșa and the mighty Kumuda.","alignment":{"type":"1:1","confidence":0.642,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6054003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e3b756fed17aa6cc1120f712e33a903e3fa327a70b1c7302fe0bfbf79c8ea1e4","compact":"28b977e260350ee6214d49344c5cb7ba5a8e6c499864636c86c1d77af92762f2","nasal":"d9004fbc867b4263f986c7