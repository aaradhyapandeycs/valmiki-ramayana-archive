7b6a38f12bebc6851dd07a8d3d349cb583eb4c91c56","nasal":"c77c77bb77aa4b6be41d77b6a38f12bebc6851dd07a8d3d349cb583eb4c91c56"}},{"id":"VRCE-6-54-7","kanda":6,"kandaId":"yuddha","sarga":54,"verse":7,"english":"Cheered with much ado, the monkeys rallying, took up trees and advanced to the field of fight.","alignment":{"type":"1:1","confidence":0.615,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-8"],"status":"unreviewed"},"source":{"sanskritLocator":"6054007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ae27de7c38138b9f8a61995324b1fb056e7496d70614c5f175502b073c8712d","compact":"b2b5f6d55e8eb5431bd9023ee733d0c78448c18a3f0baa0bdf85f118dc7e913d","nasal":"b2b5f6d55e8eb5431bd9023ee733d0c78448c18a3f0baa0bdf85f118dc7e913d"}},{"id":"VRCE-6-54-8","kanda":6,"kandaId":"yuddha","sarga":54,"verse":8,"english":"Ceasing from flight, the wood-rangers waxing, enraged, began to assail Kumbhakarņa, like to elephants in rut. And the exceedingly strong Kumbhakarna, attacked with towering mountain peaks and crags and trees with flowering top, did not shake.","alignment":{"type":"grouped","confidence":0.686,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-9"],"status":"unreviewed"},"source":{"sanskritLocator":"6054008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5d88c7af6dcc70e2f7d9465176d0610ee898575cac4a0b0ce23c14f08ad75c52","compact":"09c58a5bfadd4201e27185f1f73cf059a2995f61d27abb93602b4b217ec5fde6","nasal":"ba1e586ee79ec8b714d58574111b59ea1f713f661918f70249e363c0daecaffb"}},{"id":"VRCE-6-54-9","kanda":6,"kandaId":"yuddha","sarga":54,"verse":9,"english":"Ceasing from flight, the wood-rangers waxing, enraged, began to assail Kumbhakarņa, like to elephants in rut. And the exceedingly strong Kumbhakarna, attacked with towering mountain peaks and crags and trees with flowering top, did not shake. And countless crags descending on his person, were shattered; and trees with flowering tops, being broken, fell down to the earth.","alignment":{"type":"split","confidence":0.553,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-9","DUTT-6-66-10"],"status":"unreviewed"},"source":{"sanskritLocator":"6054009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d1c0478d15aa112b2f7ff139cf49ca7695400b8b37c19520f888dd7c4b4ba06f","compact":"8200f767acf60265428fa290db0b41eb46e1873cc1df643c1ba3f4c476cb15ce","nasal":"57c3f666ea6ee82086b23b725cde7ba902bbf13ec35b81d1205b205a9fa68cac"}},{"id":"VRCE-6-54-10","kanda":6,"kandaId":"yuddha","sarga":54,"verse":10,"english":"Incapable of containing himself (through rage), Kumbhakarņa on his part fell to agitating the ranks of the powerful monkeys, even as a fire breaking out burn dowit a forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-11"],"status":"unreviewed"},"source":{"sanskritLocator":"6054010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f71de3c3e184bd77a0ed9d727f4fa0c941fe954b2a2d8b1b27aeeaab4bad4ba","compact":"bd922b260447c25f996751577709e4b92e9417c81a8f21b77e17a6015aefe588","nasal":"05e5b58ba24f998902e4f2804e9fe885ea400b74556bf9bb408059e5e4262fe5"}},{"id":"VRCE-6-54-11","kanda":6,"kandaId":"yuddha","sarga":54,"verse":11,"english":"Many a prime monkey, crimsoned and drenched (with blood) lay down (on the ground); and many, resisted dropped to the earth, like trees bearing coppery flowers.","alignment":{"type":"1:1","confidence":0.769,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-12"],"status":"unreviewed"},"source":{"sanskritLocator":"6054011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"013ea548522202c8e1e3361da0ec0f3f746aea2a72490f5dd46a78486fe70cb6","compact":"4b24248c2a23fd42344f82abdc2ca6df289d6ca9c7262908735532039130f10c","nasal":"4b24248c2a23fd42344f82abdc2ca6df289d6ca9c7262908735532039130f10c"}},{"id":"VRCE-6-54-12","kanda":6,"kandaId":"yuddha","sarga":54,"verse":12,"english":"Without looking before or after, the monkeys bounded and rushed. And on being attacked by the Rāksasa with ease some of those heroes dropped into the deep and some entered the wilderness.","alignment":{"type":"1:1","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-13"],"status":"unreviewed"},"source":{"sanskritLocator":"6054012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc9fa78b6f03be54cd7c2be796d64f28f2a7e1b62afc1234dd034d33e9ef5091","compact":"91b45cadc586e924347352206d099e259988a960cac1fe4ea3019679373ebf20","nasal":"74ada1df73769a60f5cad6804c1c657de9d9cd1be8cc7f54f056609b5d2c856a"}},{"id":"VRCE-6-54-13","kanda":6,"kandaId":"yuddha","sarga":54,"verse":13,"english":"Some ran by the same way by which they had crossed the ocean; and some with pale faces darted into downs. And some of the bears ascended up trees, and some took shelter in mountains.","alignment":{"type":"grouped","confidence":0.661,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6054013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e87a8103485f9daf2d315040691618a9e39604830e2a43c1935a055ba931eabd","compact":"64112e0768ca2563846358d2510a39906b37509ed4be52156f13a26c6a68896a","nasal":"64112e0768ca2563846358d2510a39906b37509ed4be52156f13a26c6a68896a"}},{"id":"VRCE-6-54-14","kanda":6,"kandaId":"yuddha","sarga":54,"verse":14,"english":"Some ran by the same way by which they had crossed the ocean; and some with pale faces darted into downs. And some of the bears ascended up trees, and some took shelter in mountains.","alignment":{"type":"grouped","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6054014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a0e8ef18aba7a391c535cf721f461ab405b30d19d39de1d815d59c1559a6c4c1","compact":"ad7deac7092f213f0055320fd8c576c3600bd2202f932e4970932ee55fbd543c","nasal":"8ce432b83bebb90dea1971595c084402ef904f872213a2d7a7194c52524c7ea6"}},{"id":"VRCE-6-54-15","kanda":6,"kandaId":"yuddha","sarga":54,"verse":15,"english":"Others dropped down; and some ran on. And some fell down to the earth, and some lay insensible as if dead.","alignment":{"type":"approximate","confidence":0.186,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6054015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"141135c7d3ecd30760b50a86a6cefc005dcd742af4f95aeee465e3fe768188a0","compact":"fbb0bef0cc283d27febac700140b785a183037f32fe013384aac5b4ceb7559c8","nasal":"6e290382e6c37df15b5d1a6aa0bceb972aaaef8305c114b6d57b4e9e7879b58f"}},{"id":"VRCE-6-54-16","kanda":6,"kandaId":"yuddha","sarga":54,"verse":16,"english":"Seeing the monkeys break down, Angada addressed them, saying, “Stay we shall fight.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6054016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cffb2062d95f1fbe835894fcce0b953553a38e85537a3295240b0b108afde466","compact":"1733944e144ac74334dcfaf7eba4fb61cec56c77e1f2fe5179804c9277da0e09","nasal":"8af5d02276d52d77710141f69a637688daabec33eb85ace2d57325dac76cc91c"}},{"id":"VRCE-6-54-17","kanda":6,"kandaId":"yuddha","sarga":54,"verse":17,"english":"Desist, you monkeys. Going round this Earth place find I none where you may rest. Stop you all. What is the need of preserving your lives.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6054017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4a2113f34e73d5c02c44daac53d5ff1e1072b06b1d161902e95d3a474b1b57d3","compact":"754ad7c1b69162980d76a8459cefc2fd4c1cff80f0240a9a66056f5b18613699","nasal":"754ad7c1b69162980d76a8459cefc2fd4c1cff80f0240a9a66056f5b18613699"}},{"id":"VRCE-6-54-18","kanda":6,"kandaId":"yuddha","sarga":54,"verse":18,"english":"You poltroons, if you fly away leaving your arms behind, your wives shall deride you; and that is more painful to honourable persons than death itself.","alignment":{"type":"1:1","confidence":0.417,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-18"],"status":"unreviewed"},"source":{"sanskritLocator":"6054018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3e0f1fd45e27d7b0afdeea32789f7e224ac09805c4f8291e4953a6ce880c6631","compact":"aa58f249d7e3ca14410f34d9cd532b65ecd8e0cd55fbb0b5021c407b2c078b83","nasal":"af4c885ced287614be8ba20af9eb499021bc56438c00f63a8f993728bb8c6924"}},{"id":"VRCE-6-54-19","kanda":6,"kandaId":"yuddha","sarga":54,"verse":19,"english":"Born in long and noble lines, whither go you, suffering from fear, like abject monkeys? When renouncing your prowess, you fly away in fear, forsooth you are base.","alignment":{"type":"1:1","confidence":0.808,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-19"],"status":"unreviewed"},"source":{"sanskritLocator":"6054019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b4df89786693fe09c290f9ec063e1a1a59433e40f3cdaff6957270101f92688","compact":"9ff5d1289385de406fcc31cd8a384d7cc71bab2737b2700fbb9bb1435f45b202","nasal":"9ff5d1289385de406fcc31cd8a384d7cc71bab2737b2700fbb9bb1435f45b202"}},{"id":"VRCE-6-54-20","kanda":6,"kandaId":"yuddha","sarga":54,"verse":20,"english":"Where now is gone that talk of your anent your nobility and the welfare (of your king) which you had held in society.","alignment":{"type":"1:1","confidence":0.453,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-20"],"status":"unreviewed"},"source":{"sanskritLocator":"6054020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"359857dce969b9aac1d44b96fc22d366b44c455a640f90b9575a39c92b2e5fca","compact":"1840c41a343b06214ea841d8be570654834d277e5b8de66f405e79e9c0252098","nasal":"fa6fbdf10757a2bfeafcfc36f5e0da2bca4c896ec4a92be0ce652b661858f127"}},{"id":"VRCE-6-54-21","kanda":6,"kandaId":"yuddha","sarga":54,"verse":21,"english":"He that live, despised (of all), hear the reproach of being a craven. Therefore do you follow the way frequented by the worthy, and cast off fear.","alignment":{"type":"1:1","confidence":0.947,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-21"],"status":"unreviewed"},"source":{"sanskritLocator":"6054021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"90e93b4be9b3365950a1854fb2691553c3aef90a854dce83a162856c785ac711","compact":"d0c7ab7abf9e85a79fe71e99378697d4ce53779eb44d517199b3ecfe5c1b5596","nasal":"31b1d0655c226dc129ddfaaacf10aa4a54bf5b1d791f46d9099d23cfc4af6166"}},{"id":"VRCE-6-54-22","kanda":6,"kandaId":"yuddha","sarga":54,"verse":22,"english":"We will either lie down on the earth, being slain in consequence of our shortness of days, and thus attain the region of Brahmä incapable of being attained by dastards; or achieve renown by slaying the foe in fight and slain in battle, we shall enjoy the wealth of the region of heroes.","alignment":{"type":"1:1","confidence":0.435,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-66-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6054022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3479d7506154c5a17538a1abc8e2bc531be3981e51a14236585d846da5de9ef7","compact":"39a404f45c02745e360acf7f0c2c9742156d08aaf2f14b631637d19bf3ae6b