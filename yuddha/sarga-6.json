[{"id":"VRCE-6-6-1","kanda":6,"kandaId":"yuddha","sarga":6,"verse":1,"english":"Beholding in Lankā that dreadful and aweinspiring work performed by Hanuman like to the high-souled Sakra, the lord of Raksasas, looking down with shame, addressed them all, saying.","alignment":{"type":"1:1","confidence":0.844,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-1"],"status":"unreviewed"},"source":{"sanskritLocator":"6006001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"20d0a7414712853821b728d9dda7fd284e2e5e1d6f759457a0393211ca7d5970","compact":"c35af22a1e94ee6548729674621396c4fce5bb03cebb58fe461f09a403a560c0","nasal":"5c11bfa28098910f1b34640190a61456ddb54997eae2cb5c6d1a7790656123a9"}},{"id":"VRCE-6-6-2","kanda":6,"kandaId":"yuddha","sarga":6,"verse":2,"english":"That monkey alone has invaded and entered the city of Lankā hard to reach and has espied Sītā, the daughter of king Janaka.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-2"],"status":"unreviewed"},"source":{"sanskritLocator":"6006002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85c74145137935c327996d08445f76b083d04b7d4c8b0cfed2c421cd36c81544","compact":"007a00eceafb93d35f71c04eb7b7af38dee754d8b1eb1660d01916abb6d301ef","nasal":"036be08342ca689c19ff09cfd46441cb735511f3dae115e26571a453d87a0190"}},{"id":"VRCE-6-6-3","kanda":6,"kandaId":"yuddha","sarga":6,"verse":3,"english":"He has shattered the palace, and the altar of sacrifice, slain the leading Raksasas, and, in short, agitated the whole city of Lankā.","alignment":{"type":"1:1","confidence":0.951,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-3"],"status":"unreviewed"},"source":{"sanskritLocator":"6006003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80dc51406c0d30ddb699764cb311999fb8ecb7843d5299f71cb6b04515d64132","compact":"a07b2a3e26b90a3bf168eb06688bb08bcaa2aa2cd19f26ae39b379da27b8c4c1","nasal":"2765bf6567a513ae50afc53d7a06ed7a61ccc714c1980985d3c46d773f19c647"}},{"id":"VRCE-6-6-4","kanda":6,"kandaId":"yuddha","sarga":6,"verse":4,"english":"What shall I do now? And what should you all do one this occasion? It behove you all go give me such counsel as become me and will conduce to my glory.","alignment":{"type":"1:1","confidence":0.75,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-4"],"status":"unreviewed"},"source":{"sanskritLocator":"6006004","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"edd063110b3337b63e96ad38f57bea6b2b5e6ae86ad58a9625a2657e6a8a3aee","compact":"32946e6099befa6853bc8367a80257b9a93a7d19348fc9385ffc774019e6a8d3","nasal":"ffacee8d71d10c2024c1d79a04d43663587b248234ad4a189509082bc956e2c8"}},{"id":"VRCE-6-6-5","kanda":6,"kandaId":"yuddha","sarga":6,"verse":5,"english":"'Victory is the outcome of consultation'-this do the sages* say. Let us, therefore, O mighty ones, engage in counsel, relating to the measures we should adopt towards Rāma. * Manasvin, according to Rāmānuja, means hero.","alignment":{"type":"1:1","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-5"],"status":"unreviewed"},"source":{"sanskritLocator":"6006005","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e42eb6739bc74bb9ed1b13c2fc592ca3722cf65ca7ae721223a3bbf5b7f7f24b","compact":"52c15c898e2fa16331c5b4fe0dfc5f727591834c7b5161d16b65b0e7a461deb9","nasal":"4a623508a85943fa5881d6e45616ebb81dc60c0b4fe8cb978789f1547e3779ea"}},{"id":"VRCE-6-6-6","kanda":6,"kandaId":"yuddha","sarga":6,"verse":6,"english":"There are three orders of men on this earththe superior, the middling and the inferior. This distinction cannot be perceived without a knowledge of the signs, and so I shall relate to you their merits and demerits.","alignment":{"type":"1:1","confidence":0.814,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-6"],"status":"unreviewed"},"source":{"sanskritLocator":"6006006","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f63ea48e2cb8be577b67776d6e7699df07e9a9fffce1cd51feb7e50345020418","compact":"d48815d086100630adf15721eb665ee67491c366fb5e5ef5d7be1b90cfe2e35c","nasal":"d48815d086100630adf15721eb665ee67491c366fb5e5ef5d7be1b90cfe2e35c"}},{"id":"VRCE-6-6-7","kanda":6,"kandaId":"yuddha","sarga":6,"verse":7,"english":"He is said to belong to the superior order, whose counsel contains the three signs (mentioned below), or who engages in works after consulting duly with friends capable or with persons having the same end in view, and some times with others, and who serve Providence.","alignment":{"type":"grouped","confidence":0.701,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6006007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7e8ee466e1e3ade2aed7be95c02e3450291a63ba2f6c3a612793c183d6af10ab","compact":"6a90b075c1bbf37c812a2f11c95b6bec8a5565160320c97de4935102a07c173e","nasal":"978d65fa2248a9c61947450cdc6079b78d4f4154ddfe2f97baa3503329482504"}},{"id":"VRCE-6-6-8","kanda":6,"kandaId":"yuddha","sarga":6,"verse":8,"english":"He is said to belong to the superior order, whose counsel contains the three signs (mentioned below), or who engages in works after consulting duly with friends capable or with persons having the same end in view, and some times with others, and who serve Providence.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-7"],"status":"unreviewed"},"source":{"sanskritLocator":"6006008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c978ccb058ca24be9a610268ca6f0805421afe31ab3c617905640b5e4081db81","compact":"0a78f0aa92c109056c2ce05416c5a20541e355f67d41733556a95222