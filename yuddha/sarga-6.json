txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"83342dba2efa0aee9be0b07780388860944385796edfdb96526fc814221e0418","compact":"8a28121d41b24b42c7db838342aa798d51990bd41b3575a662dd96ff67bac431","nasal":"8e48c644d5d84b829e266fad4518b4f7f64198e740215d890bc908b1f956c4df"}},{"id":"VRCE-6-6-15","kanda":6,"kandaId":"yuddha","sarga":6,"verse":15,"english":"You are all gifted with good intellects: do you all unanimously settle as to what become me and conduce to my well-being.","alignment":{"type":"1:1","confidence":0.648,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-14"],"status":"unreviewed"},"source":{"sanskritLocator":"6006015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8f353eb06a81569eb625abf856ba362fdd97d44fa25f768f0e44f232c48737d9","compact":"86f72ed35f4105edf5010d7bd5554ef6ea3c7d918c6cc30d5abd1d2244047eb0","nasal":"7a4055da2c270ddb1913efac5fa61283c282d365b271837c44bdbeda2bf7ce30"}},{"id":"VRCE-6-6-16","kanda":6,"kandaId":"yuddha","sarga":6,"verse":16,"english":"Environed by a thousand of patient monkeys, Rāma, with a view to capture our city, is approaching towards Lankā.","alignment":{"type":"1:1","confidence":0.767,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-15"],"status":"unreviewed"},"source":{"sanskritLocator":"6006016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"892b410870374e467b0649a063080684dd59ffff64b3978cb2479ec0968ee5a9","compact":"bbc3bb0619e345c622bd499fc03cd31d7ecd38d57385122616dc44260725e308","nasal":"71d869ed8ba156d1b8677d824e3aa2f96a31e8b505dccdf266aedaf25a4a9b29"}},{"id":"VRCE-6-6-17","kanda":6,"kandaId":"yuddha","sarga":6,"verse":17,"english":"Forsooth, shall he cross over the main along with his younger brother and a mighty host.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-16"],"status":"unreviewed"},"source":{"sanskritLocator":"6006017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"934790fd1694789314d65dc1acf649fb9beb8f9c6e1640d009270a7ba0fe265f","compact":"1f8217cbba3a5e52d259cf198a7ea06e03cdad5e2d867042dcee27ba56bda169","nasal":"1f8217cbba3a5e52d259cf198a7ea06e03cdad5e2d867042dcee27ba56bda169"}},{"id":"VRCE-6-6-18","kanda":6,"kandaId":"yuddha","sarga":6,"verse":18,"english":"He can by his prowess dry up the ocean and do the other.* Rāma approaching thus with a hostile intention along with the monkeys, it behove you to devise such means as might protect my city and army. *i.e. bridge over the ocean.","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-6-17"],"status":"unreviewed"},"source":{"sanskritLocator":"6006018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4dad805d205a6fb17bfb22de8c066e1a09ee8b45e26d7057a392a0622e183af9","compact":"e80c4b1c3eeeb9915ecbdb696589a2a4812545d9a9b8c65e41da0881588fc9b3","nasal":"4f6685c952d8c8699cf576acd8348fc962563fbadec5513e5970638f37b47a7d"}}]
