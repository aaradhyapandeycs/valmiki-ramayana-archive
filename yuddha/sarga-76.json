[{"id":"VRCE-6-76-1","kanda":6,"kandaId":"yuddha","sarga":76,"verse":1,"english":"Then sighing like an enraged serpent, that chastiser of foes, Dasaratha's son, setting shafts (on his bow-string) showered them on the Raksasa-chief.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-30"],"status":"unreviewed"},"source":{"sanskritLocator":"6076001","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1d09a61a9cb9299ff0ba23825c5b59556919a493124ad87dd3bff63186329bc5","compact":"51362ba90efa996ce84bfb1d2b114617eccd6aaf2731fc4df5ea48f2a200e0fc","nasal":"5c73051507c7f6dbf5448147c8933abe079a6f1c31167637b94d87593bcde37a"}},{"id":"VRCE-6-76-2","kanda":6,"kandaId":"yuddha","sarga":76,"verse":2,"english":"And hearing the twang of his bow-string the lord of Rākṣasas, with his countenance fallen, gazed at Laksmana.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-31"],"status":"unreviewed"},"source":{"sanskritLocator":"6076002","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"791e6083f27cd300cf957fea7c64887346617b99fa8c2e742043860a1b7a3d41","compact":"2f8636def798fd679f425b3df6ef866e5566988c56c4c17640be41de30716a49","nasal":"2f8636def798fd679f425b3df6ef866e5566988c56c4c17640be41de30716a49"}},{"id":"VRCE-6-76-3","kanda":6,"kandaId":"yuddha","sarga":76,"verse":3,"english":"Then Vibhīşaņa spoke to Sumitrā's son as he was fighting, “I find (inauspicious) signs in Rāvana's son.","alignment":{"type":"1:1","confidence":0.725,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-32"],"status":"unreviewed"},"source":{"sanskritLocator":"6076003","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"383f059afac5ca7d14644abcda489a21b6626cfdb18e610421f962dc249badaf","compact":"d5e529241fbc5710c83938314e5e3e81874500d7ea6629783ca6197a7eb37493","nasa