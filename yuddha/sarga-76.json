43dafc28194fdaf","nasal":"87017ea867818d7c6b18ed6edd4c5afb3a7e96f0fbce68dae658a752c42ffafc"}},{"id":"VRCE-6-76-7","kanda":6,"kandaId":"yuddha","sarga":76,"verse":7,"english":"And eyeing that heroson to Dasaratha-present in the encounter, (Indrajit) with his eyes crimsoned on choler, drew near Sumitrā's son. And coming up to him (Laksmana), he again addressed (that hero) in a harsh speech, saying.","alignment":{"type":"approximate","confidence":0.2,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-36"],"status":"unreviewed"},"source":{"sanskritLocator":"6076007","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"36e9929a165c11f88656f38cefe257f5f7d541a8806a3bfdb5afb2638f0bab38","compact":"5f55f86965ba1419e23d11ad0f1d68e896cf0deed16b80aa0de8a5f49422da44","nasal":"4f1ae5105240975f7524bf773f530f064d8d1d28f0a32d1da3a6cbbcaf223f9f"}},{"id":"VRCE-6-76-8","kanda":6,"kandaId":"yuddha","sarga":76,"verse":8,"english":"And eyeing that heroson to Dasaratha-present in the encounter, (Indrajit) with his eyes crimsoned on choler, drew near Sumitrā's son. And coming up to him (Laksmana), he again addressed (that hero) in a harsh speech, saying. Did you not remember my prowess at that first encounter, when you along with your brother was bound up, that now you are discharging arms (at me)? Forsooth you two in mighty encounter, with shafts resembling the thunder-bolt and vajra, by me were first laid down on the ground, deprived of your lives, along with your principal adherents.","alignment":{"type":"split","confidence":0.483,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-36","DUTT-6-88-37"],"status":"unreviewed"},"source":{"sanskritLocator":"6076008","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d76b1c90cbd7899153e9b33a9ac79c2b5af3002a8e6e5c6c59d68bfad207b938","compact":"35e75b00e3541ce3e55b7439472e7a63c0fced119b8256ddb107f03d05fad11d","nasal":"35e75b00e3541ce3e55b7439472e7a63c0fced119b8256ddb107f03d05fad11d"}},{"id":"VRCE-6-76-9","kanda":6,"kandaId":"yuddha","sarga":76,"verse":9,"english":"Did you not remember my prowess at that first encounter, when you along with your brother was bound up, that now you are discharging arms (at me)? Forsooth you two in mighty encounter, with shafts resembling the thunder-bolt and vajra, by me were first laid down on the ground, deprived of your lives, along with your principal adherents.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-37"],"status":"unreviewed"},"source":{"sanskritLocator":"6076009","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"aec8e62c584e7bf51076faf38feb49f0d6194e08218c19739466ab5ac7897f2e","compact":"8b625802d8635a92edc945f8dd6b809a70938f73c0001518654b8b87c59e88bd","nasal":"8b625802d8635a92edc945f8dd6b809a70938f73c0001518654b8b87c59e88bd"}},{"id":"VRCE-6-76-10","kanda":6,"kandaId":"yuddha","sarga":76,"verse":10,"english":"Did you not remember my prowess at that first encounter, when you along with your brother was bound up, that now you are discharging arms (at me)? Forsooth you two in mighty encounter, with shafts resembling the thunder-bolt and vajra, by me were first laid down on the ground, deprived of your lives, along with your principal adherents.","alignment":{"type":"grouped","confidence":0.561,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-37"],"status":"unreviewed"},"source":{"sanskritLocator":"6076010","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"03327e010b9de3f3844bb826a0615f0b3d91f9f8ced81c671a46d31ae72d0478","compact":"22240baa9b6f8fa078b556d7ad5e30332a865d442d5c5d220a08653a7da201e4","nasal":"22240baa9b6f8fa078b556d7ad5e30332a865d442d5c5d220a08653a7da201e4"}},{"id":"VRCE-6-76-11","kanda":6,"kandaId":"yuddha","sarga":76,"verse":11,"english":"Either this has escaped your memory or I fancy, you plainly act to go to the abode of Yama, inasmuch as you have set your heart on beating me.","alignment":{"type":"1:1","confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-38"],"status":"unreviewed"},"source":{"sanskritLocator":"6076011","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"114a299cbbf7ded29ae6ca9826e9144ae54e4ba300e553c015d43278b951bb79","compact":"2df57e9e91ee9fd2650da226bd52cac6bcc970d5131955203b093df67502ab94","nasal":"0ac06fd256d4cf1760a608a714f840b510ecc65f36712d9671c8b8a1acec631a"}},{"id":"VRCE-6-76-12","kanda":6,"kandaId":"yuddha","sarga":76,"verse":12,"english":"If at the first encounter you have not witnessed my prowess, today shall I show it to you. Do you now stay, summoning your attention.","alignment":{"type":"1:1","confidence":0.886,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-39"],"status":"unreviewed"},"source":{"sanskritLocator":"6076012","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"089f02ad36c6a26c674a7c2b0f102a6cebed7df34a6f1a0a592af72dd0e3bde2","compact":"b534e894a74cfff86f2c1b4dd282596dd6c187c65802e6b3ca0d4e409b265120","nasal":"b534e894a74cfff86f2c1b4dd282596dd6c187c65802e6b3ca0d4e409b265120"}},{"id":"VRCE-6-76-13","kanda":6,"kandaId":"yuddha","sarga":76,"verse":13,"english":"Seeing this, he pierced Lakşmaņa with seven shafts, and Hanumān with ten keen-edged excellent shafts.","alignment":{"type":"1:1","confidence":0.761,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-40"],"status":"unreviewed"},"source":{"sanskritLocator":"6076013","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c44870bf1c7f6e69e1b1dfff27b084d50033259b16c0e61c08896d04ef4a1dcb","compact":"a7e0f757d2f70dd407182d8a3d2d16156420ad51abeaaeb733d54e111a204231","nasal":"fe0be8276293b06e9544a339861eee2ff60ac2fbb6d54056bc32a17ed0e0c704"}},{"id":"VRCE-6-76-14","kanda":6,"kandaId":"yuddha","sarga":76,"verse":14,"english":"Then, fired with double fury, that powerful one pierced Vibhīşana with an hundred arrows, powerfully discharged (from his weapons.)","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-41"],"status":"unreviewed"},"source":{"sanskritLocator":"6076014","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9e8e3811b0fe0a8ce473ded9ce4bc869a88e2e4f84ac5ce384e7ef047e13d70f","compact":"46ee6d182f95a375a20fc5f863fc39185aaef13e02894baf676844366479e1dc","nasal":"46ee6d182f95a375a20fc5f863fc39185aaef13e02894baf676844366479e1dc"}},{"id":"VRCE-6-76-15","kanda":6,"kandaId":"yuddha","sarga":76,"verse":15,"english":"Seeing this act of Indrajit, that foremost of men, Rama's younger brother, Laksmana, with an undaunted countenance, fired with wrath without minding the same, and saying with a laugh, this is nothing.'","alignment":{"type":"1:1","confidence":0.63,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-42"],"status":"unreviewed"},"source":{"sanskritLocator":"6076015","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"202977aae3d33f9070ee68de1fcf8196eb45109ed840bf5e059f55847465ee91","compact":"4a082268226665634b09eca75205538dfee20ca4321208afe2ff5498d39ffea2","nasal":"524a010ff1ff2585bff49d48e0cce9358cc446a199492d73342b0e742753c755"}},{"id":"VRCE-6-76-16","kanda":6,"kandaId":"yuddha","sarga":76,"verse":16,"english":"Taking dreadful arrows, in the conflict, discharged them at the son of Ravana. \"O nightrangers, heroes, coming to the field never discharge (such shafts as these). These arrows of your are light and of slight strength, and they conduce to my comfort. Heroic warriors eager for encounter, do not fight thus.","alignment":{"type":"grouped","confidence":0.763,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-43"],"status":"unreviewed"},"source":{"sanskritLocator":"6076016","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fe451a82189c1afdc12f043b3b3e39b9c2fbabc0e032c5a92b5d4e6050317879","compact":"76ec1afda3f58783879fa3c848736dc768c682234cd141f9a19605944726d6f6","nasal":"76ec1afda3f58783879fa3c848736dc768c682234cd141f9a19605944726d6f6"}},{"id":"VRCE-6-76-17","kanda":6,"kandaId":"yuddha","sarga":76,"verse":17,"english":"Taking dreadful arrows, in the conflict, discharged them at the son of Ravana. \"O nightrangers, heroes, coming to the field never discharge (such shafts as these). These arrows of your are light and of slight strength, and they conduce to my comfort. Heroic warriors eager for encounter, do not fight thus.","alignment":{"type":"grouped","confidence":0.607,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-43"],"status":"unreviewed"},"source":{"sanskritLocator":"6076017","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d6c14f2e598a8620023fa0eb7f00c4e665bfa3cd0cf852f2149d94bf6ed7845","compact":"b61b8e287f8ac3d17b7ad5af9d4a14934cdaf745e27c1b67eb3e19790a7e9f61","nasal":"88561cd221ca246aae78020883ea2a75c108e9f3a05f9bb74db871f3c2fb1194"}},{"id":"VRCE-6-76-18","kanda":6,"kandaId":"yuddha","sarga":76,"verse":18,"english":"Speaking thus, (Laksmana) accoutred with his bow showered vollies of shafts (on his adversary).","alignment":{"type":"1:1","confidence":0.431,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-44"],"status":"unreviewed"},"source":{"sanskritLocator":"6076018","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5d2182676887760ba4f6237f559dd3725b0ff3cbbf1eb09e61bf52a2d979fcec","compact":"e07be20c0d91b72f36c756658431018810722504284e286b45c161633cc70326","nasal":"ecaae160c14ed19670b4aac76afe1f58b4abdcae17c53863ea77a0908d54641d"}},{"id":"VRCE-6-76-19","kanda":6,"kandaId":"yuddha","sarga":76,"verse":19,"english":"And at his arrows (hitting), (Indrajit's) mighty golden mail fell off his person, and dropped to the platform of his car like a cluster of stars dropping from the welkin.","alignment":{"type":"1:1","confidence":0.587,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-45"],"status":"unreviewed"},"source":{"sanskritLocator":"6076019","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cc2d0aae4fe607335eaa6b586015de00de222ecf0eb05dfb8d9ca983d335589c","compact":"d583cdda4ee0c04323c52f9ff59710ec30dd5cd139f6df9dd5395f9a8aa79518","nasal":"b1c2be7e122fecce8ec8dd9f6052c8cf9908f3e1cf9f6362b31a2d18e40e2144"}},{"id":"VRCE-6-76-20","kanda":6,"kandaId":"yuddha","sarga":76,"verse":20,"english":"With his armour dropping off, that hero— Indrajit was wounded with nárachas, like the Sun at dawn.","alignment":{"type":"1:1","confidence":0.655,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-46"],"status":"unreviewed"},"source":{"sanskritLocator":"6076020","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3ae9c9f7523b41fe16f42b658a021951facc5dc1ce784f1a440c8e3239cff5b4","compact":"28876329dd2bfe8c2cf727b3676e05224b6b6da254176fa7e00d452faf2424e4","nasal":"24bd556299bf3a26d99a0cc9efdf9abbebf11629306d4f5b6a77c92640742bae"}},{"id":"VRCE-6-76-21","kanda":6,"kandaId":"yuddha","sarga":76,"verse":21,"english":"And sighing again and again, they faught furiously. And with their persons cut all over, and laved in blood, for a long while the heroes kept cleaving each other with sharpened shafts.","alignment":{"type":"1:1","confidence":0.536,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-49"],"status":"unreviewed"},"source":{"sanskritLocator":"6076021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4671a96e7b897145d1527cdd68b049709c35d64e39ecab5cb741515b1a05c6c6","compact":"75a7cd575ff620086bc1aa6ac03a8b9a812946e6e771c81afd25260586da04e8","nasal":"edcb02320000ad086198dda63b8b227160390fbc24c448fae25be0b0f9278167"}},{"id":"VRCE-6-76-22","kanda":6,"kandaId":"yuddha","sarga":76,"verse":22,"english":"Those foremost of those acquainted with weapons repeatedly displayed their weapons; and their long and short shafts enveloped the welkin.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-54"],"status":"unreviewed"},"source":{"sanskritLocator":"6076022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8cdce99b1c15eb4d0a4c3b4930d63612508c9475e804be42e2d62bf213c56171","compact":"4a14816b8dda6086c8b23d79a703cad1b80090c76cf833a3745f6747b2954d4c","nasal":"5554b50cee04b761de82e20abdd83a03079badbcb4cb46be3ad05b5585f6ff76"}},{"id":"VRCE-6-76-23","kanda":6,"kandaId":"yuddha","sarga":76,"verse":23,"english":"The skill that they displayed was perfect, and showed lightness, variety and grace; and both man and the Rākşasa carried on fearful and terrible conflict.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-55"],"status":"unreviewed"},"source":{"sanskritLocator":"6076023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d10df611ff521a8592eed26909e2ec32cd96850b54ea249de8550aada268ec2","compact":"fdc856a4def94f422bd57a42976034668acc405cb6957a40803b50dc212da6d9","nasal":"540572b661cabf7dbf8fe8e89dc5665f1adfbf1908fa682424fe2bc405227297"}},{"id":"VRCE-6-76-24","kanda":6,"kandaId":"yuddha","sarga":76,"verse":24,"english":"The dreadful and tremendous roars of each were audible (at that place); and terrific like the levin, they made the hearts of hearers tremble (in terror).","alignment":{"type":"1:1","confidence":0.339,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-88-56"],"status":"unreviewed"},"source":{"sanskritLocator":"6076024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1381347e00f8341e1ebe32a79e4e6bf