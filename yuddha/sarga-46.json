–94"},"sanskrit_fingerprints":{"exact":"fedde532cef2eb0af2bab39c059a2714654669ae497b572275b6f5cd01110895","compact":"5c92b7afa620024ccbda8aa4611d15fcfe3af1e837114888e5599a0a02e13894","nasal":"5c92b7afa620024ccbda8aa4611d15fcfe3af1e837114888e5599a0a02e13894"}},{"id":"VRCE-6-46-21","kanda":6,"kandaId":"yuddha","sarga":46,"verse":21,"english":"Then there the two hosts mingled into almost a vortex; and the sounds that arose from those infuriated once of immeasurable might, resembled the roar of the ocean.","alignment":{"type":"1:1","confidence":0.603,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-58-22"],"status":"unreviewed"},"source":{"sanskritLocator":"6046021","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"18c29bda76b4b6d233e8db7269c5c2193772d3caaeaa573b869619a7d6bd501a","compact":"37fdc94253831b011495c77f14bae2b911ed86158e0a9989fa575a25a0acc6af","nasal":"37fdc94253831b011495c77f14bae2b911ed86158e0a9989fa575a25a0acc6af"}},{"id":"VRCE-6-46-22","kanda":6,"kandaId":"yuddha","sarga":46,"verse":22,"english":"In terrific encounter the enraged Rākşasa irresistible in battle drove the monkeys to sore straits with showers of arrows.","alignment":{"type":"1:1","confidence":0.579,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-58-23"],"status":"unreviewed"},"source":{"sanskritLocator":"6046022","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bcb0f1273d233750345ff28e6a950c7af10939ab0392b9c571ce5aee587a94f5","compact":"3758402eccafde190380f0c4b971315277592559f2cacb96781e33d16ac7a673","nasal":"3758402eccafde190380f0c4b971315277592559f2cacb96781e33d16ac7a673"}},{"id":"VRCE-6-46-23","kanda":6,"kandaId":"yuddha","sarga":46,"verse":23,"english":"The earth was covered quite with the terrible bodies of monkeys and Rākşasas; and it looked as if covered with mountains.","alignment":{"type":"1:1","confidence":0.571,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-58-24"],"status":"unreviewed"},"source":{"sanskritLocator":"6046023","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f3ed6399169630b9e425f84d9c6e9b897e0d5109371eb95af0dd088332d1c41","compact":"c43f24b1773d83aabb191e4671e87101cae29c72925fee101ee719593c7ccd3f","nasal":"c43f24b1773d83aabb191e4671e87101cae29c72925fee101ee719593c7ccd3f"}},{"id":"VRCE-6-46-24","kanda":6,"kandaId":"yuddha","sarga":46,"verse":24,"english":"The earth drenched with streams of gore looked as if swarming with blossoming palāśas in the month of spring.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-6-58-25"],"status":"unreviewed"},"source":{"sanskritLocator":"6046024","sanskritFile":"Ram06.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"80284c4c18a9c392351dfae22392c704f69faa096d889d19c6cf26b7a955cbea","compact":"3cfe24f4b335e16ca8e403563a9680f0bbf4fff1649bb84df6d123d36b9de968","nasal":"61e24a11945afc99aef0f2f42430934c0acf2d9372eb25ccd4c1fae31e0fd2c9"}},{"id":"VRCE-6-46-25","kanda":6,"kandaId":"yuddha","sarga":46,"verse":25,"english":"As leaders of elephant-herds cross a lotus-tank covered with lotus-dust, those Rākşasas and choice monkeys crossed that river flowing in the field of conflict incapable of being crossed; having for her banks hosts of heroic warriors slain; for her mighty trees broken arms; for her volume of waters showers of blood; coursing to Yama resembling the Ocean; with livers and spleens for her vast slime; with scattered entrails for her moss; with riven bodies and heads for her fish; limbs for her lawns; swarming with vultures for her swans; with Kankas for her cranes, filled with fat representing her foam; with the roars (of warriors) for her sounds, incapable of being crossed by cravens, and resembling a real river swarming at the end of the rains with cranes and swans.","alignment":{"type":"grouped","confidence":0.839,"method":"shared-sanskrit-ngra