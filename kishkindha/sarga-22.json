874c135b7894b96778e20892683e4","compact":"51a00685513364ff00fa447e40846ddd5cd72c5a70d36ed67006999aed8e03ca","nasal":"2d6370036da4b11d31f4b2a8577aa1a1afe2615c47e3978e5d35d5f79e8bf8d2"}},{"id":"VRCE-4-22-7","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":7,"english":"It behoveth you, O hero, O king, to perform what I shall speak to you in this plight, however difficult it might be.","alignment":{"type":"1:1","confidence":0.903,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4022007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a71f20e71070990758da04fd8d22facd38f67f28a026d97992d4878eca4cd71b","compact":"80e1042fdd7e3c832e7222ae57c72fadb29eaadbfcbf90650ecd4f4eaa9d92c2","nasal":"80e1042fdd7e3c832e7222ae57c72fadb29eaadbfcbf90650ecd4f4eaa9d92c2"}},{"id":"VRCE-4-22-8","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":8,"english":"Do you behold Angada fallen on the ground with tears in his eyes-a little boy, incapable, brought up in luxury and deserving happiness.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4022008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8d32257b979ab3d30a80c549bf2680b631d8cee16f4d1b05e8f088294d8e327","compact":"a48ba62ab5de829f7f090b36cd1929b480b000b438509306bbcf65ef23ae3815","nasal":"db5f1e62880a756938465e650b91d2d9b3913f68c81cf92950e9116b2d0fe2fc"}},{"id":"VRCE-4-22-9","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":9,"english":"Do you maintain this my son, dearer than my life, like to your own son, born of your loins, satisfying all his wants in my absence.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4022009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c53973b6d212d1aa77fa64f0ac6035779f99269dbbd5efd2a8d0d21c11f9449b","compact":"74db69100a95621eac7f816b573f9385910691cc27924eb170d6d15c5a5c24d4","nasal":"74db69100a95621eac7f816b573f9385910691cc27924eb170d6d15c5a5c24d4"}},{"id":"VRCE-4-22-10","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":10,"english":"O best of monkeys, like to me, you are his father, protector, conferrer of gifts and remover of fear.","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4022010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9a5e1e0da8d6304a5c038d0063bcc8530836b4c2198bf7deae29c668e2a657c9","compact":"56ce2a16551e432a851d6ed75576945cccb1ddc0c2bfdd65f1969fdf0277171b","nasal":"56ce2a16551e432a851d6ed75576945cccb1ddc0c2bfdd65f1969fdf0277171b"}},{"id":"VRCE-4-22-11","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":11,"english":"This graceful son of Tārā equals you in prowess and shall precede you in the destruction of Raksasas.","alignment":{"type":"1:1","confidence":0.859,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4022011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a5bd3daf99c50b2ac3ba6e48656a41cee8ca6ab71107c014db47ce458db5335f","compact":"60c214d37905c5f92620dbb06e15fffef3c8666dc63cd973fbe54bbc2b776844","nasal":"60c214d37905c5f92620dbb06e15fffef3c8666dc63cd973fbe54bbc2b776844"}},{"id":"VRCE-4-22-12","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":12,"english":"This youthful Angada, Tārā's son, gifted with energy and strength, shall perform befitting exploits displaying his prowess in the battle.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4022012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"800baa643d038362b8f3d64cfbde2b83bea9457730dd251cb1cf231d44873e18","compact":"2b589b91905860ad2e692b9ae185d1cd64835ddaa0791b4ca7a3dad8f939e47c","nasal":"1906819a0f47abd6ca2675fe139045cf66698cf81aa7d3c3c530457bb28368c0"}},{"id":"VRCE-4-22-13","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":13,"english":"Surasen's daughter is wonderfully expert in ascertaining sabtle things and giving counsels in the time of danger.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4022013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"106d067b7961f10fb82f490555907be813f2c0bce97f7fff2ae76e7bef6a41b3","compact":"ee6ecb1802a151453c4ba891a9c8c3e5ade62e414c4721f48d88ac837dbda5ef","nasal":"ee6ecb1802a151453c4ba891a9c8c3e5ade62e414c4721f48d88ac837dbda5ef"}},{"id":"VRCE-4-22-14","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":14,"english":"Do you, without the least doubt perform what shall the chaste lady instruct you to do; for Tārā's advice never goes without effect.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4022014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6278c1fd348601762967fd72aa92fe1477eb9d0cc00d9fe1f2cabaab34f76564","compact":"88646bcc957d420fde638c25f05d11b226839ee59e3cbb694569e8693adbc097","nasal":"88646bcc957d420fde638c25f05d11b226839ee59e3cbb694569e8693adbc097"}},{"id":"VRCE-4-22-15","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":15,"english":"It behoveth you to perform Rāghava's service fearlessly or else you shall be visited with sin: on his being insulted you shall be injured.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4022015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6ff2848d4a107709e1f9d4b7e647c29c074602dbdbabddbe31e34776d3f8cd1d","compact":"90d44b30a4d3bda44b17690797b5295092504c761adef0737e9575ce451163e9","nasal":"413928a5795ef284c4f98a577044064ed7b303858cb18f01cbbf895f56c4db57"}},{"id":"VRCE-4-22-16","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":16,"english":"O Sugrīva, do you put on this celestial golden garland-herein dwelleth the bounteous Sree who shall renounce me after my death.","alignment":{"type":"1:1","confidence":0.895,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4022016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d272422a62ad0216853a74789a52dc76208e127d92689209e3e83e563dea4b2d","compact":"fabf00987b3d7d4e5ca21e7a8c363e7a2c6cb5b09d900c9b2f9d0797807ad597","nasal":"a6156791eeb25d0f1e12007f4ed3bd7ac05359d90bef52ccb1b0bcd0b5278986"}},{"id":"VRCE-4-22-17","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":17,"english":"Having been accosted thus by Vāli, out of fraternal affection, Sugrīva renouncing joy again became pale like to the Moon possessed by Rahu.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4022017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ed9fab55918734482fa392b62090d6d522cfca70a7b16b16c719c0540adbecb5","compact":"3ac237564c5bb9b3da3dc5602bf455368a4d402f9e56ce16a887910c8c7e786f","nasal":"3ac237564c5bb9b3da3dc5602bf455368a4d402f9e56ce16a887910c8c7e786f"}},{"id":"VRCE-4-22-18","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":18,"english":"Renouncing his inimical feelings, being thus addressed by Vāli and carrying out his words energetically Sugrīva accepted the golden garland as ordered (by him).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4022018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bfc2b72fb09df6a0c1a0416deb137061d99418434f5c77ce3e813a5dda07a591","compact":"a89022c94d919e2d5594e0890eb05b87c6277acc0d78ed379c03dce921470f78","nasal":"3468d91a5c6a299682d25aef9384af8ad291c927edcaa33f6830cdbfc6346ce5"}},{"id":"VRCE-4-22-19","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":19,"english":"And conferring (upon Sugrīva) that golden garland and beholding his son before him, Vāli, resolved upon death, spoke to Angada, saying.","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4022019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a5c3be14c2f4026bf6992a8daecf09185664179b3ce05e3b7b9325dc28dc5de","compact":"615ffc6ead1c1f34249e5c604026012621eed8798efc7cbf4a541fe23a964890","nasal":"3d031fb9b93e1069a7ab5b387d3d4e8fac63667c649428d8f71ab7ace6632740"}},{"id":"VRCE-4-22-20","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":20,"english":"Do you place yourself now under the control of Sugrīva, ascertaining time and place, putting up with misery for your welfare and injury.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4022020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"712238251f69b675432308c402d63ead43f08a108a93e22c3b8a1db760d96736","compact":"1c9def1da4cd96c331dc4ae9c243fbec31739b2b3c6d7453d14cbd66d50b12f5","nasal":"1c9def1da4cd96c331dc4ae9c243fbec31739b2b3c6d7453d14cbd66d50b12f5"}},{"id":"VRCE-4-22-21","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":21,"english":"O you having long arms, Sugrīva shall not regard you much, if did you remain in the same wise in which you hadst been brought up by me before*. The significance of the passage is as follows:You wert a mere child while I brought you up. But now you are a grown up young man and this is the time for you to serve your elders. Do you therefore serve Sugriva.","alignment":{"type":"1:1","confidence":0.895,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4022021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"825676449db0984493e48b83a85340d5da7f09b993a09d1edaab7bad8b41d3b9","compact":"5273bc65d5ac8ff3ae55427a823c599f4624253c8418c7223a6ed0b4396f3bbe","nasal":"5273bc65d5ac8ff3ae55427a823c599f4624253c8418c7223a6ed0b4396f3bbe"}},{"id":"VRCE-4-22-22","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":22,"english":"O slayer of foes, do you never mix with Sugrīva's enemies, and place yourself always under Sugrīva's control, having subdued your senses and being intent upon your master's (Sugriva's) welfare.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4022022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f39dfd3741c32b17c385f09f9e5d221db9894e8ce354b55dc4ddfe21b9ee6e80","compact":"dfc72efda2c2a597b6362ec4c6e7a2d205e8a6ac1bb98f816093f2f56677aa2f","nasal":"361970fd26420852fd75220b57af28a6d258e0efa54ac7909ff68ffb62b2e704"}},{"id":"VRCE-4-22-23","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":23,"english":"Do you not cultivate too much of friendship nor be wanting in it-for both of these extremes are sources of disasters. Do you therefore follow the golden mean.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4022023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1cfa6a0ffe47330edb6339c93e50f901a92d85afdbf222d5235d3baefc620d70","compact":"5a49df63712555577f9c2664eb83810272f697906b51455d9a3638dfee1aa79f","nasal":"e4da52b04338d8649013ffe17b8ddf889996206fd9458172b0b303cfcc6d76ed"}},{"id":"VRCE-4-22-24","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":24,"english":"After he had said this, his eyes became expanded, his teeth were opened and his appearance became ghastly. And greatly pained by shafts he breathed his last.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-24"],"status":"unreviewed"},"source":{"sanskritLocator":"4022024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3f2d039be6b74b52093a5ff2d92f1fb19a525f497b8acfd7adff32821e1130bd","compact":"55272c1c0e12447a3c77d31706d199daeb662092b7840ebcbe3519703b8beb9f","nasal":"37d0ea38c9ee5c8fed0d14d0a8bc3a82763d9c85c4ebf25d27e8573aa9c063fb"}},{"id":"VRCE-4-22-25","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":25,"english":"Like to kine, incapable of enjoying peace in a mighty forest filled with lions, their chief being dead, these forest-rangers could not attain to felicity on the demise of that lord of monkeys.","alignment":{"type":"1:1","confidence":0.829,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-28"],"status":"unreviewed"},"source":{"sanskritLocator":"4022025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5468f844286b3d99331d67e7080b40d6e8a375703ec7ad3e4edbb4f11991c241","compact":"2f11dbf8d8410874ca74d9be8cc8ab9270f66b69d387fd9e614402af4222a21a","nasal":"2f11dbf8d8410874ca74d9be8cc8ab9270f66b69d387fd9e614402af4222a21a"}},{"id":"VRCE-4-22-26","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":26,"english":"Thereupon, Tārā, sunk in the gulf of disaster, eyeing the countenance of her deceased lord, fell down to the ground embracing Vāli like to a creeper clinging for its support to a mighty but broken tree.","alignment":{"type":"1:1","confidence":0.823,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-29"],"status":"unreviewed"},"source":{"sanskritLocator":"4022026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"58419d7413ee152a5abee51679935863c061ced352572173e54c867b0b0324a4","compact":"ebb36c5eb31200bbae7716f875d1b75498d01997d4098908c5a91589e6cd3eb8","nasal":"ea7c0b70dbc6b7db3bce20f503fd3d2d987ec70cc6ef9a334e57f16c6468a88f"}}]
