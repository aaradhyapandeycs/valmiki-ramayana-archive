[{"id":"VRCE-4-22-1","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":1,"english":"Vāli, ranging on the verge of death, casting his looks arounds and sighing faintly, espied his younger brother Sugrīva before him.","alignment":{"type":"1:1","confidence":0.794,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4022001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d3ac26f92253785bca65272b49cf893e7155fa8140c821957dff5c1e717f02b","compact":"a14078b60e1f4f190d17e0405d488de50e9811ce1f8dfd5b3b85e395b59d7b29","nasal":"7d417c417631bb915f656abb3206adf0fa2d34d4f3f74d332b6e15694fe01eee"}},{"id":"VRCE-4-22-2","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":2,"english":"Welcoming that lord of monkeys with clear accents, Vāli addressed him affectionately saying.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4022002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f551e14384f29aea6b1d7a2f7f6e91cf76694be9a2e6fe6eaa7ed7a24547e6cd","compact":"e338ba4597eeb0c6107a222e45d59c9b4de9378336c5a676a722f8367113bc06","nasal":"e338ba4597eeb0c6107a222e45d59c9b4de9378336c5a676a722f8367113bc06"}},{"id":"VRCE-4-22-3","kanda":4,"kandaId":"kishkindha","sarga":22,"verse":3,"english":"O Sugrīva, do you not take to your heart the improper conduct I have shown towards you, being attracted by inevitable foolishness, subject as I was to sin.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-22-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4022003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dc6385b3674ec98422a4aa35be9fdc5f6e4f6b12d5e949c957304f8e5586c3d1","compact":"ab8101130c888f43859d12fe4f08e7536b1aa3910213d139