[{"id":"VRCE-4-54-1","kanda":4,"kandaId":"kishkindha","sarga":54,"verse":1,"english":"Hearing Hanuman's speech, uttered meekly, fraught with morality, and reflecting honour upon Sugriva, Angada said,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-55-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4054001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"20457e14182c9ae2ad8e175786152a3a1efebefec1e8f378fa7d7d7f874926f3","compact":"558e6e7f95a7c223d2e6b6ccbe88c6d423052542ba806858b9dc4143751f1da6","nasal":"ac60e99c2ee922da99511f9db47d51f51784303d40740e6affa4746f0cdb28c4"}},{"id":"VRCE-4-54-2","kanda":4,"kandaId":"kishkindha","sarga":54,"verse":2,"english":"Firmness, and mental sanctity, mercy, candour, prowess, and patience, are not in Sugriva.","alignment":{"type":"1:1","confidence":0.618,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-55-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4054002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b0dccd1a505cbd97f1a429a2c5647e450251684bd48ee5ef40d97d83a61b9d8","compact":"a7e0d31947b71270af864fb3d3926dd34a3a4862ddfd35d28fa5c3141695c2b9","nasal":"a7e0d31947b71270af864fb3d3926dd34a3a4862ddfd35d28fa5c3141695c2b9"}},{"id":"VRCE-4-54-3","kanda":4,"kandaId":"kishkindha","sarga":54,"verse":3,"english":"He that, while her son is living, appropriateth the beloved queen of his elder brother, mother to him by morality, is hated (of all beings). How can he that could cover up the mouth of the cave, when he had been desired by his brother gone on martial mission, to guard the same,—(how can he) know morality?","alignment":{"type":"grouped","confidence":0.787,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-55-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4054003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":