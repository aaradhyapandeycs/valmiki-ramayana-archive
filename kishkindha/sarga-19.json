[{"id":"VRCE-4-19-1","kanda":4,"kandaId":"kishkindha","sarga":19,"verse":1,"english":"Being thus accosted with reasonable words, that lord, of monkeys, lying on the ground and wounded with shafts, gave no reply.","alignment":{"type":"1:1","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-19-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4019001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9edce64f4895924eee16874ce99b7233b178b75e404235942a18a3dbaae880c5","compact":"ac40accb4b96f7f8888c4b02f1eb4a2738229c05f4d467e1b499fd3f951a6fcd","nasal":"ac40accb4b96f7f8888c4b02f1eb4a2738229c05f4d467e1b499fd3f951a6fcd"}},{"id":"VRCE-4-19-2","kanda":4,"kandaId":"kishkindha","sarga":19,"verse":2,"english":"Having his limbs dissevered by stones, being struck with trees and wounded by Rama's shaft, he became senseless at the approach of death.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-19-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4019002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f5ddc7ba8adc5d17db26353f02ef8aa0f47b092f3ea51202af2907aa1eabd05d","compact":"ad1a9ae69ac989aa0fdbe40d8e8b71f616b68e0d6ba573c7efaae0a1fe0ba569","nasal":"fd908ff8db73817baddf30ec3c2aa67e2bae71942e862337801d6ed123006414"}},{"id":"VRCE-4-19-3","kanda":4,"kandaId":"kishkindha","sarga":19,"verse":3,"english":"His spouse Tārā heard that Váli, the foremost of monkeys, had been killed in the conflict by Rāma's shaft.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-19-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4019003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5750a6e464347848199eb2a8b5953a5eea2ccc17a2e2c7953d54293f3ec92e8c","compact":"47e4b7cb1ac4b9a7b7433df701ef6379297324e4d8260b84f0670cdd9df