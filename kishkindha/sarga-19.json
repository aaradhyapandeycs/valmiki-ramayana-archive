-ngram","duttRefs":["DUTT-4-19-20","DUTT-4-19-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4019025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c7e99e067321f53a51c9bebbdf9ff90b806f2eb69bbc1177b5bdfb2133d18d66","compact":"b5557bd2af667f5479829d07e488dcdf4dbe89877749479094e122cfbc33dcf7","nasal":"26ac0ae1a8e22d9c7757a64cc306f27f4ce2d9e94a6b7f72545bb4909daf3f0a"}},{"id":"VRCE-4-19-26","kanda":4,"kandaId":"kishkindha","sarga":19,"verse":26,"english":"She espied Rāma reclining his person on a mighty bow, his younger brother and her husband's younger brother. Passing them by and getting at her husband and beholding him killed in battle, she, losing her sense, fell down to the ground.","alignment":{"type":"split","confidence":0.414,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-19-21","DUTT-4-19-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4019026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0729456db2e496f415a3ddc7c47ccf6eaaa88829c0286dc56df11393012fac6d","compact":"f657bff87eea84f05b8a0c9b8785f4305099f2309a2e9cc3601ce2367fc52866","nasal":"f657bff87eea84f05b8a0c9b8785f4305099f2309a2e9cc3601ce2367fc52866"}},{"id":"VRCE-4-19-27","kanda":4,"kandaId":"kishkindha","sarga":19,"verse":27,"english":"Passing them by and getting at her husband and beholding him killed in battle, she, losing her sense, fell down to the ground. And thereupon rising again like one asleep, she, beholding her husband engarlanded by death, cried aloud, exclaiming O son of worshipful sire.","alignment":{"type":"split","confidence":0.338,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-19-22","DUTT-4-19-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4019027","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f9d64e157991842f8cf695fa1f51616ec121c8380b2adffec3795ac3e04b514a","compact":"56fe28214b896f6150fb2