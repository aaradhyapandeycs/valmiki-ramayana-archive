[{"id":"VRCE-4-1-1","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":1,"english":"Repairing with Lakşmaņa to the lake Pampā filled with red and while lotuses and fish Rāma having his senses agitated began to lament.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4001001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"adfb93f83c0853909cc6a0bda1b0439bfb0a66bd66ce835c1c28bf11bf9258f6","compact":"8120613ddc89d1c78d850672437770f3ca53ce663a8ada461b25add06ecb4dfc","nasal":"805510cb7911630b83395740d1c3e62ad9eb61ba3e13b14bdb23103233e87760"}},{"id":"VRCE-4-1-2","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":2,"english":"And beholding there that lake, his senses were stirred with delight. Troubled with passion he spoke to Saumitri saying,","alignment":{"type":"1:1","confidence":0.939,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4001002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3734ca549b12a32b9f71a6b3018eb08ddd9147f704fd00b4776994bec6886ae6","compact":"9f975f15e135139e94f98ba78dbea15f925aedda968e6fd2e9b96fb31e554b0d","nasal":"bb1071236d90e827756cb7f491eeabbd0b61c2e695c53c8d40cc0bf4996fbd9b"}},{"id":"VRCE-4-1-3","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":3,"english":"Observe again, O son of Sumitra, the picturesque wood-land around the lake, where trees, crowned with large branches resembling the summits of a mountain, appear like so many hills.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4001003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a8e1c5b9d9ae522517f6bcad45984ebe014d6e22c9d25e3ad32e452e4c9ad4fc","compact":"4