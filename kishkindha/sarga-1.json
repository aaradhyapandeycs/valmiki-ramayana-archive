4-1-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4001006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"afc8923a1c21ffc837359846e734ccc9f7719c6c9bcc601129b1b298c6fa0941","compact":"b5cb0ea4c20a497561d85de5fd40df4929778e1e9d9ff1d32d5899bd4578495c","nasal":"fd098f761aec3bdf32a63a4b510a6c42cd22a37f013fc8fe7b4bf3fa3ce58aa2"}},{"id":"VRCE-4-1-7","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":7,"english":"Behold, O Saumitri, the beauty of the flowery woods, showering flowers like to clouds pouring forth rain.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4001007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cbed2a2c3de29bdb623deb0426eb3266c60e6f95b7bf7740e3bdc210e399cc37","compact":"64dc8bf67691af75efb1b2868ec292fb8fb1b75c582e7064e4a21d81aed3065d","nasal":"64dc8bf67691af75efb1b2868ec292fb8fb1b75c582e7064e4a21d81aed3065d"}},{"id":"VRCE-4-1-8","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":8,"english":"Various trees growing on rock surfaces, moved by the wind have been scattering flowers on the earth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4001008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cee07b1fcdafc584f016346dd3246927be9a5797bb8c8e477b1664468aa5642b","compact":"b5912a24933a58d36db62c76518f99e993de574292682cdce06407ea58c0b33a","nasal":"6e87735ab51b20f93dfc3c99b392b51a2a6f1b535783226c43bfc435ecb76244"}},{"id":"VRCE-4-1-9","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":9,"english":"Violently shaken by wind the trees in this nectar-smelling forest are sounding as it were with the hum of bees.","alignment":{"type":"1:1","confidence":0.458,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4001009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"855842af67522b70395791b2aa4753405b10a54c1a06b667ac53dbbf499f0ffb","compact":"9a36877ecbf94a55adb7ae6350df96ebc3d594154bb1da2b440b1211c9fcc0dd","nasal":"f9a92243f6acc66284c9b549527eb30824419cc32591f16f6457a8c79f73e667"}},{"id":"VRCE-4-1-10","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":10,"english":"Hillocks over-topped with picturesque and flowery trees stand beautifully on this mountainous expanse.","alignment":{"type":"1:1","confidence":0.894,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4001010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"172a8c0b2f11123aa66f3941781d178108f26132aa4e9f81754b272290b7d05c","compact":"d4b504f913e002544098e1536f6fca4927ebbbdad8c4ed44cf32f30720e94118","nasal":"1dfc3417639217edb9a5c4582376ed60f9b8e615f4075c4e1804d563170fe4f7"}},{"id":"VRCE-4-1-11","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":11,"english":"Behold, the Karņikāras covered with flowers appear on all sides like to human beings decorated with golden ornaments and wearing yellow cloths.","alignment":{"type":"1:1","confidence":0.704,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4001011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d35fd1b8b9a03675fa6502535440d7576e902fd99e216466c182e78adc60f2c5","compact":"e99ec3c4c4c57900b0c1755157c225142718efb1f258dd59b4bcc9fab49b8dad","nasal":"239b64def69dbbee282e4e2fc278bb38e9a0e5ac3bb0d3222bcac6afcbe7cc2c"}},{"id":"VRCE-4-1-12","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":12,"english":"This spring, O Saumitri, sounded by the musical notes of the birds of different spacies has been kindling my grief who am without Sītā.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4001012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1a6a9e89a340752fa0d364601d9dbb850410bf7814df17ccecd41cff6bdcc9bf","compact":"441c14f7c51d1df5f72be4895988fd33ec47b6075928ad57eeae0ec8f1c36dee","nasal":"d5d5168750a7cf10079149fd847186936bd95c811492986c23a5833bf9962c9c"}},{"id":"VRCE-4-1-13","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":13,"english":"Cupid has been smiting me the more who am stricken with grief, and the cuckoos have been defying me, displaying their mirth, O Laksmana.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4001013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4f05e55d7d9a7d8d5bb46140f65b08ded747d9fdc0043cbba1cf36bdd4ea40da","compact":"0126773d07c6bd80fd00cf7f7a02f2253cddb34174e6f13f8513b1f25d7d7fbc","nasal":"402b87ea796a8376ed38024ee7a245ea8a8511619f8b1e219a46a29f6ea83240"}},{"id":"VRCE-4-1-14","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":14,"english":"At the pleasant fountains the delighted Dátyūahas with their warblings have been afflicting me who am possessed by Cupid.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4001014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7218979537a4923c9aec4fe4f1d96b9b59197393ea4b3bf8cfeb247bc5c870d8","compact":"3e6043128d95c947b75de88526fa0b08cd86baba8f1e3a44c1c230f63324928d","nasal":"3e6043128d95c947b75de88526fa0b08cd86baba8f1e3a44c1c230f63324928d"}},{"id":"VRCE-4-1-15","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":15,"english":"O Saumitri, birds and bees of melodious notes accompanied by their co-mates and delighted with their mutual companionship are on the banks of this lake.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-25"],"status":"unreviewed"},"source":{"sanskritLocator":"4001015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7484af6faa5f9427a8daa862471d229604f84f9ce3e458e62bd6d466e4849458","compact":"4a2c63c1702e0217cf62c6fc713d3c3d5491547aa3ab5b87fa447701589a2af1","nasal":"85551668646ab032d532bae61d7c3f5e7a81b05259827989c0562043336831f0"}},{"id":"VRCE-4-1-16","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":16,"english":"That one having the eyes of a fawn and ruthless vernal breeze, O Saumitri, have been oppressing me who am overpowered with anxiety and grief.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-33"],"status":"unreviewed"},"source":{"sanskritLocator":"4001016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e19b076df397c8b7e202a0988858069331c1d5ec99af781a8fedd44139d2a4d2","compact":"5a07b5df4c255fc79343e8a1d65363145b77cd6ce155f90509425683354708d7","nasal":"379d231e0e4faf46323844ada126982a2d3fdc3f0da877501f4a75588eeeaf23"}},{"id":"VRCE-4-1-17","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":17,"english":"These maddened peacocks encircled by the pea-hens, have been aggravating my amorous desire who am already possessed by the Cupid.","alignment":{"type":"1:1","confidence":0.585,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-35"],"status":"unreviewed"},"source":{"sanskritLocator":"4001017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ba7c8c41f34ba218c98ee8cbac32a0b790d8d2be50d5cf03153713cc2435641","compact":"ed087ea44a59583ac13e5daeda1aac3ef5539dbe0788a25c91fae4c3574742ab","nasal":"ed087ea44a59583ac13e5daeda1aac3ef5539dbe0788a25c91fae4c3574742ab"}},{"id":"VRCE-4-1-18","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":18,"english":"Observe, O Laksmana, there dance with her dancing mate on the mountainous expanse, the pea-hen, troubled with amorous sentiments.","alignment":{"type":"1:1","confidence":0.645,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-36"],"status":"unreviewed"},"source":{"sanskritLocator":"4001018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72955a8e3bb69967e2519a32db3e693b16336606d2764ff6a05eef299be069e5","compact":"48be90068673a9f68d3407dfcd59e55fdbdf655a058101332b45eecbe5e0f996","nasal":"e6116e476b8b87815b472b52b3f0e88d51402c5849f43f2b095987bd049b457f"}},{"id":"VRCE-4-1-19","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":19,"english":"Surely the Rākşasa has not brought my dear one in this forest of peacocks and therefore they dance with their mates in this picturesque forest land. It is unbearable for me to live without Sītā in this season of flowers. Behold, O Laksmana, this attachment is to be seen even among the brutes. The pea-hen being influenced by passion is approaching her mate.","alignment":{"type":"split","confidence":0.429,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-38","DUTT-4-1-39"],"status":"unreviewed"},"source":{"sanskritLocator":"4001019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"098de160c0ca9c958b57da6e2426789cf18af402e44d5300e175de3347b35dc6","compact":"0e281dc822a3680f41cac876835fcbb797c5ed6e7cdf987036b99d62d66b7a20","nasal":"0e281dc822a3680f41cac876835fcbb797c5ed6e7cdf987036b99d62d66b7a20"}},{"id":"VRCE-4-1-20","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":20,"english":"Behold, O Laksmana, In this season of spring flowers of this forest rich in their load of flowers are of no avail to me. These pleasant flowers of the trees have been uselessly falling on the earth along with the swarms of black bees.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-41"],"status":"unreviewed"},"source":{"sanskritLocator":"4001020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6af80918a5c3683bb73e8aac3a8510815493a9a2555097bfd722baf10f43ef41","compact":"5860e85b1a9b1235e37393095c1a26524e03dfe1201cda5cf991b271d6ecbcd2","nasal":"cd42c71788771c9c52d0bc94bb318716b6e35acf94922003f92321d0084aa03b"}},{"id":"VRCE-4-1-21","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":21,"english":"The birds exciting my desire have been delightedly warbling in flocks as if welcoming each other.","alignment":{"type":"1:1","confidence":0.552,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-42"],"status":"unreviewed"},"source":{"sanskritLocator":"4001021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb38bafe202cdd2992a458a26dbcc7232922de0e21cabd07c06562fb8b568c6e","compact":"c7d74ce783708d685e7d8f764f4aa121610d03341f8cfc8eaf66df6312d4651a","nasal":"7a91dbbceed2c2cdb929a4ce0047f61906c1a0ca3e8a5c3c94c3dc885897a475"}},{"id":"VRCE-4-1-22","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":22,"english":"Surely shall my dear wife of a slender make, having eyes like lotus-petals and of sweet accents renounce her life at the appearance of this spring?","alignment":{"type":"1:1","confidence":0.509,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-46"],"status":"unreviewed"},"source":{"sanskritLocator":"4001022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6302f52a591c651b043d0d1ebf0e37930121e87fbb6d98ae2e1f3cc0cdefe37a","compact":"c2f3cf45e661a4015aa98259d4b9b874549ff84cf8a38d2e52d5425f5f261e1c","nasal":"c2f3cf45e661a4015aa98259d4b9b874549ff84cf8a38d2e52d5425f5f261e1c"}},{"id":"VRCE-4-1-23","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":23,"english":"This cool breeze of a pleasant touch, carrying the fragrance of flowers appears like a fire-brand to me who am thinking of my spouse.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-49"],"status":"unreviewed"},"source":{"sanskritLocator":"4001023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"390925b59841f8258bf4c6ec39eaddbec29c1803520fbea058a2fcc929088dd6","compact":"50fedbae18f27d69668f9315a9d6b717f4b2376afc63b333674b38fab447c8e4","nasal":"dc41fcba188dea2a8edd62b055dacf070adb912e8a81044f55a3dd8239ee5bf0"}},{"id":"VRCE-4-1-24","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":24,"english":"This bird set up a cry in the sky at that time* and now in the absence of Sītā, that crow, sitting on the tree is crying delightedly. This refers to the time when Rāma was united with Sītā i.e. at the time of his wedding, At that time the bird, flying up in the sky set up an inauspicious cry indicating that in no distant time he should be separated form her; and now his sitting on the tree and cawing delightedly indicated that he should soon be re-united with her.","alignment":{"type":"1:1","confidence":0.745,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-51"],"status":"unreviewed"},"source":{"sanskritLocator":"4001024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42a814ab1f80fd9e936b03e036a4c1c602c40cc82ad0c5daff0a4150a131b47e","compact":"2ef5b53b816215789ee6e18f9f6a2b039e9a18c318901f9a91a90ce93077bda1","nasal":"2ef5b53b816215789ee6e18f9f6a2b039e9a18c318901f9a91a90ce93077bda1"}},{"id":"VRCE-4-1-25","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":25,"english":"This bird flying up in the sky brought about Sītā's ravishment and this bird shall take me to her having expansive eyes.","alignment":{"type":"1:1","confidence":0.934,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-52"],"status":"unreviewed"},"source":{"sanskritLocator":"4001025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a904b2cd006d0398fa45c528537ed23a45c7b1ddb8c9b85ea6e0365017ff3e0d","compact":"77efc61553c2c7fb453ada2c14983f674317b780a9757bf488bb3bd8f9f491f1","nasal":"77efc61553c2c7fb453ada2c14983f674317b780a9757bf488bb3bd8f9f491f1"}},{"id":"VRCE-4-1-26","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":26,"english":"Hear, O Laksmana, the maddening notes of those birds sitting on the tops of the flowery trees and setting up their melody.","alignment":{"type":"1:1","confidence":0.859,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-53"],"status":"unreviewed"},"source":{"sanskritLocator":"4001026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55e3de51d2326b9d58f923bc939da3e7a1659bccff7d8602db183756262250be","compact":"1e318f640c14a461f2928a84a9e8e1779feb167efbcc7b90f2d0db5596a8534e","nasal":"aef9782ce797ad1990f496ab7692abef48b67bdccdb4c87ac51f12f8530f9d58"}},{"id":"VRCE-4-1-27","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":27,"english":"Behold, O Saumitri, O foremost of men, the Kinnaras are ranging at large in this variegated forest land on the banks of Pampā. Behold, O Lakşmaņa, here the fragrant red lotuses are shedding forth their splendour like to the newly risen sun.","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-57"],"status":"unreviewed"},"source":{"sanskritLocator":"4001027","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"916314b8ce65a67ec6453564282baf51c9bf4dd5e1162ef62c6d8f8410d72763","compact":"7889cd752f19386342eee48aa3b56d2e7c57fe4caf0a4344b772cf32cb51f4ab","nasal":"68947ab7ef30e6f491712243a609c50c09e9d7c1f1389898a1921137adbc24a2"}},{"id":"VRCE-4-1-28","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":28,"english":"Here appear beautifully the lake Pampā of transparent water, filled with blue and fragrant lotuses, swans and Kõrandavas and abounding in red lotuses like to the virgin rays of the sun and having their filaments crushed by the bees. And the beautiful woods around the lake have been manifesting their beauty, filled with Cakravākas and the herds of elephants and deer desirous of drinking water.","alignment":{"type":"grouped","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-58"],"status":"unreviewed"},"source":{"sanskritLocator":"4001028","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"06a0a22acd02ae1091ff663d6a493d3d4d47cf71b0e23adbfded81e7f7b35a38","compact":"64872fee524ed15eed2e95fb67504d0d822e93d56d48a013c3dded79e4944d79","nasal":"cebd195972ec38d6cfc00d0699b20afcaafe8d7624b0e49d88ab2f7ea1eb70fd"}},{"id":"VRCE-4-1-29","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":29,"english":"Here appear beautifully the lake Pampā of transparent water, filled with blue and fragrant lotuses, swans and Kõrandavas and abounding in red lotuses like to the virgin rays of the sun and having their filaments crushed by the bees. And the beautiful woods around the lake have been manifesting their beauty, filled with Cakravākas and the herds of elephants and deer desirous of drinking water.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-58"],"status":"unreviewed"},"source":{"sanskritLocator":"4001029","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8bd67c84f57272e39ebe074bf7365cc59b8c5cf37bd354924943f6f93851b37","compact":"042d735dd37d12c23968ebf9525fb91282c4217e8ddf8214b04ac7d141c6088a","nasal":"1c513bf12e3d056fc1b856e454564206d18fbff22d76b5b3a346a593d739b15a"}},{"id":"VRCE-4-1-30","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":30,"english":"My eyes pant for beholding those lotus-petals, O Lakṣmaṇa, because of their resemblance with Sītā's eyes.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-64"],"status":"unreviewed"},"source":{"sanskritLocator":"4001030","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"27ac917274ad9413c746ef704d967d21ddbe84d299e3e8da325f52dab1453db7","compact":"a94b3ac9d250f11296ac1d1679dbb940f621fce715beb924ee0352a8442f1110","nasal":"a94b3ac9d250f11296ac1d1679dbb940f621fce715beb924ee0352a8442f1110"}},{"id":"VRCE-4-1-31","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":31,"english":"Issuing out of the trees and touching the filaments, the pleasant wind is blowing like to Sita's breath.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-65"],"status":"unreviewed"},"source":{"sanskritLocator":"4001031","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62e2a15b43271c0d8f34fc3e2cda9ec003b1b49459a607ede9b51317380bec57","compact":"1def2c5ce165bef787a6eb5fa5777a9772167c571b8282c4a7dd34c092a1850a","nasal":"ad6a18fded3e7e947a6cdc26fcff9f7eb088f5fca906d13b4890eedf04846ab6"}},{"id":"VRCE-4-1-32","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":32,"english":"Behold O Lakşmaņa, the flowery branches of the Karņikāras on the summits of the mountain situated on the southern bank of Pampā.","alignment":{"type":"1:1","confidence":0.8,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-66"],"status":"unreviewed"},"source":{"sanskritLocator":"4001032","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"871a303a75202781c5df058e4dfab9f673e379e67d99c14484acdacdb62bc11c","compact":"b188b6874ef4ea8fc4b2cb5d1b1ba68048fa6ee68ceef13cc213080989f053df","nasal":"003c5a1c33f92fbcb7b4c4a41bbee0fa2408fd98d1277a7869419c32051d8acb"}},{"id":"VRCE-4-1-33","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":33,"english":"This prince of mountains, beautified with various metals, has been throwing up dusts of diverse colours driven by the wind.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-67"],"status":"unreviewed"},"source":{"sanskritLocator":"4001033","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7cff9209262e139776cab4849399702e240b411e01245954c90c42466daca665","compact":"d7b08c0df1ad53c96e8589310cff86eeeb60bc1cebb7cfddfb7d1d8e40e39263","nasal":"d7b08c0df1ad53c96e8589310cff86eeeb60bc1cebb7cfddfb7d1d8e40e39263"}},{"id":"VRCE-4-1-34","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":34,"english":"O Saumitri, these mountainous expanses are burning in beauty with blossoming and beautiful Kinsukas void of leaves.","alignment":{"type":"1:1","confidence":0.747,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-68"],"status":"unreviewed"},"source":{"sanskritLocator":"4001034","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"644cac25256dab91899467a7047283e63e905a493ad50de4476245450db8f6f5","compact":"610d0b9069c47943929da34d46f96652f1613bf28cb2dc6e7292b99d440585ee","nasal":"610d0b9069c47943929da34d46f96652f1613bf28cb2dc6e7292b99d440585ee"}},{"id":"VRCE-4-1-35","kanda":4,"kandaId":"kishkindha","sarga":1,"verse":35,"english":"These fragrant Mālatis, Mallikäs, Karavīras and lotuses, growing on the banks of Pampā, and fostered by Pampā's water, and Ketakis, Sinduvāras, Basantis in full blossom, the climber Madhavi full of fragrance, and Jasmin shrubs groves on every side. Ciribilvas, Madhukas, Vañjulas, Bakulas, Campakas, Tilakas, Nāgas, Padmakas, blue Asokas, and yellow Lodhras on the hills like to manes of a lion, are in flowers.","alignment":{"type":"grouped","confidence":0.906,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-1-69"],"status":"unreviewed"},"source":{"sanskritLocator":"4001035","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"86220b6d6cb7