2"],"status":"unreviewed"},"source":{"sanskritLocator":"4035012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dcd86bfb5eaa1f1b46e95b974ac94b7a2b663f5f7fd69deb9f175cf9fcd20e6d","compact":"5983a4c5827336de15655a67fe4f5f1f3b24c9fee0d34591606e80e517b88c7b","nasal":"5983a4c5827336de15655a67fe4f5f1f3b24c9fee0d34591606e80e517b88c7b"}},{"id":"VRCE-4-35-13","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":13,"english":"Having in especial, you endued with humility, my brother, O monarch of monkeys, is every way strong, O Sugriva.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4035013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a2fe280ee97e0d6bf7d50b33be291b7f893866ecc7e2928a8ea8f5e2ec2de06a","compact":"16901c0411a4d2a4427f67d83bc1a91503672c57d115b979cfa2de9057322c3c","nasal":"16901c0411a4d2a4427f67d83bc1a91503672c57d115b979cfa2de9057322c3c"}},{"id":"VRCE-4-35-14","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":14,"english":"Such is your strength, O Sugriva, and such your self-denial, that you are fully worthy to enjoy the good fortune of the king of monkeys.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4035014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9b6de3bf01ea4785ea2c63f7f51e218618eb6506e03f254b022a791c2a24428b","compact":"95f5792c8d81b824c8088f5a63f5d571758c90dd3e73d62fc7ac9bced9b67519","nasal":"95f5792c8d81b824c8088f5a63f5d571758c90dd3e73d62fc7ac9bced9b67519"}},{"id":"VRCE-4-35-15","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":15,"english":"O Sugrīva, by your help, the puissant Rāma shall speedily slay his foe. Of this there is not the least doubt.","alignment":{"type":