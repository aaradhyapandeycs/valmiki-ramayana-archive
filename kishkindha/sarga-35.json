[{"id":"VRCE-4-35-1","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":1,"english":"Humbly addressed in these words informed with morality, Sumitra's son, resuming his native mildness, accepted them.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4035001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8333b05700dc9c2cae39ab392d1bb6bfa17b55b18b301c6452c267cd70ff27da","compact":"36ff38873063ac6593222074775fa72cafd42b1eaaf512bd9a26865989789476","nasal":"0ce256380612ce7d878dd86b5d7dd46dd7b7c5a651b25e0aec9f6378dd17949b"}},{"id":"VRCE-4-35-2","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":2,"english":"On his accepting the speech, the lord of monkeys like a wet cloth cast off from him the fear he had conceived on account of Lakşmaņa.","alignment":{"type":"1:1","confidence":0.868,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4035002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2df65dde5bcb862fed8b191be60115a2ea1ea1ca4dbb6daa341c7c725149158c","compact":"06cff665030a7be93895239e811e532070ee57edd5ecc4779c15492ae4c1a8cd","nasal":"dc3f8293f5542386dd987df3ebb50e2488634c57e96aecf21648a5ec2c9480da"}},{"id":"VRCE-4-35-3","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":3,"english":"Then Sugriva-lord of monkeys-tore away the gaudy and variegated garland on his neck-potent with many a virtue, and become deprived of energy.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4035003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b2b659f162d1e7860432c50d96471d3014b96e9d52500fd1906e80f1d131e5a1","compact":"c755a95c3623e570eb370893042431cdede39822d6727cef9f4dfe905a0cc5b7","nasal":"db17c68b6cdc0dae734a075bff70ef15c3ae6f0c483437338030b5b3a701da64"}},{"id":"VRCE-4-35-4","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":4,"english":"And that master of all the monkeys, Sugrīva, gladdening Lakşmaņa of dreadful prowess, humbly observed to him,","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4035004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6b3bf743924f8426028f05515db2d5b682823c533cff5c135ba8826aeb353260","compact":"aee421aee20945209fdb7e5d3c075bfaa3ba5ca645a37478680cde23221c722b","nasal":"aee421aee20945209fdb7e5d3c075bfaa3ba5ca645a37478680cde23221c722b"}},{"id":"VRCE-4-35-5","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":5,"english":"You son to Sumitrā, by the favour of Rāma have I received back my lost luck, my fame, and this eternal monarchy of the monkeys.","alignment":{"type":"1:1","confidence":0.671,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4035005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"051b90c93fa7a7062e3bf32150c1abbc07f3974f704750a27153961c87de2961","compact":"6c2eb2b77242720d06f66dc0e7ef76c4cb526cca5732c1db5a00d9fa589feeb4","nasal":"6c2eb2b77242720d06f66dc0e7ef76c4cb526cca5732c1db5a00d9fa589feeb4"}},{"id":"VRCE-4-35-6","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":6,"english":"O king's son, who is capable of repaying even in part an action like that of the divine (Rāma) renowned by means of his own acts?","alignment":{"type":"1:1","confidence":0.581,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4035006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"effac0af5d9916c7eefb34eba15a2618a9bffd770e1380966aaefd3e45d9fd58","compact":"fbc5d8fffa58e67a9d3703ffaecb95155965ae88370f6994260dd004e7084ed7","nasal":"fbc5d8fffa58e67a9d3703ffaecb95155965ae88370f6994260dd004e7084ed7"}},{"id":"VRCE-4-35-7","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":7,"english":"By virtue of native energy, and merely with my help, the righteous Rāghava shall recover Sītā and slay Rāvana to boot.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4035007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"979a82c91e4dfbd8c2f99b9e8d7e070cfb90466dbd4089ee1bdbc17ed2d554c7","compact":"d81f42cd43f787d0e7e215349c5eb155d963e8318bd2ce82dbc50ef891dd98ee","nasal":"d81f42cd43f787d0e7e215349c5eb155d963e8318bd2ce82dbc50ef891dd98ee"}},{"id":"VRCE-4-35-8","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":8,"english":"What need of assistance to him who with a single shaft rived seven giant trees, a mountain, and the Earth.","alignment":{"type":"1:1","confidence":0.661,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4035008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e4777f0baf5f7cd892bb78718b080bf36648a913750bcdef4ed34409bec041f6","compact":"860bbb47a7e269425798d76c8238d499bb7b967246ad46719da9ec92a4c7c70f","nasal":"860bbb47a7e269425798d76c8238d499bb7b967246ad46719da9ec92a4c7c70f"}},{"id":"VRCE-4-35-9","kanda":4,"kandaId":"kishkindha","sarga":35,"verse":9,"english":"O Lakşmaņa, what is the use of help to him the sounds of whose stretching bow made the Earth tremble with her mountains?","alignment":{"type":"1:1","confidence":0.794,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-36-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4035009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},