[{"id":"VRCE-4-46-1","kanda":4,"kandaId":"kishkindha","sarga":46,"verse":1,"english":"The principal monkeys, having been ordered by the monkey-king, speedily went in all directions to their destinations for the purpose of seeing Vaidehi.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-47-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4046001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b7351ff86178318f4e2adb48d53960be213ee506a6eba24ff423a03b0f13a00e","compact":"01d857336a1c2b729ce3d84d2dd7a9c8e8b408002bd9b21618962e589e6093b4","nasal":"d8803731dd3523995a57495a8423a3de02f10779c0d27a9af2f591e246b24c5e"}},{"id":"VRCE-4-46-2","kanda":4,"kandaId":"kishkindha","sarga":46,"verse":2,"english":"And on all sides they explore watery expanses, and streams, and lawns, and commons, and cities, and tracts rendered impassable by torrents.","alignment":{"type":"1:1","confidence":0.607,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-47-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4046002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"bd339ecf4f0876fc33864fbac33abae8593dbb2e0e5c15bedae813025afb39b1","compact":"ed0865774885b3bac1a6a591ce39e3ed8cd45970b8145209a85f873fb104c101","nasal":"8019cb054994cdfc44ae3fd4a8bdd3f6ee1c8b9a330c31fd7283660adf8e31e2"}},{"id":"VRCE-4-46-3","kanda":4,"kandaId":"kishkindha","sarga":46,"verse":3,"english":"And the leaders of monkey-herds search all those countries, countries, described described by Sugrīva,-containing mountains, woods and forests.","alignment":{"type":"1:1","confidence":0.578,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-47-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4046003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ebfca42c7aa5257662189229f5afde3ed8cc5d7a3c6a6f9c1cded8d070928669","