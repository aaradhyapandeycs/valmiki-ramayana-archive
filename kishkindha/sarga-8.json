[{"id":"VRCE-4-8-1","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":1,"english":"Sugrīva, rejoiced at the words of Rāma, said to that hero, the elder brother of Laksmana; who was well pleased.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4008001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79a0f9824c4121c5e869f71afc208062dbbff1b920a4677451b0c4777684146d","compact":"6279cc9d022cb54e726510b76a35e03eba361478a6e4df8eeb9c7d8509427c86","nasal":"6279cc9d022cb54e726510b76a35e03eba361478a6e4df8eeb9c7d8509427c86"}},{"id":"VRCE-4-8-2","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":2,"english":"I am, without doubt, worthy of being favoured by the gods, since you accomplished and furnished with virtues are my friend.","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4008002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b3a58558d4fb05a9dbc6069f01eddfc6dbcbfcfaaec37d0e02cfb028086accf0","compact":"bf0993c8f9110db7cf0043d2f24ac14fcdc986821718d03c6a1b3ca836cee08b","nasal":"ee00834b27111434281a91b99a23b6a16bcb7be104602c84ee819b43ab70aca6"}},{"id":"VRCE-4-8-3","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":3,"english":"By your help, O Rama, one can, O sinless one, obtain the kingdom of the celestials,-what is to be said of one's kingdom, O lord?","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4008003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"410f96f05d6cbcffc8d5ce442eb289e4ad88522390c937bac7be0195d7bd8abe","compact":"610f619f54c9474fd92fa70a9d22af7c249a22c8f72ac311e00ec113ac3d190d","nasal":"610f619f54c9474fd92fa70a9d22af7c249a22c8f72ac311e00ec113ac3d190d"}},{"id":"VRCE-4-8-4","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":4,"english":"I, who have, in the presence of Fire, gained for my friend (you) sprung from the Rāghava race, am, O Rāghava worthy of being honoured by my friends and relations.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4008004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e421383c3ed74d858107b8d808ecaf94038a840ec520204bec3f70377ea08b70","compact":"a412b6671f15be2ffe5ba396f3d9404c1c1512ae77099cf516b4940df59dce9d","nasal":"820204988375f5ac598b193b0bc032ab387f7f5c1b2fabe8a37720d703a3d9a2"}},{"id":"VRCE-4-8-5","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":5,"english":"You also shall by and by learn that I am a fit friend for you; but I can not speak to you of the qualities that abide in me.","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4008005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e0a52753a520580a42d893a9c52389f4e845aaaf54fc6c4ec6a5e93078a10eda","compact":"04f354b876c195046285c73490c0013b984556f77c88d6175d8d72465d52ae52","nasal":"04f354b876c195046285c73490c0013b984556f77c88d6175d8d72465d52ae52"}},{"id":"VRCE-4-8-6","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":6,"english":"O free one, the felicity of high-souled and self-governed friends like you abounds and is enduring.","alignment":{"type":"1:1","confidence":0.829,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4008006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f304ab1c952d6f39660377d02d2d321749df79992e3a76346f2e247af34dcc3a","compact":"dd310786f8dfe0ecd91726275e83e2b23b709b7f1deab61091091f674ce1c7bf","nasal":"dd310786f8dfe0ecd91726275e83e2b23b709b7f1deab61091091f674ce1c7bf"}},{"id":"VRCE-4-8-7","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":7,"english":"Pious friends look upon the silver, and gold, and the elegant ornaments of pious friends as common property.","alignment":{"type":"1:1","confidence":0.569,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4008007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"596cec014d40d34d8ed8b6750e23274aa6313d8fcc2b138877b855b5d4bb8cb7","compact":"90f622e463fef484e25fda5e9532c38843f47c25eaedf93bbc772dc3eeaf9bbe","nasal":"b8be0312cab4c0d1c30873ee81ef3d4060e64a6382aee7439fd6809da0d49f00"}},{"id":"VRCE-4-8-8","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":8,"english":"Whether rich or poor, happy or miserable, good or bad, a friend is the greatest refuge (of his friend).","alignment":{"type":"1:1","confidence":0.712,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4008008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1ee1471e6738ea6e526006def4379d9ce6674329c44615356e0decde7ebf173d","compact":"fc9bf8968ea57cd8ba944d67fd18017b0a4594882f20825e076d36cd17e75c89","nasal":"fc9bf8968ea57cd8ba944d67fd18017b0a4594882f20825e076d36cd17e75c89"}},{"id":"VRCE-4-8-9","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":9,"english":"Witnessing such affection, people can, O sinless one, forsake wealth, comfort, and even their native land for the sake of their friends.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4008009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2ed0b00e95c017f476be0767d742387980c6a065fc2f313aa66f4d8f0c65d7d4","compact":"e0df0027d709898a52957250f834e4015bd0308babb353d419e2d96241f5c8e3","nasal":"d70134e4aadcb470282d056c5fad80f8853c8bab7bc7e0ae83f9ca0a44aac98a"}},{"id":"VRCE-4-8-10","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":10,"english":"There at the graceful Rāma, in front of the intelligent Lakşmaņa resembling Väsava, said to Sugriva of a pleasing presence,-It is even so.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4008010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a5079195a7739426448bbf16d3aa1e60f036203f2e1f4d1d76cbbb094cb5281f","compact":"cea9771e2ab2607950ea27b72cd236cf65e5613d54baabaa9583ce36d5504041","nasal":"cea9771e2ab2607950ea27b72cd236cf65e5613d54baabaa9583ce36d5504041"}},{"id":"VRCE-4-8-11","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":11,"english":"The next day seeing Rāma as well as the mighty Lakşmaņa seated on the ground, Sugrīva briskly cast his eyes about the forest.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4008011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"45f4e3cc91ac49fccd3a2f60a1471e565aa90f939944cddff77012bfac4903b1","compact":"2beee9222979a7d7adba19eca62f2dc22621f3c1e6b558c44931684b0f8e69d1","nasal":"2beee9222979a7d7adba19eca62f2dc22621f3c1e6b558c44931684b0f8e69d1"}},{"id":"VRCE-4-8-12","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":12,"english":"And hard by that lord of monkeys discovered a Sāla tree, bearing a few beautiful blossoms, with its wealth of foliage, decked by black bees.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4008012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b77dcd2d12bd5b6e683c431bd9aa97536de9144e136de4d26d1cb050d14e1b12","compact":"1666deee93d140874979c7c8121b19882e784f65e56fb4090438008d98efc8f2","nasal":"1666deee93d140874979c7c8121b19882e784f65e56fb4090438008d98efc8f2"}},{"id":"VRCE-4-8-13","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":13,"english":"Then spreading a beautifully blossoming spray of Sala, full of foliage, Sugriva made an awning and sat down with Rāghava.","alignment":{"type":"1:1","confidence":0.775,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-5-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4008013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6833e21e8c2b9955a400f99f9ac2c09a0ee8cd71671885c7ca593ee226a5bee5","compact":"9ce2b3cd201a2d645c10557b084be7f5996bce4241626655a9fc397c50a68fee","nasal":"5a41b6c6de920ad1c7f43d3fd70bda8896790bbbe696b718c73ac84f6e6b3171"}},{"id":"VRCE-4-8-14","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":14,"english":"Seeing them seated, Hanumān breaking off a branch of śāla, humbly made Lakşmaņa sit down.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4008014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e705a564b90b39716c643c361010bf17346eb761e3a4ada5527b2b5bfb7f1c24","compact":"5d9e9b4fadbe81521f4d4d64452f4b4ee0ecce68dcfaa8b097f97155bae28db6","nasal":"5d9e9b4fadbe81521f4d4d64452f4b4ee0ecce68dcfaa8b097f97155bae28db6"}},{"id":"VRCE-4-8-15","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":15,"english":"Seeing Rāma seated at his case in that best of mountains abounding in Sāla flowers, and cheerful like the ocean, Sugrīva from love spoke to Rāma sweet and excellent words, of which the letters vibrated with delight.","alignment":{"type":"1:1","confidence":0.824,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4008015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d55c425baa00bd9f957350b247435368577aca603c0c9995c78a9717f90f6449","compact":"a4f113584b96217c102464eba4e1a928bcdfede3c66f327aad6b060d6d7c0ec3","nasal":"a4f113584b96217c102464eba4e1a928bcdfede3c66f327aad6b060d6d7c0ec3"}},{"id":"VRCE-4-8-16","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":16,"english":"Wronged by my brother, I deprived of my wife and exceedingly distressed, and exercised with fear, live in this foremost of mountains, Rs yamuka.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4008016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"16961185fabb8181d8b88be99688579ed50b878df2fb6612199d2007ff7b326b","compact":"8c6ced3666d9f75a2f1d373c95f2dee1dab52300c4a783d424735c0ed139caad","nasal":"8c6ced3666d9f75a2f1d373c95f2dee1dab52300c4a783d424735c0ed139caad"}},{"id":"VRCE-4-8-17","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":17,"english":"O Rāghava, my senses wildered, having been oppressed by Vāli, and having incurred his enmity, I am afflicted with fear, and tormented with fright.","alignment":{"type":"1:1","confidence":0.788,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-8-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4008017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f72ad8beeaff291d285130cad09cc7681f8bbc57740e6a770ef9ce90b16f92b5","compact":"8215b09cceec2a918e22caa11f0ed7470af94141e7be75f423b1d064e369a654","nasal":"f4a08d59935d2fdffa029e378b77a50e083eed64028cd81c123d349253db5c96"}},{"id":"VRCE-4-8-18","kanda":4,"kandaId":"kishkindha","sarga":8,"verse":18,"englis