[{"id":"VRCE-4-16-1","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":1,"english":"After Tārā, having a moon-like countenance, had spoken thus, Vāli, remonstrated with her and said.","alignment":{"type":"1:1","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4016001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5a2329172859106eb70247b917b5f12e685f0e2a8987e476c4285e1c92a8f947","compact":"8045738a23150d7a2067268a4ae96c69d3ad41dc4e9ac288e2cf367800fd372b","nasal":"8045738a23150d7a2067268a4ae96c69d3ad41dc4e9ac288e2cf367800fd372b"}},{"id":"VRCE-4-16-2","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":2,"english":"O you of exquisite loveliness, my brother, and specially my enemy, is roaring lowly and haughtily-and how shall I put up with it?","alignment":{"type":"1:1","confidence":0.541,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4016002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"73ba68743339d17420cdd2540ad8440818aac23b88e8d17d5bd2e6b4ae0453e0","compact":"f377720f5b7ea4062ea844692794124b7f96686f99021b2517b6c69ded84dea4","nasal":"8c7abba97a2f925371905a98a941ae41d7102c5fbe18077ed18491cacaf18305"}},{"id":"VRCE-4-16-3","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":3,"english":"O timid damsel, heroes, who have never been defeated and have never fled away from the battle field, had rather meet with death than put up with this ignominy.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4016003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3e8409a6e3610a86a39f3f1737ff2e7ae646b87efc0d49e83d479b28caab85f3","compact":"74f3755ac9fa7d5fcec98a4900f126c9c79d8403ef8f01f9857c273cccee1cb4","nasal":"74f3755ac9fa7d5fcec98a4900f126c9c79d8403ef8f01f9857c273cccee1cb4"}},{"id":"VRCE-4-16-4","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":4,"english":"I am incapable of bearing this proud uproar of Sugrīva, having a defective neck and desirous of entering into conflict with me.","alignment":{"type":"1:1","confidence":0.967,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4016004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7cc4e5e8d594378bd006c9456da9b1248f051fe54e8808f2af5cb68ddc464d2a","compact":"e0c1e70a97d7d7b9884f2e6907d3693d0595dedb62b9ad0d59764c912c2881fd","nasal":"9759149d7995573aee1c75616b316fb385abfb75249ad7bb873a31552e9c5678"}},{"id":"VRCE-4-16-5","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":5,"english":"Fearing danger from Rāghava, you needst not entertain any anxiety on my account. Why shall that virtuous-souled and grateful Rāma perpetrate iniquity?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4016005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"934e6f7cdaaab0e407ad1e4820546af3c259aef9500ec1adbf4e9c2984896b64","compact":"f640b60a225ee346900addf717a4a7154b65c606173b40276e2e959cc5c9f411","nasal":"f640b60a225ee346900addf717a4a7154b65c606173b40276e2e959cc5c9f411"}},{"id":"VRCE-4-16-6","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":6,"english":"Do you therefore return with my other wives. Why do you follow me again? You have already shown your friendship and respect for me. I shall repairing thither, only fight with Sugrīva. I shall crush down his pride and not destroy him.","alignment":{"type":"grouped","confidence":0.698,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-6"],"status":"unreviewed"},"source":{"sanskritLoca