r":"4016020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6bde767f1621267c6e3661dcce669dc63a06cc92953a8be4d91055481821431e","compact":"e83fbb786cbdf907be169ad889b7eb3133c5c42d502c230833932e16d0116185","nasal":"e83fbb786cbdf907be169ad889b7eb3133c5c42d502c230833932e16d0116185"}},{"id":"VRCE-4-16-21","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":21,"english":"And Vāli too was struck down by Sugrīva, fearlessly taking up a Sāla tree, like to a mountain clapped by a thunderbolt.","alignment":{"type":"1:1","confidence":0.823,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4016021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"122e2c27fc8f69aca20c151a86513c65a7169ad3dbe39984fc5595373da151fc","compact":"d2dfa0c1f3c98056fd8c13bec99e6938190d2d8116a61df74b573ccad6ecbbf8","nasal":"d2dfa0c1f3c98056fd8c13bec99e6938190d2d8116a61df74b573ccad6ecbbf8"}},{"id":"VRCE-4-16-22","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":22,"english":"Being thus smitten by the tree and overwhelmed with the strike of Sāla he was troubled like to a heavily laden boat in the midst of an ocean.","alignment":{"type":"1:1","confidence":0.309,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4016022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4fcdf3dbc3cf494eaa1f9a3763a99643154005a949371005a4d23ec0d39a5c4a","compact":"f25c92de989c05557523ec4a34aa5843c4a7819f25fd1091c460bbfb1273781b","nasal":"9ff28ebc8e6763d0a289027de82edf501fa9dd79991c0ee5052786b95396fb95"}},{"id":"VRCE-4-16-23","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":23,"english":"And these (two brothers) gifted with mighty strength and prowess and motion of Suparna, and having huge persons fought with each other like to the Sun and Moon on the sky.","alignment":{"type":"1:1","confidence":0.774,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-24"],"status":"unreviewed"},"source":{"sanskritLocator":"4016023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"254f35c56b74ab61ec1edd3638ff2e49dd78a454afa4ba14407e9d8bc87d5558","compact":"63d3f8796b5b19541bd57c9501c744b77f38ce704fa5d180354ba337f2510283","nasal":"988ddd531795bd332b4d75d2cd3f75253c3fe256a4f9e506d14742435cd13a3e"}},{"id":"VRCE-4-16-24","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":24,"english":"And having his pride crushed down by Väli and strength greatly reduced, Sugrīva in anger pointed him out to Rāma.","alignment":{"type":"1:1","confidence":0.905,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-26"],"status":"unreviewed"},"source":{"sanskritLocator":"4016024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9036b39a2c046a8acff27610b513dd13df66cc949b5dcd5b64385fd025e6392","compact":"f1c92d33026605aba573cff924a329b2373187841e49899a628ca189c5a973f0","nasal":"5e90eaf26c4bb2470dc85013d9648706f6cece0edb142db58dff290ea7f57222"}},{"id":"VRCE-4-16-25","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":25,"english":"And fixing on his bow an arrow resembling a serpent, he stretched it like to Death drawing out his cycle of time. And a mighty shaft, like to thunderbolt and resembling flaming fire, being hurled by Rāma, alighted on the breast of Väli.","alignment":{"type":"split","confidence":0.449,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-31","DUTT-4-16-33"],"status":"unreviewed"},"source":{"sanskritLocator":"4016025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"744c91f634e47a01cb231eebc49e5cdae41e5945b13cc5ea16b5a4dc8876b475","compact":"90d831ba3fb829fae044426f4d7fff4038bd292403dc3136d2fa35d8558913ed","nasal":"90d831ba3fb829fae044426f4d7fff4038bd292403dc3136d2fa35d855