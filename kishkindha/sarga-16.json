47","compact":"6122c6550b92fcc4638b5b474aefdb5149527f3819f41e281ff4cbc51d10a5ed","nasal":"6122c6550b92fcc4638b5b474aefdb5149527f3819f41e281ff4cbc51d10a5ed"}},{"id":"VRCE-4-16-15","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":15,"english":"Highly powerful and closely habited, he, clinching his fists, proceeded towards Sugriva, and waited for the action.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4016015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ef3c6087432e1ce96d7d47b673b6d008e256b07921304c825139cf0a9f275a0","compact":"6d3bcaceaeff1bd4b582aa89085eb0d9c87aed941fa2dcfe750a926a3d15face","nasal":"6d3bcaceaeff1bd4b582aa89085eb0d9c87aed941fa2dcfe750a926a3d15face"}},{"id":"VRCE-4-16-16","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":16,"english":"Sugrīva too, clinching his fist and exceedingly wroth, proceeded towards Vāli, wearing a golden garland.","alignment":{"type":"1:1","confidence":0.892,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4016016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ab07ae972fb3e39a87bd57aae69cf153e8061bcee6bd5985ce15d8be8139313a","compact":"ebc3cb484b559cdb2e29228eb4f101bfb47458908948cb1d03713e9bc66fba6f","nasal":"ebc3cb484b559cdb2e29228eb4f101bfb47458908948cb1d03713e9bc66fba6f"}},{"id":"VRCE-4-16-17","kanda":4,"kandaId":"kishkindha","sarga":16,"verse":17,"english":"And beholding Sugrīva, adept in warfare having his eyes reddened with ire, advance quickly, Vāli spoke.","alignment":{"type":"1:1","confidence":0.583,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-16-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4016017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"59b890865a60