reviewed"},"source":{"sanskritLocator":"4012009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1acecc8ba0736982f137a6efc4eea1c5fc0e72051afdd497a6d3466a8baf17fd","compact":"84d5d6fdb59a8b89745270be329558f1b68e4affcccf1d032e4bc4a5dde862c9","nasal":"84d5d6fdb59a8b89745270be329558f1b68e4affcccf1d032e4bc4a5dde862c9"}},{"id":"VRCE-4-12-10","kanda":4,"kandaId":"kishkindha","sarga":12,"verse":10,"english":"Obtaining you as my friend like to Mahendra and Varuņa, my grief has been removed and I have attained to an excess of delight.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-12-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4012010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5896cbe943ccc1273a77cf9730a1edbc94bc8a8eb3f9f33af26f5b7c61b79974","compact":"14d81d8002ea9743702cc1ffd9e332673799dd0e27cdf09830a9af885a1cd9b1","nasal":"b400550071e4fbe6e174cc7e1d6b44db14d601e6d7ac41bc171f2e8873d98b1d"}},{"id":"VRCE-4-12-11","kanda":4,"kandaId":"kishkindha","sarga":12,"verse":11,"english":"Do you, O Kākutstha, even to-day destroy, for my welfare, my brother Vāli. This I do pray to you with folded hands.","alignment":{"type":"1:1","confidence":0.877,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-12-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4012011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"31ad6eaa71967a9efc617cdfe661751b4774db5e3ac49c2e1e06fd62d18085d7","compact":"aa82cfcbaeedff358ea70fe07c409019d80fe7efc260226165e9bbf2dea2f620","nasal":"210898d875545ada822ded05c09e2ab4a9e66bc03a6a7de2a753fe3fbb48bba8"}},{"id":"VRCE-4-12-12","kanda":4,"kandaId":"kishkindha","sarga":12,"verse":12,"english":"Thereupon embracing Sugrīva, of a pleasant countenance and like to Lakşmaņa, the highly wise Rāma spoke to him, saying,","alignment":{"type":"1:1","confi