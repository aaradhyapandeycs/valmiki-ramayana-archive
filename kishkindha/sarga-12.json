[{"id":"VRCE-4-12-1","kanda":4,"kandaId":"kishkindha","sarga":12,"verse":1,"english":"Hearing those pleasant words of Sugrīva, the highly effulgent Rāma, to create his confidence, took up his bow.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-12-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4012001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f53899f1471fa7c3336e486d002f2d295ab5222b4b92ad0cf1e2a9b42f5528bc","compact":"28fe3f3262920f58cbbb36f9ed1a1ec905cb1cfa81b19c82a601377e254c247d","nasal":"d44845902ff5fc3ef52e7d23c725d9d48f310db7324f966264cb1932cf7d1673"}},{"id":"VRCE-4-12-2","kanda":4,"kandaId":"kishkindha","sarga":12,"verse":2,"english":"That one, conferring honours upon others, holding his terrible bow and a shaft, darted it towards the Sāla, filling all the quarters with a sound,","alignment":{"type":"1:1","confidence":0.365,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-12-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4012002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"122400d9cf4351dd385e2b0fffe19b807b3f60874471626dc33d7e26442ebb46","compact":"2d87f6ed69cbbe1947f0556550bf1bcf1ff41e29d185d1a78c694cddbb1dedde","nasal":"6c73f663c0e84fdc32198a3fbc0c412c2ada83af90e8d14d3028a228d177d22b"}},{"id":"VRCE-4-12-3","kanda":4,"kandaId":"kishkindha","sarga":12,"verse":3,"english":"The arrow, clear as the gold itself, hurled by that one of mighty strength, perforating the trees, entered into the mountainous expanse and the sevenfold regions of the earth.","alignment":{"type":"1:1","confidence":0.773,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-12-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4012003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f88566e29b96289fd89a4601e639087b4ef49d2873af8742faaebe9e1acc1bf5","co