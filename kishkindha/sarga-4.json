","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cf687eb53a2bcc00de7017a4c7a87b9494e78e864198f96f4118a2f8b0aea1b5","compact":"5fef22e4f24c763362a1c559434c795c210aaad3fec5731ca7665fbb1bed4f0a","nasal":"5fef22e4f24c763362a1c559434c795c210aaad3fec5731ca7665fbb1bed4f0a"}},{"id":"VRCE-4-4-17","kanda":4,"kandaId":"kishkindha","sarga":4,"verse":17,"english":"When Sumitrā's son shedding tears had spoken thus, that one skilled in speech, Hanumān, answered in these words, 'Persons of such a stamp, endued with understanding, of controlled anger and subdued senses, should be seen by the master of monkeys, and such come within one's ken through blessed luck.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-4-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4004017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a53bd71814aadf7b6d71e42d4674528769a30908168599f3189e7f7d279c94bd","compact":"d9f77225e9054195a47d2cfed03e8f080e83be90beb9a108885179eff1e10dfe","nasal":"d9f77225e9054195a47d2cfed03e8f080e83be90beb9a108885179eff1e10dfe"}},{"id":"VRCE-4-4-18","kanda":4,"kandaId":"kishkindha","sarga":4,"verse":18,"english":"When Sumitrā's son shedding tears had spoken thus, that one skilled in speech, Hanumān, answered in these words, 'Persons of such a stamp, endued with understanding, of controlled anger and subdued senses, should be seen by the master of monkeys, and such come within one's ken through blessed luck.","alignment":{"type":"grouped","confidence":0.892,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-4-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4004018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"05bd45fc2ff7ac53727e792bdc316ec76ffc85df3986185f2d4fcebf8d2f7b66","compact":"87afb7bc59568bdc85f83527a1731b64ed84559686e8d0b47e7e3e479842c9a1","nasal":"63cec2680a1c90ac6110394