or":"4004024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c33a9580a65fb5050d856854bd45360892ca09f16c8ed9e5b14f87ffba0e8f47","compact":"69a54cca387281e5b0ff20a4bce66a602c02711f005bed9823f15b335327defb","nasal":"fe42208c5fcf1e7b5ffab4b75f8fc404a5c4bd8c1599e2c1967afed892e0afb5"}},{"id":"VRCE-4-4-25","kanda":4,"kandaId":"kishkindha","sarga":4,"verse":25,"english":"Then that vastly wise one Hanumān the son of the wind god departed, taking with him the heroic descendants of Raghu, for (presenting them) to the monarch of monkeys.","alignment":{"type":"1:1","confidence":0.909,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-4-29"],"status":"unreviewed"},"source":{"sanskritLocator":"4004025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1cd2dfd045046460ac2b71f54840cdd370d50a71ee88dd99bbcac2e14500892a","compact":"721639babcdea2ba539cfae1b08fd315219e506b4f93405d5fc353ee52106899","nasal":"721639babcdea2ba539cfae1b08fd315219e506b4f93405d5fc353ee52106899"}},{"id":"VRCE-4-4-26","kanda":4,"kandaId":"kishkindha","sarga":4,"verse":26,"english":"Then the heroic monkey, the son of the windgod, of wide fame, and great prowess, with his mind perfectly pure, considering himself as crowned with success, and experiencing exceeding delight, arrived at that best of mountains in company with Rāma and Laks mana.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-4-31"],"status":"unreviewed"},"source":{"sanskritLocator":"4004026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac71efc3dc6ca29c049b5059f374d1b4db577a6561409bc9f248824014775a7f","compact":"ab01f042f08adfa0e857bd33eb5fe3d6a1be92720c3877b9ff294469f59b146f","nasal":"ab01f042f08adfa0e857bd33eb5fe3d6a1be92720c3877b9ff294469f59b146f"}}]
