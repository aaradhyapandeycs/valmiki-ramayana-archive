f40fba79cd05"}},{"id":"VRCE-4-14-6","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":6,"english":"Being thus accosted by Sugrīva, the virtuoussouled Rāghava, the slayer of foes, addressed him with the following words.","alignment":{"type":"approximate","confidence":0.233,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4014006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0d9b701ff41bf5f2216f792376b5bc9cfde86807296824c5fe814169344e95ca","compact":"5841ea22be438620b0b3c40d16a4045d0643a4077a87a1f011c81fa6a787f6b3","nasal":"5841ea22be438620b0b3c40d16a4045d0643a4077a87a1f011c81fa6a787f6b3"}},{"id":"VRCE-4-14-7","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":7,"english":"Being thus accosted by Sugrīva, the virtuoussouled Rāghava, the slayer of foes, addressed him with the following words.","alignment":{"type":"grouped","confidence":0.491,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4014007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"abb5d29e7fc397870e9ceee3db22c34a27219acff1da4f54bb51f44487eddd65","compact":"bdb419f4c2bab57f8095b907c7bc8776a5cfb75dc84213b38c3d9fa07057b745","nasal":"bdb419f4c2bab57f8095b907c7bc8776a5cfb75dc84213b38c3d9fa07057b745"}},{"id":"VRCE-4-14-8","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":8,"english":"Uprooting the Gaja creeper, Laksmana, has placed it around your neck as an emblem (to distinguish you). You does appear beautiful, O hero, with this creeper around your neck like to the sun on the sky engarlanded by the stars. I shall, O monkey, by the discharge of one shaft in the conflict, destroy your fear and enmity proceeding from Vāli.","alignment":{"type":"split","confidence":0.466,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-7","DUTT-4-14-8"],"status":"unreviewed"},"source":{"san