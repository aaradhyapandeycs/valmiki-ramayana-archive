tt 1891–94"},"sanskrit_fingerprints":{"exact":"726e28ca8d46f81783502adad936678704c00f665003fce925f18de3a306bb0c","compact":"c23d2a8afbf5abe7d7d5ac768b3775299d4482f06e302be160d41b1d6265a4a9","nasal":"c23d2a8afbf5abe7d7d5ac768b3775299d4482f06e302be160d41b1d6265a4a9"}},{"id":"VRCE-4-14-16","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":16,"english":"He has subdued his breath, is proud of victory and fond of warfare; you could not repress him before. Forsooth that Vāli shall come out, leaving the company (of his wives). Hearing the war cry of his enemy, he shall never put up with it, specially, as he boasteth of his prowess before his wives.","alignment":{"type":"grouped","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4014016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8a2cb88c0d4cb3d7a2450bfcb93c769705866302adbf9975da0e687d90eb3eed","compact":"38e83e3db6ad47a367dabc87f2724f2963472d53dd5571b09c8855e4fd2fbc8b","nasal":"38e83e3db6ad47a367dabc87f2724f2963472d53dd5571b09c8855e4fd2fbc8b"}},{"id":"VRCE-4-14-17","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":17,"english":"He has subdued his breath, is proud of victory and fond of warfare; you could not repress him before. Forsooth that Vāli shall come out, leaving the company (of his wives). Hearing the war cry of his enemy, he shall never put up with it, specially, as he boasteth of his prowess before his wives.","alignment":{"type":"grouped","confidence":0.818,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4014017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d63102b35671604943c91e2575bd985e09e5f5955c08b006343c5dbab98e9396","compact":"6c3bd1ced19b5b83c19f9dfdbaa124291a728f74bfbfeb44b510030b82d08550","nasal":"d835415058dc75b1df69444fbe1ab353d463051d073ea01db