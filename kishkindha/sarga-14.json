[{"id":"VRCE-4-14-1","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":1,"english":"They all, repairing quickly to Kiskindha, Vāli's capital stood waiting in the dense forest, hiding themselves behind the trees.","alignment":{"type":"grouped","confidence":0.819,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4014001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a1859f28076d1607028b7573ef4309cf3d2b0c1670aae642035a570fae1a088e","compact":"240de1420a723235b3d377a02defbd16cfb2545a26c5b86cae38d89f21e40017","nasal":"be452ca1c4b502ab6762ce0d2e61ec01539cfd556993c9e6d5073aff0ac01829"}},{"id":"VRCE-4-14-2","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":2,"english":"Casting his looks all around in the forest, Sugrīva, having a huge neck and fond of woods, became exceedingly enraged.","alignment":{"type":"1:1","confidence":0.954,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4014002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ea853779685cc3833ead96ca0388ee5faf6123b3ed4bf1b4068a8e2aa7444949","compact":"86107e3f0c5316c924ef050dd701d9d79262f9c5ccfa84870de8935730ddeaac","nasal":"86107e3f0c5316c924ef050dd701d9d79262f9c5ccfa84870de8935730ddeaac"}},{"id":"VRCE-4-14-3","kanda":4,"kandaId":"kishkindha","sarga":14,"verse":3,"english":"Setting up a terrible uproar and rending the sky with his cry (Sugrīva) encircled by his kinsmen, invited (Vāli) to battle.","alignment":{"type":"1:1","confidence":0.538,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-14-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4014003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f45e65d5bfe56d19b99b900a6ca7fdde841031fa594904e85dc8c3db8423919d","compact":"176004903b5c67f55e43f9f35c6579c6e3d4c50d89a546d3166