[{"id":"VRCE-4-61-1","kanda":4,"kandaId":"kishkindha","sarga":61,"verse":1,"english":"Having said this to that foremost of ascetics, I smitten with grief, began to weep. Thereat, after, reflecting for a while, that reverend one said,","alignment":{"type":"1:1","confidence":0.545,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-62-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4061001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42126d38edcc8e3e8048224027046956238116c5ae90831c2c9a5cb7ff75b9c7","compact":"d13243182e22168799f2dec55e68ddab7fb219adceef87dd257cbf795048b3c5","nasal":"d13243182e22168799f2dec55e68ddab7fb219adceef87dd257cbf795048b3c5"}},{"id":"VRCE-4-61-2","kanda":4,"kandaId":"kishkindha","sarga":61,"verse":2,"english":"Your wings together with two smaller ones shall grow again; as also your sight, energy, prowess and strength.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-62-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4061002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7a431485c02ffb7e9d4d7f6965419e81baf361e29c2ead1be2d54ce56825f5ee","compact":"fe0f168d3440d2c08540f5d1e3567c6f42af7b7b17ea315ff28d0d972c7f08c2","nasal":"fe0f168d3440d2c08540f5d1e3567c6f42af7b7b17ea315ff28d0d972c7f08c2"}},{"id":"VRCE-4-61-3","kanda":4,"kandaId":"kishkindha","sarga":61,"verse":3,"english":"Having heard of it, and also seen it through ascetic power, I know that a great deed is going to take place.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-62-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4061003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9555c5ee5a25f8c3df819e11f77a852ce81fa826ae6977df3f067f510744acf8","compact":"250c0111eceb8a7945abb67e2927a3269309f9a0f0995661199cf5fc5927610