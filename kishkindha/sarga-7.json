[{"id":"VRCE-4-7-1","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":1,"english":"Thus addressed by the aggrieved Rāma, the monkey, Sugriva, his accents obstructed by vapour and his eyes filled with tears, said with joined hands,","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4007001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"55baebbe1aab96615ece68d23b86c856ab58bd3c3f174faf1f62f3727d0f863b","compact":"0cdb9eaa720ba79740aead8ff5d0aa6a317ac7c37afd69ab4c406c7f41129761","nasal":"a9e297db6c2c5cf047876abfab8182bbda1c5f560152cb7a54c26b1d2db95cba"}},{"id":"VRCE-4-7-2","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":2,"english":"I do not know the hidden abode of that exceedingly wicked Raksasa,-nor do l know his heroism and prowess, or the lineage of that one sprung from a vicious race.","alignment":{"type":"1:1","confidence":0.869,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4007002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8d01ba255552542473cefcb5cb5362e65813f33a3f518f30ea095ada7247e98e","compact":"a9c4bd80c8b18571b4ccb5f12a575b504228fba33fd8d21547e7b57594d4f26f","nasal":"a9c4bd80c8b18571b4ccb5f12a575b504228fba33fd8d21547e7b57594d4f26f"}},{"id":"VRCE-4-7-3","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":3,"english":"O vanquisher of foes, leave off sorrowing. I promise to you truly, I will exert so that you mayst obtain Maithilī.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4007003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"16e66c4d27379bd46b9a3cb249e5c83e004b173d3ce7c6d6e448e022f5a24457","compact":"0df5a2f503bdbaf077eece789ecbed832b9893b54d4b6b2210aeff786522847a","nasal":"0df5a2f503bdbaf077eece789ecbed832b9893b54d4b6b2210aeff786522847a"}},{"id":"VRCE-4-7-4","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":4,"english":"Slaying Rāvaņa with his hosts, and putting forth my manliness capable of pleasing others, I will speedily act so that you mayst be pleased.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4007004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ceaba296882e9b0306dc6e88c71c655e53e4a9e558340ccd1092c9b247822014","compact":"a93016e3f6a752382111605c5fb61248a07197cd2fd746454d9a90e6f2dd266c","nasal":"a93016e3f6a752382111605c5fb61248a07197cd2fd746454d9a90e6f2dd266c"}},{"id":"VRCE-4-7-5","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":5,"english":"Do not be overwhelmed with grief: summon the fortitude that is in you. Such lightness of sense does not become persons like you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4007005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d13e7826a021d4d480a14094cbab86f26630368205dc6a6b97376d996c0cc1ab","compact":"1dcf70da17ef8f145e74911a05fcb2ff7d74d6d71cb5ae7e6cdea8db39fac023","nasal":"51cdfd33f9b4a7a8f85273171524840318ab76df996eac3e5fca68a429835ccb"}},{"id":"VRCE-4-7-6","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":6,"english":"I also have experienced mighty disaster arising out of separation from my wife; but I do not weep in this wise,-nor do I forsake my fortitude.","alignment":{"type":"1:1","confidence":0.333,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4007006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b0b3c4c25d095ff027bda688f4d5134d8dc104a51ccceaf1c177071351a3ccba","compact":"a3b6f3ee97a79d381c80e35f1b879a1dadcb7470751cfec9cdc6b490d564c369","nasal":"a3b6f3ee97a79d381c80e35f1b879a1dadcb7470751cfec9cdc6b490d564c369"}},{"id":"VRCE-4-7-7","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":7,"english":"A despicable monkey as I am, I do not grieve for her,-and what again shall I say of one that is magnanimous, endued with meekness and firmness, and great?","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4007007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e279ddecfede0417b8fe83bcc6e26f89d0ff461a5c7e0d5fd34e98ea7162b4f1","compact":"7314c4cd193fc4a76eaa34c073cb3e4642611e10b8c8ba21c31e911db0b1cc43","nasal":"7314c4cd193fc4a76eaa34c073cb3e4642611e10b8c8ba21c31e911db0b1cc43"}},{"id":"VRCE-4-7-8","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":8,"english":"It behoveth you to restrain your falling tears by patience. It behoveth you not to resign that patience which is the dignity of persons possessed of the quality of goodness.","alignment":{"type":"1:1","confidence":0.987,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4007008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e2389052e7edcaf805b945a0acbf00fe08142c6f0a10ab765b93e4fd601ab13b","compact":"80f248572be69774833841b080a4d56e24d30a95986489cf7991e544862f3736","nasal":"610299a5d9219b0448fb0321f2161674cc147b777b703f4e1c759db4d2c852b0"}},{"id":"VRCE-4-7-9","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":9,"english":"Persons endued with firmness of understanding by help of their intellect, do not in calamity consequent on separation from dear ones, or on the occasion of loss of wealth, or of fear arising from thieves, wild beasts, etc., or of loss of life itself, lose their self-possession.","alignment":{"type":"1:1","confidence":0.838,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4007009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"580a166f56326d787721e33754f3f5badf8128de3dbc306553c74e159779c024","compact":"47929032f4ac9f0d92aef958d31d850d1e379e36fcec94f204eaf2452edae1d8","nasal":"fb0b2ea47c076ed71928741ccddc6b8dbc4277f862a5b9dfec7daac037d3a598"}},{"id":"VRCE-4-7-10","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":10,"english":"He that is senseless as well as he that suffers himself to be overwhelmed with grief, losing all control over self, drown themselves in sorrow like a boat bearing a heavy load in water.","alignment":{"type":"1:1","confidence":0.923,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4007010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"822c7728d6f84cf90597055dec9088b3edb1d1b01b8c7f750265e5107799166d","compact":"f74a49480ab00b990b7bc5bf151894b18db5f7cd2a0f1a3292896b4ed14e9229","nasal":"415c3a2181cba6a396e14692d04f4e9a2f2f6a535e4a8570b732613ac4a89239"}},{"id":"VRCE-4-7-11","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":11,"english":"I soothe you from the love I bear towards you. Do you have recourse to manliness. It does not behove you to let grief overcome you.","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4007011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f71e62a3fc9beadb2e80965f78d3583ce7c1b912c183352105b1d28729b2b012","compact":"a28ecf291fedb7a686ea442b48bb38bef18ae298588165d132dbda132fc15962","nasal":"e1add1cf6a7246de1626d656e8458949fe80c029785dd51ecb3286e01f19a3c4"}},{"id":"VRCE-4-7-12","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":12,"english":"Those that indulge in sorrow, know no happiness; and their virtue* goeth out of them. Therefore it behoveth you not to grieve. In the sense of energy.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4007012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7d1a40766dc6b393fa0f3d0a93b38b55ee9997f15d276e6a146da2c91c06e04a","compact":"fa52dc11ca2bc932f2174cf4506052d3a289bcbfb6dabbb735dc6e5101b5e9fe","nasal":"a353734c17b9e92a95095cb5195ce7a9bef52a45f5d94d5ea73ccf9970335e8f"}},{"id":"VRCE-4-7-13","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":13,"english":"In the spirit of a friend I tell what is for your good: I do not instruct you. Honour the amity I bear towards you. It behoveth you not to weep.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4007013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e9c9306a32270e73057b0b73111b2bb45f5315aefbe2d0e1fae40255f05d589","compact":"1e40b8b9ede0558a677a042804271b531f7bb2aba864dc410899bf682b3cff4d","nasal":"1e40b8b9ede0558a677a042804271b531f7bb2aba864dc410899bf682b3cff4d"}},{"id":"VRCE-4-7-14","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":14,"english":"Thus sweetly consoled by Sugrīva, Rāghava with the end of his cloth wiped his face tarnished with tears.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4007014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"72a1cf6d92149901a5631e0b6f900ea501796d810e38217db6200fcef14c202e","compact":"8ce604c08a9d86826b7c26013332373ec7dbc0acd49fc4c239a42dd9074cb6d8","nasal":"f1a746da6317992499a3468adf7597befcf21aa3acb0794cc7cde05df3eda9d0"}},{"id":"VRCE-4-7-15","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":15,"english":"And after that lord, Kakutstha, had recovered his natural state through the words of Sugrīva he embraced Sugrīva and addressed him, saying,","alignment":{"type":"1:1","confidence":0.739,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4007015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d9264f6285acacb619deafa6948ea61e9e6858d90b9f9322e2b2682dea340be8","compact":"3fbb479b7d238a117e749b8c1e414a1c75250fa54a5cc13a7464fa97577719d5","nasal":"3fbb479b7d238a117e749b8c1e414a1c75250fa54a5cc13a7464fa97577719d5"}},{"id":"VRCE-4-7-16","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":16,"english":"O Sugriva, that which, pleasing and profitable, proper and fit, ought to be done by a friend, has been done by you.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4007016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b0a542c42850405bf6d87b54e7dfe899e0f124d599111f69c9d60916b1adf0ec","compact":"45ff4ecb9c004dfc60cb27ee2ce1b71d1ebb23d862f33ae0b18f55bda61454d8","nasal":"45ff4ecb9c004dfc60cb27ee2ce1b71d1ebb23d862f33ae0b18f55bda61454d8"}},{"id":"VRCE-4-7-17","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":17,"english":"Solicited by you, I have, O friend, regained my natural tone of mind. Such a friend is rare, specially at such a time.","alignment":{"type":"1:1","confidence":0.683,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4007017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a0d84ed48595018b5781f5f48d4bc626f36507880f80190d2e9d84724f29a5e5","compact":"0a4569be354e793ba265e8c00cf20b587b44b31377ea7f20334e106057f0e731","nasal":"4aac8df4b9830f5528d27a23aef8b562843ae154b3f420459ba8332e2189708b"}},{"id":"VRCE-4-7-18","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":18,"english":"But you should strive to trace Maithili as well as bring about the destruction of that fierce Räks asa, the impious Rāvana.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4007018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8e873df98dc45c63ddae25b0ec4e61089a138c6ee6bf74898b44042386db6b52","compact":"641ae6308bf57f9c52e7ecb6dd8ae75e4b01b772ecc57d521acd2e62f94d93a6","nasal":"641ae6308bf57f9c52e7ecb6dd8ae75e4b01b772ecc57d521acd2e62f94d93a6"}},{"id":"VRCE-4-7-19","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":19,"english":"Do you also without reserve say what I shall have to do for you. Like corn sown in a fertile field in the rainy season, every concern of thine shall attain success.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4007019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ca2746449d44129e3c85a8e2f6bf12a13f9ad9f654d0968eda8170436b70a1b","compact":"0f213727ca2f28c432539324a207b8b7a096d7b7aac1985f38cdc416e681e37d","nasal":"0f213727ca2f28c432539324a207b8b7a096d7b7aac1985f38cdc416e681e37d"}},{"id":"VRCE-4-7-20","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":20,"english":"O best of monkeys, do you verily consider as true the words that I have uttered through affection.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4007020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02e6f36a8d08570ededdf036e9aa51d2929b1ac81c4e8ac074105869b8e2036e","compact":"db9d9425acbf7f191d016896e9ff20cde7df64d8582275a8a70350d63d740a57","nasal":"db9d9425acbf7f191d016896e9ff20cde7df64d8582275a8a70350d63d740a57"}},{"id":"VRCE-4-7-21","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":21,"english":"Falsehoods have I never spoken before, nor will I ever say one (in future). This I promise to you. I swear by truth itself.","alignment":{"type":"1:1","confidence":0.947,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4007021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5ea4d1a6cf99c2d96c5a2f6c9d13b873fc0f5f9ad74d2839d80821cb6d8f03ae","compact":"99218f39e62365ad5d9524cefed7262cb6cd0d7fac44f5459e70ca1816fe1368","nasal":"99218f39e62365ad5d9524cefed7262cb6cd0d7fac44f5459e70ca1816fe1368"}},{"id":"VRCE-4-7-22","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":22,"english":"Hearing Rāghava's words, and in special his promise, Sugrīva felt exceedingly delighted along with this monkey ministers.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4007022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f4cab6da8e6bff1eb21118bb55d088a42b78663f4ff2bb6cf46c9aa5cd37da07","compact":"c482dbf14a8c7739cbded5b2ae1bf55796c2d49fe6e25da72d84639122863d2f","nasal":"c482dbf14a8c7739cbded5b2ae1bf55796c2d49fe6e25da72d84639122863d2f"}},{"id":"VRCE-4-7-23","kanda":4,"kandaId":"kishkindha","sarga":7,"verse":23,"english":"Hearing the words of that illustrious monarch of kings, that hero-greatest of monkeys-considered and felt in his heart as if his work had already been accomplished.","alignment":{"type":"1:1","confidence":0.354,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-7-25"],"status":"unreviewed"},"source":{"sanskritLocator":"4007023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6c4fa2a9ae5634bac9e5aaedeba56e56f5c15d7387eb28e151502adcb5008d22","compact":"c3b928675ef83fa87819a33bd5ab2b81805db452126c14eeecad5acab1aa489f","nasal":"c3b928675ef83fa87819a33bd5ab2b81805db452126c14eeecad5acab1aa489f"}}]
