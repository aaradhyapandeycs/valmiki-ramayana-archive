erprints":{"exact":"7cb81c6bb45a75c7809b7155aada460eb214ba026d5398dded049abbd7df5b70","compact":"08bf1724b2d73707d3ffc6be9b5f58ca7f111e0d5e35f07e82f2e7a7bdcce1e1","nasal":"08bf1724b2d73707d3ffc6be9b5f58ca7f111e0d5e35f07e82f2e7a7bdcce1e1"}},{"id":"VRCE-4-55-9","kanda":4,"kandaId":"kishkindha","sarga":55,"verse":9,"english":"You have in detail heard all that, inspired with the desire of doing what is good to Vaidehi, that king of vultures, Jatayu, did here.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-56-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4055009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f1b5e986b633bcbc9fa8bfb71cec7cbe3d4e6d118266b6eda47528c5e670ac67","compact":"8eb3b49c0890254e45bc0c1b921512d243aac1a79a56cad78df628f9a224bcf1","nasal":"8eb3b49c0890254e45bc0c1b921512d243aac1a79a56cad78df628f9a224bcf1"}},{"id":"VRCE-4-55-10","kanda":4,"kandaId":"kishkindha","sarga":55,"verse":10,"english":"In this way, all creatures, even the brute species, compass the welfare of Rāma, renouncing their lives, as we do.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-56-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4055010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9d08aba8cb923c38b75a5d7c349f3fac6a6d8f2ae9ecde45a09c2b4fc984c341","compact":"5536941c0a7d0e40908f1707649d227445c5a636a183f8734de77eae8837dde5","nasal":"bdef8a17070303d8eac9435ffb796a8e4d58e308e9c33d540b065d25637052d0"}},{"id":"VRCE-4-55-11","kanda":4,"kandaId":"kishkindha","sarga":55,"verse":11,"english":"Therefore the righteous Jațãyu, of his own accord laying down his life, has done the pleasure of Rāma. We also, overcome with fatigue and (almost) dying, have come to this forest; but Mithila's daughter we find not.","alignment":{"type":"1:1","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-56-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4055011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4c675ed49f7fbaca70409a1f9b5ba33fc77792a430c58986eaa55e9ddfcd1c3b","compact":"6e2ac9713386278b85393bcf0a2ff443a155a8bb21ecb1f8a64138f4e4996e5c","nasal":"332aa9929f0147d0051f8dcc18d9485467d88acb1da2eb36c3c0e167b83f0a42"}},{"id":"VRCE-4-55-12","kanda":4,"kandaId":"kishkindha","sarga":55,"verse":12,"english":"Happy is that king of vultures, having been slain by Rāvaņa in battle. He has got quit of the fear of Sugrīva, and has also attained supreme state.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-56-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4055012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"03225608f149a5632823e4d5a070f8e0ebd5a95ec98eb523095038387b8da7c9","compact":"822bacf1963fe684ea687e3d54edc6690c427570deecb18cc299043b42f155f6","nasal":"822bacf1963fe684ea687e3d54edc6690c427570deecb18cc299043b42f155f6"}},{"id":"VRCE-4-55-13","kanda":4,"kandaId":"kishkindha","sarga":55,"verse":13,"english":"In consequence of the death of Jațāyu and that of king Dasaratha, as well as owing to the ravishment of Vaidehi, (the lives of) the monkeys have come into jeopardy.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-56-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4055013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5512e623775d2f768316699df3414785e3ad3bc8e7550f873b3113f935c61e40","compact":"362d9b6d24736ccb256addd5e9e2fd35b142187a7bcab4695c6958c31489dd14","nasal":"362d9b6d24736ccb256addd5e9e2fd35b142187a7bcab4695c6958c31489dd14"}},{"id":"VRCE-4-55-14","kanda":4,"kandaId":"kishkindha","sarga":55,"verse":14,"english":"Rama's and Laksmana's abode in 