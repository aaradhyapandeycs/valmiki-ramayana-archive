gram","duttRefs":["DUTT-4-11-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4011009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f68c1fe34be268f652025dacb132590fd0a55387864f7069279459bc021b1e25","compact":"586e6c974c682680bbfaa201e9b505c1d1c4dfd455bd48430d2f0d027e7fd729","nasal":"413d8e0aad5009971b51ff6aed7761420d6a73351662e7757ac31bdefb3f7c25"}},{"id":"VRCE-4-11-10","kanda":4,"kandaId":"kishkindha","sarga":11,"verse":10,"english":"Thereat the righteous-souled and mighty Ocean arose and, O king, said these words to that Asura, who had been urged by Death.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-11-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4011010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"168b3b72d5de0b153548f93bc9bfd6753dbe2188159d27e138a1b456f582c124","compact":"80c881d61855c2c219aeca6b8c3cb9d81ea18267ab4de6324bfff23486061247","nasal":"fe885bbb05196eeb8685164b0cfc8cc0c6473372953cf9efd998afd7facf6905"}},{"id":"VRCE-4-11-11","kanda":4,"kandaId":"kishkindha","sarga":11,"verse":11,"english":"O you that are skilled in fight, I am not competent to offer you fight; but lister to me who will tell you who shall offer the fight.","alignment":{"type":"1:1","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-11-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4011011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5b59a137d3c6b861d7c888748fb3cd9ea70edee4877e192286308ea65249af11","compact":"2ca5ae683e90457258a2f86ca234f0ea6a147d47b62450010472c2a9aefa8209","nasal":"2ca5ae683e90457258a2f86ca234f0ea6a147d47b62450010472c2a9aefa8209"}},{"id":"VRCE-4-11-12","kanda":4,"kandaId":"kishkindha","sarga":11,"verse":12,"english":"There is a monarch of mountains in a mighty forest,—the great refuge of asceticism, the worker of the weal (of all), an Asura, celebrated by the name of Himavān containing great cascades and furnished with many fountains and caves. He can compass your incomparable pleasure.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-11-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4011012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a2f85e55a0d0b7102c88a5de1d41d97cb2a1b63b1610976d39bf16f24f3f19a8","compact":"26fe8c724462262affdc29d6f170b6c21ba137d2ac6bda72983e2c586837dfad","nasal":"26fe8c724462262affdc29d6f170b6c21ba137d2ac6bda72983e2c586837dfad"}},{"id":"VRCE-4-11-13","kanda":4,"kandaId":"kishkindha","sarga":11,"verse":13,"english":"There is a monarch of mountains in a mighty forest,—the great refuge of asceticism, the worker of the weal (of all), an Asura, celebrated by the name of Himavān containing great cascades and furnished with many fountains and caves. He can compass your incomparable pleasure.","alignment":{"type":"grouped","confidence":0.895,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-11-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4011013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7979755f007c72ca292e9547e678f56fdf59dcd1005a32f49d137eaba31c379b","compact":"037394e4ce9358b6a20c54be2078dd6cc852228cc6ffffa8653ba4aca22c014e","nasal":"f0df0ced16abd6493f2e6bb0d5ac4905eae1297500134c64f48e1634867260ae"}},{"id":"VRCE-4-11-14","kanda":4,"kandaId":"kishkindha","sarga":11,"verse":14,"english":"Concluding that the ocean was afraid, that foremost of Asuras, presented himself in the wood of Himavān, like a shaft shot from a bow. Thereupon Dundhubhi began to throw down many white crags resembling the foremost of elephants; and sent up shouts.","alignment":{"type":"grouped","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-11-13"],"status":"unreviewed"},"