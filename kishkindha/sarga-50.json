[{"id":"VRCE-4-50-1","kanda":4,"kandaId":"kishkindha","sarga":50,"verse":1,"english":"Having said this to that female clad in a piece of black deer-skin, Hanumān asked that highly religious ascetic practising pious offices,","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-51-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4050001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2a7559fbc2c7de6384259054966e22fe1c1e56e8b9840f3f8c7c2c026aa7f0c5","compact":"ed0ed4d01029feb3eff79c287fb72d11141fb44bc25b722daeed23799ab01e24","nasal":"9d47100f41c798693f9ac2f0a82c07ffb99f3e815a97306fbfffd83cd92738d1"}},{"id":"VRCE-4-50-2","kanda":4,"kandaId":"kishkindha","sarga":50,"verse":2,"english":"Having rashly entered this cave enveloped in gloom, we have been exercised with hunger and thirst; and are extremely faint. And, having entered this mighty cave underneath the earth, we have become thirsty. And, seeing all these wonderful phenomena, we have become afflicted, and bewildered; and have lost our sense. To whom belong these golden trees resembling the infantine sun;","alignment":{"type":"grouped","confidence":0.735,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-51-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4050002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5134330337368d5708f65f7db1f2a1a7fd7d27afe0041a83e94fe2f377d93131","compact":"6c7578c16307ddfa77f9ae902d601ade21bae46b851ec327f8bb5a5283015a9d","nasal":"2ff46b522df9be6143dcc83e57723e1865df21bb02f2791e532b27b4437a241c"}},{"id":"VRCE-4-50-3","kanda":4,"kandaId":"kishkindha","sarga":50,"verse":3,"english":"Having rashly entered this cave enveloped in gloom, we have been exercised with hunger and thirst; and are extremely faint. And, having entered this mighty cave underneath the earth, we have become thirsty. And, seeing all these wonderful phenomena, we have become afflicted, and bewildered; and have lost our sense. To whom belong these golden trees resembling the infantine sun;","alignment":{"type":"grouped","confidence":0.904,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-51-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4050003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02d08a21e02ddb82326b9b69dfb595fe81843cb0a602b56a6fee0b275859e380","compact":"8e24f778efc941c33b971130a05fdc2bedb9473c986f26acac6d1d408236ee5c","nasal":"7b776a20b70b8ed72e8e2ce6e007d75cd7192904309d8fe40b1b39e975afbfbf"}},{"id":"VRCE-4-50-4","kanda":4,"kandaId":"kishkindha","sarga":50,"verse":4,"english":"Having rashly entered this cave enveloped in gloom, we have been exercised with hunger and thirst; and are extremely faint. And, having entered this mighty cave underneath the earth, we have become thirsty. And, seeing all these wonderful phenomena, we have become afflicted, and bewildered; and have lost our sense. To whom belong these golden trees resembling the infantine sun; And the pure fruits and roots, and the houses and vehicles of gold and silver,-veiled in networks of jewels, and furnished with golden windows? And by whose energy are these golden trees (here), bearing flowers, crowned with fruits, grateful to the sight, and breathing rich odour?","alignment":{"type":"split","confidence":0.391,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-51-2","DUTT-4-51-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4050004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"814791a32f507c510da621b80b4d40cac461fdc1878a1337c5b66b3aa144e8fa","compact":"0c966a63ce999114ae219214326ca0164bdc5c9541b6974a9c31fc7ef61b362f","nasal":"10ff214f523a757b15068a000a61427edb6b2e9f74513992716f6af09d972470"}},{"id":"VRCE-4-50-5","kanda":4,"kandaId":"kishkindha","sarga":50,"verse":5,"english":"And the pure fruits and roots, and the 