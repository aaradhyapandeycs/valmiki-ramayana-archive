"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-59-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4058019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"fb024ac8ca87f65d2d96e37ada30bd36bb17e6ca70e65d7e99e3251d686494b7","compact":"6e1dcee7e442d8ac9440dcab1d646445d11a37828f624ab20d49bdeeeaef336f","nasal":"6e1dcee7e442d8ac9440dcab1d646445d11a37828f624ab20d49bdeeeaef336f"}},{"id":"VRCE-4-58-20","kanda":4,"kandaId":"kishkindha","sarga":58,"verse":20,"english":"Then those eminently handsome Siddhas spoke thus to me.-This is Ravana, the king of the Rākşasas, said they to me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-59-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4058020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7636987bdfa76571639ae4f43cebb5ccac551b30f40a003bc8122f703eba9de3","compact":"e353286fc0c2f2f79aa3453e85efe4cd46a05175daedd3aa56dda24b15ba02da","nasal":"e353286fc0c2f2f79aa3453e85efe4cd46a05175daedd3aa56dda24b15ba02da"}},{"id":"VRCE-4-58-21","kanda":4,"kandaId":"kishkindha","sarga":58,"verse":21,"english":"I (stood), beholding the wife of Rama, son to Dasaratha,—throwing off her ornaments and silken apparel, overwhelmed by might of sorrow, with hair dishevelled crying out the names of Rāma and Lakşmaņa. This O father, is the reason of my passing the time.' That best of those skilled in speech, Suparswa, said all this to me. Even hearing of this, I could not think of putting forth prowess.","alignment":{"type":"grouped","confidence":0.967,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-59-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4058021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"22a8bd511e74b6cec50d31858f986411062f815b2a4698e1009825064b3b6050","compact":"a81abe50ab96