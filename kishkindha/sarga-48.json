m04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"85d67b010fa29d376a5f4ae879fc0eddd9d1ce2764b38154aa82ce5635832bce","compact":"aeaf2c5eb8fc5f1e1902854db39864e17d96cec50fdc07d99a2384211c1cb5b5","nasal":"98dbb205d62595e11c453944c2bd25177057487012a7fd437a7ec29099d7260b"}},{"id":"VRCE-4-48-18","kanda":4,"kandaId":"kishkindha","sarga":48,"verse":18,"english":"And ascending its top*, those ones endued with immense prowess, experiencing fatigue, could not find Vaidehi, the beloved spouse of Rama. *i.e. the top of the Silvern Hill.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-49-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4048018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6f20e130ed03abf5fa6d517bd20aeedc1db21b812801d5e4e1c0782685d48803","compact":"cfc0a6d75271a11743b4a73e717c4c47506f985bb7ee9ce86078b9ba7c5b62fd","nasal":"b9abbe86135ea3c47f007de59a6b079e4743fbb985a365f3104cbf41ec6201a6"}},{"id":"VRCE-4-48-19","kanda":4,"kandaId":"kishkindha","sarga":48,"verse":19,"english":"And having surveyed that hill having many a grot, so far as the eye could range, the monkeys looking all round, descended (the eminence).","alignment":{"type":"1:1","confidence":0.69,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-49-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4048019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cf4806521f63705431107cf5f65e9a370cc48835a6e4a12cd2ea3888b6a3ac11","compact":"de7e104acc4272abfe09227489c67623307fb33c7606faf105ab4189c7ef5871","nasal":"da30b7397856d11d779c563812c460cc41436b2758062cbde6e4a9dbc474cffb"}},{"id":"VRCE-4-48-20","kanda":4,"kandaId":"kishkindha","sarga":48,"verse":20,"english":"And having descended to the earth, the monkeys, bewildered, and losing their consciousness, rested for a while at the foot of a tree.","alignment":{"ty