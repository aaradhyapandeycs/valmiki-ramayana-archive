T-4-23-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4023006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9e9983441b62f206c3ef46235246094477e29ba219c6d64ebd60c7a99d3165c3","compact":"4430dc2875715c51000f386ce22fa0f54644e59c1348586b2812cd0801cf2c25","nasal":"4430dc2875715c51000f386ce22fa0f54644e59c1348586b2812cd0801cf2c25"}},{"id":"VRCE-4-23-7","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":7,"english":"O you born of a pure family, O you that are fond of warfare, O my dear, O conferror of honours, whither have you departed making me husbandless?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4023007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"08e84e2a6638898d77d2afae469ca320b956b037bf733407b92effe7434bc462","compact":"9bee564178c82f233b0ac94a9c96f6eb12da3abe383f0f1a1c50265578d9aedd","nasal":"9bee564178c82f233b0ac94a9c96f6eb12da3abe383f0f1a1c50265578d9aedd"}},{"id":"VRCE-4-23-8","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":8,"english":"Let not the wise, henceforth, confer their daughters upon the heroes. Alas! behold me, the wife of a hero, made a widow in no time.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4023008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0de0243db62a4500ef1a62387da975a4eea889c7ccbf8e053851f76eeba7dd95","compact":"68156e502204812dd652a8fbbb4cb3b948ecd40ae1ea16fba6c9fdb4af93fa74","nasal":"68156e502204812dd652a8fbbb4cb3b948ecd40ae1ea16fba6c9fdb4af93fa74"}},{"id":"VRCE-4-23-9","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":9,"english":"Shattered is my honour and destroyed is my happiness and I am sunk in the deep abyss of grief.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4023009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"df614688858807197690f4c11560bdc7463d81f8e62d78a69216db7aaabffa47","compact":"30618d4f26a5302d1401c3ebaf573a96d37911efacd98c00d355fadb65b0ee6f","nasal":"30618d4f26a5302d1401c3ebaf573a96d37911efacd98c00d355fadb65b0ee6f"}},{"id":"VRCE-4-23-10","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":10,"english":"Forsooth, this my firm heart is not sundered into hundred pieces, beholding my husband slain!","alignment":{"type":"1:1","confidence":0.931,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4023010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c5b40432d5e627a94c19b8f2c3def3897a92f32e252246127aaf8e3c773dc111","compact":"7b36d6d3760c1090e00117ab7a3cd9e1dc619267c358fb2662c7bdf18e5a27bf","nasal":"c7690bede7b3ee5c592caef4d13e9125c5c484e06f709a5e20104163893f467e"}},{"id":"VRCE-4-23-11","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":11,"english":"You are my friend, my dear husband and a great hero-and you had met with destruction, being struck by another man.","alignment":{"type":"1:1","confidence":0.683,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4023011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"84af7b0963c18252d95e5775403edf755a8691c8dd9daa453a9d2706ff587497","compact":"c33ef75158c998a155296177b134b66b66f105050dd7ea856fa53dc552b5dccd","nasal":"858c7956bc78b7869c181c4e649ed4aaaece34f356834fcb9b03c5ab2fbc87ba"}},{"id":"VRCE-4-23-12","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":12,"english":"A husbandless woman is always styled by the wise as widow, although she might have a son and enough of riches.","alignment":{"type":"1:1","confidence":0.661,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4023012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"67f59d186078e1d0e08e9e8a1699db6e0bfebf0e30a250aac2da4f90e4527e7b","compact":"456bf611c230d6b48a3e4999644da7b28921e960e8747a0d2de67629856b620d","nasal":"456bf611c230d6b48a3e4999644da7b28921e960e8747a0d2de67629856b620d"}},{"id":"VRCE-4-23-13","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":13,"english":"O hero, you are lying down in a pool of blood issuing out of your own person, like to your own bed having a red-dyed bed-sheet.","alignment":{"type":"1:1","confidence":0.745,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4023013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5f24521ebbec25a96c591726b73abbef48df79744a4853867c180df6f4df0016","compact":"0225b778abcceb8af4f283a2a6dbc9147a823ec3ff6f15c701ebb523a610ab4c","nasal":"4620ef261430df2689dfe3dcb79914ef654e228d8cfbc98d79ca8572248db76a"}},{"id":"VRCE-4-23-14","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":14,"english":"Your body is on all sides besmeared with blood and dust and I am incapable of embracing you with my arms, O best of monkeys.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4023014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"334f64aad075ddaee1d7f14a42e69c080b14928be99e0602b472df29a4ec0e6c","compact":"d533d655f1ed7ab432ad433fb1af68ea84880ec85cd63c30486451c552d025dd","nasal":"b5d82f049aed6e532ed5a074512171d2af3d56618a053ad2c3c34b335523d071"}},{"id":"VRCE-4-23-15","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":15,"english":"Surely has Sugrīva satisfied his hostile intention to-day, whose fear has been removed by one shaft, discharged by Rāma.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4023015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"03bac509dc7250a7936edda2af94e0c25029be158ea565bbfc642365a2be6f4f","compact":"a524b7f89b20d1579b53cdbe1e8d5ffeade6828a7b564dabc21adbdf89cb2244","nasal":"79a223cf0aa0f266977c4a70a7c88cc88d28d39dbaab285e82292f720382992f"}},{"id":"VRCE-4-23-16","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":16,"english":"Thyself departing to the land of the dead. I have been eyeing you simply, being prevented from touching your person by the shaft piercing your heart.* The meaning is:-Lest by my touching that shaft you feelest a greater pain.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4023016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ea7cf78861686c3b0a94b2b064144885cad0a164708545fa3790cd5f62734d0","compact":"c956f60ee43e78867d63929889b8a5a4d18d2096588cbd908b5b849202eba938","nasal":"2f2d489763f2e1e4a1a928bb52007a6820f792e78c9e3e8de68e14831d13ce4d"}},{"id":"VRCE-4-23-17","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":17,"english":"Thereupon Neela took out that shaft from the person of (Vāli) like to a flaming serpent lurking in a mountain cave.","alignment":{"type":"1:1","confidence":0.927,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4023017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b527d973734d3668eafcd38e9f7e02b6899c6457d9513588097925c88a3a432","compact":"8180ca3fdc7c19c3641dc7b41fedc6887fa4e9d