[{"id":"VRCE-4-23-1","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":1,"english":"Thereupon smelling the face of that lord of monkeys, Tārā again addressed her deceased lord, known all over the world, saying.","alignment":{"type":"1:1","confidence":0.738,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4023001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e15d2ccf35aaa87ce8bdbd24db84de1667c426d8987dec72b71152592039c502","compact":"25d9a8fb1807790f8f216a4f727671fa44f24b8af89b26e349fcef9eea6c0520","nasal":"df892dd0ef145609845668c85f5cfb64777a433eae1c3f952723f933cffb4ad7"}},{"id":"VRCE-4-23-2","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":2,"english":"O hero, disregarding my words, you are lying on the uneven earth, hard and filled with gravels.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4023002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c837a9ca7009e27efbfbabc5ae45238d062886712a1474a9fb3ea1fbecf113b7","compact":"0a53b5565ed851c38a7ff32e2464487b212524cd8dba0c5c8a9af68d24d340d9","nasal":"0a53b5565ed851c38a7ff32e2464487b212524cd8dba0c5c8a9af68d24d340d9"}},{"id":"VRCE-4-23-3","kanda":4,"kandaId":"kishkindha","sarga":23,"verse":3,"english":"O lord of monkeys, the earth is dearer to you than I, since you are lying there embracing her and are not welcoming me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-23-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4023003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"446a0934487d5bd3d5ba6b45fe04e4d95ccbc57febb89bab66f59f8a74f7a5e2","compact":"d62ddf7451a424df546aeeb87bf1f5121cc902d84004de88bc435d00fbe8e169","nasal":"16d61cea078a