[{"id":"VRCE-4-5-1","kanda":4,"kandaId":"kishkindha","sarga":5,"verse":1,"english":"Having departed from Rşyamuka, and arrived at the Malaya hill, Hanumān informed the king of monkeys of (the arrival of) the descendants of Raghu.","alignment":{"type":"1:1","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-5-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4005001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"24ffcede28e927bbbe2ae372055e6c17abe916ce999d4353d580505d39a89c0e","compact":"32699005e63ed969701e94b05008736197fb2ff21955acac26f452da842d52a1","nasal":"32699005e63ed969701e94b05008736197fb2ff21955acac26f452da842d52a1"}},{"id":"VRCE-4-5-2","kanda":4,"kandaId":"kishkindha","sarga":5,"verse":2,"english":"O exceedingly wise one, this one that has come here is Rāma having truth for his prowess.","alignment":{"type":"1:1","confidence":0.851,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-5-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4005002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c7ba8f8e1953c85581e091503bc9900ce0a3989081d112ce732866e9f05ff6d0","compact":"c9d185abc47dac243f3dc40152ab99654a70af49bac02a9404060bb2caac9234","nasal":"c9d185abc47dac243f3dc40152ab99654a70af49bac02a9404060bb2caac9234"}},{"id":"VRCE-4-5-3","kanda":4,"kandaId":"kishkindha","sarga":5,"verse":3,"english":"This is Rāma having truth for his prowess, in company with his brother, Lakşmaņa. Rāma the son of Dasaratha, is born in the race of the Ikş wākus. Ever doing the will of his sire, he has been sent hither, in order that his father's verity may stand in tact.","alignment":{"type":"1:1","confidence":0.77,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-5-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4005003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"04a558cef1db72ef83d