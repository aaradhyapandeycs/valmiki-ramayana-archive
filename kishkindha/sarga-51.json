[{"id":"VRCE-4-51-1","kanda":4,"kandaId":"kishkindha","sarga":51,"verse":1,"english":"Then to all the monkey-chiefs, after they had rested, the female ascetic, engaged in righteous practices, eagerly said these words,","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4051001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79d4264b75b8a1ae38ac98e9c6aaa0b1a5eaac3766dd18ac1fcc47cc94bb7c5b","compact":"dc289567b4c411685efb31120acb53ea6cd4bd33d3c29f09bc1795f9b6594b7b","nasal":"f506989a0f048eeed3cc471ce428276f8333d8970e824dcbc0d73926a0b300be"}},{"id":"VRCE-4-51-2","kanda":4,"kandaId":"kishkindha","sarga":51,"verse":2,"english":"You monkeys, if your pain has gone off in consequence of the fare of fruits which you have partaken, and also if it be fit to be heard by me, I would listen to your narration.","alignment":{"type":"1:1","confidence":0.758,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4051002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7169f17dae08d01de0add8b8a83456993942433b2e9d1eb8ac1e4ebee9920ede","compact":"1dd50018c12b196a00e8024f8e97eaebcdc4c4d8b23757dc1c03e8a8f08e8cc5","nasal":"1dd50018c12b196a00e8024f8e97eaebcdc4c4d8b23757dc1c03e8a8f08e8cc5"}},{"id":"VRCE-4-51-3","kanda":4,"kandaId":"kishkindha","sarga":51,"verse":3,"english":"Hearing her words, Hanumān, the son of the wind-god, in all candour began to relate everything faithfully.","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4051003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0f1c7d1fb257f669af92a198f550801dd6672c2de71e22f99b7172e6172e42cf","compact":"9967b8b1daf