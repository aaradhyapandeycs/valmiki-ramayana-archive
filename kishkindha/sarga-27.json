[{"id":"VRCE-4-27-1","kanda":4,"kandaId":"kishkindha","sarga":27,"verse":1,"english":"Thereupon encompassing the destruction of Vāli, installing Sugrīva and dwelling on the summit of the Mālyabana hill, Rāma spoke to Laksmana, saying,","alignment":{"type":"1:1","confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-28-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4027001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c0fa949f7fb307cc2abe1841808986bc2cd4767719c5bb7d3c4b85f939cf9a8","compact":"fe97d6a4923fd5262dbe958c078c77eacb72c2b19c318ef3f41106e821e7356d","nasal":"fe97d6a4923fd5262dbe958c078c77eacb72c2b19c318ef3f41106e821e7356d"}},{"id":"VRCE-4-27-2","kanda":4,"kandaId":"kishkindha","sarga":27,"verse":2,"english":"This is the time the beginning of the rainy season-do you behold the sky enveloped with clouds resembling so many hills.","alignment":{"type":"1:1","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-28-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4027002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b22daeb34d790721128f77b01f07a4ad7240676e0d2a5960452a156cf485e3de","compact":"2cb5c2e3fb2bb9b10d0cbdadaa27fec864f690f427facabe31747090b468dc5a","nasal":"2cb5c2e3fb2bb9b10d0cbdadaa27fec864f690f427facabe31747090b468dc5a"}},{"id":"VRCE-4-27-3","kanda":4,"kandaId":"kishkindha","sarga":27,"verse":3,"english":"The sky, drinking the liquid contents of the ocean through the rays of the Sun, and being enceinite for nine months, is giving birth to showers.","alignment":{"type":"1:1","confidence":0.781,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-28-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4027003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f88cce75b979709b6416501705c7e1f22c7841f3ee81b9bdccd09e9da78c96d6","compact":"c8013da23b43