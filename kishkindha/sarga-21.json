14","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a3144c23016b14ea822d92e3e7e60d16d3fc576f0e14c6c7f50fd80b4bff738a","compact":"29c4fb1855f5cbc21455bc5c538fe77436d96053d6ad7b6b80c521d03789006d","nasal":"f20fcd55a5e6d8c339c37477ccc00f88312e0c05accaa9cb5158a6b8d247f8c5"}},{"id":"VRCE-4-21-15","kanda":4,"kandaId":"kishkindha","sarga":21,"verse":15,"english":"O Hanumān, do you not consider that I shall confer this kingdom upon Angada-0 best of monkeys, father is son's friend (in this respect) not mother.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-21-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4021015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7ef588ef2a1a79dd4757ecef14adc8f11c210fb72cc859a57dfe8b427316577c","compact":"ef03ac41611b9430baf8f1db0904d0c740786c1640975a7c3b1e02e553db48bf","nasal":"399fe98da88a3e0298e96eb473d68919e552402ce779fd0a1036e78c1fb13a3a"}},{"id":"VRCE-4-21-16","kanda":4,"kandaId":"kishkindha","sarga":21,"verse":16,"english":"There is no other resource for me tending to my welfare both in this world and the next than taking refuge to this lord of monkeys. It is becoming for me to serve this bed which has been resorted to by the hero, slain (and lying before me.) monkeys, father is son's friend (in this respect) not mother. There is no other resource for me tending to my welfare both in this world and the next than taking refuge to this lord of monkeys. It is becoming for me to serve this bed which has been resorted to by the hero, slain (and lying before me.)","alignment":{"type":"split","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-21-16","DUTT-4-21-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4021016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2dc061016238bad0caf5f32c884841ed375f31763