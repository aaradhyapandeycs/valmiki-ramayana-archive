[{"id":"VRCE-4-17-1","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":1,"english":"Thereupon Vāli, adept in warfare, wounded by Rāma's shaft, fell down to the ground like to a felled tree.","alignment":{"type":"1:1","confidence":0.867,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4017001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f8a1b5aa549b7b86f0e20fbdd8653a3b182ac1c9fb3e7239d9a79f28786de556","compact":"74b647761b8b3343c1a66654f9457a69087d946a70db13b35360749bd016b1ef","nasal":"74b647761b8b3343c1a66654f9457a69087d946a70db13b35360749bd016b1ef"}},{"id":"VRCE-4-17-2","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":2,"english":"Ornamented with burning gold, he stretched the whole length of his person on the ground like to the banner of the Lord of celestials, loosened and thrown (off the chariot).","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4017002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87847dde0c1050544d50928762a32508dbd11ddbf6d796f50280355f5204697c","compact":"fe37efa0f7f01756fd1166c3262280328a9d385aa3acee059b4861fa7f4c2caa","nasal":"02ec5ad3660ab8f1f2dd9648c51abd9672b8526ddf0e04e8d6b0c72b283c79b9"}},{"id":"VRCE-4-17-3","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":3,"english":"That lord of monkeys being levelled to the ground, his kingdom appeared like to the sky, shorn of the Moon.","alignment":{"type":"1:1","confidence":0.705,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4017003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cbe8112f2186b7ef7f8e691cdfe18bb6a56e86ac1038786874b94c4d6c30828c","compact":"bc1665292cb547dfc9bd4c1bd9ba5b4dd09792c56