3e7d76c0fa907e1f5f2d3ab85009fe86bcbbcdd01e29ef57b91b32"}},{"id":"VRCE-4-17-13","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":13,"english":"What merit have you reaped by destroying me, who was not engaged in fight with you? I was exercised with ire, being engaged in conflict (with another person) and for you I have met with destruction.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4017013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cd08a102294e320481a64ffc184cd36f374f081ed8ef4aea8bdc222c44426a95","compact":"6f76a30c77a958d90c2a5f265682ab8add4866a132bb44c196e4e91c951a589e","nasal":"6f76a30c77a958d90c2a5f265682ab8add4866a132bb44c196e4e91c951a589e"}},{"id":"VRCE-4-17-14","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":14,"english":"People speak highly of you, O Rāma, on this earth, describing you as coming of a high family, gifted with manliness and prowess, ever engaged in the welfare of your subjects, compassionate, energetic, of firm resolution and knowing time.","alignment":{"type":"grouped","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4017014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"06809af01723a1dad2e15ae08c484fa7494baa02681a123ba197f0d50c771e23","compact":"1e0bdd89a9f7e1191b78d132d6e99a121a8e059030153d69f1bcd6d829638408","nasal":"a51ab040d2203deddb22c2691880601fd4f91d0d66960497c654d04e29d6d07c"}},{"id":"VRCE-4-17-15","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":15,"english":"People speak highly of you, O Rāma, on this earth, describing you as coming of a high family, gifted with manliness and prowess, ever engaged in the welfare of your subjects, compassionate, energetic, of firm resolution and knowing time.","alignment":{"type":"grouped","confidence":0.821,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4017015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0a61d4a6daa9a898527fb915d2d5f2584708f964f0b0ac784413fee86f3b52ca","compact":"4bb590dcd92156d6374652c65b5e23b7a391a237559c1a5db444308a080ca9ad","nasal":"77bb4a39cc5898e3214584c7bb13d12d8c4da86b2f55ac90e50e8e5bb80e9cce"}},{"id":"VRCE-4-17-16","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":16,"english":"And knowing your high pedigree, and all these your accomplishments I approached Sugrīva with a hostile intention, albeit prevented by Tārā.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4017016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"79e85e93b40e6cea6f6191cca797f878c38e9f19e2147ecb68d5f88b859d2a25","compact":"e3024fccda6b616831e48457fdb69479013fb037127ac9ff38ab309be1770fea","nasal":"e3024fccda6b616831e48457fdb69479013fb037127ac9ff38ab309be1770fea"}},{"id":"VRCE-4-17-17","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":17,"english":"Before I saw you I had thought within myself:-'Forsooth Rāma shall not destroy me, engaged as I am with another person and hence not prepared to fight with him.'","alignment":{"type":"1:1","confidence":0.742,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4017017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"931bf654d73b9d3160dc27d841307898e9518773554b7faf4791c0f8e5e083ac","compact":"423aabc09e57571589a7621b4058c236e1b2bbc717d43216420a1df5d708119c","nasal":"3e2be27c81c5601bd4407ce2d5619912a46850cc111732a2cf384e568361715f"}},{"id":"VRCE-4-17-18","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":18,"english":"I do now know you as one who has spoliated his soul through impious actions, feigning religion while in truth an irreligious person, resorting to all vicious deeds, like to a well crusted with grass, unrighteous while passing under the clock of honesty and religion like to a hidden fire.","alignment":{"type":"grouped","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4017018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"df8901d034d6e6a73ca48cd5ca3ecd78dcfdce1c49a4966ce0d4cac6812c5edd","compact":"bd347d9d13f9a6922738fd985d93ee9b7612d37b1db37cf6f40237b4a1cbc0b9","nasal":"bd347d9d13f9a6922738fd985d93ee9b7612d37b1db37cf6f40237b4a1cbc0b9"}},{"id":"VRCE-4-17-19","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":19,"english":"I do now know you as one who has spoliated his soul through impious actions, feigning religion while in truth an irreligious person, resorting to all vicious deeds, like to a well crusted with grass, unrighteous while passing under the clock of honesty and religion like to a hidden fire.","alignment":{"type":"grouped","confidence":0.871,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4017019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2f956789eed86833ccaea5db077f9518879551d390b28f11fdabb2b2e312b8d9","compact":"67f331f8b905fca9e7d0a311166df02f11443b7ad1f544e85e224e4f0b57c689","nasal":"28ab82db8bde1b543cc1149ca3f1718b8efcd1e6c2e70995bed250624d2e6a32"}},{"id":"VRCE-4-17-20","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":20,"english":"I have not done you any wrong either in your kingdom or in your city. Nor have I passed by you. Why have you then destroyed me, who am a monkey ranging always in the woods, living on fruits and roots and who have come here to fight with another person? It appears that you are of a kingly father and of a graceful countenance. And, O king, there are marks of piety on your person.","alignment":{"type":"grouped","confidence":0.576,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4017020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f2ad783baa7c211e1e7771b51d96cb07ea4c51aa10c9a85d88c97dd1bd15202d","compact":"f8db5897466bdb7bc2da3e83115793b046e6823928104f2a398fa91cbda35bbc","nasal":"f8db5897466bdb7bc2da3e83115793b046e6823928104f2a398fa91cbda35bbc"}},{"id":"VRCE-4-17-21","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":21,"english":"I have not done you any wrong either in your kingdom or in your city. Nor have I passed by you. Why have you then destroyed me, who am a monkey ranging always in the woods, living on fruits and roots and who have come here to fight with another person? It appears that you are of a kingly father and of a graceful countenance. And, O king, there are marks of piety on your person.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4017021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5572ba5a4675c3f732f66957966246ac18edec43163a76c7f2d32bd2fda75556","compact":"3094820e2363cc6f65b6ee59a0c264fa3a8dc8f66820106324eb5e64ef0eb54b","nasal":"ab9445c2f8629fa9a2466bae9afa7c0990132892762981d7d4a8d6155d0371ff"}},{"id":"VRCE-4-17-22","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":22,"english":"I have not done you any wrong either in your kingdom or in your city. Nor have I passed by you. Why have you then destroyed me, who am a monkey ranging always in the woods, living on fruits and roots and who have come here to fight with another person? It appears that you are of a kingly father and of a graceful countenance. And, O king, there are marks of piety on your person.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4017022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b96fc17abe9884264d561cb9c9409cd6178d052ceb93c9499853d5a711d3ce39","compact":"e77d78aca77f51c790477a6e958d61c7282f3e60267d3865d0feefc23781d5df","nasal":"51b5b85ec2337a3fd9a5614b28fe5e8490a0eaa1f6c18f5b05595cda9dad455c"}},{"id":"VRCE-4-17-23","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":23,"english":"Who, born in the race of Kșatriyas, versed in religious lore, having his doubts removed and marks of piety on his person, perpetrates such an iniquitous deed?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4017023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f16d62035313dc265107c0e4f29dbf1e3cbdaa3ce1bc430282eb554d08c792b3","compact":"45e6eb304436e3d6264b6d1b5d8e38d77a12bca507414b51d4dbf85f222de20c","nasal":"6c0ba523c6abaa26cf63882ad6d4bef6fc5cb5032a3ff97c62d9f00f77ae1d25"}},{"id":"VRCE-4-17-24","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":24,"english":"You are born in the family of Raghus and known all over the world as being pious. Being clothed in righteousness why did you commit such an unrighteous act?","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4017024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b462d9fe5346a728d849525b48f283bc43bc0b15466df98faa867f93f273be0f","compact":"c788b0ee3e6588d95dd3e79b2feb15d25eee0403951f38c50cc474f0ce93a109","nasal":"c788b0ee3e6588d95dd3e79b2feb15d25eee0403951f38c50cc474f0ce93a109"}},{"id":"VRCE-4-17-25","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":25,"english":"Chastisement, charity, forgiveness, piety, truthfulness firmness, prowess and the punishment of the iniquitous are the virtues of a king, O prince.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4017025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0f9add120ca1c912d94a54157080ed0bef09ef7a6075e1086b1ffb22616e38db","compact":"48d53292f4d5e2da8c996af0ef4dcbb32d708eb1448ab08c747fba6296316999","nasal":"36cfa6e9e62d010fb0251c5e0af9e702b679af51eb7aa58158bee092cb46850e"}},{"id":"VRCE-4-17-26","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":26,"english":"We are, O Rama, wild beasts ranging in the forest and living on roots and fruits-our nature is such—but you are a man, O king.","alignment":{"type":"1:1","confidence":0.815,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4017026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42b274f5f3d53de2d003ac7ab23a052e26c1be00fd18d0f79e9d19f436ebd8ed","compact":"5473067d710c7d682249da784ce4d408d7a8670b9d92d41bf86f3dffd943f7b7","nasal":"5473067d710c7d682249da784ce4d408d7a8670b9d92d41bf86f3dffd943f7b7"}},{"id":"VRCE-4-17-27","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":27,"english":"Land, gold and silver are the causes of dissension. But who is there who is avaricious enough to get by our forest habitations and fruits?","alignment":{"type":"1:1","confidence":0.845,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4017027","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d69d86c5fa17347d3bdaf6baac2b135dbd962db4a0325ccde0221989a2b02ae9","compact":"197bb63b0b7458d7172bc506c03320bc71fa6c902690db68ee31bade92910f6d","nasal":"197bb63b0b7458d7172bc506c03320bc71fa6c902690db68ee31bade92910f6d"}},{"id":"VRCE-4-17-28","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":28,"english":"The royal virtue consists in humbly and freely administering discipline, favour and punishment. Kings by no means, should follow their whims.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-24"],"status":"unreviewed"},"source":{"sanskritLocator":"4017028","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8664d746bed0c7d2e86e307c8e292fd9f154442f76a30446105580426c22642a","compact":"9e7c423dee2ea459bbfcbe8789b5d01b2266591d88a374d677e1d3fa676e8c6e","nasal":"9e7c423dee2ea459bbfcbe8789b5d01b2266591d88a374d677e1d3fa676e8c6e"}},{"id":"VRCE-4-17-29","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":29,"english":"But you are angry and unsteady by nature, capricious, perfectly narrow-minded in the discharge of your royal duties and did use your bow and shaft: (any where and every time).","alignment":{"type":"1:1","confidence":0.81,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-25"],"status":"unreviewed"},"source":{"sanskritLocator":"4017029","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"69fb3333a78be660786c3b10428361f8e97df7e15317721b4ffe0dab6a5ef9b2","compact":"bcac6a068735eb37649e706745f5bee9ac1cacdb5f72df9cf31655d019f8adcc","nasal":"bcac6a068735eb37649e706745f5bee9ac1cacdb5f72df9cf31655d019f8adcc"}},{"id":"VRCE-4-17-30","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":30,"english":"You have no attachment for virtue, no comprehension of right things and are always guided by your passions albeit you are a lord of men.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-26"],"status":"unreviewed"},"source":{"sanskritLocator":"4017030","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f08f0e38ba28fe6765863f52120d3772f85ed4af7c6069cc1dd10f5e26d9e63d","compact":"3034d602321f0fb3eee25a88cdaccec75512b75e42f4ae63ceb865c4a3020048","nasal":"190d3aed86f1b6b0fe05bde7f3fc96412ce090be0ccaa9286e5552b2fcdfeaa7"}},{"id":"VRCE-4-17-31","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":31,"english":"O Kākutstha, destroying me sinless, with your shaft and perpetrating such a disgraceful act, how shall you relate it to the pious.","alignment":{"type":"grouped","confidence":0.882,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-27"],"status":"unreviewed"},"source":{"sanskritLocator":"4017031","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3c9b6ea537eb223b4877a37334a962dfe90bc7e36f9b413b17102572cb75b44d","compact":"9c839758b3cdd9f0ac963bda458bef77206bbfc51d59bade4cab4b949ad48a9e","nasal":"9c839758b3cdd9f0ac963bda458bef77206bbfc51d59bade4cab4b949ad48a9e"}},{"id":"VRCE-4-17-32","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":32,"english":"Those, who commit treason, destroy Brahmins and kine, who are thieves and always engaged in the destruction of animals, and who are atheists and marry before their elder brothers are married, do all go to hell.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-28"],"status":"unreviewed"},"source":{"sanskritLocator":"4017032","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"35446a0e0f0fb0deb6d3921ef7abaf524cfccf2e78bd54a33d96a2034933f552","compact":"f7027530bec16a9aecb203fd8766a21cb5b62bc98405647657d2876516cc7c02","nasal":"f7027530bec16a9aecb203fd8766a21cb5b62bc98405647657d2876516cc7c02"}},{"id":"VRCE-4-17-33","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":33,"english":"And there is not the least doubt about it. My skin is not worthy of your touch and my bones and hairs should always be avoided by the virtuous. And my flesh is not worthy of being eaten by persons of your piety.","alignment":{"type":"1:1","confidence":0.887,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-30"],"status":"unreviewed"},"source":{"sanskritLocator":"4017033","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7b933a9afd5048b0b4d498cccc8ad0b0c7e663ef815783e14601bad26d1922b2","compact":"353f92867ad9be57aa6945c3c8631f1ca085537e68a543b6e981cb94a9004cd8","nasal":"353f92867ad9be57aa6945c3c8631f1ca085537e68a543b6e981cb94a9004cd8"}},{"id":"VRCE-4-17-34","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":34,"english":"A hedge-hog a porcupine, an iguana, a hare and a tortoise these five animals only, having five toes, are worthy of being eaten by the Ks atryas and Brahmins, O Rāghava.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-31"],"status":"unreviewed"},"source":{"sanskritLocator":"4017034","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7bb9916f0dd11a55ebb0d6e4ab318cc5ebabce7ffcbac28050ecef69b04e4e80","compact":"66c36ad0df657e26d08c1f8390f195e9224e70df4dfeba0e0943fddf86f0bc4b","nasal":"c835150cac5d6925529383ca185cffa727611bba001fef3329062c553c46a3fd"}},{"id":"VRCE-4-17-35","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":35,"english":"The wise, O Rāma, do not touch my skin and bones and my flesh is not worthy of being taken-I am that (monkey) having five toes who have been killed by you.","alignment":{"type":"1:1","confidence":0.733,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-32"],"status":"unreviewed"},"source":{"sanskritLocator":"4017035","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0d63d24bf8cd30a3b6e3c6ef303f3d6555f378f66a09b2451d41b6b75897de6","compact":"e256afacfe2ce2e36e9a05cf6572a3efd194e7a41d053db7602518d98b8e65e3","nasal":"ef438c6f7bc7b595827ce6d04d7e6751fa4b548124c79357ec0c109b9c5506c5"}},{"id":"VRCE-4-17-36","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":36,"english":"O Kākutstha, the Earth has got you as her husband like to a good natured damsel being wedded to a husband who has forsaken his own religion.","alignment":{"type":"1:1","confidence":0.625,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-34"],"status":"unreviewed"},"source":{"sanskritLocator":"4017036","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"18faa94d874e15056b69eab57eaf3729c7dc79212aadabcea85d28c7772d6864","compact":"8df475ea7faa5a89228044779660b6eac5e756c8fd3a1430284a257f61b7389d","nasal":"28b8666b93e4da0a8e1922f16dbd5f912902be2b5c8a4c56dc8115effe8addfe"}},{"id":"VRCE-4-17-37","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":37,"english":"How are you, who are wicked, narrowminded, a liar and ever intent upon bringing about others' misfortune, born of the loins of the high-souled Dasaratha?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-35"],"status":"unreviewed"},"source":{"sanskritLocator":"4017037","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62eb17a5ee8cf580ca4eb447e1b0209e05b26da20a0a82f0d4721ccb4767beb1","compact":"da47a85fdeb28a0aa3eadbba241b0f2b3018f0b9db6c2207a0f2a4c4249c4222","nasal":"da47a85fdeb28a0aa3eadbba241b0f2b3018f0b9db6c2207a0f2a4c4249c4222"}},{"id":"VRCE-4-17-38","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":38,"english":"I have been killed by an elephant-Rāma, disregarding the virtue of the pious, breaking the chord of character, and neglecting the goad of religion.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-36"],"status":"unreviewed"},"source":{"sanskritLocator":"4017038","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"761fe545b71f3edaf203eb51cc217c398026b93749306afcf45ebcceec0de6c1","compact":"3ac7d5e79801e751285af494db774c595f6fae452b1260ff5f2c739ec16c8b70","nasal":"9edd41fd39bf765a021bc9fab97c80106954702d604ff6cdf19ab3aa99b4e41f"}},{"id":"VRCE-4-17-39","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":39,"english":"O son of a king, hadst you fought with me openly you wouldst have, forsooth, seen the abode of Death being killed by me.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-39"],"status":"unreviewed"},"source":{"sanskritLocator":"4017039","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3919c6c13d72266b5398bf8ace868cddd00202bd258638d2ce1b25721634fb08","compact":"ebf36966561775fd7e77ae52bcdb497ec66f6acd663e8964bb12c377b457a68b","nasal":"ebf36966561775fd7e77ae52bcdb497ec66f6acd663e8964bb12c377b457a68b"}},{"id":"VRCE-4-17-40","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":40,"english":"O Rāma, like to a serpent destroying persons asleep, you, that are under the control of vice, have killed me, who am hard to repress, keeping yourself out of my sight in the battle.","alignment":{"type":"1:1","confidence":0.87,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-40"],"status":"unreviewed"},"source":{"sanskritLocator":"4017040","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"10ccee66816bf55227928888a128c8493cf1ac9cacb637d25f41889c123d9248","compact":"8287ca616dde4fdd461d38cf11b95344632ebcb970d8e9928c4020a96c3e560c","nasal":"a5881947d234a235fc5aac3a282d6e36d2dabeb19abedfcd01cb8f84ca85e2a3"}},{"id":"VRCE-4-17-41","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":41,"english":"I have been killed by you, desirous of encompassing Sugrīva's well being. Hadst you apprized me of your object before, I would have got you your Maithili in the course of a day, and brought, by the neck, that vicious-souled Raks asa-Rāvaņa, the ravisher of your spouse with out putting an end to his life in the battle.","alignment":{"type":"1:1","confidence":0.885,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-41"],"status":"unreviewed"},"source":{"sanskritLocator":"4017041","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0004f695f0faecbd1882b95445f977bfe8dc45da436e66097a4224289af775bc","compact":"2e785a0f5bfa1ffe0ff0c91ce75e6a085d6f8622027af73dcb0bb9477183f0f8","nasal":"c36fdf4c6978ce1ffbf1505329857ab54204b5a5a46804fb44619a9e2cd1927c"}},{"id":"VRCE-4-17-42","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":42,"english":"Whether in the deep ocean or in the region under the earth, I shall bring your Maithili like to an Asyatar* Here is an allusion. A prince of Daityas, named Hayagriva, stole the Vedas at the end of Kalpa; in the recovery of them he was slain by Vişnu after his descent as Matshya.","alignment":{"type":"1:1","confidence":0.574,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-42"],"status":"unreviewed"},"source":{"sanskritLocator":"4017042","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1b8c51ce1a1c59e02faafc5afe4fc56baef0dce019f6856215ee5120f0931cba","compact":"ef1c3714a39a1d18e795de65ec7291039bb90f4e23b6d0d9f51e3554bf14a6bf","nasal":"ef1c3714a39a1d18e795de65ec7291039bb90f4e23b6d0d9f51e3554bf14a6bf"}},{"id":"VRCE-4-17-43","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":43,"english":"It is perfectly proper that Sugrīva shall inherit my kingdom on my ascension to heaven. And it is equally improper that I have been viciously killed by you in the battle.","alignment":{"type":"1:1","confidence":0.897,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-43"],"status":"unreviewed"},"source":{"sanskritLocator":"4017043","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1979da94ec9f56e35386600857645f3de666452a89fe91ac8db9a9a1106be40d","compact":"25f6cace5a8cb67efe3a73d914729b337401a6fcb7b86faf09edbfe954380950","nasal":"25f6cace5a8cb67efe3a73d914729b337401a6fcb7b86faf09edbfe954380950"}},{"id":"VRCE-4-17-44","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":44,"english":"Every one in time meets with death and hence there is nothing to be sorry for me. But do you think of a proper reply you shall give to the people (when asked about the cause of my destruction).","alignment":{"type":"1:1","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-44"],"status":"unreviewed"},"source":{"sanskritLocator":"4017044","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ce382d2c733bc2229518c6ca21b955a81329d002453921201b671fcfe2ee1050","compact":"a96aa583de3cd80f9c02d82e42e625077b8fd2ae3b313ff88fd0162bb36ae352","nasal":"ad286ef8754971886d4a956bc6d07a90f388f06fd22b432067fdfc7d4875b532"}},{"id":"VRCE-4-17-45","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":45,"english":"Having said this, that high-souled Son of monkey-chief, greatly distressed being wounded by (Rāma's) shaft and having his countenance dried up, became silent, fixing his look upon Rāma, resembling the sun.","alignment":{"type":"1:1","confidence":0.88,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-45"],"status":"unreviewed"},"source":{"sanskritLocator":"4017045","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1ce857c7d6f4b8e8b26c8e392e7ea96765255054fcd817533a1ccb16fc77897c","compact":"82535036c530cabce33dbe6179b4fde105e388d6089d89db0746682088d817f2","nasal":"82535036c530cabce33dbe6179b4fde105e388d6089d89db0746682088d817f2"}}]
