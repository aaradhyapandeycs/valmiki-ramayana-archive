978493ff774d54d748c6750e01a848c95a","compact":"c6dd7c42b43bdd86d95a83847fc568406c4c4f9acc566c7584fbf62ae9f7bb79","nasal":"f8d4413e69a113f6edbf219c2e8bd33fb40a559b01bd3e3e3961594054f53d42"}},{"id":"VRCE-4-17-7","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":7,"english":"Though felled to the ground, his beauty appeared as if divided into three, namely, his garland, his body and the shaft piercing his heart.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4017007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a33f621f14887b5ab6db95732c573db3975d3bd7408434454a25818933cabac2","compact":"fe975d7f9f2a98fa1f1f9260157d408309dca2288d4abed3147fa69300be89fe","nasal":"fe975d7f9f2a98fa1f1f9260157d408309dca2288d4abed3147fa69300be89fe"}},{"id":"VRCE-4-17-8","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":8,"english":"The arrow thrown off Răma's bow pointing out to him the way to the celestial region, became an excellent means to that hero.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4017008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7cd2e0f57ba8bf996c41c965cf2a901129895c6b572c843e5579c577704e42bb","compact":"19d8df59da2f73377d2fe8b46efc110a240e9259c8920c72b116437ecc185b86","nasal":"19d8df59da2f73377d2fe8b46efc110a240e9259c8920c72b116437ecc185b86"}},{"id":"VRCE-4-17-9","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":9,"english":"Beholding the broad-chested and mightyarmed Vali, Mahendra's son, wearing a golden garland and having a flaming countenance and yellow eyes, thus struck down to the earth, resembling a flameless fire in the field of battle, like to Yayāti, slipped from the abode of the celestials on the wane of his piety, like to a tree falling down to the earth at the time of Dissolution, hard to repress as Mahendra himself, incapable to withstand like Upendra, Rāma, followed by Lakşmaņa, approached and beheld him. And paying respects to that hero falling on the earth like to a flameless fire and eyeing him again and again those two highly powerful brothers, Rāma and Laksmana neared him.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4017009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"10a02b054ea9e194144d22f0d1059a5b85a86142cb57f56926e5958f6bb0f9ee","compact":"93ff010f6d3e4cdac04cf9931647dc123ef1a79980661dde2bbfcbd6c05b4f3e","nasal":"bb4e0e196c866445b9a34cd15dce53a894a5292e654e2079f50d4335c74c965b"}},{"id":"VRCE-4-17-10","kanda":4,"kandaId":"kishkindha","sarga":17,"verse":10,"english":"Beholding the broad-chested and mightyarmed Vali, Mahendra's son, wearing a golden garland and having a flaming countenance and yellow eyes, thus struck down to the earth, resembling a flameless fire in the field of battle, like to Yayāti, slipped from the abode of the celestials on the wane of his piety, like to a tree falling down to the earth at the time of Dissolution, hard to repress as Mahendra himself, incapable to withstand like Upendra, Rāma, followed by Lakşmaņa, approached and beheld him. And paying respects to that hero falling on the earth like to a flameless fire and eyeing him again and again those two highly powerful brothers, Rāma and Laksmana neared him.","alignment":{"type":"grouped","confidence":0.891,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-17-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4017010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6effd8c83f863091c09744b3b8cc81a70d7a019544690509d709cd2c892a7b3e","compact":"604499157bd0f6bf08f107d093480c16445