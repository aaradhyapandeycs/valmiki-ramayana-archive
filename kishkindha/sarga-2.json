ba41766ecc20d38","compact":"7adb853e350f9da29e618921b03f99358c036b75d1dbbfed45a4ce2c30bc2a88","nasal":"bc8545784d017a47663b13d00d3b79870d603fd5fa06431f2b25c4e0ef83d422"}},{"id":"VRCE-4-2-7","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":7,"english":"Beholding these two mighty archers the counsellors of Sugriva, quitting that mountainous expanse proceeded to another best of hills.","alignment":{"type":"1:1","confidence":0.754,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4002007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b7cf8916a73b20c62175f6cb487d6830fbc3f44cda9e6f66a471427673128b0a","compact":"e850368b3cacd0c97f777797adc0494420632a616347d2bc45b892786efe38d7","nasal":"e850368b3cacd0c97f777797adc0494420632a616347d2bc45b892786efe38d7"}},{"id":"VRCE-4-2-8","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":8,"english":"Thereupon proceeding quickly the commanders of various monkey herds stood encircling the king of monkeys and the chief of · leaders.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4002008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0c3333029a33b9ef1eb27669df228b7db9bc0fcf01e51bed9ee2ba975f94bb96","compact":"b302488ea6eefcfad60df5ee85c1ed835a9bb215017190b4bfa75526c846d0de","nasal":"b302488ea6eefcfad60df5ee85c1ed835a9bb215017190b4bfa75526c846d0de"}},{"id":"VRCE-4-2-9","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":9,"english":"The monkeys thus sharing in the misery and happiness (of their chief) proceeded jumping from hill to hill shaking the summits thereof, with the velocity (of their persons). Thereupon those mighty monkeys, jumping, broke down the flowery trees of that stronghold.","alignment":{"type":"grouped","confidence":0.825,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4002009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a7da7196e5ce41d08ee7b798fb1f7958c198fc8c92aa4db527dca268ee909df7","compact":"3fda11e93867285c7d948515202e5c88cee71812161408f89ce62452458eb3f8","nasal":"59523967e071c5e63032bc735946091eae5b2e52fcd8e0c0ddc381d8e44bde8b"}},{"id":"VRCE-4-2-10","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":10,"english":"The monkeys thus sharing in the misery and happiness (of their chief) proceeded jumping from hill to hill shaking the summits thereof, with the velocity (of their persons). Thereupon those mighty monkeys, jumping, broke down the flowery trees of that stronghold.","alignment":{"type":"grouped","confidence":0.884,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4002010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"62cf9dd5bea12e8429232e7567bba8c20779467e7e3ad3da837d93588c345ce0","compact":"860a54dc66ffa767ff9e089f68831cc66e356d8fbaaa9972b04ba50232f6fbac","nasal":"26759346ba7bbead4b51d3246c712e91e7c1225a121a7849fc1d65d61d9d8983"}},{"id":"VRCE-4-2-11","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":11,"english":"Those best of monkeys, springing all around that mighty hill, proceeded terrifying the deer, the wild cats and the tigers.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4002011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e2d234f6958a9e1e9c83db3d69c352367195c8f28827e6508c109d4533416b30","compact":"a1f1394a2be6ebc6dd1cf88652dd989f57d84f56cf6c0c9ca3275a2b35f6c876","nasal":"66c4f1cc134f1b9ffa8074fa47d5a04e902e7e85bdc0f995ac7e5937014e2ad2"}},{"id":"VRCE-4-2-12","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":12,"english":"Stationed on that best of mountains the ministers of Sugrīva, coming in the front of that monkey-chief, stood with clasped palms.","alignment":{"type":"1:1","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4002012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cb72e62886b57706c151b26e2fde89294ed1e38540e558a42ab1547317e00ed9","compact":"d4427b04107392a232f5242015e6dc2e100cefee6eca1ebc72f6d922307ea634","nasal":"1ea994d30f755536e4fa41eab650cc6a4361f14abfa7a8bd962d3eb744f49be4"}},{"id":"VRCE-4-2-13","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":13,"english":"Thereupon Hanumān, skilled in speech, spoke to Sugrīva, terrified and afraid of Vāli's wicked wiles.","alignment":{"type":"1:1","confidence":0.785,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4002013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"762bd172d7f1aa50d664b7d619cfd3d15d9940474e33ceff91305f3ca7e29017","compact":"11c2350e4fcaafb15a94384b3824406e5020c29f977af33a34cceac42bfb202e","nasal":"b5a3bc1b12551c038427592a11a70eda8f8e789c649d62f67f6e45e6552f3552"}},{"id":"VRCE-4-2-14","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":14,"english":"I do not behold, O best of monkeys, that wicked Vāli of terrible looks, afraid of whom you had fled away and for whom you are anxious.","alignment":{"type":"1:1","confidence":0.743,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4002014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"513bb9cd131ce63b658c5de9fe334d49c78241e6956f2d9259c3db80b6a36969","compact":"e1c41c7fbd4fa22c55c1960735f1fbc56ea540c75d38a45f2a63d16ac7ef51d2","nasal":"e1c41c7fbd4fa22c55c1960735f1fbc56ea540c75d38a45f2a63d16ac7ef51d2"}},{"id":"VRCE-4-2-15","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":15,"english":"I do not observe here, O gentle one, the wicked-souled Väli your elder brother of impious actions and whom you do fear and I do not perceive any terror proceeding from him.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4002015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"23b51df9bfcb21edca1ff4357e422f519135f06b61625e31f2c27df5e6995ba7","compact":"20c187807b13c917508cb3376934ea495ea178e24dd11182221b3a6ef991f86f","nasal":"20c187807b13c917508cb3376934ea495ea178e24dd11182221b3a6ef991f86f"}},{"id":"VRCE-4-2-16","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":16,"english":"O monkey-chief, truly manifest is your monkey-hood and it is through your lightheartedness that you are incapable of fixing your soul.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4002016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5c9ca35df2da1f738bd8a7231b5c686476d32ceafd4728da491a6fc5b33c4644","compact":"27e7d8d59248c4ba07e7c8c03b20a98c6d75f4344be3ee554bd63039f36d7f34","nasal":"27e7d8d59248c4ba07e7c8c03b20a98c6d75f4344be3ee554bd63039f36d7f34"}},{"id":"VRCE-4-2-17","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":17,"english":"Gifted with intellect and knowledge do you perforin all by means of gestures. A king void of sense cannot govern all creatures.","alignment":{"type":"1:1","confidence":0.875,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4002017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"815220400525ff7047b5f64590124e9cfd855d1cb0df23cb173c41d721f1d5f1","compact":"fec8451c1036be502b2ebd50abe19774f6d483a1f9207a3bd71b9654a420b90d","nasal":"00ebd5fa6e5305578a3f676d7a6e8a083aaea4265236310e8dd649f5a4150219"}},{"id":"VRCE-4-2-18","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":18,"english":"Hearing those pregnant words of Hanumār in its entirety, Sugrīva addressed to Hanumān in better accents.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4002018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5e51e95852b7cd1013830e0ea1658da53c99450ae2f874b1741b804cccb02863","compact":"39dc4837479fb77f0047b1e8fcdd5ae4d3c328c471d2ddbfe2fbf542ec8c5123","nasal":"55c8bc0f208ea9fb28cde088805e830ca5a06815b7c784a39d25a45577fa2d24"}},{"id":"VRCE-4-2-19","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":19,"english":"Who is not terrified beholding those two mighty armed heroes, having expansive eyes, with bows, arrow, and daggers in their hands like to two sons of a celestial?","alignment":{"type":"1:1","confidence":0.623,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4002019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"68f9fa740ba1d58a6711c0a024764b569b17ea0117d6522182867b6fea16d562","compact":"6fa932f0a6719e087eeacd5123d6238e81445a99b4995bd85ad7ce41ce989c6e","nasal":"6fa932f0a6719e087eeacd5123d6238e81445a99b4995bd85ad7ce41ce989c6e"}},{"id":"VRCE-4-2-20","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":20,"english":"Methinks these two best of men have been despatched by Vali. Kings have many friends. And it is not proper for me to place confidence in them.","alignment":{"type":"1:1","confidence":0.864,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4002020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"02828b20ca0269e5842bfdcc528d33b582d37d2184cb045db27d3907d8e666db","compact":"32f992121367a0d555f3796721442f8ad5a0e130c04611ecf7fde0d90e2b411b","nasal":"02eaec72a95dffceb140ba2c3ae587fd17c34aaeee95bad1a87a35644f694de8"}},{"id":"VRCE-4-2-21","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":21,"english":"People should know that enemies, always treacherous by nature, range under false guises. And those foes, availing of their credulity, bring about their destruction whenever opportunity presents itself.","alignment":{"type":"1:1","confidence":0.812,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4002021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dfc89c3053d384859e405bf7b317066134dec6eb428ec4253227cba4187e568d","compact":"8e06c9e24bbbc78db02ba446175b6757e256f8d392018eb1f04e1fcae9267ad3","nasal":"c025dd9969eea7e91bd8841249a940b06697a8fbdee8dfbd5ddee44ed32b904b"}},{"id":"VRCE-4-2-22","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":22,"english":"Vāli is eminently expert in despatching business. Monarchs, cognizant of many a wily expedient, bring about others' destruction. It is proper to discern them by means of disguised spies.","alignment":{"type":"1:1","confidence":0.773,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4002022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"034c562a2d708d32ea0b5b278ec8ac7c398b250e1f68af57ca0aad8ed6651da5","compact":"da84ff52f295ce9bca43eebfa6eb51d3b90682fe282b7dc98e1677a082c4003b","nasal":"307ff501f82133f0f50ea50f78a9ddd19e086f9862068e0d8f41a353c7c5f318"}},{"id":"VRCE-4-2-23","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":23,"english":"O monkey, do you proceed under a false guise and come by their intentions, examining them aright by their countenances, gestures and words.","alignment":{"type":"1:1","confidence":0.651,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4002023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77ca6806ffa3e5e9109dd14951ee8c2120114626ca146873ff4dcba589147054","compact":"1df156185d7948c5994b2fdd401821631c785d2e349a083649c0157478ae7c1a","nasal":"71ad0992e95eb199fba36b1e29d055097ab79f7043cbe912590d5ee42907eccc"}},{"id":"VRCE-4-2-24","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":24,"english":"Do you ascertain their intention. If do you find them delighted, secure their confidence in my favour by eulogising me again and again and giving out to them my views.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-24"],"status":"unreviewed"},"source":{"sanskritLocator":"4002024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"735245b97e788904153616f9fa1dc685871ebd0e82daf63e815ce23d3bfa8d08","compact":"b0b4e627c52c4ed0861f1a557c87944b3e71871dbc1c4b73141a4034bed90d15","nasal":"51d98730273a8962f07640df8573eb57f1c0d6282f0357aa94ad49cc5c5e1cdd"}},{"id":"VRCE-4-2-25","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":25,"english":"O best of monkeys, do you ask them why they have entered this forest, if you do perceive that these two archers are pure souled.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-25"],"status":"unreviewed"},"source":{"sanskritLocator":"4002025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5910ee43433aab340d7e48beee1172b66762d6b325c88ae7c564a4c6a78870f3","compact":"f217e96c2f9e8271fef5702be9dbff9de8b302d9c793ad68dac593ca069ba3ff","nasal":"f217e96c2f9e8271fef5702be9dbff9de8b302d9c793ad68dac593ca069ba3ff"}},{"id":"VRCE-4-2-26","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":26,"english":"O monkey, if you determine the fairness and unfairness of their purpose, their wickedness should be discovered by means of their gestures and conversation.","alignment":{"type":"1:1","confidence":0.889,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-26"],"status":"unreviewed"},"source":{"sanskritLocator":"4002026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f0a7e549e2b6d25165bdda25a9edd40cb161c638715a93ca4dd9850db3cdc1de","compact":"2e34bca1a8eabbc9dbd89bbb31660891001f78ba98d26a94b4218f06a82f9e91","nasal":"2e34bca1a8eabbc9dbd89bbb31660891001f78ba98d26a94b4218f06a82f9e91"}},{"id":"VRCE-4-2-27","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":27,"english":"Being commanded by that chief of monkeys, the son of Maruta purposed to approach Rāma and Laksmana.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-27"],"status":"unreviewed"},"source":{"sanskritLocator":"4002027","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"173be36ae3963e907e5779b36618e5048b06d99a6cfb6343329771cc17cc8e9f","compact":"dd5b1ce36e4c9c734c5cfe8fc96fec47cb01aa184b96f566896ce212e6da989f","nasal":"dd5b1ce36e4c9c734c5cfe8fc96fec47cb01aa184b96f566896ce212e6da989f"}},{"id":"VRCE-4-2-28","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":28,"english":"Assenting to the words of the terrified and unconquerable Sugriva and saying 'Be it so, Hanumān, the high-souled monkey proceeded where the heroic Râma was with Lakşmaņa.","alignment":{"type":"1:1","confidence":0.793,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-28"],"status":"unreviewed"},"source":{"sanskritLocator":"4002028","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4427dfdbd09e7b91da5bb5cdd6927d1b1cb35118608f6ff3840ed2f654380ec8","compact":"ad38dd843b5d9216625