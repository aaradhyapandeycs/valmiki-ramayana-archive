[{"id":"VRCE-4-2-1","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":1,"english":"Beholding those two high-souled brothers Rāma and Lakşmaņa, heroic and with great scimitars in their hands, Sugrīva became terrified.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4002001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"42a28cbb5a7f671f07286dd52aa22fbc48939abed39aa5fcd7d6801bc7bb60c4","compact":"33f3a41911709ce72214bd932331bc6c69e661776d5b7db7ebf1d215f9667a51","nasal":"90af45d30cbf728e300d8d38cd9122ec0a4aefed221189f0061d0732499392e7"}},{"id":"VRCE-4-2-2","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":2,"english":"That best of monkeys, of a disturbed mind, cast his looks around and could not stand (patiently) at any place.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4002002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d7be11a807ca970c79f02e96a451249408090315227e6d762a84aca3d22e9c5f","compact":"b42f4a9065b9e217fdec8d78e438668f7828d1e37cb4b7dab859241fec5c795d","nasal":"4fd2acb20d83d72773785d64ef0acb6c63486b287a885e0e504e1aec139e0ff5"}},{"id":"VRCE-4-2-3","kanda":4,"kandaId":"kishkindha","sarga":2,"verse":3,"english":"Beholding those two of great prowess he could not make up his mind to remain there and the heart of that terrified monkey, sank.","alignment":{"type":"1:1","confidence":0.679,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-2-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4002003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"53a6ab61452d6edc6c9bd8f7941885e0f0b12e55ee498315786b8b11e580d9b5","compact":"ced702fc0afb59affa548f78c543319c9f7faca85e23360b110d2df4a8bed60b"