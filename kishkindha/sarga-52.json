[{"id":"VRCE-4-52-1","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":1,"english":"Thus accosted in excellent words fraught with asceticism and righteousness Hanumān spoke to that one of faultless eyes, saying.","alignment":{"type":"1:1","confidence":0.848,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4052001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"91f38fd24b30afa56556ad6e133979ebbd16988a72ad27745c616004f2e6af11","compact":"4c1dd9ad3bd97f9cceafe7c02073888c5b2292a403f3494485ec6b2bf3938aab","nasal":"b2d1258d5aaff9be0d80f4cf5f1d8d79e461c0f6af70cce506838bab60db92c9"}},{"id":"VRCE-4-52-2","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":2,"english":"We all take refuge in you, practising piety. the term that had been fixed by the high-souled Sugrīva in respect of us, shall all be spent in this cave. Therefore it behoveth you to deliver us from this place.","alignment":{"type":"1:1","confidence":0.832,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4052002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5428f24101fcde553dba50185fad383b7b6522f1db22aa21b4c29344d522e097","compact":"9052a85be7f04d5a23ddc2547db086d870dd2223cdfda5a9a84de2c9f3ebac93","nasal":"be5de3b3750bb59cc076e7edde3b5a2a5e326ab1175d62260834ef52186635c8"}},{"id":"VRCE-4-52-3","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":3,"english":"It behove you to save us, exercised with fear for Sugriva,-who, happening to override Sugriva's command, shall lose our lives. And, further, O you that practisest righteousness, great is the task that is to be performed by us.","alignment":{"type":"grouped","confidence":0.375,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4052003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6432f7ead94fb7966e0d82a861e06180d887ea5a6d5ab3d2ab316672352d2917","compact":"639090356fb0f1998307260f31b384739cc32818191a2d4f3d2e3fec888987d0","nasal":"639090356fb0f1998307260f31b384739cc32818191a2d4f3d2e3fec888987d0"}},{"id":"VRCE-4-52-4","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":4,"english":"It behove you to save us, exercised with fear for Sugriva,-who, happening to override Sugriva's command, shall lose our lives. And, further, O you that practisest righteousness, great is the task that is to be performed by us.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4052004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"28f5a72a5a6d08f6d197afcaf55be52d20070e24d4ce85306974fde1852874a6","compact":"1cf76dab42db686a4ff33a625de78d8e563cc9e9d47bb889b96a0f926349afe6","nasal":"02529b52073dbf05e4ec848d61a93229c73f9584a23b48b92540d85d50aad2e3"}},{"id":"VRCE-4-52-5","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":5,"english":"But if we stay here, that work of ours shall remain unaccomplished.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4052005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"349bb56b5775f3ac59dd672e09df70165f5552414043bce32d9ee8f99f81907d","compact":"c504b6e002e7cacfb913eb3d1573a55fb23c97ffe5f02f59a1e15e1e95666a52","nasal":"c504b6e002e7cacfb913eb3d1573a55fb23c97ffe5f02f59a1e15e1e95666a52"}},{"id":"VRCE-4-52-6","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":6,"english":"Thus addressed by Hanumān, the ascetic said, Once entering, hard it is for any one to return (hence) alive. But by the potency of my asceticism acquired through self-discipline, I shall deliver all the monkeys from this den.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4052006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9153d0620c3b6f670ba8ddd74c04168c2a168dfd5e9ed7b34beafd5d9aaa39e0","compact":"83dcd57066370909001bdf392b1764b476fb3027cc0fbaabc8f404a3548fab99","nasal":"83dcd57066370909001bdf392b1764b476fb3027cc0fbaabc8f404a3548fab99"}},{"id":"VRCE-4-52-7","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":7,"english":"Thus addressed by Hanumān, the ascetic said, Once entering, hard it is for any one to return (hence) alive. But by the potency of my asceticism acquired through self-discipline, I shall deliver all the monkeys from this den.","alignment":{"type":"grouped","confidence":0.567,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4052007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"33f9b6d53b0c48afadbdf6e8c54158076ad247d06d93c78826b2d1748f0f4ecc","compact":"3349c487e88b0989106a3ecb35e63520501f0997616d58394c2c456d63ac628b","nasal":"3349c487e88b0989106a3ecb35e63520501f0997616d58394c2c456d63ac628b"}},{"id":"VRCE-4-52-8","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":8,"english":"You foremost of monkeys, do you close your eyes. No one is able to issue out of this place without closing one's eyes.","alignment":{"type":"1:1","confidence":0.684,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4052008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e5722e34ad86caf610eb3418079a48c94a8a6e7923740fac9a58695c4cb6aab3","compact":"c34679cb27ba8d1f6188d56ff7331c690e51f13d9b8c9a508577ff4326cb5d23","nasal":"c34679cb27ba8d1f6188d56ff7331c690e51f13d9b8c9a508577ff4326cb5d23"}},{"id":"VRCE-4-52-9","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":9,"english":"Then they, eagerly desirous of going out, closed their sight* with their hands furnished with tender fingers. *The text has nimilitah—and thus they closed their eyes. This redundant epithet has been left out in the translation, as it would render the version extremely awkward.","alignment":{"type":"1:1","confidence":0.667,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4052009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ae15989f59e112660a7457ac934b854f3265b5e7104cc3937294e39f35102ba5","compact":"870a66bb87912444a2c031f453f9e54a690b0f90051e5374a04cbc97dfdb3e1a","nasal":"06c9771dd6d6feb6dca69f6cba6e4423be5ce0e4e81911182decaad75cb9e348"}},{"id":"VRCE-4-52-10","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":10,"english":"The magnanimous monkeys, with their faces covered with their palms, were in the twinkling of an eye, liberated from the den by her.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4052010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b1b64f2bc413ad2b1eb1cc256b5102778ae586a27b8cc723df4e64ab6dfe7b2e","compact":"38c3ae9453c23ac1ab1fd6ffdda68de4ba329c600db45726b5a664feb5ca68ef","nasal":"353c0e2e696a089ffa705482c493fb85b1bcec4960534852a0c184032ce2b810"}},{"id":"VRCE-4-52-11","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":11,"english":"And then the pious anchoret spoke to them there. And when they had come out of the fearful den, cheering them up, she said,","alignment":{"type":"1:1","confidence":0.73,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-24"],"status":"unreviewed"},"source":{"sanskritLocator":"4052011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8988992c1e4203488f58663f5c9e7db0747fbc306aa73a00716fb37d575c804c","compact":"ccf90a03ff627437f34ad7c058dc668f3e5913426820dff3746ff561bb3016e6","nasal":"ccf90a03ff627437f34ad7c058dc668f3e5913426820dff3746ff561bb3016e6"}},{"id":"VRCE-4-52-12","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":12,"english":"This is the fair Vindhya mountain filled with various trees and herbs. This is the Praśravaņa hill; and this is the great deep. Fair Fortune! I go to my abode, you foremost of monkeys. Having spokea thus, Svayamprabhā entered that captivating cave.","alignment":{"type":"grouped","confidence":0.729,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-25"],"status":"unreviewed"},"source":{"sanskritLocator":"4052012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"722c355c9bcb333370b77651512b2784c337cbceafcc7e60caa5a7f490bf71c0","compact":"29e64ea37b2e02fe8f2c1c07e85257341ed4d52871a626a1184c2b14e972bafd","nasal":"f4beff95d8d8c7af70b7429b3cc09a52c215e459ec483d54195f719717546b54"}},{"id":"VRCE-4-52-13","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":13,"english":"This is the fair Vindhya mountain filled with various trees and herbs. This is the Praśravaņa hill; and this is the great deep. Fair Fortune! I go to my abode, you foremost of monkeys. Having spokea thus, Svayamprabhā entered that captivating cave.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-52-25"],"status":"unreviewed"},"source":{"sanskritLocator":"4052013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"faa22597dad181d0f634bf0b96b6dc793f2bf1fdcde30117f4053d5a4c2cc5b4","compact":"ada9ac806af2c95c419d40dbc4cca3e15d74ccf3d37d6fdc7f90f169df364db3","nasal":"ada9ac806af2c95c419d40dbc4cca3e15d74ccf3d37d6fdc7f90f169df364db3"}},{"id":"VRCE-4-52-14","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":14,"english":"Then they saw the ocean—abode of Varuņashoreless, resounding, rife with dreadful billows.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4052014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e0dbcf94f322cf8d03d1b107844264c13ad54adbcad1e75bdc9e7ca74b5fb45","compact":"39ecac6a4c6ccd9854c999f57069d03dff4c9971c93c5652b44deeb082f90582","nasal":"a60c3e6e6597cde14de8ed81038c0fc73893fe1a9db48ad614f2b9ba771b0788"}},{"id":"VRCE-4-52-15","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":15,"english":"Exploring the mountain fateness of Maya*, they spent the month that had been set by the king. *Named Rhiksavila.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4052015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cfb8920f0491015909c9728af5dd55ef2dd6675044f285b07ea387fec4bd4f21","compact":"3f77f7f6a732f41eed16b8e3427ec4effe48263a69ec7d43f40d936b5eccf0bf","nasal":"47a93c0a5778adc8e62a899fa3250fe56620f8b1c23b8d7dd353b308f2572b9c"}},{"id":"VRCE-4-52-16","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":16,"english":"Then sitting down at the foot of the Vindhya mountain, containing blossoming trees, at that time* those high-souled ones indulged-in reflections. *i.e. at the beginning of winter.","alignment":{"type":"1:1","confidence":0.656,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4052016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e7695aa7c7b1b6ab09b25b2fc69082f604c989e87644c7fe502749db28a726e","compact":"c1eaef731b18fa80c37f024390c5b3b4a87a918d499e2291303178cbf11476f1","nasal":"8daab71c64ffe5237b597f3e9f3f383d3b50215448eb73fa702bfd4e12764fee"}},{"id":"VRCE-4-52-17","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":17,"english":"Beholding vernal trees bending beneath the load of flowers, and environed by hundreds of plants, they were inspired with apprehension.","alignment":{"type":"1:1","confidence":0.753,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4052017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"961505d94bac3ccb56b3e00b7a0bad90b85c98d1d44d24cda6219702541815f8","compact":"c8c39fdbb3e26f920be6eb4effc6956c26b7fcdc7e2f6cbf8b00cabd6925c759","nasal":"0bc097a4274ca857b2a548e0e2c00fb158c165f574136a1271fbf2bcd316d68c"}},{"id":"VRCE-4-52-18","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":18,"english":"And each knowing that spring had appeared, they, the term appointed for their task having run out, dropped down on the ground.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4052018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"19a1b5bf408e25cf3fb0a8a6ac031ff94774da11f13873d21f808d41e45498ec","compact":"45a3481d30e39770e9ea33232ce23d5b9dcf046517221c6697d231b45fde3ec9","nasal":"97cbeb6775eee9d6a63ee3f5de15df65f39b34f5b5ced6344d29c17c8da5a3a8"}},{"id":"VRCE-4-52-19","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":19,"english":"Thereat, with bland words properly honouring the aged apes and the rest dwelling in the woods, that monkey having the shoulders of a lion or a bull, and plump and broad arms-the youthful prince Angada, endowed with high wisdom, spoke,","alignment":{"type":"1:1","confidence":0.82,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4052019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"29a9b36f257bfbf2f1e37002e93f8397c078e54dd7d7709bf75965a9fc4e1db4","compact":"d1d28c1e6bf36d11d7810ce3b9f7959e694b715620f75db85671672ca3957b6d","nasal":"ea9afac41e29cdf1b644da6544dfaa3f65b9fa95b9c78b1f3c5d09563e2dc782"}},{"id":"VRCE-4-52-20","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":20,"english":"We have come out at the mandate of the monarch of monkeys. While we sojourned in the cave, a full month had passed away, you monkeys. Why do you not understand this? We set out, engaging that our term of search should reach no further than the end of Kärtika;* but that has expired. Now, what next is to be done? *October.","alignment":{"type":"1:1","confidence":0.984,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4052020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"15566947b4b637de6cfab6446bd695cb6c8b109a94b976f46df2ca84caa22db4","compact":"c19f0aec7dffd1218d6daa9b17e171dbe4e19f401afee252860210a914063c59","nasal":"c19f0aec7dffd1218d6daa9b17e171dbe4e19f401afee252860210a914063c59"}},{"id":"VRCE-4-52-21","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":21,"english":"Having received the orders (of the king), you, conversant with polity, engaged in the welfare of your master, expert in every work, incomparable in execution, and renowned in every quarter, have come out, commanded by the lord of monkeys. Now, having failed to attain our object, we shall meet with death. There is no doubt whatever about this. Who, having been unsuccessful in doing the mandate of the king of monkeys, enjoyeth ease? Now all the rangers of the forest should fast for death.","alignment":{"type":"1:1","confidence":0.985,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4052021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7655056d4927267232539cd2728acd2b231470b62d2a311e704f327d45539d97","compact":"d8099b0293b44506645c33bb165e3c94b4fc3fdb8fead3582c0ab050ae0c4be1","nasal":"a296e4824774177698e0e57507e8ac9ceff365cd16de91e0d1d84c8bf1cba1e3"}},{"id":"VRCE-4-52-22","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":22,"english":"Naturally stern, Sugrīva, established as our master, shall not forgive us, when we repair there, after having transgressed thus.","alignment":{"type":"1:1","confidence":0.886,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4052022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"801867860f10fbc1d98c6188f531f3689fe0c184453037272166283ab439cfb3","compact":"4ac7a82e308a0fed63cc80ea65e71114f090285ea7c2f72f8c27ea602ab21720","nasal":"4ac7a82e308a0fed63cc80ea65e71114f090285ea7c2f72f8c27ea602ab21720"}},{"id":"VRCE-4-52-23","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":23,"english":"Sītā not having been found out, Sugrīva, for certain, shall commit this sin.* Therefore it is fit that, forsaking our sons, and wives, and wealth, and homes, we this very day sit down to starve ourselves to death. *i.e. slay us.","alignment":{"type":"grouped","confidence":0.623,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4052023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87dd77a30ac78540d30d93aece1e30ee0040af45607299827ef043f908a1307d","compact":"7ab864ce62172e82a019c0b404b60813a8ead212605224308c64b389f6f0851d","nasal":"7ab864ce62172e82a019c0b404b60813a8ead212605224308c64b389f6f0851d"}},{"id":"VRCE-4-52-24","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":24,"english":"Sītā not having been found out, Sugrīva, for certain, shall commit this sin.* Therefore it is fit that, forsaking our sons, and wives, and wealth, and homes, we this very day sit down to starve ourselves to death. *i.e. slay us. Death at this place is preferable to the unequal punishment (we must meet with at the hands of Sugriva).","alignment":{"type":"split","confidence":0.495,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-10","DUTT-4-53-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4052024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ff49f96c6a17abf6e317960c8758029a4a46e067dea68235634a92b502fb9824","compact":"f1ada9a37d67a10bf9e08858ee8dea297204a452355564be8d8642770a57825e","nasal":"9c80d342fa12079ebfd9794a50d280fa8c645b25cec444ba49f3828ee707e600"}},{"id":"VRCE-4-52-25","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":25,"english":"And, further, I have not been installed heirapparent by Sugrīva: I have been sprinkled by that foremost of kings, Rāma of untiring energy.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4052025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a6b86fe46b199cb4cb0bb1c3b89f2d10607501b3ab38266b9961b0fd8f78f027","compact":"c7e7f127c72716048c7ec93f1669a4ee6f4c10f2a5b962175b242f4fc15153cb","nasal":"2b45794c0f878b191162c6731264b5b25d41bee33a3b4ae38f8ce45fa54c0d5b"}},{"id":"VRCE-4-52-26","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":26,"english":"Entertaining enmity against me of old, the king, seeing this lapse, must be firmly determined to take my life by means of a severe sentence.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4052026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7bf68141b3b1bfb0f87fcc2c6af49de205b9cdc57008e0235c4421d3fab03d3c","compact":"415c73e317769f8b5b5369606ddf7b319bcbe08fec3367d16b22ed4abe5eee6c","nasal":"d819c60d637b71e2661b49f5bd3e3d4918ea7f0a3430f5f738dfc4746e7325aa"}},{"id":"VRCE-4-52-27","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":27,"english":"What is the use of suffering my friends to look on my disaster at the last moment of my existence? Therefore even on this sacred shore of the sea shall I sit down to starve myself.","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4052027","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c3dd5cc5e4a74c607bd74a7916fc895811f01a23b0e0e7fb66561bd8d7c1b682","compact":"e65a47b4a36fff670e01f38b34d663571643dc1ce7975125f62188255d87a717","nasal":"89d9ba955b5fa45225a475a4b81e731f9381cb6119e19f23efc03c5b95328986"}},{"id":"VRCE-4-52-28","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":28,"english":"Hearing the tender prince speak thus, all those principal monkeys pathetically observed,","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4052028","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e86f94d281f5f83b43a7b4eb84f4908eeb2765ceb566ab0104ec03db275097a3","compact":"f4ee7d8640671c9b245960c7240965c445fa326f8108bc018995a9999c026e2f","nasal":"f4ee7d8640671c9b245960c7240965c445fa326f8108bc018995a9999c026e2f"}},{"id":"VRCE-4-52-29","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":29,"english":"Sugrīva is harsh by nature, and Rāghava loveth his wife dearly. The time appointed having passed by, seeing us (come) without attaining success in the task, and seeing us arrive without obtaining a sight of Vaidehi, (Sugrīva) shall certainly slay us from the desire of doing what is agreeable to Rāghava.","alignment":{"type":"grouped","confidence":0.625,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4052029","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ce036a131dfba2fb99b8775fb904e2fbb8f110a44008d41a63935c7262e7d69c","compact":"9d5f2adb9d2ddf9d88020fa84fa5f1cd3c1a228d761e0903e320b1ae2ec73610","nasal":"9d5f2adb9d2ddf9d88020fa84fa5f1cd3c1a228d761e0903e320b1ae2ec73610"}},{"id":"VRCE-4-52-30","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":30,"english":"Sugrīva is harsh by nature, and Rāghava loveth his wife dearly. The time appointed having passed by, seeing us (come) without attaining success in the task, and seeing us arrive without obtaining a sight of Vaidehi, (Sugrīva) shall certainly slay us from the desire of doing what is agreeable to Rāghava. Those who have transgressed, cannot come to the side of their master. Having come hither as the principal servants of Sugrīva, we shall either see Sītā or obtain information concerning her, or else, O hero, we shall repair to the mansion of Yama.","alignment":{"type":"split","confidence":0.469,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-16","DUTT-4-53-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4052030","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a9bcaaffdcbab62117daad62b7c7235d63d7ede28b2ab6afd855ab3f7d65a475","compact":"2e528c70c70688040dddbe46aaa43414b8db06fef63c08cbdc29ba6e23eed4a0","nasal":"2e528c70c70688040dddbe46aaa43414b8db06fef63c08cbdc29ba6e23eed4a0"}},{"id":"VRCE-4-52-31","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":31,"english":"Hearing the speeches of the monkeys afflicted with fear, Tārā said,-No use of indulging in grief. If you relish it, let us all entering the cave, dwell there.","alignment":{"type":"1:1","confidence":0.939,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4052031","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0b8b20c15483efb10f1daf28f4cea3999aff57b052c820e22b6c3a8dd81532c7","compact":"eeaab772468b62931f13203514982abf9f0bfd9a71130cf197623db5114a910c","nasal":"eeaab772468b62931f13203514982abf9f0bfd9a71130cf197623db5114a910c"}},{"id":"VRCE-4-52-32","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":32,"english":"This place abounding in flowers and waters, meats and drinks,—which has been brought forth by the power of ilusion, is incapable of being approached. Here we have no fear from Purandara, or Rāghava, or the king of monkeys.","alignment":{"type":"1:1","confidence":0.512,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4052032","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"54fb0e8da12c13c9c143fd4cb671b710cdb0757bb8a6e634cedaf4c1b80de3b2","compact":"95f71f2175b5e65044e20c7d3dc3e4d3e3ba58683384e94c234733110e284658","nasal":"d5f971356931b703b61031a6464bf436a43b301f553fe1808b1858ca6967d2e9"}},{"id":"VRCE-4-52-33","kanda":4,"kandaId":"kishkindha","sarga":52,"verse":33,"english":"Hearing the welcome words of Angada, the monkeys,-being convinced, said,-Do you this very day so order that we may not be slain.","alignment":{"type":"1:1","confidence":0.28,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-53-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4052033","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0ac6e406bcc6f0729275e3dee0780df6fcb5c69707f637b66bbd173e04a6a014","compact":"67623ff639d6aba7e74f9479f38a5ff01225bc700697afb3062f0ec857d867a7","nasal":"f7a1827ae946818a5f5268e73ec604674d3551639c901397e708a57d55f6c01e"}}]
