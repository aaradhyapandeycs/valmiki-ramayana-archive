r":"4026022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"15ab18fa9c3a98dadba8629bfef3b36f6c205e996cfc3c9b5bfc787016cc068d","compact":"c15885b9c68b64706e0cb79172653856ceed2be8a9a7bae312b84266c03b07b1","nasal":"2e3014890e6ab3df20e1a57456e28315171a058144b20e81392a5d3d4bf8c9ec"}},{"id":"VRCE-4-26-23","kanda":4,"kandaId":"kishkindha","sarga":26,"verse":23,"english":"Subduing your wrath, and awaiting the autumn, do you with me spend these four months in this hill filled with deer, capable as you are of encompassing the destruction of your enemy.","alignment":{"type":"1:1","confidence":0.71,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-27-37"],"status":"unreviewed"},"source":{"sanskritLocator":"4026023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"09e488eedc2e7fee74c2fba92bd375e6d0566f88acd84771d3f10aa297586a36","compact":"96b7567c3522b0061d18d25014b5a025f4868ace779a2276ddfd9ceceb472703","nasal":"96b7567c3522b0061d18d25014b5a025f4868ace779a2276ddfd9ceceb472703"}}]
