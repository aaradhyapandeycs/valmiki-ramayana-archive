[{"id":"VRCE-4-63-1","kanda":4,"kandaId":"kishkindha","sarga":63,"verse":1,"english":"Having heard all this related to them by the vulture-king, the monkeys possessing the strength of lions, filled with delight, bounded and set up a roar.","alignment":{"type":"1:1","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-64-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4063001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9e03a25ca39fd653da5daffa9eebd9bce5d8df0404689843639c0badcf55d6d4","compact":"7e866c6909b876b8f883d4f2de68b61f8b1c10f4dc22ef6a14acac9218e486cb","nasal":"7e866c6909b876b8f883d4f2de68b61f8b1c10f4dc22ef6a14acac9218e486cb"}},{"id":"VRCE-4-63-2","kanda":4,"kandaId":"kishkindha","sarga":63,"verse":2,"english":"Hearing from Sampāti that Rāvana was to be slain, the monkeys growing glad, came to the ocean, with the desire of seeing Sītā.","alignment":{"type":"1:1","confidence":0.969,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-64-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4063002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9006fffc2a870bded422cefd75ae5e5eb6a24713e38e31f9ca60da7dcf203af8","compact":"c3a09efd25d8ab81714f5a4e2e6eb8c4c08bc6196d1105c81f1b946eacdb2509","nasal":"c1f6ef37e4f651c81edb51950dbfebb9dc1f717c2a7776120efce2e97bf4e625"}},{"id":"VRCE-4-63-3","kanda":4,"kandaId":"kishkindha","sarga":63,"verse":3,"english":"Coming to that country, these ones processing dreadful prowess, beheld (the sea) reflecting the image of this entire mighty world.","alignment":{"type":"1:1","confidence":0.652,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-64-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4063003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"17775471a4dc99e5d2fc38f682f9ed386e3c834e71d2aeadec6596ace9e963cc","compact":"06ec21dba77ae32