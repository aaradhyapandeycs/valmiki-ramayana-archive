[{"id":"VRCE-4-29-1","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":1,"english":"Sugrīva having entered his palace, and the sky being cleared of the clouds, Rāma, racked with grief, passing the rainy season and beholding the yellow welkin, the clear disc of the Moon, the autumnal right sprinkled with the rays of the Moon, the amour-stricken lord of monkeys, the ravishment of the daughter of Janaka, and the season well-nigh expired, became overwhelmed with sorrow and senseless.","alignment":{"type":"grouped","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4029001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"082bd33940dcfdc8fd8f473a525adfc32a4274655b7e3738f05f659341f99567","compact":"13e67c70d215621e65cb2976098467e582f0a60db9b9824f7815c12540167445","nasal":"13e67c70d215621e65cb2976098467e582f0a60db9b9824f7815c12540167445"}},{"id":"VRCE-4-29-2","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":2,"english":"Sugrīva having entered his palace, and the sky being cleared of the clouds, Rāma, racked with grief, passing the rainy season and beholding the yellow welkin, the clear disc of the Moon, the autumnal right sprinkled with the rays of the Moon, the amour-stricken lord of monkeys, the ravishment of the daughter of Janaka, and the season well-nigh expired, became overwhelmed with sorrow and senseless.","alignment":{"type":"grouped","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4029002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"cfea066b3d69096fdae4ca29b59bd88edcf9adebb24a31158548cf8a34a7f799","compact":"0a94ecefa1b4524b5a89502bb12b36fdfd39e0d99ca70f89e68df518c7950c3c","nasal":"7958bb736d540412ced89673268ed9f10d0352d57f07798e595c452e78da9cf2"}},{"id":"VRCE-4-29-3","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":3,"english":"Sugrīva having entered his palace, and the sky being cleared of the clouds, Rāma, racked with grief, passing the rainy season and beholding the yellow welkin, the clear disc of the Moon, the autumnal right sprinkled with the rays of the Moon, the amour-stricken lord of monkeys, the ravishment of the daughter of Janaka, and the season well-nigh expired, became overwhelmed with sorrow and senseless.","alignment":{"type":"grouped","confidence":0.797,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4029003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"71a3e721da06ab9d23eb8e7db374ffd87f118fe3fbe76aebaa90c57c304c7516","compact":"b011fb5de737b21d8ed429e76fa356c3f3fc680f027a8512c46034f555df7d70","nasal":"36c4d5ca7e570c55998d2d325c848dfda458d3319c361966b2570bd0cf7fb967"}},{"id":"VRCE-4-29-4","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":4,"english":"And regaining his sense after sometime, the highly intelligent king-Räghava began to think of Vaidehĩ although always present in his mind.","alignment":{"type":"1:1","confidence":0.778,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4029004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b7ea3b05e4a8fb403977d86375b7fa727584237d8527e0b48a7c885c2090b027","compact":"6c7ebe04e29fc4dc9ff92adcea22bba8bc97d6ba8faf7b72dedc2622fc13e93d","nasal":"7232ad550cb0c90366ec6e2b79f70c3f9c012f8dbc51ddf45fc285cd1c6d85ca"}},{"id":"VRCE-4-29-5","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":5,"english":"And beholding the clear sky void of lightnings and clouds and filled with the noise of Sārasas, Rāghava began to lament piteously, stationing himself on the summit of the hill ornamented with metals of golden hue. And beholding the autumnal sky he engaged in the meditation of his beloved spouse.","alignment":{"type":"grouped","confidence":0.879,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4029005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"49f021a11199a787fa7451f6c2208a07422869b332c4591f47f26748c3aed69a","compact":"74f66c8fc942da3fc7c400dd90c75f1d0352e09371013099a8c164bb90370770","nasal":"74f66c8fc942da3fc7c400dd90c75f1d0352e09371013099a8c164bb90370770"}},{"id":"VRCE-4-29-6","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":6,"english":"And beholding the clear sky void of lightnings and clouds and filled with the noise of Sārasas, Rāghava began to lament piteously, stationing himself on the summit of the hill ornamented with metals of golden hue. And beholding the autumnal sky he engaged in the meditation of his beloved spouse.","alignment":{"type":"grouped","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4029006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2b77cc7d931ac9ec888116ac8a2c1d40932053ba4621b2633828ce39199ac402","compact":"3cd1ba97d2d8857a9dd5b7bccbc721b53a61bb65f4004d5215dcaebf78f02a95","nasal":"3cd1ba97d2d8857a9dd5b7bccbc721b53a61bb65f4004d5215dcaebf78f02a95"}},{"id":"VRCE-4-29-7","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":7,"english":"How shall that Sarasa-voiced damsel be pleased to-day, who, while sporting in the hermitage, used to warble like Sārasas, to invite them.","alignment":{"type":"1:1","confidence":0.74,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4029007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"4571084b8ea1153f3ec86ea32374ed1d37c24c8e2cc6268dc4007c7e7a2bec96","compact":"d266c5ecfac1d71fdc5d47c527226e508714131ff72539012f43669591405f6d","nasal":"d266c5ecfac1d71fdc5d47c527226e508714131ff72539012f43669591405f6d"}},{"id":"VRCE-4-29-8","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":8,"english":"Beholding Asana trees, as if covered with golden flowers and not beholding me how shall that damsel be pleased?","alignment":{"type":"1:1","confidence":0.821,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4029008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8a6879b8d406c1330c4ef80a6dc45b737078b548e20e5de8b00521ca982b6ff2","compact":"12aebb797b6aeecf76d2842da660e86c674ca79b51bc1b925cf461f565d48251","nasal":"8efde809730d0c2c19ffceef1da50b8c5b01b1917018043e5e6255d31ecfd7f3"}},{"id":"VRCE-4-29-9","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":9,"english":"How that exquisitely fine damsel having a sweet voice shall be pleased to-day, who used formerly to awake at the sounds of the drakes.?","alignment":{"type":"1:1","confidence":0.6,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4029009","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"01e17f2e8fe6cc6d48be4898ed15b0b158d7ac4043e50abfdf362c2acebd2fc5","compact":"40de20a7f08cdf94a3d688327c86ea1a3b9c4bf76a817f17e4c8782b82618a1d","nasal":"c4cb299742808ad27a0c6a1bf1af2239f1ba9b1a142a99a1d97a1b144ac547f2"}},{"id":"VRCE-4-29-10","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":10,"english":"Hearing the noise of her companionsCakravākas, how shali that one, of expansive eyes resembling lotuses, live?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-7"],"status":"unreviewed"},"source":{"sanskritLocator":"4029010","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5725299c243a61390fd93ea111ca3689c6d000e2bd3108b2c39d5c05e2c3fab1","compact":"4779d2c7b2aa199da806030d9c2dc69533dee7687ee216d61ae61bf8500a4107","nasal":"ad341590b27055574a432ff638131288eb5d8e48eb176e9898cbdc99b026487d"}},{"id":"VRCE-4-29-11","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":11,"english":"Without her having the eyes of a fawn, I do not attain to felicity to-day, ranging at large by ponds, streams, pools and in forests and woods.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4029011","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"196e08702a519c044d29857daeeeff87a0672817cb530caf76c3b761ab506e0b","compact":"811e4102a09a4dfad54b7a821148b5908e82da44a74de0ac55acbebc827b73c2","nasal":"4aaff82bf6333a5e3af2b89a781da1b0d07a239f425bc9075e556a957e931c9c"}},{"id":"VRCE-4-29-12","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":12,"english":"Forsooth shall Cupid excited by the approach of the autumn, distress her the more on account of my separation and her personal charms.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-9"],"status":"unreviewed"},"source":{"sanskritLocator":"4029012","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0736e80b4281c3eab52a575bd24430988dabcab3883f42bb49a5788611a84bb8","compact":"22e3cba2b82b48ebe69be8371ddbd98d882f832b8f584a7d9cd77e4fa94bdbdc","nasal":"edbe16dea2c5212ac0f5f85f119082a2c6bff7eb08b823524796c703e0c7915c"}},{"id":"VRCE-4-29-13","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":13,"english":"Thus bewailed that best son of a king like to the bird Sāranga soliciting water from the lord of celestials.","alignment":{"type":"1:1","confidence":0.86,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-10"],"status":"unreviewed"},"source":{"sanskritLocator":"4029013","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"61816f36f1286f3a9b6f151ad76d624909e320d8873ce34c63749bd3e445662b","compact":"585be013d895dc68a06349e12a16f45a6c7bebeed5122daf019e0dc49a9cf9ae","nasal":"5a2b43eb96ec6c73e84f7bd87fc0c008bde0780ed1dba8c989883949f1d7b10c"}},{"id":"VRCE-4-29-14","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":14,"english":"And the graceful Lakşmaņa, returning from the picturesque mountain-summits where he had sojourned in quest of fruits, beheld his elder brother.","alignment":{"type":"1:1","confidence":0.726,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-11"],"status":"unreviewed"},"source":{"sanskritLocator":"4029014","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"87526b8cb51c9996ebb26faa3c68d09ee27cdd84a9a5347ff6482a90918c06ed","compact":"412f462aaf588658065c5f21f607b1615c43f1b960bd25cfc328f3e24b2b3eb7","nasal":"a30783cd7a5589172981178a9b9a85f8004c5ea846f4f976ac630bdb65a7e51f"}},{"id":"VRCE-4-29-15","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":15,"english":"And beholding in that lonely forest his brother, racked with anxious thoughts hard to bear and almost beside himself (with grief) the high-minded Saumitri, prompted by his brother's grief, spoke to him very poorly, saying.","alignment":{"type":"1:1","confidence":0.636,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-12"],"status":"unreviewed"},"source":{"sanskritLocator":"4029015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e248833e4d8a43cc2bfe121c4520f731362faa17e9bba20de85a84b1c9fa3859","compact":"1fe5f802ddce0390c63c6a528907136f14b8cf7881036910f7fad6a9c89b0dd4","nasal":"ce9e786270aaa7c90fe7e22fae940c192378b4e405e37f59b3c2f4cee1059a38"}},{"id":"VRCE-4-29-16","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":16,"english":"O worshipful one, what have you perpetrated by placing yourself under the control of passions and defeating your manliness? Your deep and devout meditation has been purloined by your grief; and it is by religious contemplation that your grief shall be terminated now.","alignment":{"type":"1:1","confidence":0.747,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-13"],"status":"unreviewed"},"source":{"sanskritLocator":"4029016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"94be8072d9717ee09957a2a8ad2675745055af4d2ae8dad88730f5b10538ddf8","compact":"4b5a4fadaa4a23f0aa2dff9f7c2e42df11875767c6c61bfe657b0228057d0948","nasal":"4b5a4fadaa4a23f0aa2dff9f7c2e42df11875767c6c61bfe657b0228057d0948"}},{"id":"VRCE-4-29-17","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":17,"english":"O brother, after going through the ceremonies of bathing and so forth, and acquiring peace, do you bring all your time under your control by virtue of the concentration of soul; and being of unmitigated strength do you resort to power and help, the key-notes for the accomplishment of your great object.","alignment":{"type":"1:1","confidence":0.714,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-14"],"status":"unreviewed"},"source":{"sanskritLocator":"4029017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ddf84071dd0e3cb09e33d2c00c50ac7bdf35ac2dce74080cbff57f26305a5618","compact":"5a2cab84845796cc35f932b2ef93c9596dc61885b4a78d944f15d2411c144a46","nasal":"5a2cab84845796cc35f932b2ef93c9596dc61885b4a78d944f15d2411c144a46"}},{"id":"VRCE-4-29-18","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":18,"english":"O lord of men, Jānakī, husbanded by you, is not capable of being easily possessed by others. O hero who getting at a flame of fire, does not burn himself?","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4029018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a5e70cc6d9990f290a9fc0947600d9b6a7c3a66dd01e5a2a859c2452c8775974","compact":"d921c57d0bb3338e37dfc02c041fb4a2e0c9c10cbfe4c972b0bfac3e69834aa7","nasal":"d921c57d0bb3338e37dfc02c041fb4a2e0c9c10cbfe4c972b0bfac3e69834aa7"}},{"id":"VRCE-4-29-19","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":19,"english":"Thereupon Rāma spoke to Lakşmaņa, gifted with royal marks, addressing him with natural and resolute words and saying:—What you had said, is sound, well-meaning, sanctioned by polity and speaks of piety, wealth and forgiveness. It should therefore, without the least doubt, be performed by me. It behoveth me to engage in contemplation about the eternal truth regarding the Deity and in ascetic observances. Oh else O Prince, it is not proper to think of the fruits of a difficult, highly developed and energetic action.","alignment":{"type":"grouped","confidence":0.915,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4029019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e8d052e5e51bfc4c96122da49fc2dcd4fdbf0d9c67708b490dc2893d33da5d1","compact":"72a97a17679d0a4377ae587b6b0b9f09193ab0465d03fadc79346b276b436f94","nasal":"72a97a17679d0a4377ae587b6b0b9f09193ab0465d03fadc79346b276b436f94"}},{"id":"VRCE-4-29-20","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":20,"english":"Thereupon Rāma spoke to Lakşmaņa, gifted with royal marks, addressing him with natural and resolute words and saying:—What you had said, is sound, well-meaning, sanctioned by polity and speaks of piety, wealth and forgiveness. It should therefore, without the least doubt, be performed by me. It behoveth me to engage in contemplation about the eternal truth regarding the Deity and in ascetic observances. Oh else O Prince, it is not proper to think of the fruits of a difficult, highly developed and energetic action.","alignment":{"type":"grouped","confidence":0.521,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4029020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"7e9d45bd31b8386f9d17119897da9de7dd0dd64f1d6f79bf3bdc76b9bc7c5ed0","compact":"2cea7b89518ed9856fcd3f336bb2adc46af20a59594e536bbf7a7fd8e3e50f74","nasal":"afbc11eaa87405b06eb27a01f40f476b3a888e13e55ba9aa515f42107a384db3"}},{"id":"VRCE-4-29-21","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":21,"english":"Thereupon thinking of Maithelee, having eyes resembling lotus-petals, Rāma spoke to Laks mana with dried countenance.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4029021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"5080f752452722714333c845f57c44a4421c2303c77f34d6093e660c26eb0cff","compact":"473c511f2834e7d6cc00a1588d3de8ea090059c3558fa6f297143f9784b49ad4","nasal":"62d9fd2862d7565dde43d0c9a366a2a909ed994c9dae3aa54f9da92bfa1af062"}},{"id":"VRCE-4-29-22","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":22,"english":"Having satisfied the earth with a profuse discharge of water, produced crops and thus finished his work, the thousand eyed Deity is sitting silent.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4029022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"0e7b983696ba40713fff7f98f7fea9862242b2b06617fce02cc438d87d3c619a","compact":"fb3c5c8ab35d5be819c0ae9afe877bb140574920bab429504ea1050a887c5a6b","nasal":"fb3c5c8ab35d5be819c0ae9afe877bb140574920bab429504ea1050a887c5a6b"}},{"id":"VRCE-4-29-23","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":23,"english":"O son of a king, the clouds, muttering a long and deep sound and approaching the hills and frees, are calmed having discharged their liquid contents.","alignment":{"type":"1:1","confidence":0.627,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4029023","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"484e27ab800ec037419bf45986b7827199e99fa512461dcab7deaa5b9271cb8a","compact":"d2a19c00112908246769bd2e341ebd5933f6b3b5ed55948af56e733be221d181","nasal":"b4f2348059cf588d35a126a1acf418133b1f39a7c70bdd962da85ddcbd2e2b1b"}},{"id":"VRCE-4-29-24","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":24,"english":"Having made the ten quarters dark blue, the clouds, resembling blue lotuses, have become calm, like to elephants without temporal juice.","alignment":{"type":"1:1","confidence":0.746,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4029024","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e786bc1cbfdee0648793cab8180363275e703bbc9817f36ef91fc0d4792db592","compact":"474b07f5d594a624aa96dd3f85752d50f27181606bfb64b4fdceb6d0158ac63b","nasal":"5bdc2455de21b32cb45dc60a2da43aec974f17e09fc1eb6202fb4ea6ff1b080d"}},{"id":"VRCE-4-29-25","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":25,"english":"O gentle one, high gales accompanied with rains, big with water and fragrant with Kutaja and Arjuna flowers being driven before hither and thither, have now become silent.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4029025","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"84ebd08061d3a1639d1aa6c88779ff2e7f2eb5a7d6fcf7a7dd72b0c8be2554ed","compact":"bde6267a3dbade913e887a8a7ba440e78b440b18cf1eddd0336a4e81bc8e226b","nasal":"2d24bd0ffbc15cfda87d5977f8f19743158b5b086feab77f2923ed48c86871b5"}},{"id":"VRCE-4-29-26","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":26,"english":"O innocent Laksmana, the sounds of clouds, elephants, peacocks, and fountains, have been all stopped.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4029026","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e4b598a2672b093eed66106a3b702a193cbc3dd4b5bed7507e3b2abc08a96a55","compact":"b94fd91c4bc5dd025c8f9f2e33b7bd6cb8580674842000de6b15bb97003d4412","nasal":"649e89124941103745a417c01f3afbfe88b77b64437694b9dac1c346fb9e4221"}},{"id":"VRCE-4-29-27","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":27,"english":"Hills, having variegated summits, being washed by dense clouds and thus free from dirt and impurities, do appear elegant being sprinkled by the rays of the Moon.","alignment":{"type":"1:1","confidence":0.779,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-23"],"status":"unreviewed"},"source":{"sanskritLocator":"4029027","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2e0bdf4fcf07c4b36644ef21cc159cf49cc4e361606a0f819c2c660d40051957","compact":"23b794b34594e427b948f6f100b4e517c5e5165675497a13bc8a5a57a6c520d6","nasal":"9b5fdf2a935b2319a677c46faf555698208baf755ef7fef9f8edf7621f5f4b15"}},{"id":"VRCE-4-29-28","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":28,"english":"The rivers in this season of autumn have been gradually showing their banks.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-54"],"status":"unreviewed"},"source":{"sanskritLocator":"4029028","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"778626084c4e7fba2f57c7df3f69a96e87db3b4473008552521aa6d62ea20934","compact":"f156edba84d316a797fb98e502eee5b18af64c5278da74760c1389998ad959f3","nasal":"f80f7c3239f6070a25701eaef3e04c30e879a0564aeab817fc71433d88af4ee3"}},{"id":"VRCE-4-29-29","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":29,"english":"O you of excellent looks, the ponds in this season) appear exquisitely fine, being filled with Kurara birds and Cakravākas.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-55"],"status":"unreviewed"},"source":{"sanskritLocator":"4029029","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8b4b56818fa4e802c1b1004e385af3eca524443324ea4add7f1827ed8b4cb81d","compact":"734478fcd6624e1ddb373b35da3519eb3c848ce4d3c01c1a18de8bdb07d38c7d","nasal":"5bf7418999a2c7686189a30ea6a94cea1d52458b36df10bb64df4f1bbfb6a6fc"}},{"id":"VRCE-4-29-30","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":30,"english":"O son of king, this is the time of preparation for inimical kings, desirous of defeating one another.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-56"],"status":"unreviewed"},"source":{"sanskritLocator":"4029030","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"43edf2664b9dffed73acdd9cdc6f3bee77fe79959daf0a5041f3370b54fada15","compact":"3b09f1dd88fba8a9cb836e0540ae3ccf716c8d0381e3a55dfd36a536645d5482","nasal":"3b09f1dd88fba8a9cb836e0540ae3ccf716c8d0381e3a55dfd36a536645d5482"}},{"id":"VRCE-4-29-31","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":31,"english":"O son of king, this is the best time for royal marches, but I do not find Sugrīva preparing himself for that end.","alignment":{"type":"1:1","confidence":0.857,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-57"],"status":"unreviewed"},"source":{"sanskritLocator":"4029031","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1ffa53530d61f15e6343b0e784f2dd3af5bf9484948eff677a6fb57a70c1bf75","compact":"91c2b91f3cc7a27be909d2179ae35ac3bc13343b058579802c2e2e8dd298b127","nasal":"91c2b91f3cc7a27be909d2179ae35ac3bc13343b058579802c2e2e8dd298b127"}},{"id":"VRCE-4-29-32","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":32,"english":"Stricken as I am with grief, these four months, the season of rains, appeared to me like a hundred year, not beholding Sītā.","alignment":{"type":"1:1","confidence":0.789,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-60"],"status":"unreviewed"},"source":{"sanskritLocator":"4029032","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6e84f9fd398fbc063b9700ca3f719092fba4cb7ac6f04a53ff88f00d1c6fd3a3","compact":"35140f9a4c274a267017db0a04181d7115335f69c7e7f87487ef60f2c36ed729","nasal":"35140f9a4c274a267017db0a04181d7115335f69c7e7f87487ef60f2c36ed729"}},{"id":"VRCE-4-29-33","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":33,"english":"O Laksmana, Sugriva, is not inclined to show any commiseration towards me, who am separated from my beloved spouse, deprived of my kingdom, banished and stricken with sorrow.","alignment":{"type":"1:1","confidence":0.862,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-62"],"status":"unreviewed"},"source":{"sanskritLocator":"4029033","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"9038a20359c4212990489a94e28f9d62dada2f3a08045f29ca3730f6deacad61","compact":"31434009e1e875cba573c9908a2bf78042159ea41e048ed258c230da3380a6ed","nasal":"31434009e1e875cba573c9908a2bf78042159ea41e048ed258c230da3380a6ed"}},{"id":"VRCE-4-29-34","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":34,"english":"Regarding me as one without any to back him, deprived of his kingdom, insulted my Rāvaņa, wretched, of a distant land, under the influence of amour and therefore seeking his help, (Sugrīva has not felt pity for me).","alignment":{"type":"1:1","confidence":0.706,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-63"],"status":"unreviewed"},"source":{"sanskritLocator":"4029034","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a67139b00e3d7ef76db8418a00fd7538e4a92077811a7f8e3aaa8a7cc66e1fb7","compact":"cdc7720976df1a21f28432ec55a013ace34da508e624cd9c8e38931168642bff","nasal":"cdc7720976df1a21f28432ec55a013ace34da508e624cd9c8e38931168642bff"}},{"id":"VRCE-4-29-35","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":35,"english":"O subduer of foes, O you of excellent looks, for these reasons, I have been insulted by that vicious-souled king of monkeys-Sugriva.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-64"],"status":"unreviewed"},"source":{"sanskritLocator":"4029035","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"f26d7030dc82ae2ff80166955cb639a66f210ca720aab3fbb494a7a750c920ec","compact":"667e829243db192d40037362ae5e3f0b307d3a7459b38a93a2bdfdaf867de360","nasal":"667e829243db192d40037362ae5e3f0b307d3a7459b38a93a2bdfdaf867de360"}},{"id":"VRCE-4-29-36","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":36,"english":"Having appointed the time time to institute enquiries about Sītā, that wicked-minded one has now forgot it on the accession of his new dignity.","alignment":{"type":"1:1","confidence":0.806,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-65"],"status":"unreviewed"},"source":{"sanskritLocator":"4029036","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"b37730d868f6828b67c9e6c8f5ca2d9443082ee0f9b457e954459b99f12510b8","compact":"10aa2445629a0d49bb7d9643f37763fff1b79ef9d6fd0d41f8e957f4e6fd09d3","nasal":"10aa2445629a0d49bb7d9643f37763fff1b79ef9d6fd0d41f8e957f4e6fd09d3"}},{"id":"VRCE-4-29-37","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":37,"english":"Do you therefore repair to Kişkindhā and speak of me to that stupid lord of monkeys Sugriva, addicted to rural enjoyments.","alignment":{"type":"1:1","confidence":0.542,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-66"],"status":"unreviewed"},"source":{"sanskritLocator":"4029037","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"ac363aa0fc9a21be17a1b7016740d5495c93fdc82307e8ea1ed925f97f5016db","compact":"afdc611b0a87a2f51046ec7535ac96ca20b5c199065fa82ba78404770b95163e","nasal":"f767698b40d5715beec186ba55cb5e9cb22c52e32e846720f008f2d72b6f57ba"}},{"id":"VRCE-4-29-38","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":38,"english":"And do you tell him-'He, who breaks his promise made to a powerful benefactor who solicits his favour, is regarded by people as vile.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-67"],"status":"unreviewed"},"source":{"sanskritLocator":"4029038","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2cebaa616e0f45f63745086bf44ca9486eec66d476538a2e734cdb17adc19efa","compact":"157d6858a5741c91aeb1022757661971db3bda0be0aece35918456efd0004d01","nasal":"dbcb1579a6b5cf158cba1d61eb65ad6d2769b56535342b39f73fdc1fe43397b5"}},{"id":"VRCE-4-29-39","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":39,"english":"He is a true hero and an excellent person who verifies his words whether good or bad.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-68"],"status":"unreviewed"},"source":{"sanskritLocator":"4029039","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"8e8aeeefb656b461eee0cb15490a26d37251b17cbc7da56388e9a7898b447858","compact":"39f948028c25e9cef6f199da20e191a88e776fe2fcc04fa09b70bb62319f58a2","nasal":"39f948028c25e9cef6f199da20e191a88e776fe2fcc04fa09b70bb62319f58a2"}},{"id":"VRCE-4-29-40","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":40,"english":"Ungrateful they are who do not, after attaining their ends, engage in the service of those of their friends who have not accomplished their objects; even those living on raw flesh do not feed on their gore after their death.","alignment":{"type":"1:1","confidence":0.903,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-69"],"status":"unreviewed"},"source":{"sanskritLocator":"4029040","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2f601fa4d520b836c814cb83509bc47c1b2c5d7de6f548cbdaabe333cf91472c","compact":"3806c9eb5b8216cf062d95a891f73a675aa6874101ae49dea3303dc5a62f297e","nasal":"b97550b79fb6d16978efc4dc71628da3a9f0898204a28a15b8667320cc228120"}},{"id":"VRCE-4-29-41","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":41,"english":"And ask him if he wishes to behold in battlefield the golden bow resembling a lightning.","alignment":{"type":"1:1","confidence":0.853,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-70"],"status":"unreviewed"},"source":{"sanskritLocator":"4029041","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6544f408c34fb8d59960497306cf173bdd55e3c69d5c15792c74de4cd2c92d95","compact":"e9660b27af3e706329260dfc92d81265ff4703706c107de00fb4e3280b9efae0","nasal":"4f9efe111df300afd7b971681fedb928d45f3cdb6a49fd0965ce675cab7a14c6"}},{"id":"VRCE-4-29-42","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":42,"english":"And ask him more, if he wishes to hear the terrible twang of my bow resembling the noise of thunder, when I am enraged in battle.","alignment":{"type":"1:1","confidence":0.969,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-71"],"status":"unreviewed"},"source":{"sanskritLocator":"4029042","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"15550d69bcbc8ebd6c90150a489071fdd161fb542ea416810b4408d367aca387","compact":"61adbda81e4757e5949d2e667861846805b98dcc0f8f16a699e4b0855bcd185f","nasal":"61adbda81e4757e5949d2e667861846805b98dcc0f8f16a699e4b0855bcd185f"}},{"id":"VRCE-4-29-43","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":43,"english":"O hero, O son of a king, when apprised of my prowess assisted by you, will he not recapitulate in his mind (that he may be destroyed by us like to Vali)?","alignment":{"type":"1:1","confidence":0.766,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-72"],"status":"unreviewed"},"source":{"sanskritLocator":"4029043","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3edc5b31531c32f383552eb5ac0a34df3e366b5d5644f1849767316c9942b6a7","compact":"27df6958a6c9d5b1ca2a167bdb69064cdb20a61100e18dc09f7db8eae3ec7ac0","nasal":"d64c7597a5278feb390d1c2789212013c213f70c98f7ef52fbfdd7853387e7a5"}},{"id":"VRCE-4-29-44","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":44,"english":"O conqueror of enemies' cities, does not that lord of monkeys, after accomplishing his object, think of the conditions under which our friendship was contracted?","alignment":{"type":"1:1","confidence":0.846,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-73"],"status":"unreviewed"},"source":{"sanskritLocator":"4029044","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a084bb0c8e1867c0d6c2214c8ce0f730effc2a4d17a8a99f0268e89939c2c2d6","compact":"d54d97facd3a2245bfac56c6b44030381cd800511d2a645c58973606c1df0ab2","nasal":"5c5d2783e6ebe14517f186c849f4a27ed3ef15fc1ad39ff934c3cc7d1906b98a"}},{"id":"VRCE-4-29-45","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":45,"english":"Does not that lord of monkeys think that he has spent four months in enjoyments, having promised and appointed the season, after rains, (for making) enquiries about Sītā?","alignment":{"type":"1:1","confidence":0.79,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-74"],"status":"unreviewed"},"source":{"sanskritLocator":"4029045","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6a251bf079e2bee7d53168ea04a79e86fa776e9e9ebb69f344d2f0ac9897435d","compact":"b472f6ecad9ea0f0d64609b93a030725d0ec2a21098dfe586becc5b07a58f48f","nasal":"a8f4641ca935424c83eb78b79a93cd31fbf792bad58ccb4ef348eb53498aba21"}},{"id":"VRCE-4-29-46","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":46,"english":"Does not Sugrīva feel pity for us, who are racked with sorrow, being addicted to drinking with friends and counsellors?","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-75"],"status":"unreviewed"},"source":{"sanskritLocator":"4029046","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"822c125d4550e7b4fadce7da937d41301ee5bc3798d1c156acaa54e30a4169df","compact":"bca5b67b731786f19505008be6ba7d7c2b1e08dc4a01a3c6fd6c4955412a43ab","nasal":"bca5b67b731786f19505008be6ba7d7c2b1e08dc4a01a3c6fd6c4955412a43ab"}},{"id":"VRCE-4-29-47","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":47,"english":"Do you go, O hero, O you of mighty strength and relate to Sugrīva these my angry words.","alignment":{"type":"1:1","confidence":0.833,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-76"],"status":"unreviewed"},"source":{"sanskritLocator":"4029047","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a885576f84bd9a28d182c139e54bd81e585f92e97bb7b0401717c59c8a615a17","compact":"9c517315b3cb240a1e68b4f8c0726658929000f3c9591f8b9f1b85513692eaa8","nasal":"9c517315b3cb240a1e68b4f8c0726658929000f3c9591f8b9f1b85513692eaa8"}},{"id":"VRCE-4-29-48","kanda":4,"kandaId":"kishkindha","sarga":29,"verse":48,"english":"'O Sugriva, do not neglect your promise and wend your way trodden by Vāli.","alignment":{"type":"grouped","confidence":0.962,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-30-77"],"status":"unreviewed"},"source":{"sanskritLocator":"4029048","sanskritFile":"Ram04.txt","english