Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"576249d798f798619951e66bda2193a280068b70ab9d716dcf3a8e41aba48490","compact":"4ef86cb5fb288c0a9bc7a97481e62874a4f01e071155a00f45f070e989845ca3","nasal":"4ef86cb5fb288c0a9bc7a97481e62874a4f01e071155a00f45f070e989845ca3"}},{"id":"VRCE-4-20-15","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":15,"english":"How shall the heroic and youthful Angada, brought up in luxury and happiness, be regarded by his uncle, senseless with wrath?","alignment":{"type":"1:1","confidence":0.881,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-15"],"status":"unreviewed"},"source":{"sanskritLocator":"4020015","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"91862e8d00c9d19b94c43f8a44ebfe5c4df22c7dc1049905d02a9ba462ff10e7","compact":"723fe0355e4e507c2431fb9f8e5d01dedae85f3f51f1687b966f4e33a0482ccd","nasal":"39b4b6d1a501c19bc9e7bdf7f8c7e77a91e889ba99f8fc63fcc5f6ff951ae260"}},{"id":"VRCE-4-20-16","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":16,"english":"Do you cast for good, O my son, your looks towards your pious sire, for since now it will be hard for you to see him again.","alignment":{"type":"1:1","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-16"],"status":"unreviewed"},"source":{"sanskritLocator":"4020016","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a513de24549dee6822c7aba3fa1f8414d4a0f4cc5f999aeb8cf11c6f5d82798a","compact":"493952025bf096a1efafb6476847e132927af0086f5ae8202ad7d23b66029754","nasal":"493952025bf096a1efafb6476847e132927af0086f5ae8202ad7d23b66029754"}},{"id":"VRCE-4-20-17","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":17,"english":"Do you console your son, favour me with orders, smell his head, as you are going to journey in a foreign land.","alignment":{"type":"1:1","confidence":0.618,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-17"],"status":"unreviewed"},"source":{"sanskritLocator":"4020017","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"edc21422e82fe2da8d7d313e4be2f465d5744b9d6c2f3d8b2855a4e4cd3e125f","compact":"b900e2fa1a326bfb72abd8b34795e5605f278be137e0e17894bd3309de28c437","nasal":"b900e2fa1a326bfb72abd8b34795e5605f278be137e0e17894bd3309de28c437"}},{"id":"VRCE-4-20-18","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":18,"english":"By destroying you, Rāma, has performed a great action, since by this he has been released from his vow to Sugriva.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-18"],"status":"unreviewed"},"source":{"sanskritLocator":"4020018","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d86334a5680ccf970e822e2e476b67d2893a414bf78d1bb55f024a0dc5374418","compact":"40e0d0d535b3bdd8c949fbb3442f09012e731a8c785ef202129e7751db6860eb","nasal":"40e0d0d535b3bdd8c949fbb3442f09012e731a8c785ef202129e7751db6860eb"}},{"id":"VRCE-4-20-19","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":19,"english":"O Sugrīva, do you gain your ends and get back your Rumā, devoid of anxiety do you govern your kingdom-your enemy, the brother has been slain.","alignment":{"type":"1:1","confidence":0.836,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-19"],"status":"unreviewed"},"source":{"sanskritLocator":"4020019","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"58e9fc62e86f2a43af96856613c9fbe3767faa8b20513ae168bdd4ec0591ce3c","compact":"8fc7afbc759ba9aa5fe56a3ec79a72718845702fd1bab54b865c201b6428e1d6","nasal":"a0358d6fdbebbcfdf650694bc5fc128a2aea83d3ff1786450f32c07a744c19c0"}},{"id":"VRCE-4-20-20","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":20,"english":"O lord of monkeys, why did you not welcome me, your beloved spouse, who am bewailing thus? Behold, your other wives are also mourning in the same wise.","alignment":{"type":"1:1","confidence":0.485,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-20"],"status":"unreviewed"},"source":{"sanskritLocator":"4020020","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"35f53ff4271204a45ad983d0ba9d408299333760b59fa31485f92ccad814fcad","compact":"81dfabd015349f2089c7e9675214b9d33d8cb8fe6ff8a126117ba7bbb82d1ac4","nasal":"81dfabd015349f2089c7e9675214b9d33d8cb8fe6ff8a126117ba7bbb82d1ac4"}},{"id":"VRCE-4-20-21","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":21,"english":"Hearing the bewailings of that she-monkey, others, taking Angada, distressed and overwhelmed with grief, began to cry piteously.","alignment":{"type":"1:1","confidence":0.676,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-21"],"status":"unreviewed"},"source":{"sanskritLocator":"4020021","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a887e95b0015edf373a8d60790e325c0194ac312d0b4898b0e2f8ee9b28984b4","compact":"40509b78e7fe765ba39f9b77f4f5f51bda3f67d91daa9e8539d47646422341ec","nasal":"ba38f30cfa89a4a918cb7853096b7135ab3c3c3e10a0a5067ec0c0cf20a1c2c4"}},{"id":"VRCE-4-20-22","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":22,"english":"O hero, having Arigada on your arms, why are you proceeding on a journey for good in a foreign land leaving behind (your son) Angada. It does not behove you (to leave aside) your dear son, gifted with diverse accomplishments and wearing a charming and beautiful cloth.","alignment":{"type":"1:1","confidence":0.602,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-22"],"status":"unreviewed"},"source":{"sanskritLocator":"4020022","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"77e854eb9dd8cd2c4059b0efba2723dabe0b090c77f1825891c9038e842d8a81","compact":"cbac24394ae3e78bbb5b3ec5aaf0102d0693b0a87b9a14e1c0c63717590876ad","nasal"