[{"id":"VRCE-4-20-1","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":1,"english":"Beholding her husband lying dead on the ground with the life-destroying shafts of Rama, Tārā, having a moon-like countenance, approaching, embraced him. And seeing him slain with shafts like to an elephant, resembling a lord mountains and an uprooted tree, Tārā, racked with grief began to bewail.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4020001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"369a27f5c39a77e679dcf73046bc238d51cbf15783f9bbf6f6bd9071e7366713","compact":"62fd5097f63cf320dfa83b8a31d969d180ef75c88b0b02029244696ca5c614e4","nasal":"570396c8b93e549c20c3298963f006ece47a937172a9880396b4e34652210237"}},{"id":"VRCE-4-20-2","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":2,"english":"Beholding her husband lying dead on the ground with the life-destroying shafts of Rama, Tārā, having a moon-like countenance, approaching, embraced him. And seeing him slain with shafts like to an elephant, resembling a lord mountains and an uprooted tree, Tārā, racked with grief began to bewail.","alignment":{"type":"grouped","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4020002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"3b02c8434183afd14e27a549fdabc8f0969c60f950cd4f31080f49ae2a529d38","compact":"efe850533cd8a195f7ebb88de04c2e7a17e2b78654a1462338bd7d696a48a1d8","nasal":"70ba2a933913300f3a6ccf78c450138922068c24edd250e71a9c350461feec64"}},{"id":"VRCE-4-20-3","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":3,"english":"Beholding her husband lying dead on the ground with the life-destroying shafts of Rama, Tārā, having a moon-like countenance, approaching, embraced him. And seeing him slain with shafts like to an elephant, resembling a lord mountains and an uprooted tree, Tārā, racked with grief began to bewail.","alignment":{"type":"grouped","confidence":0.683,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4020003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"6246b3c13c311d7c72c8e0e110813b5cd81fae1047e043639cda05275a90245d","compact":"1f485549f21f0b5aa9af660317e4e4a87482655458a90b21effc06314b937e74","nasal":"1ac3a2ab76d5ed9ada1b9b21a7e648d715687df079ed60b070d03330cd3ad521"}},{"id":"VRCE-4-20-4","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":4,"english":"O hero, O foremost of monkeys, O powerful one, O you terrible in warfare, why did you not welcome me to-day who am guilty of some iniquity by you?","alignment":{"type":"1:1","confidence":0.776,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4020004","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"a254bf35dbeb8c6c707bf8783cd7e0216d777a24274cd0770deed43aef228f46","compact":"9cbb8e5908d719c33606920e2be4f9edd3e83f7ffe5ccde0b356926b8b15deb1","nasal":"fbe8aa2091d49c1b5110be8cae77a9d17f4286486b652507526f7957f07f5b8b"}},{"id":"VRCE-4-20-5","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":5,"english":"Rise, O best of monkeys, and lie down on a better bed; monarchs do not stretch themselves on earth.","alignment":{"type":"1:1","confidence":1.0,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4020005","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c83a5e7f2566c248c90f4bae94f4e7b5dd7df83b11020584fbb130f7badbea43","compact":"661ef9a324e5a298f02929eed5f24973b88f22949a4e714c264a5160c9d72d56","nasal":"661ef9a324e5a298f02929eed5f24973b88f22949a4e714c264a5160c9d72d56"}},{"id":"VRCE-4-20-6","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":6,"english":"O lord of earth, indeed earth is your favourite wife; since renouncing me, you, though dead, are serving her with your body.","alignment":{"type":"1:1","confidence":0.709,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-4"],"status":"unreviewed"},"source":{"sanskritLocator":"4020006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"2069581915ceeb1fa4edc62a89e411476735f21c0581c5711855668f3ba3f83c","compact":"2e8085091b98e96b6dca45356a3c8dc3da85041dd75559aa86d0e5a85c0b9279","nasal":"dbf337099c680ac55f2cd3dba8eb9a09612ac24dc817dc9bbed3a264c503b4f6"}},{"id":"VRCE-4-20-7","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":7,"english":"Evident it is, O hero, that while engaged in a lawful conflict, you hadst created another city of Kiskindha, in the region of the celestials.","alignment":{"type":"1:1","confidence":0.732,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-5"],"status":"unreviewed"},"source":{"sanskritLocator":"4020007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"630f7825e1e0cb4a92707a5ef1bc5514f3ad74f030198632576617c7e728858a","compact":"acc6effb4f1bf9ee795a78010692398bb39e7da0952122188cf77bf258da2b03","nasal":"d6a5fa60aa91f54c70f60126e3b8d3ad5453c988a9d5ca183801d205d0ae404f"}},{"id":"VRCE-4-20-8","kanda":4,"kandaId":"kishkindha","sarga":20,"verse":8,"english":"All your enjoyments with me in nectarsmelling woods, have been brought to a close.","alignment":{"type":"1:1","confidence":0.873,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-20-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4020008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"d27ac02bfb7f086e376bceb4b88e78a9f12e3f3adee6d3111dc950b8c828f0a4","compact":"da4caf8751229f31c5fba141a33ca297d581f87c7473e88bc28e8f6667c845e2","na