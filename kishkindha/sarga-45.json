skritLocator":"4045006","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"dffc0c5082685466a43adceb1c3a196cdb2f31c026aeb002445ba70db7e8ed6e","compact":"cd20821b061c229f35a5a171ead4df66d60bb852c50e8679c14d47fb19aaac06","nasal":"cd20821b061c229f35a5a171ead4df66d60bb852c50e8679c14d47fb19aaac06"}},{"id":"VRCE-4-45-7","kanda":4,"kandaId":"kishkindha","sarga":45,"verse":7,"english":"And I, losing my sense, thought that my superior had for certain been slain. And I placed 7 crag huge as a hill at the mouth of the cave. took to my","alignment":{"type":"1:1","confidence":0.562,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-46-6"],"status":"unreviewed"},"source":{"sanskritLocator":"4045007","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"45afcabe61196ded2c3f7a63dce5270dbe67731c2d5330e6c11e7c387e8fdb19","compact":"25706e3a3732d2a4868b1ebfb593aa024148ec6817932d6f0e9952ec8e663c88","nasal":"6454397fa73ee65792200f40ad2c64b1c3e96b85687fd21a3e909548319171dd"}},{"id":"VRCE-4-45-8","kanda":4,"kandaId":"kishkindha","sarga":45,"verse":8,"english":"(And thought I), 'Mahisa, unable to issue out, needs must meet his end.' And despairing of his (Vali's) life, I retraced my steps to Kiskindha. And obtaining the spacious kingdom along with Tãrã and Umā, I began to pass my days in peace in company with his counsellors.","alignment":{"type":"split","confidence":0.375,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-46-7","DUTT-4-46-8"],"status":"unreviewed"},"source":{"sanskritLocator":"4045008","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"c8fdf245ee0f96dbd105f0a4ec0b24e3c36118ff8526843db8ed30fa16dd628e","compact":"6dcc413c39629dd3e05ea901a35f4bc86dc4ad0adbf131e5ca28ee5f7ed1d415","nasal":"0f803585db59c2aef4166271eaa3d21f9907f22b1166a3fff430bd77574ee6e3"}},{"id":"VRCE-4-45-9","kanda":4,"kandaId":"kishkindha","sarga":45,"verse":9,"en