[{"id":"VRCE-4-45-1","kanda":4,"kandaId":"kishkindha","sarga":45,"verse":1,"english":"On the monkey-chiefs having departed, Rāma said to Sugrīva, How is it that you know all the quarters of this earth?'","alignment":{"type":"1:1","confidence":0.841,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-46-1"],"status":"unreviewed"},"source":{"sanskritLocator":"4045001","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"e507f61283863c4dcf5efc434b39953b66311c5c55b306d7a42c66f51466735f","compact":"997c409df821273b61b4e1e35e875f249c7387d59c343cbb08330b4cc685c619","nasal":"53166d05c9230b887109026d371607c2d98683146cffcf512682211b91ac97a0"}},{"id":"VRCE-4-45-2","kanda":4,"kandaId":"kishkindha","sarga":45,"verse":2,"english":"Thereupon, the self-controlled Sugrīva, bowing low, said to Rāma, Do you listen to my words. I shall relate everything.","alignment":{"type":"1:1","confidence":0.734,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-46-2"],"status":"unreviewed"},"source":{"sanskritLocator":"4045002","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"af822d333b645b4a073358899e3faaa64178ba597db67970a41e4f74ba913ede","compact":"9af740b61a163346f7a6750f6aaa6bb477d4712217eb23b426ada465b743665a","nasal":"9af740b61a163346f7a6750f6aaa6bb477d4712217eb23b426ada465b743665a"}},{"id":"VRCE-4-45-3","kanda":4,"kandaId":"kishkindha","sarga":45,"verse":3,"english":"When Vāli pursued the Dānava Dundubhi, wearing the form of a buffalo towards the Malaya mountain, Mahișa entered a cave of that mountain. And Vali also, desirous of slaying the Asura, entered Malaya.","alignment":{"type":"grouped","confidence":0.855,"method":"shared-sanskrit-ngram","duttRefs":["DUTT-4-46-3"],"status":"unreviewed"},"source":{"sanskritLocator":"4045003","sanskritFile":"Ram04.txt","englishEdition":"M. N. Dutt 1891–94"},"sanskrit_fingerprints":{"exact":"1f02372f4a5378d50ddf5ee5adf8dc70376ea678ac9a0ffc9d353b53bfdd16